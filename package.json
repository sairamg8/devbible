{
  "name": "devbible",
  "version": "0.0.0",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node scripts/page-counts.mjs && node scripts/ensure-search-index.mjs && docusaurus start",
    "start:no-search": "node scripts/page-counts.mjs && docusaurus start",
    "search:index": "node scripts/ensure-search-index.mjs --force",
    "status": "node scripts/status.mjs",
    "page-counts": "node scripts/page-counts.mjs",
    "build": "node scripts/page-counts.mjs && DOCUSAURUS_SSG_WORKER_THREAD_COUNT=4 DOCUSAURUS_SSG_WORKER_THREAD_RECYCLER_MAX_MEMORY=500000000 docusaurus build",
    "build:fast": "node scripts/page-counts.mjs && FAST_BUILD=true DOCUSAURUS_SSG_WORKER_THREAD_COUNT=4 DOCUSAURUS_SSG_WORKER_THREAD_RECYCLER_MAX_MEMORY=500000000 docusaurus build --no-minify",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "currency": "node scripts/currency.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "claude-mem": "^13.15.2",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
