{
  "name": "mono-root",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mono-root",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@acme/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@acme/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/api": {
      "name": "@acme/api",
      "version": "1.0.0",
      "dependencies": {
        "@acme/shared": "1.0.0"
      }
    },
    "packages/shared": {
      "name": "@acme/shared",
      "version": "1.0.0"
    }
  }
}
