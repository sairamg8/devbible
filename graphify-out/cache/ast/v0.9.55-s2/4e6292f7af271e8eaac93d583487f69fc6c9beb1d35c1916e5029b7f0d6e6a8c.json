{"nodes": [{"id": "$graphify-root$_docs_system_design_pages_phase_2_request_path_17e_graphql_at_the_edge_md", "label": "17e-graphql-at-the-edge.md", "file_type": "document", "node_kind": "page", "source_file": "docs/system-design/pages/phase-2-request-path/17e-graphql-at-the-edge.md", "source_location": "L1", "frontmatter": {"title": "A graph at the edge buys one round trip for a screen&#x27;s data and ends over- and under-fetching, and it pays for that with the transport: every query is a POST to a single URL, so the CDN that answered most of your traffic has nothing to key on and nothing to store, HTTP&#x27;s automatic-retry allowance no longer applies, and a partial failure now arrives as a 200 with an errors array that no status-code dashboard will ever notice", "sidebar_label": "17e \u00b7 GraphQL at the edge", "sidebar_position": "17.6"}}, {"id": "$graphify-root$_docs_system_design_pages_phase_2_request_path_17e_graphql_at_the_edge_what_a_graph_at_the_edge_genuinely_fixes", "label": "What a graph at the edge genuinely fixes", "file_type": "document", "node_kind": "heading", "source_file": "docs/system-design/pages/phase-2-request-path/17e-graphql-at-the-edge.md", "source_location": "L34"}, {"id": "$graphify-root$_docs_system_design_pages_phase_2_request_path_17e_graphql_at_the_edge_why_the_edge_cache_stops_helping", "label": "Why the edge cache stops helping", "file_type": "document", "node_kind": "heading", "source_file": "docs/system-design/pages/phase-2-request-path/17e-graphql-at-the-edge.md", "source_location": "L58"}, {"id": "$graphify-root$_docs_system_design_pages_phase_2_request_path_17e_graphql_at_the_edge_a_200_with_an_errors_array_breaks_your_alerting", "label": "A `200` with an `errors` array breaks your alerting", "file_type": "document", "node_kind": "heading", "source_file": "docs/system-design/pages/phase-2-request-path/17e-graphql-at-the-edge.md", "source_location": "L110"}, {"id": "$graphify-root$_docs_system_design_pages_phase_2_request_pat