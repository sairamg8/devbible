{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_vendor_prefixes", "label": "Vendor prefixes in 2026", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mostly history. New features ship behind flags. Exceptions: -webkit-line-clamp still required; -webkit-backdrop-filter for Safari. Manage the rest with Autoprefixer/Lightning CSS."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_webkit_line_clamp", "label": "-webkit-line-clamp still required", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unprefixed line-clamp is false in Firefox 153; -webkit-line-clamp is true. Full incantation still needs display:-webkit-box and -webkit-box-orient:vertical."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_not_a_browser_detector", "label": "A -webkit- prefix is not a browser detector", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firefox implements -webkit-user-select, -webkit-box-shadow, -webkit-appearance for compatibility. Authors shipped WebKit-only CSS; prefixes as detectors failed."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_vendor_prefixes", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_webkit_line_clamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_not_a_browser_detector", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_vendor_prefixes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_vendor_prefixes_not_a_browser_detector", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_supports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/vendor-prefixes.html", "source_location": null, "weight": 1.0}], "hyperedges": []}