{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_row_number", "label": "row_number", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consecutive integers; ties broken arbitrarily. Non-unique ORDER BY is non-deterministic \u2014 WHERE rn = 1 can pick a different row after a plan flip. Always add a unique tiebreaker. Ranking functions ignore the frame."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_rank", "label": "rank", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties share; next value skips (1, 1, 3). max(rank) equals the row count, not the number of distinct values. Sporting convention: two golds, no silver."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_dense_rank", "label": "dense_rank", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties share; no gap (1, 1, 2). Use when you want the count of distinct levels rather than sporting position."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_percent_rank", "label": "percent_rank and cume_dist", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "percent_rank is (rank-1)/(rows-1), 0 to 1. cume_dist is the proportion at or before this row, starts above 0, ends at 1."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_ntile", "label": "ntile", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remainder goes to earliest buckets (7 into 3 \u2192 3,2,2). Splits ties across boundaries with no peer notion \u2014 unsuitable for grading. Use percentile_cont thresholds instead."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_row_number", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_rank", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_rank", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_dense_rank", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_percent_rank", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_rank", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/the-four-functions.html", "source_location": null, "weight":