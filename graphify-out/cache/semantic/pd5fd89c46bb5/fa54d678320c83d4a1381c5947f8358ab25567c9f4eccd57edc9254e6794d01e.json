{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_cross_join", "label": "CROSS JOIN", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/cross-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every left row pairs with every right row. Deliberate for spines and grids; accidental via comma FROM with no error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_comma_join", "label": "Comma FROM accidental product", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/cross-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM a, b with a missing WHERE produced 20 rows from 4\u00d75 with no error. JOIN \u2026 ON makes the same omission a syntax error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_calendar_spine", "label": "Calendar spine", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/cross-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CROSS JOIN generate_series then LEFT JOIN facts with the date filter in ON. count(*) reports 1 on empty days; count(o.id) reports 0."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_comma_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_cross_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/cross-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_calendar_spine", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_cross_join_cross_join", "relation": "implem