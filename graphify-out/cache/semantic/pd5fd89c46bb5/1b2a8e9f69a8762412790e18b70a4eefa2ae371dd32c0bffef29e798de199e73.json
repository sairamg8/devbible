{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_06_tls", "label": "TLS to the database", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_06_tls_sslmode", "label": "Six libpq sslmodes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prefer is the default and silently falls back to plaintext. allow tries plaintext first. require encrypts but verifies nothing."}, {"id": "docs_postgresql_pages_phase_13_ops_06_tls_verify_full", "label": "verify-full hostname check", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "verify-ca accepted CN=devbible-pg-hba while connecting to 127.0.0.1; verify-full rejected it. Production should use verify-full."}, {"id": "docs_postgresql_pages_phase_13_ops_06_tls_hostssl", "label": "hostssl hostnossl enforce TLS on the server", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client sslmode is the client's choice. hostnossl reject plus hostssl scram is the only version of require-TLS that survives a misconfigured service."}, {"id": "docs_postgresql_pages_phase_13_ops_06_tls_pg_reject_unauthorized", "label": "pg rejectUnauthorized false is require", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ssl: true is not verify-full. Pass the CA explicitly with rejectUnauthorized: true. Check pg_stat_ssl per connection."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_06_tls", "target": "docs_postgresql_pages_phase_13_ops_05_pg_hba", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_06_tls_hostssl", "target": "docs_postgresql_pages_phase_13_ops_05_pg_hba_first_match_wins", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_06_tls_verify_full", "target": "docs_postgresql_pages_phase_13_ops_06_tls_sslmode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_06_tls_pg_reject_unauthorized", "target": "docs_postgresql_pages_phase_13_ops_06_tls_verify_full", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/06-tls.md", "source_location": null, "weight": 1.0}], "hyperedges": []}