{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_lost_this", "label": "Lost this", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicit binding is a property of the call site. Assigning, destructuring, or passing a method drops the receiver."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_thisarg", "label": "thisArg", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach/map/filter/some/every/find/findIndex/flatMap accept a thisArg. reduce and sort do not."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_bind_identity_trap", "label": "bind identity trap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bind returns a new function each call, so removeEventListener never matches. Store the bound function once."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_class_field_arrow", "label": "Class field arrow", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-instance own property capturing constructor this. Survives detach; cannot be super-called or stubbed on the prototype."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_arrow_callback_fix", "label": "Arrow callback this fix", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An arrow has no this, so the inner obj.method() keeps its receiver. Wrong as the method itself at module scope."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_lost_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_implicit_this_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_lost_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_default_this_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_thisarg", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_lost_this", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/losing-and-fixing-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_losing_and_fixing_this_bind_identity_trap", "target": "build_css_p2_docs_javascript_pages_phase_3_functions