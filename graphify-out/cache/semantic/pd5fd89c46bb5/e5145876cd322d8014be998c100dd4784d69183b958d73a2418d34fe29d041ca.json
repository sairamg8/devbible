{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_health_checks", "label": "Health checks \u2014 liveness vs readiness", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflating liveness and readiness is how a temporary dependency blip becomes a restart storm."}, {"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_liveness_probe", "label": "Liveness probe", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers 'should this process be killed?'. Must depend on almost nothing. If /live checks the database and it blips, every pod restarts at once."}, {"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_probe", "label": "Readiness probe", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers 'should this process receive traffic?'. Allowed to be strict: DB pool, required caches, acceptingTraffic flag. Temporary and reversible without a kill."}, {"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_startup_probe", "label": "Startup probe", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional. Has boot finished? Wait; do not kill yet. Same checks as readiness, but only during boot."}, {"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_accepting_traffic", "label": "acceptingTraffic flag", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flip true only after validate config, connect pools, and listen. Ready before the pool exists means health already passed while first requests fail."}, {"id": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_drain", "label": "Readiness drain on SIGTERM", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set readiness false, wait for in-flight requests, close server, exit. The balancer stops new traffic because readiness failed, not because the process vanished mid-request."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_liveness_probe", "target": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_probe", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_health_checks", "target": "docs_nodejs_pages_phase_10_observability_10_health_checks_startup_probe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_probe", "target": "docs_nodejs_pages_phase_10_observability_10_health_checks_accepting_traffic", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_drain", "target": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_probe", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_liveness_probe", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_event_loop_lag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_10_health_checks_accepting_traffic", "target": "docs_nodejs_pages_phase_11_deployment_02_boot_sequence_validate_connect_listen_ready", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/10-health-checks.md", "source_location": null, "weight": 1.0}], "hyperedges": []}