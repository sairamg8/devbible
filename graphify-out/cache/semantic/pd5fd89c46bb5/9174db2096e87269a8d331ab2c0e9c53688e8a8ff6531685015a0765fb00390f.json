{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_page", "label": "list with filtering, sorting and pagination", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_assembled_query", "label": "Assembled list query", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filter values and limit/offset are parameters. Filter fields, sort column and direction come from an allowlist. Clamp limit to avoid DoS."}, {"id": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_sort_tiebreaker", "label": "ORDER BY unique tiebreaker", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY on a non-unique column is underspecified. Paging 100 rows without , id returned 54 distinct and 46 duplicates. Instability is between offsets, not per-query jitter."}, {"id": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_offset_cost", "label": "OFFSET pagination cost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET n produces and discards n rows and cannot stay correct under concurrent writes. Use keyset for deep or crawlable lists."}, {"id": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_total_count", "label": "Expensive total count", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtered count(*) scans matching rows. Prefer limit+1 hasMore. Count and page must share one transaction snapshot."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_assembled_query", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_identifiers_not_params", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_sort_tiebreaker", "target": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_assembled_query", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_offset_cost", "target": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_sort_tiebreaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_total_count", "target": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_assembled_query", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/02-list-endpoint.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_02_list_endpoint_total_count", "target": "docs_postgresql_pages_phase_9_api_crud_12_client_propagation_db_first_arg", "relation": "conceptually_related_t