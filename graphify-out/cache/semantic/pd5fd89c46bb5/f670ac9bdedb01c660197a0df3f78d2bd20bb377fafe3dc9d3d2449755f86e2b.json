{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_text_text_type", "label": "text type", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default string type. Same implementation, size and speed as varchar(n) (13 MB / ~26 ms on 300k rows)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_text_varchar", "label": "varchar(n)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column insert raises 22001 over length; explicit ::varchar(n) truncates silently. Widening is metadata-only (2.4 ms); narrowing rewrites (305 ms / 200k)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_text_char_n", "label": "char(n) blank-padded", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pads to width (51 vs 4 bytes for 'abc' in char(50)); comparison ignores trailing spaces. Avoid except genuinely fixed-width codes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_text_check_length", "label": "text plus CHECK length", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cannot be cast away, visible in \\d, and changeable with NOT VALID + VALIDATE without rewriting the table."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_text_collation_libc", "label": "Collation from libc (musl vs glibc)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sort order comes from the column/database collation via the C library, so Alpine musl and Debian glibc can order the same strings differently."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_text_text_type", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_citext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_text_check_length", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_text_varchar", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_text_text_type", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_text_varchar", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_text_char_n", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_text_text_type", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/text.html", "source_location": null, "weight": 1.0}], "hyperedges": []}