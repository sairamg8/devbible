{"nodes": [{"id": "docs_java_pages_phase_11_testing_06_mockmvc_06_validation_errors", "label": "06-validation-errors.md", "file_type": "document", "node_kind": "page", "source_file": "docs/java/pages/phase-11-testing/06-mockmvc/06-validation-errors.md", "source_location": "L1", "frontmatter": {"title": "A @Valid failure in a bare @WebMvcTest gives you a 400 with an EMPTY body \u2014 because Spring&#x27;s default resolver calls response.sendError(...) and MockMvc performs no error dispatch, so Boot&#x27;s /error controller never runs \u2014 which means the error body most people believe they are testing is produced by a @ControllerAdvice that has to be in the slice, or by a property that is off by default", "sidebar_label": "06 \u00b7 Validation errors", "sidebar_position": "15"}, "_origin": "ast"}, {"id": "docs_java_pages_phase_11_testing_06_mockmvc_06_validation_errors_which_failure_raises_which_exception", "label": "Which failure raises which exception", "file_type": "document", "node_kind": "heading", "source_file": "docs/java/pages/phase-11-testing/06-mockmvc/06-validation-errors.md", "source_location": "L30", "_origin": "ast"}, {"id": "docs_java_pages_phase_11_testing_06_mockmvc_06_validation_errors_what_a_bare_slice_actually_returns_400_and_nothing_else", "label": "\ud83d\udd34 What a bare slice actually returns: 400, and nothing else", "file_type": "document", "node_kind": "heading", "source_file": "docs/java/pages/phase-11-testing/06-mockmvc/06-validation-errors.md", "source_location": "L46", "_origin": "ast"}, {"id": "docs_java_pages_phase_11_testing_06_mockmvc_06_validation_errors_where_the_body_you_expected_comes_from", "label": "Where the body you expected comes from", "file_type": "document", "node_kind": "heading", "source_file": "docs/java/pages/phase-11-testing/06-mockmvc/06-validation-errors.md", "source_location": "L101", "_origin": "ast"}, {"id": "docs_java_pages_phase_11_testing_06_mockmvc_06_validation_errors_gotchas", "label": "Gotchas", "file_