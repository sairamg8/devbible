{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_snapshot_rule", "label": "The snapshot rule", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/the-snapshot-rule.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every part of one statement shares one snapshot taken before it began. Sibling SELECT on the table cannot see a CTE write (visible_to_sibling: 0, visible_via_returning: 1). CTE execution order is unspecified; one snapshot makes the result deterministic."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_sibling_lost_update", "label": "Two write CTEs on the same row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/the-snapshot-rule.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One update is silently lost \u2014 a: 1, b: 0, no error. SERIALIZABLE does not help: there is only one transaction. Merge into one UPDATE, make sets disjoint, or use separate statements."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_snapshot_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_sibling_lost_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/the-snapshot-rule.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_snapshot_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_data_modifying_cte", 