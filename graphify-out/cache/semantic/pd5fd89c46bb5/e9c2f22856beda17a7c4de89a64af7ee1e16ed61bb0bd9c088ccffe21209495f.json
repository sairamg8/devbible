{"nodes": [{"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_page", "label": "select, textarea, files and FormData", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_select_value", "label": "select takes value, not option selected", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "selected on option is stripped and warned. multiple takes an array; read selectedOptions, not e.target.value."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_textarea_value", "label": "textarea takes value, not children", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Children warn; children plus defaultValue throws. Rendered markup still puts text between the tags."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_file_input", "label": "File input FileList and clear", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "e.target.files is a FileList. Clear with node.value = ''. Same file twice does not fire onChange unless reset."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_formdata", "label": "Read a form with FormData", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "name is the key; e.currentTarget is the form; preventDefault stops navigation. Unchecked checkboxes are absent; repeated names need getAll."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_start_uncontrolled", "label": "Start uncontrolled, upgrade fields that need it", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most forms need per-keystroke state for none of their fields. Controlled when you validate as they type or fields constrain each other."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_page", "target": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_select_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_page", "target": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_textarea_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/02-select-textarea-and-formdata.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_page", "target": "docs_react_pages_phase_1_jsx_13_form_elements_02_select_textarea_and_formdata_file_input", "relation