{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_25p02_aborted", "label": "25P02 current transaction is aborted", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the first error the transaction is dead. SELECT 1 was refused after 22012. Accepts only ROLLBACK, COMMIT (as rollback), or ROLLBACK TO SAVEPOINT."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_savepoint", "label": "SAVEPOINT for an optional step", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROLLBACK TO SAVEPOINT rewinds to the savepoint, not the failing statement, and clears aborted state. Place it immediately before the group that belongs together."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_idle_in_transaction", "label": "idle in transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 1240 ms external await held the xact open 1223 ms. Occupies a pool slot, holds locks, and pins xmin so VACUUM cannot clean tables the endpoint never touches."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_idle_in_transaction_timeout", "label": "idle_in_transaction_session_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kills sessions that sit idle in a transaction, turning an unbounded stall into a specific error. ALTER ROLE api_user SET \u2026 = '15s'."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_external_work_outside_tx", "label": "Do external work outside the transaction", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Charge first, then withTransaction. The new failure is money taken with no order \u2014 fix with idempotent charges and reconcile, not by putting the call back inside."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_commit_on_aborted", "label": "COMMIT on an aborted transaction reports success", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It rolls back and does not raise. Catch-log-commit produces HTTP 200 with nothing written."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_subtransaction_xid_cache", "label": "Savepoint-per-row overflows the 64-XID cache", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each writing subtransaction gets an XID. Thousands of savepoints push lookups to disk and degrade every backend. Batch instead of a savepoint per row."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_savepoint", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_25p02_aborted", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_commit_on_aborted", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_25p02_aborted", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_idle_in_transaction", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_idle_in_transaction_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_external_work_outside_tx", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_02_savepoints_and_duration_idle_in_transaction", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/02-savepoints-and-duration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_cr