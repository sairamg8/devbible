{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_patterns_and_composition_patterns_and_composition", "label": "Pattern matching and composition", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/safe-dynamic-where/patterns-and-composition.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_patterns_and_composition_ilike_wildcard_escape", "label": "ILIKE wildcard escaping", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/safe-dynamic-where/patterns-and-composition.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user searching % is not injection \u2014 the parameter is still a value \u2014 but it matches every row and can DoS a large table. Escape \\, %, _ and declare ESCAPE '\\'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_patterns_and_composition_sort_not_in_builder", "label": "Sorting cannot use the parameter builder", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/safe-dynamic-where/patterns-and-composition.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY needs an identifier. Identifiers cannot be parameters; ORDER BY $1 silently sorts by a constant."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_patterns_and_composition_sort_not_in_builder", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_two_failure_modes_order_by_placeholder", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/safe-dyna