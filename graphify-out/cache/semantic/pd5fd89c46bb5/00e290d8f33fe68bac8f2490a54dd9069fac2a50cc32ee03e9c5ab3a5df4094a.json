{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_var_split", "label": "var declaration vs initialization split", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "var x = 1 is two operations: the declaration hoists to function scope as undefined; the assignment stays where it is."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_function_declaration_hoisting", "label": "Function declaration value hoisting", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only form that is usefully hoisted: the slot holds the finished function before the first line runs."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_function_expression_not_hoisted", "label": "Function expression not hoisted", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "var f = function(){} hoists the binding as undefined; calling it above the line is TypeError, not ReferenceError."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_var_function_name_collision", "label": "var and function name collision", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At scope entry the function wins regardless of source order. Only an initializer overwrites it at execution time."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_script_toplevel_var_global", "label": "Script top-level var as non-configurable global", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In a classic script, top-level var is a non-configurable global property and cannot be deleted. Modules do not do this."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_var_split", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_01_the_two_step_scope_entry_declaration_hoisting", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_var_split", "target": "docs_javascript_pages_phase_3_functions_07_lexical_scope_02_var_let_const_function_vs_block_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/02-var-and-function-declarations.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_02_var_and_function_declarations_function_declaration_hoisting", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_01_the_two_step_scope_entry_value_hoisting", "relation": "implements", "c