{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_page", "label": "Startup races and advisory locks", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ensureSchema() at boot is a bug. IF NOT EXISTS is idempotent, not concurrency-safe."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_if_not_exists", "label": "CREATE TABLE IF NOT EXISTS race", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog check and insert are not atomic. 228/500 failed with 23505 on pg_type_typname_nsp_index."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_silent_seed", "label": "Silent startup seed race", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 workers, 20 duplicate admin rows, zero errors. Worse than CREATE race because it is silent data corruption."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_advisory_xact_lock", "label": "pg_advisory_xact_lock", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transaction-scoped lock on a chosen bigint. 500/500 succeeded. Session-scoped pg_advisory_lock can wedge after a crash. Same mechanism real tools use."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_if_not_exists", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_silent_seed", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_advisory_xact_lock", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_if_not_exists", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/startup-races.html", "source_location": null, "weight": 1.0}], "hyperedges": []}