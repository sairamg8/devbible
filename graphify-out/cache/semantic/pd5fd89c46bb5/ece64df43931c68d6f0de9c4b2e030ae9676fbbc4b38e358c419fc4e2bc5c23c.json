{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_strictmode_and_the_compiler", "label": "StrictMode, the Compiler and how purity is enforced", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_doubling_is_the_test", "label": "Doubling is the test", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React cannot inspect purity, so it runs the function twice and lets the damage double."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_what_doubles", "label": "What StrictMode double-invokes", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Component body, useState init, useMemo, useCallback, reducers, class constructor/render/SCU, setState updaters."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_cannot_catch", "label": "What StrictMode cannot catch", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production-only paths, unrun branches, idempotent writes, event handlers, later-update effects. A clean run is not proof."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_compiler_static", "label": "Compiler is the stricter static checker", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It analyses and bails out rather than rewriting impure components. Skipped list is a purity report."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_useref_guard", "label": "useRef guard is the wrong StrictMode fix", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides the symptom. The effect still cannot be remounted safely under navigation or Activity."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_concurrent_abandon", "label": "Abandoned concurrent renders cannot roll back side effects", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_doubling_is_the_test", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_same_inputs_same_output", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/strictmode-and-the-compiler.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_compiler_static", "target": "build_css_p2_doc