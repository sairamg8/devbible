{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_strip_only_mode", "label": "Strip-only mode", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node runs TS by deleting types, never transforming. Syntax that needs a transform is rejected at parse as SyntaxError, not a catchable exception."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_err_unsupported_typescript_syntax", "label": "ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-time SyntaxError for enum, namespace, and parameter properties in strip-only mode. The module never evaluates."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_erasable_syntax_only", "label": "erasableSyntaxOnly", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes tsc reject non-erasable syntax with TS1294 at check time. Defaults false in 7.0.2. Enable whenever anything runs .ts directly."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_whitespace_stripping", "label": "Whitespace type stripping", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Annotations are replaced with whitespace so every character position is preserved and stack traces match without a source map. That forbids generating an IIFE or inserting this.id = id."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_experimental_transform_types", "label": "--experimental-transform-types", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escape hatch that transforms enums. Experimental, warns every start, reintroduces source maps. Rewriting syntax is cheaper."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_const_enum_not_erasable", "label": "const enum is not erasable", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const enum disappears by inlining values \u2014 a transform \u2014 so it errors under erasableSyntaxOnly and isolatedModules. Do not use preserveConstEnums."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_strip_only_mode", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_erasure_erasure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_err_unsupported_typescript_syntax", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_strip_only_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_erasable_syntax_only", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_strip_only_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_whitespace_stripping", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_strip_only_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_const_enum_not_erasable", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_and_erasable_syntax_erasable_syntax_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strip-only-and-erasable-syntax.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strip_only_a