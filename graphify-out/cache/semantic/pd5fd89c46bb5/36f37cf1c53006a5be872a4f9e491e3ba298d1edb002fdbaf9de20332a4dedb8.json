{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_containment_operator", "label": "jsonb @> containment", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks whether the right-hand document appears inside the left. GIN can serve it; ->> = cannot. Measured 4.5ms Index Cond vs 35.4ms seq scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_key_exists", "label": "jsonb ? key exists", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True even when the value is JSON null. jsonb_path_ops cannot serve existence operators."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_jsonpath", "label": "jsonpath @? / @@", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparisons and wildcards that containment cannot express. @? asks whether a path matches; @@ evaluates a boolean path."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_jsonb_path_ops", "label": "jsonb_path_ops vs jsonb_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path_ops is smaller and faster for @> but has no entry for a bare key, so ?/?|/ ?& seq-scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_jsonb_mutation", "label": "jsonb mutation operators", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "|| is shallow; every mutation produces a new document so UPDATE rewrites the whole column."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_gin_cannot_serve_accessor", "label": "GIN cannot serve ->> equality", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A GIN index on a jsonb column indexes structure. doc->>'tag' = 't42' is a different expression and falls back to a filter."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_containment_operator", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_gin_cannot_serve_accessor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/jsonb-operators/containment-and-jsonpath.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_containment_operator", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_jsonb_operators_containment_and_jsonpath_js