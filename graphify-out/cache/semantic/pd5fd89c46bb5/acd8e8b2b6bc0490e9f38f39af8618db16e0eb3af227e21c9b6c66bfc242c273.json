{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_immutable_config", "label": "to_tsvector IMMUTABLE config", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-arg to_tsvector(body) is rejected in an index (42P17) because it reads a session GUC. Name the config."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_generated_tsv", "label": "Generated tsvector column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same speed as an expression index (~17 ms). Chosen to merge columns, carry setweight, and keep queries as tsv @@ q."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_ts_headline", "label": "ts_headline after LIMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-tokenises original text and cannot use the index. Apply after LIMIT so it runs for the page, not every match."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_immutable_config", "target": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_01_tsvector_and_queries_tsvector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgre