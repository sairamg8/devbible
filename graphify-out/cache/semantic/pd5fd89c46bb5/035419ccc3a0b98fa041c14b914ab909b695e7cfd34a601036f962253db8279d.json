{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_deadline_propagation", "label": "Deadline propagation", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_abort_signal_threading", "label": "One AbortSignal threaded through", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the client leaves, the work they started should stop. Measured: one abort() cancelled three children and signal.reason carried 'client disconnected'."}, {"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_abort_signal_any", "label": "AbortSignal.any composition", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compose timeout, client disconnect, and shutdown. Whichever fires first stops the operation through a single signal parameter."}, {"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_cooperative_cancellation", "label": "Cancellation is cooperative", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fetch, timers, streams, and fs/promises honour a signal. Your loops need throwIfAborted(). A synchronous JSON.parse cannot be interrupted."}, {"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_stops_at_queue", "label": "Propagation stops at the queue", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cancelled request must not cancel a job it already enqueued \u2014 the work still needs doing. Also stop before anything already committed."}, {"id": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_client_disconnect", "label": "Abort on request close", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "req close fires on normal completion too. Check !req.readableEnded before aborting or successful work is cancelled."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_deadline_propagation", "target": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_abort_signal_threading", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_deadline_propagation", "target": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_abort_signal_any", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/13-deadline-propagation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_deadline_propagation", "target": "docs_nodejs_pages_phase_7_background_work_13_deadline_propagation_cooperative_cancellation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs