{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_page", "label": "REPEATABLE READ and SERIALIZABLE", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_repeatable_read", "label": "REPEATABLE READ", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One snapshot for the whole transaction, taken at the first statement not BEGIN. Read-only RR cannot fail with 40001. Writers updating a changed row get 40001 concurrent update."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_serializable", "label": "SERIALIZABLE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outcome equals some serial execution. Tracks read/write dependencies. High-conflict: 135 attempts / 115 retries / 12.4s vs 20 attempts / 71ms for FOR UPDATE in id order."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_write_skew", "label": "Write skew", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two transactions read an overlapping set then write different rows, breaking an invariant neither saw break. RR allows it; SERIALIZABLE aborts one with 40001 read/write dependencies."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_serialization_failure_40001", "label": "Serialization failure 40001", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry the whole transaction on 40001/40P01 with bounded attempts, jittered backoff outside the checked-out connection, and no external side effects inside the body."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_repeatable_read", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_serializable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_write_skew", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels_serialization_failure_40001", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/isolation-levels.html", "sou