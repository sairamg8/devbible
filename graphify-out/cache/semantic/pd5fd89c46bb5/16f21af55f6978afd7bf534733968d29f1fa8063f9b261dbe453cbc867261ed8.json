{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_graceful_shutdown_graceful_worker_shutdown", "label": "Graceful worker shutdown", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/graceful-shutdown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On SIGTERM stop claiming, finish in-flight jobs, then close pool and Redis. Close worker first."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_graceful_shutdown_sigkill_active_job", "label": "SIGKILL leaves job active", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/graceful-shutdown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIGKILL mid-job leaves active:1 with no error. Recovered only when the visibility timeout expires."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_graceful_shutdown_ack_last", "label": "Acknowledge last", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/graceful-shutdown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ack after the durable effect. Ack first plus crash is silent loss; ack last plus crash is a duplicate."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_graceful_shutdown_exec_form_pid1", "label": "Exec-form PID 1", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/graceful-shutdown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMD npm run worker makes a shell PID 1; SIGTERM never reaches node. Use CMD [\"node\", \"src/worker.js\"]."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_graceful_s