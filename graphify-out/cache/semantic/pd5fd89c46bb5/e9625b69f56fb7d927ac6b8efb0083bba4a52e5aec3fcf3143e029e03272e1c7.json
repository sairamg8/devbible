{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_page", "label": "Fetching data in an effect", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_fetch_in_effect", "label": "Fetching data in an effect", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A legitimate effect that react.dev still recommends replacing. Four downsides: no server fetch, waterfalls, no cache, and race-condition boilerplate."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_ignore_flag", "label": "ignore-flag race guard", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network responses may arrive out of order. Cleanup flips ignore so a stale response cannot set state. Pair with clearing state before the new fetch."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_network_waterfall", "label": "Network waterfall", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A child cannot render \u2014 and so cannot fetch \u2014 until its parent has. Nested mount-time fetches serialise even when independent."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_usedata_hook", "label": "useData custom hook", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracting the race guard is valuable. It does not add cache, deduplication, or pre-mount fetch. Framework loaders or TanStack Query / useSWR do."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_page", "target": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_fetch_in_effect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_page", "target": "build_css_p2_docs_react_pages_phase_3_state_derived_state_you_might_not_need_an_effect", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_ignore_flag", "target": "build_css_p2_docs_react_pages_phase_4_effects_cleanup_cleanup_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_network_waterfall", "target": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_fetch_in_effect", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/fetching-data.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_fetching_data_network_waterfall", "target": "build_css_p2_docs_react_pages_phase_3_state_render_order_top_down_depth_first", 