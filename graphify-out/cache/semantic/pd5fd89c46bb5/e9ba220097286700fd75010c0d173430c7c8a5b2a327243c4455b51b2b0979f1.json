{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_06_on_conflict_on_conflict", "label": "INSERT ON CONFLICT", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_06_on_conflict_upsert", "label": "Atomic upsert", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only correct insert-if-absent. Check-then-insert raced: 20 workers produced 20 duplicates and zero errors. MERGE can still raise unique_violation under concurrent inserts."}, {"id": "docs_postgresql_pages_phase_4_crud_06_on_conflict_excluded", "label": "EXCLUDED proposed row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXCLUDED is the row that would have been inserted. table.qty + EXCLUDED.qty accumulates; SET qty = EXCLUDED.qty overwrites. WHERE on DO UPDATE skips no-op writes."}, {"id": "docs_postgresql_pages_phase_4_crud_06_on_conflict_xmax_was_insert", "label": "xmax = 0 as was_insert", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "xmax is 0 for a freshly inserted tuple. Implementation detail; prefer created_at versus updated_at if the distinction is load-bearing."}, {"id": "docs_postgresql_pages_phase_4_crud_06_on_conflict_conflict_target_unique_index", "label": "Conflict target needs a unique index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "42P10 without a matching unique or exclusion constraint. Partial indexes need a matching WHERE. Deferrable unique constraints cannot be the arbiter."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_06_on_conflict_on_conflict", "target": "docs_postgresql_pages_phase_4_crud_06_on_conflict_upsert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_06_on_conflict_upsert", "target": "docs_postgresql_pages_phase_4_crud_06_on_conflict_excluded", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_06_on_conflict_conflict_target_unique_index", "target": "docs_postgresql_pages_phase_4_crud_06_on_conflict_upsert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_06_on_conflict_on_conflict", "target": "docs_postgresql_pages_phase_4_crud_07_update_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/06-on-conflict.md", "source_location": null, "weight": 1.0}], "hyperedges": []}