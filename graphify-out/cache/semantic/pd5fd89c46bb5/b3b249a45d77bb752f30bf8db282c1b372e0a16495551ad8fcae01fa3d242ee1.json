{"nodes": [{"id": "docs_react_pages_phase_2_components_11_portals_page", "label": "Portals", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/11-portals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_11_portals_createportal", "label": "createPortal", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/11-portals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createPortal(children, domNode, key?). Called in the return position. The node must already exist. Not a component or a hook."}, {"id": "docs_react_pages_phase_2_components_11_portals_react_tree", "label": "Portal changes DOM placement only", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/11-portals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events, context, state, error boundaries, Suspense and unmount follow the React tree, not the DOM tree."}, {"id": "docs_react_pages_phase_2_components_11_portals_css_escape", "label": "Portals escape overflow and stacking contexts", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/11-portals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "overflow:hidden clips; transform/filter/opacity create stacking contexts z-index cannot cross; position:fixed inside a transform is relative to the ancestor."}, {"id": "docs_react_pages_phase_2_components_11_portals_dialog_top_layer", "label": "dialog showModal and the top layer", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/11-portals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native top layer es