{"nodes": [{"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_single_threaded_javascript", "label": "Single-threaded JavaScript", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True of your code, false of the platform. Network, timers, disk, crypto and rendering run elsewhere."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_run_to_completion", "label": "Run-to-completion", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function cannot be preempted. Buys no locks; costs a frozen UI for any long synchronous job."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_concurrency_vs_parallelism", "label": "Concurrency vs parallelism", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrency is several operations in progress; parallelism is simultaneous execution. Promise.all is concurrency; workers are parallelism."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_await_does_not_block", "label": "await does not block the thread", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await suspends the async function, not the thread. It cannot slice a long synchronous computation."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_worker_agent", "label": "Worker as separate agent", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own thread, heap and event loop. Communication is structured-cloned message passing; isolation preserves run-to-completion."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_never_blocking_exceptions", "label": "Never-blocking exceptions", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomics.wait over SharedArrayBuffer can halt an agent (dedicated/shared workers only). Sync APIs \u2014 readFileSync, execSync, alert, localStorage \u2014 stop the world."}, {"id": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_mdn_execution_model", "label": "MDN JavaScript execution model", "file_type": "document", "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "source_url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Execution_model", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_single_threaded_javascript", "target": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_run_to_completion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/01-sync-vs-async/01-one-thread.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_run_to_completion", "target": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thre