{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_mode", "label": "mode()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most common value. Ties broken by WITHIN GROUP order, with no tie flag. Four kinds tied at 125000 each returned click (or view if reversed). Empty set is NULL. Prefer top-N with counts for a UI."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_bool_and", "label": "bool_and", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set version of all. Empty set is NULL, not true \u2014 same aggregate-empty rule as sum(). JS if (row.all_paid) treats NULL as false, so a customer with no orders looks unpaid. coalesce(..., true). every() is the SQL alias."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_bool_or", "label": "bool_or", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set version of any. Pair with a FILTERed count. Empty-set default should be coalesce(..., false)."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_every", "label": "every()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard-SQL alias for bool_and. Measured identical. Pick one spelling."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_hypothetical_set", "label": "Hypothetical-set aggregates", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where a value would rank if inserted: rank, dense_rank, percent_rank, cume_dist. Argument list must match ORDER BY in number and type. Window rank ranks existing rows; this ranks a value that is not there."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_rank_within_group", "label": "rank() WITHIN GROUP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rank(150) WITHIN GROUP (ORDER BY amount) returned 66721. bigint in the driver until ::int."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_percent_rank_within_group", "label": "percent_rank() WITHIN GROUP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/02-mode-and-booleans.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps a value to a fraction \u2014 inverse of percentile_cont. percent_rank(150) returned 0.1334. Use when you have a score and want its percentile."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_02_mode_and_booleans_mode", "target": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_within_group", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/