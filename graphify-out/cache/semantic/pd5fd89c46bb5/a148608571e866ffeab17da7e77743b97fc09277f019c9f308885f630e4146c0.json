{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_11_intersection_types_intersection", "label": "Intersection types", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/11-intersection-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A & B means both at once. Unions widen values and narrow usable members; intersections do the reverse. Mixin pattern for composing named fragments."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_11_intersection_types_conflicting_members", "label": "Intersection conflicting members become never", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/11-intersection-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error at the declaration. First assignment is Type 'string' is not assignable to type 'never'. interface extends reports TS2430 instead."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_11_intersection_types_distributes_over_union", "label": "Intersection distributes over union", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/11-intersection-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(A | B) & C becomes (A & C) | (B & C). Adds a shared field to every branch of a discriminated union without breaking the discriminant."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_11_intersection_types_intersection", "target": "docs_typescript_pages_phase_1_type_vocabulary_05_union_types_union", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/11-intersection-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages