{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_order", "label": "Logical query processing order", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/09-logical-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_processing_order", "label": "FROM WHERE GROUP BY HAVING SELECT DISTINCT ORDER BY LIMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/09-logical-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT is seventh so aliases do not exist in WHERE. DISTINCT applies after the select list. LIMIT without ORDER BY is arbitrary."}, {"id": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_vs_execution", "label": "Logical order is not execution order", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-4-crud/09-logical-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines semantics. Planner may push predicates, use top-N heapsort, reorder joins. Putting the most selective WHERE first has no effect."}, {"id": "docs_postgresql_pages_phase_4_crud_09_logical_order_where_vs_having", "label": "WHERE versus HAVING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/09-logical-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE filters rows before grouping; HAVING filters groups after. Aggregates in WHERE raise 42803. Non-aggregates in WHERE reduce work."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_order", "target": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_processing_order", "relation": "references", "confide