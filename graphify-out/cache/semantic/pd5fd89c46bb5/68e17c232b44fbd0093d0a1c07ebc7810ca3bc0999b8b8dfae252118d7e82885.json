{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_columns_and_ownership", "label": "Columns, reads and ownership", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_additive_column_grants", "label": "Column grants are additive", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A column grant adds access; table-wide SELECT from any inherited role makes the column list irrelevant. SELECT * and predicates on ungranted columns fail; count(*) needs no column privilege."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_update_needs_select", "label": "UPDATE needs SELECT to read", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE covers writing only. WHERE, RETURNING and SET x = x + 1 read columns and need SELECT. A write-only role cannot run a qualified update."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_ownership_outranks_acl", "label": "Ownership outranks privileges", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REVOKE from the owner succeeds and is not a boundary: ownership carries the right to GRANT it back. There is no GRANT DROP; DDL is an ownership right."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_public_execute_default", "label": "EXECUTE to PUBLIC on new functions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "proacl NULL means the built-in default, not no access. Combined with SECURITY DEFINER this is the classic privilege-escalation shape. There is no DENY; revoke from PUBLIC and re-grant."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_view_as_column_boundary", "label": "View as a column boundary", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column grants only widen. A view exposes named columns and cannot be widened by an unrelated group membership."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_additive_column_grants", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_view_as_column_boundary", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_view_as_column_boundary", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_additive_column_grants", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/03-columns-and-ownership.md", "source_location": null, "weight": 1