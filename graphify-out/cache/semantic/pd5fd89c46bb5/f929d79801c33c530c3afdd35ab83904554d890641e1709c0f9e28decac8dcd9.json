{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "label": "async_hooks and AsyncResource", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_async_id_tree", "label": "executionAsyncId and triggerAsyncId", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every async operation gets an id and the id of what created it. That tree is what AsyncLocalStorage walks. Context is lost wherever the tree is broken."}, {"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_createhook", "label": "async_hooks.createHook", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stability 1 experimental. Fires on every async operation. console.log inside a hook recurses. Exists for APM vendors. Use ALS or diagnostics_channel instead."}, {"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_async_resource_bind", "label": "AsyncResource.bind", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures async context at bind time and restores it when the callback runs. Fix for EventEmitter listeners and queues that store callbacks."}, {"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_eventemitter_context_loss", "label": "EventEmitter listener context loss", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listeners run in the context of emit, not registration. A listener registered inside als.run still loses the store if emit happens in a timer."}, {"id": "docs_nodejs_pages_phase_2_async_21_async_hooks_diagnostics_channel", "label": "diagnostics_channel", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supported instrumentation: named channels, near-zero cost when nobody is subscribed. Prefer over createHook."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "target": "docs_nodejs_pages_phase_2_async_21_async_hooks_async_id_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "target": "docs_nodejs_pages_phase_2_async_21_async_hooks_createhook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "target": "docs_nodejs_pages_phase_2_async_21_async_hooks_async_resource_bind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "target": "docs_nodejs_pages_phase_2_async_21_async_hooks_eventemitter_context_loss", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/21-async-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs