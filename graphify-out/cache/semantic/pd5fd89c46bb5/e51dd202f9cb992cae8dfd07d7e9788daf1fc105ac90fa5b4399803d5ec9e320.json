{"nodes": [{"id": "docs_react_syllabus_03_concurrent_and_server_part", "label": "Part 3 \u2014 Concurrent React and the server", "file_type": "document", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_syllabus_03_concurrent_and_server_concurrent_rendering", "label": "Concurrent rendering", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React can start rendering, stop, do something more urgent, and throw unfinished work away. Purity becomes a correctness requirement."}, {"id": "docs_react_syllabus_03_concurrent_and_server_suspense", "label": "Suspense", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A component threw a promise React knows about. A plain fetch inside useEffect cannot suspend no matter how many boundaries wrap it."}, {"id": "docs_react_syllabus_03_concurrent_and_server_server_components", "label": "Server Components", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs only on the server; code never reaches the browser. No state, effects, event handlers, or browser APIs \u2014 and it can be async."}, {"id": "docs_react_syllabus_03_concurrent_and_server_use_client", "label": "'use client' directive", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks an entry point into the client graph, not 'this file is a component'. Everything it imports goes to the browser too."}, {"id": "docs_react_syllabus_03_concurrent_and_server_use_server", "label": "'use server' directive", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks a Server Function and has nothing to do with Server Components. Every Server Function is a public HTTP endpoint."}, {"id": "docs_react_syllabus_03_concurrent_and_server_actions", "label": "Actions", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function passed to form action. React calls it with FormData, wraps it in a transition, tracks pending state, and resets on success."}, {"id": "docs_react_syllabus_03_concurrent_and_server_hydration", "label": "Hydration", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hydrateRoot attaches React to server HTML. Hydration costs roughly a full render's worth of JavaScript."}, {"id": "docs_react_syllabus_03_concurrent_and_server_partial_prerendering", "label": "Partial Pre-rendering", "file_type": "concept", "source_file": "docs/react/syllabus/03-concurrent-and-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19.2 resume APIs: prerender a static shell at build time, resume per request to fill dynamic holes."}], "edges": [{"source": "docs_react_syllabus_03_concurrent_and_server_part", "target": "docs_react_syllabus_04_building_an_app_part", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc