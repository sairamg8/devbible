{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_01_sync_vs_background_sync_vs_background", "label": "Sync vs background", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/01-sync-vs-background.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The request path should do the minimum the user is waiting on. One event loop: 120 ms resize produced 1246 ms p95 at 10 concurrent vs 19 ms queued."}, {"id": "docs_nodejs_pages_phase_7_background_work_01_sync_vs_background_202_accepted", "label": "202 Accepted for queued work", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/01-sync-vs-background.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work is accepted, not done. 200 plus fire-and-forget is how a frontend polls a receipt that failed silently."}, {"id": "docs_nodejs_pages_phase_7_background_work_01_sync_vs_background_fake_queue", "label": "res.json then doSlowThing is not a queue", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/01-sync-vs-background.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No retry, no visibility, no backpressure; a restart deletes it. Still runs on the API event loop."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_01_sync_vs_background_sync_vs_background", "target": "docs_nodejs_pages_phase_7_background_work_02_job_queues_job_queues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/01-sync-vs-background.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_01_sync_vs_background_sync_vs_background", "target": "docs_nodejs_pages_phase_7_background_work_05_job_idemp