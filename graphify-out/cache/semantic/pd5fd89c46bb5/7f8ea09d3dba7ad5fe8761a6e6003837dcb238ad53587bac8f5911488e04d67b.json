{"nodes": [{"id": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure", "label": "The procedure", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_three_steps", "label": "Lift state in three steps", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove child state, pass hardcoded data from the parent, then add state and handlers. The middle step separates wiring bugs from update bugs."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_closest_parent", "label": "Closest common parent owns state", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Count components that render based on the value, not ones that only pass it through. Invent a component solely to own state if needed."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_single_source", "label": "Single source of truth", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One owner per piece, not all state in one store. The forbidden case is the same information in two places."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_inverse_data_flow", "label": "Inverse data flow", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data down as props, changes up as function calls. Name handlers for the event so the owner keeps its state shape private."}], "edges": [{"source": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure", "target": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_three_steps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_closest_parent", "target": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_three_steps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_inverse_data_flow", "target": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_naming", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_context_hole", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/01-the-procedure.md", "source_location": null,