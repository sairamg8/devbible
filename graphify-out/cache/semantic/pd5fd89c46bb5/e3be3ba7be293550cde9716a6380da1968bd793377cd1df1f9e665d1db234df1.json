{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_store_every_fact_once", "label": "Store every fact exactly once", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalization is a checklist for finding duplicated facts. Duplication permits contradiction that concurrent writers can create and the database cannot resolve."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_first_normal_form", "label": "First normal form", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One value per column. Comma-separated product_names cannot be joined, indexed, or counted without parsing; fix with a child table."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_second_normal_form", "label": "Second normal form", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No partial dependency on part of a composite key. product_name on order_items depends only on product_id, not (order_id, product_id)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_third_normal_form", "label": "Third normal form", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No dependency between non-key columns. customer_city belongs on customers, not orders. Test: every non-key column depends on the key, the whole key, and nothing but the key."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_historical_snapshot", "label": "Historical snapshot vs denormalization", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unit_cents on an order line is a different fact from products.price_cents. Copying price at sale time is required; joining would rewrite past invoices."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_denormalization", "label": "Deliberate denormalization", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade write complexity for read speed: counters, generated columns, materialized views. Measure first; prefer forms the database maintains."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_normalize_by_default", "label": "Normalize by default", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slow read is measurable and fixable later; inconsistent data is often unfixable and erodes trust. Denormalize against EXPLAIN, not a hunch."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_store_every_fact_once", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_first_normal_form", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_first_normal_form", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_second_normal_form", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_second_normal_form", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_third_normal_form", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_historical_snapshot", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_denormalization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_normalize_by_default", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_denormalization", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_denormalization", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_many", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_first_normal_form", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_many_to_many", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/normalization.html", "source_location": null, "weight": 1.0}], "hyperedges": []}