{"nodes": [{"id": "docs_expressjs_pages_phase_3_requests_08_cookies_and_helpers_page", "label": "Cookies and req helpers", "file_type": "document", "source_file": "docs/expressjs/pages/phase-3-requests/08-cookies-and-helpers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_3_requests_08_cookies_and_helpers_asymmetry", "label": "Cookie read/write asymmetry", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-3-requests/08-cookies-and-helpers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "res.cookie is built in; req.cookies needs cookie-parser. Writing Set-Cookie works without the package."}, {"id": "docs_expressjs_pages_phase_3_requests_08_cookies_and_helpers_cookie_parser", "label": "cookie-parser", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/08-cookies-and-helpers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not in Express built-in list. cookieParser('secret') populates req.signedCookies. Session middleware typically depends on cookie parsing."}, {"id": "docs_expressjs_pages_phase_3_requests_08_cookies_and_helpers_signed_cookies", "label": "Signed cookies", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/08-cookies-and-helpers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detect tampering with a server secret; they are not encryption. Still visible to the client unless httpOnly and not encrypted by default."}, {"id": "docs_expressjs_pages_phase_3_requests_08_cookies_and_helpers_req_helpers", "label": "req.accepts, req.is, req.get, req.range", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/08-cookies-and-helpers.md", "source_location": nu