{"nodes": [{"id": "docs_react_pages_phase_1_jsx_09_children_page", "label": "children", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_09_children_ordinary_prop", "label": "children is an ordinary prop", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nesting is syntax for setting it. Nesting wins over an explicit children attribute because JSX writes children last."}, {"id": "docs_react_pages_phase_1_jsx_09_children_jsx_vs_jsxs", "label": "jsx vs jsxs decides children shape", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One child is the element itself (jsx); two or more is an array (jsxs). props.children.map throws on a single child."}, {"id": "docs_react_pages_phase_1_jsx_09_children_toarray", "label": "Children.toArray", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flattens nested arrays, drops null/undefined/booleans, keeps strings and numbers, rewrites keys with a path prefix (.$k1, .2:$k2)."}, {"id": "docs_react_pages_phase_1_jsx_09_children_fragment_counts_one", "label": "A fragment child counts as one", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Children.count says 1 while markup has two elements. Layouts that branch on children.length fail when the caller wraps in a fragment."}, {"id": "docs_react_pages_phase_1_jsx_09_children_four_ways", "label": "Four ways to pass content", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default slot (children); named element props; children as a function (render prop); a slot-object of per-item functions."}, {"id": "docs_react_pages_phase_1_jsx_09_children_helpers_discouraged", "label": "Children helpers discouraged in new code", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React docs prefer composition. Helpers remain correct when you must inspect an unknown children set."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_09_children_page", "target": "docs_react_pages_phase_1_jsx_09_children_ordinary_prop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_09_children_page", "target": "docs_react_pages_phase_1_jsx_09_children_jsx_vs_jsxs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_09_children_page", "target": "docs_react_pages_phase_1_jsx_09_children_toarray", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/09-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_09_children_page", "target": "docs_react_pages_phase_1_jsx_09_children_fragment_counts_one", "relation": "references", "confidence": "EXTRACTED", "co