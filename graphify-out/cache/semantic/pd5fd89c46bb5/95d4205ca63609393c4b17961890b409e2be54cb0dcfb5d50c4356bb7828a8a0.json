{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "label": "Migrations", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A migration is a numbered file that runs exactly once, inside a transaction, with the fact recorded in the database. Drop any property and the schema is unreproducible."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_schema_migrations", "label": "schema_migrations tracking table", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "version PK, applied_at, checksum. The database records its own version. version PK answers 'has this run?' by constraint, not app logic."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_forward_only", "label": "Forward-only migrations", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Down migrations are rarely tested and cannot restore DROP COLUMN data. Recovery is a new forward file plus backup restore."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_checksum", "label": "Migration checksum", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never edit a shipped file. Runner re-hashes and fails if checksum changes, so two environments cannot share a version with different schemas."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_lexical_ordering", "label": "Lexical migration filename order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filename sort is lexical: 1, 10, 11, 2. Surfaces as 42P01 on a fresh database. Fix with zero-padding or UTC timestamps."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_timestamped_names", "label": "Timestamped migration filenames", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UTC timestamps avoid branch collisions on counter names. Ordering is authorship time, which may not be dependency order. Tools generate these."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_deploy_step", "label": "Migrations as a deploy step", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not at app boot. Failure should stop the deploy, app role should lack CREATE/ALTER, and ACCESS EXCLUSIVE must not block old instances still serving traffic."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migrations.html", "source_location": null, "weight": 1.0}, {"so