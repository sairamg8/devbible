{"nodes": [{"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "label": "Conditional rendering", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_and_zero_trap", "label": "The && zero trap", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "&& returns the falsy left operand. 0, NaN, -0 and 0n render as text. Put a boolean on the left."}, {"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_four_forms", "label": "Four conditional forms", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "&& for render-or-nothing; ternary for either/or; early return null for the whole component; lookup object for three-plus keyed states."}, {"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_position_identity", "label": "Conditionals decide identity", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same type at the same depth keeps the instance. Different depth remounts. && / ternary-to-null unmount when false."}, {"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_hooks_before_return", "label": "Early return after every hook", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A return above a hook changes hook count between renders and throws."}, {"id": "docs_react_pages_phase_1_jsx_06_conditional_rendering_key_reset", "label": "Reset a subtree with key", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not fake a remount with a conditional. <ProfileForm key={userId} /> is the deliberate reset."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "target": "docs_react_pages_phase_1_jsx_06_conditional_rendering_and_zero_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "target": "docs_react_pages_phase_1_jsx_06_conditional_rendering_four_forms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "target": "docs_react_pages_phase_1_jsx_06_conditional_rendering_position_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "target": "docs_react_pages_phase_1_jsx_06_conditional_rendering_hooks_before_return", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/06-conditional-rendering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_06_conditional_rendering_page", "target": "d