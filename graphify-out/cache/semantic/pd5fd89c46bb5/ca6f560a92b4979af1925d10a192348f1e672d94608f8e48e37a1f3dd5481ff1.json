{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_lexical_scope", "label": "Lexical scope", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function's free variables resolve where it is written, not where it is called. That is what makes closures possible."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_scope_chain", "label": "Scope chain", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup walks innermost to outermost and stops at the first match. Outer scopes never see inner bindings."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_scope_creators", "label": "What creates a scope", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functions, modules, blocks for let/const/class, for-heads with let/const, and catch. Object literals do not."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_shadowing", "label": "Shadowing", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inner binding hides the outer one for its scope without overwriting it. let cannot redeclare a parameter at function top level."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_with_statement", "label": "with statement", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Injects an object's properties into the scope chain, defeating static slot resolution. SyntaxError in strict mode."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_direct_eval", "label": "Direct eval", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can introduce bindings into the surrounding scope. Indirect eval (0, eval)(...) runs in global scope instead."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_lexical_scope", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_scope_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_scope_creators", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_lexical_scope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/the-scope-chain.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_t