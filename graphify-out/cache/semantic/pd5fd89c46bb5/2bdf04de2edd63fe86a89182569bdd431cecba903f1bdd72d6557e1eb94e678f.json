{"nodes": [{"id": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_page", "label": "Discriminated unions", "file_type": "document", "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "label": "Discriminated union", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One literal-typed property shared by every member lets the compiler tell variants apart from ===. Highest-value pattern: illegal states become unrepresentable and exhaustiveness checking becomes possible. Costs a property on every member and more verbose construction."}, {"id": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_literal_discriminant", "label": "Literal-typed discriminant", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A discriminant widened to string matches every member, so nothing is eliminated. Validate at the boundary so the validator produces the literal type."}, {"id": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_result_ok", "label": "Result ok discriminated union", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "{ ok: true; data: T } | { ok: false; error: Error } \u2014 one check gives a fully-typed branch either way, and there is no state where both data and error exist."}, {"id": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_illegal_states", "label": "Illegal states unrepresentable", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single object with optional data/error and status: string type-checks illegal combinations. The union makes those combinations unrepresentable and turns a new variant into a compile error."}], "edges": [{"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_page", "target": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "target": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_literal_discriminant", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_illegal_states", "target": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_result_ok", "target": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_page", "target": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_page", "target": "docs_typescript_syllabus_03_in_the_stack_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_05_discriminated_unions_discriminated_union", "target": "docs_typescript_syllabus_03_in_the_stack_usereducer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/05-discriminated-unions.md", "source_location": null, "weight": 1.0}], "hyperedges": []}