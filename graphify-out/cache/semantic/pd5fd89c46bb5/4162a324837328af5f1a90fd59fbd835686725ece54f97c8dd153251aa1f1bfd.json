{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_index_file", "label": "The index is a real file", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/the-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".git/index is a binary file of paths with blob hashes and cached stat data. git add writes content into the object store first."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_staging_is_a_copy", "label": "Staging is a copy, not a bookmark", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/the-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The index recorded a hash, so later edits cannot change what is staged. Enables git add -p and recovery of staged-but-uncommitted blobs via fsck --lost-found."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_merge_stages", "label": "Merge stage numbers", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/the-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 0 normally. During conflict: 1 base, 2 ours, 3 theirs. UU in status means stages 1/2/3 and no stage 0."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_cached_stat", "label": "Cached stat data", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/the-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git status skips re-hashing if size and mtime match. Network or Windows shares that lie about modes make everything look modified."}], "edges": 