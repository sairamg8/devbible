{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "label": "ORDER BY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without ORDER BY there is no row order. Sorting is free only when an index supplies the order; otherwise it spills past work_mem."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_no_default_order", "label": "No default SELECT order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A SELECT with no ORDER BY may return any order and can change after VACUUM, a plan switch, or an UPDATE that relocates a heap row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_unique_tiebreaker", "label": "Unique ORDER BY tiebreaker", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY plus LIMIT on a non-unique column is not a total order. Measured 46 duplicate page rows of 100; append the primary key."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_nulls_placement", "label": "NULLS FIRST and NULLS LAST", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default is NULLS LAST for ASC and NULLS FIRST for DESC. Indexes record null placement; a mismatch forces an in-memory sort."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_collation", "label": "Collation and libc vs ICU", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "musl Alpine sorts en_US.utf8 by byte value; glibc applies dictionary order. libc upgrades can silently corrupt text btrees."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_pin_icu_collation", "label": "Pin an ICU or builtin collation", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not inherit collation from the container image. ICU is versioned by PostgreSQL; builtin C.UTF-8 is stable byte order."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_sort_in_sql", "label": "Sort in SQL not JavaScript", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIMIT must sort server-side; sorting a page in JS reorders the wrong twenty rows."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_no_default_order", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_unique_tiebreaker", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_nulls_placement", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_collation", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_pin_icu_collation", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_collation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_sort_in_sql", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_no_default_order", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_no_defined_order", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/order-by.html", "source_location": null, "weight": 1.0}], "hyperedges": []}