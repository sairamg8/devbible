{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_default_deny", "label": "RLS default-deny empty table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ENABLE ROW LEVEL SECURITY with no policy: queries succeed and return zero rows. Not an error."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_using_vs_with_check", "label": "USING versus WITH CHECK", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "USING filters existing rows; WITH CHECK validates the row after a write. UPDATE needs both or a user can reassign owner_id. USING alone is copied into WITH CHECK."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_permissive_restrictive", "label": "Permissive OR restrictive AND", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PERMISSIVE grants (OR); RESTRICTIVE constrains (AND) and grants nothing alone. Tenant isolation is the canonical restrictive policy."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_owner_bypass", "label": "Table owners bypass RLS by default", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Superusers, BYPASSRLS, and table owners skip policies. Connecting as schema owner makes RLS a no-op and tests pass while proving nothing."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_force_row_level_security", "label": "FORCE ROW LEVEL SECURITY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the owner subject to policies. Real fix is connecting as a non-owner. Verify relrowsecurity and relforcerowsecurity."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_owner_bypass", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_force_row_level_security", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_permissive_restrictive", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_default_deny", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/01-policies.md", "source_location": null, "weight": 1.0}], "hyperedges": []}