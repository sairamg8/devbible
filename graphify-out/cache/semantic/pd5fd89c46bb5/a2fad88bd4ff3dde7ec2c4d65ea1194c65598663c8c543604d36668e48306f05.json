{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_err_code", "label": "Branch on err.code SQLSTATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never branch on err.message. Messages are localised and version-dependent. SQLSTATEs are a stable five-character contract."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_to_http", "label": "SQLSTATE to HTTP mapping", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "23505/23503 \u2192 409, 23502/23514/22P02 \u2192 400, 40001/40P01 retry then 409, 57014 \u2192 504, 53300 \u2192 503, 42xxx \u2192 500. Match constraint name, not just the code."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_detail_leak", "label": "err.detail leaks data", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "detail contains the submitted value and enables user enumeration. Log it; never serialise the raw error to a client."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_retryable_serialization", "label": "Retry 40001 and 40P01", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialization failure and deadlock are isolation machinery, not bugs. Retry the whole transaction with backoff and jitter."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_fatal_as_events", "label": "FATAL errors arrive as events", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the server terminates a connection with no in-flight query, pg emits 'error' instead of rejecting a promise."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_err_code", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_to_http", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_detail_leak", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_err_code", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_fatal_as_events", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_pool_on_error", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_retryable_serialization", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_err_code", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/errors.html", "source_location": null, "weight": 