{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_page", "label": "Startup races and advisory locks", "file_type": "document", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_if_not_exists_race", "label": "CREATE TABLE IF NOT EXISTS race", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog check and insert are not atomic. 228 of 500 concurrent attempts failed with 23505 on pg_type_typname_nsp_index."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_silent_seed_dup", "label": "Silent startup seed duplication", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 workers, 20 duplicate admin rows, zero errors. Fix with a unique constraint plus ON CONFLICT DO NOTHING."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_advisory_xact_lock", "label": "pg_advisory_xact_lock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialises bootstrap; 500 of 500 succeeded. Prefer the _xact_ form so a crash releases the lock at rollback. Session-scoped pg_advisory_lock can wedge migrations."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_idempotent_vs_safe", "label": "Idempotent vs concurrency-safe", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent means twice in sequence is the same. Concurrency-safe means twice at the same time is also correct. IF NOT EXISTS buys only the first."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_ddl_placement", "label": "Where DDL belongs", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numbered recorded migrations are the normal way. ensureSchema at startup races and is unversioned. DDL in a request handler takes ACCESS EXCLUSIVE on a live table."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_page", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_if_not_exists_race", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_idempotent_vs_safe", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_advisory_xact_lock", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_if_not_exists_race", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_silent_seed_dup", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_if_not_exists_race", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_03_startup_races_ddl_placement", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_access_exclusive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/03-startup-races.md", "source_location": null, "weight": 1.0}], "hyperedges": []}