{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_three_valued_logic", "label": "Three-valued WHERE logic", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE keeps only true. Unknown is discarded like false, silently."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_is_distinct_from", "label": "IS DISTINCT FROM", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Null-safe comparison. qty != 5 dropped the NULL row; IS DISTINCT FROM 5 kept it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_not_in_null", "label": "NOT IN with NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One NULL in the list makes every row unknown. Prefer NOT EXISTS for subqueries."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_sargable", "label": "Sargable predicates", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An index on col serves bare col. date(created_at) or lower(email) needs a matching expression index."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_between_half_open", "label": "Half-open time ranges", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BETWEEN is inclusive on both ends and double-counts midnight boundaries. Use >= start AND < end."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_is_distinct_from", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_not_in_null", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_sargable", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_case_insensitive", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_between_half_open", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_where_predicates_three_valued_logic", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/where-predicates.html", "source_location": null, "weight": 1.0}], "hyperedges": []}