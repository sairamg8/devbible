{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_recursive_cte_cycles_and_limits_cycle_clause", "label": "CYCLE clause", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/recursive-cte/cycles-and-limits.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PG 14+. CYCLE id SET is_cycle USING path flags the row where the loop closed and stops. Only option that reports the cycle. A self-referencing FK does not prevent cycles."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_recursive_cte_cycles_and_limits_search_clause", "label": "SEARCH DEPTH/BREADTH FIRST", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/recursive-cte/cycles-and-limits.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates a sortable ord column; you must still ORDER BY ord. DEPTH FIRST follows each branch to its end \u2014 what a rendered tree needs."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_recursive_cte_cycles_and_limits_depth_guard", "label": "Recursive depth guard", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/recursive-cte/cycles-and-limits.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE t.d < N bounds work unconditionally. Cannot tell a legitimately deep tree from a loop. Measured: 8-row table produced 107 rows before d < 40 stopped it. UNION instead of UNION ALL dedups but fails if rows carry a depth/path column."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_recursive_cte_cycles_and_limits_cycle_clause", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_recursive_cte_cycles_and_limits_depth_guard", "relation": "co