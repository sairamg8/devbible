{"nodes": [{"id": "docs_git_pages_phase_0_how_git_stores_things_02_commit_is_a_snapshot", "label": "A commit is a snapshot not a diff", "file_type": "document", "source_file": "docs/git/pages/phase-0-how-git-stores-things/02-commit-is-a-snapshot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_02_commit_is_a_snapshot_snapshot_model", "label": "Snapshot model", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/02-commit-is-a-snapshot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every commit names a complete tree. Diffs are derived. Unchanged files reuse existing blobs so snapshots are cheap."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_02_commit_is_a_snapshot_packfile_deltas", "label": "Packfile delta compression", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/02-commit-is-a-snapshot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deltas are a packfile storage layer. No command's behaviour depends on them; 51 loose objects packed to 6.03 KiB on git 2.55.0."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_02_commit_is_a_snapshot_commit_object", "label": "Commit object contents", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/02-commit-is-a-snapshot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_git_pages_phase_0_how_git_stores_things_02_commit_is_a_snapshot", "target": "docs_git_pages_phase_0_how_git_stores_things_03_object_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/02-commit-is-a-snapshot.m