{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_page", "label": "Testing against a real PostgreSQL", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_per_test_rollback", "label": "Per-test transaction rollback", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.66 ms vs 42.50 ms truncate+reseed with 2000 seed rows. Parallel-safe because nothing commits."}, {"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_sequences", "label": "Sequences are not transactional", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolled-back insert still consumes an id. Never assert on a literal id."}, {"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_inject_client", "label": "Tests must inject the executor", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code using pool.query cannot see uncommitted fixtures. The harness enforces the executor contract."}, {"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_savepoint_wrap", "label": "BEGIN/COMMIT remapped to savepoints", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL has no nested transactions. Inner COMMIT ends the test transaction. Map to SAVEPOINT / RELEASE / ROLLBACK TO."}, {"id": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_commit_suite", "label": "Committed test suite", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred constraints, LISTEN/NOTIFY, and two-connection lock tests need real COMMIT and TRUNCATE cleanup."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_page", "target": "docs_postgresql_pages_phase_9_api_crud_12_client_propagation_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_inject_client", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_01_the_executor_contract_executor", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_inject_client", "target": "docs_postgresql_pages_phase_9_api_crud_12_client_propagation_split_tx", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/16-testing-real-pg.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_sequences", "target": "docs_postgresql_pages_phase_9_api_crud_16_testing_real_pg_per_test_rollback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase