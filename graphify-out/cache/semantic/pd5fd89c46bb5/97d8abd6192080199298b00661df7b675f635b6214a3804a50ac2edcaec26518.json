{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_questions", "label": "Three different questions", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How many orders, how many have a total, how many different coupons \u2014 spelled almost identically."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_count_forms", "label": "Three count forms", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) counts rows. count(expr) counts non-NULL. DISTINCT then de-duplicates survivors and does not bring NULLs back. count(DISTINCT coupon)=2, not 3."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_count_1_folklore", "label": "count(1) is not faster than count(*)", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "26.73 vs 28.35 ms, identical plans, buffers=3783. count(*) is 'no argument'; the executor counts tuples. Scan is the cost."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_distinct_row_constructor", "label": "count(DISTINCT (a, b)) row constructor", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(DISTINCT a, b) parses as two-argument count and fails 42883. Wrap columns in a row constructor."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_composite_null_counted", "label": "A row containing NULL is not NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(DISTINCT (status, coupon)) is 4 including (open,NULL) and (cancelled,NULL). Composite comparison uses IS NOT DISTINCT FROM per field."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_questions", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_count_forms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_count_forms", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_null_skipping_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_count_forms", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_null_grouping_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/01-three-questions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_