{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rest_resources", "label": "REST resource modeling", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resources are nouns. Collections are lists of them. Prefer /orders/12/items over /getOrderItems."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_collection_item_subresource", "label": "Collection, item, and sub-resource", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /users list+POST create; GET /users/:id read/update/delete one; /users/:id/orders owned hierarchy."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rpc_style", "label": "RPC-style action routes", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine when the domain is an action, not a thing \u2014 POST /payments/:id/refund. Name them honestly instead of inventing fake nouns. Acceptable for multi-step operations that are not natural CRUD."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_static_before_param", "label": "Static segments before :id", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/users/export is captured by :id if the param route is registered first. Static segments first."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_deep_hierarchy_tradeoff", "label": "Deep hierarchy vs flatten", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep hierarchies mirror the domain and complicate authorization and caching. Flatten when joins explode."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rest_resources", "target": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_collection_item_subresource", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rest_resources", "target": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rpc_style", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_static_before_param", "target": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_rest_resources", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_deep_hierarchy_tradeoff", "target": "docs_expressjs_pages_phase_6_rest_surface_01_rest_resources_collection_item_subresource", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/01-rest-resources.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_p