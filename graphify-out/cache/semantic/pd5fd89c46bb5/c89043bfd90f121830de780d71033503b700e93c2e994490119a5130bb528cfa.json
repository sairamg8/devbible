{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_top_n_per_group", "label": "Top-N per group", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three shapes: row_number + filter, DISTINCT ON (top-1), LATERAL LIMIT. Winner depends on group count versus table size."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_run_condition", "label": "Run Condition", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15+ pushes outer WHERE rn <= N into WindowAgg for monotonic functions (row_number, rank, dense_rank, count). Emitted 15000 instead of 500000; the Sort still processes all rows."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_distinct_on_top1", "label": "DISTINCT ON top-1", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shortest PostgreSQL-only top-1 per key. Cannot return N > 1. Measured 546.62 ms without index on this table."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_lateral_top_n", "label": "LATERAL top-N per group", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wins when the driving set is small and each probe is indexed. Timed out at 30s without an index (5000 full scans); 906.59 ms with one. Only form that takes OFFSET per group."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_index_made_it_slower", "label": "Non-covering window index made top-N slower", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index Scan (not Index Only Scan) because id was not in the index: 434.74 ms / 3783 buffers \u2192 533.67 ms / 500574 buffers. INCLUDE selected columns, or keep the sequential scan. Compare Buffers, not just milliseconds."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_top_n_per_group", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_run_condition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_top_n_per_group", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_distinct_on_top1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_top_n_per_group", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_top_n_per_group_lateral_top_n", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/02-top-n-per-group.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_02_