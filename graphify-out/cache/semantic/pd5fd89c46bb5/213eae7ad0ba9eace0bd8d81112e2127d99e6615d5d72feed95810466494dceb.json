{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_err_code", "label": "Error codes not messages", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messages are prose and get reworded. code is a stable contract (ENOENT, ERR_USER_NOT_FOUND). instanceof can fail if the class module is duplicated."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_custom_error_class", "label": "Custom error class", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend Error, set name and a stable code, carry structured context as properties, forward options so {cause} works."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_error_cause", "label": "error.cause", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard wrap that keeps the root error attached. Wrap when adding information; rethrow bare otherwise."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_aggregate_error", "label": "AggregateError", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several failures in one error (.errors). Promise.any throws one when every input rejects."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_operational_vs_programmer", "label": "Operational versus programmer errors", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational (timeout, 404, disk full) are handled. Programmer (TypeError) crash and restart \u2014 retrying reproduces the bug."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_err_code", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_custom_error_class", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_error_cause", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_custom_error_class", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_aggregate_error", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_any", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_operational_vs_programmer", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_custom_error_class", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-design.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_error_cause", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_err