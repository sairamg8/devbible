{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_page", "label": "SQL in .sql files, not template literals", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL in JS strings is invisible to formatters, linters and psql. Files cost a loader and restore tooling, diffs and a boundary against concatenation."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_loader", "label": "sql() file loader", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolve from import.meta.url, cache in a Map in production. process.cwd() works in tests and fails in production."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_multi_statement", "label": "Multi-statement .sql result array", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No params: simple protocol, query() is an array, res.rows is undefined. Non-empty params: 42601 cannot insert multiple commands. Keep app query files to one statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_named_params", "label": "Named SQL parameters", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comment headers or a :name shim that emits real $n placeholders. Regex must not rewrite :: casts. Values never enter SQL text."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_issuing_ddl_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_sql_files_multi_statement", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_issuing_ddl_protocols", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/sql-files.html", "source_location": null, "weight": 1.0}], "hyperedges": []}