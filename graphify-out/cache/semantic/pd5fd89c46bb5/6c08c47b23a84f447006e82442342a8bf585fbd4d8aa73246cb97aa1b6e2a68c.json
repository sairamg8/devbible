{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_module_scope_pool", "label": "Module-scope pg.Pool", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create one Pool at module scope and share it. Construction opens nothing; the first query opens the first connection."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_lazy_connection", "label": "Lazy pool connection", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Pool() performs no I/O. A bad host surfaces as ECONNREFUSED on the first query, so boot with SELECT 1."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_pool_on_error", "label": "pool.on('error') is mandatory", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An idle connection killed by the server emits 'error' on the pool. Unhandled, that is an uncaught exception that kills the process."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_application_name", "label": "application_name", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows up in pg_stat_activity so every connection is attributable to a service."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_one_pool_per_process", "label": "One pool per process", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two pools of max 10 are 20 connections against a shared max_connections of 100. Exceptions: replica pool, dedicated LISTEN Client, short-lived script pool."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_module_scope_pool", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_lazy_connection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_pool_on_error", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_module_scope_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_one_pool_per_process", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_module_scope_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_module_scope_pool", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/install-wire.htm