{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_07_update_update", "label": "UPDATE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_update_from", "label": "UPDATE FROM join update", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM supplies rows, WHERE joins, SET reads source columns. Unmatched targets stay untouched. Duplicate sources pick one row arbitrarily with no error."}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_duplicate_source_trap", "label": "UPDATE FROM duplicate-source trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three candidate prices, rowCount 1, one value chosen arbitrarily. MERGE rejects the same input with 21000. Deduplicate with DISTINCT ON if staying on UPDATE FROM."}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_lost_update", "label": "Lost update from read-modify-write", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 concurrent SELECT-then-UPDATE increments produced 2 with no errors. SET qty = qty + 1 produced 20 under a row lock."}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_inplace_increment", "label": "In-place increment SET qty = qty + 1", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the new value is a function of the old one, compute it in SQL. Otherwise FOR UPDATE, optimistic version, or SERIALIZABLE plus 40001 retry."}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_coalesce_patch", "label": "COALESCE PATCH semantics", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET col = COALESCE($n, col) leaves omitted fields alone but cannot set a column to null. For that, build SET from present keys over an allowlist."}, {"id": "docs_postgresql_pages_phase_4_crud_07_update_mvcc_tuple_version", "label": "UPDATE writes a new tuple version", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never in-place. Dead versions await VACUUM. Non-HOT updates also add index entries. SET x = x is not free."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_07_update_update", "target": "docs_postgresql_pages_phase_4_crud_05_returning_returning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_07_update_duplicate_source_trap", "target": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_07_update_lost_update", "target": "docs_postgresql_pages_phase_4_crud_07_update_inplace_increment", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_07_update_coalesce_patch", "target": "docs_postgresql_pages_phase_4_crud_15_expressions_coalesce", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_07_update_mvcc_tuple_version", "target": "docs_postgresql_pages_phase_4_crud_11_delete_delete_does_not_shrink", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/07-update.md", "source_location": null, "weight": 1.0}], "hyperedges": []}