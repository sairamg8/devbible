{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_health_checks", "label": "Health checks \u2014 liveness vs readiness", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/health-checks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_liveness", "label": "liveness probe", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/health-checks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kill me if I am stuck. Must depend on almost nothing. A DB check here turns a dependency blip into a restart storm."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_readiness", "label": "readiness probe", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/health-checks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop sending me traffic if I cannot serve. Allowed to check the pool (select 1, short timeout). Fail first on SIGTERM so the balancer drains before exit."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_accepting_traffic", "label": "acceptingTraffic flag", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/health-checks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flip true only after config, pools, and listen. Flip false on SIGTERM before closing the server."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_health_checks", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_health_checks_live