{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_tuple_comparison_tuple_comparison", "label": "Row constructors and tuple comparison", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/tuple-comparison.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a, b) > ($1, $2) is lexicographic. It replaces an OR chain the planner handles worse."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_tuple_comparison_keyset_pagination", "label": "Keyset pagination", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/tuple-comparison.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seek to the last row's sort key. Tuple, ORDER BY, and index must match; the last column must be unique."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_tuple_comparison_null_trap", "label": "NULL in a row constructor", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/tuple-comparison.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(1,NULL) < (1,2) is unknown. WHERE discards it, so pagination silently stops. Only paginate NOT NULL columns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_tuple_comparison_opaque_cursor", "label": "Opaque keyset cursor", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/tuple-comparison.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round-trip both values as one server-issued token. Base64 is not encryption; validate types before binding."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_tuple_comparison_keyset_pagination", "target": "build_css_p2_docs_postg