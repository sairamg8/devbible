{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "label": "Mocking \u2014 mock.fn, mock.method and mock timers", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_tmock", "label": "t.mock auto-restore", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "t.mock restores everything it touched when the test ends; the top-level mock does not and leaks into later tests. Use t.mock unless you have a reason not to, or call mock.restoreAll() in afterEach."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_fn", "label": "mock.fn", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_method", "label": "mock.method spy versus stub", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two arguments spies (original still runs); a third argument stubs. Spy when the real behaviour is harmless."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_timers", "label": "mock.timers", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mock timers and real I/O do not mix \u2014 faked setTimeout also fakes a query's internal timeouts. Enable only the APIs you need."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_fetch", "label": "Mocking fetch", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine for unit-testing response mapping. For headers, retries, timeouts or AbortSignal, use a real ephemeral server."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_tmock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_fn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking_mock_timers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/mocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_mocking", "target": "build_css_p2_docs_nodejs_