{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_connect", "label": "pool.connect checkout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes a connection out of the pool until release(). A fourth request against max 3 queues; leaks present as latency, not exceptions."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_client_release", "label": "client.release()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the connection for reuse. Does not close it or roll anything back. Always call it in finally."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_release_true", "label": "release(true) destroys the connection", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use after FATAL, client-side query_timeout, or unknown session state. Cheaper than poisoning later borrowers."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_with_transaction", "label": "withTransaction helper", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN/COMMIT on one checked-out client; wrap ROLLBACK so a dead connection does not mask the original error; release in finally."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_discard_all", "label": "DISCARD ALL before release", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "release() does not reset the session. SET search_path, temp tables and open transactions persist. DISCARD ALL cannot run inside a transaction."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_counters", "label": "Pool totalCount idleCount waitingCount", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sustained waitingCount > 0 means undersized pool, slow queries, or a leak. A leak also pins idleCount at 0 with totalCount at max."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_connect", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_client_release", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_with_transaction", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_pool_vs_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_release_true", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_query_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_discard_all", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_options_passthrough", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_counters", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_connect", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_discard_all", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_named_prepared_statements", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connect-release.html", "source_location": null, "weight": 1.0}], "hyperedges": []}