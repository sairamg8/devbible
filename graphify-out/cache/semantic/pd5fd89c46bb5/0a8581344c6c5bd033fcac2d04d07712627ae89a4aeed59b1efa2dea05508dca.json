{"nodes": [{"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_streaming_and_downloads", "label": "Streaming and downloads", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "res.sendFile and res.download stream files with safer path options. For big dynamic bodies, pipe a stream and handle errors mid-flight."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_sendfile", "label": "res.sendFile", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves one file inline on a route. Use when the file is chosen by logic \u2014 auth, tenancy, a lookup. Path must be absolute unless root is set. Errors arrive in the callback, not as thrown exceptions."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_download", "label": "res.download", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "res.sendFile plus Content-Disposition: attachment. Transfers the file as an attachment with a filename you choose."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_attachment", "label": "res.attachment", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets Content-Disposition and infers Content-Type from the extension. Must run before the body is sent."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_root_option", "label": "sendFile root option", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When root is set, Express validates the relative path resolves within that root \u2014 the documented traversal guard. Without it, path.join of client input can escape to ../../etc/passwd."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_stream_pipeline", "label": "stream.pipeline over pipe", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare .pipe() leaves the source open when the destination fails or the client disconnects, leaking handles. pipeline destroys every stream in the chain on failure."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_headers_before_first_byte", "label": "Set headers before first stream byte", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once the stream writes, status and headers are frozen. A mid-flight failure leaves a truncated 200. Validate and authorise before the pipe starts. The catch only logs; it cannot rescue the response."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_compression", "label": "compression middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compressing in Node costs event-loop time. Terminate gzip at Nginx or the CDN when you have one. Never double-compress. Use the middleware when Express is the edge or you need per-route control."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_signed_urls", "label": "Signed URL offload", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When files are large or private, issue a signed URL to object storage. Node then spends no bandwidth, memory, or event-loop time on the transfer."}, {"id": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_stream_vs_buffer", "label": "Stream vs buffer trade-off", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streaming keeps memory flat regardless of payload size. You give up changing status after the first byte. Buffering keeps error handling simple until size makes it untenable."}], "edges": [{"source": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_download", "target": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_sendfile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_download", "target": "docs_expressjs_pages_phase_4_responses_08_streaming_and_downloads_res_attachment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/08-streaming-and-downloads.md", "source_l