{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_checking_vs_transpiling_checking_vs_transpiling", "label": "Checking is not transpiling", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/checking-vs-transpiling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transpiler reads one file; a checker reads the whole program. That structural difference is why esbuild is fast, cannot type-check, and why isolatedModules exists."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_checking_vs_transpiling_emit_declaration_only", "label": "tsc --emitDeclarationOnly", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/checking-vs-transpiling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transpilers cannot emit .d.ts because declarations need the type graph they skip. Publishing always involves tsc even when JS is bundled elsewhere."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_checking_vs_transpiling_split_pipeline", "label": "Separate typecheck and build scripts", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/checking-vs-transpiling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dev: vite; build: vite build; typecheck: tsc --noEmit; ci: typecheck && test && build. Nothing depends on the build catching type errors."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_verbatim_module_syntax", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_checking_vs_transpiling_checking_vs_transpiling", "relation": "references", "confidence": "E