{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_connection_and_auth_connection_uri", "label": "PostgreSQL connection URI", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/connection-and-auth.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgresql://USER:PASSWORD@HOST:PORT/DATABASE, or PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE. DATABASE_URL is an app convention, not read by psql."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_connection_and_auth_pg_hba", "label": "pg_hba.conf", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/connection-and-auth.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides who may connect how (trust, scram-sha-256, peer) from which addresses. Managed providers force TLS plus password/SCRAM."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_connection_and_auth_sqlstate_28p01", "label": "SQLSTATE 28P01", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/connection-and-auth.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "invalid_password / authentication failure. Map this when diagnosing auth failures from Node."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_connection_and_auth_inet_server_port", "label": "inet_server_port vs published port", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/connection-and-auth.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "inet_server_port() is the listen port inside the container (5432), not the host-published port (55432)."}, {"id": "bui