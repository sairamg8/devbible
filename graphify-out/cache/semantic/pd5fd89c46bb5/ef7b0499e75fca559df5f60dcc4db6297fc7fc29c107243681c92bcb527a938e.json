{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc", "label": "MVCC: row versions and snapshots", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_mvcc", "label": "MVCC", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL never overwrites a row. UPDATE writes a new version and marks the old one ending; DELETE only stamps xmax. Explains lock-free reads, table growth, and why VACUUM exists."}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_xmin_xmax_ctid", "label": "xmin xmax ctid", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_snapshot", "label": "MVCC snapshot xmin:xmax:in-progress", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visible if xmin committed before the snapshot and is not in-progress, and xmax is absent or not yet committed. xmax is one past the last completed transaction."}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_readers_never_block", "label": "Readers never block writers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_hot_update", "label": "HOT update", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New version on the same page and no indexed column changed, so indexes stay untouched. fillfactor 100 \u2192 0.1% HOT and 24 MB; fillfactor 70 \u2192 76.6% HOT and 13 MB; index on updated column \u2192 0% HOT."}, {"id": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_fillfactor", "label": "fillfactor for update-heavy tables", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_05_mvcc", "target": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_mvcc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_mvcc", "target": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_xmin_xmax_ctid", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_mvcc", "target": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_snapshot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_readers_never_block", "target": "docs_postgresql_pages_phase_11_mvcc_05_mvcc_mvcc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/05-mvcc.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_page