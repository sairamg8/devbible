{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_planner_wal", "label": "Planner costs, WAL, and changing a setting", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings that decide whether the planner picks an index are one-line, no-restart changes. pg_settings.context values sandbox-measured on PG 18.4."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_random_page_cost", "label": "random_page_cost = 4 models spinning disk", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On SSD/NVMe use 1.1. Leaving 4.0 over-costs index scans so the planner ignores indexes. Highest-value one-line change; test with EXPLAIN first."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_default_statistics_target", "label": "default_statistics_target", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 100. Raise per-column (SET STATISTICS 250\u2013500) for skewed data rather than globally. Correlated columns want CREATE STATISTICS."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_jit", "label": "jit default on", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helps long analytics; can add overhead to short queries mis-costed above the JIT threshold. Test SET jit = off after upgrades."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_max_wal_size", "label": "max_wal_size checkpoint loop", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 GB default on write-heavy systems forces frequent checkpoints and full-page write bursts. Raise to several GB; cost is longer crash recovery."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_fsync", "label": "fsync = off risks corruption", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never off on real data. synchronous_commit = off is the safe durability trade: can lose recent commits, no corruption."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_synchronous_commit", "label": "synchronous_commit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe way to trade durability for speed. With empty synchronous_standby_names, remote_apply/remote_write/local behave like on."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_lock_timeout", "label": "lock_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 0 (wait forever). Essential for safe DDL. User context; set per role so migrations are not killed by web limits."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_statement_timeout", "label": "statement_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounds a single statement. Default 0. Set per role, not globally. Not a substitute for lock_timeout."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_idle_in_transaction_session_timeout", "label": "idle_in_transaction_session_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kills transactions left open. Default 0. Worst blockers of vacuum and DDL hold locks while doing nothing."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_random_page_cost", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_seq_scan_hint", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_fsync", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_synchronous_commit", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_lock_timeout", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_timeout_retry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/02-planner-wal-and-changing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}