{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_copy_streams_pg_copy_streams", "label": "pg-copy-streams COPY FROM STDIN", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/copy-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns client.query into a writable stream. Needs a checked-out client; COPY puts the connection in a distinct protocol mode."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_copy_streams_pipeline_not_pipe", "label": "pipeline not .pipe() for COPY", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/copy-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pipeline propagates errors and destroys both ends. .pipe() leaves the connection stuck mid-COPY and returns a broken client to the pool."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_copy_streams_csv_vs_text", "label": "COPY csv vs text format", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/copy-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default is text (tab, \\N for NULL). Feeding CSV to default COPY puts the whole line in the first column. In CSV an unquoted empty field is NULL; \"\" is empty string."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_copy_streams_staging_table", "label": "UNLOGGED staging table for COPY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/copy-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COPY is all-or-nothing with no skip. Load 