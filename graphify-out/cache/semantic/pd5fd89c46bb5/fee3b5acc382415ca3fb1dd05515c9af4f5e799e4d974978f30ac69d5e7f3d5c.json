{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence", "label": "Sequence", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate object whose state is deliberately outside the transaction. Every surprising sequence behaviour follows from that."}, {"id": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence_gaps", "label": "Sequence gaps", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four attempts produced ids 1 and 4. Required for concurrency: transactional nextval would serialise all inserts. CACHE and crash recovery also leave holes."}, {"id": "docs_postgresql_pages_phase_3_ddl_14_sequences_gapless_counter", "label": "Gapless counter row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invoice numbers cannot use a sequence. UPDATE counters SET n = n + 1 RETURNING n serialises every insert on that counter. Gapless and concurrent are mutually exclusive."}, {"id": "docs_postgresql_pages_phase_3_ddl_14_sequences_owned_by", "label": "ALTER SEQUENCE OWNED BY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lifecycle only: owned sequences drop with the table (serial/identity). Hand-created sequences survive DROP TABLE. Does not restrict nextval."}, {"id": "docs_postgresql_pages_phase_3_ddl_14_sequences_returning_over_currval", "label": "RETURNING id over currval", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "currval is session state (55000 if unused). lastval() silently changes if a trigger consumes another sequence. RETURNING is unambiguous and one round trip."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence", "target": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence_gaps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_14_sequences_gapless_counter", "target": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence_gaps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_generated_always_as_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_14_sequences_owned_by", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_serial", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_14_sequences_returning_over_currval", "target": "docs_postgresql_pages_phase_3_ddl_14_sequences_sequence", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/14-sequences.md", "source_location": null, "weight": 1.0}], "hyperedges": []}