{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_fs_promises", "label": "node:fs/promises", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/fs-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default filesystem API. Every operation returns a promise; errors are exceptions with a code; nothing blocks the event loop."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_err_code", "label": "err.code", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/fs-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch on code (ENOENT, EEXIST, EACCES, ENOSPC, EMFILE, EXDEV), never message text. Swallowing all errors hides EACCES as empty config."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_rename", "label": "rename atomicity", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/fs-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic within one filesystem: readers see old or new, never a partial write. Across devices throws EXDEV."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_async_thread_pool", "label": "fs/promises thread pool overlap", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/fs-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200 async reads 45 ms with 23 timer ticks vs 200 sync 86 ms and 0 ticks. Unbounded Promise.all still hits EMFILE."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_fs_promises", "target": "build_css_p2_docs_nodejs_