{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_deadline_propagation_deadline_propagation", "label": "Deadline propagation", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/deadline-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thread one AbortSignal through every layer so a cancelled request stops the DB, outbound calls and worker slot it started."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_deadline_propagation_abortsignal_any", "label": "AbortSignal.any composition", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/deadline-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compose timeout, client disconnect and shutdown; whichever fires first cancels the shared signal."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_deadline_propagation_cooperative_cancellation", "label": "Cooperative cancellation", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/deadline-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signal is not preemptive. Loops must throwIfAborted; a synchronous JSON.parse cannot be interrupted."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_deadline_propagation_stops_at_queue", "label": "Propagation stops at the queue", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/deadline-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cancelled request must not cancel work already enqueued or already committed."}], "edges": [{"source": "build_css_p2_d