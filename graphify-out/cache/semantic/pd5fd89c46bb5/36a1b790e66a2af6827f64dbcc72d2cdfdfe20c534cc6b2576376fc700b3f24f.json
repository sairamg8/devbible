{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_when_it_pays", "label": "When FILTER pays", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER is not faster than CASE. It is faster than one subquery per number: 4\u00d7 the buffers and 2.5\u00d7 the time."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_vs_scalar_subqueries", "label": "FILTER vs four scalar subqueries", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER 65.45 ms / 3783 buffers; CASE 65.14 ms / 3783; four subqueries 161.21 ms / 15132. Buffer ratio is exactly the number of scans."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_not_scan_filter", "label": "FILTER is not a scan filter", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No index can serve a FILTER predicate. One aggregate should use WHERE. FILTER pays from the second aggregate onwards."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_vs_group_by_shape", "label": "FILTER vs GROUP BY shape", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither is faster (65 vs 72 ms). FILTER: one row, N columns, zeros for absent categories, frozen set. GROUP BY: N rows, omits empty categories, discovers new ones."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_on_window", "label": "FILTER on aggregate window functions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clause order is aggregate(...) FILTER (WHERE \u2026) OVER (\u2026). row_number/rank/lag are not aggregates and reject FILTER."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_error_42809", "label": "42809 FILTER on a non-aggregate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wrong_object_type. Also what you get from a misspelled aggregate name rather than 'does not exist'."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_when_it_pays", "target": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_vs_scalar_subqueries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_02_when_it_pays_filter_vs_scalar_subqueries", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_compare_buffers", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/02-when-it-pays.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgre