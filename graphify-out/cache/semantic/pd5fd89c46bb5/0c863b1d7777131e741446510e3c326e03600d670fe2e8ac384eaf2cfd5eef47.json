{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pg_cursor", "label": "pg-cursor streaming", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs a checked-out client. read(n) until empty array, then close() then release(). Live set is one batch regardless of result size."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pool_query_buffering", "label": "pool.query buffers the whole result", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "300000 rows grew the heap by 101 MB, proportional to row count. The first row is unavailable until the last arrives."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_declare_needs_transaction", "label": "DECLARE cursor needs a transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FETCH after COMMIT is 34000 cursor does not exist. WITH HOLD materialises the whole result at commit. pg-cursor uses a protocol portal bound to the connection."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_keyset_batching", "label": "Keyset batching instead of a cursor", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each chunk is a short pooled transaction: no long snapshot, no held client, interruptible. A cursor is right only when the export must reflect one point in time."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_xmin_horizon", "label": "Long cursor pins xmin horizon", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A twenty-minute stream is twenty minutes of no VACUUM database-wide. Hidden cost of streaming a large result."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pg_cursor", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_session_state_needs_checkout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pool_query_buffering", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pg_cursor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_keyset_batching", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_pg_cursor", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/cursors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_cursors_xmin_horizon", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_idle_in_transaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/pos