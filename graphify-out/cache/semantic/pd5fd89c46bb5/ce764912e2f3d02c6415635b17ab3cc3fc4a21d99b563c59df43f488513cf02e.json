{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_05_api_testing_page", "label": "API testing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/05-api-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make HTTP requests. Do not fake req/res. fetch + listen(0) or supertest 7.2.2 against express 5.2.1."}, {"id": "docs_nodejs_pages_phase_9_testing_05_api_testing_ephemeral_server", "label": "Ephemeral real server", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/05-api-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boot the real app so middleware runs. Bind 127.0.0.1 not localhost (verbatim DNS can yield ::1). Close in after; closeAllConnections if keep-alive hangs."}, {"id": "docs_nodejs_pages_phase_9_testing_05_api_testing_listen_zero", "label": "listen(0) ephemeral port", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/05-api-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded ports plus file-parallelism produce EADDRINUSE as a race. Read server.address().port after listen(0)."}, {"id": "docs_nodejs_pages_phase_9_testing_05_api_testing_supertest", "label": "supertest", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/05-api-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts the app on an ephemeral port, chained .expect() for status/headers/body. Empty res.body usually means missing Content-Type. Pick fetch or supertest, not both."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_05_api_testing_page", "target": "docs_nodejs_pages_phase_9_testing_05_api_testing_ephemeral_server", "relation": "references", "confidence": "EXT