{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_page", "label": "Render, reconcile, commit", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_render_phase", "label": "Render phase", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React calls component functions to get elements. Repeatable and discardable. DOM still shows previous UI."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_reconcile_phase", "label": "Reconcile phase", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diffs the new element tree against the current one. Part of render; can be thrown away."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_commit_phase", "label": "Commit phase", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies DOM operations, then refs, layout effects, passive effects. Cannot be thrown away."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_render_must_be_pure", "label": "Render must be pure", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React may call it more than once and throw the result away. Observable work in the body happens an uncontrolled number of times."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_children_first", "label": "Children commit before parents", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refs and layout effects run bottom-up so a parent can assume children's DOM exists."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_useeffect", "label": "useEffect after paint", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default place for fetching, subscriptions, logging, timers."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_uselayouteffect", "label": "useLayoutEffect before paint", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measure or mutate DOM before the user sees the frame. Blocks painting."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_render_reconcile_commit_root_render_async", "label": "root.render() schedules work", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/render-reconcile-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": n