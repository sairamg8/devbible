{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_15_web_streams_web_streams", "label": "Web Streams", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/15-web-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHATWG ReadableStream, WritableStream, TransformStream. Globals in Node since v18. fetch bodies are web streams."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_15_web_streams_toweb_fromweb", "label": "Readable.toWeb and fromWeb", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/15-web-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Convert at the boundary. Node chunks are Buffers; web chunks are Uint8Array. Each conversion adds a queue \u2014 convert once."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_15_web_streams_fetch_body", "label": "fetch Response.body", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/15-web-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ReadableStream. pipeline(Readable.fromWeb(res.body), createWriteStream) streams a download; res.arrayBuffer buffers the whole file."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_15_web_streams_locking_and_tee", "label": "Web stream locking and tee", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/15-web-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one reader; getReader/for await/pipeTo lock. res.json() then res.text() fails. tee/clone buffers the slower branch."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_15_web_streams_prefer_node_streams", "label": "Default to Node streams in Node", "file_type": "rat