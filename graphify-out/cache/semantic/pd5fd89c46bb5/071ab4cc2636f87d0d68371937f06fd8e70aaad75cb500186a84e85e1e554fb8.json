{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_page", "label": "Multicolumn indexes and column order", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_leftmost_prefix_rule", "label": "Leftmost-prefix rule", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index on (a,b,c) serves (a), (a,b), (a,b,c) but not b or c alone. Phone-book order: surname then first name."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_skip_scan", "label": "PostgreSQL 18 skip scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can probe once per distinct leading value when that column has few distincts (Index Searches: 7). Not chosen for 5000-value leading columns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_equality_then_range", "label": "Equality then range column order", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Put equality predicates first, then the range/sort column. (user_id, created_at) used 23 buffers vs 396 for the reverse order."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_leftmost_prefix_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_skip_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_equality_then_range", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_skip_scan", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_leftmost_prefix_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_unused_indexes_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/multicolumn.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_multicolumn_leftmost_prefix_rule", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_fk_indexes_missing_fk_index_audit", "relation": "conceptually_related_to", "confide