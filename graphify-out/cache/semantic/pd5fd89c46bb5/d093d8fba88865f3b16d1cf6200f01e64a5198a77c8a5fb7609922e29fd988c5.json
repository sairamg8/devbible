{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_in_operator", "label": "in operator", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walks the prototype chain, so user keys like constructor match Object.prototype. Throws TypeError on primitives, null, and undefined \u2014 unlike property access, in does not auto-box."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_object_hasown", "label": "Object.hasOwn", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES2022 static own-only check. Works on null-prototype objects, immune to a shadowed hasOwnProperty, and coerces primitives instead of throwing."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_hasownproperty", "label": "Object.prototype.hasOwnProperty", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy own-only check looked up on the receiver, so Object.create(null) throws and a JSON hasOwnProperty key can lie."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_hasownproperty_call", "label": "hasOwnProperty.call fallback", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object.prototype.hasOwnProperty.call(obj, prop) bypasses null-prototype and shadowing. Keep only for pre-ES2022 runtimes."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_capability_vs_data", "label": "in for behaviour, hasOwn for data", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature detection needs the chain (DOM methods live on prototypes). Dictionary keys from users must be own-only or constructor/toString become true."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_capability_vs_data", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_in_operator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_capability_vs_data", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_in_and_hasown_object_hasown", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/existence-checks-and-delete/in-and-hasown.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p