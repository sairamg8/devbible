{"nodes": [{"id": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_error_first_convention", "label": "Error-first callback convention", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/02-error-first.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An async callback cannot throw \u2014 the stack is gone \u2014 so the error travels as data in position zero. On success the first argument is null, not omitted."}, {"id": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_missing_return", "label": "Missing return after if (err)", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/02-error-first.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike catch, an if does not end the block. Fall-through starts the success path with undefined and points the stack trace at the wrong function."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_error_first_convention", "target": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_complete_when_stack_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/02-error-first.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_missing_return", "target": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_error_first_convention", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/02-error-first.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_04_callbacks_02_error_first_error_first_convent