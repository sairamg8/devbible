{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_schema_namespace", "label": "Schema as namespace", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A namespace inside a database. Also used for extensions, staging areas, and GRANT USAGE access-control boundaries."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "label": "search_path", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default \"$user\", public. The same SELECT FROM items returned different rows under tenant_a vs tenant_b. Most dangerous session setting in a pooled app."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_shared_tables_tenant_id", "label": "Shared tables with tenant_id", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheapest layout; one missing WHERE leaks. Pair with row-level security so the guarantee travels with the row."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_schema_per_tenant", "label": "Schema per tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong search_path shows an empty table, not another tenant. Stops scaling around the low thousands (1000\u00d750 = 50000 tables)."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_database_per_tenant", "label": "Database per tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strongest isolation. A connection pool per tenant; cross-tenant queries impossible."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_row_level_security", "label": "Row-level security tenant isolation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "USING (tenant_id = current_setting('app.tenant_id')::bigint). A rule the application can forget is not a rule."}, {"id": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_set_local_search_path", "label": "SET LOCAL search_path", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET search_path persists on a pooled connection. SET LOCAL reverts on commit. Schema name cannot be $1; validate against pg_namespace then escapeIdentifier."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_schema_namespace", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_shared_tables_tenant_id", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_row_level_security", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_row_level_security", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_app_cannot_enforce", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_set_local_search_path", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_schema_per_tenant", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_shared_tables_tenant_id", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_choosing_tenancy_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/10-schemas-tenancy.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_3_tenancy_models", "label": "Three multi-tenant layouts plus RLS backstop", "nodes": ["docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_shared_tables_tenant_id", "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_schema_per_tenant", "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_database_per_tenant", "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_row_level_security", "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_choosing_tenancy_model"], "relation