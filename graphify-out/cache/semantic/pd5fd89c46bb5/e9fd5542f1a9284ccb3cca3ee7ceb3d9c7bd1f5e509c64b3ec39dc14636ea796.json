{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_strictmode_double_invocation", "label": "StrictMode double-invocation", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_extra_effect_cycle", "label": "Extra setup+cleanup cycle", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development-only cycle before the first real setup: setup \u2192 cleanup \u2192 setup. Asserts mount-path symmetry."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_only_doubles_mount", "label": "StrictMode only doubles the mount", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extra cycle is attached to mounting, not every re-run. Dependency-change leaks pass a green StrictMode."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_double_render_vs_effect", "label": "Double render vs extra effect cycle", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double render finds impurity; extra effect cycle finds missing cleanup. Event handlers are in neither."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_partial_strictmode", "label": "Partial StrictMode skips the extra effect cycle", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child-only double mount cannot happen in production, so React declines to simulate it. The check requires StrictMode at the root."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_callback_ref_cycle", "label": "Callback refs get the same extra cycle", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing ref cleanup doubles registry counts. React 19 ref cleanup functions make symmetry expressible."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_only_doubles_mount", "target": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_extra_effect_cycle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_extra_effect_cycle", "target": "build_css_p2_docs_react_pages_phase_4_effects_cleanup_the_cleanup_contract_setup_cleanup_setup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/strictmode-double-invocation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_strictmode_double_invocation_strictmode_double_invocation", "target": "build_css_p2_docs_react_pages_phase_4_effe