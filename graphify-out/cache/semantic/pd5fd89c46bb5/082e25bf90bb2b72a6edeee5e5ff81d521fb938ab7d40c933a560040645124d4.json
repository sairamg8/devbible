{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_page", "label": "Keep-alive and connection pooling", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two unrelated pools: http.Agent for http.request and undici Dispatcher for fetch."}, {"id": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_http_agent", "label": "http.Agent", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "keepAlive default true since Node 19. maxSockets is a per-origin concurrency cap that queues overflow."}, {"id": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_undici_dispatcher", "label": "undici Agent dispatcher", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default dispatcher opens a connection per parallel request. Bound with Agent({connections}). Bundled undici is not importable."}, {"id": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_dispatcher_mismatch", "label": "Built-in fetch rejects npm undici Agent", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UND_ERR_INVALID_ARG: bundled and npm copies are different classes. Use setGlobalDispatcher or undici.fetch."}, {"id": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_proxy_502", "label": "Proxy 502 from keepAliveTimeout race", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raise server.keepAliveTimeout above the proxy idle timeout (65s vs ALB 60s) and keep headersTimeout higher."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_undici_dispatcher", "target": "docs_nodejs_pages_phase_5_http_processes_05_fetch_undici", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_dispatcher_mismatch", "target": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_undici_dispatcher", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_proxy_502", "target": "docs_nodejs_pages_phase_5_http_processes_01_http_server_keep_alive_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_http_agent", "target": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_undici_dispatcher", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/07-keep-alive-and-agents.md", "source_location": null, "weight": 1.0}], "hyperedges": []}