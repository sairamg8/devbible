{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_pool_query", "label": "pool.query", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "query(text), query(text, values), query(configObject). Object form needed for name, rowMode, types. All return the same Result. Callback form exists; do not use it in new code."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_positional_placeholders", "label": "Positional $n placeholders", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$1 is values[0], 1-based, may repeat. Numbering must be contiguous; extra values are silently ignored. Wire-protocol $n unchanged. Renumbering is the failure mode \u2014 build fragments and the array together."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_any_array", "label": "ANY($1::int[])", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One parameter for a variable-length list. Statement text stays constant for the plan cache. Sidesteps NOT IN null trap and the 65535-parameter ceiling."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_undefined_null", "label": "undefined becomes SQL NULL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null and undefined both become SQL NULL with no error. A misspelled property inserts NULL. Validate the object before building the array."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_identifiers_not_parameters", "label": "Identifiers are not parameters", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY $1 sorts every row by the same constant string and raises no error. Column names, table names and sort direction need an allowlist."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_parameter_ceiling", "label": "65535 parameter ceiling", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "21845 rows ok (65535 params); 21846 rows \u2192 08P01 bind message has 2 parameter formats but 0 parameters. Fix with unnest or chunk. Parameterized calls also reject multi-statement text (42601)."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_pool_query", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_positional_placeholders", "target": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_pool_query", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/04-query-placeholders.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders