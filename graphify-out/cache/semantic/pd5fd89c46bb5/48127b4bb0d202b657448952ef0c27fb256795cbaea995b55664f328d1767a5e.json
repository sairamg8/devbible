{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_traversal", "label": "Path traversal", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_join_not_boundary", "label": "path.join is not a security boundary", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "join('/srv/app/uploads', '../../../etc/passwd') returns /etc/passwd with no error. Normalising .. is its job, not a defence."}, {"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_safe_join", "label": "Resolve then check containment", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path.resolve then p === root || p.startsWith(root + sep). Bare startsWith(root) matches uploads-evil. Also catches resolve(root, '/etc/passwd')."}, {"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_zip_slip", "label": "Zip slip", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Archive entry named ../../etc/cron.d/x escapes the extraction directory. Validate every entry path against the destination root before writing."}, {"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_symlink_realpath", "label": "Symlink escape", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path.resolve is string arithmetic. A file inside the root can point outside. fs.realpath and re-check for attacker-controlled uploads."}, {"id": "docs_nodejs_pages_phase_8_security_10_path_traversal_opaque_storage_key", "label": "Opaque generated storage key", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User names a record; you look it up scoped to them and derive the path from a UUID you generated. Traversal then has no input."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_join_not_boundary", "target": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_traversal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_traversal", "target": "docs_nodejs_pages_phase_8_security_10_path_traversal_safe_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_traversal", "target": "docs_nodejs_pages_phase_8_security_10_path_traversal_zip_slip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/10-path-traversal.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_10_path_traversal_path_traversal", "target": "docs_nodejs_pages_phase_8_security_10_path_traversal_symlink_realpath", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "d