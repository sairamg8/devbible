{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_higher_order_components", "label": "Higher-order components", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_hoc_pattern", "label": "HOC wraps rather than mutates", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function that takes a component and returns a new one that renders the original with extra props."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_never_apply_during_render", "label": "Never apply a HOC during render", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new enhanced type each render remounts the subtree and wipes state. Apply once at module level."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_statics_not_copied", "label": "HOC wrappers do not copy statics", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wrapper is a different function object; copy statics or use hoist-non-react-statics."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_ref_forwarding", "label": "HOC ref forwarding after React 19", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ref is now an ordinary prop, so spreading props forwards it. Class instance refs and React 18 still need forwardRef."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_hooks_replaced_hocs", "label": "Why hooks replaced HOCs", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silent prop collisions and unreadable wrapper stacks. Hooks name values at the call site."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_around_not_inside", "label": "HOCs wrap around a component", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hook cannot wrap from the outside. memo, forwardRef, error boundaries, instrumentation stay HOC-shaped."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_displayname", "label": "HOC displayName convention", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without displayName DevTools shows WithUser or Anonymous for every wrap."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_never_apply_during_render", "target": "build_css_p2_docs_react_pages_phase_2_components_function_components_identity_and_nesting_never_nest", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_ref_forwarding", "target": "build_css_p2_docs_react_pages_phase_2_components_ref_as_a_prop_ordinary_prop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_hooks_replaced_hocs", "target": "build_css_p2_docs_react_pages_phase_2_components_render_props_hooks_replaced", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_around_not_inside", "target": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_error_boundaries", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_hoc_pattern", "target": "build_css_p2_docs_react_pages_phase_2_components_render_props_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/higher-order-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_higher_order_components_around_not_inside", "tar