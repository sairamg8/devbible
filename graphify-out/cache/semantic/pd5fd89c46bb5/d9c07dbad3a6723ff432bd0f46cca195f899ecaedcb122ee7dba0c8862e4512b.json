{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_page", "label": "What an index is", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/what-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_index", "label": "Index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/what-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second sorted copy of some columns maintained on every write so some SELECTs can stop scanning. A PRIMARY KEY is already a unique index."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_write_cost", "label": "Index write cost", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/what-index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One index nearly doubled a 200000-row insert (1239\u21922266 ms); three tripled it (4035 ms) with 36 MB of indexes vs 15 MB heap. Key width, not column count, drives size."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/what-index.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_what_index_write_cost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-