{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_loop_forms_what_each_iterates_for_in", "label": "for...in", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/loop-forms/what-each-iterates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterates enumerable string keys including inherited prototype properties. Almost never the right loop."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_loop_forms_what_each_iterates_for_of", "label": "for...of", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/loop-forms/what-each-iterates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterates values via Symbol.iterator. Works on arrays, strings (code points), Map, Set, NodeList, generators. Not plain objects."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_loop_forms_what_each_iterates_foreach", "label": "Array.prototype.forEach", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/loop-forms/what-each-iterates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterates values with numeric index. Skips holes, cannot break, does not await, returns undefined."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_loop_forms_what_each_iterates_object_entries_adapter", "label": "Object.entries as iterable adapter", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/loop-forms/what-each-iterates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribut