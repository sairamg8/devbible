{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_correlated_subquery", "label": "Correlated subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "References an outer column so it cannot be computed once \u2014 N+1 inside one statement. count() over empty is 0; sum/avg/min/max are NULL. Fine for a detail endpoint; rewrite as GROUP BY + LEFT JOIN for a list."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_subplan_loops", "label": "SubPlan loops= signature", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SubPlan with high loops and Index Searches matching the outer row count is per-row work. Measured 5000 probes. If the planner already un-correlated it there is no SubPlan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_visibility_map_swing", "label": "Correlated cost depends on visibility map", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best case after VACUUM: 145 vs 65 ms GROUP BY (2.2\u00d7). After touching 1 row in 500, Heap Fetches 0\u2192133359 and 414 vs 90 ms (4.6\u00d7). GROUP BY barely moved because it reads the heap once."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_correlated_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_subplan_loops", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_visibility_map_swing", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_correlated_subquery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_and_cost_correlated_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_scalar_subquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/correlated-and-cost.html", "source_location": null, "weight": 1.0}], "hyperedges": []}