{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_what_to_log", "label": "What to log and what it costs", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults disable duration, statement, lock-wait and temp-file logging. Each is a one-line reload."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_min_duration_statement", "label": "log_min_duration_statement", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default -1 disabled. 1000 ms is a web starting point. Sample the merely-slow band with log_min_duration_sample + log_statement_sample_rate."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_line_prefix", "label": "log_line_prefix", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default is only timestamp and PID. Add %u@%d %a %e. %a only works if services set application_name."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_lock_waits", "label": "log_lock_waits", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default off. Logs waits longer than deadlock_timeout. Best diagnostic for a freeze that then recovered \u2014 invisible to pg_stat_activity afterwards."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_temp_files", "label": "log_temp_files", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default -1. Set 0 to log every spill past work_mem, naming the statement behind rising temp_bytes."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_statement", "label": "log_statement", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "all fills disks and logs bound parameters. ddl is the safe continuous production value."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_jsonlog", "label": "jsonlog destination", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured JSON per line. Prefer over regex on log_line_prefix when shipping logs."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_logging_collector", "label": "logging_collector", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures stderr into rotating files. Requires a restart. In containers, stderr to the container log is often preferred."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_min_duration_statement", "target": "docs_postgresql_pages_phase_13_ops_11_logging_readme_three_legged_stool", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/01-what-to-log.md"