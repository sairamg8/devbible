{"nodes": [{"id": "docs_expressjs_pages_phase_3_requests_04_query_parser_page", "label": "Query parser", "file_type": "document", "source_file": "docs/expressjs/pages/phase-3-requests/04-query-parser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_3_requests_04_query_parser_simple", "label": "query parser simple", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/04-query-parser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express 5 default. Node querystring: repeated keys become arrays and bracket syntax is never interpreted. Safer default; breaks old nested-query clients."}, {"id": "docs_expressjs_pages_phase_3_requests_04_query_parser_extended", "label": "query parser extended", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/04-query-parser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in via app.set('query parser', 'extended'). a[b]=1 becomes {a:{b:'1'}} via qs. Allow-list filter keys if enabled."}, {"id": "docs_expressjs_pages_phase_3_requests_04_query_parser_qs_docs_contradiction", "label": "qs vs simple docs contradiction", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/04-query-parser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "req.query reference still says the parser by default uses qs \u2014 stale Express 4 text. Settings table and migration guide agree on simple."}, {"id": "docs_expressjs_pages_phase_3_requests_04_query_parser_prototype_pollution", "label": "Nested query prototype pollution", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/04-query-parser.md", "source_location": null, "source_url": null, "captur