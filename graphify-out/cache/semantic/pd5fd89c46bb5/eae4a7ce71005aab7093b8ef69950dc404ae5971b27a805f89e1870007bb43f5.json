{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_captures_variable_not_value", "label": "Closure captures the variable not the value", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A live reference to the binding, read at call time. Explains both counter factories and the loop bug."}, {"id": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "label": "var-in-a-loop bug", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "var is function-scoped so one i is shared. Closures report the final 3. Fixes: let, IIFE parameter, or forEach."}, {"id": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_let_per_iteration_binding", "label": "let per-iteration binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for (let) copies the loop variable into a fresh binding each iteration. Closures that mutate n do not interfere."}, {"id": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_iife_loop_fix", "label": "IIFE loop-variable capture", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function parameter is a fresh binding per call. Pre-ES6 fix that let automates."}, {"id": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_settimeout_not_the_cause", "label": "setTimeout is not the loop-bug cause", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The synchronous var loop also yields [3,3,3]. The timer only guarantees callbacks run after the loop."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "target": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_captures_variable_not_value", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "target": "docs_javascript_pages_phase_3_functions_07_lexical_scope_02_var_let_const_function_vs_block_scope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_let_per_iteration_binding", "target": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_iife_loop_fix", "target": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_iife_loop_fix", "target": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_let_per_iteration_binding", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_settimeout_not_the_cause", "target": "docs_javascript_pages_phase_3_functions_06_closures_01_what_is_captured_var_in_loop_bug", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/06-closures/01-what-is-captured.md", "source_location": null, "weight": 1.0}], "hyperedges": []}