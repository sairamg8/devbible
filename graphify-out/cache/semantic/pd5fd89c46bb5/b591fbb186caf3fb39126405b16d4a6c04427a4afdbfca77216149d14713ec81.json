{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_page", "label": "delete hard vs soft", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard delete removes the row and cascades. Soft delete is an UPDATE that makes every query wrong until you add deleted_at IS NULL. Schema-wide, not per-endpoint."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_hard_delete", "label": "Hard delete with RETURNING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rowCount 0 is 404, not an error. ON DELETE CASCADE fires. Missing-row delete is not thrown."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_soft_delete", "label": "Soft delete UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET deleted_at = now() WHERE id AND deleted_at IS NULL. No FK cascade. Not an audit log. AND deleted_at IS NULL keeps retries from overwriting the timestamp."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_partial_unique", "label": "Partial unique index for live emails", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full unique index blocks re-registration (23505). UNIQUE (email) WHERE deleted_at IS NULL. A lookup without the predicate can hit either row; a partial index is unusable without it."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_page", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_repository_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_soft_delete", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_delete_soft_hard_partial_unique", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/delete-soft-hard.html", "source_location": null, "weight": 1.0}], "hyperedges": []}