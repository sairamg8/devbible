{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_11_scaling_page", "label": "Scaling \u2014 vertical vs horizontal, cluster vs replicas", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/11-scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_11_deployment_11_scaling_vertical_vs_horizontal", "label": "Vertical vs horizontal scaling", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/11-scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Node process uses one JS core well for concurrent I/O; extra cores need more processes."}, {"id": "docs_nodejs_pages_phase_11_deployment_11_scaling_node_cluster", "label": "node:cluster on one machine", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/11-scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer when packing cores on a single VM without an orchestrator; not usually inside each pod."}, {"id": "docs_nodejs_pages_phase_11_deployment_11_scaling_horizontal_replicas", "label": "Horizontal replicas", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/11-scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Need stateless handling or a shared session store; connection pools multiply with replica count."}, {"id": "docs_nodejs_pages_phase_11_deployment_11_scaling_autoscale_on_lag", "label": "Autoscale on lag and saturation", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-11-deployment/11-scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CPU-only HPA misses I/O-bound APIs that are slow