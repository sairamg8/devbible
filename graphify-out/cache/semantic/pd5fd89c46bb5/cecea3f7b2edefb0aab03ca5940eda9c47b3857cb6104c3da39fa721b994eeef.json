{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_json_stringify", "label": "JSON.stringify", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/stringify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lossy and silent except BigInt and cycles, which throw. Sees own enumerable string keys like Object.keys."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_silent_drops", "label": "JSON.stringify silent drops", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/stringify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined/functions/symbols omitted in objects and null in arrays; NaN/Infinity become null; Map/Set become {}."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_tojson", "label": "toJSON hook", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/stringify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialiser uses toJSON's return value. Date uses it (ISO string). Cleanest per-type control."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_replacer", "label": "JSON.stringify replacer", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/stringify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function redacts (undefined omits); array is a deny-by-default key allowlist. Symbol keys cannot be re-included."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_jso