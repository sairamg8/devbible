{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_object_types", "label": "Object types", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional properties, readonly, index signatures, and nesting cover almost every shape. ? and readonly are compile-time only."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_optional_vs_undefined", "label": "Optional property vs undefined union", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "? means the key may be absent. T | undefined means the key must exist and may hold undefined. exactOptionalPropertyTypes stops ? accepting explicit undefined."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_index_signature", "label": "Index signature and Record", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every key is assumed to exist unless noUncheckedIndexedAccess. Record with a union key produces required properties. Prefer Map when keys are runtime data."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_excess_property_checks", "label": "Excess property checks", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fresh object literal assigned to a typed target is checked for unknown properties (TS2353). Store it in a variable and freshness is gone."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_weak_type_detection", "label": "Weak type detection", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A type whose properties are all optional rejects a value with no properties in common (TS2559). Add one required property and the same typo through a variable passes silently."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_object_types", "target": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_optional_vs_undefined", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_object_types", "target": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_index_signature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_object_types", "target": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_excess_property_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/04-object-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_excess_property_checks", "target": "docs_typescript_pages_phase_1_type_vocabulary_04_object_types_weak_type_detection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f