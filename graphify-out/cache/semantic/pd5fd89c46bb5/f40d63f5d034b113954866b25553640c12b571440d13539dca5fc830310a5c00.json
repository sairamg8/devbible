{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_03_text_text_vs_varchar_vs_char", "label": "text vs varchar vs char", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same implementation for text and varchar. Measured identical 13 MB and ~26 ms on 300k rows. char(50) pads: 51 bytes vs 4 for the same three characters, 24 MB vs 13 MB."}, {"id": "docs_postgresql_pages_phase_2_types_03_text_use_text", "label": "Use text by default", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "varchar(n) bakes a guessed number into physical structure. Widening is 2.4 ms metadata; narrowing rewrites under ACCESS EXCLUSIVE (305 ms / 200k rows). Prefer text plus CHECK (length(col) <= n)."}, {"id": "docs_postgresql_pages_phase_2_types_03_text_varchar_cast_truncates", "label": "varchar cast truncates silently", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INSERT into varchar(50) raises 22001. Explicit ::varchar(50) truncates with no warning. A CHECK cannot be cast away."}, {"id": "docs_postgresql_pages_phase_2_types_03_text_char_padding", "label": "char(n) padding semantics", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparison ignores trailing spaces; concatenation after implicit text cast does not. Acceptable only for genuinely fixed-width codes."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_03_text_use_text", "target": "docs_postgresql_pages_phase_2_types_03_text_text_vs_varchar_vs_char", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_03_text_varchar_cast_truncates", "target": "docs_postgresql_pages_phase_2_types_03_text_text_vs_varchar_vs_char", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_03_text_char_padding", "target": "docs_postgresql_pages_phase_2_types_03_text_text_vs_varchar_vs_char", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_03_text_text_vs_varchar_vs_char", "target": "docs_postgresql_pages_phase_2_types_14_network_geo_citext_citext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_03_text_varchar_cast_truncates", "target": "docs_postgresql_pages_phase_2_types_12_casting_three_kinds", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-2-types/03-text.md", "source_location": null, "weight": 1.0}], "hyperedges": []}