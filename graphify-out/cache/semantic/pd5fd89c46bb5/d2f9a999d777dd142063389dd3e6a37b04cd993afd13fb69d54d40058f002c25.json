{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_now_is_transaction_time", "label": "now() is transaction start time", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "now() aliases transaction_timestamp(); two inserts 150 ms apart share a timestamp. statement_timestamp() is per statement; clock_timestamp() is wall clock."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_date_js_midnight_trap", "label": "date maps to JS Date at local midnight", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg maps date to Date at local midnight. On UTC+5:30, date '2026-01-01' becomes 2025-12-31T18:30:00Z. Return to_char or setTypeParser(1082)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_date_trunc", "label": "date_trunc bucketing", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correct way to bucket for reports (timestamp, sortable, indexable). Pass a timezone: date_trunc('day', ts, 'Europe/Berlin') or local midnight lands in the previous UTC day."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_age_vs_subtraction", "label": "age() vs timestamp subtraction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "age returns a symbolic interval (1 mon is 28\u201331 days). Subtraction is elapsed time. pg returns interval as PostgresInterval, not a number."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_interval_day_vs_hours", "label": "interval 1 day vs 24 hours", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Differ on DST: 1 day keeps wall-clock time (23 or 25 h); 24 hours is elapsed. Same time tomorrow vs token expires in 24 hours."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_timestamptz_not_timestamp", "label": "timestamptz for instants", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz stores UTC and renders in TimeZone. timestamp without zone is a wall-clock reading with no recoverable zone. SET TIME ZONE on a pool leaks like search_path."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_now_is_transaction_time", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_date_js_midnight_trap", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_date_trunc", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_timestamptz_not_timestamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_age_vs_subtraction", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_interval_day_vs_hours", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_timestamptz_not_timestamp", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_datetime_functions_date_js_midnight_trap", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_generate_series_generate_series", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/datetime-functions.html", "source_location": null, "weight": 1.0}], "hyperedges": []}