{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_test_reset_page", "label": "Resetting between test runs", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/test-reset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reset strategy sets suite speed. Fastest option requires every query on one injected client."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_test_reset_rollback", "label": "Transaction rollback per test", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/test-reset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.8 ms measured vs TRUNCATE 4.4 ms. Discards only the test's writes; seed survives. Requires injected client and no nested COMMIT. Cannot test commit-only effects."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_test_reset_truncate", "label": "TRUNCATE RESTART IDENTITY CASCADE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/test-reset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One statement lists every table to avoid deadlock. CASCADE for FKs (0A000 otherwise). RESTART IDENTITY or next id is 10001 after 10k rows."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_test_reset_drop_and_migrate", "label": "Drop and migrate once per suite", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/test-reset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only strategy that tests migrations. Seconds, not milliseconds. Combine with rollback per test."}], "edges"