{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs", "label": "One row per matching pair", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_inner_join", "label": "INNER JOIN matching pairs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Output is pairs that satisfy ON. Unmatched left rows vanish; N matches repeat the left row N times. Dee gone, Ann twice."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_join_is_inner", "label": "JOIN is INNER JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INNER is optional. Comma form is also inner but a missing condition is a silent cross join."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_join_strategies", "label": "Nested Loop Hash Join Merge Join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equijoin unlocks all three. Non-equality leaves only nested loop. Planner picks by cost from statistics and indexes."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_not_null_fk", "label": "NOT NULL FK makes child-to-parent count knowable", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child JOIN parent via NOT NULL FK yields one row per child. Parent JOIN child drops parents with no children."}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_inner_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_join_is_inner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_join_strategies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_not_null_fk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/01-matching-pairs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_01_matching_pairs_join_is_inner", "target": "docs_postgresql_pages_phase_5_joins_07_cross_join_comma_form", "relation": "references",