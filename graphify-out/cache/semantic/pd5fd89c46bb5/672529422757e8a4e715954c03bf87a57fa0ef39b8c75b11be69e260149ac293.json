{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watch", "label": "fs.watch", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OS events (inotify/FSEvents/ReadDirectoryChangesW). Fast, inconsistent. One writeFile produced two change events. Often silent on Docker mounts."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watchfile", "label": "fs.watchFile", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polls with stat (default 5007 ms). Reliable on network/Docker mounts; expensive at scale. Deletion is curr.mtimeMs===0. Must unwatchFile."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_chokidar", "label": "chokidar", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debounces, distinguishes add/change/unlink, awaitWriteFinish, auto-polls for network mounts, handles editor atomic-save."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_do_not_watch_in_production", "label": "Do not watch files in production", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Containers are immutable, events fail on production volumes, a partial write can be loaded, and the reload path is under-tested. Prefer restart or SIGHUP."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_inotify_enospc", "label": "inotify ENOSPC", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-user watch limit, not disk space. One watch per directory; recursive watch over node_modules exhausts max_user_watches."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watch", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watchfile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_chokidar", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_chokidar", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watchfile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_do_not_watch_in_production", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_fs_watch", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/watching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_watching_do_not_watch_in_production", "target"