{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_01_what_index_what_an_index_is", "label": "What an index is", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_01_what_index_index", "label": "PostgreSQL index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second sorted copy of some columns written on every INSERT/UPDATE/DELETE so some SELECTs can stop scanning. You buy read speed with write time and disk."}, {"id": "docs_postgresql_pages_phase_10_indexes_01_what_index_write_cost", "label": "Index write cost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One index took a 200000-row insert from 1239 ms to 2266 ms; three took it to 4035 ms with indexes 36 MB against 15 MB of heap."}, {"id": "docs_postgresql_pages_phase_10_indexes_01_what_index_primary_key_is_index", "label": "PRIMARY KEY is a unique index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A table is never truly at zero indexes if it has a PRIMARY KEY or UNIQUE constraint."}, {"id": "docs_postgresql_pages_phase_10_indexes_01_what_index_idx_scan", "label": "idx_scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero over a full business cycle means the index is only costing you."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_what_an_index_is", "target": "docs_postgresql_pages_phase_10_indexes_01_what_index_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_index", "target": "docs_postgresql_pages_phase_10_indexes_01_what_index_write_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_primary_key_is_index", "target": "docs_postgresql_pages_phase_10_indexes_01_what_index_index", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_idx_scan", "target": "docs_postgresql_pages_phase_10_indexes_01_what_index_write_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_what_an_index_is", "target": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_unused_indexes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/01-what-index.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_01_what_index_what_an_index_is", "target": "docs_postgresql_pages_phase_10_indexes_12_concurrently_create_in