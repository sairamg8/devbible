{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_web_streams", "label": "Web Streams", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHATWG ReadableStream, WritableStream, and TransformStream \u2014 globals in Node since v18; fetch bodies are web streams."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_readable_toweb_fromweb", "label": "Readable.toWeb / fromWeb", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Convert once at the boundary. Node chunks are Buffers; web chunks are Uint8Array. Repeated conversion adds wrapper queues."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_readablestream_lock", "label": "ReadableStream lock", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one reader at a time. for-await, pipeTo, and getReader all lock; a second getReader throws TypeError."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_tee", "label": "ReadableStream.tee", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicates a stream into two branches. The faster branch buffers until the slower reads \u2014 an abandoned branch grows unbounded."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_prefer_node_streams", "label": "Prefer Node streams in Node", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Node streams for pipeline, object mode, and Node APIs. Use web streams for edge/browser, fetch-only code, or CompressionStream."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_readable_toweb_fromweb", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_web_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_readablestream_lock", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_web_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_tee", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_readablestream_lock", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/web-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_prefer_node_streams", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_web_streams_web_streams", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams