{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_named_query", "label": "Named prepared statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "query({name}) issues server PREPARE. First call Parse; later Bind/Execute. Measured 1.6x on a hot single-row lookup."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_custom_vs_generic_plan", "label": "Custom vs generic plan after five executions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First five executions use custom plans with real values. From the sixth PostgreSQL may switch to a generic plan, which is wrong on skewed data."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_plan_cache_mode", "label": "plan_cache_mode", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "force_custom_plan always plans with values; force_generic_plan never replans; auto is default. Use force_custom_plan on skewed tables."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_per_session", "label": "Prepared statements are per session", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A name prepared on one backend is invisible to another. A pool of N prepares up to N times. Names must be a small fixed unique set."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_pgbouncer", "label": "PgBouncer breaks named statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transaction or statement pooling routes consecutive queries to different backends. Symptom: 26000 prepared statement does not exist."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_named_query", "target": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_custom_vs_generic_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_plan_cache_mode", "target": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_custom_vs_generic_plan", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_named_query", "target": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_per_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_pgbouncer", "target": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_per_session", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/10-prepared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_10_prepared_named_query", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_discard_all", "relation": "conceptually_related_to", "co