{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_10_order_by_order_by", "label": "ORDER BY", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_10_order_by_no_default_order", "label": "No default row order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not insertion order. Can change after VACUUM, a plan switch, or an UPDATE that relocates a heap tuple. If order matters, state it."}, {"id": "docs_postgresql_pages_phase_4_crud_10_order_by_nulls_placement", "label": "NULLS LAST and NULLS FIRST", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default NULLS LAST for ASC and NULLS FIRST for DESC. Reversing a UI sort moves empty rows from bottom to top. Indexes record null ordering too."}, {"id": "docs_postgresql_pages_phase_4_crud_10_order_by_collation_libc_split", "label": "musl versus glibc collation split", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical PostgreSQL 18.4, both reporting datcollate en_US.utf8. Alpine musl sorts by byte value; Debian glibc uses dictionary order. Range queries change too."}, {"id": "docs_postgresql_pages_phase_4_crud_10_order_by_icu_collation", "label": "Pin an ICU collation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ICU ships with PostgreSQL and is identical across images. builtin C.UTF-8 is fast and stable for identifiers. Nondeterministic ICU can do case-insensitive equality but forbids LIKE."}, {"id": "docs_postgresql_pages_phase_4_crud_10_order_by_libc_upgrade_index_corruption", "label": "libc upgrade can corrupt text btrees", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index is physically ordered by the old collation. New rules miss present rows. Remedy REINDEX; prevention is ICU or C/builtin."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_10_order_by_order_by", "target": "docs_postgresql_pages_phase_4_crud_10_order_by_no_default_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_10_order_by_no_default_order", "target": "docs_postgresql_pages_phase_4_crud_03_limit_offset_unique_tiebreaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_10_order_by_icu_collation", "target": "docs_postgresql_pages_phase_4_crud_10_order_by_collation_libc_split", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_10_order_by_libc_upgrade_index_corruption", "target": "docs_postgresql_pages_phase_4_crud_10_order_by_icu_collation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_10_order_by_order_by", "target": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/10-order-by.md", "source_location": null, "weight": 1.0}], "hyperedges": []}