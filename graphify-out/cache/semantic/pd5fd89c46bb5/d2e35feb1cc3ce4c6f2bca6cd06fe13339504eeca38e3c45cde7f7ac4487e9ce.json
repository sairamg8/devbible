{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_page", "label": "02 \u00b7 Primitives are copied, objects are shared", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_copy_vs_share", "label": "Primitive copy vs object share", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigning a primitive copies it; assigning an object copies the reference. JS is always pass-by-value, but for objects the value is the reference."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_shallow_copy", "label": "Shallow copy", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_structured_clone", "label": "structuredClone", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default deep copy: handles cycles, Map, Set, Date. Throws on functions and DOM nodes. JSON.parse(JSON.stringify) drops undefined/functions/symbols, empties Map/Set, NaN\u2192null."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_immutable_updates", "label": "Immutable updates / structural sharing", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React change detection is a reference comparison. Mutating in place leaves the reference identical. Return new objects only along the changed path; untouched branches keep their references."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_copy_vs_share", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_shallow_copy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_shallow_copy", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_structured_clone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_immutable_updates", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_copy_vs_share", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/references-vs-values.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_references_vs_values_page", "ta