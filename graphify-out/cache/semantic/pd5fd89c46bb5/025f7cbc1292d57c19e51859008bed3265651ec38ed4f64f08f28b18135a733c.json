{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "label": "TypeScript is a checker, not a runtime", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TypeScript reads code and complains. It is not a language the computer runs. By execution time every annotation is gone, like a comment."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_emit_on_error", "label": "tsc emit-on-error default", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default tsc reports errors and still emits JS, exiting 2. --noEmitOnError and --noEmit exit 1 and write nothing. Ignoring exit 2 ships rejected output."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_no_runtime_guarantee", "label": "Types are promises, not runtime checks", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No runtime type representation or check. An API, JSON.parse, or as can lie. That gap is Phase 9 \u2014 types at the boundary."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_tsc_noemit_ci", "label": "tsc --noEmit as CI gate", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundlers and Node strip without checking. A required tsc --noEmit with a respected exit code is the only automatic check."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_erasure_erasure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_no_runtime_guarantee", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_tsc_noemit_ci", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/static-checker-not-runtime.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_emit_on_error", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css