{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "label": "Promise states and chaining", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_07_promise_states_three_states", "label": "Promise pending / fulfilled / rejected", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transitions exactly once from pending to fulfilled or rejected, then immutable. Settled means fulfilled or rejected. Resolved-with-a-promise stays pending until that one settles."}, {"id": "docs_nodejs_pages_phase_2_async_07_promise_states_promises_are_eager", "label": "Promises are eager", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work starts when the promise is created, not when it is awaited. To defer, wrap creation in a function. Settling twice is a silent no-op."}, {"id": "docs_nodejs_pages_phase_2_async_07_promise_states_return_or_not_chained", "label": "Return or it is not chained", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".then returns a new promise that adopts whatever the handler returns. Forget return and the inner work detaches; its rejection is unhandled."}, {"id": "docs_nodejs_pages_phase_2_async_07_promise_states_finally", "label": "Promise.prototype.finally", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on both paths and passes the outcome through. Return value is ignored; throw inside finally replaces the outcome."}, {"id": "docs_nodejs_pages_phase_2_async_07_promise_states_then_twoarg_vs_catch", "label": ".then(f, g) vs .then(f).catch(g)", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-argument g only sees upstream rejections, not errors thrown by f. A chained .catch is downstream of f. Prefer .then().catch()."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_three_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_promises_are_eager", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_three_states", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_return_or_not_chained", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_three_states", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_finally", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_then_twoarg_vs_catch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "target": "docs_nodejs_pages_phase_2_async_12_floating_promises_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_07_promise_states_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/07-promise-states.md", "source_location": null, "weight": 1.0}], "hyperedges": []}