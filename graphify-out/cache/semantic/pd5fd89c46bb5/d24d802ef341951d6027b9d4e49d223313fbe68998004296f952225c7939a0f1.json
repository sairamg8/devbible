{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_add_not_null_safely", "label": "Adding NOT NULL safely", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The obvious SET NOT NULL holds ACCESS EXCLUSIVE for a full scan. Do the long part under a weaker lock."}, {"id": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_constant_default_pg11", "label": "Constant default ADD COLUMN since PG11", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bool NOT NULL DEFAULT false is 4 ms catalog-only. Volatile gen_random_uuid() still rewrites 902 ms and needs the old three-step dance."}, {"id": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_not_valid_then_validate", "label": "NOT VALID then VALIDATE for NOT NULL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADD CHECK (col IS NOT NULL) NOT VALID 3 ms; VALIDATE 25 ms under SHARE UPDATE EXCLUSIVE. Direct SET NOT NULL 36 ms ACCESS EXCLUSIVE throughout. From PG12 SET NOT NULL can use the validated CHECK as proof."}, {"id": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_batched_backfill", "label": "Batched backfill", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One UPDATE over millions of rows holds row locks, huge WAL, and VACUUM's cleanup horizon. Batches of a few thousand commit and stay interruptible."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_constant_default_pg11", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_volatile_default_rewrite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_not_valid_then_validate", "target": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_add_not_null_safely", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_not_valid_then_validate", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_not_valid", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_batched_backfill", "target": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_add_not_null_safely", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_add_not_null_safely", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_lock_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/09-add-not-null.md", "source_location": null, "weight": 1.0}], "hyperedges": []}