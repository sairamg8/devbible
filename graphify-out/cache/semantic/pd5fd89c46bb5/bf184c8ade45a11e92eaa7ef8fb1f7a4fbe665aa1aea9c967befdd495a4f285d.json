{"nodes": [{"id": "docs_expressjs_pages_phase_5_errors_06_not_found_and_process_not_found_middleware", "label": "404 as three-arg middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-5-errors/06-not-found-and-process.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "404 is normal middleware (3 args) after routes, not error middleware. It always sends 404 when reached. Error middleware mounts after it."}, {"id": "docs_expressjs_pages_phase_5_errors_06_not_found_and_process_process_errors_are_node", "label": "Process crashes are Node topics", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-5-errors/06-not-found-and-process.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unhandledRejection / uncaughtException belong to Node Phase 5. Structured logging of errors is Node Phase 10 plus request-id middleware. Request 404/500 envelope stays in Express."}], "edges": [{"source": "docs_expressjs_pages_phase_5_errors_06_not_found_and_process_not_found_middleware", "target": "docs_expressjs_pages_phase_5_errors_01_error_middleware_four_arg_error_middleware", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-5-errors/06-not-found-and-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_5_errors_06_not_found_and_process_not_found_middleware", "target": "docs_expressjs_pages_phase_5_errors_03_error_contract_error_response_contract", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/expressjs/pages/phase-5-errors/06-not-found-and-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_5_errors_06_not_found_and_process_process_errors_are_node", "target": "docs_expressjs_pages_phase