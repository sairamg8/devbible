{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_timeout_budgets_fetch_no_timeout", "label": "fetch has no default timeout", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/timeout-budgets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node fetch waits as long as the socket stays open. AbortSignal.timeout(ms) is the built-in bound."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_timeout_budgets_timeout_budget", "label": "Timeout budget", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/timeout-budgets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One deadline for the operation; each step gets remaining time. Three 5s timeouts are a 15s request."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_timeout_budgets_shrinking_timeouts", "label": "Timeouts shrink down the stack", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/timeout-budgets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A caller's timeout must exceed the callee's. Otherwise the client gives up while you still hold resources."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_timeout_budgets_statement_timeout", "label": "statement_timeout vs query_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/timeout-budgets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "statement_timeout is server-enforced and cancels the query. query_timeout only stops the client wait."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_wo