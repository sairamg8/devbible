{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_shapes", "label": "JSON shapes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jsonb_build_object, to_jsonb, jsonb_agg and jsonb_object_agg cover naming fields, converting a row, collecting an array, and building a keyed map."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_build_object", "label": "jsonb_build_object", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternating key, value. Verbose on purpose: the API contract is written in the query, so adding a table column cannot change the response."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_to_jsonb", "label": "to_jsonb", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emits every column. Never point it at a table you do not control. Safe form names columns in a subquery. numeric becomes a JSON number; cast money to text first."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_object_agg", "label": "jsonb_object_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows into a keyed map. NULL key raises 22023 at runtime. Duplicate keys silently keep the last value \u2014 aggregate over already-grouped input."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_vs_jsonb", "label": "json versus jsonb", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "json stores verbatim text; jsonb stores parsed binary, collapses duplicates, drops whitespace, reorders keys. jsonb is 60 vs 23 bytes here, GIN-indexable. Difference is invisible from Node because JSON.parse collapses duplicates too."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_agg", "label": "jsonb_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collects rows into a JSON array. Arrives as a JS array; JSON.parse throws. Put ORDER BY inside, same sibling-sort inheritance as array_agg."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_null_key_22023", "label": "22023 field name must not be null", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jsonb_object_agg rejects a NULL key only when such a row exists, so a query that works for months breaks on the first NULL grouping value."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_shapes", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_build_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_shapes", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_to_jsonb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_shapes", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_object_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_shapes", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_json_vs_jsonb", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_agg", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_02_json_shapes_jsonb_agg", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_array_agg", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/02-json-shapes.md