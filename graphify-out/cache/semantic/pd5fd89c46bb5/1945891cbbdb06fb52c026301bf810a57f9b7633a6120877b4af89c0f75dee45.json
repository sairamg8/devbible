{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_strict", "label": "strict flag", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A switch over seven checks that decides what the language means. Without strictNullChecks, string includes null."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_default_true_ts7", "label": "strict defaults to true in TypeScript 7", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tsc --help --all reports default: true on 7.0.2 and false on 5.9.3. Unflagged loose.ts reports TS7006, TS18047, TS2564, TS18046."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_seven_flags", "label": "Seven flags under strict", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "noImplicitAny, strictNullChecks, strictPropertyInitialization, useUnknownInCatchVariables, strictFunctionTypes, strictBindCallApply, alwaysStrict."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_strict_null_checks", "label": "strictNullChecks", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-bearing flag. Without it null is assignable to every type so | null is decoration. With it, user.name after a nullable find is TS18047 until narrowed."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_ts5052", "label": "TS5052 strictPropertyInitialization requires strictNullChecks", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never-assigned and assigned-undefined are the same without null tracking, so the flag cannot stand alone."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_nounchecked_indexed_access", "label": "noUncheckedIndexedAccess is not in strict", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate opt-in; tsc --init enables it anyway. Makes arr[0] and record[key] return T | undefined."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_seven_flags", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_strict", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_strict_null_checks", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_strict", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/strict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_strict_default_true_ts7", "target": "build_css_p2_docs_typescrip