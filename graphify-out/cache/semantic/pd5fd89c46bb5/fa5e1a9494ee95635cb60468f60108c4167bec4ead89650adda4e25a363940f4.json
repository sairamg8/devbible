{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_hsts", "label": "HSTS", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/https-hsts-cookies.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser refuses the first plaintext request. The header on HTTP is ignored. includeSubDomains and preload are commitments."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_cookie_flags", "label": "Session cookie flags", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/https-hsts-cookies.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HttpOnly, Secure, SameSite=Lax, Path=/, Max-Age, __Host- prefix. Node validates none of them."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_x_forwarded_proto", "label": "X-Forwarded-Proto is forgeable", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/https-hsts-cookies.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trust req.socket.encrypted when Node terminates TLS. Trust the header only if a controlled proxy overwrites it."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_tls13_session_event", "label": "TLS 1.3 session event", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/https-hsts-cookies.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getSession() in the connect callback looks like a ticket and does not resume. Cache the 'session' event."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_cookie_flags", "target": "build_css_p2