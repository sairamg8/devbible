{"nodes": [{"id": "docs_expressjs_reviews_verification_claude_pages", "label": "Express explanation pages verification", "file_type": "document", "source_file": "docs/expressjs/reviews/verification-claude-pages.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_reviews_verification_claude_pages_quality_cliff", "label": "Quality cliff after Phase 3", "file_type": "concept", "source_file": "docs/expressjs/reviews/verification-claude-pages.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "29 finished pages in Phases 0-3; Phases 6-10 are accurate outlines. Quality degrades monotonically, not bimodally."}, {"id": "docs_expressjs_reviews_verification_claude_pages_if_match_gap", "label": "Express does not enforce If-Match", "file_type": "concept", "source_file": "docs/expressjs/reviews/verification-claude-pages.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stale If-Match is ignored; Express generates ETags but never enforces preconditions. Lost-update protection is application code (412/428)."}, {"id": "docs_expressjs_reviews_verification_claude_pages_trust_proxy_true_spoof", "label": "trust proxy true spoofs req.ip", "file_type": "concept", "source_file": "docs/expressjs/reviews/verification-claude-pages.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trust proxy: true takes the leftmost X-Forwarded-For hop, which the client sent. Combined with IP-keyed rate limits this is a bypass."}, {"id": "docs_expressjs_reviews_verification_claude_pages_fetch_cannot_show_304", "label": "fetch cannot verify 304", "file_type": "concept", "source_file": "docs/expressjs/reviews/verification-claude-pages.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "