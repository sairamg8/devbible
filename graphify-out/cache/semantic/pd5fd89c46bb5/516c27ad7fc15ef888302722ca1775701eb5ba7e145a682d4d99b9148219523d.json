{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_call_signature", "label": "Call signature", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object/interface form can carry properties (Express middleware). Arrow form is callable only. Multiple call signatures are overloads; first match wins."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_construct_signature", "label": "Construct signature", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new (id: string) => Widget types the constructor, not an instance. Generic factory: Ctor: new (id: string) => T."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_typeof_class", "label": "typeof MyClass is the static side", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every class creates two types: C is the instance; typeof C is constructor plus statics. 'Property create does not exist on Repo' is this confusion."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_abstract_new", "label": "abstract new construct signature", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "abstract new (...args: any[]) => T accepts abstract classes; a plain new signature rejects them. Needed for mixins and registries over bases."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_hybrid_type", "label": "Hybrid call/construct type", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call signature plus construct signature plus properties. Rare in new code; common in .d.ts for older JS (jQuery $)."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_typeof_class", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_construct_signature", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_abstract_new", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_construct_signature", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/call-and-construct-signatures.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_hybrid_type", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_call_and_construct_signatures_call_signature", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confide