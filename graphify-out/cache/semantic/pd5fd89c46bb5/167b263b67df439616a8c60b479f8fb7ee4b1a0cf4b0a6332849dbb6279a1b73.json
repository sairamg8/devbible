{"nodes": [{"id": "docs_react_pages_phase_2_components_12_render_props", "label": "Render props and function-as-children", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_12_render_props_render_prop", "label": "Render prop", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function prop a component calls to decide what to render. The owner keeps state and behaviour; the caller keeps markup. The prop need not be named render \u2014 children is the same pattern."}, {"id": "docs_react_pages_phase_2_components_12_render_props_function_as_children", "label": "Function-as-children", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same inversion as a render prop with children as the function, which JSX can nest inside the element."}, {"id": "docs_react_pages_phase_2_components_12_render_props_wrapper_hell", "label": "Wrapper hell", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composing several render-prop components nests JSX and closures until the code is unreadable. Custom hooks were introduced to solve this."}, {"id": "docs_react_pages_phase_2_components_12_render_props_hooks_replaced_render_props", "label": "Hooks replaced render props", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hooks share logic without extra tree nodes, make values usable anywhere in the component, and compose linearly instead of nesting."}, {"id": "docs_react_pages_phase_2_components_12_render_props_still_win", "label": "When render props still win", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hooks cannot render. Render props remain right when the component controls placement, values are per-item, or rendering must run inside a boundary it owns."}, {"id": "docs_react_pages_phase_2_components_12_render_props_inline_defeats_memo", "label": "Inline render prop defeats memoization", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inline arrow is a new function each render, so PureComponent or memo never skips. Fix with useCallback only if the child is actually memoized."}, {"id": "docs_react_pages_phase_2_components_12_render_props_legacy_docs", "label": "legacy.reactjs.org Render Props", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_react_pages_phase_2_components_12_render_props", "target": "docs_react_pages_phase_2_components_12_render_props_render_prop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props", "target": "docs_react_pages_phase_2_components_12_render_props_legacy_docs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props_function_as_children", "target": "docs_react_pages_phase_2_components_12_render_props_render_prop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props_wrapper_hell", "target": "docs_react_pages_phase_2_components_12_render_props_hooks_replaced_render_props", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props_still_win", "target": "docs_react_pages_phase_2_components_12_render_props_render_prop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props_inline_defeats_memo", "target": "docs_react_pages_phase_2_components_15_purecomponent_shallow_comparison", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_12_render_props", "target": "docs_react_pages_phase_2_components_01_function_components_02_identity_and_nesting_nesting_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/12-render-props.md", "source_location": null, "weight": 1.0}], "hyperedges": []}