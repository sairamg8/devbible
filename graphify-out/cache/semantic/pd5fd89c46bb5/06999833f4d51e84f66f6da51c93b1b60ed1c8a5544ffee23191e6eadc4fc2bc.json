{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_per_row_cost", "label": "Per-row INSERT cost", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10000 autocommit inserts: 20165 ms. One transaction: 2559 ms (WAL flush once). One unnest statement: 84 ms. 240\u00d7 spread."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_unnest", "label": "INSERT \u2026 SELECT unnest", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter per column; statement text is constant. Casts are required. Supports ON CONFLICT and RETURNING. Materialises everything in JS (201 MB heap at 500k rows)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_parameter_ceiling", "label": "65535 parameter ceiling", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wire protocol encodes the count in 16 bits. 21845 rows \u00d7 3 columns succeeds; 21846 fails with 08P01 that does not mention the limit. Batch by floor(65535 / columns)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_copy_vs_unnest", "label": "COPY vs unnest from Node", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unnest beat pg-copy-streams by 2.7\u20133\u00d7 at 10k/100k/500k because CSV formatting in JS dominates. COPY wins on streaming memory and unlimited size."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_per_row_cost", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_unnest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_copy_vs_unnest", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_unnest", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_copy_vs_unnest", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_copy_streams_pg_copy_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_parameter_ceiling", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_unnest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/bulk-insert.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "bulk_load_and_stream_paths", "label": "Bulk load and large-result paths", "nodes": ["build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_bulk_insert_per_row_cost", "bui