{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_02_secrets_01_where_secrets_leak_where_secrets_leak", "label": "Where secrets leak", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/02-secrets/01-where-secrets-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_02_secrets_01_where_secrets_leak_pool_object_leak", "label": "Pool object connectionString leak", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/02-secrets/01-where-secrets-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pool.options.password is undefined but connectionString still holds the credential. JSON.stringify and util.inspect reproduce it. pg error objects carry no password."}, {"id": "docs_postgresql_pages_phase_13_ops_02_secrets_01_where_secrets_leak_pg_stat_activity_query", "label": "pg_stat_activity.query text", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/02-secrets/01-where-secrets-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any superuser or pg_read_all_stats member can read the running statement, including the last statement of an idle session. Bound parameters appear as $1 in the view."}, {"id": "docs_postgresql_pages_phase_13_ops_02_secrets_01_where_secrets_leak_log_statement_parameters", "label": "log_statement logs bound parameters", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/02-secrets/01-where-secrets-leak.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameters stay out of statement text and pg_stat_activity but log_statement=all adds DETAIL: Parameters. log_parameter_max_length defaults to -1 (unlimited)."}, {"id": "docs_postgre