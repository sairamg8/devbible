{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_page", "label": "11 \u00b7 NaN", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_nan", "label": "NaN", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IEEE-754: NaN means a failed computation, and two unrelated failures are not the same value, so NaN !== NaN. It never throws and poisons every later arithmetic step."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_number_isnan", "label": "Number.isNaN", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Number.isNaN, not global isNaN. The global coerces first so isNaN('abc') is true; Number.isNaN answers only 'is this the NaN value?'."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_includes_vs_indexof", "label": "includes vs indexOf for NaN", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "indexOf uses === so [NaN].indexOf(NaN) is -1; includes and Map/Set keys use SameValueZero, so NaN is found and Set([NaN,NaN]).size is 1."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_number_isfinite", "label": "Number.isFinite validation", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validate where the value enters with Number.isFinite, which rejects NaN and both infinities. !Number.isNaN lets Infinity through."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_page", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_nan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_nan", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_number_isnan", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_includes_vs_indexof", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_is_and_zero_samevaluezero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_nan", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_nullish_coalescing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_number_isfinite", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_nan", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_includes_vs_indexof", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_is_and_zero_object_is", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/nan.html", "source_location": null, "weight": 1.0}], "hyperedges": []}