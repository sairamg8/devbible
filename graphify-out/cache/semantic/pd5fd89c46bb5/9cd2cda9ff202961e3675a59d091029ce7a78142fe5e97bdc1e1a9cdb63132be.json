{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_page", "label": "Fixtures, factories, and test data", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. Test data rots when written once, shared everywhere, and then nobody dares change it."}, {"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_factory", "label": "Factory with defaults and overrides", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sensible valid defaults plus a spread override. Each test names only the field it is about. A schema change is a one-place edit."}, {"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_shared_fixture_rot", "label": "Shared fixture rot", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared JSON imported by 40 tests cannot change, hides the subject field, and goes stale when the state machine adds required fields."}, {"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_determinism", "label": "Determinism beats faker", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random faker data produces unreproducible fortnightly failures. Use a counter for uniqueness; use property-based testing when you genuinely want random input."}, {"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_transaction_per_test", "label": "Transaction per test rollback", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN in beforeEach, ROLLBACK in afterEach, pass the checked-out client. Faster than truncate-and-reseed. Fails for code that manages its own transactions."}, {"id": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_captured_payload", "label": "Captured static fixture", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right for input you did not author \u2014 webhooks, OAuth responses, a real CSV that broke the importer. Comment provenance; never edit captured payloads."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_factory", "target": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_shared_fixture_rot", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_determinism", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_transaction_per_test", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_page", "target": "docs_nodejs_pages_phase_9_testing_11_coverage_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/10-fixtures-and-factories.md", "source_location": null, "weight": 1.0}], "hyperedges": []}