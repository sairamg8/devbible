{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_lag_and_read_your_writes", "label": "Lag and read-your-writes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_read_your_writes", "label": "Read-your-writes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A client must see its own committed writes. Async replicas replay after the primary commits, so a post-save read can return the old value with no error. Load-dependent and invisible in development."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_physical_streaming_replica", "label": "Physical streaming replica", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A byte-identical whole-cluster copy permanently in recovery. Writes return 25006. It replays VACUUM and DDL. pg_is_in_recovery() is true on a standby."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_wal_lsn_stages", "label": "Four WAL LSN stages", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sent_lsn, write_lsn, flush_lsn, replay_lsn on pg_stat_replication. The flush-to-replay gap is durability without visibility. Lag columns revert to NULL when caught up and idle."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_replay_lag", "label": "replay_lag", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On an async standby, approximates the delay before recent transactions became visible. now() - pg_last_xact_replay_timestamp() grows without bound on an idle primary; compare receive vs replay LSN for health."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_synchronous_commit", "label": "synchronous_commit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-transaction. on is not synchronous replication unless synchronous_standby_names is set. Only remote_apply waits for replay. A slow synchronous standby stalls commits on the primary."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_remote_apply", "label": "remote_apply", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COMMIT returns once WAL is replayed and visible on the synchronous standby. Apply per transaction with SET LOCAL; a global setting couples write availability to replica health."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_read_your_writes", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_replay_lag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_wal_lsn_stages", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_replay_lag", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_synchronous_commit", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_remote_apply", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_remote_apply", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_read_your_writes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_synchronous_commit", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_set_local", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/01-lag-and-read-your-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replic