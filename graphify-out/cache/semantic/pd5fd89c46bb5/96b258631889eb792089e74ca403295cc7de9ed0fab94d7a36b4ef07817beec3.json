{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_offset_pagination", "label": "Offset pagination", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/03-pagination.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /items?limit=20&offset=40. Easy, slow on deep pages, unstable if rows insert while paging."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_cursor_pagination", "label": "Cursor pagination", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/03-pagination.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable for infinite scroll; opaque cursors hide storage details. Encode nothing sensitive without signing/encrypting. Prefer for large or volatile lists."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_cap_limit", "label": "Cap pagination limit", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-6-rest-surface/03-pagination.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default limit (e.g. 20) and max (e.g. 100). Never allow limit=999999. Protects DB and API CPU from accidental or malicious full-table pulls."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_offset_pagination", "target": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_cursor_pagination", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/expressjs/pages/phase-6-rest-surface/03-pagination.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_cap_limit", "target": "docs_expressjs_pages_phase_6_rest_surface_03_pagination_offset_pagination", "relation": "rationale_for", "confi