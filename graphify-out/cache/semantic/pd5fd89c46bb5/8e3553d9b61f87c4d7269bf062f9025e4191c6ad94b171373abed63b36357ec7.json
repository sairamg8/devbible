{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_first_and_last_last_value_default_frame", "label": "last_value default frame trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY implies RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, so last_value is the current row. first_value looks correct by accident because the frame starts at UNBOUNDED PRECEDING. Fix: full ROWS frame, or first_value over reversed ORDER BY."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_first_and_last_first_value", "label": "first_value", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame-relative start of the window. Default frame makes it the partition first row. first_value OVER (ORDER BY x DESC) is the preferred last-value spelling \u2014 no frame reasoning."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_first_and_last_nth_value", "label": "nth_value", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1-based, frame-relative. With the default frame, nth_value(x, 2) is NULL on the first row of each partition. No negative form \u2014 reverse the ordering. Named windows cannot override ORDER BY."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_first_and_last_last_value_default_frame", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_first_and_last_fi