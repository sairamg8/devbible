{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_the_two_rules", "label": "The two rules of a pure component", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_mind_your_own_business", "label": "Mind your own business", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not change objects or variables that existed before the call: props, state, context, refs, module variables."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_same_inputs_same_output", "label": "Same inputs, same output", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inputs are props, state and context only. Time, Math.random, window and localStorage are untracked."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_module_variable", "label": "Module-level mutation during render", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "react.dev Cup example: StrictMode doubling yields 2, 4, 6 instead of 1, 2, 3."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_ref_write_during_render", "label": "Writing a ref during render", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ref exists before the render. Mutability by design does not exempt it."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_usesyncexternalstore", "label": "useSyncExternalStore for external sources", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Window size, media queries and mutable singletons need a tracked subscription."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_mind_your_own_business", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_what_is_allowed_local_mutation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_module_variable", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_strictmode_and_the_compiler_doubling_is_the_test", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_usesyncexternalstore", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_same_inputs_same_output", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/purity/the-two-rules.html", "sourc