{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_empty_array_trap", "label": "The empty-array trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naked array_agg/jsonb_agg over LEFT JOIN yields [null] because the invented NULL child is a real group member. FILTER removes it and then the empty group is NULL. Both FILTER and coalesce(..., '[]'::jsonb) are required to reach []. '{}'' is an empty JSON object, not an array."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_child_collection_idiom", "label": "Canonical child-collection expression", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "coalesce(jsonb_agg(jsonb_build_object(...) ORDER BY ...) FILTER (WHERE child.id IS NOT NULL), '[]'::jsonb). Four parts: name fields, stable order, drop [null], empty group to []."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_lateral_nested_payload", "label": "Two-level LATERAL JSON payload", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LEFT JOIN LATERAL \u2026 ON true so the inner query can see c.id and childless parents stay. Inner GROUP BY o.id stops fan-out compounding. Measured 292 shaped bytes vs 580 flat."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_child_collection_idiom", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_empty_array_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_child_collection_idiom", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_build_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_empty_array_trap", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_string_agg", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_lateral_nested_payload", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_child_collection_idiom", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/the-empty-array-trap.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "json_child_collection_idiom", "label": "Canonical nested JSON child collection", "nodes": ["build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_build_object", "build_css_p2_docs_postgresq