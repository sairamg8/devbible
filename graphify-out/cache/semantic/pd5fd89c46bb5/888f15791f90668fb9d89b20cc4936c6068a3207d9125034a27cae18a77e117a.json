{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_05_string_decoder_string_decoder", "label": "StringDecoder", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/05-string-decoder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds a partial trailing byte sequence and prepends it to the next write so multi-byte characters split on chunk boundaries survive."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_05_string_decoder_chunk_tostring_corruption", "label": "Per-chunk toString corruption", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/05-string-decoder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunk boundaries fall on bytes, not characters. Decoding each half independently substitutes U+FFFD and the character is lost irreversibly."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_05_string_decoder_setencoding", "label": "stream.setEncoding", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/05-string-decoder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs a StringDecoder internally. After string mode you cannot recover exact bytes; size limits become character counts."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_05_string_decoder_character_vs_token_boundary", "label": "Character vs token boundaries", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/05-string-decoder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "StringDecoder fixes character boundaries only. A regex still misses a token split across chunks \u2014 that needs a framing Transform."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buff