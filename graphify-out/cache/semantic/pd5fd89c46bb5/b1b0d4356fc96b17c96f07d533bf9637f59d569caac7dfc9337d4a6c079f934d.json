{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_bind", "label": "Function.prototype.bind", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a new function whose this is permanent \u2014 bind only works once; call/apply cannot override. Constructor bind installs an own property that shadows the prototype method."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_arrow_field", "label": "Arrow class field", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field initialiser runs with this already the instance; the arrow captures it. One function per instance, not on the prototype \u2014 subclasses cannot override normally and super cannot reach it."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_call_site_wrapper", "label": "Call-site arrow wrapper", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best default: explicit, free, method stays on the prototype and overridable. Wrong for removable listeners because each arrow is a new function."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_removeeventlistener", "label": "removeEventListener identity match", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removal matches by function identity. An inline arrow cannot be removed. Store one bound function or arrow field and pass it to both add and remove."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_bind", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_how_methods_lose_this_detached_method", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_arrow_field", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_how_methods_lose_this_detached_method", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_call_site_wrapper", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_how_methods_lose_this_detached_method", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/this-in-methods/the-fixes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_bind", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_this_in_methods_the_fixes_arrow_fie