{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_withtransaction", "label": "withTransaction wrapper", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One place that knows connect/BEGIN/fn(client)/COMMIT/ROLLBACK/release. A handler cannot forget finally."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_begin_on_connection", "label": "BEGIN is a statement on a connection", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transaction is a property of one connection. connect() before BEGIN; every statement inside uses that client."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_pool_query_begin_not_tx", "label": "pool.query('BEGIN') is not a transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pool.query is a separate checkout. Idle-pool tests reuse one pid and pass. With 8 concurrent inserts, 7 survived ROLLBACK. No error is raised."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_try_catch_finally", "label": "try COMMIT catch ROLLBACK finally release", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swallowing the error turns a failed request into a silent 200. release() outside finally leaks a connection per failed request."}, {"id": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_rollback_preserves_error", "label": "ROLLBACK catch must not replace the original error", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If ROLLBACK throws (broken connection), wrap it and rethrow the original. Logs otherwise describe cleanup instead of the business failure."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_withtransaction", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_try_catch_finally", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_withtransaction", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_begin_on_connection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_pool_query_begin_not_tx", "target": "docs_postgresql_pages_phase_9_api_crud_05_transactions_request_01_the_wrapper_begin_on_connection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/05-transactions-request/01-the-wrapper.md", "source_location": null, "weig