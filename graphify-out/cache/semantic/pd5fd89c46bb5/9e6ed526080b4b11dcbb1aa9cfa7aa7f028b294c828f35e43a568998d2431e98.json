{"nodes": [{"id": "docs_git_pages_phase_0_how_git_stores_things_05_the_index", "label": "The index is a real file", "file_type": "document", "source_file": "docs/git/pages/phase-0-how-git-stores-things/05-the-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_05_the_index_binary_file", "label": ".git/index binary file", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/05-the-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staged is not a flag. git add writes a blob then records mode, hash, stage, path. Staging is a copy, not a bookmark."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_05_the_index_merge_stages", "label": "Index merge stages 0 1 2 3", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/05-the-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 0 is normal. During a conflict a path holds 1 base, 2 ours, 3 theirs. UU means those three exist and no stage 0."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_05_the_index_cached_stat", "label": "Cached stat data", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/05-the-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "status skips re-hash when size and mtime match. Network or Windows shares that lie about modes make every file look modified."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_05_the_index_add_p", "label": "git add -p", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/05-the-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null