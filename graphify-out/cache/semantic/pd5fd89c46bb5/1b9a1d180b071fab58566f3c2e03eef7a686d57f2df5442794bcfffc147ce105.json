{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_four_this_binding_rules", "label": "Four this binding rules", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "this is a hidden first parameter filled by the call site: new, then explicit, then implicit, then default."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_default_this_binding", "label": "Default this binding", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bare fn() is undefined in strict/module/class code and globalThis in sloppy. Module top-level this is undefined."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_implicit_this_binding", "label": "Implicit this binding", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "obj.fn() binds this to whatever is left of the last dot. The rest of the chain is irrelevant."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_explicit_this_binding", "label": "Explicit this binding", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "call/apply invoke immediately; bind returns a new function with this fixed. A bound function cannot be re-bound."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_new_this_binding", "label": "new this binding", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create object, link Fn.prototype, call with this bound, return it unless the constructor returns another object. A returned primitive is ignored."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_this_precedence", "label": "this precedence", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new beats bind beats call/apply beats implicit beats default. new on a bound function discards bound this but keeps bound arguments."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_four_this_binding_rules", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_default_this_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_four_this_binding_rules", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_implicit_this_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/this/the-four-rules.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_four_this_binding_rules", "target": "build_css_p2_docs_javascript_