{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_11_coverage_page", "label": "Coverage \u2014 why 100% is a bad target", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. Coverage measures which lines executed, not whether anything was checked."}, {"id": "docs_nodejs_pages_phase_9_testing_11_coverage_experimental_test_coverage", "label": "--experimental-test-coverage", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built in on Node 24 \u2014 no nyc or c8. Include/exclude, per-metric thresholds, lcov output."}, {"id": "docs_nodejs_pages_phase_9_testing_11_coverage_execution_not_assertion", "label": "Coverage records execution not assertions", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "withVat(19.99) returns 23.987999999999996 under 100% line, branch and function coverage. A float-money bug ships green because the line executed."}, {"id": "docs_nodejs_pages_phase_9_testing_11_coverage_hundred_percent_harm", "label": "100% coverage is actively harmful", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewards assertion-free tests, makes defensive code a liability, ends in istanbul ignore comments, and buys false confidence."}, {"id": "docs_nodejs_pages_phase_9_testing_11_coverage_uncovered_lines", "label": "Uncovered lines column", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The useful part of the report: error branches, catch blocks, leftover functions. Read the column, not the percentage."}, {"id": "docs_nodejs_pages_phase_9_testing_11_coverage_threshold_ratchet", "label": "Coverage threshold as a ratchet", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set slightly below current (80 when at 84) to fail large untested additions. Do not ratchet toward 100."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_11_coverage_execution_not_assertion", "target": "docs_nodejs_pages_phase_9_testing_11_coverage_experimental_test_coverage", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_11_coverage_hundred_percent_harm", "target": "docs_nodejs_pages_phase_9_testing_11_coverage_threshold_ratchet", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_11_coverage_page", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/11-coverage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_11_coverage_page", "target": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pa