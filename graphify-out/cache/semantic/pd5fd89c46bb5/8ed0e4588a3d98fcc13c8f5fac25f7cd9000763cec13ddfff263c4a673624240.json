{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_then_catch_finally", "label": "then, catch and finally", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_then", "label": "Promise.prototype.then", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a new promise that is always pending when returned. The handler always runs asynchronously, even if the current promise is already settled."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_default_handlers", "label": "Identity and thrower default handlers", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing onFulfilled is (x)=>x; a missing onRejected is (x)=>{throw x}. Error propagation is just the default thrower, one link at a time."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_catch", "label": "Promise.prototype.catch", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shortcut for then(undefined, onRejected). A catch that returns normally restores the chain to fulfilled."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_finally", "label": "Promise.prototype.finally", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transparent: a return is ignored and the original outcome passes through. A throw or rejected/pending return still replaces the outcome."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_executor_async_throw", "label": "Executor throws catch cannot see", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only a synchronous throw during the executor becomes a rejection. Async throws and throws after resolve() are not converted."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_catch", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_then", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_default_handlers", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_then", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/then-catch-finally.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_then_catch_finally_promise_then", "target": "build_css_p2_docs_javascript_pages_