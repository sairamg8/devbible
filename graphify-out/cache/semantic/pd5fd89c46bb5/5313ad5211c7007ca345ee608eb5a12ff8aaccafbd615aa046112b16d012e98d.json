{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_how_it_executes", "label": "How GROUP BY executes", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/how-it-executes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_how_it_executes_hashaggregate", "label": "HashAggregate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/how-it-executes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a hash table of groups in work_mem; preferred when no ordered input is required."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_how_it_executes_groupaggregate", "label": "GroupAggregate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/how-it-executes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregates already-sorted input; used when an index or Sort already matches the grouping keys."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_how_it_executes_work_mem_spill", "label": "work_mem Batches spill", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/how-it-executes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the hash table exceeds work_mem, HashAggregate spills Batches to disk."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_how_it_executes_partial_finalize", "label": "Partial and Finalize Aggregate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-