{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_13_publishing_publishing", "label": "Publishing a package", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/13-publishing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A checklist rather than a skill. The two irreversible parts are what ends up in the tarball and the version number you burn."}, {"id": "docs_nodejs_pages_phase_1_modules_13_publishing_scoped_packages", "label": "Scoped package names", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/13-publishing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scope is a namespace you own. Scoped packages default to private; publish publicly with --access public or publishConfig.access."}, {"id": "docs_nodejs_pages_phase_1_modules_13_publishing_npm_pack_dry_run", "label": "npm pack --dry-run", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/13-publishing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only way to see what you are actually shipping. Catches secrets going out and needed files staying home."}, {"id": "docs_nodejs_pages_phase_1_modules_13_publishing_publish_is_permanent", "label": "A published version is permanent", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/13-publishing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm unpublish is restricted to 72 hours and only when nothing depends on it. Recovery is npm deprecate plus a new version."}, {"id": "docs_nodejs_pages_phase_1_modules_13_publishing_prerelease_tag", "label": "Pre-release dist-tag", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/13-publishing.md", "source_loc