{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_physical_backup", "label": "Base backups and WAL archiving", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed providers do this; you still decide RPO/RTO. Logical restore measured 4\u00d7 dump because indexes rebuild."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_logical_vs_physical", "label": "Logical vs physical backups", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logical: portable, per-table, no PITR, slow restore. Physical: whole cluster, same major/arch, PITR, fast restore. Production wants both."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pitr", "label": "Point-in-time recovery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restore base backup, replay archived WAL to any later second. Base need not be a consistent snapshot; log replay repairs it like crash recovery."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_archive_command", "label": "archive_command", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must return non-zero on failure or WAL is deleted locally and never stored. test ! -f refuses overwrite. archive_mode=on requires a restart."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_archive_timeout", "label": "archive_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 0. Quiet databases may not fill a WAL segment for hours, so last hours are unarchived. Forces a switch and bounds RPO."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pg_basebackup", "label": "pg_basebackup -X stream", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streams WAL generated during the backup so it is restorable standalone. PG 18 incremental backups recombine with pg_combinebackup."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pg_stat_archiver", "label": "pg_stat_archiver failed_count", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Growing failed_count is an emergency: recovery window stops advancing and unreycled WAL fills pg_wal until the disk is full."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_physical_backup", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_logical_vs_physical", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pitr", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_logical_vs_physical", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_archive_command", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pitr", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_archive_timeout", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pitr", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pg_basebackup", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pitr", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pg_stat_archiver", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_archive_command", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_01_archiving_pg_stat_archiver", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_disk_space_alert", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/01-archiving.md", "source_location": null, "weight": 1.0}], "hyperedges": []}