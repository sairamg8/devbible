{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_what_counting_costs", "label": "What counting costs", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over the same 500000 rows, counting cost 27 ms to 209 ms. The expensive form is count(DISTINCT) because it cannot be parallelised."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_count_distinct_not_parallel", "label": "count(DISTINCT) is not combinable", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two workers both seeing user 7 cannot combine partial counts without the values. Falls back to a single-threaded external merge sort. 208.87 ms, Disk 5880kB."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_distinct_subquery_rewrite", "label": "DISTINCT-subquery rewrite", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) FROM (SELECT DISTINCT user_id \u2026) is a parallel HashAggregate. 208.87 ms \u2192 57.61 ms, 3.6\u00d7, no spill."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_index_flips_ranking", "label": "Index flips the rewrite ranking", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a btree leading on the counted column, count(DISTINCT) becomes an index-only scan at 63.53 ms / 575 buffers and beats the rewrite's 76.21 ms sequential scan."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_mvcc_no_row_count", "label": "MVCC prevents a stored row count", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The correct count depends on the asking transaction's snapshot. A stored counter would also serialise every insert and delete."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_what_counting_costs", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_count_distinct_not_parallel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_distinct_subquery_rewrite", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_count_distinct_not_parallel", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/03-what-counting-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_index_flips_ranking", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_03_what_counting_costs_distinct_subquery_rewrite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", 