{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_page", "label": "GiST, BRIN and hash", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_brin_index", "label": "BRIN index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Block Range INdex stores min/max per 128-page range. Tiny filter, not a lookup; needs physical correlation near \u00b11. 24 kB vs 64 MB B-tree on 3M ordered rows."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_physical_correlation", "label": "Physical correlation", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_stats.correlation near 1 or \u22121 makes BRIN useful. Shuffled data at 0.0119 caused the planner to ignore the BRIN index entirely."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_hash_index", "label": "Hash index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equality only. Cannot UNIQUE (0A000), range, ORDER BY, INCLUDE, or index-only scans. Crash-safe since PostgreSQL 10. Smaller on wide keys."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_gist_index", "label": "GiST index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framework for overlap, containment and distance on types with no total order: ranges, PostGIS, inet, nearest-neighbour."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_exclusion_constraint", "label": "Exclusion constraint", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXCLUDE USING gist (room WITH =, during WITH &&) raises 23P01 on overlap. Needs btree_gist for equality types. Cannot be expressed with UNIQUE or CHECK."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_brin_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_physical_correlation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gist_brin_hash_hash_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gist-brin-hash.html", "source_location": null, "weight": 1.0}, {