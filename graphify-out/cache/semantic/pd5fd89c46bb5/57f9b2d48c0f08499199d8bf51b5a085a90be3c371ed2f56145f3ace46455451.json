{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse", "label": "Streaming responses and SSE", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_chunked_transfer_encoding", "label": "Chunked transfer encoding", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omit Content-Length and Node sets Transfer-Encoding: chunked automatically so the first byte reaches the client while the rest is still being produced."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_server_sent_events", "label": "Server-Sent Events", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One long-lived chunked HTTP response, server to client only \u2014 no upgrade, survives HTTP/1.1 proxies. Prefer over WebSockets when traffic is one-way."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_last_event_id", "label": "Last-Event-ID resumption", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser stores SSE id: and replays it as Last-Event-ID on reconnect so the server can resume instead of replaying or dropping events."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_pipeline_over_pipe", "label": "pipeline over pipe for streaming", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".pipe() leaves both ends open when a client disconnects, so a database query keeps running. pipeline propagates destruction."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_chunked_transfer_encoding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_server_sent_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_server_sent_events", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_chunked_transfer_encoding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/streaming-and-sse.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_server_sent_events", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse_last_event_id", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 