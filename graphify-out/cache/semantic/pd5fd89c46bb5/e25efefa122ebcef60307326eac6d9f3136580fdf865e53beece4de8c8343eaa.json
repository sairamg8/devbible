{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "label": "Promise anti-patterns", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_explicit_construction", "label": "Explicit construction antipattern", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapping an already-promise API in new Promise adds a forgotten-reject path and a never-settling promise. new Promise belongs only around callback or event APIs."}, {"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_async_executor", "label": "Async Promise executor", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "throw rejects the executor's own promise, which nobody holds. The constructed promise stays pending forever. On modern Node the orphaned rejection is a fatal unhandledRejection."}, {"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_nested_then", "label": "Nesting .then instead of chaining", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds the callback pyramid. Inner promises are floating; an outer .catch never sees their rejections."}, {"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_forgotten_return", "label": "Forgotten return inside .then", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a => { get(a); } returns undefined so the chain resolves immediately while inner work is unwatched. Concise a => get(a) avoids it."}, {"id": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_return_await_in_try", "label": "return await inside try is not redundant", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without await the promise is returned before it settles, so the enclosing catch never runs. Everywhere else return await just adds microtask ticks."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "target": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_explicit_construction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "target": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_async_executor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "target": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_nested_then", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "target": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_forgotten_return", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_forgotten_return", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_return_or_not_chained", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_explicit_construction", "target": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_new_promise_only_for_wrapping", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_return_await_in_try", "target": "docs_nodejs_pages_phase_2_async_11_error_handling_try_catch_await", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_async_executor", "target": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_unhandled_rejection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/17-promise-antipatterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "target": "docs_nodejs_pages_phase_2_async_12_floating_promises_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"