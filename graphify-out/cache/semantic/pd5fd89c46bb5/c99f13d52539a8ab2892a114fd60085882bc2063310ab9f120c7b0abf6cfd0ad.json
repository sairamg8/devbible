{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_the_jit_v8_tiers", "label": "V8 compilation tiers", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/the-jit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignition interprets, Sparkplug baselines, Maglev mid-tier, TurboFan fully optimises hot type-stable functions."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_the_jit_deoptimisation", "label": "Deoptimisation", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/the-jit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimised add(a,b) fell out of TurboFan after strings and objects. Nothing in the function changed \u2014 only the shapes flowing through it."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_the_jit_stable_shapes", "label": "Keep data shapes stable", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/the-jit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not tune for the JIT. Normalise payloads at the boundary so every downstream object has the same keys in the same order."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_the_jit_cold_vs_warm", "label": "Cold vs warm micro-benchmarks", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/the-jit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical function 28x apart cold versus warm, reproduced. A single timing measures compilation state, not the code."}], "edges": [{"source": "build