{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "label": "numeric exact decimal", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact software decimal. numeric(12,2) is 12 digits, 2 after the point. Default for money; 1000\u00d70.01 sums to 10.00."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_double_precision", "label": "double precision (float8)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast approximate binary float. 1000\u00d70.01 stored as 9.999999999999831 so WHERE total = 10 finds nothing. Use for measurements, not money."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_integer_cents", "label": "Integer cents in bigint", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact and as fast as float8 (27.7 ms vs 76.8 ms numeric on 300k sums). Units become implicit; name columns total_cents."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_overflow_22003", "label": "numeric field overflow 22003", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exceeding declared precision errors; extra scale rounds silently."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_half_away_from_zero", "label": "numeric half-away-from-zero rounding", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2.5::numeric(2,0) \u2192 3; float-to-int uses half-to-even \u2192 2. numeric NaN compares equal to itself so it can be indexed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric_as_string", "label": "pg returns numeric as a string", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converting to JS Number would discard exactness. Do arithmetic in SQL or use a decimal library; never setTypeParser(1700, parseFloat)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_double_precision", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_integer_cents", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/numeric-vs-float.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_overflow_22003", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, 