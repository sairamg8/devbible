{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_statement", "label": "MERGE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL-standard insert/update/delete in one pass from a source. Not a drop-in ON CONFLICT replacement; wrong tool for concurrent upsert. Does support RETURNING and merge_action()."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_not_concurrent_upsert", "label": "MERGE is not concurrency-safe for upsert", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MERGE can still raise a unique violation under concurrent inserts because it does not use the unique index as an arbiter the same way ON CONFLICT does."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_statement", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_not_concurrent_upsert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_not_concurrent_upsert", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_merge_statement", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on", "relation": "references