{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_what_you_can_select", "label": "What you are allowed to select", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every expression must reduce to one value per group. PostgreSQL refuses to guess; the error is 42803, the most-seen SQL error in this phase."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_error_42803", "label": "42803 grouping error", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL loose mode picks an arbitrary row. ONLY_FULL_GROUP_BY restores strictness; PostgreSQL never had the loose mode."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_four_ways_out", "label": "Four ways out of 42803", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add to GROUP BY (changes grouping), take min/max/array_agg[1], collect all values, or take one whole row via DISTINCT ON / row_number. Do not add to GROUP BY reflexively."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_distinct_on", "label": "DISTINCT ON one whole row per group", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every column comes from the same row. min(id), max(total) can invent a pair that never existed. ORDER BY must start with the DISTINCT ON keys; add NULLS LAST."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_functional_dependency", "label": "Functional dependency on primary key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY o.id licenses o.status. Per table only; grouping by the other side's key is 42803. Lost inside UNION/DISTINCT/SRF views."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_unique_not_fd", "label": "UNIQUE does not grant functional dependency", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A unique column can be NULL and NULLs group together, so uniqueness alone does not guarantee one row per group. Requires a declared PRIMARY KEY."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_what_you_can_select", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_error_42803", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/03-what-you-can-select.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_four_ways_out", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_03_what_you_can_select_error_42803", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggrega