{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_backoff_and_jitter", "label": "Exponential backoff and jitter", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_exponential_backoff", "label": "Exponential backoff with cap", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "min(cap, base * 2^(attempt-1)). Uncapped doubling from 100 ms is 200 seconds by attempt 12. Cap delay and attempt count."}, {"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_full_jitter", "label": "Full jitter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "random(0, backoff). AWS full-jitter default. Equal jitter when a minimum spacing is required. Decorrelated for long-running pollers."}, {"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_thundering_herd", "label": "Thundering herd of synchronised retries", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "500 clients, no jitter: all 500 in one 100 ms bucket at 700 ms. Full jitter: busiest bucket 122. Failures are correlated; deterministic schedules stay correlated."}, {"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_retry_after", "label": "Honour Retry-After", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the server tells you when to come back, obey it rather than your own schedule."}, {"id": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_circuit_breaker", "label": "Circuit breaker after repeated failures", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backoff does not reduce total load during a long outage. Fail fast after N consecutive failures, then probe with a single request."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_backoff_and_jitter", "target": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_backoff_and_jitter", "target": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_full_jitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_full_jitter", "target": "docs_nodejs_pages_phase_7_background_work_15_backoff_and_jitter_thundering_herd", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/15-backoff-and-jitter.md", "source_location": null, "weight": 1.0}, {"source": "docs_no