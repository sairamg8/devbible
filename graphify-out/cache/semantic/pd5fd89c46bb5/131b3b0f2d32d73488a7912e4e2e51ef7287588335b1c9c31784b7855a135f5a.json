{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_2_operators_phase_2", "label": "Phase 2 Operators, expressions and control flow", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fifteen high-frequency operator and control-flow topics. Invisible-on-review bugs are precedence (?? with ||, right-associative **) and ASI."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_remainder_vs_modulo", "label": "Remainder vs modulo", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "% is remainder and takes the sign of the dividend: -7 % 3 is -1, not 2. Real modulo is ((a % b) + b) % b."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_right_associative_exponentiation", "label": "Right-associative **", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2 ** 3 ** 2 is 512, not 64. ** is the only right-associative arithmetic operator. -2 ** 2 is a SyntaxError."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_optional_chaining_non_function", "label": "Optional chaining does not protect non-functions", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nf.notAFunction?.() still throws TypeError. ?.() only guards null/undefined."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_double_tilde_32bit", "label": "~~ 32-bit wrap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~~1e10 is 1410065408. The fast-truncate trick wraps at 32 bits; Math.trunc gives 10000000000."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_for_in_prototype_chain", "label": "for...in walks the prototype chain", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for...in walks the prototype chain and yields string indices on arrays."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_asi", "label": "Automatic semicolon insertion", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five dangerous line starts break a file that omits semicolons. Phase gate requires the exact rules, not folklore."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_nullish_or_syntaxerror", "label": "?? mixed with || is a SyntaxError", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a ?? b || c is a SyntaxError. Precedence of ?? with || is one of the five operators that actually bite."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_2_operators_phase_2", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_phase_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_page