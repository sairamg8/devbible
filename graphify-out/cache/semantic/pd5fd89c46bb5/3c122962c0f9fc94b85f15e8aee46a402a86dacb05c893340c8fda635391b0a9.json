{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_local_install_container_first", "label": "Container-first local Postgres", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/local-install.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin major (postgres:18-alpine), reset in one command, match CI. Prefer that over a host distro package until you need native."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_local_install_ipv4_published_port", "label": "127.0.0.1 and published port 55432", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/local-install.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node resolves localhost to ::1 first; IPv4 publishes fail. Non-default 55432:5432 avoids colliding with a host Postgres on 5432."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_local_install_container_first", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_local_install_ipv4_published_port", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/local-install.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_local_install_container_first", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_version_policy_server_version_num", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/local-install.html", "source_location": null, "weight": 1.0}], "hyperedges": []}