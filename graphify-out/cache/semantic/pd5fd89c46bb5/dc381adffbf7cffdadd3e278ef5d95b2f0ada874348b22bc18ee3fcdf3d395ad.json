{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_12_node_sqlite_node_sqlite", "label": "node:sqlite", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/12-node-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node ships SQLite 3.53.3. Zero-setup SQL for learning, tests, and local tools \u2014 not a networked PostgreSQL replacement."}, {"id": "docs_nodejs_pages_phase_6_data_access_12_node_sqlite_databasesync", "label": "DatabaseSync", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/12-node-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronous by design: a local file, not a socket. A slow query blocks the event loop."}, {"id": "docs_nodejs_pages_phase_6_data_access_12_node_sqlite_bigint_throws", "label": "SQLite integers throw above MAX_SAFE_INTEGER", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/12-node-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERR_OUT_OF_RANGE rather than silent rounding. setReadBigInts(true) returns BigInt."}, {"id": "docs_nodejs_pages_phase_6_data_access_12_node_sqlite_autocommit_fsync", "label": "SQLite autocommit fsync", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/12-node-sqlite.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each write outside a transaction is its own fsync. 1000 inserts: 66 ms autocommit vs 1 ms in one transaction."}, {"id": "docs_nodejs_pages_phase_6_data_access_12_node_sqlite_defensive_mode", "label": "SQLite defensive mode", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/12-node-sqlite.md", "source_location": null, "source_url": null, "c