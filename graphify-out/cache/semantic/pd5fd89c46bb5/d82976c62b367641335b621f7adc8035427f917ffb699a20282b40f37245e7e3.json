{"nodes": [{"id": "sandbox_git_p0_ex1_output_git_2550_environment_probe", "label": "Git 2.55.0 environment probe", "file_type": "document", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured porcelain surface, default branch, ref backend, object hash, pull-on-diverge, switch/restore, empty identity, and blob hashing on git 2.55.0."}, {"id": "sandbox_git_p0_ex1_output_git_version_2550", "label": "Git version 2.55.0", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sandbox_git_p0_ex1_output_porcelain_surface", "label": "Git porcelain surface", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "46 main commands from git help -a first section; 172 commands on PATH."}, {"id": "sandbox_git_p0_ex1_output_absent_commands", "label": "filter-repo and LFS absent", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "switch, restore, sparse-checkout, worktree, maintenance, replay, backfill, last-modified, bundle, range-diff, filter-branch are builtins; filter-repo and lfs are ABSENT; scalar reports git version 2.55.0."}, {"id": "sandbox_git_p0_ex1_output_init_default_branch", "label": "init.defaultBranch unset uses master", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With init.defaultBranch unset, git init still names the first branch master and hints that Git 3.0 will change the default to main. HEAD points at refs/heads/master."}, {"id": "sandbox_git_p0_ex1_output_ref_storage_backend", "label": "Git ref storage backend", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default ref format is files; loose-ref layout is heads and tags."}, {"id": "sandbox_git_p0_ex1_output_reftable", "label": "reftable ref format", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reftable is supported; on-disk tables.list shows a 0x000000000001-0x000000000001-5d9a0b8b.ref table."}, {"id": "sandbox_git_p0_ex1_output_object_hash", "label": "Default object hash SHA-1", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default object hash is sha1; sha256 is supported as an alternate object format."}, {"id": "sandbox_git_p0_ex1_output_sha256_object_format", "label": "SHA-256 object format", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sandbox_git_p0_ex1_output_divergent_pull", "label": "Divergent pull requires reconcile", "file_type": "rationale", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With pull.rebase unset, a bare git pull on diverged branches is fatal: Need to specify how to reconcile divergent branches. Options are pull.rebase false (merge), true (rebase), or pull.ff only."}, {"id": "sandbox_git_p0_ex1_output_git_switch", "label": "git switch", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git switch is a builtin and is no longer advertised as experimental; usage is git switch [<options>] [<branch>]."}, {"id": "sandbox_git_p0_ex1_output_git_restore", "label": "git restore", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git restore is a builtin; usage is git restore [<options>] [--source=<branch>] <file>..."}, {"id": "sandbox_git_p0_ex1_output_empty_identity", "label": "Empty author identity failure", "file_type": "rationale", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Why every setup guide starts with user.email: commit fails with Author identity unknown / Please tell me who you are until user.email and user.name are set."}, {"id": "sandbox_git_p0_ex1_output_empty_blob_hash", "label": "Empty blob hash e69de29", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hash-object of an empty file is e69de29bb2d1d6434b8b29ae775ad8c2e48c5391; raw object header is blob."}, {"id": "sandbox_git_p0_ex1_output_blob_header_hash", "label": "Blob header plus content hash", "file_type": "concept", "source_file": "sandbox/git-p0/ex1-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHA-1 of blob 6\\0hello\\n is ce013625030ba8dba906f756967f9e9ca394464a and matches what git reports."}], "edges": [{"source": "sandbox_git_p0_ex1_output_git_2550_environment_probe", "target": "sandbox_git_p0_ex1_output_git_version_2550", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1