{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_what_an_effect_is_for", "label": "What an effect is for", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_synchronize_external", "label": "Synchronize with an external system", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you are not synchronizing with a browser API, widget, network, or non-React component, you probably do not need an Effect."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_effects_vs_events", "label": "Effects versus events", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effects are caused by rendering; events by a particular interaction. Ask why it happens. If the answer names a user action, it is not an effect."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_not_didmount", "label": "componentDidMount is the wrong model", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useEffect(fn, []) stays connected to the first room forever. Synchronization with real deps and cleanup handles mount, update, and unmount."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_client_only", "label": "Effects only run on the client", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They cannot produce server HTML. They are the legal place for window, document, localStorage after mount."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_paint_unguaranteed", "label": "Passive-effect paint timing is unguaranteed", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interaction-caused Effects may run before paint; React may also paint before processing state updates inside them. For a guarantee use useLayoutEffect or setTimeout."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_what_an_effect_is_for", "target": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_synchronize_external", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_effects_vs_events", "target": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_synchronize_external", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_not_didmount", "target": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_the_dependency_array", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_paint_unguaranteed", "target": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_uselayouteffect", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/what-an-effect-is-for.html", "source_location": null, "weight": 1.0}], "hyperedges": []}