{"nodes": [{"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_page", "label": "Control flow and choosing a loop", "file_type": "document", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_capability_table", "label": "Loop capability table", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Need break, continue, enclosing return or await? forEach and array methods are out. Produce a value with map/filter/find."}, {"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_foreach_return", "label": "return inside forEach", "file_type": "concept", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns from the callback like continue, not from the enclosing function. findUser always returns null."}, {"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_await_sequential_vs_concurrent", "label": "for...of await vs Promise.all map", "file_type": "concept", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach(async) discards promises. Sequential for...of bounds load; Promise.all starts every request at once."}, {"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_labels", "label": "Labelled break", "file_type": "concept", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "outer: for (...) { break outer } exits both loops. No labelled escape from forEach."}, {"id": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_modify_while_iterating", "label": "Iterating while modifying", "file_type": "concept", "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach fixes its range up front. for...of re-reads length, so push inside the same array is an infinite loop."}], "edges": [{"source": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_page", "target": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_01_what_each_iterates_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02-loop-forms/02-control-flow-and-choosing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_02_control_flow_and_choosing_capability_table", "target": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_01_what_each_iterates_foreach", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-6-iteration-and-destructuring/02