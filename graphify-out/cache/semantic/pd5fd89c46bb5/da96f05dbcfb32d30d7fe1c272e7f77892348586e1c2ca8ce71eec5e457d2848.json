{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_02_node_assert_page", "label": "node:assert \u2014 strict mode and deep equality", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/02-node-assert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import node:assert/strict, never the legacy == module. Verified Node 24.19.0."}, {"id": "docs_nodejs_pages_phase_9_testing_02_node_assert_assert_strict", "label": "node:assert/strict", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/02-node-assert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "legacy.equal(1, '1') passes. An assertion that ignores type is worse than none. assert.equal in strict is strictEqual."}, {"id": "docs_nodejs_pages_phase_9_testing_02_node_assert_deep_strict_equal", "label": "deepStrictEqual rules", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/02-node-assert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object.is: NaN equals NaN, 0 \u2260 -0. Prototypes compared so a class instance \u2260 a literal. Holes \u2260 undefined. Explicit undefined keys count. Maps ignore insertion order."}, {"id": "docs_nodejs_pages_phase_9_testing_02_node_assert_throws_matcher", "label": "assert.throws matcher", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/02-node-assert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regexp, property subset, or class. A string is the failure message and can raise ERR_AMBIGUOUS_ARGUMENT. Matcher functions must return true. rejects must be awaited."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_02_node_assert_page", "target": "docs_nodejs_pages_phase_9_testing_02_node_assert_