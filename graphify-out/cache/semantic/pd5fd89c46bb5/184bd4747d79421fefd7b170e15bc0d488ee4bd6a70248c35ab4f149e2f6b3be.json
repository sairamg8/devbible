{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_page", "label": "06 \u00b7 Numbers are doubles", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_ieee754_double", "label": "IEEE-754 double number type", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript has one number type: a 64-bit float. 0.1 + 0.2 !== 0.3 because both are repeating binary fractions. This is not a JS-only flaw."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_money_minor_units", "label": "Store money as integer minor units", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do arithmetic in paise/cents; Math.round once where a fraction is created; divide by 100 only when formatting with Intl.NumberFormat. Never toFixed money \u2014 1.005 stores as slightly less so toFixed(2) is '1.00'."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_max_safe_integer", "label": "Number.MAX_SAFE_INTEGER", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "53-bit significand: integers above 2^53-1 collapse. JSON.parse silently corrupts bigint IDs; send IDs as strings or recover via reviver ctx.source + BigInt."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_money_minor_units", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_ieee754_double", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_ieee754_double", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_max_safe_integer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_page", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_nan_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_numbers_are_doubles_ieee754_double", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_is_and_zero_infinity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/numbers-are-doubles.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "js_ieee754_numeric_specials", "label": "IEEE-754 numeric specials: doubles, NaN,