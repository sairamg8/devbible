{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice_splice", "label": "Array.prototype.splice", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing/splice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-place remove/insert/replace. Returns the removed elements, not the array."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice_tospliced", "label": "Array.prototype.toSpliced", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing/splice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES2023 non-mutating counterpart; returns the new dense array, not the removed items."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice_omit_deletecount", "label": "Omitted splice deleteCount", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing/splice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "splice(i) deletes from i to the end; splice(i, 0) inserts. Omitting deleteCount is not 0."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice_forward_loop", "label": "splice in a forward loop", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing/splice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing at i shifts later items down so i++ skips the next. Filter or iterate backwards."}, {"id": "build_css_p2_docs_javascript_pages_ph