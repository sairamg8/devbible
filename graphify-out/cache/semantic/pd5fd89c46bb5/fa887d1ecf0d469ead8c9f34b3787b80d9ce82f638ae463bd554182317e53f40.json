{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_allowlist", "label": "Allow-list filter and sort fields", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never pass raw req.query into Mongo or SQL builders. Allow-list fields and operators. Prevents sorting on unindexed or sensitive columns and injection-style operators."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_mongo_operator_injection", "label": "Mongo operator injection via query", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "?filter[$gt]=\u2026 injects operators when query objects are merged blindly. Fix with allow-list plus parameterized queries."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_bounded_search", "label": "Bounded full-text search", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search endpoints that hit full-text indexes belong behind explicit q params and timeouts. Do not run unbounded scans on the request thread."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_allowlist", "target": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_mongo_operator_injection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_allowlist", "target": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_mongo_operator_injection", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_bounded_search", "target": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_allowlist", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_04_filter_sort_search_allowlist", "target": "docs_expressjs_pages_phase_6_rest_surface_05_versioning_url_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/04-filter-sort-search.md", "source_location": null, "weight": 1.0}], "hyperedges": []}