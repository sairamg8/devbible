{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_structuredclone", "label": "structuredClone", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in deep clone via the structured clone algorithm. Rebuilds cycles to point at the clone. Preserves Map, Set, Date, RegExp and typed arrays."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_silent_losses", "label": "structuredClone silent losses", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops the prototype chain, descriptors, getters/setters, private elements and RegExp.lastIndex. A frozen object comes back writable."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_dataclonerror", "label": "DataCloneError", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functions and DOM nodes throw DataCloneError. Throwing at the clone is better than JSON silently dropping functions."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_transfer", "label": "structuredClone transfer option", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves transferable objects instead of copying them. The original ArrayBuffer is detached and byteLength becomes 0. Only use when nothing still reads the source."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_structuredclone", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_shallow_copy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_silent_losses", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_structuredclone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_dataclonerror", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_structuredclone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/02-structuredclone.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_transfer", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_02_structuredclone_structuredclone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidenc