{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_lost_this", "label": "Lost this", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicit binding is a property of the call site. Assigning, destructuring, or passing a method drops the receiver."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_thisarg", "label": "thisArg", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach/map/filter/some/every/find/findIndex/flatMap honour thisArg. reduce and sort do not."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_arrow_callback_fix", "label": "Arrow callback this fix", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An arrow has no this, so the inner obj.method() keeps its receiver. Wrong as the method itself at module scope."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_bind_identity_trap", "label": "bind identity trap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bind returns a new function each call, so removeEventListener never matches. Store the bound function once."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_class_field_arrow", "label": "Class field arrow", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-instance own property capturing constructor this. Survives detach; not on the prototype so it cannot be stubbed or overridden there."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_lost_this", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_implicit_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_lost_this", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_default_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_arrow_callback_fix", "target": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_lost_this", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/02-losing-and-fixing-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_bind_identity_trap", "target": "docs_javascript_pages_phase_3_functions_03_this_02_losing_and_fixing_this_lost_this", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "do