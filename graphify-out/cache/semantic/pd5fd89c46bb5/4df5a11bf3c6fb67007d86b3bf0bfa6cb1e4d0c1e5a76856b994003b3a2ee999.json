{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_page", "label": "pg_stat_statements", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_pg_stat_statements", "label": "pg_stat_statements", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranks statements by total time after normalising literals to $n. Requires shared_preload_libraries and a restart."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_total_exec_time", "label": "total_exec_time ranking", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order by total, not mean. A 18 ms query run 500 times (9240 ms) outranks an 87 ms query run twice (173 ms)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_shared_preload_libraries", "label": "shared_preload_libraries", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_stat_statements hooks the executor and must be preloaded. CREATE EXTENSION alone leaves an empty view."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_dealloc", "label": "pg_stat_statements.max dealloc", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 5000 distinct normalised statements. Overflow evicts least-executed; growing dealloc means raise max or stop unparameterised IN-list churn."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_pg_stat_statements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_total_exec_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_shared_preload_libraries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_pg_stat_statements_dealloc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/pg-stat-statements.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_