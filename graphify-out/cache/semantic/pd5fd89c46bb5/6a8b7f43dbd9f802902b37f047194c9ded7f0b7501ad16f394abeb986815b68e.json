{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_dead_zone", "label": "Temporal dead zone", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From block entry until the let/const/class declaration initialises the binding. The slot exists but is empty; a read throws ReferenceError."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_not_positional", "label": "TDZ is temporal not positional", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function defined above a let may close over it. Only a read that runs before the declaration throws."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_declaration_closes_tdz", "label": "Declaration closes the TDZ", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let x; initialises to undefined and ends the zone. const without an initialiser is a parse-time SyntaxError."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_self_reference_initializer", "label": "Self-referential initializer", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let x = x throws because the RHS is evaluated before initialisation. var y = y silently assigns undefined."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_per_iteration_binding", "label": "Per-iteration TDZ binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for (const item of items) is legal because each iteration declares a new binding. Same machinery as let-in-a-loop closures."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_dead_zone", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_01_the_two_step_scope_entry_two_step_scope_entry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_not_positional", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_dead_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/03-the-temporal-dead-zone.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_declaration_closes_tdz", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_03_the_temporal_dead_zone_temporal_dead_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-t