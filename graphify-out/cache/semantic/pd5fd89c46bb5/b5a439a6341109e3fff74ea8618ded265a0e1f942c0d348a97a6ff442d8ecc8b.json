{"nodes": [{"id": "docs_javascript_pages_phase_7_async_04_callbacks_04_callback_hell_callback_hell", "label": "Callback hell / pyramid of doom", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/04-callback-hell.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forced because a callback API returns nothing to sequence on. Real cost is per-level if (err) return, not indentation."}, {"id": "docs_javascript_pages_phase_7_async_04_callbacks_04_callback_hell_named_functions_not_the_fix", "label": "Named functions do not fix callback hell", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/04-callback-hell.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flattens indentation, hides sequence, loses closures, keeps per-level error branches, and leaves every trust problem in place."}, {"id": "docs_javascript_pages_phase_7_async_04_callbacks_04_callback_hell_one_result_later_vs_many", "label": "Promise for one result, callback for many", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/04-callback-hell.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a promise for one result later; a callback for a function to run or many results over time. Promises are one-shot."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_04_callbacks_04_callback_hell_callback_hell", "target": "docs_javascript_pages_phase_7_async_04_callbacks_04_callback_hell_named_functions_not_the_fix", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/04-callbacks/04-callback-hell.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_04