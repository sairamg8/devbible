{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_limit_offset", "label": "LIMIT and OFFSET", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_offset_linear_cost", "label": "OFFSET cost grows with depth", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET is defined as produce then discard. Measured 1.22 ms at 0 vs 105.85 ms at 499980 on 500000 rows; EXPLAIN showed rows=500000 feeding Limit of 20."}, {"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_keyset_pagination", "label": "Keyset pagination", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE id > $1 ORDER BY id LIMIT 20 seeks the index. Same depth: 0.93 ms and 4 buffers versus 105.85 ms and 5045. Costs random access."}, {"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_offset_page_drift", "label": "OFFSET pages drift under writes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A count, not a position. An insert between requests serves the boundary row twice; a delete hides a row. Keyset uses a value cursor."}, {"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_unique_tiebreaker", "label": "Unique ORDER BY tiebreaker", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties have undefined order. Paging 100 rows by 5 without a unique column: 54 distinct ids and 46 repeats. Append the primary key."}, {"id": "docs_postgresql_pages_phase_4_crud_03_limit_offset_limit_n_plus_1", "label": "LIMIT n+1 next-page flag", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) on 500000 rows was 25.69 ms; reltuples 0.49 ms. Asking for one extra row answers has-next at no extra scan. Clamp user LIMIT."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_03_limit_offset_limit_offset", "target": "docs_postgresql_pages_phase_4_crud_03_limit_offset_offset_linear_cost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_03_limit_offset_keyset_pagination", "target": "docs_postgresql_pages_phase_4_crud_03_limit_offset_offset_linear_cost", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_03_limit_offset_limit_offset", "target": "docs_postgresql_pages_phase_4_crud_20_tuple_comparison_tuple_comparison", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/03-limit-offset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_03_limit_offset_unique_tiebreaker", "target": "docs_postgresql_pages_phase_4_crud_10_order_by_order_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/