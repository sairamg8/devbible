{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_08_jsonb_jsonb_vs_json", "label": "jsonb vs json", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "json stores exact text. jsonb parses to binary: keys sorted, last duplicate wins, whitespace dropped. json has no equality operator (42883). jsonb was larger on a small object (112 vs 56 bytes)."}, {"id": "docs_postgresql_pages_phase_2_types_08_jsonb_gin_index", "label": "GIN index on jsonb", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200k rows: jsonb ->> 33.6 ms vs json 98.7 ms unindexed; @> with GIN 9.4 ms. json cannot be GIN-indexed (42704). ->> equality does not use default GIN; use @> or a B-tree expression index."}, {"id": "docs_postgresql_pages_phase_2_types_08_jsonb_promote_keys", "label": "Promote queried jsonb keys to columns", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A jsonb key has no CHECK, FK, statistics, or cheap B-tree. Use jsonb for schemaless payloads; promote keys you filter or join. A generated column is the migration-free middle step. Pass objects to pg; JSON.stringify double-encodes."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_08_jsonb_gin_index", "target": "docs_postgresql_pages_phase_2_types_08_jsonb_jsonb_vs_json", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_08_jsonb_promote_keys", "target": "docs_postgresql_pages_phase_2_types_08_jsonb_jsonb_vs_json", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_08_jsonb_promote_keys", "target": "docs_postgresql_pages_phase_2_types_15_domains_composites_avoid_composites", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-2-types/08-jsonb.md", "source_location": null, "weight": 1.0}], "hyperedges": []}