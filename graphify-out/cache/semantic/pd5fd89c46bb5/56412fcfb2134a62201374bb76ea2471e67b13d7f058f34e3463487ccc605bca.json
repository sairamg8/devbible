{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authn_vs_authz", "label": "Authentication vs authorization", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authentication", "label": "Authentication", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Who you are. One chokepoint at the edge. 401 means I do not know who you are."}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authorization", "label": "Authorization", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What that identity may do. A decision at every object, always server-side. Hidden buttons and JWT role claims are not enforcement."}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_bola", "label": "Broken object-level authorization", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authenticated, never checks the record is yours. Put the owner in the WHERE so the unscoped fetch is unreachable. Near the top of the OWASP API list."}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_404_not_403", "label": "Return 404 not 403 for foreign objects", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 403 confirms the record exists and leaks invoice numbering, user counts, registered emails. Reserve 403 for actions where existence is not a secret."}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_rbac", "label": "RBAC and ABAC", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start with ownership. RBAC when permissions are not 'is this mine' \u2014 name actions, not screens. ABAC is more expressive and harder to audit; do not start there."}, {"id": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_deny_by_default", "label": "Deny by default at the router", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A route with no declared permission should throw at startup. A Friday endpoint with no check is the common regression; enumerate routes in a test."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authn_vs_authz", "target": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/04-authentication-vs-authorization.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authn_vs_authz", "target": "docs_nodejs_pages_phase_8_security_04_authentication_vs_authorization_authorization", "relation": "ref