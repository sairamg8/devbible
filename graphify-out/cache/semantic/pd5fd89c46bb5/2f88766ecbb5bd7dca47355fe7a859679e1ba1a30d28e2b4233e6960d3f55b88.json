{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_05_wal_write_ahead_log", "label": "Write-ahead log", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential record of changes flushed so the database can recover after a crash and stream changes to replicas. Never delete WAL files by hand."}, {"id": "docs_postgresql_pages_phase_0_architecture_05_wal_commit_flush", "label": "COMMIT flushes WAL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under default synchronous settings COMMIT succeeds only after the needed WAL is flushed. BEGIN is cheap; modifying data generates WAL; commit makes it durable."}, {"id": "docs_postgresql_pages_phase_0_architecture_05_wal_double_write", "label": "Change is written twice", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once to WAL immediately for durability/order, later to heap/index files via dirty shared buffers, checkpoints, and the background writer. Normal, not a bug."}, {"id": "docs_postgresql_pages_phase_0_architecture_05_wal_wal_level_replica", "label": "wal_level = replica", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured usual default on PostgreSQL 18.4. Supports physical replication."}, {"id": "docs_postgresql_pages_phase_0_architecture_05_wal_checkpoint", "label": "Checkpoint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes dirty buffers out so data files catch up with WAL. Lagging checkpoints can grow pg_wal."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_05_wal_commit_flush", "target": "docs_postgresql_pages_phase_0_architecture_05_wal_write_ahead_log", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_05_wal_double_write", "target": "docs_postgresql_pages_phase_0_architecture_05_wal_write_ahead_log", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_05_wal_double_write", "target": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_shared_buffers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_05_wal_write_ahead_log", "target": "docs_postgresql_pages_phase_0_architecture_05_wal_wal_level_replica", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_05_wal_checkpoint", "target": "docs_postgresql_pages_phase_0_architecture_05_wal_write_ahead_log", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/05-wal.md", "s