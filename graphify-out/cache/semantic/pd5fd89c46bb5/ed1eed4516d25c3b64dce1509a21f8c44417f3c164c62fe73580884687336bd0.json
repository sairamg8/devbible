{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_canonical_skeleton", "label": "Canonical Express middleware skeleton", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "disable x-powered-by, json parser, routes, 404, then four-arg error middleware. Keep one composition root."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_parsers_early_errors_last", "label": "Parsers early, errors last", "file_type": "rationale", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handlers read req.body so parsers must run first. Error middleware is skipped in the normal chain and must be last."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_four_arg_error_middleware", "label": "Four-argument error middleware", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/first-and-last.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Error middleware must be (err, req, res, next) so Express can detect it. A three-arg 404 is not an error handler."}], "edges": [{"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_parsers_early_errors_last", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_canonical_skeleton", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/first-and-last.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_l