{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_execution_context", "label": "Execution context and the call stack", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One thread, one stack. A frame holds arguments, locals, the defining scope, this, and the return address."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_stack_limit_is_bytes", "label": "Stack limit is bytes, not calls", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 12524 frames with no locals versus 5442 with six args plus an array local. Never treat about 10000 calls as a budget."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_no_tco_in_v8", "label": "V8 does not implement tail-call optimisation", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCO is in ES2015; only JavaScriptCore ships it. Writing recursion in tail position buys nothing in Chrome or Node."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_await_tears_down_stack", "label": "await does not consume stack", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200000-deep async recursion succeeded. Every await returns to the event loop; the continuation is a microtask on a fresh stack."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_stacktracelimit", "label": "Error.stackTraceLimit default 10", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8 truncates at ten frames by default. Raise to 50 or Infinity while debugging; capturing stacks is not free."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_await_tears_down_stack", "target": "build_css_p2_docs_javascript_pages_phase_7_async_event_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_await_tears_down_stack", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_execution_context", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_closures", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/call-stack.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_call_stack_no_tco_in_v8", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_javascri