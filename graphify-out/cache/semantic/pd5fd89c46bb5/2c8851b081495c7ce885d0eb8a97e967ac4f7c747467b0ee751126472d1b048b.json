{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_reduce", "label": "Array.prototype.reduce", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-argument callback, no thisArg. Holes skipped; stored undefined is not. Wins for scalar folds, pipe, promise sequencing. MDN has a when-not-to-use section."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_initial_value", "label": "reduce initialValue", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omitted: accumulator is element 0, iteration starts at 1, TypeError on an empty array. Always pass an initial value."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_quadratic_spread", "label": "reduce spread-accumulator anti-pattern", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreading the accumulator each step is O(N\u00b2). The accumulator is private \u2014 mutating it is not an immutability violation. Prefer flat, Object.groupBy, Set, filter."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_object_groupby", "label": "Object.groupBy and Map.groupBy", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named replacement for the grouping fold. Map.groupBy usually beats Object.groupBy because object key order re-sorts integer-like keys."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_reduce", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_initial_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_quadratic_spread", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_reduce", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_object_groupby", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_quadratic_spread", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_reduce", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_undefined_holes_and_brand_checks_array_holes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/reduce.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_object_groupby", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-cs