{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_spread_replaces_apply", "label": "Spread replaces apply", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "f(...args) does what f.apply(null, args) did, composes with fixed args and new. apply remains only for setting this."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_spread_argument_limit", "label": "Spread argument-count limit", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreading a large array into a call can RangeError. Use reduce for max, loop or concat for append."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_object_spread_merge", "label": "Later-wins object merge", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "{ ...defaults, ...overrides } is replace, not deep merge. A later spread after an explicit key overrides it."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_immutable_spread_updates", "label": "Immutable spread updates", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copies only the changed level and shares untouched branches \u2014 what makes prev.items === next.items a valid change check."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_quadratic_spread_loop", "label": "Quadratic spread-in-loop", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "out = [...out, x] copies the accumulated array each iteration. Use map or push."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_array_from_vs_spread", "label": "Array.from vs spread", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/spread-with-iterables/where-it-earns-its-place.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array.from accepts array-likes without iterators, maps while converting, and builds n slots. Spread is shorter when an iterator exists."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_where_it_earns_its_place_spread_replaces_apply", "target": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_spread_with_iterables_two_operations_one_syntax_array_call_spread", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructurin