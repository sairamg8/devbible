{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_07_local_install_container_first", "label": "Container-first local Postgres", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin major version, reset in one command, match CI. Prefer that over fighting a distro package until you have a reason to go native."}, {"id": "docs_postgresql_pages_phase_0_architecture_07_local_install_postgres_18_alpine", "label": "postgres:18-alpine sandbox", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "podman run docker.io/library/postgres:18-alpine with POSTGRES_USER/DB/PASSWORD=devbible. Verified PostgreSQL 18.4 on x86_64-pc-linux-musl."}, {"id": "docs_postgresql_pages_phase_0_architecture_07_local_install_port_55432", "label": "Published host port 55432", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-default host port so nothing collides with a system Postgres on 5432. Inside the container the listen port remains 5432."}, {"id": "docs_postgresql_pages_phase_0_architecture_07_local_install_127_0_0_1", "label": "Use 127.0.0.1 not localhost", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node's DNS order prefers ::1; IPv4 port publishes fail with confusing errors if you use localhost."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_07_local_install_container_first", "target": "docs_postgresql_pages_phase_0_architecture_07_local_install_postgres_18_alpine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_07_local_install_postgres_18_alpine", "target": "docs_postgresql_pages_phase_0_architecture_07_local_install_port_55432", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_07_local_install_127_0_0_1", "target": "docs_postgresql_pages_phase_0_architecture_07_local_install_port_55432", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_07_local_install_postgres_18_alpine", "target": "docs_postgresql_pages_phase_0_architecture_readme_target_pg_18_4", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-0-architecture/07-local-install.md", "source_location": null, "weight": 1.0}], "hyperedges": []}