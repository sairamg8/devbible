{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_timestamps_trigger", "label": "created_at and updated_at \u2014 trigger or application code", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_created_at_default", "label": "created_at DEFAULT now()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DEFAULT covers every insert path including COPY. No trigger needed. Use timestamptz, not timestamp."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_before_update_trigger", "label": "BEFORE UPDATE updated_at trigger", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App-managed updated_at stayed stale on an UPDATE that never mentioned it. Trigger moved it. Cost 1.23\u20131.29\u00d7 on the update (328.9 vs 266.8 ms). BEFORE can assign NEW; AFTER would need a second UPDATE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_now_transaction_timestamp", "label": "now() is the transaction timestamp", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every row in one transaction shares updated_at. clock_timestamp() moved 303 ms. That is why updated_at cannot be an optimistic-concurrency version."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_before_update_trigger", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_update_partial_is_distinct_from", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_now_transaction_timestamp", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_timestamps_trigger_before_update_trigger", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/timestamps-trigger.html", "source_location": null, "weight": 1.0}], "hyperedges": []}