{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeout_budgets", "label": "Timeout budgets", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_fetch_no_default_timeout", "label": "fetch has no default timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node fetch waits as long as the socket stays open. AbortSignal.timeout(300) aborted after 306 ms with TimeoutError."}, {"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_budget", "label": "Timeout budget", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One deadline for the operation; each step gets the remainder. After a 200 ms step of a 500 ms budget the next call got 300 ms and aborted at 301 ms."}, {"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeouts_shrink_down_stack", "label": "Timeouts must shrink down the stack", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the caller allows 2 s and the callee has 3 s, the client gives up first and the callee's work is wasted while still holding resources. Retries live inside the budget."}, {"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_statement_timeout", "label": "statement_timeout vs query_timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "statement_timeout is enforced by PostgreSQL and cancels the query. query_timeout is client-side: the client stops waiting while the server keeps running."}, {"id": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeout_unknown_state", "label": "A timeout is an unknown state", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The remote side may have completed after you stopped waiting. Retrying a timed-out write requires idempotency. Timeouts are not a circuit breaker."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeout_budgets", "target": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_fetch_no_default_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeout_budgets", "target": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_timeouts_shrink_down_stack", "target": "docs_nodejs_pages_phase_7_background_work_12_timeout_budgets_budget", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/12-timeout-budgets.md", "source_locatio