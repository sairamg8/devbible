{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform_and_boundaries_callback_contract", "label": "Transform callback contract", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/transform-streams/transform-and-boundaries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call callback exactly once. Never calling hangs the pipeline; twice throws ERR_MULTIPLE_CALLBACK. callback(null,v) emits one chunk."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform_and_boundaries_chunk_boundary_problem", "label": "Chunk boundary problem", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/transform-streams/transform-and-boundaries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-chunk regex misses a token that straddles the 64 KB mark. Verified: tok_live_ split across chunks was not redacted."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform_and_boundaries_splitlines_framing", "label": "SplitLines framing", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/transform-streams/transform-and-boundaries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold everything after the last newline as a tail, push complete lines, emit remainder in _flush. Frame first, then operate on records."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform_and_boundaries_flush_emits_tail", "label": "_flush emits the last record", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/transform-streams/transform-and-boundaries.html", "s