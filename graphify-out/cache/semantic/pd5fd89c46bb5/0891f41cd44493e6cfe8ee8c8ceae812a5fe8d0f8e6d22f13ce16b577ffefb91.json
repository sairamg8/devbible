{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_three_trees", "label": "The three trees", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HEAD, index, working tree. Every core command is a move between two of them."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_head", "label": "HEAD snapshot", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The snapshot of the last commit on the current branch, reached via .git/HEAD."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_working_tree", "label": "Working tree", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actual files on disk, editable by anything, tracked or not."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_status_am", "label": "AM status code", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Left column is index versus HEAD; right is working tree versus index. AM means staged and then edited; commit records the older content."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_reset_flags", "label": "reset --soft --mixed --hard", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All move HEAD. --mixed also resets the index. --hard also overwrites the working tree and is the only variant that can lose uncommitted work."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_three_trees", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_head", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_three_trees", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_index_file", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_three_trees", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_working_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_three_trees_status_am", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_the_index_staging_is_a_copy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/three-trees.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_ph