{"nodes": [{"id": "docs_react_pages_phase_4_effects_12_uselayouteffect_uselayouteffect", "label": "useLayoutEffect", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same hook as useEffect except it fires before the browser repaints. That difference is the reason to use it and the reason not to."}, {"id": "docs_react_pages_phase_4_effects_12_uselayouteffect_blocks_paint", "label": "useLayoutEffect blocks paint", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The guarantee is the blocking. Code and state updates scheduled inside sit on the critical path. Prefer useEffect when possible."}, {"id": "docs_react_pages_phase_4_effects_12_uselayouteffect_measure_then_place", "label": "Measure then place before paint", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tooltip renders, measures height, re-renders in the right place. Two renders either way; useLayoutEffect only decides whether the user sees the first."}, {"id": "docs_react_pages_phase_4_effects_12_uselayouteffect_state_pulls_remaining_effects", "label": "Layout state update executes remaining Effects immediately", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A setState here drags every pending useEffect into the blocking window, including expensive work elsewhere in the tree."}, {"id": "docs_react_pages_phase_4_effects_12_uselayouteffect_ssr_noop", "label": "useLayoutEffect does nothing on the server", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No layout information and no paint. Options: useEffect, client-only Suspense, isMounted after hydration, or useSyncExternalStore."}], "edges": [{"source": "docs_react_pages_phase_4_effects_12_uselayouteffect_uselayouteffect", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effect_paint_timing_not_guaranteed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_12_uselayouteffect_blocks_paint", "target": "docs_react_pages_phase_4_effects_12_uselayouteffect_measure_then_place", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_12_uselayouteffect_state_pulls_remaining_effects", "target": "docs_react_pages_phase_4_effects_13_effect_ordering_three_passes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_12_uselayouteffect_ssr_noop", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_client_only", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-4-effects/12-uselayouteffect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_12_uselayouteffect_ssr_noop", "target": "docs_react_pages_