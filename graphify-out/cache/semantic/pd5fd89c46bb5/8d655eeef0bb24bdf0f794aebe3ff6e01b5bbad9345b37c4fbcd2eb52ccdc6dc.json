{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "label": "Buffer basics", "file_type": "document", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_buffer", "label": "Buffer", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed-length raw bytes outside the V8 heap. Strings are UTF-16; network and disk are bytes. Every Node I/O boundary hands you one."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_buffer_from_alloc", "label": "Buffer.from and Buffer.alloc", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "from encodes text or copies exact bytes; alloc zeros safely. new Buffer is deprecated DEP0005 and unsafe."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_length_is_bytes", "label": "Buffer.length is bytes", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "h\u00e9llo is 5 characters and 6 UTF-8 bytes. Content-Length and size limits must use Buffer.byteLength, not str.length."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_json_stringify_buffer", "label": "JSON.stringify of a Buffer", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produces {type:Buffer,data:[...]}. Convert with toString(base64) or toString() before res.json."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_subarray_shares_memory", "label": "Buffer.subarray shares memory", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A view, not a copy. Buffer.prototype.slice is an alias and unlike Array/Uint8Array.slice does not copy. Return a copy for anything you store."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_concat", "label": "Buffer.concat", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass totalLength when known to skip a summing pass. Collect HTTP body as buffers then concat once \u2014 never string-concatenate chunks."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_timing_safe_equal", "label": "crypto.timingSafeEqual vs Buffer.equals", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "equals short-circuits on the first differing byte \u2014 a timing oracle for tokens and HMACs."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_collect_body", "label": "Collect HTTP body with a size limit", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sum chunk.length, destroy and 413 past the limit, then Buffer.concat(chunks, size). Counting characters lets multi-byte payloads through."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "target": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_buffer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "target": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_buffer_from_alloc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_length_is_bytes", "target": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_buffer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "target": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_json_stringify_buffer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "target": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_subarray_shares_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/01-buffer-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_01_buffer_basics_page", "target": "docs_