{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pg_cursor", "label": "pg-cursor streaming", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches in batches so memory stops depending on row count. Needs a checked-out client, read(n) until empty, close then release."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pool_query_buffering", "label": "pool.query buffers the whole result", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heap grew +101 MB for 300000 rows, linear in result size. First row waits for the last."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_server_side_cursor", "label": "DECLARE cursor dies on COMMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FETCH after COMMIT is 34000. WITH HOLD materialises the whole result at commit. pg-cursor uses a protocol portal with the same binding."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_xmin_horizon", "label": "Long cursor snapshot pins xmin", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A twenty-minute export is twenty minutes of no VACUUM database-wide. Hidden cost of streaming."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_keyset_batching", "label": "Keyset batching instead of a cursor", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each LIMIT chunk is its own short transaction on a pooled connection. Interruptible, no long snapshot. Sees rows committed during the run."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pg_cursor", "target": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pool_query_buffering", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pg_cursor", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_server_side_cursor", "target": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_pg_cursor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_xmin_horizon", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_in_transaction_session_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/15-cursors.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_keyset_batching", "target": "docs_postgresql_pages_phase_7_pg_driver_15_cursors_xmin_horizon", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":