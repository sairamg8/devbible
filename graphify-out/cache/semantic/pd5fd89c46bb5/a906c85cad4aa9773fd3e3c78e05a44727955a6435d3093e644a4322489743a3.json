{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "label": "Microtasks, macrotasks and nextTick", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_nexttick_queue", "label": "process.nextTick queue", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drains completely at a checkpoint, including entries added while draining, before the microtask queue. That complete drain is what makes recursive nextTick starvation possible."}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_microtask_queue", "label": "Microtask queue", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise.then, await resumptions and queueMicrotask. Drains after nextTick at a checkpoint, but once inside a microtask the microtask queue keeps draining first."}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_macrotasks", "label": "Macrotasks", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timers, setImmediate and I/O callbacks belong to event-loop phases and get one turn per lap. Microtasks and nextTick are not phases; they drain between every phase and every callback."}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_esm_toplevel_microtask", "label": "ESM top-level is a microtask", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module evaluation is a promise job, so nextTick scheduled at ESM top level runs after pending microtasks. Identical code as .cjs and .js prints different order."}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_queuemicrotask_vs_nexttick", "label": "queueMicrotask vs process.nextTick", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer queueMicrotask: portable, same queue as promises, less starvation. nextTick only when you must run before pending promise continuations, classically deferring an emit so a caller can subscribe."}, {"id": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_await_yields_microtask", "label": "await yields to the microtask queue", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await does not give the event loop a turn. An await-heavy loop over in-memory values never runs timers or I/O; CPU-bound work needs setImmediate, a real phase."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_nexttick_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_microtask_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_macrotasks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_esm_toplevel_microtask", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_nexttick_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_esm_toplevel_microtask", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_microtask_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_await_yields_microtask", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_microtask_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_queuemicrotask_vs_nexttick", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_nexttick_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_22_cpu_bound_work_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase2_event_loop_checkpoint_ordering", "label": "Event-loop checkpoint drain order", "nodes": ["docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_nexttick_queue", "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_microtask_queue", "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_macrotasks", "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_setimmediate", "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_settimeout_zero_clamp"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/03-microtasks-and-macrotasks.md"}]}