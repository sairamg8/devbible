{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers", "label": "Triggers \u2014 BEFORE/AFTER, row versus statement", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_before_after", "label": "BEFORE vs AFTER triggers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEFORE can modify NEW and cancel with RETURN NULL. AFTER assignment to NEW is silently discarded \u2014 the row is already written."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_row_vs_statement", "label": "FOR EACH ROW vs FOR EACH STATEMENT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One UPDATE of 1000 rows: 1000 row firings, 1 statement firing. A statement trigger still fires when zero rows match."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_transition_tables", "label": "Trigger transition tables", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REFERENCING OLD TABLE / NEW TABLE lets a statement trigger audit bulk changes in one insert instead of 1000 row inserts."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_when_clause", "label": "Trigger WHEN clause", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated before the plpgsql call. Measured 0.86\u00d7 of an unconditional row trigger. Cannot be used on INSTEAD OF."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_return_null", "label": "BEFORE RETURN NULL cancels the row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10 submitted, 5 stored; rowCount reported 5. Prefer RAISE EXCEPTION so the caller sees a rejection."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_alphabetical_firing", "label": "Trigger firing order is alphabetical", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created zebra, alpha, middle; fired alpha, middle, zebra. Name with numeric prefixes if order matters."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_data_not_behaviour", "label": "Triggers maintain data not behaviour", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invisible from the application: right for updated_at and audit, wrong for business rules or external side effects inside the transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_before_after", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/08-triggers.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresq