{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_page", "label": "04 \u00b7 Automatic batching", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_automatic_batching", "label": "Automatic batching", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React waits until all code in the event has run before processing state updates, preventing half-finished renders. React 18 made batching apply everywhere, not only in React event handlers."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_flushsync", "label": "flushSync", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only per-callback opt-out of batching. Uncommon last resort: may force Suspense fallbacks, run pending Effects, and flush unrelated pending work."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_await_batch_boundary", "label": "await is a batch boundary", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updates before and after an await live in different tasks, so they batch separately. Automatic batching is not one render per function."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_half_finished_renders", "label": "Half-finished renders", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without batching, each update can paint a frame where one related value has changed and another has not. Batching is a correctness feature, not only a performance one."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_queueing_series_citation", "label": "Queueing a Series of State Updates (react.dev)", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_page", "target": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_automatic_batching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_page", "target": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_flushsync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_page", "target": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_queueing_series_citation", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/automatic-batching.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_automatic_batching_flushsy