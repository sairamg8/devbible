{"nodes": [{"id": "docs_javascript_pages_phase_0_how_javascript_runs_10_feature_detection_feature_detection", "label": "Feature detection", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/10-feature-detection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test the capability, never the browser or environment. Use typeof so an undeclared name does not throw."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_10_feature_detection_navigator_in_node", "label": "navigator exists in Node 21+", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/10-feature-detection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof navigator !== 'undefined' is true on Node 21+, so SSR hydrates as if it were a browser. Probe document or the specific API."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_10_feature_detection_localstorage_write_probe", "label": "localStorage write probe", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/10-feature-detection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safari private mode defines localStorage then throws QuotaExceededError on every write. Existence is not usability."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_10_feature_detection_progressive_enhancement", "label": "Progressive enhancement", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/10-feature-detection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship a version that works everywhere, then add capability-gated improvements. A Load more button beats a dead page."}, {"id": "docs_javascri