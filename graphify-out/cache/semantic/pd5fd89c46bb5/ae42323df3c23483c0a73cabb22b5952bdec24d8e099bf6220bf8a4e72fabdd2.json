{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_one_statement_many_writes", "label": "One statement, several writes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE may contain INSERT, UPDATE, DELETE or MERGE. With RETURNING feeding the next step, a move-then-record is one atomic statement and one round trip."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_archive_pattern", "label": "Archive pattern", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WITH moved AS (DELETE \u2026 RETURNING *) INSERT INTO archive SELECT * FROM moved. No moment the row exists in neither table or both. Also upsert-plus-audit via xmax = 0."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_unreferenced_write_cte", "label": "Unreferenced write CTE still runs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A SELECT CTE nobody references can be discarded; a write is a promised side effect and executes exactly once. Delete the CTE, not just the reference."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_always_fenced", "label": "Data-modifying CTE always fenced", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the five inlining exclusions. NOT MATERIALIZED cannot override it, because inlining would execute the write once per reference."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_one_statement_many_writes", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_archive_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_archive_pattern", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_unreferenced_write_cte", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_always_fenced", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_always_fenced", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_materialized_hint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/01-one-statement-many-writes.md", "source_location": null, "weight": 1.0}], "hyperedges": []}