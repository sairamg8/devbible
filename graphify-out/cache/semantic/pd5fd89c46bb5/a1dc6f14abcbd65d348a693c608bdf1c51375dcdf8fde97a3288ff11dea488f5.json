{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_triggers", "label": "PostgreSQL triggers", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trigger runs code the application cannot see, skip, or ask for. Right for data invariants; wrong for business behaviour and external side effects."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_before_trigger", "label": "BEFORE trigger", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can modify NEW and cancel the row with RETURN NULL. Use to change the row (updated_at, normalisation)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_after_trigger", "label": "AFTER trigger", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return value is ignored; the row is already written. Use to react: audit, notify, cascade."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_row_vs_statement", "label": "Row vs statement trigger", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One UPDATE of 1000 rows: 1000 row firings, 1 statement firing. Statement triggers also fire on zero-row statements."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_transition_tables", "label": "Transition tables", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REFERENCING OLD TABLE / NEW TABLE lets a statement trigger audit bulk changes in one insert."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_when_clause", "label": "Trigger WHEN clause", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated before the plpgsql call. Measured 0.86\u00d7 of an unconditional row trigger. Cannot be used on INSTEAD OF."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_return_null_cancel", "label": "RETURN NULL cancels the row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silent drop: 10 submitted, 5 stored, rowCount reported 5. Prefer RAISE EXCEPTION when the caller should know."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_alphabetical_firing_order", "label": "Alphabetical trigger firing order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/triggers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires by trigger name, not creation order. Prefix 01_/02_/03_ if order matters."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_triggers", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_triggers_before_trigger", "relation": "references", "confidence": "EXTR