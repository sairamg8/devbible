{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_test_doubles", "label": "Test doubles \u2014 stub, spy, mock, fake", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/test-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_test_doubles_stub", "label": "Stub", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/test-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns canned values; assert on the result of the code under test. The double you should reach for most often."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_test_doubles_spy", "label": "Spy", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/test-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_test_doubles_mock", "label": "Mock (interaction double)", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/test-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assert on the call only when the call is the behaviour \u2014 payments, emails, webhooks. Not loggers or metrics."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_test_doubles_fake", "label": "Fake", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/test-doubles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second implementation that can drift. Keep it small and back it with one integration test against the real thing."}, {"id": "build_css_p2_docs_nodejs