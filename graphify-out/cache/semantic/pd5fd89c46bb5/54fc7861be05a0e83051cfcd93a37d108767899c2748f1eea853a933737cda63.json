{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql", "label": "PL/pgSQL functions", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_sql_inlining", "label": "LANGUAGE sql inlining vs plpgsql black box", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sql inlines and sees real statistics (60 rows). plpgsql is a Function Scan with a fixed 1000-row guess that wrecks joins."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_volatility", "label": "Function volatility IMMUTABLE STABLE VOLATILE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VOLATILE is the default and blocks inlining even for LANGUAGE sql. Lying about IMMUTABLE gives wrong answers, not errors. Index expressions need IMMUTABLE (42P17)."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_trigger_functions", "label": "Trigger functions must be plpgsql", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NEW, OLD, RETURN NEW/NULL, TG_OP/TG_NAME/TG_LEVEL are the vocabulary. The honest list for plpgsql is trigger bodies plus rare data-heavy loops."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_raise_exception", "label": "RAISE EXCEPTION USING ERRCODE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without an explicit SQLSTATE everything is P0001. Use 23xxx integrity codes so the app maps them like constraint violations."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql", "target": "docs_postgresql_pages_phase_12_beyond_tables_10_srf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_sql_inlining", "target": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_volatility", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_trigger_functions", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_before_after", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/12-plpgsql.md", "source_location": null, "weight": 1.0}], "hyperedges": []}