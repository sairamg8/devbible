{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_language_server_vs_build_language_server_vs_build", "label": "Language server is not the build", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/language-server-vs-build.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editor is a long-lived server on open files, often the bundled compiler, including unsaved buffers. CI is tsc --noEmit, cold, the include set, the repo version."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_language_server_vs_build_version_disagreement", "label": "Editor vs CI compiler version drift", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/language-server-vs-build.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same loose.ts: 7.0.2 four errors, 5.9.3 exit 0, because the strict default changed. Fix: Use Workspace Version and typescript.tsdk."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_language_server_vs_build_file_set_disagreement", "label": "Editor vs CI file-set disagreement", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/language-server-vs-build.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file nobody imports and include misses is checked when opened and never in CI. Ambient @types also depend on cwd."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_language_server_vs_build_stale_server", "label": "Stale TS Server state", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/language-server-vs-build.html", "source_location": null, "source_