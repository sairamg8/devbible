{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_02_syntax_and_when_not_to_object_literal_trap", "label": "Arrow object-literal trap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/02-syntax-and-when-not-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "n => { value: n } is a labelled statement returning undefined. One property parses; two properties are SyntaxError. Parenthesise: ({value: n})."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_02_syntax_and_when_not_to_concise_body", "label": "Concise arrow body", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/02-syntax-and-when-not-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expression position only. if and return are SyntaxError. Ternary and ?? remain legal."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_02_syntax_and_when_not_to_no_generator_arrow", "label": "No generator arrow", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/02-syntax-and-when-not-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "async () => is supported. *() => {} is SyntaxError. Generators must be function*."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_02_syntax_and_when_not_to_prototype_vs_field_arrow", "label": "Prototype method vs class-field arrow", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/02-syntax-and-when-not-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P