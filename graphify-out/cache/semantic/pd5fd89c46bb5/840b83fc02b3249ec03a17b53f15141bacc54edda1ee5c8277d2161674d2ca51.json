{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit", "label": "BEGIN, COMMIT, ROLLBACK from Node", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_autocommit", "label": "PostgreSQL autocommit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_pool_query_begin", "label": "pool.query BEGIN bug", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idle pool luck: all three statements share one connection. Under load BEGIN, UPDATE and ROLLBACK hit backends 1055/1056/1056 \u2014 the update autocommits and a stray open transaction remains."}, {"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_withtransaction", "label": "withTransaction helper", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One client from pool.connect(); ROLLBACK.catch to avoid masking; release() in finally. Isolation goes on BEGIN, not SET after the first query (25001)."}, {"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_nested_begin", "label": "Nested BEGIN is a warning", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_connection_seconds", "label": "Transaction cost is connection-seconds", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transaction holds a connection for its entire duration. Do not open it across HTTP calls; that exhausts the pool and stalls VACUUM."}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit", "target": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_autocommit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_pool_query_begin", "target": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_autocommit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_withtransaction", "target": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_pool_query_begin", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_nested_begin", "target": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_no_nested_tx", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/02-begin-commit.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_02_begin_commit_connection_seconds", "target": "docs_postgresql_pages_phase_11_mvcc