{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "label": "string_agg, array_agg, jsonb_agg", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These aggregates fold a group into a collection, enabling a one-query nested API payload. Every one returns NULL where empty was expected, and [null] where [] was expected."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_string_agg", "label": "string_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns text and skips NULL inputs. Opposite of array_agg and jsonb_agg on NULLs."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_array_agg", "label": "array_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns an array of the input type and keeps NULLs as elements."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_jsonb_agg", "label": "json_agg / jsonb_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a JSON array and keeps NULL inputs as null. jsonb_agg(child.*) also leaks every child column."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_jsonb_object_agg", "label": "jsonb_object_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a jsonb object. Key must not be NULL (error 22023)."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_string_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_array_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_jsonb_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_jsonb_object_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_readme_collection_aggregates", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_03_the_empty_array_trap_empty_array_trap", "relation": "references", "confidence": "EXTRACT