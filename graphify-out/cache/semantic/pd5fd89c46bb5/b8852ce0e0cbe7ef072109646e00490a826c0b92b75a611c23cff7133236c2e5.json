{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_15_expressions_expressions", "label": "Expressions and CASE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_15_expressions_coalesce", "label": "COALESCE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First non-null argument; short-circuits. NULLIF(a, b) returns NULL when equal, used as x / NULLIF(y, 0) to avoid 22012."}, {"id": "docs_postgresql_pages_phase_4_crud_15_expressions_greatest_least_skip_nulls", "label": "GREATEST and LEAST skip nulls", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GREATEST(NULL, 2) returned 2. Opposite of almost every other operator. Row-wise, not aggregates."}, {"id": "docs_postgresql_pages_phase_4_crud_15_expressions_case", "label": "CASE expression", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First match wins; implicit ELSE NULL. Short form uses = so WHEN NULL never matches. Put IS NULL first in the long form."}, {"id": "docs_postgresql_pages_phase_4_crud_15_expressions_concat_vs_pipe", "label": "|| versus concat versus concat_ws", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'x' || NULL is NULL; concat('x', NULL) is x. concat_ws skips null values including their separator; a null separator voids the call."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_15_expressions_expressions", "target": "docs_postgresql_pages_phase_4_crud_01_select_shape_select_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_15_expressions_expressions", "target": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_15_expressions_concat_vs_pipe", "target": "docs_postgresql_pages_phase_4_crud_15_expressions_coalesce", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_15_expressions_greatest_least_skip_nulls", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_three_valued_logic", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-4-crud/15-expressions.md", "source_location": null, "weight": 1.0}], "hyperedges": []}