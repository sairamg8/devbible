{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_04_output_control_x_expanded", "label": "\\x expanded output", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One column per line. \\x auto switches only when the row does not fit \u2014 the setting to keep in .psqlrc."}, {"id": "docs_postgresql_pages_phase_1_psql_04_output_control_at_unaligned", "label": "-At unaligned tuples-only", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No header, no padding, no row-count footer. Pipe-friendly pair for a single value into a shell variable."}, {"id": "docs_postgresql_pages_phase_1_psql_04_output_control_csv", "label": "--csv", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proper CSV including quoting. Prefer over -A -F ',' which does not quote commas or quotes."}, {"id": "docs_postgresql_pages_phase_1_psql_04_output_control_pset_null", "label": "\\pset null", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "By default NULL and empty string render identically as blank. Highest-value single .psqlrc line: \\pset null '(null)'."}, {"id": "docs_postgresql_pages_phase_1_psql_04_output_control_redirect", "label": "\\o and \\g redirect", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\\o file is a persistent output mode; \\g file is one-shot; \\g | cmd pipes. Both write rendered output."}], "edges": [{"source": "docs_postgresql_pages_phase_1_psql_04_output_control_x_expanded", "target": "docs_postgresql_pages_phase_1_psql_07_query_buffer_g_variants", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_04_output_control_at_unaligned", "target": "docs_postgresql_pages_phase_1_psql_04_output_control_csv", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_04_output_control_pset_null", "target": "docs_postgresql_pages_phase_1_psql_04_output_control_x_expanded", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_04_output_control_redirect", "target": "docs_postgresql_pages_phase_1_psql_07_query_buffer_g_variants", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_04_output_control_at_unaligned", "target": "docs_postgresql_pages_phase_1_psql_06_scripting_no_psqlrc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/04-output-control.md", "source_location": null, "weight": 1.0}], "hyperedges": []}