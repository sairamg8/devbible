{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "label": "async and await", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syntax over promises: async makes a function return a promise and permits await. Adds no new capability."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_top_level_await", "label": "Top-level await", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES modules can await outside a function; importers wait. Makes the module impossible to require() from CommonJS."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_await_in_foreach", "label": "await inside forEach", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array.forEach ignores the returned promise so async work floats. Use for...of or Promise.all(map)."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_yields_microtasks", "label": "await yields to microtasks not the event loop", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Body runs synchronously to the first await; resumption is a microtask. A loop of already-resolved awaits never lets timers or I/O run."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_yields_microtasks", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_top_level_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_await_in_foreach", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_await_in_foreach", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_floating_promise", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-await.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_yields_microtasks", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s