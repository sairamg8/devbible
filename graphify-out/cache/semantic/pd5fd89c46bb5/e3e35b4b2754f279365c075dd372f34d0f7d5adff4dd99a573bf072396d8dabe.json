{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_page", "label": "Rate limiting and brute-force protection", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes volume away so timing, stuffing and ReDoS stop being practical. Algorithm, key and store are the three decisions."}, {"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_rate_limiting", "label": "Rate limiting", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory Map is per-process (4 workers \u2192 4\u00d7 limit) and unbounded (200k keys / 31.2 MB). Redis INCR+TTL is the shared store."}, {"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_window_algorithms", "label": "Fixed window, sliding window, token bucket", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed window allowed 10 in 80 ms against 5/s. Sliding has no boundary. Token bucket separates burst and refill. Sliding for login; token bucket for APIs."}, {"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_redis_incr_expire_race", "label": "Redis INCR then EXPIRE race", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Death between INCR and EXPIRE leaves ttl -1 and a permanent lock. One Lua script: INCR, PEXPIRE only when n==1."}, {"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_fail_open_closed", "label": "Limiter fail-open vs fail-closed", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open keeps a read API up unprotected; closed keeps login protected while unavailable. Silent fail-open is never acceptable \u2014 alert on limiter errors."}, {"id": "docs_nodejs_pages_phase_8_security_21_rate_limiting_brute_force_lockout", "label": "Account lockout as DoS", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard lock after N failures lets anyone lock any known email. Use exponential per-account delay plus per-IP limit; sit the limiter in front of scrypt."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_21_rate_limiting_page", "target": "docs_nodejs_pages_phase_8_security_21_rate_limiting_rate_limiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_21_rate_limiting_page", "target": "docs_nodejs_pages_phase_8_security_21_rate_limiting_window_algorithms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_21_rate_limiting_page", "target": "docs_nodejs_pages_phase_8_security_21_rate_limiting_redis_incr_expire_race", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/21-rate-limiting.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_21_rate_limiting_page", "target": "doc