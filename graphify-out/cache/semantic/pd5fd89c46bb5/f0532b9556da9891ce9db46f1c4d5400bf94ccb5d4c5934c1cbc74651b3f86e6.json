{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_defaults_and_auditing", "label": "Defaults and auditing", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_on_all_tables_snapshot", "label": "GRANT ON ALL TABLES is a snapshot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It expands to the tables that exist at execution and stores one ACL each. A table created afterwards is 42501. You also need ALTER DEFAULT PRIVILEGES for future objects."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_alter_default_privileges", "label": "ALTER DEFAULT PRIVILEGES", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores a rule applied when new objects are created; not retroactive. Keyed on the creating role (defaclrole). Omit FOR ROLE and a DBA records a rule for postgres, not the migration role."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_acl_string", "label": "relacl privilege string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "grantee=privileges/grantor. rwadDxtm map to SELECT UPDATE INSERT DELETE TRUNCATE REFERENCES TRIGGER MAINTAIN. relacl NULL is the built-in default, not locked down. Empty grantee is PUBLIC."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_public_schema_pg15", "label": "public schema CREATE removed in PG15", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PUBLIC now has USAGE only on public. Apps that created tables in public as a non-owner fail after upgrade with 42501. pg_database_owner resolves to whoever owns the current database."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_has_privilege_audit", "label": "has_*_privilege boot assertion", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These functions resolve group membership and inheritance, which reading relacl does not. Assert the app can SELECT and cannot TRUNCATE, CREATE or be superuser, at boot."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_on_all_tables_snapshot", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_alter_default_privileges", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/04-defaults-and-auditing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_has_privilege_audit", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_acl_string", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgre