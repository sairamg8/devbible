{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_native_compiler", "label": "TypeScript 7 native compiler", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiler rewritten as a native binary in platform optional deps (@typescript/typescript-linux-x64 etc). tsc is a thin Node wrapper. Language unchanged."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_measured_3x", "label": "TypeScript 7 measured 3\u00d7 speedup", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "300 files, 1500 lines, --noEmit --strict: 7.0.2 0.76s vs 5.9.3 2.32s. First run claimed 10\u00d7 because 5.9.3 also loaded ancestor @types."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_api_moved", "label": "Compiler API moved to typescript/unstable", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require('typescript') exports only version and versionMajorMinor. createProgram is undefined. Live surface: typescript/unstable/sync, /async, /ast (409 exports)."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_ambient_cwd_confound", "label": "Ambient @types follows cwd not sources", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5.9.3 resolves @types relative to cwd. Moving fixture to /tmp did not help while cwd stayed in the repo. Assert equal diagnostic counts before comparing timings."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_typescript_6_bridge", "label": "TypeScript 6.0 deprecation bridge", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript-implemented 6.0 carries deprecations so a large project can fix issues on the familiar compiler before the native 7 jump. Tooling is the risky part."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_changed_defaults", "label": "TypeScript 7 changed option defaults", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "strict, esModuleInterop true; moduleResolution bundler or node16/nodenext following module. Unset projects behave differently on 7."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_measured_3x", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_typescript_7_native_compiler_native_compiler", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/typescript-7-native-compiler.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs