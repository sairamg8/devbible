{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_todomain", "label": "toDomain row mapper", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps a pg row to the API contract: String(id), snake_case to camelCase, Date to ISO, and only named fields. Lives in the repository next to the SELECT list."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_bigint_as_string", "label": "bigint arrives as a String", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg will not silently lose precision past Number.MAX_SAFE_INTEGER. Treat ids as opaque strings; Number() is only safe under 2^53."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_missing_row_not_error", "label": "Missing SELECT row is not an error", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A matching-nothing SELECT succeeds with rowCount 0 and rows []. rows[0] is undefined; normalise to null so JSON.stringify keeps the key."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_rowcount_vs_rows_length", "label": "rowCount versus rows.length", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rowCount is rows affected; rows is what came back. They match for SELECT and diverge on writes without RETURNING. rowCount is null, not 0, for DDL/BEGIN/SET."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_mapper_allowlist", "label": "Mapper is an allowlist by construction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A column added later does not appear in responses until named here. SELECT * plus no mapper leaks password_hash the day it is added."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_mapper_next_to_query", "label": "Keep mapper adjacent to the SELECT", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mapper can only produce what the query selected. Splitting them yields undefined fields instead of errors and makes SELECT * tempting. Alias for shape, mapper for contract."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_todomain", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_bigint_as_string", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_todomain", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_mapper_allowlist", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/02-rows-to-domain.md", "source_location": null, "weight"