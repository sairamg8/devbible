{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_08_exports_map_exports_map", "label": "exports map", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/08-exports-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines the package public surface and makes everything else unreachable. Turns an open directory into a declared interface."}, {"id": "docs_nodejs_pages_phase_1_modules_08_exports_map_subpath_exports", "label": "Subpath exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/08-exports-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Left side is the public name, right side is the file. Once exports exists the only valid specifiers are listed keys, including the real path."}, {"id": "docs_nodejs_pages_phase_1_modules_08_exports_map_err_package_path_not_exported", "label": "ERR_PACKAGE_PATH_NOT_EXPORTED", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/08-exports-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thrown for any path not listed. Adding an exports map is a major version if consumers were deep-importing."}, {"id": "docs_nodejs_pages_phase_1_modules_08_exports_map_conditional_exports", "label": "Conditional exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/08-exports-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node picks the first matching condition in written order. types must be first; default must be last."}, {"id": "docs_nodejs_pages_phase_1_modules_08_exports_map_dual_package_hazard", "label": "Dual package hazard", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/08-exports-map.md", "source_locat