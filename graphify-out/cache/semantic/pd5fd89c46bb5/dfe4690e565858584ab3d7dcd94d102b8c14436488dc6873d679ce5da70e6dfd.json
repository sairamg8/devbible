{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_04_testable_code_page", "label": "Writing testable code", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/04-testable-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard-to-test is usually a hidden grab. Pass the dependency in. Verified ESM import-time process.env bake-in."}, {"id": "docs_nodejs_pages_phase_9_testing_04_testable_code_dependency_injection", "label": "Dependency injection via parameters", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/04-testable-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Factory closing over deps, or db as first argument so a pool or a transactional client can be handed in. Defaults keep tests from constructing the world."}, {"id": "docs_nodejs_pages_phase_9_testing_04_testable_code_hidden_dependency", "label": "Hidden dependency", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/04-testable-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Date, Math.random, process.env at import, module-scope Pool, fixed-URL fetch, top-level logger. ESM evaluates config before any test body."}, {"id": "docs_nodejs_pages_phase_9_testing_04_testable_code_no_di_container", "label": "No DI container in Node", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/04-testable-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function taking an object already is DI. Wire by hand in main.mjs. A container is a signal about design, not a missing framework."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_04_testable_code_page", "target": "docs_nodejs_pages_phase_9_testing_04_tes