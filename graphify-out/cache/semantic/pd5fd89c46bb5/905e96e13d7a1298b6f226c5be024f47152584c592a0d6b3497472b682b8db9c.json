{"nodes": [{"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise", "label": "Promise", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An object representing eventual completion or failure. You attach callbacks to a returned object instead of passing them into a function."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise_three_states", "label": "Promise three states", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pending, fulfilled, rejected. Settled means fulfilled or rejected. Transition happens at most once and is irreversible."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_resolved_vs_fulfilled", "label": "Resolved vs fulfilled", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved is the decision, not the outcome \u2014 settled or locked onto another promise. resolve(inner) can leave the outer pending. The executor parameter is named resolve, not fulfill."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_thenable", "label": "Thenable", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any object with a callable then. Promise.resolve and await assimilate thenables. A data field named then is accidentally adopted."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_state_unreadable", "label": "Promise state is not readable", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No promise.state or promise.value. A synchronous isSettled() would reintroduce Zalgo. The only read is attaching a handler."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_mdn_promise", "label": "MDN Promise", "file_type": "document", "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "source_url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise", "target": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise_three_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise", "target": "docs_javascript_pages_phase_7_async_04_callbacks_01_the_pattern_callback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/01-the-three-states.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_resolved_vs_fulfilled", "target": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise_three_states", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confide