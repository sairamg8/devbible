{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_set_returning_functions", "label": "Set-returning functions in FROM", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An SRF returns rows, so it belongs in FROM where rows enter a query. In SELECT two SRFs lockstep-pad with NULL; in WHERE they raise 0A000."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_unnest", "label": "unnest bulk-insert bridge", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter per column keeps the bind count fixed. VALUES hits the 65535 protocol cap at 21845 three-column rows; unnest has no such ceiling."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_jsonb_to_recordset", "label": "jsonb_to_recordset", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One JSON parameter for any number of rows with types declared in AS. Convenient when the body is already JSON; unnest is generally faster."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_generate_series", "label": "generate_series", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gap filling: endpoints are inclusive (hourly over one day is 25 rows); descending needs a negative step; step 0 raises 22023."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_with_ordinality", "label": "WITH ORDINALITY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only way to preserve array input order once values become rows. pos is bigint, which pg returns as text."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_rows_from", "label": "ROWS FROM zip", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit lockstep zip of two SRFs in FROM; same padding as two SRFs in SELECT but readable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_lateral_unnest", "label": "LATERAL unnest", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explodes a per-row array by referencing the left-hand row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_protocol_parameter_cap", "label": "Wire protocol 65535 parameter cap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_set_returning_functions", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_srf_unnest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/srf.html", "source_location": null, "wei