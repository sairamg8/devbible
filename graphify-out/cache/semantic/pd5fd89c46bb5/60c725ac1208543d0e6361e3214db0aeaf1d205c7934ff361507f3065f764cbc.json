{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_page", "label": "An effect has its own lifecycle", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_start_stop", "label": "Effect start/stop lifecycle", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Components mount, update, unmount. Effects only start and stop synchronizing. One mount can contain many start/stop cycles."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_one_process_per_effect", "label": "One effect per synchronization process", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One effect has one dependency array. Merging processes unions their deps, so each restarts for the other's reasons."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_reactive_values", "label": "Reactive values", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Props, state, and values declared inside the component are reactive. ref.current and location.pathname are not, because they live outside render data flow."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_door_lock", "label": "StrictMode door-lock extra cycle", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React starts and stops the effect one extra time in development to verify cleanup is the inverse of setup, not to simulate a rare user journey."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_page", "target": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_start_stop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_one_process_per_effect", "target": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_start_stop", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_reactive_values", "target": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_start_stop", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_door_lock", "target": "build_css_p2_docs_react_pages_phase_4_effects_cleanup_cleanup_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/effect-lifecycle.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_effect_lifecycle_start_stop", "target": "build_css_p2_docs_react_pages_