{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_page", "label": "AbortController and cancellation", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_promises_no_cancel", "label": "Promises cannot be cancelled", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A promise is a view of a result, not a handle on the work. Many consumers can await the same promise; cancelling for one would break the rest."}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortcontroller", "label": "AbortController", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The remote: only the owner calls abort(). Hand callees the signal, never the controller."}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal", "label": "AbortSignal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only side: aborted, reason, throwIfAborted, abort event. Operations reject with a generic AbortError; custom reason is on signal.reason. Check aborted before listening \u2014 the event does not re-fire."}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_timeout", "label": "AbortSignal.timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces racing a promise against setTimeout and actually stops the work. Timer is unrefed so it will not hold the process open."}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_any", "label": "AbortSignal.any", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aborts when any input aborts and adopts that reason. Cancellation counterpart of Promise.race for combining user cancel, deadline and shutdown."}, {"id": "docs_nodejs_pages_phase_2_async_19_abortcontroller_thread_signal", "label": "Thread { signal } through every layer", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation is cooperative. One layer that drops the signal makes everything below uncancellable. Call throwIfAborted between units of work."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_page", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortcontroller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_page", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_promises_no_cancel", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortcontroller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_promises_no_cancel", "target": "docs_nodejs_pages_phase_2_async_09_combinators_no_cancellation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_page", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_page", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_any", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_any", "target": "docs_nodejs_pages_phase_2_async_09_combinators_promise_race", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_thread_signal", "target": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_19_abortcontroller_abortsignal_timeout", "target": "docs_nodejs_pages_phase_2_async_09_combinators_promise_race", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-2-async/19-abortcontroller.md", "source_location": null, "weight": 1.0}], "hyperedges": []}