{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_object_is", "label": "Object.is (SameValue)", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fourth equality algorithm: === with NaN and -0 fixed. Use inside comparison helpers (React, shallowEqual) so NaN fields do not retrigger; keep === for everyday code."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_samevaluezero", "label": "SameValueZero", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NaN equals NaN; 0 equals -0. Used by includes and Map/Set keys."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_strict_equality", "label": "Strict equality ===", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NaN not equal to itself; 0 equals -0. Used by ===, indexOf, and switch."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_loose_equality", "label": "Loose equality ==", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same NaN/-0 outcomes as === in this table; used only by ==."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_negative_zero", "label": "Signed zero -0", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IEEE-754 signed zero from underflow, 0*-1, -1/Infinity, Math.round(-0.2). Invisible to ===, includes, String, JSON.stringify. Detect with Object.is(x,-0) or 1/x===-Infinity. Matters for atan2 and Object.is deep-equal."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_infinity", "label": "Infinity and -Infinity", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Division by zero does not throw. Propagates silently. JSON.stringify turns Infinity and NaN into null."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_number_isfinite", "label": "Number.isFinite validation", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects NaN and both infinities. Number.isNaN(Infinity) is false so overflow passes a NaN-only check."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_math_max_empty", "label": "Math.max empty identity", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/16-object-is-and-zero.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Math.max() and Math.max(...[]) return -Infinity, the identity for max \u2014 not 0 and not an error."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_object_is", "target": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_an