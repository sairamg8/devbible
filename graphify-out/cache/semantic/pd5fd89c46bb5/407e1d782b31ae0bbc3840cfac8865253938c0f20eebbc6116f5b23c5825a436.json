{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_default_parameter_expression", "label": "Default parameter expression", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored unevaluated; runs at call time, left to right, only for omitted arguments."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_undefined_triggers_default", "label": "Only undefined triggers a default", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null is a value. APIs that return null for missing data will not fall back unless you use ?? in the body."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_parameter_list_tdz", "label": "Parameter list TDZ", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults initialise left to right. A forward reference throws only when that argument is omitted."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_no_python_mutable_default", "label": "No Python mutable-default trap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "list = [] constructs per call. The trap returns if the default names a shared outer binding."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_function_length", "label": "Function.length and defaults", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "length counts parameters before the first default or rest. Express and Mocha dispatch on arity."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_parameter_vs_body_scope", "label": "Parameter scope vs body scope", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any default creates a parameter scope. A var of the same name in the body is a different binding."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_default_parameter_expression", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_undefined_triggers_default", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_defaults_and_scope_parameter_list_tdz", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_temporal_dead_zone_temporal_dead_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/defaults-and-scope.html", "source_location": null, "weight": 1.