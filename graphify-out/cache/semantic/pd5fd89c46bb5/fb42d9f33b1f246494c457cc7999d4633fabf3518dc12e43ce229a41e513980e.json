{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_in_exists_not_in", "label": "IN, EXISTS and the NOT IN trap", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IN, = ANY and EXISTS agree. Their negations do not: NOT IN against one NULL returns no rows. The most expensive NULL behaviour in SQL."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_semi_join", "label": "IN / = ANY / EXISTS as semi join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IN is defined as = ANY. All three plan as a semi join that stops at the first match. Choice is readability, not speed. EXISTS SELECT 1 vs SELECT * is identical."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_in_null_trap", "label": "NOT IN NULL trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x NOT IN (a, NULL) is x <> a AND x <> NULL. Comparison to NULL is unknown; WHERE unknown drops every row. Measured 1 \u2192 0 after one NULL elsewhere. NOT EXISTS still returned 1."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_exists", "label": "NOT EXISTS anti join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never compares a value to NULL; a NULL join key simply does not match. Default for every subquery negation. LEFT JOIN \u2026 WHERE right.id IS NULL is the older null-safe spelling."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_any_array_parameter", "label": "= ANY($1::int[]) list parameter", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One parameter regardless of list length; empty array matches nothing. Empty IN () is a syntax error. Never interpolate a NOT IN list \u2014 a null turns the predicate into no rows."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_in_exists_not_in", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_semi_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_in_exists_not_in", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_in_null_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_exists", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_in_null_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_semi_join", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_exists", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_any_array_parameter", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_semi_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/03-in-exists-and-not-in.md", "source_location": null, "weight": 1.0}], "hyperedges": []}