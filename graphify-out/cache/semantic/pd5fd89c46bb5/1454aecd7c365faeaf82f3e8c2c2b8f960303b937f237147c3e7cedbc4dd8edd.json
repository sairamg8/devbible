{"nodes": [{"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_what_an_effect_is_for", "label": "What an effect is for", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An effect synchronizes a component with a system outside React. It is not run-after-render, not componentDidMount, and not where you respond to a click."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_synchronize_with_external_system", "label": "Synchronize with an external system", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you are not synchronizing with a browser API, widget, network, or non-React component, you probably do not need an Effect."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_versus_events", "label": "Effects versus events", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effects are caused by rendering itself. Events are caused by a particular interaction. If why names a user action, it is a handler."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_componentdidmount_wrong_model", "label": "componentDidMount is the wrong model", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useEffect(fn, []) stays connected to the first room forever. Synchronization with real deps and cleanup handles mount, update and unmount."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_client_only", "label": "Effects only run on the client", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They do not run during server rendering, so fetched data is absent from initial HTML, and they are where window, document and localStorage are legal."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effect_paint_timing_not_guaranteed", "label": "Effect timing relative to paint is not guaranteed", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An interaction-caused Effect may run before paint; React may also repaint before processing state updates inside it. useLayoutEffect or setTimeout for a guarantee."}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_synchronizing_with_effects", "label": "react.dev Synchronizing with Effects", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": "https://react.dev/learn/synchronizing-with-effects", "captured_at": "2026-08-13", "author": null, "contributor": null}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_useeffect", "label": "react.dev useEffect", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": "https://react.dev/reference/react/useEffect", "captured_at": "2026-08-13", "author": null, "contributor": null}, {"id": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_you_might_not_need_an_effect", "label": "react.dev You Might Not Need an Effect", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "source_url": "https://react.dev/learn/you-might-not-need-an-effect", "captured_at": "2026-08-13", "author": null, "contributor": null}], "edges": [{"source": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_what_an_effect_is_for", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_synchronizing_with_effects", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_what_an_effect_is_for", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_useeffect", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_what_an_effect_is_for", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_you_might_not_need_an_effect", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_what_an_effect_is_for", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_synchronize_with_external_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/01-what-an-effect-is-for.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_versus_events", "target": "docs_react_pages_phase_4_effects_01_wha