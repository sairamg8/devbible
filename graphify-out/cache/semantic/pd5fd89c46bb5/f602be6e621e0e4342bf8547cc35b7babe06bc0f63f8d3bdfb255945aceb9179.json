{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_index_policy_columns", "label": "Index policy predicate columns", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A policy is a silent predicate on every query. Tenant tables want (tenant_id, \u2026) leading indexes. Confirm with EXPLAIN."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_current_setting_stable", "label": "current_setting is STABLE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "May be evaluated once per statement. Helper functions must be STABLE, not IMMUTABLE (wrong cache) or VOLATILE (per-row)."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_leakproofness", "label": "RLS leakproofness limit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strong on rows returned, weaker on inference. Non-leakproof user predicates may not be pushed below the barrier. SECURITY DEFINER is the common practical hole."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_testing_rls", "label": "Test RLS as the application role", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner-run tests always pass. Assert negatives: other tenant 0 rows, cross-tenant INSERT/UPDATE rejected, missing context empty or error."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_bypassrls_jobs", "label": "BYPASSRLS job role", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one unfiltered role, named for that purpose; the application must not use it. Implicit owner bypass hides unrestricted access."}, {"id": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_rls_as_backstop", "label": "Filter in the app and enable RLS underneath", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App WHERE is clearer and faster; RLS converts a forgotten tenant_id into an empty result and covers psql. On Supabase, RLS is the whole mechanism."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_index_policy_columns", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_permissive_restrictive", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_current_setting_stable", "target": "docs_postgresql_pages_phase_13_ops_14_rls_02_carrying_the_identity_set_config", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_testing_rls", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_owner_bypass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_bypassrls_jobs", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_owner_bypass", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_rls_as_backstop", "target": "docs_postgresql_pages_phase_13_ops_14_rls_readme_row_level_security", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_14_rls_03_performance_and_practice_leakproofness", "target": "docs_postgresql_pages_phase_13_ops_14_rls_01_policies_using_vs_with_check", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-13-ops/14-rls/03-performance-and-practice.md", "source_location": null, "weight": 1.0}], "hyperedges": []}