{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "label": "timestamptz vs timestamp", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both 8 bytes; neither stores a zone. timestamptz is a UTC instant converted on input/output. timestamp keeps the digits and means a different instant to every reader."}, {"id": "docs_postgresql_pages_phase_2_types_04_timestamptz_at_time_zone", "label": "AT TIME ZONE bidirectional conversion", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz AT TIME ZONE zone yields timestamp (clock reading there). timestamp AT TIME ZONE zone yields timestamptz (interpret those digits as that zone). Direction depends on input type."}, {"id": "docs_postgresql_pages_phase_2_types_04_timestamptz_now_vs_clock_timestamp", "label": "now() versus clock_timestamp()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "now()/CURRENT_TIMESTAMP is frozen at transaction start. clock_timestamp() is wall clock and changes every call. Use now() for created_at so one transaction shares a timestamp."}, {"id": "docs_postgresql_pages_phase_2_types_04_timestamptz_dst_intervals", "label": "DST: 1 day versus 24 hours", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same wall-clock time tomorrow and 24 hours from now differ across a DST boundary in a local zone. On UTC-normalised timestamptz they agree."}, {"id": "docs_postgresql_pages_phase_2_types_04_timestamptz_date_js_trap", "label": "date to JavaScript Date midnight trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg turns date into a Date at local midnight. In Asia/Calcutta that is 18:30 UTC the previous day, so toISOString prints the day before. Fix with to_char or setTypeParser(1082)."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_at_time_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_now_vs_clock_timestamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_04_timestamptz_dst_intervals", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_04_timestamptz_date_js_trap", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "target": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/04-timestamptz.md", "source_location": null, "weight": 1.0}], "hyperedges": []}