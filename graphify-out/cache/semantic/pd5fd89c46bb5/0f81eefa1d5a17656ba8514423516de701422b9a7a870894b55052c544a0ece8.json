{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_constructor", "label": "Array constructor arity trap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Array(3) is length 3 with holes; new Array(1,2) is [1,2]. One numeric argument is a length. Hazard when argument count is dynamic."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_of", "label": "Array.of", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always treats arguments as elements. Array.of(3) is [3]. Exists because Array() changes meaning by argument count."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_from", "label": "Array.from", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates a shallow-copied Array from an iterable or array-like. Only built-in that accepts both protocols. Spread requires Symbol.iterator."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_from_mapfn", "label": "Array.from mapFn", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps during construction: no intermediate array. Callback gets (element, index) only \u2014 no third array argument because the array is still being built."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_length_n_idiom", "label": "{length: n} range idiom", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array.from({length:n}, (_,i)=>...) never creates a sparse array. new Array(n).map skips holes. Standard way to build a range."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_page", "label": "01.1 \u00b7 Making arrays", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_page", "target": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_constructor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_page", "target": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_01_making_arrays_array_of", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/01-making-arrays.md", "source_location": nu