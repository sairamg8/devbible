{"nodes": [{"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_single_thread_and_io", "label": "Single-threaded JavaScript, multi-threaded I/O", "file_type": "document", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_one_thread_never_wait", "label": "One thread, and never let it wait", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheap concurrency for I/O-heavy work, paid for with a hard rule: never make that one thread do anything slow."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_blocking_vs_nonblocking", "label": "Blocking versus non-blocking", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_run_to_completion_no_locks", "label": "One callback at a time, no locks", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two functions can never execute simultaneously. The guarantee stops at every await."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_await_read_modify_write_race", "label": "Read-modify-write race across await", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The function yields at await; a second request can run the same code and both write back a value computed from the same stale read."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_network_io_no_threads", "label": "Network I/O uses no extra threads", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sockets are handled by epoll/kqueue/IOCP. The libuv pool is for filesystem, dns.lookup, parts of crypto, and zlib."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_sequential_await_waterfall", "label": "Sequential await waterfall", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three 300ms queries sequential ~902ms, Promise.all ~301ms. Sequential await in a loop is the single most common performance bug in Node code."}], "edges": [{"source": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_single_thread_and_io", "target": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_one_thread_never_wait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_single_thread_and_io", "target": "docs_nodejs_pages_phase_0_runtime_model_02_single_thread_and_io_blocking_vs_nonblocking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-0-runtime-model/02-single-thread-and-io.md", "source_location": null, "weight": 1.0}, {