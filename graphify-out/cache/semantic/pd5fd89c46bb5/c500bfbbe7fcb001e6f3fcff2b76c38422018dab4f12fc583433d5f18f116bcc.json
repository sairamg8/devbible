{"nodes": [{"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_page", "label": "Controlled and uncontrolled", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_two_modes", "label": "Controlled vs uncontrolled", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controlled: React state is the value (value + onChange). Uncontrolled: the DOM owns it (defaultValue). Pick once per field for its lifetime."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_value_no_onchange", "label": "value without onChange is read-only", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warns unless readOnly. value={null} is controlled-with-nothing; use '' to clear and undefined to go uncontrolled."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_attr_vs_property", "label": "value attribute vs value property", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The attribute stays at the initial value; the property holds what the user typed. Assert on element.value, not markup."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_onchange_is_input", "label": "React onChange is the DOM input event", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires every keystroke with the value after the stroke. Native change afterwards fires nothing. No built-in 'finished' event \u2014 use onBlur or debounce."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_store_string", "label": "Store the raw string, convert at the edge", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number() on each keystroke destroys intermediate states (1., -, 1.0) and jumps the caret. Initialise to '' / false / [], never undefined."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_mode_switch", "label": "Uncontrolled-to-controlled warning", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "value was undefined then defined \u2014 usually a fetch. Fix with ?? '' or do not render the form until data exists."}, {"id": "docs_react_pages_phase_1_jsx_13_form_elements_01_controlled_and_uncontrolled_file_uncontrolled", "label": "File inputs are always uncontrolled", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/13-form-elements/01-controlled-and-uncontrolled.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The picker sets the value; JS cannot assign it. Read via ref or FormData."}], "edges": [{"source": "docs_r