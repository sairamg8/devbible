{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "label": "== vs ===", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "=== compares without converting. == converts: null/undefined only each other; string to number; boolean to number first; object via ToPrimitive."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_null_equals_undefined", "label": "value == null", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one defensible == use: tests null or undefined and nothing else. ESLint eqeqeq smart allows it."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_null_relational_trap", "label": "null >= 0 is true", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relational operators ToNumber; Number(null) is 0. == never numeric-compares null. A null stock level silently passes a bounds check."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_four_algorithms", "label": "Four equality algorithms", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "== and === treat NaN as unequal and 0 equal to -0. SameValueZero (includes, Map/Set) equates NaN. SameValue (Object.is) also distinguishes -0."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_null_equals_undefined", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_four_algorithms", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_null_relational_trap", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_reading_the_spec_toprimitive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/equality.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_four_algorithms", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object", "relation": "conceptually_related_to", "confidence": "INFERRED", "confid