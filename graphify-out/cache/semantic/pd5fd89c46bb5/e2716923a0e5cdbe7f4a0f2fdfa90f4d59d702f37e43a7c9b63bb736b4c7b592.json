{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_plpgsql", "label": "PL/pgSQL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/plpgsql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required for trigger bodies. A black box to the planner: fixed 1000-row estimate wrecks joins. Default: sql for one query, plpgsql for triggers, app otherwise."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_language_sql", "label": "LANGUAGE sql", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/plpgsql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can be inlined so the planner sees real statistics (60 rows vs plpgsql's 1000). Standalone timing is the same; joins are where it matters."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_volatility", "label": "Function volatility markers", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/plpgsql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IMMUTABLE foldable and indexable; STABLE inlinable; VOLATILE (default) blocks inlining. Lying about IMMUTABLE gives wrong answers, not errors."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_language_sql", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_plpgsql", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/plpgsql.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_volatility",