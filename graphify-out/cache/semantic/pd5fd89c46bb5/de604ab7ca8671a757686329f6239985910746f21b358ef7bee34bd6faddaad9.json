{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_page", "label": "09 \u00b7 Lazy initial state", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/lazy-initial-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_lazy_initial_state", "label": "Lazy initial state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/lazy-initial-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useState(expensive()) evaluates every render and discards the result after the first. Passing a function runs the work once per instance."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_initializer_purity", "label": "Initializer purity (Strict Mode)", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/lazy-initial-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict Mode double-invokes the initializer in development and discards one result. Side effects belong in an effect, which has cleanup."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_lazy_ref_pattern", "label": "Lazy ref pattern", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/lazy-initial-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useRef has no lazy form; a function argument becomes the ref contents. Initialise to null and assign inside if (ref.current === null)."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_page", "target": "build_css_p2_docs_react_pages_phase_3_state_lazy_initial_state_lazy_initi