{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_write_cte", "label": "Data-modifying CTE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE can INSERT/UPDATE/DELETE/MERGE. WITH moved AS (DELETE \u2026 RETURNING *) INSERT INTO archive SELECT * FROM moved archives in one atomic statement. Always a fence."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_snapshot_rule", "label": "Write-CTE snapshot rule", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A write CTE always runs, referenced or not. Its effect is visible only through its own RETURNING; a sibling SELECT sees the pre-statement snapshot. Two writes touching the same row can lose one silently."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_write_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_snapshot_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_snapshot_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_write_cte", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_write_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_with_cte", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes.html", "source_location": null, "weight": 1.0}], "hyperedges": []}