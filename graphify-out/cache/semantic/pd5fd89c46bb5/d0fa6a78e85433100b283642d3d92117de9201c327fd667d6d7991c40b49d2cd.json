{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_04_typeof_and_why_its_a_feature_typeof_tdz_throw", "label": "typeof throws in the TDZ", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/04-typeof-and-why-its-a-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof still reads the binding. The 'undefined' special case applies only to names with no binding at all."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_04_typeof_and_why_its_a_feature_tdz_is_a_feature", "label": "TDZ is a feature", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/04-typeof-and-why-its-a-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails at the wrong line instead of later; lets const guarantee one observable value; makes a shadow own its name for the whole block."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_04_typeof_and_why_its_a_feature_tdz_error_messages", "label": "TDZ engine error messages", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/04-typeof-and-why-its-a-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8: Cannot access 'X' before initialization. SpiderMonkey names the declaration. JavaScriptCore omits the identifier."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_04_typeof_and_why_its_a_feature_globalthis_feature_detect", "label": "globalThis feature detect", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/04-typeof-and-why-its-a-feature.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribu