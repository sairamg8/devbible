{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_page", "label": "Test doubles \u2014 stub, spy, mock, fake", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. The four are distinguished by what they replace and what you assert on."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_stub", "label": "Stub", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns canned values; assert on the result of the code under test. Reach for this most often. Nothing is asserted about the stub itself."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_spy", "label": "Spy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records calls while real behaviour continues. t.mock.method(obj, name) with two arguments spies; a third argument stubs."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_mock", "label": "Mock (interaction assertion)", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canned values plus expectations about calls. Correct when the call itself is the behaviour \u2014 payments, emails, webhooks."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_fake", "label": "Fake", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Working simplified implementation. Best when several tests need the collaborator to actually work. Drift risk \u2014 back with one integration test against the real thing."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_over_mocking", "label": "Over-mocking as a design smell", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven doubles for one assertion restates implementation. Setup size equals collaborator count. Extract pure functions; leave one thin wiring test."}, {"id": "docs_nodejs_pages_phase_9_testing_09_test_doubles_never_mock_driver", "label": "Never double your own database driver", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stubbing pool.query goes green against invalid SQL, a missing column, and a missing constraint. If mocking removes the risk, it is an integration test."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_over_mocking", "target": "docs_nodejs_pages_phase_9_testing_09_test_doubles_mock", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_never_mock_driver", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_real_sqlstate", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_fake", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_stub", "target": "docs_nodejs_pages_phase_9_testing_09_test_doubles_mock", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_spy", "target": "docs_nodejs_pages_phase_9_testing_09_test_doubles_stub", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_09_test_doubles_page", "target": "docs_nodejs_pages_phase_9_testing_10_fixtures_and_factories_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_9_test_doubles_taxonomy", "label": "Stub, spy, mock, and fake form the test-doubles taxonomy", "nodes": ["docs_nodejs_pages_phase_9_testing_09_test_doubles_stub", "docs_nodejs_pages_phase_9_testing_09_test_doubles_spy", "docs_nodejs_pages_phase_9_testing_09_test_doubles_mock", "docs_nodejs_pages_phase_9_testing_09_test_doubles_fake"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/09-test-doubles.md"}]}