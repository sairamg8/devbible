{"nodes": [{"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_app_set", "label": "Application settings (app.set / app.get)", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App-wide defaults. Do not confuse app.get('etag') (setting) with app.get('/etag', handler) (route)."}, {"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_x_powered_by", "label": "x-powered-by", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default true; advertises Express. Disable in production APIs. Not a security boundary by itself. Measured: app.disable sets it to false."}, {"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_query_parser_simple", "label": "query parser default simple", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express 5 default is simple (was extended in 4). Nested a[b]=1 is not an object. Measured on 5.2.1: query parser = \"simple\"."}, {"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_trust_proxy", "label": "trust proxy", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default false. Without it, req.ip is the proxy. Affects IP, protocol from X-Forwarded-*, secure cookies, and rate-limit keys. Never true blindly."}, {"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_unset_routing_flags", "label": "strict and case-sensitive routing unset", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured undefined, not false. Express never assigns them until you app.set. Unset behaves as off. app.get('strict routing') === false never runs on a fresh app."}, {"id": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_etag_weak", "label": "etag default weak", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured etag = \"weak\". Affects automatic ETag generation for some responses."}], "edges": [{"source": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_app_set", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_express_app", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_app_set", "target": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_x_powered_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/05-application-settings.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_app_set", "target": "docs_expressjs_pages_phase_0_express_basics_05_application_settings_query_parser_simple", "relation": "references", "confidence": "EXTRACTED", "confidence_scor