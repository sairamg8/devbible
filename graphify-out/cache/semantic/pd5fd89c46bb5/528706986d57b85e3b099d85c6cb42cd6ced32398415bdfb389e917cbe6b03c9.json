{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_with_cte", "label": "WITH CTE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds a name to a subquery for one statement. Since PostgreSQL 12 a qualifying CTE is inlined rather than fenced; MATERIALIZED restores the boundary and cost 6\u00d7 here."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_inlining_rule", "label": "CTE inlining rule", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inlined when referenced once, not MATERIALIZED, not recursive, does not write, and contains no volatile function. Otherwise materialized into a tuplestore. Referenced twice runs once."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_with_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_inlining_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_inlining_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_with_cte", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_with_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_write_cte", "relation": "ref