{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_type_parsing_type_mapping", "label": "Default pg type mapping", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/type-parsing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL sends text; pg converts by column OID. json arrives parsed, arrays as arrays, bytea as Buffer, NULL as null."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_type_parsing_bigint_numeric_as_string", "label": "bigint and numeric arrive as strings", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/type-parsing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A JS number is exact only to 2^53-1. Number(9007199254740993) becomes 9007199254740992. numeric is for money where float rounding is unacceptable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_type_parsing_date_timezone_trap", "label": "date and timestamp read in Node TZ", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/type-parsing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "date becomes Date at local midnight (2026-08-12 \u2192 2026-08-11T18:30Z under UTC+5:30). timestamp assumes local time. Only timestamptz is a real instant."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_type_parsing_postgres_interval", "label": "PostgresInterval object", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/type-parsing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Months and days are not fixed durations, so there is no correct millisecond conversion. 