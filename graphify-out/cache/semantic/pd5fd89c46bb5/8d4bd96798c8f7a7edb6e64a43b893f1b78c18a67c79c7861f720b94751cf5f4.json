{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_major_vs_minor", "label": "Minor vs major upgrade", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "18.3\u219218.4 is a restart; 17\u219218 is a data migration. On-disk format is the dividing line."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade", "label": "pg_upgrade", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrates the catalog rather than rewriting rows. Run --check days in advance with the old server still running."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade_link_swap", "label": "pg_upgrade --link / --swap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade rollback for speed. After the new cluster starts (link) or transfer begins (swap), the old cluster is unsafe. Verified backup is the only rollback."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_post_upgrade_statistics", "label": "Post-upgrade statistics", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PG18 transfers most optimizer stats (not CREATE STATISTICS). Still run vacuumdb --all --analyze-in-stages."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_logical_upgrade_path", "label": "Logical-replication upgrade path", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-zero downtime because publisher and subscriber may differ in major version. Downtime is stop-writes, advance sequences, flip the connection string."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_major_vs_minor", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade_link_swap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_pg_upgrade", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_post_upgrade_statistics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_major_vs_minor", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_major_upgrades_logical_upgrade_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/major-upgrades.html", "source_location": null, "weight": 1.0}, {"source