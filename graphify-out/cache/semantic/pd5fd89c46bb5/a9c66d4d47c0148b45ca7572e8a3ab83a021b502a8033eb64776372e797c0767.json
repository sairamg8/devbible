{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "label": "Backpressure", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "write() returns false when the destination queue hits highWaterMark. Ignoring it moves data into an unbounded in-memory queue."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_write_returns_false", "label": "write() returns false", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not mean the write failed \u2014 the chunk was queued. Means stop until drain. 4000\u00d764KB ignored: 250 MB queued vs 0 KB respected."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_drain_event", "label": "drain event", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires when the queue falls below the high water mark. Use once, not on \u2014 on inside a loop leaks listeners and trips MaxListenersExceededWarning."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_writable_length", "label": "writableLength", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queued byte (or object) count. Direct measure of backpressure; legitimate disconnect threshold for a slow consumer."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_fanout_danger", "label": "Fan-out without per-client backpressure", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One slow client queues at the full production rate and can OOM the server. Check write() per destination; drop, throttle, or disconnect laggards."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_write_returns_false", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_drain_event", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_write_returns_false", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_writable_length", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_fanout_danger", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "target": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "backpressure_consumption_protocol", "label": "Backpressure and safe consumption", "nodes": ["docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_write_returns_false", "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_drain_event", "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipeline", "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_for_await_of", "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/09-backpressure.md"}]}