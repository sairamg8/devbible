{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_constant_default", "label": "Constant DEFAULT add is catalog-only", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PostgreSQL 11 a constant default is stored once and applied on read \u2014 4 ms at 200k rows. Old three-step dance is obsolete for constants."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_volatile_default_rewrite", "label": "Volatile DEFAULT rewrites the table", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gen_random_uuid() needs a distinct value per row \u2014 902 ms rewrite. Add nullable, batch-backfill, then set default and NOT NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_not_valid_validate", "label": "NOT VALID then VALIDATE CONSTRAINT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK (col IS NOT NULL) NOT VALID is 3 ms ACCESS EXCLUSIVE; VALIDATE is 25 ms under SHARE UPDATE EXCLUSIVE so reads/writes continue. Then SET NOT NULL can use the CHECK as proof (PG 12+)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_batched_backfill", "label": "Batched backfill", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One UPDATE over millions holds row locks, huge WAL, and VACUUM's horizon. Batches of a few thousand commit separately."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_volatile_default_rewrite", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_not_valid_validate", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_constant_default", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_batched_backfill", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_not_valid_validate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_add_not_null_not_valid_validate", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_alter_table_access_exclusive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/add-not-null.html", "source_location": null, "weight": 1.0}], "hyperedges": []}