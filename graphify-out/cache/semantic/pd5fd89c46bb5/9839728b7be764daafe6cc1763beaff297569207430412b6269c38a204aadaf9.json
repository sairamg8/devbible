{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict", "label": "Against ON CONFLICT", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_index_arbiter", "label": "ON CONFLICT is index-arbitrated", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A unique index is the arbiter so concurrent upserts resolve. MERGE evaluates ON against its snapshot and is not index-arbitrated."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_concurrent_23505", "label": "MERGE concurrent 23505 or silent duplicate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two transactions can both take NOT MATCHED. Isolation below SERIALIZABLE does not fix it; no unique constraint yields a silent duplicate."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_prefer_on_conflict", "label": "ON CONFLICT in request handlers, MERGE in batch jobs", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrency is the dividing line, not RETURNING. MERGE wins for controlled ETL, DELETE-in-pass, complex WHEN, or portability."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_21000", "label": "21000 MERGE cannot affect row a second time", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two source rows match one target. Deduplicate the source first, typically DISTINCT ON (key)."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_availability", "label": "MERGE availability 15 / 17 / 18", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MERGE arrived in 15. 17 added RETURNING, merge_action() and WHEN NOT MATCHED BY SOURCE. 18 added old./new. aliases."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict", "target": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_index_arbiter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict", "target": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_concurrent_23505", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict", "target": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict_prefer_on_conflict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/03-vs-on-conflict.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_13_merge_03_vs_on_conflict", "target": "docs_postgresql_pages_phase_4_cru