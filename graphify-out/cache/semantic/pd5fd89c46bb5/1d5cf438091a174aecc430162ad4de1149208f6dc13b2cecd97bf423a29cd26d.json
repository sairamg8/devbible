{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_fn_prototype", "label": "Constructor.prototype property", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary property only functions have \u2014 the [[Prototype]] given to new instances. Not the function's own prototype; Object.getPrototypeOf(Box) is Function.prototype."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_new_operator", "label": "new operator", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates an object whose [[Prototype]] is Fn.prototype, calls Fn with this bound to it, returns it unless the body returns an object. Methods are shared, not copied. Lookup is dynamic."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_class_sugar", "label": "class as prototype sugar", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Class methods land on Ctor.prototype; the chain is identical. Adds #private, extends, strict bodies, throw-without-new, and non-enumerable methods. Hand-assigned prototype methods stay enumerable."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_object_create", "label": "Object.create", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets [[Prototype]] with no constructor call. Second-argument descriptors default every flag to false \u2014 silent read-only unless stated."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_constructor_property", "label": "prototype.constructor back-reference", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own property of Fn.prototype. Replacing prototype wholesale drops it \u2014 hence Child.prototype.constructor = Child. Writable and forgeable; never use for type checks. Some built-ins read it via Symbol.species."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_fn_prototype", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_how_lookup_walks_internal_slot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/prototype-vs-the-slot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_new_operator", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_prototype_vs_the_slot_fn_prototype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css