{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_inference", "label": "Type inference", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most types are written by nobody. The compiler infers differently for let vs const. Read inferred types from emitted .d.ts, not tooltips."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_widening", "label": "Literal widening let vs const", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let x = 'Hyderabad' infers string because it can be reassigned. const keeps \"Hyderabad\". Object properties widen even under const because contents stay mutable."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_annotate_inputs", "label": "Annotate inputs infer outputs", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameters are not inferred (TS7006 under noImplicitAny). Defaults make parameters optional. Returns are inferred from the body. Annotate exported returns to pin the public contract."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_nouncheckedindexedaccess", "label": "noUncheckedIndexedAccess", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same first<T>(items: T[]) source emits T or T | undefined depending on the flag, because indexing can miss."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_inference", "target": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_widening", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_annotate_inputs", "target": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_inference", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_inference", "target": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_nouncheckedindexedaccess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_widening", "target": "docs_typescript_pages_phase_1_type_vocabulary_02_literal_types_and_as_const_as_const", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/01-primitives-and-inference.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_01_primitives_and_inference_inference", "target": "docs_typescript_pages_phase_1_type_vocabulary_03_arrays_and_tuples_array_type", "relation": "references", "confidenc