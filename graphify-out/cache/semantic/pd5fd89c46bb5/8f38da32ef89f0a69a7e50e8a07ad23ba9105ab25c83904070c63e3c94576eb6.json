{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_12_stream_events_and_modes_flowing_vs_paused", "label": "Flowing vs paused mode", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/12-stream-events-and-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "readableFlowing is null (no consumer), true (pushing via data), or false (paused after flowing). on('data'), pipe, resume switch to flowing."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_12_stream_events_and_modes_stream_events", "label": "Stream events end finish close", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/12-stream-events-and-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "end is readable exhausted and only fires if consumed. finish is writable flushed after end(). close is last and the only event guaranteed after error."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_12_stream_events_and_modes_data_loss_window", "label": "Late data handler data-loss window", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/12-stream-events-and-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once flowing, chunks emitted before a handler attaches are gone. One tick after resume received 0 of 3 chunks."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_12_stream_events_and_modes_readable_read_n", "label": "readable event plus read n", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/12-stream-events-and-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit pull API. read(n) returns exactly n bytes or null \u2014 the one thing for await cannot do. Do not 