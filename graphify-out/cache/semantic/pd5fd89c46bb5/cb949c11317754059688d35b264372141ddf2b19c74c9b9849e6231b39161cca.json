{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_changing_a_setting", "label": "Changing a setting", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reload that silently does nothing wastes an afternoon. Check context and pending_restart first."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_pg_settings_context", "label": "pg_settings.context", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postmaster=restart (shared_buffers, max_connections); sighup=reload (ssl, random_page_cost); user/superuser=SET. pending_restart shows staged changes. Measured PG 18.4."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_alter_system", "label": "ALTER SYSTEM vs postgresql.conf", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes postgresql.auto.conf, read after postgresql.conf and overrides it. RESET undoes. Reload is refused on syntax error; restart with a bad file fails to start."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_setting_precedence", "label": "Setting precedence order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgresql.conf \u2192 auto.conf \u2192 ALTER DATABASE \u2192 ALTER ROLE \u2192 SET \u2192 SET LOCAL. Narrowest scope wins."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_where_to_start", "label": "Tuning start order for PERN", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 random_page_cost 1.1, 2 effective_cache_size ~75% RAM, 3 timeouts per role, 4 work_mem with spill evidence, 5 max_wal_size, 6 shared_buffers last (restart)."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_alter_system", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_setting_precedence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_pg_settings_context", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_alter_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_where_to_start", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_random_page_cost", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/03-changing-a-setting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_where_to_start", "target": "docs_postgresql_p