{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_13_merge_02_returning_and_merge_action", "label": "RETURNING and merge_action()", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/02-returning-and-merge-action.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_02_returning_and_merge_action_returning", "label": "MERGE RETURNING since PostgreSQL 17", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/02-returning-and-merge-action.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widely-repeated advice said MERGE has no RETURNING. Support arrived in 17; this page repeated the false claim until measured."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_02_returning_and_merge_action_merge_action", "label": "merge_action()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/02-returning-and-merge-action.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns INSERT, UPDATE or DELETE per row. Legal only in a MERGE RETURNING list; elsewhere raises 42601."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_02_returning_and_merge_action_old_new", "label": "old. and new. in MERGE RETURNING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/13-merge/02-returning-and-merge-action.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 18 aliases. old.qty is null on INSERT, but a stored NULL looks the same \u2014 use merge_action() for the branch."}, {"id": "docs_postgresql_pages_phase_4_crud_13_merge_02_returning_and_merge_action_delete_prestate", "label": "DELETE branch RETURNING yields pre-state", "file_type":