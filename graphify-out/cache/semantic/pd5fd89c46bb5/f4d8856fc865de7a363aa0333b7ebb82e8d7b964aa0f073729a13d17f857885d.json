{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_conditional_aggregation", "label": "Conditional aggregation", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER attaches a predicate to a single aggregate. Other aggregates in the same select list still see all rows. Standard SQL since PG 9.4."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_where", "label": "FILTER (WHERE \u2026)", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goes after the aggregate's closing parenthesis and before OVER. Takes a full WHERE-style predicate. MySQL and SQL Server do not have it."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_vs_case_empty", "label": "FILTER vs CASE on empty match", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows exist but none match: sum FILTER is NULL, sum(CASE ELSE 0) is 0. No rows at all: both sums are NULL. count FILTER is 0 in every case."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_case_else_0_count_bug", "label": "count(CASE \u2026 ELSE 0) counts every row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count counts non-NULL and 0 is not NULL. Working CASE omits ELSE so non-matches are NULL. FILTER has no ELSE to get wrong."}, {"id": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_pivot", "label": "FILTER pivot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY dimension with one FILTER count per category. Counts come back 0 for empty cells; sums come back NULL and need coalesce. Columns are fixed at query-writing time."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_conditional_aggregation", "target": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_where", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_vs_case_empty", "target": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_where", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/04-filter-clause/01-conditional-aggregation.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_04_filter_clause_01_conditional_aggregation_filter_vs_case_empty", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_sum_empty_null", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 