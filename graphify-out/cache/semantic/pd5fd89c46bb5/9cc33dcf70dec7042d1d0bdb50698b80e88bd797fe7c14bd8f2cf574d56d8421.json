{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_page", "label": "10 \u00b7 Structuring state", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/structuring-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_five_principles", "label": "Five principles for structuring state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/structuring-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group related state; avoid contradictions; avoid redundant state; avoid duplication; avoid deep nesting. Framed as database normalisation."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_impossible_states", "label": "Impossible states", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/structuring-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two booleans give four combinations, some meaningless. A single status value makes invalid combinations unrepresentable."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_flatten_nested_state", "label": "Flatten nested state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/structuring-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lookup table keyed by id turns deep spreads into single-level updates. Flatten in response to pain, not pre-emptively."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_page", "target": "build_css_p2_docs_react_pages_phase_3_state_structuring_state_five_principles", "relation": "references