{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_and_row", "label": "Scalar and row subqueries", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A subquery in an expression position must produce one row and one column. Enforced at runtime, so today's one-row table is tomorrow's 21000."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_subquery", "label": "Scalar subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncorrelated form is evaluated once and attached to every row. More than one row is 21000; zero rows is NULL, not an error. Prefer an aggregate or unique key over LIMIT 1."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_error_21000", "label": "21000 more than one row returned", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planner cannot know the row count, so the query is accepted and the executor discovers the problem. LIMIT 1 without ORDER BY converts a loud error into a plan-dependent answer."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_row_constructor", "label": "Row constructor comparison", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a, b) > (1, 5) is lexicographic: a > 1 or (a = 1 and b > 5). Correct spelling for keyset pagination. Any NULL component yields NULL, same three-valued logic as NOT IN."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_and_row", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_subquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_error_21000", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_row_constructor", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_03_in_exists_and_not_in_not_in_null_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_01_scalar_and_row_scalar_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_correlated_subquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/01-scalar-and-row.md", "source_location": null, "weight": 1.0}], "hyperedges": []}