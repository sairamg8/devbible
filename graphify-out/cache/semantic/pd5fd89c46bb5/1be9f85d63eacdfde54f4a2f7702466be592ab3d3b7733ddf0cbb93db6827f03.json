{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_default_thrower_propagation", "label": "Default thrower error propagation", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no special skip-to-catch rule. Each then without onRejected uses (x) => { throw x; }, so a rejection walks link by link."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_then_two_arg_vs_catch", "label": ".then(f, g) vs .then(f).catch(g)", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-argument then handles only upstream rejections. A throw in f rejects the next promise and is not caught by g. Trailing catch catches both."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_handling_restores_chain", "label": "Handling restores the chain", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a catch the chain is fulfilled. Later then runs on both success and recovered-failure paths. Re-throw to stop."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_nest_to_scope_catch", "label": "Nest then to scope a catch", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A nested catch only sees its scope. The pattern for letting optional steps fail while a critical failure still reaches the outer handler."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_chain_catches_programming_errors", "label": "Chains catch programming errors", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A TypeError in a handler lands in the same catch as a network failure. In the callback pyramid it would escape to uncaughtException."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_default_thrower_propagation", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_promise", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_default_thrower_propagation", "target": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_then_returns_new_promise", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_then_two_arg_vs_catch", "target": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_error_propagation_default_thrower_propagation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/error-propagation.html", "source_location": null, "weight": 1.