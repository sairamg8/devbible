{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_what_css_is_declarative_constraint_language", "label": "CSS as a declarative constraint language", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/what-css-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS states claims about elements; the engine finds the one winning value per property. There is no execution order or call stack, so you debug by asking which rules matched and which won."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_what_css_is_cssom", "label": "CSSOM", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/what-css-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The live object model a stylesheet is parsed into (document.styleSheets / cssRules). The engine consults this, not the authored text; malformed rules silently vanish from the count."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_what_css_is_parse_time_normalization", "label": "Parse-time value normalization", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/what-css-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authored text is not retained: #ff0000 becomes rgb(), padding/border shorthands expand to longhands, and unspecified longhands get defaults such as currentcolor."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_what_css_is_declarative_constraint_language", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_what_css_is_cssom", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/what-css-is.html", "source_lo