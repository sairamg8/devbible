{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_error_first_convention", "label": "Error-first callback convention", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An async callback cannot throw \u2014 the stack is gone \u2014 so the error travels as data in argument zero. On success the first argument is null, not omitted."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_missing_return_after_err", "label": "Missing return after if (err)", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An if does not end the block the way catch does. Fall-through starts the success path with undefined and the stack points at the wrong function."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_try_catch_cannot_reach_callback", "label": "try/catch cannot reach an async callback", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The try finishes when the callee returns. The callback runs later on a fresh stack. Put try inside the callback and route errors as cb(err)."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_zalgo", "label": "Zalgo sometimes-async callback", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function that calls its callback synchronously on some paths and asynchronously on others. Defer the fast path with queueMicrotask."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_callback_exactly_once", "label": "Call the callback exactly once", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every exit path must invoke the callback once. A guard that returns without calling back hangs forever with no object left behind."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_error_first_convention", "target": "build_css_p2_docs_javascript_pages_phase_7_async_the_event_loop_job_complete_when_stack_empty", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_error_first_convention", "target": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_missing_return_after_err", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_try_catch_cannot_reach_callback", "target": "build_css_p2_docs_javascript_pages_phase_7_async_the_event_loop_job_complete_when_stack_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_zalgo", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_task_vs_microtask", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_callback_exactly_once", "target": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_error_first_convention", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_try_catch_cannot_reach_callback", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_never_throws_sync", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_error_first_error_first_convention", "target": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_the_pattern_callback_not_inherently_async", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/error-first.html", "source_location": null, "weight": 1.0}], "hyperedges": []}