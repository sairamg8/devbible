{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_first_normal_form", "label": "First normal form", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One value per column. Comma-separated product_names cannot be joined, indexed, or counted without parsing strings."}, {"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_second_normal_form", "label": "Second normal form", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No partial dependency on part of a composite key. product_name depends only on product_id, not (order_id, product_id)."}, {"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_third_normal_form", "label": "Third normal form", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No dependency between non-key columns. customer_city belongs on customers, not orders, or a move leaves contradictory cities."}, {"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_depend_on_the_key", "label": "Depend on the key the whole key and nothing but the key", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain-language test that replaces formal 1NF/2NF/3NF. Duplication permits contradiction two concurrent writers cannot prevent."}, {"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_historical_snapshot", "label": "Historical price snapshot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unit_cents on the order line is a different fact from products.price_cents. Not denormalization; joining would rewrite past invoices."}, {"id": "docs_postgresql_pages_phase_3_ddl_12_normalization_denormalize_against_measurement", "label": "Denormalize against a measurement", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slow read is fixable later; inconsistent data is often unfixable. Prefer generated columns and materialized views the database maintains."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_12_normalization_depend_on_the_key", "target": "docs_postgresql_pages_phase_3_ddl_12_normalization_first_normal_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_12_normalization_depend_on_the_key", "target": "docs_postgresql_pages_phase_3_ddl_12_normalization_second_normal_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_12_normalization_depend_on_the_key", "target": "docs_postgresql_pages_phase_3_ddl_12_normalization_third_normal_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/12-normalization.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_12_normalization_third_normal_form", "target": "docs_postgr