{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_esm_interop", "label": "CJS \u2194 ESM interop", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both directions work on Node 24. require(esm) shed its experimental label in v24.15.0. One hard boundary remains: top-level await."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_module_lexer", "label": "cjs-module-lexer named exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node statically analyses CJS source to synthesise named exports. Computed keys, loops, and conditionals are invisible. Default-import and destructure."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_require_esm", "label": "require() of an ES module", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the module namespace object, not the default export. A default is at .default. Unflagged in v23.0.0 / v22.12.0 / v20.19.0."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_esmodule_marker", "label": "__esModule marker", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node sets __esModule: true on the namespace from require(esm) so interop code can distinguish it from a plain CJS export object."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_err_require_async_module", "label": "ERR_REQUIRE_ASYNC_MODULE", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require cannot load an ESM graph that contains top-level await anywhere in the subtree. Use await import() or --experimental-print-required-tla."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_create_require", "label": "createRequire", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build a working require inside ESM via createRequire(import.meta.url). Escape hatch that reintroduces synchronous loading."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_json_import_attribute", "label": "JSON import attribute", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "import data from './x.json' with { type: 'json' }. Mandatory security requirement; the old assert spelling is gone."}, {"id": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_dual_package_hazard", "label": "Dual package hazard", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate CJS and ESM builds can both load in one process. Module-scope state then exists twice."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_module_lexer", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_esm_interop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_require_esm", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_esm_interop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_esmodule_marker", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_require_esm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_err_require_async_module", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_require_esm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_err_require_async_module", "target": "docs_nodejs_pages_phase_1_modules_02_commonjs_require_synchronous", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_create_require", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_esm_interop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_json_import_attribute", "target": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_cjs_esm_interop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_04_cjs_esm_interop_dual_package_hazard", "target": "docs_nodejs_pages_phase_1_modules_08_exports_map_exports_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/04-cjs-esm-interop.md", "source_location": null, "weight": 1.0}], "hyperedges": []}