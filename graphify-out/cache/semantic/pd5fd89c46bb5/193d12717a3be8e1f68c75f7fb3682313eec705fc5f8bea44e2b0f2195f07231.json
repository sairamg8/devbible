{"nodes": [{"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_objects_and_functions", "label": "Objects and functions as dependencies", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objects and functions created at different times are different. Avoid object and function dependencies."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_move_static_outside", "label": "Move 1 \u2014 static object outside the component", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If it involves no props or state it is not reactive. Module scope makes [] genuinely correct."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_move_dynamic_inside", "label": "Move 2 \u2014 build the object inside the Effect", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The effect makes the object rather than reading it. What remains is a primitive like roomId. This is the default answer."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_destructure_primitives", "label": "Move 3 \u2014 destructure object props to primitives", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Destructure during render, not inside setup. A parent that rebuilds options every render then causes no reconnection."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_call_pure_function_prop", "label": "Move 4 \u2014 call a pure function prop during render", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getOptions() must be safe during render. An impure function prop belongs in useEffectEvent instead."}], "edges": [{"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_objects_and_functions", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_object_function_identity", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_move_static_outside", "target": "docs_react_pages_phase_4_effects_09_effect_lifecycle_start_and_stop", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_01_objects_and_functions_move_static_outside", "target": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_module_level_init", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/01-objects-and-functions.md", "source_location": null, "weight": 1.0}, {"