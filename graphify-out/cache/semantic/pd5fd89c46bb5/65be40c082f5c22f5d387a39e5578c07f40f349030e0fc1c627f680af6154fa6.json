{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_function_types", "label": "Function types", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contract with a caller. Parameters must be annotated unless contextual; return types inferred but worth writing on exports."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_fewer_parameters", "label": "Fewer parameters is assignable", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignoring an argument is safe; demanding one the caller never sends is not. Makes map(x => \u2026) legal. Reverse: Target signature provides too few arguments."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_contextual_typing", "label": "Contextual typing of callbacks", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the target type is known, parameter types are inferred. Remove the annotation and they revert to implicit any (TS7006)."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_overloads", "label": "Overload implementation is not callable", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only declared overloads are visible. Invalid calls report against the overload list. First matching overload wins; specific first. Prefer union/generic when return type does not depend on args."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_default_vs_optional", "label": "Default vs optional parameters", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x?: string is string | undefined in the body. x = 'a' is optional for callers and string in the body. Default makes the emitted signature optional."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_fewer_parameters", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_function_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_contextual_typing", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_function_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_overloads", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_function_types_function_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/function-types.html", "source_location": null, "weight": 1.0}, {"source": 