{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_page", "label": "MVCC: row versions and snapshots", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_mvcc", "label": "MVCC", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL never overwrites a row. UPDATE writes a new version and marks the old one ending; DELETE only stamps xmax. Explains lock-free reads, table growth, and why VACUUM exists."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_xmin_xmax_ctid", "label": "xmin xmax ctid", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "xmin created this version, xmax ended it, ctid is the physical (page, slot). ctid moves on every UPDATE and is not a stable identifier."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_snapshot", "label": "Snapshot", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "xmin:xmax:in-progress \u2014 oldest still-running xid, one past last completed, and older-than-completed still-running ids. Visible if xmin committed before the snapshot and xmax had not."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_hot_update", "label": "HOT update", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heap-Only Tuple: new version on the same page and no indexed column changed, so indexes are untouched. Index on the updated column disables HOT entirely (0%)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_fillfactor", "label": "fillfactor", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserves free space per page for future versions. fillfactor 100: 0.1% HOT, 4\u219224 MB. fillfactor 70: 76.6% HOT, ended at 13 MB. Requires VACUUM FULL to rewrite existing pages."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_mvcc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_xmin_xmax_ctid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/mvcc.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_hot_update", "relation": "references", "confidence":