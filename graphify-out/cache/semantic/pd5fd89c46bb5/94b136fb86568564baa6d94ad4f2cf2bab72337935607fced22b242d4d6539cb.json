{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_building_the_allowlist", "label": "Building the allowlist", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_sortable_lookup_map", "label": "SORTABLE lookup map", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An allowlist is not validation. Use the request key into an object whose values are SQL you authored. User input never reaches the query. Direction is a ternary, never interpolated."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_null_prototype_map", "label": "Null-prototype or Map allowlist", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain object resolves ?sort=constructor or ?sort=__proto__ to something truthy that is not a column."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_quote_ident", "label": "quote_ident and format %I", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quoting stops stacked statements but is not authorization. An attacker can still order by any real column, including password_hash. %s is unquoted substitution."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_filterable_spec", "label": "FILTERABLE column and operator spec", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both the column and the operator come from the map. Letting the client choose ?op=>= is the same identifier hole."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_quote_ident", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_sortable_lookup_map", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_building_the_allowlist_filterable_spec", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_predicates_and_params_params_length_placeholder", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/building-the-allowlist.html", "source_location": null, "weight": 1.0}], "hyperedges": []}