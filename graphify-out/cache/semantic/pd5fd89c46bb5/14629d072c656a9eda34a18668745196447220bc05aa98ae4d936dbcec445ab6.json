{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_page", "label": "Atomic writes and temp files", "file_type": "document", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "writeFile is not atomic. Write a same-directory temp, fsync, then rename."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_atomic_write", "label": "Temp plus fsync plus rename", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rename is atomic within one filesystem. Readers of the old inode keep the old contents."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_exdev", "label": "EXDEV cross-device rename", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "os.tmpdir is often a different mount in a container. Write the temp in the destination directory."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_mkdtemp", "label": "mkdtemp", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomically creates a directory with a random six-character suffix. Argument is a prefix, not a directory."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_midstream_upload_limit", "label": "Mid-stream upload size limit", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content-Length is client-supplied and absent under chunked encoding. Count bytes as they arrive."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_orphan_sweeper", "label": "Boot-time orphan temp sweeper", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIGKILL leaks temp dirs. Sweep stale .incoming-* with a grace period so in-flight uploads survive boot."}, {"id": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_fsync_before_rename", "label": "fsync before rename", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without sync the rename can persist before contents; power loss leaves the new name on an empty file."}], "edges": [{"source": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_atomic_write", "target": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_wx_exclusive_create", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_fsync_before_rename", "target": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_atomic_write", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/10-atomic-writes-and-temp-files.md", "source_loc