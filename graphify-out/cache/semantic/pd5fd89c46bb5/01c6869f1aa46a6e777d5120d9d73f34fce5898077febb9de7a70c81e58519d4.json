{"nodes": [{"id": "docs_react_pages_phase_4_effects_10_useeffectevent_useeffectevent", "label": "useEffectEvent", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read the latest props and state from inside an effect without making them dependencies. The only sanctioned way to do that."}, {"id": "docs_react_pages_phase_4_effects_10_useeffectevent_effect_events_non_reactive", "label": "Effect Events are non-reactive", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They always see the latest values, but their execution does not re-run the surrounding Effect. Theme can style a notification without reconnecting chat."}, {"id": "docs_react_pages_phase_4_effects_10_useeffectevent_unstable_identity", "label": "Effect Event identity is intentionally unstable", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A runtime assertion: put it in a dependency array and the effect re-runs every render. Never wrap it in useCallback."}, {"id": "docs_react_pages_phase_4_effects_10_useeffectevent_call_site_rules", "label": "Effect Event call-site rules", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level Hook. Call only from Effects or other Effect Events. Never during render, never from a handler, never pass to another component or Hook."}, {"id": "docs_react_pages_phase_4_effects_10_useeffectevent_misuse_shrink_array", "label": "Do not use useEffectEvent to avoid dependencies", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapping the whole setup to reach [] hides real staleness. Only genuinely event-like logic belongs in an Effect Event."}, {"id": "docs_react_pages_phase_4_effects_10_useeffectevent_stable_in_react_19_2", "label": "useEffectEvent is stable in React 19.2", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-checked 2026-08-14: the reference has no experimental banner. The React 19.2 release post (1 Oct 2025) lists it as shipped."}], "edges": [{"source": "docs_react_pages_phase_4_effects_10_useeffectevent_useeffectevent", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_cannot_choose_dependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_10_useeffectevent_effect_events_non_reactive", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_versus_events", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_10_useeffectevent_misuse_shrink_array", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_exhaustive_deps", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/10-useeffectevent.md", "source_location": null, "weight": 1.0}, {"s