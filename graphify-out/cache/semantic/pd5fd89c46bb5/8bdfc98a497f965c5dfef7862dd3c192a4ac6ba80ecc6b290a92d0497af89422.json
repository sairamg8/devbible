{"nodes": [{"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_restructuring_the_effect", "label": "Restructuring the effect", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four moves that change what the effect is, rather than what it reads, so the unwanted dependency becomes genuinely irrelevant."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_updater_form", "label": "Move 5 \u2014 updater form", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setMessages(msgs => [...msgs, msg]) stops reading messages, so the chat no longer reconnects on every received message."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_extract_effect_event", "label": "Move 6 \u2014 extract an Effect Event", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read isMuted or an inline callback prop without reacting to it. Muting should not reconnect the chat."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_move_to_handler", "label": "Move 7 \u2014 move the code to an event handler", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A submitted flag plus theme in the array re-registers the user when the theme changes. The trigger state and the effect disappear together."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_split_effects", "label": "Move 8 \u2014 split into several Effects", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merged, [country, city] refetches cities when the city changes. Each request keeps its own ignore flag."}], "edges": [{"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_updater_form", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_cannot_choose_dependencies", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_extract_effect_event", "target": "docs_react_pages_phase_4_effects_10_useeffectevent_effect_events_non_reactive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_02_restructuring_the_effect_move_to_handler", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_state_as_message_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/02-restructuring-the-effect.md", "source_loc