{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_four_functions", "label": "The four ranking functions", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "row_number, rank, dense_rank and percent_rank take no arguments and differ only in tie behaviour."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_row_number", "label": "row_number", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consecutive integers; ties broken arbitrarily. Non-deterministic unless ORDER BY is unique. Always add a unique tiebreaker before WHERE rn = 1."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_rank", "label": "rank", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties share a place; next value skips the gap (1, 1, 3). max(rank) equals row count, not distinct values. Ranking functions ignore the frame clause."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_dense_rank", "label": "dense_rank", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties share a place with no gap (1, 1, 2). Use for distinct score levels rather than sporting position."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_percent_rank", "label": "percent_rank", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(rank - 1) / (rows - 1), always 0 to 1. Sibling cume_dist is the proportion of rows at or before this one."}, {"id": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_ntile", "label": "ntile", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Divides into n buckets; remainder goes to earliest buckets (7 into 3 \u2192 3,2,2). Splits ties across boundaries, so unsuitable for grading. Prefer percentile_cont thresholds."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_four_functions", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_row_number", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_four_functions", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_rank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_four_functions", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_dense_rank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_four_functions", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_percent_rank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_row_number", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_rank", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_rank", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_dense_rank", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_ntile", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_row_number", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/07-ranking/01-the-four-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_07_ranking_01_the_four_functions_row_number", "target": "d