{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_12_asi_asi", "label": "Automatic semicolon insertion", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/12-asi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semicolons are not optional. ASI inserts only where the next token would otherwise be a syntax error, so valid continuations are taken even when unintended."}, {"id": "docs_javascript_pages_phase_2_operators_12_asi_restricted_productions", "label": "Restricted productions", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/12-asi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Newline after return/throw/break/continue/yield/postfix ++/-- forces a semicolon. return\\n{a:1} yields undefined."}, {"id": "docs_javascript_pages_phase_2_operators_12_asi_dangerous_line_starts", "label": "Five dangerous ASI line starts", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/12-asi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "( [ ` + - and / continue the previous line. + and - produce no error, just a wrong number. Semicolon-free style needs a leading ;."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_12_asi_restricted_productions", "target": "docs_javascript_pages_phase_2_operators_12_asi_asi", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/12-asi.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_12_asi_dangerous_line_starts", "target": "docs_javascript_pages_phase_2_operators_12_asi_asi", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"