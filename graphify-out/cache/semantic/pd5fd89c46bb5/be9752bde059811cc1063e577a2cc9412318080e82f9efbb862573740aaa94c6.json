{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_anchor", "label": "Recursive CTE anchor", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starting set, run once. Cast types here so UNION ALL branches agree (name::text). Anchor row is included in subtree aggregates \u2014 off-by-one for descendant counts."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_term", "label": "Recursive term", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joins the table to the CTE, not to itself. c.parent_id = t.id descends; t.parent_id = c.id climbs. Carries depth and path. Table is scanned once per iteration \u2014 index the join column or cost is depth \u00d7 full scan."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_union", "label": "Recursive Union", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan node for the whole construct. First child is the anchor; second is the recursive term. loops= on the term is iteration count (depth). Measured loops=4 on a 4-level tree."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_worktable_scan", "label": "WorkTable Scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows produced by the previous iteration \u2014 the only input the recursive term reads. Not everything found so far."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_generate_series_instead", "label": "generate_series instead of recursion", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use WITH RECURSIVE when following data shape (hierarchy, graph). When the next value is a pure function of the last, generate_series is simpler and faster."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_union", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_anchor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_union", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_term", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_worktable_scan", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_recursive_term", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_01_walking_a_tree_generate_series_instead", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_readme_with_recursive", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/01-walking-a-tree.md", "source_location": null, "weight": 1.0}], "hyperedges": []}