{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_raw_and_text_express_raw", "label": "express.raw() for webhooks", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/raw-and-text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON parsing destroys exact bytes. HMAC webhooks need express.raw so signatures verify over the original Buffer."}, {"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_raw_and_text_first_consumer_wins", "label": "First body consumer wins the stream", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/raw-and-text.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global express.json() before a route-level raw parser leaves the hook with an empty or re-serialized body. Mount raw on /webhooks/* first."}], "edges": [{"source": "build_css_p2_docs_expressjs_pages_phase_3_requests_raw_and_text_first_consumer_wins", "target": "build_css_p2_docs_expressjs_pages_phase_3_requests_raw_and_text_express_raw", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/raw-and-text.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_3_requests_raw_and_text_first_consumer_wins", "target": "build_css_p2_docs_expressjs_pages_phase_3_requests_json_and_urlencoded_express_json", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/raw-and-text.html", "source_location": null, "weight": 1.0}], "hyperedges": []}