{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_strict_body", "label": "Class body is always strict", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No opt-out. Unbound this is undefined; implicit globals and several silent failures become errors."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_must_use_new", "label": "Class constructors require new", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calling without new is TypeError. A constructor function would silently assign to the wrong this."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_methods_nonenumerable", "label": "Class methods are non-enumerable", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-assigned prototype methods show up in for...in. Class methods do not."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_instance_field_vs_prototype_method", "label": "Instance field vs prototype method", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A field is an own enumerable property per instance. A method is one shared non-enumerable function. Mutable defaults must be fields."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_derived_field_init_order", "label": "Derived field initialization order", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base: fields at constructor start. Derived: immediately before super() returns. An overridden method called from the parent constructor sees uninitialised fields."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_strict_body", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_five_nonsugar_class_features", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_must_use_new", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this_the_four_rules_new_this_binding", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/what-class-desugars-to.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_what_class_desugars_to_class_methods_nonenumerable", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_keys_values_entries_object_keys_definition", "relation": "conceptually_related_to", "confidence": "INFERRE