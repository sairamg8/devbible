{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_what_makes_a_component", "label": "What makes a function a component", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_react_calls_it", "label": "React calls it, not you", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A helper is a function you call. Ownership lets React attach state, effects, position and identity."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_element_vs_call", "label": "<Widget /> is not Widget()", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct calls inline the result into the caller. Hooks join the caller's list and break if conditional."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_capitalization", "label": "Capitalization makes JSX emit a function", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowercase emits a string tag. The function never runs."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_single_props_arg", "label": "One props argument", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built fresh each render so props identity is always new. defaultProps removed for functions in React 19."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_hooks_top_level", "label": "Hooks matched by call order", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No name, no key, just position on the fiber. Conditional hooks shift every later slot."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_react_calls_it", "target": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_element_vs_call", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_element_vs_call", "target": "build_css_p2_docs_react_pages_phase_2_components_function_components_what_makes_a_component_hooks_top_level", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/function-components/what-makes-a-component.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_c