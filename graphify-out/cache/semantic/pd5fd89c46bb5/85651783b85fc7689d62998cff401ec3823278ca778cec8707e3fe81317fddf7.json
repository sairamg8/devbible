{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_task_vs_microtask", "label": "Tasks vs microtasks", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tasks: setTimeout, setInterval, event dispatch, initial script \u2014 one per turn. Microtasks: then/catch/finally, await continuations, queueMicrotask, MutationObserver \u2014 all of them after the current task."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "label": "Microtask drain until empty", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After each task the loop runs all microtasks, including those queued during the drain, until the queue is empty."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_starvation", "label": "Microtask starvation", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A self-re-arming microtask chain never returns to the task queue \u2014 no timers, events, or rendering. A recursive setTimeout yields; a recursive then does not."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_rendering_between_tasks", "label": "Rendering between tasks", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser schedules rendering between tasks after the microtask queue is empty. await null cannot yield to paint; await setTimeout(0) or scheduler.yield() can."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_ordering_1_4_3_2", "label": "1, 4, 3, 2 ordering", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronous first, then the entire microtask queue, then one task. Nested timers drain their microtasks before the next timer task."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_node_extra_queues", "label": "Node nextTick and setImmediate", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "process.nextTick drains before the promise microtask queue; setImmediate is a check-phase task. Relative setTimeout(0) vs setImmediate is context-dependent."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_task_vs_microtask", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_microtasks_vs_macrotasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_task_vs_microtask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_starvation", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_rendering_between_tasks", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_ordering_1_4_3_2", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/the-drain-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotas