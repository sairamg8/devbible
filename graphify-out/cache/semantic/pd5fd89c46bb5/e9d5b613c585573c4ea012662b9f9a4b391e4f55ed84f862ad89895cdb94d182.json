{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_06_scripting_on_error_stop", "label": "ON_ERROR_STOP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default prints the error, continues, and exits 0. -v ON_ERROR_STOP=1 stops and exits 3. Put on every non-interactive invocation."}, {"id": "docs_postgresql_pages_phase_1_psql_06_scripting_single_transaction", "label": "--single-transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps the whole file so a failing later statement rolls back earlier ones. Measured 0 leftover rows. Cannot wrap CREATE DATABASE, VACUUM, CREATE INDEX CONCURRENTLY, ALTER SYSTEM. Holds every lock until the end."}, {"id": "docs_postgresql_pages_phase_1_psql_06_scripting_exit_codes", "label": "psql exit codes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0 success, 1 psql fatal, 2 connection lost, 3 SQL error with ON_ERROR_STOP. Code 3 never appears without the flag."}, {"id": "docs_postgresql_pages_phase_1_psql_06_scripting_c_vs_f", "label": "-c vs -f vs stdin", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several -c flags are separate statements/transactions. -c does not expand psql variables. Use -f or stdin when :var is involved."}, {"id": "docs_postgresql_pages_phase_1_psql_06_scripting_no_psqlrc", "label": "--no-psqlrc / -X", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops a developer's .psqlrc from changing script behaviour. Required in every scripted invocation."}], "edges": [{"source": "docs_postgresql_pages_phase_1_psql_06_scripting_on_error_stop", "target": "docs_postgresql_pages_phase_1_psql_06_scripting_exit_codes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_06_scripting_single_transaction", "target": "docs_postgresql_pages_phase_1_psql_06_scripting_on_error_stop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_06_scripting_single_transaction", "target": "docs_postgresql_pages_phase_0_architecture_12_templates_create_database", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_06_scripting_c_vs_f", "target": "docs_postgresql_pages_phase_1_psql_08_variables_c_no_interpolation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/06-scripting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_06_scripting_single_transaction", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_transactional_ddl", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/