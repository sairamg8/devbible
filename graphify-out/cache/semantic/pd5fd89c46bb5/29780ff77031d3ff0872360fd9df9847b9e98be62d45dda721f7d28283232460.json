{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_page", "label": "Zero-downtime deploys \u2014 rolling restarts, drain, readiness", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_zero_downtime_deploys", "label": "Zero-downtime deploy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New pods take traffic before old pods die; old pods stop receiving work before they exit."}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_rolling_update", "label": "Kubernetes-style rolling update", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ready too early means users hit 500s; platform knobs are maxUnavailable and maxSurge."}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_readiness_and_sigterm_drain", "label": "Readiness gate and SIGTERM drain", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On SIGTERM mark not-ready immediately, close the server, finish in-flight work, then exit."}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_readiness_vs_liveness", "label": "Readiness is not liveness", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failing readiness removes traffic without killing the pod mid-drain; liveness restarts."}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_expand_contract_migrations", "label": "Expand/contract migrations", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old and new code run together during a rollout; schema must be compatible with both briefly."}, {"id": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_termination_grace_period_seconds", "label": "terminationGracePeriodSeconds", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounds how long SIGTERM has before SIGKILL; keep-alive sockets can hang server.close."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_page", "target": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_zero_downtime_deploys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_rolling_update", "target": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_zero_downtime_deploys", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/07-zero-downtime-deploys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_07_zero_downtime_deploys_readiness_and_sigterm_drain"