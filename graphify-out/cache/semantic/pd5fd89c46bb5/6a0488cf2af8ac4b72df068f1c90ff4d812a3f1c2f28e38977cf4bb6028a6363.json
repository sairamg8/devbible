{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_one_thread_one_thread", "label": "One thread, and what runs elsewhere", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/sync-vs-async/one-thread.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_one_thread_run_to_completion", "label": "Run to completion", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/sync-vs-async/one-thread.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function cannot be preempted. That is why JS needs no locks, and why a long sync loop freezes rendering."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_one_thread_concurrency_vs_parallelism", "label": "Concurrency vs parallelism", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/sync-vs-async/one-thread.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_one_thread_await_does_not_block", "label": "await does not block the thread", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/sync-vs-async/one-thread.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await suspends the async function, not the thread. It cannot slice a long synchronous computation."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_one_thread_workers", "label": "Web Workers", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/sync-vs-async/one-thread.html", "source_location": null, "source_url"