{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_lexical_this", "label": "Lexical this", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An arrow has no this. The identifier is a free variable resolved through the scope chain like any other."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_object_literal_not_scope", "label": "Object literal is not a scope", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An arrow used as a method looks past the object literal to module this (undefined)."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_arrow_ignores_call_bind", "label": "call apply bind cannot change arrow this", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They silently do nothing to this and still pass arguments. bind still returns a function so nothing signals failure."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_four_missing_bindings", "label": "Arrow inherited bindings", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "this, arguments, super, and new.target are inherited, not banned. Only prototype is genuinely absent."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_arrow_no_prototype", "label": "Arrow has no prototype", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hasOwnProperty('prototype') is false, so new A() throws TypeError: A is not a constructor."}, {"id": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_inherited_arguments", "label": "Arrow inherited arguments", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At module scope arguments is not defined. Inside a function the arrow reports the outer call count, not its own. Use rest."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_lexical_this", "target": "docs_javascript_pages_phase_3_functions_07_lexical_scope_01_the_scope_chain_lexical_scope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_04_arrow_functions_and_this_01_lexical_this_object_literal_not_scope", "target": "docs_javascript_pages_phase_3_functions_07_lexical_scope_01_the_scope_chain_what_creates_scope", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/javascript/pages/phase-3-functions/04-arrow-functions-and-this/01-lexical-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascrip