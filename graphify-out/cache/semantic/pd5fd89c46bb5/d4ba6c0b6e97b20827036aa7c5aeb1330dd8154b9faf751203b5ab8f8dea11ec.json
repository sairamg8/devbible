{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_25_web_crypto_page", "label": "Web Crypto API", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/25-web-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same primitives as node:crypto via the browser standard. Global, entirely async, stricter. Verified sandbox/p8-security/ex23-webcrypto.mjs."}, {"id": "docs_nodejs_pages_phase_8_security_25_web_crypto_web_crypto", "label": "Web Crypto SubtleCrypto", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/25-web-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "globalThis.crypto === crypto.webcrypto. Every subtle op returns a promise. verify() is constant-time inside the API. No MD5, no scrypt, no streaming."}, {"id": "docs_nodejs_pages_phase_8_security_25_web_crypto_extractable_false", "label": "extractable: false", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/25-web-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node:crypto KeyObject can always be exported. A non-extractable CryptoKey still signs; exportKey throws InvalidAccessError. Containment node:crypto cannot express."}, {"id": "docs_nodejs_pages_phase_8_security_25_web_crypto_webcrypto_vs_nodecrypto", "label": "Web Crypto vs node:crypto choice", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/25-web-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared with browser/Workers \u2192 Web Crypto. Server-only streaming or scrypt \u2192 node:crypto. Do not mix for one concern. HMAC ~5\u00d7 slower (43 vs 8.85 \u00b5s)."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_25_web_crypto_p