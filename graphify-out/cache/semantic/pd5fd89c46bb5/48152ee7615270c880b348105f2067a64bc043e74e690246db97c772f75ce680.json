{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_02_request_bodies_page", "label": "Request bodies are streams", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/02-request-bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no req.body. An unbounded read is a denial-of-service you wrote yourself."}, {"id": "docs_nodejs_pages_phase_5_http_processes_02_request_bodies_req_is_stream", "label": "req is a readable stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/02-request-bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handler runs when headers are parsed. Body arrives in Buffer chunks; concat then decode."}, {"id": "docs_nodejs_pages_phase_5_http_processes_02_request_bodies_body_size_limit", "label": "Mid-stream request body limit", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/02-request-bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content-Length is a claim. Count bytes, reply 413, then destroy. stream/consumers json is unbounded."}, {"id": "docs_nodejs_pages_phase_5_http_processes_02_request_bodies_respond_then_destroy", "label": "Respond 413 before req.destroy", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/02-request-bodies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Destroy first and the client sees UND_ERR_SOCKET, which looks retryable. 413 is not."}, {"id": "docs_nodejs_pages_phase_5_http_processes_02_request_bodies_drain_unread", "label": "Drain or destroy unread bodies", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/02-request-bodies.md", "source_lo