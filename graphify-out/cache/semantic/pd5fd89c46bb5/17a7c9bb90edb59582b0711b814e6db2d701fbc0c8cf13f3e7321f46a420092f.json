{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed migration leaves nothing behind, including the tracking row. Makes forward-only practical. MySQL/Oracle need manual cleanup."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_no_transaction_statements", "label": "Statements that cannot run in a transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE/DROP INDEX CONCURRENTLY, VACUUM, CREATE/DROP DATABASE fail with 25001 inside BEGIN."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_invalid_index", "label": "INVALID leftover CONCURRENTLY index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed CONCURRENTLY build is not rolled back. Planner ignores it; writes still maintain it. Find via pg_index WHERE NOT indisvalid."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_set_local_lock_timeout", "label": "SET LOCAL lock_timeout in migrations", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET LOCAL reverts at commit. Plain SET on a pooled connection leaks into later app queries. 55P03 is the good fail-fast outcome."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_no_transaction_directive", "label": "migrate no-transaction directive", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-file opt-out so CONCURRENTLY can run unwrapped. Honest shape: most DDL should be atomic; non-blocking statements cannot be."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_transactional_ddl", "target": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_migrations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_transactional_ddl", "target": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_forward_only", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_no_transaction_statements", "target": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_no_transaction_directive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migration.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_invalid_index", "target": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_no_transaction_statements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/06-tx-migrati