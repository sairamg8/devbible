{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_rows_frame", "label": "ROWS frame", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts physical rows. Running total that advances one row at a time. Write ROWS UNBOUNDED PRECEDING even when ORDER BY is unique, because RANGE and ROWS only agree until peers appear."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_range_frame", "label": "RANGE frame", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treats equal ORDER BY values as peers sharing one frame. Default. Running total per distinct ordering value. Two same-day rows both showed 30 under RANGE versus 10 then 30 under ROWS."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_default_frame", "label": "Default window frame", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW. Why a running total over a non-unique ORDER BY jumps two rows at once. Hidden in development against unique keys."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_window_peers", "label": "Window peers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows with equal ORDER BY values are indistinguishable to a RANGE frame and share one total. Add a unique tiebreaker or write ROWS."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_partial_window", "label": "Partial moving-average window", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame clips at the partition edge rather than returning NULL. First row of a 3-row MA is its own value. Detect with count(*) over the same frame and blank short windows."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_ranking_ignores_frame", "label": "Ranking functions ignore the frame", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "row_number, rank, dense_rank, lag, lead are defined over the partition. PostgreSQL accepts a frame clause and silently ignores it \u2014 even an absurd frame produced identical output. Worse than a rejection. Aggregates plus first_value/last_value/nth_value do depend on the frame."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_default_frame", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_range_frame", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_window_peers", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_range_frame", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_rows_frame", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_range_frame", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_partial_window", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_rows_frame", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_ranking_ignores_frame", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_readme_window_frames", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/01-rows-vs-range.md", "source_location": null, "weight": 1.0}], "hyperedges": []}