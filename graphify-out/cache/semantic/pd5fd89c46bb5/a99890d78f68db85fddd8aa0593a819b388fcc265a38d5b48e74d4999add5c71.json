{"nodes": [{"id": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_finally_is_a_link", "label": "finally is a link, not a clause", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It runs when the promise it attaches to settles, not at the end of the chain. Transparency means it does not mark a rejection handled."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_executor_runs_synchronously", "label": "Promise executor runs synchronously", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Promise(fn) calls fn immediately on the current stack. Wrapping slow work in a promise does not make it non-blocking."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_every_link_costs_a_microtask", "label": "Every chain link costs a microtask", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A three-link chain over an already-resolved promise takes three ticks. A long chain of sync handlers freezes the frame the way a loop does."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_finally_is_a_link", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_finally_transparency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_executor_runs_synchronously", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_then_always_async", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_every_link_costs_a_microtask", "target": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_01_the_drain_order_microtask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_every_link_costs_a_microtask", "target": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_01_the_drain_order_microtask_starvation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_03_finally_and_timing_every_link_costs_a_microtask", "target": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_01_the_drain_order_rendering_between_tasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/03-finally-and-timing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}