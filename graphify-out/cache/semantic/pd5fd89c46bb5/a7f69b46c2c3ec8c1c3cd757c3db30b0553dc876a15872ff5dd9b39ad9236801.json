{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_17_input_validation_page", "label": "Input validation at the boundary", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one Master practice in front of the prior nine bugs. Content-type, size cap, JSON.parse, then schema. Verified zod 4.4.3 / valibot 1.4.2."}, {"id": "docs_nodejs_pages_phase_8_security_17_input_validation_parse_dont_validate", "label": "Parse, don't validate", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A validator returns a boolean and leaves the untrusted object. A parser returns a new typed value; unchecked fields no longer exist."}, {"id": "docs_nodejs_pages_phase_8_security_17_input_validation_boundary_check_order", "label": "HTTP boundary check order", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content-type \u2192 size cap \u2192 JSON.parse \u2192 schema. JSON.parse of 20 MB is 40.7 ms of event loop; the cap rejects at 1 KB in 0.002 ms."}, {"id": "docs_nodejs_pages_phase_8_security_17_input_validation_body_size_cap", "label": "Request body size cap", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A schema cannot defend a payload it has not received. .max() on an array runs after every element is parsed and can be slower than no max."}, {"id": "docs_nodejs_pages_phase_8_security_17_input_validation_zod_unknown_keys", "label": "Zod unknown-key modes", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "z.object strips, z.strictObject rejects, z.looseObject keeps and copies inherited properties. Privileged fields must be omitted from the schema, not validated."}, {"id": "docs_nodejs_pages_phase_8_security_17_input_validation_zod_coerce_pitfalls", "label": "Zod coercion pitfalls", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "z.coerce.number is Number(): '', [] and null become 0. z.coerce.boolean maps 'false' to true. Repeated query keys arrive as arrays."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_17_input_validation_page", "target": "docs_nodejs_pages_phase_8_security_17_input_validation_parse_dont_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_17_input_validation_page", "target": "docs_nodejs_pages_phase_8_security_17_input_validation_boundary_check_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_17_input_validation_page", "target": "docs_nodejs_pages_phase_8_security_17_input_validation_body_size_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/17-input-validation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_ph