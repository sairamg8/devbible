{"nodes": [{"id": "docs_nodejs_pages_phase_0_runtime_model_06_globals_globals", "label": "Globals worth knowing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-0-runtime-model/06-globals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_0_runtime_model_06_globals_process", "label": "process", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/06-globals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_0_runtime_model_06_globals_process_env_strings", "label": "process.env values are always strings", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/06-globals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEBUG=false is the truthy string 'false'. Convert at the edge, once, and validate at startup."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_06_globals_exit_vs_exitcode", "label": "process.exit versus process.exitCode", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/06-globals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "process.exit is immediate and abandons pending work. Set exitCode and let the event loop drain."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_06_globals_sigterm_graceful_shutdown", "label": "SIGTERM graceful shutdown", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/06-globals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIGTERM is what Docker and Kubernetes send before they kill you. Without a handler, in-flight requests are dropped on every deploy."}, {"id": "docs_nodejs_pages_phase_0_runtime_m