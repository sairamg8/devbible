{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_datetime_functions", "label": "Date and time functions", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_now_transaction_timestamp", "label": "now() is transaction start", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alias for transaction_timestamp(). Two inserts 150 ms apart shared a timestamp. statement_timestamp is per statement; clock_timestamp advances mid-statement."}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_date_js_midnight_trap", "label": "date maps to JS Date at local midnight", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "date 2026-01-01 printed as 2025-12-31T18:30:00Z at UTC+5:30. Return to_char YYYY-MM-DD or setTypeParser on OID 1082. timestamptz is lossless."}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_date_trunc", "label": "date_trunc bucketing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a timestamp so it sorts and indexes. Pass a timezone or a Berlin 00:30 order lands in the previous UTC day. Prefer over to_char grouping."}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_age_vs_subtract", "label": "age() versus timestamp subtraction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "age returns a symbolic interval where 1 mon is 28 to 31 days. Subtraction is elapsed days and hours. pg returns PostgresInterval objects."}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_interval_day_vs_hours", "label": "interval 1 day versus 24 hours", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 day keeps wall-clock time across DST (23 or 25 hours). 24 hours is elapsed. Same time tomorrow versus expires in 24 hours."}, {"id": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_timestamptz", "label": "timestamptz for instants", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores UTC, renders in session TimeZone. timestamp without zone is a wall-clock reading with no recoverable instant. SET TIME ZONE on a pool leaks."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_datetime_functions", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_where_predicates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-functions.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_datetime_functions", "target": "docs_postgresql_pages_phase_4_crud_18_generate_series_generate_series_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/17-datetime-function