{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_07_query_buffer_buffer", "label": "psql query buffer", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/07-query-buffer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL is sent only when terminated. Meta-commands execute immediately. A missing semicolon looks like a hang."}, {"id": "docs_postgresql_pages_phase_1_psql_07_query_buffer_prompt_suffixes", "label": "psql prompt suffixes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/07-query-buffer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "=# ready, -# mid-statement, '# unterminated string, (# unbalanced parentheses. Ctrl-C clears the buffer."}, {"id": "docs_postgresql_pages_phase_1_psql_07_query_buffer_g_variants", "label": "\\g family", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/07-query-buffer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "; and \\g send the buffer. \\gx forces expanded. \\gexec executes each returned value as SQL. \\gdesc describes columns without running."}, {"id": "docs_postgresql_pages_phase_1_psql_07_query_buffer_gset", "label": "\\gset", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/07-query-buffer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores each column of exactly one result row into a psql variable. Prefix avoids collisions. Together with \\if, scripts can branch on data."}, {"id": "docs_postgresql_pages_phase_1_psql_07_query_buffer_editor", "label": "\\e editor", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/07-query-buffer.md", "source_location": null, "source_url": null, "captured_at":