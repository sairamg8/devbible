{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_read_committed", "label": "READ COMMITTED", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default isolation: a fresh snapshot per statement. Maximum concurrency and no 40001 retries; a read-then-write sequence can silently produce wrong data."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_non_repeatable_read", "label": "Non-repeatable read", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same row changes mid-transaction (balance 100 \u2192 999). Allowed by READ COMMITTED."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_phantom_read", "label": "Phantom read", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New matching rows appear mid-transaction (count 2 \u2192 3). Allowed by READ COMMITTED."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_dirty_read", "label": "Dirty read", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading uncommitted data. PostgreSQL never permits this; READ UNCOMMITTED is mapped to READ COMMITTED."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_statement_snapshot", "label": "Statement-level snapshot", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshot is fixed when the statement starts. A long SELECT is internally consistent even if another session commits mid-scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_update_reevaluation", "label": "UPDATE WHERE re-evaluation", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An UPDATE that waited on a row lock re-evaluates WHERE against the newly committed version and may report rowCount 0."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_read_committed", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_non_repeatable_read", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_read_committed", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_phantom_read", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_dirty_read", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_read_committed_read_committed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/read-committed.html", "source_location": 