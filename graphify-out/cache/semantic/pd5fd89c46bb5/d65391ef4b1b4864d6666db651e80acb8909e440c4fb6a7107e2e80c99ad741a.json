{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_what_postgresql_is_object_relational_server", "label": "PostgreSQL object-relational server", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/what-postgresql-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A long-running program that stores data, enforces rules, and answers SQL over a network protocol \u2014 not an embedded library, not SQL syntax alone."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_what_postgresql_is_database_cluster", "label": "Database cluster", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/what-postgresql-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One data directory on disk that may contain many databases. The server process writes WAL and data files for that cluster."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_what_postgresql_is_postgresql_license", "label": "PostgreSQL License", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/what-postgresql-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BSD-style permissive license; no single commercial owner of core. The engine is free; managed hosting is the product."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_what_postgresql_is_app_is_guest", "label": "App is a guest with a connection", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/what-postgresql-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL owns durable multi-user truth; the Node process stay