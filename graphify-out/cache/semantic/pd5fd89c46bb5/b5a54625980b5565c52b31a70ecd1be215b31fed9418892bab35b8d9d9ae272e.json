{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_references_and_hints", "label": "References, hints and the plan", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Referenced twice, a CTE is computed once. NOT MATERIALIZED is a request the planner may ignore. No CTE node is not the same as the filter reaching the scan."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_multi_ref_once", "label": "Multiply-referenced CTE computed once", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic materialization: Buffers 3803, 56.5 ms. NOT MATERIALIZED doubled work (7606 buffers, 124.1 ms). This is the one execution guarantee a CTE gives that a repeated subquery does not."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_not_materialized_advisory", "label": "NOT MATERIALIZED is advisory", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignored when inlining would change the answer \u2014 volatile, recursive, or data-modifying CTEs stay fenced. A random() CTE still planned as CTE Scan despite the hint."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_offset_0_fence", "label": "OFFSET 0 subquery fence", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic pre-12 fence. Still blocks subquery pull-up in PG18: no CTE node, but filter stuck above Subquery Scan and no parallelism. Removing a pointless OFFSET 0 can change the plan."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_references_and_hints", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_multi_ref_once", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_not_materialized_advisory", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_multi_ref_once", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_not_materialized_advisory", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_volatility_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_offset_0_fence", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_materialized_hint", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/03-references-and-hints.md", "source_location": null, "weight": 1.0}], "hyperedg