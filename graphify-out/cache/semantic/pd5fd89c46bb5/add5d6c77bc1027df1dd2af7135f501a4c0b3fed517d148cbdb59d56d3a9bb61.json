{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_deep_copy_json_and_hand_written_json_clone", "label": "JSON round-trip clone", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/shallow-vs-deep-copy/json-and-hand-written.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven documented losses: undefined/functions/symbols omitted-or-nulled, NaN/Infinity\u2192null, Date\u2192string, Map/Set\u2192{}, BigInt throws, cycles throw, symbol/non-enumerable skipped. Acceptable only for already-JSON-shaped data."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_deep_copy_json_and_hand_written_handwritten_clone", "label": "Hand-written deep clone", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/shallow-vs-deep-copy/json-and-hand-written.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interview answer, not production. Still drops prototype, descriptors, accessors, and private fields. Ship structuredClone."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_deep_copy_json_and_hand_written_visited_map", "label": "Visited WeakMap before recurse", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/shallow-vs-deep-copy/json-and-hand-written.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register the empty clone in a WeakMap before walking children so cycles terminate and shared identity is preserved. After the loop never terminates. WeakMap so bookkeeping does not pin every visited object."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_de