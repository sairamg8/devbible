{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_22_security_headers_page", "label": "Security headers and CSP", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser instructions, not API access control. helmet() is 0.80 \u00b5s and 356 bytes; only CSP needs a decision."}, {"id": "docs_nodejs_pages_phase_8_security_22_security_headers_helmet", "label": "helmet defaults", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x-xss-protection: 0 is deliberate. Default HSTS includes includeSubDomains. Node sends none of these headers itself."}, {"id": "docs_nodejs_pages_phase_8_security_22_security_headers_csp", "label": "Content Security Policy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "script-src 'unsafe-inline' is not a CSP. Per-response nonce; a fixed nonce is a permanent password. Roll out via Report-Only. Second line behind output encoding."}, {"id": "docs_nodejs_pages_phase_8_security_22_security_headers_nosniff", "label": "X-Content-Type-Options nosniff", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it browsers sniff bytes so text/plain containing script can execute. Node sends no Content-Type by default. Pair with a correct type and a separate origin for uploads."}, {"id": "docs_nodejs_pages_phase_8_security_22_security_headers_cors_not_access_control", "label": "CORS is not access control", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CORS relaxes the browser SOP; curl and server fetch ignore it. Dangerous only with cookie auth plus reflected Origin and Allow-Credentials."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_22_security_headers_page", "target": "docs_nodejs_pages_phase_8_security_22_security_headers_helmet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_22_security_headers_page", "target": "docs_nodejs_pages_phase_8_security_22_security_headers_csp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_22_security_headers_page", "target": "docs_nodejs_pages_phase_8_security_22_security_headers_nosniff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_22_security_headers_page", "target": "docs_nodejs_pages_phase_8_security_22_security_headers_cors_not_access_control", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/22-security-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_22_security_headers_helmet", "target": "docs_nodejs_pages_phase_8_security_22_security_headers_csp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confi