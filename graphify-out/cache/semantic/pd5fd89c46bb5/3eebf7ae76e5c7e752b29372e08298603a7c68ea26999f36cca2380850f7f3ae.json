{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_page", "label": "The poll phase", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_phase", "label": "Poll phase", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run ready I/O callbacks, then decide whether to block and for how long. Where an idle server spends its life."}, {"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_blocking_vs_blocked_loop", "label": "Poll blocking vs blocked event loop", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poll blocking is sleeping in a kernel call at ~0% CPU; a blocked loop is JS hogging the thread at 100% of one core."}, {"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_epoll_kqueue_iocp", "label": "epoll / kqueue / IOCP idle wait", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thousands of idle sockets cost file descriptors and almost no CPU because they share one blocking kernel call."}, {"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_libuv_thread_pool_signals_poll", "label": "libuv thread pool signals poll", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File reads, dns.lookup, crypto.pbkdf2 and zlib finish on the pool then wake poll; sockets do not compete for the pool."}, {"id": "docs_nodejs_pages_phase_2_async_02_poll_phase_settimeout_is_a_floor", "label": "setTimeout delay is a floor", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poll blocks at most until the nearest timer, then the loop must reach the timers phase; slow callbacks push firing later."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_02_poll_phase_page", "target": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_phase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_phase", "target": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_event_loop_phases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_blocking_vs_blocked_loop", "target": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_phase", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_02_poll_phase_epoll_kqueue_iocp", "target": "docs_nodejs_pages_phase_2_async_02_poll_phase_poll_phase", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/02-poll-phase.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_02_poll_phase_libuv_thread_pool_signals_poll", "target": "docs_no