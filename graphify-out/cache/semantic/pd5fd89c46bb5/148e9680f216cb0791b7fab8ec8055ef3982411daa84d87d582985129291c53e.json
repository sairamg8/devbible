{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "label": "TRUNCATE vs DELETE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE is O(rows) and fires triggers. TRUNCATE is near O(1), reclaims space immediately, and has different semantics."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_transactional", "label": "TRUNCATE is transactional", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike MySQL and Oracle, PostgreSQL TRUNCATE rolls back. It takes ACCESS EXCLUSIVE until commit."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_restart_identity", "label": "TRUNCATE RESTART IDENTITY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain TRUNCATE leaves sequences alone. After 10000 rows the next id was 10001."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_no_row_triggers", "label": "TRUNCATE skips row triggers", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AFTER DELETE FOR EACH ROW never fires. Audit and counter side effects silently vanish. Use AFTER TRUNCATE FOR EACH STATEMENT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_fk_cascade", "label": "TRUNCATE CASCADE vs named tables", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbound FKs raise 0A000. CASCADE empties referencing tables transitively, unlike DROP CASCADE which removes objects not data."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_transactional", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_restart_identity", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_no_row_triggers", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_fk_cascade", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_truncate_truncate_vs_delete", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/truncate.html", "source_location": null, "weight": 1.0}], "hyperedges": []}