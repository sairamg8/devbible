{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_same_number_type", "label": "Literal bases are notation only", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0b, 0o, 0x, decimal, and exponent forms all produce number. Only the n suffix changes the type to bigint."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_numeric_separators", "label": "Numeric separators", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Underscores ignored by the parser. Illegal leading, trailing, doubled, or next to the decimal. _1000 is a ReferenceError (identifier), not SyntaxError."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_octal_file_mode", "label": "Octal file-mode literal 0o755", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0o755 is decimal 493. chmod(path, 755) silently sets wrong permissions. Legacy 0755 is SyntaxError in strict/modules."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_number_vs_parseint", "label": "Number vs parseInt prefixes", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number understands 0x, 0o, 0b. parseInt honours 0x but parseInt('0o755') and parseInt('0b1010') are 0. Always pass radix 10."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_parse_time_rounding", "label": "Literal rounding above MAX_SAFE_INTEGER", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any-base literals above 2^53-1 are rounded at parse time. Use BigInt literals such as 0xffffffffffffffffn."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_number_vs_parseint", "target": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_octal_file_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_parse_time_rounding", "target": "docs_javascript_pages_phase_1_values_and_coercion_17_numeric_literals_same_number_type", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/17-numeric-literals.md", "source_location": null, "weight": 1.0}], "hyperedges": []}