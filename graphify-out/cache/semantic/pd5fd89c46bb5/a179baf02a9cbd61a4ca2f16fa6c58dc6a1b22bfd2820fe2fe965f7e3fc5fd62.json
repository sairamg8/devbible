{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_page", "label": "Cookies", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node has no cookie API. Cookie attributes are the security model of session authentication."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_cookie_header", "label": "Cookie request header", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicates join with semicolon, not comma. Parse with indexOf equals; first occurrence wins."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_set_cookie_array", "label": "Set-Cookie as an array", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One cookie per header line. Joining with semicolon produces one malformed cookie."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_security_attributes", "label": "HttpOnly Secure SameSite", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HttpOnly blocks document.cookie XSS theft; Secure blocks plaintext; SameSite blunts CSRF. Session cookies want all three."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_urlsearchparams_wrong", "label": "URLSearchParams is the wrong cookie parser", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Form decoding: plus becomes space, last duplicate wins, valueless tokens become empty keys."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_host_prefix", "label": "__Host- cookie prefix", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser refuses unless Secure, Path=/, and no Domain. Hardening unforgeable by a subdomain."}, {"id": "docs_nodejs_pages_phase_5_http_processes_04_cookies_opaque_session_id", "label": "Opaque session id vs JWT cookie", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opaque id keeps authority server-side so revocation is a delete. JWT needs a denylist, reintroducing the store."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_04_cookies_urlsearchparams_wrong", "target": "docs_nodejs_pages_phase_5_http_processes_04_cookies_cookie_header", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_04_cookies_urlsearchparams_wrong", "target": "docs_nodejs_pages_phase_4_filesystem_05_url_urlsearchparams", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-5-http-processes/04-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_04_cookies_host_prefix", "target": "docs_nodejs_pages_phase_5_http_processes_04_cookies_security_attributes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0,