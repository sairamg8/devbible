{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views", "label": "Views \u2014 naming a query, and their limits", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_stored_query", "label": "View is a stored query not stored data", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_relation_size is 0 bytes. The view is substituted before planning so the planner optimises one combined query."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_predicate_pushdown", "label": "View predicate pushdown", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering on a GROUP BY key pushed down (0.8 ms); filtering the aggregate result forced a full scan (135.8 ms, 170\u00d7)."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_optimisation_fence", "label": "View optimisation fence", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregates then filtered, DISTINCT, window functions, LIMIT inside the view, and set operations materialise the view before the outer filter."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_no_parameters", "label": "A view cannot take a parameter", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE VIEW ... WHERE customer = $1 raises 42P02. Workaround is LANGUAGE sql STABLE SRF or filter at the call site."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_with_check_option", "label": "WITH CHECK OPTION", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it a write can insert a row that immediately vanishes from the view. With it the insert raises 44000."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_automatically_updatable", "label": "Automatically updatable view", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One table, no aggregate, DISTINCT, GROUP BY, window, or set operation. Otherwise 55000 and an INSTEAD OF trigger is required."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_07_views_security_invoker", "label": "security_invoker views", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Views run with the owner's privileges by default, bypassing caller RLS. PostgreSQL 15+ security_invoker = true uses the caller's privileges."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views_stored_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_stored_query", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views_predicate_pushdown", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_optimisation_fence", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views_predicate_pushdown", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_no_parameters", "target": "docs_postgresql_pages_phase_12_beyond_tables_10_srf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_no_parameters", "target": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_automatically_updatable", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/07-views.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_07_views_stored_query", "target": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/page