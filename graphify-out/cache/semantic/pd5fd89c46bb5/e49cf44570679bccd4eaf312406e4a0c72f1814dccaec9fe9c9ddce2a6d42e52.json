{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_comments_comment_on", "label": "COMMENT ON", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/comments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog documentation; pg_dump includes it. Read with obj_description/col_description or \\d+. information_schema does not expose comments."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_comments_in_migrations", "label": "Comments belong in migrations", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/comments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hand-typed psql comment is lost on rebuild. Comments are not inherited and vanish when an object is dropped/recreated. COMMENT ON replaces; NULL deletes."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_comments_in_migrations", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_comments_comment_on", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/comments.html", "source_location": null, "weight": 1.0}], "hyperedges": []}