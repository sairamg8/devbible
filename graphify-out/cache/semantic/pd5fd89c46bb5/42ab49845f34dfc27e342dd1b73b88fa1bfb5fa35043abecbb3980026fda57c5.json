{"nodes": [{"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_useeffect_anatomy", "label": "useEffect anatomy", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three parts: setup after commit, optional cleanup that undoes it, and a dependency array with three distinct forms."}, {"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_three_dependency_array_forms", "label": "Three dependency-array forms", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No array: after every commit. Empty: after the initial commit only. Populated: initial commit and when a dependency changes by Object.is."}, {"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_cleanup_then_setup", "label": "cleanup(old) then setup(new)", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleanup closes over the render that created it, so it disconnects the old room. At unmount it runs one final time."}, {"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_constant_size_literal", "label": "Dependency array must be a constant-size literal", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies are compared positionally. A changing size is meaningless; a variable defeats exhaustive-deps."}, {"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_async_setup_forbidden", "label": "Setup function cannot be async", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React expects a cleanup function; async returns a Promise. Declare an inner async function and return a real cleanup."}, {"id": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_one_effect_per_concern", "label": "One effect per concern", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging concerns unions their dependency lists, so each tears down for the other's reasons. Split by what is synchronized, not when it runs."}], "edges": [{"source": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_useeffect_anatomy", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_react_dev_useeffect", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_cleanup_then_setup", "target": "docs_react_pages_phase_4_effects_04_cleanup_readme_cleanup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_three_dependency_array_forms", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_the_dependency_array", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/02-useeffect-anatomy.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_02_usee