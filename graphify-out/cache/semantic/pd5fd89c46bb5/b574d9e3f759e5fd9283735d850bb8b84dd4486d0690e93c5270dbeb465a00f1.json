{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "label": "Point-in-time recovery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop the server, move the old data directory aside, restore the base backup, set restore_command and a recovery_target_*, touch recovery.signal, then start. The target must be after the end of the base backup."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_target_action_pause", "label": "recovery_target_action pause default", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default pause stops recovery so you can connect and confirm the landing point before promoting. Immediate promote forecloses a retry. Combined with timelines, a wrong attempt can be repeated."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_signal", "label": "recovery.signal versus standby.signal", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "recovery.signal performs recovery then becomes a normal read-write server. standby.signal keeps the server in continuous recovery as a replica."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_timelines", "label": "PostgreSQL timelines", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When recovery completes, PostgreSQL starts a new timeline so post-recovery WAL does not overwrite original history. recovery_target_timeline (default latest) selects which branch to follow. A wrong PITR is not fatal."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_rpo", "label": "Recovery point objective", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How much data may we lose. Set by archive frequency, archive_timeout, and replication mode. Continuous archiving: last archived WAL segment (seconds to minutes). Nightly pg_dump: up to 24 hours."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_rto", "label": "Recovery time objective", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How long may we be down. Set by backup size, restore speed, and whether anyone has practised. A restore never timed is a hope, not a plan."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_floor", "label": "Oldest recoverable point is backup end", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The recovery target must be after the end of the base backup. You cannot recover into a backup that was still in progress. Base backup frequency sets the recovery floor."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_managed_restore", "label": "Managed provider restore duties", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose retention against how long a corrupting bug might go unnoticed. Keep logical dumps for per-table recovery. Snapshot restore usually yields a new endpoint. The provider guarantees the backup exists, not that you can use it."}, {"id": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr_tradeoff", "label": "PITR trades procedure for precision", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A logical restore is one command; PITR is a stopped server, restored directory, configured target, signal file, and verification. All value is contingent on rehearsal."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_target_action_pause", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_signal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_timelines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_floor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr_tradeoff", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_pitr", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_recovery_target_action_pause", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_timelines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/15-physical-backup/02-restoring-and-rpo.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_rpo", "target": "docs_postgresql_pages_phase_13_ops_15_physical_backup_02_restoring_and_rpo_rto", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13