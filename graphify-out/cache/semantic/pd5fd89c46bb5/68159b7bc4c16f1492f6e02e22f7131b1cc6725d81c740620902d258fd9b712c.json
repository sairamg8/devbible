{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_module_resolution", "label": "Module resolution", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How a string in an import becomes a file on disk. Node decides from specifier shape before anything else."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_specifier_kinds", "label": "Three kinds of specifier", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in (node:fs/fs), relative/absolute path, or bare package name. Only bare specifiers search node_modules."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_node_modules_walk", "label": "node_modules walk", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a bare specifier Node looks in node_modules in the importing file's directory, then parents to the filesystem root. First match wins."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_hoisting_undeclared_deps", "label": "Hoisting makes undeclared dependencies work", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm flattens the tree so a transitive lodash sits in root node_modules. It breaks the day that dependency drops it."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_cjs_esm_divergence", "label": "CJS vs ESM resolution", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CommonJS probes .js/.json/.node and directory index.js. ESM resolves the exact URL and fails with ERR_MODULE_NOT_FOUND or ERR_UNSUPPORTED_DIR_IMPORT."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_nearest_type_field", "label": "Nearest package.json type field", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolution finds the file; the nearest package.json decides how to parse it. .mjs is always ESM, .cjs always CommonJS."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_module_typeless_package_json", "label": "MODULE_TYPELESS_PACKAGE_JSON", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since v22.7.0 / v20.19.0 a typeless .js that fails as CommonJS is reparsed as ESM, with a warning about the cost."}, {"id": "docs_nodejs_pages_phase_1_modules_05_module_resolution_require_resolve", "label": "require.resolve", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/05-module-resolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the resolution algorithm and returns the filename without loading the module."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_05_module_resolution_specifier_kinds", "target": "docs_nodejs_pages_phase_1_modules_05_module_resolution_module_resolution", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase