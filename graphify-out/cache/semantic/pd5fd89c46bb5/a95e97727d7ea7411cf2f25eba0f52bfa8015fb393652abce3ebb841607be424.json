{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_arrow_vs_double_arrow", "label": "jsonb -> vs ->>", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "-> returns jsonb and chains; ->> returns text and terminates. One character decides type."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_missing_key_vs_json_null", "label": "Missing key vs JSON null", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "->> returns SQL NULL for both a missing key and JSON null; use ? or jsonb_typeof to tell them apart."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_hash_path_operators", "label": "jsonb #> and #>> path operators", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path form takes text[]; prefer #>> when the path is fixed and deeper than two levels."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_missing_key_vs_json_null", "target": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_arrow_vs_double_arrow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": null, "we