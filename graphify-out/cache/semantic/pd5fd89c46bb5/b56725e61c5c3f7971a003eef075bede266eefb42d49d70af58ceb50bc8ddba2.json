{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_01_select_shape_select_shape", "label": "The SELECT shape", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/01-select-shape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_01_select_shape_alias_visibility", "label": "SELECT alias visibility", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/01-select-shape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE runs before the select list exists so aliases raise 42703. ORDER BY runs after so the alias works. Repeat the expression in WHERE."}, {"id": "docs_postgresql_pages_phase_4_crud_01_select_shape_select_star", "label": "SELECT * is for psql not code", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/01-select-shape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New columns silently widen payloads, defeat index-only scans, leak column order, and collapse duplicate join names to the last one."}, {"id": "docs_postgresql_pages_phase_4_crud_01_select_shape_bigint_as_string", "label": "pg returns bigint as a string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/01-select-shape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bigint and numeric exceed Number.MAX_SAFE_INTEGER so pg returns strings. count(*) is bigint; cast to int in SQL. Do not parseInt a real bigint."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_01_select_shape_select_shape", "target": "docs_postgresql_pages_phase_4_crud_01_select_shape_alias_visibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgr