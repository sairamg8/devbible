{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_not_in_null_trap", "label": "NOT IN NULL trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x NOT IN (a, NULL) is x <> a AND x <> NULL. The last comparison is unknown, so every row fails. Measured: 1 row became 0 after one NULL elsewhere. NOT EXISTS is null-safe."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_exists", "label": "EXISTS / NOT EXISTS", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positive IN / = ANY / EXISTS all plan as a semi join and agreed at 4. Target list inside EXISTS is never evaluated \u2014 SELECT 1 is convention. Prefer EXISTS for nullable columns and all negations."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_any_array", "label": "= ANY($1::int[]) list parameter", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One parameter regardless of list length; empty array matches nothing. Empty IN () is a syntax error. Stable statement text avoids re-planning per list size."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_not_in_null_trap", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_exists", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_any_array", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_exists", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_not_in_null_trap", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_row_constructor", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/in-exists-and-not-in.html", "source_location": null, "weight": 1.0}], "hyperedges": []}