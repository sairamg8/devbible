{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_private_elements_private_elements", "label": "Private elements", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/private-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No desugaring. # prefix; parser-enforced. Fields, methods, statics, and accessors. Cannot be deleted or created by assignment."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_private_elements_private_parse_time_syntaxerror", "label": "Private access SyntaxError", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/private-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "obj.#field outside the declaring class is a parse-time SyntaxError. The file never runs."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_private_elements_private_brand_check", "label": "Private brand check", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/private-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#x in obj is legal only inside the declaring class. Stronger than instanceof because privates cannot be forged or added later."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_class_private_elements_private_not_inherited", "label": "Private elements are not inherited", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/class/private-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript has n