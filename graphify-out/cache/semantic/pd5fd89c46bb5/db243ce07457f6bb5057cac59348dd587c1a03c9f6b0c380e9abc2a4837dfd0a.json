{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_08_variables_textual_substitution", "label": "Variables are textual substitution", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-1-psql/08-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side paste before SQL is sent. Not parameters, no binding, no type checking. Acceptable for scripts you control; untrusted input belongs in application code with real placeholders."}, {"id": "docs_postgresql_pages_phase_1_psql_08_variables_three_forms", "label": "Three interpolation forms", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/08-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":var raw text for names/numbers/fragments. :'var' quoted escaped string literal. :\"var\" quoted escaped identifier. Same value status produced literal status vs column value paid."}, {"id": "docs_postgresql_pages_phase_1_psql_08_variables_c_no_interpolation", "label": "-c does not interpolate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/08-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical -v variable and query: syntax error at or near \":\" via -c; correct answer 4 via stdin or -f."}, {"id": "docs_postgresql_pages_phase_1_psql_08_variables_unset_literal", "label": "Unset variable left as text", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/08-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error for an undefined name. Guard with \\if :{?name} and \\q 1."}, {"id": "docs_postgresql_pages_phase_1_psql_08_variables_injection", "label": "Bare :var is injectable", "file_type": "concept", "sourc