{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_phase_2", "label": "Phase 2 \u2014 Components, props and composition", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_function_components", "label": "Function components", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React calls it, not you \u2014 a new function object per render destroys the subtree."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_purity", "label": "Purity", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same inputs, same output; no writes to anything that existed before."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_composition", "label": "Composition over configuration", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass the <Button>, not three props describing one."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_controlled_vs_uncontrolled", "label": "Controlled vs uncontrolled", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Who owns the value, and why undefined decides it forever."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up", "label": "Lifting state up", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove, hardcode, add state \u2014 and the re-render that moves with it."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_nesting_is_type_identity", "label": "Nesting rule is type identity", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciliation compares component types by reference. HOCs, lazy() and memo() called in render are the same remount bug."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_proptypes_silent", "label": "propTypes removed silently", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 ignores propTypes with no warning, so an upgrade quietly deletes runtime prop checks."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_memo_is_a_hint", "label": "Skipping a render is a hint", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "shouldComponentUpdate docs say React may re-render anyway \u2014 memoization is not a correctness mechanism."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_ref_as_prop", "label": "ref as a prop", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 made ref ordinary and retired forwardRef for function components."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals", "label": "Portals", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the DOM node, keeps the React tree \u2014 including events."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_no_sandbox", "label": "Phase 2 has no sandbox", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validated against react.dev Learn/Reference, React 19 upgrade guide, and legacy.reactjs.org."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_react_dev", "label": "react.dev", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_phase_2", "target": "build_css_p2_docs_react_pages_phase_2_components_function_components", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_phase_2", "target": "build_css_p2_docs_react_pages_phase_2_components_purity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_phase_2", "target": "build_css_p2_docs_react_pages_phase_2_components_composition", "relation": "references", "confidence": "EXTRACTED", "confidence_score":