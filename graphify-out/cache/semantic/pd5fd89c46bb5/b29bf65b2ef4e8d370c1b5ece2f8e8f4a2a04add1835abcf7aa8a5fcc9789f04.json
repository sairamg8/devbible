{"nodes": [{"id": "docs_react_pages_phase_2_components_16_element_manipulation", "label": "cloneElement, Children.map and isValidElement", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/16-element-manipulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_16_element_manipulation_clone_element", "label": "cloneElement", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/16-element-manipulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a new element with merged props. Uncommon and fragile, not deprecated. Only reaches direct children and hides data flow."}, {"id": "docs_react_pages_phase_2_components_16_element_manipulation_children_api", "label": "Children namespace", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/16-element-manipulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traverses the opaque children structure. Fragments are not traversed; arrays are flattened; elements are not rendered."}, {"id": "docs_react_pages_phase_2_components_16_element_manipulation_children_to_array", "label": "Children.toArray key rewriting", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/16-element-manipulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops empty nodes and prefixes keys with nesting and position so flattening cannot collide keys from different branches."}, {"id": "docs_react_pages_phase_2_components_16_element_manipulation_is_valid_element", "label": "isValidElement", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/16-element-manipulation.md", "source_location": null, "source_u