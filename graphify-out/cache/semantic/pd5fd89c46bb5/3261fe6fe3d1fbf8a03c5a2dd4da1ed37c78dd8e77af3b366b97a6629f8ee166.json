{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_discipline", "label": "Join alias discipline", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alias every table and qualify every column. An unqualified unique name silently rebinds after a same-named column is added."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_ambiguous_42702", "label": "42702 ambiguous column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL will not pick a side. The dangerous case is the unambiguous one that later becomes wrong."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_replaces_name", "label": "Alias replaces the table name", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After FROM t AS c, t.id is 42P01. That replacement is what makes a self join possible."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_ambiguous_42702", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_discipline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_replaces_name", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_discipline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_discipline", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_alias_in_where", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_alias_discipline_alias_discipline", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_bigint_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/alias-discipline.html", "source_location": null, "weight": 1.0}], "hyperedges": []}