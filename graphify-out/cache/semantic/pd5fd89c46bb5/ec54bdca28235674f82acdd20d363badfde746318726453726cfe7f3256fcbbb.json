{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_postgres_fdw", "label": "postgres_fdw", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/fdw.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foreign table is a query against another server. IMPORT FOREIGN SCHEMA snapshots remote definitions."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_pushdown", "label": "FDW pushdown", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/fdw.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full remote aggregate 2.9 ms vs 41.9 ms when a VOLATILE predicate forces shipping rows. Read EXPLAIN VERBOSE Remote SQL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_no_2pc", "label": "FDW is not two-phase commit", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/fdw.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local commit can succeed while the remote fails. Treat FDW as a read tool."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_dblink", "label": "dblink", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/fdw.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older string-query mechanism with no pushdown. Still useful for a query not tied to the local transaction."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_pushdown", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_fdw_postgres_fdw", "relation": "rationale_for", "confidence": "EXTR