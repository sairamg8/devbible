{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_page", "label": "The element", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_react_element", "label": "React element", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen plain object: $$typeof, type, key, props. Not a DOM node. Creating one runs nothing."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_jsx_call", "label": "JSX compiles to jsx()", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic runtime from react/jsx-runtime. Children become a children prop; key is a third argument."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_dollar_typeof", "label": "$$typeof", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symbol mark of a genuine element. Cannot survive JSON, so a server cannot send a fake renderable element \u2014 XSS mitigation."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_key_not_prop", "label": "key is not a prop", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 installs a non-enumerable getter that warns and returns undefined. Pass the value again under another name."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_no_call_yet", "label": "<Greeting /> does not call Greeting", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It holds a reference. React decides whether, when, and how many times to call it."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_react_element", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_jsx_call", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_dollar_typeof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/the-element.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_the_element_key_not_prop", "relation": "references", "confidence": "EXTRACTED", "confi