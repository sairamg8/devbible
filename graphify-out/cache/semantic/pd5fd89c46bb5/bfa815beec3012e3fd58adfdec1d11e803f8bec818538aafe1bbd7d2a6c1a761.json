{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_percentile_cont", "label": "percentile_cont", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set/percentiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interpolates; can return a value not in the data (2.5 from 1,2,3,4). numeric/interval only. Must sort: 178.32 ms vs 57.41 ms for avg on 500k (3.1\u00d7). Percentiles do not compose \u2014 cannot average hourly p95s."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_percentile_disc", "label": "percentile_disc", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set/percentiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns an actual value from the set. Works on any sortable type. percentile_disc(0.0) is min, percentile_disc(1.0) is max. NULLs ignored like every aggregate."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_within_group", "label": "WITHIN GROUP ordered-set syntax", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set/percentiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fraction is the argument; the column lives in WITHIN GROUP (ORDER BY ...), separate from the query's ORDER BY. percentile_cont(ARRAY[0.5, 0.9, 0.99]) sorts once and returns an array."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_percentile_cont", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_percentile_disc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set/percentiles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_percentile_cont", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentiles_within_group", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set/percentiles.html", "source_location": null, "weight": 1.0}], "hyperedges": []}