{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_what_having_costs", "label": "What HAVING costs", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HAVING on a grouping column is rewritten into WHERE and costs nothing. HAVING on an aggregate cannot be, and every discarded group was still built."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_having_rewrite_to_where", "label": "HAVING on grouping columns is rewritten", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY user_id, kind HAVING kind='purchase' becomes Group Key: user_id and Filter on the seq scan. Plans identical to WHERE. Rewrite requires a non-volatile grouping-column predicate."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_aggregate_having_not_pushed", "label": "HAVING on an aggregate cannot be pushed", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filter sits on Finalize HashAggregate. Selectivity does not reduce work: keeping 0 of 5000 groups was no cheaper than keeping all. Same buffers=3783."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_exists_vs_having_count", "label": "EXISTS instead of HAVING count > 0", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(\u2026)>0 forces a full count of every group. EXISTS stops at the first match and can use an index. Does not apply when the threshold is genuinely >1."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_window_in_having_42p20", "label": "42P20 window functions not allowed in HAVING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows run after HAVING. Filter a window in an outer WHERE. rank() OVER (ORDER BY count(*) DESC) is legal because windows run after aggregation."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_what_having_costs", "target": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_having_rewrite_to_where", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_having_rewrite_to_where", "target": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_where_vs_having", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/02-what-having-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_03_having_02_what_having_costs_aggregate_having_not_pushed", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-