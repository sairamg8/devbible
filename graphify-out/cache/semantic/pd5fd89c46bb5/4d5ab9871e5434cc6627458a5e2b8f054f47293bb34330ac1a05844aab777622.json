{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "label": "Sessions vs JWT", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_revocation_tradeoff", "label": "Revocation versus a database lookup", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sessions delete a row and the next request is denied. A JWT is valid because the maths says so until expiry. Short expiry plus refresh rebuilds sessions with extra steps."}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_session", "label": "Opaque server-side session", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random id in an HttpOnly cookie; server holds the truth. Default for a single browser app. Instant revocation, ~32 bytes on the wire."}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_jwt", "label": "JWT", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed claims, readable by anyone holding the token. No storage to validate. Roles bake in at issue time. Pin algorithms; check iss and aud."}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_alg_none_attack", "label": "alg none and HS256-as-RS256", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A library that trusts the header skips verification for alg:none, or uses the public key as an HMAC secret. Always pass an explicit algorithms allowlist."}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_hybrid_tokens", "label": "Short access JWT plus opaque refresh", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5\u201315 minute access JWT plus revocable refresh in an HttpOnly cookie. Accept a revocation window equal to the access lifetime \u2014 a deliberate trade."}, {"id": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_asymmetric_signing", "label": "Asymmetric JWT signing", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RS256/EdDSA so verifiers hold only a public key. With HS256 every service holds the signing secret and is a forgery risk."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_revocation_tradeoff", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_jwt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_alg_none_attack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_hybrid_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_sessions_vs_jwt", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_asymmetric_signing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_session", "target": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_jwt", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/02-sessions-vs-jwt.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_02_sessions_vs_jwt_hybrid_tokens", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_in_memory_access_token", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_fi