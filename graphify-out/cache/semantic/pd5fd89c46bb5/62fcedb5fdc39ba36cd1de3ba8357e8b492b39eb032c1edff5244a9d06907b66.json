{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "label": "LISTEN/NOTIFY from Node", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push to a connected client. Needs a dedicated Client, delivers on COMMIT, stores nothing. Treat as a hint, never a queue."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_dedicated_client", "label": "Dedicated Client for LISTEN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LISTEN is session state. pool.query returns the connection immediately so notifications are lost. Sending via pool is fine."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_pg_notify", "label": "pg_notify function", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOTIFY channel and payload are syntax. pg_notify takes ordinary parameters so a dynamic payload is not concatenated."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_delivery_on_commit", "label": "NOTIFY delivery on COMMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is delivered while the transaction is open. ROLLBACK discards them. Notify in the same transaction as the write."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_dedup_within_tx", "label": "NOTIFY dedup within a transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical channel/payload pairs fold to one delivery. You cannot count notifications."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_payload_limit", "label": "NOTIFY 8000-byte payload limit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over 8000 bytes raises 22023. Send an id and let the listener fetch the row."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_hint_not_queue", "label": "NOTIFY plus queue table", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No persistence, ack, or replay. Queue table is truth; NOTIFY only removes latency. Poll with FOR UPDATE SKIP LOCKED."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_dedicated_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_pg_notify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_delivery_on_commit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_hint_not_queue", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_dedup_within_tx", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_hint_not_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_payload_limit", "target": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_listen_notify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_14_listen_notify_dedicated_client", "target": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_client_end", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-7-pg-driver/14-listen-notify.md", "source_location": null, "weight": 1.0}], "hyperedges": []}