{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark", "label": "highWaterMark", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How much a stream buffers before backpressure. Node 24 defaults: 65536 bytes, 16 object-mode items. Raised from 16 KiB in Node 22."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_curve", "label": "High water mark throughput curve", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4 KB is 10\u00d7 slower than 64 KB on a 216 MB file; 1 MB is no faster than 256 KB. Default sits where the curve flattens."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_when_to_tune", "label": "When to raise or lower highWaterMark", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raise for sequential bulk reads (ceiling ~256 KB). Lower for heavy objects, many concurrent sockets, or latency-sensitive SSE. Peak \u2248 sum of stage marks \u00d7 connections."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_curve", "target": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_when_to_tune", "target": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_19_highwatermark_tuning_highwatermark", "target": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_object_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/19-highwatermark-tuning.md", "source_location": null, "weight": 1.0}], "hyperedges": []}