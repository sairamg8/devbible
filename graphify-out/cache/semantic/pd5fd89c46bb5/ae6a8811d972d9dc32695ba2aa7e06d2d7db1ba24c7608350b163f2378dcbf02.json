{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_on_delete_actions", "label": "ON DELETE actions", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NO ACTION 23503, RESTRICT 23001, CASCADE deletes children, SET NULL, SET DEFAULT. Map both 23503 and 23001 to HTTP 409."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_no_action_vs_restrict", "label": "NO ACTION vs RESTRICT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Difference is timing: deferred NO ACTION checks at COMMIT; RESTRICT always fires immediately (23001)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_index_referencing", "label": "Index every FK referencing column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL indexes the referenced PK, not the child column. Unindexed parent DELETE scanned 300k children in 33.6 ms vs 8.7 ms indexed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_app_cannot_enforce", "label": "Application cannot enforce referential integrity", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check-then-insert is not atomic; another transaction can delete the parent between them. Only the database evaluates the constraint as part of the write."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_no_action_vs_restrict", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_on_delete_actions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_index_referencing", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_create_table_contract", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_app_cannot_enforce", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_on_delete_actions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/foreign-keys.html", "source_location": null, "weight": 1.0}], "hyperedges": []}