{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_page", "label": "Passing a client through services", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transaction across repositories works only if every function uses the same client. Handing the pool breaks atomicity with no error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_pool_split", "label": "Pool instead of client half-commit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "insertOrder(client) rolled back; insertItem(pool) committed. orders=0 items=1. Different backend pids; PostgreSQL has no reason to object."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_db_first", "label": "db as first argument", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the handler names pool. Services that open their own transaction cannot be composed. grep pool in services/repositories should be empty."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_ambient_client", "label": "AsyncLocalStorage ambient client", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes the forgotten-argument bug. ?? pool fallback reintroduces silent autocommit when async context is lost. Throw if no store."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_page", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_pool_split", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_db_first", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_repository_executor_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_ambient_client", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_client_propagation_db_first", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/client-propagation.html", "source_location": null, "weight": 1.0}], "hyperedges": []}