{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_01_lag_and_lead_lag_and_lead", "label": "lag and lead", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/01-lag-and-lead.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetch a value a fixed number of rows away. Makes change-since-last-time a column. Counts rows, not days."}, {"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_01_lag_and_lead_lag", "label": "lag", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/01-lag-and-lead.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lag(expr, offset=1, default=NULL) from a preceding row. Does not cross PARTITION BY. Without ORDER BY, previous means scan order. Non-constant offset is accepted and can yield all NULLs."}, {"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_01_lag_and_lead_lead", "label": "lead", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/01-lag-and-lead.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same arguments as lag, looking forward. Last row of each partition is NULL unless a default is supplied."}, {"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_01_lag_and_lead_date_spine", "label": "generate_series date spine before lag", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/01-lag-and-lead.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lag returns the previous row. A missing day silently compares across the gap. Build a dense spine, LEFT JOIN, count(o.id) not count(*). Use nullif(lag(n), 0) for percent change."}], "edges": 