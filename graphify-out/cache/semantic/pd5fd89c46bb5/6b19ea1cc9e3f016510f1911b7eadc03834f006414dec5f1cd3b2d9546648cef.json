{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_alter_table", "label": "ALTER TABLE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every ALTER takes ACCESS EXCLUSIVE. Catalog-only is milliseconds; a rewrite is linear in row count. Both block every reader and writer."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "label": "Table rewrite via relfilenode", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrite when on-disk representation changes: int\u2192bigint, narrowing varchar, volatile default, SET LOGGED/UNLOGGED. Widening varchar and varchar\u2192text do not."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_volatile_default_rewrite", "label": "Volatile default rewrites ADD COLUMN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constant default is catalog-only since PG11 (4 ms). gen_random_uuid() rewrites 902 ms. now() is statement-stable and did not rewrite."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_lock_timeout", "label": "SET LOCAL lock_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 3 ms ALTER can outage a table: ACCESS EXCLUSIVE queues behind a long read and everything after queues behind it. 55P03 and retry is the good outcome."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_add_backfill_swap", "label": "Add backfill swap type change", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add new column, backfill in batches, keep current with a trigger, swap in a short lock_timeout transaction. Interruptible unlike one ALTER TYPE."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_not_valid", "label": "ADD CONSTRAINT NOT VALID", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips the validation scan (3 ms). VALIDATE CONSTRAINT later takes SHARE UPDATE EXCLUSIVE so reads and writes continue."}, {"id": "docs_postgresql_pages_phase_3_ddl_05_alter_table_batch_subcommands", "label": "Batch ALTER subcommands", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One statement is one lock acquisition and at most one rewrite pass covering all sub-commands."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_alter_table", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_volatile_default_rewrite", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_lock_timeout", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_alter_table", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_add_backfill_swap", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_not_valid", "target": "docs_postgresql_pages_phase_3_ddl_09_add_not_null_not_valid_then_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_alter_table", "target": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_create_index_concurrently", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_05_alter_table_batch_subcommands", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_alter_table", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/05-alter-table.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_3_online_ddl", "label": "Online schema change without long ACCESS EXCLUSIVE", "nodes": ["docs_postgresql_pages_phase_3_ddl_05_alter_table_lock_timeout", "docs_postgresql_pages_phase_3_ddl_05_alter_table_not_valid", "docs_postgresql_pages_phase_3_d