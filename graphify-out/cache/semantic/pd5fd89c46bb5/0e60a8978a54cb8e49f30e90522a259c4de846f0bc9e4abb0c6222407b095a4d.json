{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on", "label": "DISTINCT ON", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL-only: keep the first row per group as ORDER BY produced them. DISTINCT ON (user_id) \u2026 ORDER BY user_id, at DESC is latest event per user, whole row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_order_by_rule", "label": "DISTINCT ON ORDER BY rule", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DISTINCT ON expressions must be the leading ORDER BY expressions (42P10 otherwise). Omitting ORDER BY is legal and returns an arbitrary row per group."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_vs_alternatives", "label": "DISTINCT ON vs row_number vs LATERAL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DISTINCT ON for top-1 over a whole table; row_number() for top-N or the rank; LATERAL when the outer set is small and indexed, and to keep groups with no rows."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_plain_distinct", "label": "Plain DISTINCT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deduplicates the entire computed select list. A unique column in the list makes every row distinct. Treats NULLs as equal. Do not use it to mask join fan-out."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_order_by_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_vs_alternatives", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_plain_distinct", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_order_by_rule", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_logical_order_logical_processing_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_distinct_on_distinct_on_order_by_rule", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_limit_without_order", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/distinct-on.html", "source_location": null, "weight": 1.0}], "hyperedges": []}