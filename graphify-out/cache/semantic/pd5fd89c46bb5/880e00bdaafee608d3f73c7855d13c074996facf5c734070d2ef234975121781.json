{"nodes": [{"id": "docs_react_pages_phase_2_components_13_higher_order_components", "label": "Higher-order components", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_hoc", "label": "Higher-order component", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function that takes a component and returns a new one by wrapping, not mutating. Apply at module level, once."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_never_apply_in_render", "label": "Never apply a HOC during render", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new enhanced type each render makes React unmount and remount the subtree, losing all state. Same nesting-rule bug."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_statics_not_copied", "label": "HOC does not copy static methods", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wrapper is a different function object. Copy statics or use hoist-non-react-statics. Mostly historical now."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_ref_forwarding", "label": "HOC refs and React 19", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before 19, ref was not a prop so spreads dropped it. Function-component HOCs that spread props now forward ref automatically. Class instance refs and React 18 still need forwardRef."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_prop_collisions", "label": "HOC prop collisions are silent", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Injected names collide by spread order with no warning. Wrapper stacks hide where a prop came from."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_around_not_inside", "label": "HOC wraps around a component", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hook cannot wrap from the outside. memo, forwardRef, error boundaries, instrumentation and injected Suspense stay HOC-shaped."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_displayname", "label": "HOC displayName convention", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set displayName from the wrapped component or DevTools shows anonymous wrappers."}, {"id": "docs_react_pages_phase_2_components_13_higher_order_components_legacy_docs", "label": "legacy.reactjs.org Higher-Order Components", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/13-higher-order-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contr