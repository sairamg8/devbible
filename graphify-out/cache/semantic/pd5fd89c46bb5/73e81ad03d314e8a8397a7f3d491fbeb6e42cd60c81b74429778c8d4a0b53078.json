{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify", "label": "LISTEN/NOTIFY \u2014 push from the database", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_pg_notify", "label": "pg_notify from a trigger", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AFTER trigger so the announced row exists. PERFORM rather than SELECT. Row-level 500 inserts \u2192 500 notifications; statement-level \u2192 1."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_channel_names", "label": "NOTIFY identifier vs pg_notify string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOTIFY folds unquoted names; pg_notify uses the string exactly and can compute a channel. Prefer pg_notify from application or trigger code."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_queue", "label": "8 GB notification queue", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stuck listener is database-wide: the queue cannot truncate past it and NOTIFY errors for everyone. Monitor pg_notification_queue_usage()."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_at_most_once", "label": "LISTEN/NOTIFY is at-most-once", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A notification sent while nobody is listening is discarded. Fine as a hint; unacceptable for exactly-once. Combine with an outbox."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_pg_notify", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers_row_vs_statement", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_pg_notify", "target": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql_trigger_functions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_at_most_once", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_table", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/13-listen-notify.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_at_most_once", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_