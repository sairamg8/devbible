{"nodes": [{"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_when_express_wins", "label": "When Express is the right default", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Team already knows it, largest middleware ecosystem, CRUD/JSON where clarity beats micro-benchmarks. This bible uses Express as the HTTP edge for MERN/PERN for those reasons."}, {"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_fastify", "label": "Fastify", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose when schema-driven validation and throughput matter more than the widest Connect middleware ecosystem. Plugin/encapsulation model."}, {"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_hono", "label": "Hono", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edge / ultra-light routing, modern DX, not married to Connect middleware."}, {"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_nestjs", "label": "NestJS", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full batteries with DI and modules. Out of this bible's Express track. Can wrap Express or Fastify later."}, {"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_raw_node_http", "label": "Raw node:http", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learn HTTP itself here first. Possible for production APIs, rarely pleasant. Leaving Express does not mean leaving Node."}, {"id": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_current_line", "label": "Express 5.2.1 current line", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm latest is 5.2.1; latest-4 is 4.22.2. 'Express is unmaintained' FUD is outdated social posts."}], "edges": [{"source": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_when_express_wins", "target": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_fastify", "target": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_ecosystem_tradeoff", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when-not-to-use-express.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_07_when_not_to_use_express_raw_node_http", "target": "docs_expressjs_readme_node_phase_5_prerequisite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/07-when