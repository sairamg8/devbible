{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues", "label": "Dead-letter queues", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/dead-letter-queues.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues_dlq", "label": "Dead-letter queue", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/dead-letter-queues.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where poison jobs go when retrying no longer helps. BullMQ's failed set is not a DLQ \u2014 it mixes today's transients with last month's poison. Store full payload, error, attempts, correlation id."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues_unrecoverable_error", "label": "UnrecoverableError", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/dead-letter-queues.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 4xx other than 429 should die on the first attempt. Classify the error rather than counting retries. Replay into the original queue with a derived jobId and idempotent handlers."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues", "target": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues_dlq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/dead-letter-queues.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_dead_letter_queues", "target": "build_css_p2_docs_nodejs_page