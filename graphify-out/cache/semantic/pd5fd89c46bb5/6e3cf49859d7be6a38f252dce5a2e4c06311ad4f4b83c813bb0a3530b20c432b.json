{"nodes": [{"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_chains_of_effects", "label": "Chains of effects", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each effect sets the state that wakes the next. One card costs four renders. The cascade is only visible when you read all four together."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_cannot_be_replayed", "label": "An effect chain cannot be replayed", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attached to state changing, not the user acting. Undo, history, session restore and tests that seed state re-fire the cascade. Handler logic is inert until called."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_snapshot_trap", "label": "Snapshot trap when collapsing a chain", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inside a handler, state is a snapshot. Name nextRound = round + 1. The chain had been getting fresh values only because each link ran in a later render."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_derived_state_in_chain", "label": "Chains are often stored derived state", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "isGameOver was always round > 5. Each stored derivation needs a maintaining effect. Delete the storage and the effect goes with it."}], "edges": [{"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_cannot_be_replayed", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_derived_state_in_chain", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_snapshot_trap", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_02_chains_of_effects_cannot_be_replayed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/02-chains-of-effects.md", "source_location": null, "weight": 1.0}], "hyperedges": []}