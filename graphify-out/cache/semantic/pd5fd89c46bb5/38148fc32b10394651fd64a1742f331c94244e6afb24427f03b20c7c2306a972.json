{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_page", "label": "Module mocking with mock.module()", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. Experimental, Stability 1.0 Early development."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_mock_module", "label": "mock.module()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces a module in the loader so importers get the test version. Escape hatch for a dependency you cannot inject."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_experimental_flag", "label": "--experimental-test-module-mocks", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without the flag mock.module is not a function \u2014 TypeError, not a helpful message. Put it on the test script."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_import_order_trap", "label": "Mock-first then dynamic import", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A static import evaluates the module under test before the mock exists. Even a later await import() returns the cached module. Mock first, then dynamic-import."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_exports_option", "label": "mock.module exports option", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "namedExports is deprecated on 24.19.0. Use options.exports for named and default exports."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_t_mock_scope", "label": "t.mock.module scoped restore", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "t.mock.module is undone when the test ends; top-level mock.module is not. Default process-per-file isolation prevents leaks between files; --test-isolation=none can leak."}, {"id": "docs_nodejs_pages_phase_9_testing_08_module_mocking_prefer_injection", "label": "Prefer dependency injection over mock.module", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use mock.module only for third-party import-time side effects, uninjectable builtins, or legacy code. Injection has no flag, no import-order rule, and a visible signature."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_08_module_mocking_mock_module", "target": "docs_nodejs_pages_phase_9_testing_08_module_mocking_experimental_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_08_module_mocking_import_order_trap", "target": "docs_nodejs_pages_phase_9_testing_08_module_mocking_mock_module", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/08-module-mocking.md", "source_location": null, "weight": 1.0}, {"source": 