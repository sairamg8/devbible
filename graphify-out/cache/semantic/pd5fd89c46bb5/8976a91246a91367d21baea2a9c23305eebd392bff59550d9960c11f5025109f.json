{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_02_left_join_01_null_extension", "label": "The guarantee and its NULLs", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/01-null-extension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_01_null_extension_guarantee", "label": "LEFT JOIN at-least-once guarantee", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/01-null-extension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every left row appears at least once, not exactly once. Fan-out still applies. Unmatched left rows are NULL-extended."}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_01_null_extension_manufactured_nulls", "label": "Manufactured NULLs indistinguishable from stored", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/01-null-extension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test a NOT NULL right-hand column, normally the primary key, to detect unmatched rows."}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_01_null_extension_count_trap", "label": "count(*) vs count(col) after LEFT JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/01-null-extension.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) counts the NULL-extended row (5 vs 4). Per group it turns no orders into a count of 1."}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_01_null_extension_is_null_antijoin", "label": "LEFT JOIN IS NULL anti-join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/01-nul