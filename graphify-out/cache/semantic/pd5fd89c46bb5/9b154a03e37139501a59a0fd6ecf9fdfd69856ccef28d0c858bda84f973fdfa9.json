{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_advisory_locks_page", "label": "Advisory locks", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/advisory-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_advisory_locks_advisory_lock", "label": "Advisory lock", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/advisory-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named mutex keyed by a number, not a row. For single-runner cron, migrations, file imports. Advisory: the database enforces the lock, not the invariant."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_advisory_locks_pg_try_advisory_lock", "label": "pg_try_advisory_lock", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/advisory-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never waits; returns true/false immediately. Re-entrant and reference-counted within a session. Two-int form is a separate key space from the bigint form."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_advisory_locks_session_vs_transaction_scope", "label": "Session vs transaction advisory lock", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/advisory-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer pg_advisory_xact_lock \u2014 released at COMMIT/ROLLBACK and cannot leak. Session locks survive COMMIT and a pooled connection can return still holding them; release(true) if state is unknown."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvc