{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_borrowing_and_cost_borrowing_and_cost", "label": "Borrowing, partial application and cost", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/borrowing-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "call/apply/bind survive as borrowing, type tags, and left-to-right partial application."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_borrowing_and_cost_method_borrowing", "label": "Array method borrowing", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/borrowing-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array methods need only length and integer keys; Array.from replaced most slice.call uses."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_borrowing_and_cost_tostring_call", "label": "Object.prototype.toString.call type tag", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/borrowing-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof cannot tell Array from null; toString.call reads the internal tag but loses to Symbol.toStringTag."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_borrowing_and_cost_apply_stack_limit", "label": "apply and spread stack limit", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/borrowing-and-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both overflow at ~200k arguments with RangeErr