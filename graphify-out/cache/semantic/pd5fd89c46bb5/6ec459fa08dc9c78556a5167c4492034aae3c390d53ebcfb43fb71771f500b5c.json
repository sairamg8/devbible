{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_null_vs_undefined", "label": "null versus undefined", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined is absence the engine produced; null is absence you chose. Prefer undefined by omission; use null to signal cleared in a payload."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_default_parameters", "label": "Defaults fire only on undefined", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "f(undefined) and f() get the default; f(null) and f(0) do not. Same rule for destructuring, so API null bypasses defaults."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_nullish_coalescing", "label": "Nullish coalescing ??", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "?? falls back only on null and undefined. || falls back on every falsy value including 0, '', false, and NaN. Mixing ?? with || or && is a SyntaxError without parens. NaN ?? 1 is NaN."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_json_undefined_dropped", "label": "JSON.stringify drops undefined", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined omits the field; null keeps it. In a PATCH, that is leave-alone versus set-to-empty."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_null_vs_undefined", "target": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_default_parameters", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_null_vs_undefined", "target": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_json_undefined_dropped", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_nullish_coalescing", "target": "docs_javascript_pages_phase_1_values_and_coercion_04_truthiness_eight_falsy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_null_vs_undefined", "target": "docs_javascript_pages_phase_1_values_and_coercion_03_equality_null_eq_undefined", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/05-null-vs-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_null_vs_undefined", "target": "docs_javascript_pages_phase_1_values_and_coercion_01_the_eight_types_typeof_null_bug", "relation": "references", "confidence": "EXTR