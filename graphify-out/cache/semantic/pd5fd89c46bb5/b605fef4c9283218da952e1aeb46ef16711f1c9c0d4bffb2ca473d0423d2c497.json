{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum", "label": "VACUUM, autovacuum and bloat", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum", "label": "VACUUM", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks dead space reusable under SHARE UPDATE EXCLUSIVE; does not return space to the OS. Deleting half of a 46 MB table left it 46 MB after VACUUM; later inserts reused the space."}, {"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum_full", "label": "VACUUM FULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrites the table under ACCESS EXCLUSIVE and returns space to the OS (46 MB \u2192 23 MB, 260 ms). Only when the table will not regrow. Never on a schedule."}, {"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_autovacuum", "label": "Autovacuum threshold", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "50 + 0.2 \u00d7 live_rows. 90000 live \u2192 18050 dead. A 10-million-row table waits for two million dead rows. Override per table, not globally."}, {"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_pg_repack", "label": "pg_repack", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_insert_threshold", "label": "autovacuum_vacuum_insert_threshold", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_13_vacuum", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum_full", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_autovacuum", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_pg_repack", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum_full", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_insert_threshold", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_autovacuum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/13-vacuum.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgre