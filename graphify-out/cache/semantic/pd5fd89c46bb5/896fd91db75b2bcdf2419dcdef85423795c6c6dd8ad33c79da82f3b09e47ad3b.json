{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_unused_indexes_page", "label": "Unused and duplicate indexes", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/unused-indexes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_unused_indexes_idx_scan", "label": "idx_scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/unused-indexes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How many times the planner chose the index. Zero after a full business cycle is a drop candidate, but exclude UNIQUE, check stats_reset, replicas, and quarterly jobs."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_unused_indexes_duplicate_indexes", "label": "Duplicate indexes", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/unused-indexes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group pg_index by indrelid, indkey, indclass, indexprs, indpred, indisunique. A PRIMARY KEY or UNIQUE already is an index; adding another on the same column is dead weight."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_unused_indexes_stats_fetch_consistency", "label": "stats_fetch_consistency cache", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/unused-indexes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "idx_scan lags: backends flush on a timer and the reader caches a snapshot. pg_stat_clear_snapshot() plus a wait; never judge unused from seconds-old reads."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_index