{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_lifecycle_and_hooks", "label": "Lifecycle and hooks mapping", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_one_effect", "label": "Three lifecycles collapse into one effect", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setup covers mount and update, cleanup covers unmount. Mimicking three methods misses the sync model."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_unsafe_lifecycles", "label": "UNSAFE_ lifecycles", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They run before commit, so an abandoned concurrent render has already executed them. Signal of pre-16.3 code."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_error_boundaries", "label": "Error boundaries require a class", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No function equivalent for getDerivedStateFromError or componentDidCatch in React 19."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_gdsfe_vs_cdc", "label": "getDerivedStateFromError vs componentDidCatch", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static method is render-phase and must be pure. Instance method is commit-phase logging with the component stack."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_boundary_gaps", "label": "What error boundaries do not catch", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event handlers, async, SSR and the boundary itself. React 19 adds onUncaughtError and onCaughtError."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_gdsfp", "label": "getDerivedStateFromProps usually should not translate", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copying a prop into state is duplicated state. Derive during render instead."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_error_boundaries", "target": "build_css_p2_docs_react_pages_phase_2_components_class_components_lifecycle_and_hooks_gdsfe_vs_cdc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/lifecycle-and-hooks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phas