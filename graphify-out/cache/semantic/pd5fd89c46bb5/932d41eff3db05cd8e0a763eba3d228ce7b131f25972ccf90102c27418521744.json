{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_04_what_to_log_what_to_log", "label": "What to log", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log decisions and outcomes: authz denies, state transitions, dependency failures, exhausted retries, config fallbacks."}, {"id": "docs_nodejs_pages_phase_10_observability_04_what_to_log_never_log_secrets", "label": "Never log secrets or raw PII", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords, tokens, full PAN/CVV, government ids, raw address books, private keys. Logs have wider read access than the database."}, {"id": "docs_nodejs_pages_phase_10_observability_04_what_to_log_data_minimization", "label": "Data minimization vs redaction", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimization means not putting sensitive fields on the object. Redaction strips fields that slipped through. Minimization first."}, {"id": "docs_nodejs_pages_phase_10_observability_04_what_to_log_access_vs_app_logs", "label": "Access logs vs app logs", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access log: method, path, status, duration, request id. App log: domain events and failures. Duplicating every request as info doubles cost."}, {"id": "docs_nodejs_pages_phase_10_observability_04_what_to_log_volume_discipline", "label": "Log volume discipline", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not log every SQL query, full bodies, debug fleet-wide, or inside tight loops. Sample high-volume success; always keep errors."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_04_what_to_log_never_log_secrets", "target": "docs_nodejs_pages_phase_10_observability_04_what_to_log_what_to_log", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_04_what_to_log_data_minimization", "target": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_redact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_04_what_to_log_data_minimization", "target": "docs_nodejs_pages_phase_10_observability_04_what_to_log_never_log_secrets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_04_what_to_log_access_vs_app_logs", "target": "docs_nodejs_pages_phase_10_observability_04_what_to_log_what_to_log", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_04_what_to_log_volume_discipline", "target": "docs_nodejs_pages_phase_10_observability_01_structured_logging_log_levels", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-10-observability/04-what-to-log.md", "source_location": null, "weight": 1.0}], "hyperedges": []}