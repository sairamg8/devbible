{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_statement_timeout", "label": "statement_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side cancel. Raises 57014; connection stays usable. The only timeout that stops the database doing work. Prefer ALTER ROLE."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_query_timeout", "label": "query_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side: pg rejects while the server keeps executing. Use with statement_timeout set slightly lower. release(true) afterwards."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_in_transaction_session_timeout", "label": "idle_in_transaction_session_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kills a session that is open but idle. Protects VACUUM xmin and locks. Arrives as a Client error event, not a rejected query."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_connection_timeout_millis", "label": "connectionTimeoutMillis", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Give up acquiring a connection, including waiting for a free pooled one. Fires when a leak saturates the pool."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_timeout_millis", "label": "idleTimeoutMillis", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Close unused pooled connections. Set below intermediary idle TCP drops to avoid connection terminated unexpectedly."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_lock_timeout", "label": "lock_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail fast when waiting on a lock. Use before ALTER TABLE so ACCESS EXCLUSIVE does not queue the whole site."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_pool_on_error", "label": "pool.on error handler", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FATAL with no in-flight query emits an unhandled error event and kills Node. Mandatory for idle-in-transaction termination."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_query_timeout", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_release_true", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_query_timeout", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_statement_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_in_transaction_session_timeout", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_pool_on_error", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_connection_timeout_millis", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_lock_timeout", "target": "docs_postgresql_pages_phase_8_schema_from_node_06_tx_migration_set_local_lock_timeout", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "pg_timeout_stack", "label": "Five timeouts that apply to a pg query", "nodes": ["docs_postgresql_pages_phase_7_pg_driver_11_timeouts_statement_timeout", "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_query_timeout", "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_in_transaction_session_timeout", "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_connection_timeout_millis", "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_idle_timeout_millis", "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_lock_timeout"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/11-timeouts.md"}]}