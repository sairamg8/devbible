{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries", "label": "Subqueries", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_subquery", "label": "Scalar subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must return at most one row and one column; more than one row is an error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_correlated_subquery", "label": "Correlated subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refers to the outer row and is conceptually re-evaluated per outer row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_not_in_vs_not_exists", "label": "NOT IN vs NOT EXISTS", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT IN is UNKNOWN when the set contains NULL, so the anti-join silently returns no rows; NOT EXISTS does not have that trap."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_subquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-