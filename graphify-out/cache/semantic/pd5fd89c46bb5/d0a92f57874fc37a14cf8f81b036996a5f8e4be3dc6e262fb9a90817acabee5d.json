{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "label": "Password storage", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_slow_password_hash", "label": "A password hash must be slow", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHA-256 is excellent at being fast, which is the attacker's advantage. Measured ~344k SHA-256/s vs ~11 scrypt hashes at N=2^15 on one core."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_argon2id", "label": "argon2id", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Password Hashing Competition winner. Memory-hard and side-channel resistant. First choice for a new project; needs the argon2 package."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_scrypt", "label": "scrypt", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory-hard, built into node:crypto. Store scheme$N$r$p$salt$hash. Uses ~128*N*r bytes per concurrent hash; never scryptSync on a request path."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_bcrypt", "label": "bcrypt", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptable and ubiquitous. Silently truncates input past 72 bytes."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_salt", "label": "Per-password salt", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 random bytes from a CSPRNG, stored next to the hash. Not secret. Makes one precomputed table useless and identical passwords hash differently."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_rehash_at_login", "label": "Rehash at login", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameters live in the stored string so cost can rise when you have the plaintext. Bulk recomputation is impossible \u2014 that is the point. Hash on unknown-email too."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_timing_safe_equal", "label": "timingSafeEqual for secrets", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "=== leaks how much of the value matched through timing. Guard length first \u2014 timingSafeEqual throws on mismatched buffers."}, {"id": "docs_nodejs_pages_phase_8_security_01_password_storage_thread_pool_login_capacity", "label": "libuv thread-pool login capacity", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default four threads. At N=2^15 four hashes take ~166 ms like one, then throughput flattens at about 23 logins/s per process."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_01_password_storage_slow_password_hash", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_argon2id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_scrypt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_bcrypt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_salt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_rehash_at_login", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_scrypt", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_timing_safe_equal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_scrypt", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_thread_pool_login_capacity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_argon2id", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_scrypt", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_01_password_storage_password_storage", "target": "docs_nodejs_pages_phase_8_security_05_session_management_rotation_on_privilege", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/01-password-storage.md", "source_location": null, "weight": 1.0}], "hyperedges": []}