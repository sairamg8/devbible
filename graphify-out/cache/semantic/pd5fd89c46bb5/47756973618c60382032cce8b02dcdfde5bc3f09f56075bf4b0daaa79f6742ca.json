{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_12_long_transactions", "label": "Long-running transactions and the xmin horizon", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/12-long-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_12_long_transactions_xmin_horizon", "label": "xmin horizon", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/12-long-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VACUUM may only remove versions no running transaction could need. The oldest snapshot pins cleanup for every table. With a blocker, 0 of 100000 dead rows removed and the file grew 27 MB \u2192 40 MB."}, {"id": "docs_postgresql_pages_phase_11_mvcc_12_long_transactions_idle_rc_readonly", "label": "Idle READ COMMITTED read-only does not block VACUUM", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/12-long-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Between statements a READ COMMITTED session holds no snapshot. All 100000 dead rows were still removed. Contradicts the common any-idle-in-transaction-stalls-cleanup advice."}, {"id": "docs_postgresql_pages_phase_11_mvcc_12_long_transactions_horizon_pinners", "label": "Transactions that pin the horizon", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/12-long-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REPEATABLE READ/SERIALIZABLE even idle (snapshot lives); any writer (backend_xid); any still-executing statement including a long SELECT."}, {"id": "docs_postgresql_pages_phase_11_mvcc_12_long_transactions_external_pinners", "label": "R