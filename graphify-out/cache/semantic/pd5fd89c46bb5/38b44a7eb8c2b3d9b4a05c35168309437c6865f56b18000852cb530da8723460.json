{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_page", "label": "Stability, mutation and toSorted", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_inplace_mutation", "label": "sort mutates and returns the same array", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const sorted = arr.sort() is the same reference, so change detection sees no new identity and shared callers are reordered."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_tosorted", "label": "Array.prototype.toSorted", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES2023 non-mutating counterpart: returns a shallow-copied sorted array. [...arr].sort() is the portable form."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_es2019_stability", "label": "ES2019 sort stability", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equal elements keep original relative order since ES2019. Earlier engines varied by array length, which is why old code carries index tiebreaks."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_twopass_multicolumn", "label": "Two-pass multi-column sort", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sort secondary first then primary; stability preserves the secondary inside each primary group. Use the || chain for a one-shot sort."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_undefined_holes_end", "label": "undefined and holes sort last", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparator is never called for them. Missing properties on objects still reach it. Map to a sentinel to put missing values first."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_nonmutating_family", "label": "ES2023 non-mutating array family", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "toSorted, toReversed, toSpliced and with leave the original alone and produce dense arrays."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_02_stability_and_mutation_reverse", "label": "Array.prototype.reverse", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/02-stability-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like sort, reverse mutates in place and returns the same reference."}], "edges": [{"source": "docs_javascript_pages_phase_5_built