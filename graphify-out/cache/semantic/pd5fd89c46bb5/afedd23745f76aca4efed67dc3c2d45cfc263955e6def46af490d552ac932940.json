{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_push_pop", "label": "Array push and pop", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Back-of-array adders return the new length; removers return the element. Do not re-index the rest of the array. Non-mutating twins: [...arr, x] and arr.slice(0, -1)."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_shift_unshift", "label": "Array shift and unshift", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Front operations re-index the whole array. Draining a large queue with shift() is quadratic."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice", "label": "Array splice and toSpliced", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove, insert, replace. Omitted deleteCount deletes to the end \u2014 splice(2) on ten elements drops eight. Beats delete (no hole). Never splice in a forward loop. toSpliced is the non-mutating twin."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_push_pop", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_shift_unshift", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_existence_checks_and_delete_undefined_holes_and_brand_checks_array_holes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_adding_and_removing_splice", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_deep_copy_what_shallow_means_shallow_copy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/adding-and-removing.html", "source_location": null, "weight": 1.0}], "hyperedges": []}