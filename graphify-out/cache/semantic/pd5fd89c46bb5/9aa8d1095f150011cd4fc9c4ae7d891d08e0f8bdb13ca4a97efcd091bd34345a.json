{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_list_endpoint_page", "label": "list with filtering, sorting and pagination", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/list-endpoint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters are parameters, sort is an allowlist, pagination is two more parameters plus a tiebreaker. Wrong combination duplicates rows with no error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_list_endpoint_assembled_query", "label": "Assembled list query", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/list-endpoint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "buildWhere + orderClause + LIMIT/OFFSET as last parameters. Clamp limit. Number() junk input; uncoerced 'abc' is 22P02."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_list_endpoint_tiebreaker", "label": "Unique ORDER BY tiebreaker", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/list-endpoint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY grp over 30k rows: 54 distinct / 46 repeats paging 100. Append , id. Instability is between offsets, so repeating page 1 does not catch it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_list_endpoint_offset_cost", "label": "OFFSET is the wrong default", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/list-endpoint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET n produces and discards n rows. Concurrent inserts shift the window. Keyset for infinite scroll/public APIs; OFFSET f