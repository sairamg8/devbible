{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_the_eight_types_page", "label": "01 \u00b7 The eight types", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/the-eight-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_the_eight_types_eight_types", "label": "Eight JavaScript types", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/the-eight-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven primitives plus object. Arrays, dates, regexes, Map and classes are objects. Functions are objects; typeof reports 'function' as a convenience."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_the_eight_types_typeof_null", "label": "typeof null === 'object' bug", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/the-eight-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historic tag-bit bug: objects used tag 000 and null was the all-zero pointer. Fix rejected because existing code depends on it. Always && v !== null."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_the_eight_types_array_isarray", "label": "Array.isArray", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/the-eight-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instanceof Array fails across realms (iframe, vm). Array.isArray works regardless."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_the_eight_ty