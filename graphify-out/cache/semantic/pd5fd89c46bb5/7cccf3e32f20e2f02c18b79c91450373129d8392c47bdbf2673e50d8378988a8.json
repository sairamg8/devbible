{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox_dual_write", "label": "Dual-write problem", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A row and a queue message cannot commit together. Reversing order or try/catch leaves a new window."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox_outbox", "label": "Transactional outbox", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insert the event in the same database transaction as the business row. One commit, no divergence."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox_relay", "label": "Outbox relay", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark published_at then enqueue. Crash republishes. At-least-once plus jobId outbox:${id}."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox_same_db_queue", "label": "Postgres jobs table is the outbox", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the queue is the same database, writing the jobs row inside the transaction needs no relay."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox_outbox", "ta