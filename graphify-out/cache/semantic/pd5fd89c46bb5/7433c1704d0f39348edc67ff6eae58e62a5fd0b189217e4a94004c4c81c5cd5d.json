{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_declaration_merging", "label": "Declaration merging", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two interfaces with the same name combine. Type aliases error TS2300 Duplicate identifier. Merging is how you augment Express.Request and ProcessEnv."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_type_alias", "label": "type alias", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only aliases can be unions, tuples, primitives, mapped, conditional, and template literal types. Discriminated unions force a large share of types to be aliases."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_interface", "label": "interface", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always an object shape. Needed when something must be augmentable. extends checks compatibility and reports TS2430 on conflict."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_extends_vs_intersection", "label": "extends vs intersection on conflict", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "interface extends reports the conflict at the declaration. An intersection silently produces string & number, i.e. never, discovered at the call site."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_error_folklore", "label": "Interface error-message folklore", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured: a plain object alias and an equivalent interface produced identical TS2741 text, each naming its type. Aliases of intersections or mapped types can still expand."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_interface", "target": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_declaration_merging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_type_alias", "target": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_interface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_type_alias", "target": "docs_typescript_pages_phase_1_type_vocabulary_05_union_types_union", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/07-type-vs-interface.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_extends_vs_intersection", "target": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_interface", "relation": "rationale_for", "confidence":