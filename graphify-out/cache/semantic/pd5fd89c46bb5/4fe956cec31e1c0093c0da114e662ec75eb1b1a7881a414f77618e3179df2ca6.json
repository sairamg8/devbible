{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_gin_fts_index", "label": "GIN index on tsvector", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200002 products: 1165ms seq scan \u2192 17.36ms Bitmap Heap Scan (~66\u00d7). Query expression must match the indexed expression exactly."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_immutable_to_tsvector", "label": "IMMUTABLE to_tsvector trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-arg to_tsvector(body) reads session default_text_search_config so it is not IMMUTABLE \u2014 42P17. Name the config."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_generated_tsvector_column", "label": "Generated tsvector column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same speed as an expression index (17.87 vs 17.36ms). Chosen to combine columns, carry weights, and stop expression-mismatch misses. coalesce required."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_setweight", "label": "setweight A\u2013D", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default rank weights {0.1,0.2,0.4,1.0} for D\u2013A. Title match counts 5\u00d7 a body match. Weights do nothing until ranking."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_ts_rank", "label": "ts_rank", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not indexable. Index finds matches; rank runs on each. Narrow the match rather than optimise the rank."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_ts_rank_cd", "label": "ts_rank_cd", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also accounts for cover density. Better for multi-word queries. Not bounded 0\u20131."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_ts_headline", "label": "ts_headline", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-reads original text so it cannot use the index. Apply after LIMIT, never before."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_fts_typo_boundary", "label": "Full-text cannot find typos", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stemming normalises grammar, not misspellings. router against a document saying routr \u2192 0 rows. That is pg_trgm's job."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_gin_fts_index", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_immutable_to_tsvector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_generated_tsvector_column", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_gin_fts_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_generated_tsvector_column", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_setweight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-ranking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_setweight", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_full_text_indexing_and_ranking_ts_rank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/full-text/indexing-and-r