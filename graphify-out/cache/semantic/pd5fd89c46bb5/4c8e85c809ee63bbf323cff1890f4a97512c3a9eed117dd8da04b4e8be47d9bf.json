{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_typescript_natively", "label": "TypeScript without a build step", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "label": "Node type stripping", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default since v23.6.0, Stability 2 as of v24.12.0. Replaces type annotations with whitespace so stack traces stay correct. Never type-checks."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_erasable_syntax", "label": "erasable TypeScript syntax", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Annotations, interface, type, generics, import type erase cleanly. enum, runtime namespace, parameter properties must generate JS and throw ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX in strip-only mode."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_tsc_noemit", "label": "tsc --noEmit", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native .ts execution removes the build, not the check. Dropping tsc --noEmit from CI silently switches to decorative annotations."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_node_modules_strip_block", "label": "ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node refuses to strip types inside node_modules so published packages must ship JS plus .d.ts. Bounds startup cost."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_ts_import_specifiers", "label": "TypeScript import specifiers", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running .ts directly requires importing ./helper.ts. The tsc convention of importing ./helper.js assumes you compile first. Mixing them fails under one of the two commands."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_typescript_natively", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_erasable_syntax", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_tsc_noemit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_node_modules_strip_block", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_typescript_natively", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_ts_import_specifiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_node_modules_strip_block", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_dual_package", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/typescript-natively.html", "source_location": null, "weight": 1.0}], "hyperedges": []}