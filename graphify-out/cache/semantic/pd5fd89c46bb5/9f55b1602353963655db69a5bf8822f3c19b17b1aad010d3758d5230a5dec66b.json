{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_pino_in_practice_pino_in_practice", "label": "pino in practice", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/pino-in-practice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_pino_in_practice_child_logger", "label": "pino child logger", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/pino-in-practice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bind reqId/orderId once so every subsequent line carries them. One child per request. base holds process-lifetime facts; children hold per-request facts."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_pino_in_practice_redact", "label": "pino redact", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/pino-in-practice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strips matching keys before write. Defense in depth, not a substitute for not putting secrets on the object."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_pino_in_practice_err_serializer", "label": "pino err serializer", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/pino-in-practice.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "log.error({err}, msg) with stdSerializers.err preserves type, message and stack. log.error(err) often serializes as an empty object."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_pino_in_practice_pino_pretty", "label": "pino-pretty", "file_type": "concept", "source_file": "build-cs