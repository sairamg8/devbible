{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_splice", "label": "Array.prototype.splice", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes, inserts, and replaces in place. Returns the removed elements as an array, not the modified array."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_omitted_deletecount", "label": "Omitted splice deleteCount deletes to the end", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "splice(2) truncates from index 2. splice(2,0) inserts without removing. Most damaging splice mistake."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_splice_vs_delete", "label": "splice vs delete on arrays", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "delete leaves a hole and length unchanged. splice removes the element, closes the gap, decrements length."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_splice_forward_loop", "label": "Never splice inside a forward loop", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing at i shifts later elements down, so i++ skips the next. Iterate backwards, or filter (the default)."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_tospliced", "label": "Array.prototype.toSpliced", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-mutating counterpart: same arguments, returns the new array. Produces a dense array; splice preserves sparseness."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_splice_indexof_guard", "label": "indexOf + splice(-1) trap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "indexOf miss is -1; splice(-1,1) removes the last element. Guard with i !== -1, or use filter."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_page", "label": "02.2 \u00b7 splice", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_page", "target": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_splice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/02-splice.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_page", "target": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_02_splice_omitted_delete