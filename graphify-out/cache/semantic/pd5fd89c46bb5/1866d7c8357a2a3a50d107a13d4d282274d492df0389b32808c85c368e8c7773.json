{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "label": "CPU-bound work", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Busy compute on the single JS thread. While it runs, no request, timer, or health check is handled."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_chunking_setimmediate", "label": "Chunking with setImmediate", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split work into ~10\u201350ms pieces and await setImmediate so the loop can drain I/O. Bounds latency, not throughput."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_worker_threads", "label": "worker_threads", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real parallelism on another thread. Spawn is expensive; use a pool (piscina). Data is structured-cloned unless transferred."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_libuv_thread_pool", "label": "libuv thread pool crypto APIs", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "crypto.pbkdf2, scrypt, and async bcrypt run off the loop; *Sync variants block it. Cheapest password-hashing fix."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_async_does_not_unyield", "label": "async does not stop CPU from blocking", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "async changes the return value, not whether the body blocks. There is no await that yields inside a tight loop."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_async_does_not_unyield", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_chunking_setimmediate", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_worker_threads", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_libuv_thread_pool", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_work_cpu_bound_work", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/cpu-bound-work.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_cpu_bound_w