{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "label": "Async testing done right", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runner ends when the test function settles. A missing await moves assertions past that point. Corrects the 'passes silently' folklore on Node 24.19.0."}, {"id": "docs_nodejs_pages_phase_9_testing_06_async_testing_forgotten_await", "label": "Forgotten await misattribution", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test prints \u2714; file prints \u2716 and exit 1 with 'asynchronous activity after the test ended'. A .catch() swallows the evidence and CI goes green."}, {"id": "docs_nodejs_pages_phase_9_testing_06_async_testing_assert_rejects", "label": "assert.rejects shapes", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Await rejects, return the promise, or await fn().catch(e => e). No default timeout \u2014 set --test-timeout in CI. Prefer allSettled so siblings do not outlive the test."}, {"id": "docs_nodejs_pages_phase_9_testing_06_async_testing_try_catch_rejection_trap", "label": "try/catch rejection test trap", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the code stops throwing, catch never runs and the test passes. assert.rejects reports Missing expected rejection."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "target": "docs_nodejs_pages_phase_9_testing_06_async_testing_forgotten_await", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "target": "docs_nodejs_pages_phase_9_testing_06_async_testing_assert_rejects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "target": "docs_nodejs_pages_phase_9_testing_06_async_testing_try_catch_rejection_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_try_catch_rejection_trap", "target": "docs_nodejs_pages_phase_9_testing_06_async_testing_assert_rejects", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_assert_rejects", "target": "docs_nodejs_pages_phase_9_testing_02_node_assert_throws_matcher", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "target": "docs_nodejs_pages_phase_9_testing_05_api_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "target": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/06-async-testing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}