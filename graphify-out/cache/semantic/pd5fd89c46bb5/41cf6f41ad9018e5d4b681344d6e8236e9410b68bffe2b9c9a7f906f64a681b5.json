{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_simple_query_protocol", "label": "Simple query protocol", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No values argument: the string is a script. Several statements run and query() returns an array of Result objects."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_extended_query_protocol", "label": "Extended query protocol", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A values argument permits exactly one statement. Extra commands raise 42601, which is stacked-statement injection protection."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_empty_params_array", "label": "Empty params array is not parameterized", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg switches protocols on present-and-non-empty values. query(sql, []) still uses the simple protocol."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_implicit_transaction", "label": "Multi-statement implicit transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A simple-query string is one implicit transaction. A later failure rolls back earlier successes. Feature for migration files."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_one_statement_per_call", "label": "One statement per call", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default everywhere except schema files. Buys parameters, attributable errors, and a consistent Result. Use a CTE, not concatenated statements."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_extended_query_protocol", "target": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_simple_query_protocol", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_empty_params_array", "target": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_simple_query_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_implicit_transaction", "target": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_simple_query_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_implicit_transaction", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_with_transaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/12-one-statement.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_12_one_statement_