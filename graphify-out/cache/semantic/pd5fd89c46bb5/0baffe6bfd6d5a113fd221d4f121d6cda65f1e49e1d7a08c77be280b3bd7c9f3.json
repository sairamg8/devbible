{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_always_returns_promise", "label": "async always returns a promise", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No path out of an async function is not a promise. A return fulfils, a throw rejects, a returned promise is adopted."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_never_throws_sync", "label": "async never throws synchronously", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A throw anywhere, including before the first await, becomes a rejection. try { asyncFn() } without await catches nothing."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_identity_vs_resolve", "label": "async return vs Promise.resolve identity", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise.resolve(p) returns the same native promise. An async function must create its own and resolve it with p, so references differ."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_desugars_to_then", "label": "async/await desugars to then", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await 1 becomes Promise.resolve(1).then(continuation). Semantics equal a chain; the gain is try/catch, loops, if/else, and locals in one scope."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_always_returns_promise", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_never_throws_sync", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_always_returns_promise", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_identity_vs_resolve", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_desugars_to_then", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_always_returns_promise", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_desugars_to_then", "target": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_promise_chaining", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/always-a-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css