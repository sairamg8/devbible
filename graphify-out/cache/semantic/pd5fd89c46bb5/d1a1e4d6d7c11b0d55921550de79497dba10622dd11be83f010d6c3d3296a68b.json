{"nodes": [{"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_overview", "label": "Removing dependencies legitimately", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_dependencies_match_code", "label": "Dependencies should match the code", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You cannot choose Effect dependencies. To remove one, prove to the linter it is unnecessary by editing the surrounding code."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_eight_legitimate_moves", "label": "Eight legitimate dependency-removal moves", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move static values outside the component, build them inside the effect, depend on primitives, call during render, updater form, useEffectEvent, event handler, or split effects."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_illegitimate_fixes", "label": "Illegitimate dependency fixes", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suppressing the linter, a counter that always shows 1, and refs used to hide a dependency produce confusing bugs."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_useeffectevent", "label": "u