{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_bigint", "label": "BigInt", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arbitrary-precision integers because Number cannot represent every integer past MAX_SAFE_INTEGER. Convert huge values from strings."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_no_mix_number", "label": "Cannot mix BigInt and Number", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1n + 1 throws TypeError. Comparison is exempt: 1n == 1 is true, 1n === 1 is false. Division truncates: 5n / 2n is 2n."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_json_throws", "label": "JSON.stringify throws on BigInt", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON has no BigInt type. Use a replacer to string. Do not patch BigInt.prototype.toJSON."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_ids_as_strings", "label": "Identifiers should be strings", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres bigint keys and snowflake IDs are never added or averaged. Send them as strings and skip BigInt serialisation entirely."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_bigint", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_no_mix_number", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_json_throws", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_json_throws", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_transpilation_polyfills_ponyfill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_ids_as_strings", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_bigint", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_bigint_no_mix_number", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_equality_strict_vs_loose", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/bigint.html", "source_location": null, "weig