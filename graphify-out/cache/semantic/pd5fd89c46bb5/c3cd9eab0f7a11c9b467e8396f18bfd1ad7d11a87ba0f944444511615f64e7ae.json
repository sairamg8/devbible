{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_02_patterns_and_composition_ilike_wildcard_escape", "label": "Escape ILIKE pattern metacharacters", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/02-patterns-and-composition.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user % is not injection but forces a full scan. Escape \\, %, _ then wrap; declare ESCAPE '\\'. Leading-wildcard ILIKE needs pg_trgm."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_02_patterns_and_composition_listitems_composition", "label": "listItems composes WHERE sort LIMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/02-patterns-and-composition.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "buildList supplies WHERE params; orderClause is vetted literal text; limit/offset are pushed last so numbering stays intact."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_02_patterns_and_composition_identifiers_not_params", "label": "Sorting cannot use parameter machinery", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/02-patterns-and-composition.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY needs an identifier. ORDER BY $1 silently sorts by a constant. Identifiers need an allowlist of authored SQL."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_02_patterns_and_composition_hand_build_vs_query_builder", "label": "Hand-built predicates versus a query builder", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/02-patterns-and-composition.md", "source_locati