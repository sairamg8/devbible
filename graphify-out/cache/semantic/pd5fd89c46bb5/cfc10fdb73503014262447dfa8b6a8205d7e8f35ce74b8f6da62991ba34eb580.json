{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_zero_downtime_ddl_page", "label": "Zero-downtime schema changes", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/zero-downtime-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A waiting ACCESS EXCLUSIVE lock blocks everything behind it. Schema change and code deploy are never simultaneous; expand-and-contract."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_zero_downtime_ddl_access_exclusive_queue", "label": "Waiting ACCESS EXCLUSIVE lock queue", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/zero-downtime-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 5 ms ALTER can cause a 30 s outage because new queries do not jump the queue behind a waiting ACCESS EXCLUSIVE lock."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_zero_downtime_ddl_lock_timeout", "label": "lock_timeout for DDL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/zero-downtime-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_zero_downtime_ddl_expand_contract", "label": "Expand and contract migrations", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/zero-downtime-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_zero_downtime_ddl_not_valid", "label": "ADD CONSTRAINT \u2026 NOT VALID then VALIDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/zero-downtime-ddl.html", "source_location": null, "source_url": null, "ca