{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_create_extension", "label": "CREATE EXTENSION", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/extensions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs a package of types/functions per database. Available means files on disk; installed means CREATE EXTENSION ran here."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_per_database", "label": "Extensions are per database", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/extensions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE DATABASE does not copy extensions. digest() worked in one DB and raised 42883 in a new one on the same server."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_pg_stat_statements", "label": "pg_stat_statements", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/extensions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First extension to enable. Also needs shared_preload_libraries and a restart; CREATE EXTENSION alone returns nothing."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_per_database", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_create_extension", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/extensions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_extensions_pg_stat_statements", "target":