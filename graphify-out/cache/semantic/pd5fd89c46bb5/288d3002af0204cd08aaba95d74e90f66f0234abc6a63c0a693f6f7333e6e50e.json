{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_not", "label": ":not() negation", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts lists and complex selectors. Specificity is the most specific argument. :not(.a, .b) means neither, not 'not a or not b'. Neutralise with :not(:where(#id))."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_empty", "label": ":empty whitespace trap", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires no child nodes at all. A space or newline is a text node so pretty-printed HTML rarely matches. Comments do not count. Prefer :not(:has(*)) when it fails."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_root", "label": ":root for global custom properties", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches html in HTML documents but at class specificity 0,1,0. Top of the inheritance chain; properties on body never reach anything above body."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_lang_dir", "label": ":lang() and :dir()", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":lang() matches inherited language including subtags. :dir() matches computed direction including dir=auto, unlike [dir=rtl] which only sees an explicit attribute."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_not", "target": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_empty", "target": "build_css_p2_docs_css_pages_phase_1_selectors_has_parent_selector", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_root", "target": "build_css_p2_docs_css_pages_phase_1_selectors_scope_donut_scoping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_lang_dir", "target": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_operators", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/not-empty-root.html", "source_location": null, "weight": 1.0}], "hyperedges": []}