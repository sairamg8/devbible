{"nodes": [{"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_page", "label": "What can be rendered", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_renderable_types", "label": "Renderable child types", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React renders strings, numbers, bigints, elements, and iterables of those (arrays, Set, Map, generators)."}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_silent_no_render", "label": "Silent no-render values", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null, undefined, true, false, symbols and functions render nothing. Functions warn in development only."}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_objects_not_valid_child", "label": "Objects are not valid as a React child", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain objects and Date throw. Production is Minified React error #31 with args[] naming the shape."}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_iterable_children", "label": "Iterables as children", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set renders. Map yields key/value pairs and is warned. A generator is consumed by render, so StrictMode blanks it on the second pass."}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_promise_suspends", "label": "Promise child suspends", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 unwraps a promise only under Suspense. Without a boundary the root withholds its commit \u2014 no DOM, no error."}, {"id": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_undefined_return_throws", "label": "Returning undefined throws", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing was returned from render. Return null to render nothing on purpose. Missing return or JSX after return is the usual cause."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_page", "target": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_renderable_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_page", "target": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_silent_no_render", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/03-what-can-be-rendered.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_page", "target": "docs_react_pages_phase_1_jsx_03_what_can_be_rendered_objects_not_valid_child", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f