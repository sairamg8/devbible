{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_over_keeps_the_rows", "label": "OVER keeps the rows", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same aggregate, same numbers, different row count. GROUP BY collapses; OVER (PARTITION BY) attaches the group value to every original row."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_partition_by", "label": "PARTITION BY is GROUP BY that does not collapse", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For each row PostgreSQL finds rows sharing the partition key, computes the aggregate, and attaches it to that row. OVER () is one partition of the whole result."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_running_total", "label": "Running total via ORDER BY in OVER", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY inside OVER implies RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, turning the aggregate cumulative. Inner ORDER BY changes values; outer ORDER BY only presentation."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_filter_before_over", "label": "FILTER before OVER", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) FILTER (WHERE \u2026) OVER (\u2026). Reverse order is a syntax error. FILTER attaches only to aggregates, not row_number or rank."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_over_keeps_the_rows", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_partition_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_partition_by", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_running_total", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_filter_before_over", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_partition_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_01_over_vs_group_by_over_keeps_the_rows", "target": "docs_postgresql_pages_phase_6_aggregation_07_ranking_readme_ranking_functions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/01-over-vs-group-by.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregati