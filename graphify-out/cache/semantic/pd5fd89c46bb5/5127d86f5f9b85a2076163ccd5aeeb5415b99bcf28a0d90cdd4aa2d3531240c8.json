{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_filter", "label": "FILTER (WHERE)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricts the rows one aggregate sees without restricting the query. One scan can answer paid/open/cancelled counts. Not pure CASE sugar: they disagree about the empty set."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_vs_case", "label": "FILTER vs CASE empty set", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum(x) FILTER (\u2026) returns NULL when nothing matches; sum(CASE \u2026 ELSE 0) returns 0. The empty-set NULL is inherited from ordinary aggregates."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_filter", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_vs_case", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_vs_case", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_filter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_filter", "target": "build_css_p2_docs_postgresql_pages_phase_6_a