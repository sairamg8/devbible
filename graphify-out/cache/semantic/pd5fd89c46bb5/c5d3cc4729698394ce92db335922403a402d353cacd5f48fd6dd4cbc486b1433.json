{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_process_per_connection", "label": "Process-per-connection model", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each client connection is a dedicated OS backend process. Isolation and simpler memory accounting cost startup time and RAM, so Node pools instead of opening a connection per request."}, {"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_backend_process", "label": "Backend process", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parses SQL, plans, executes, holds session state, and can crash without taking down other clients. Appears as backend_type client backend in pg_stat_activity."}, {"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_max_connections", "label": "max_connections", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-wide cap on concurrent backends. Measured default 100 on PostgreSQL 18.4 alpine. Exceeding it yields sorry, too many clients already."}, {"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_connection_pool", "label": "Node connection pool", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One global pg.Pool at module scope reuses backends. Two checkouts produced two client backends. pool.query borrows and returns a client; it does not start a new process each time."}, {"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_pgbouncer", "label": "PgBouncer", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External pooler that exists because process-per-connection is expensive. Taught in Phase 13, not Phase 0."}, {"id": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_pg_stat_activity", "label": "pg_stat_activity", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog view of backends and workers. Measured 18.4 types: autovacuum launcher, background writer, checkpointer, client backend, io worker, logical replication launcher, walwriter."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_process_per_connection", "target": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_backend_process", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_process_per_connection", "target": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_connection_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/02-client-server-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_pr