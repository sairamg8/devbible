{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_idempotency_keys_idempotency_key", "label": "Idempotency-Key", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-6-rest-surface/idempotency-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients retry POSTs. Without a key you double-charge. POST and some PATCH need keys; GET/PUT are already idempotent when implemented correctly."}, {"id": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_idempotency_keys_replay_store", "label": "Idempotency replay store", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-6-rest-surface/idempotency-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store key \u2192 response (status + body) under a TTL. Replay returns the same result without re-executing side effects."}, {"id": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_idempotency_keys_payload_hash_mismatch", "label": "Idempotency payload hash 409", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-6-rest-surface/idempotency-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same key, different body is a client bug or attack. Reject with 409 if payload hash mismatches stored request."}], "edges": [{"source": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_idempotency_keys_idempotency_key", "target": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_idempotency_keys_replay_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-6-rest-surface/idempotency-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_6_rest_surface_i