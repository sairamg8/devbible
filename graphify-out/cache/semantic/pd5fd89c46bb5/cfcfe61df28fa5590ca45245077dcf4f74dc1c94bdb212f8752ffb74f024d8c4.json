{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_session_timezone", "label": "Session TimeZone setting", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display and interpretation only, not storage. Changes timestamptz print, bare timestamp literals, current_date, date_trunc and ::date grouping."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_at_time_zone", "label": "AT TIME ZONE in the query", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes day-bucketing independent of the session. Two events at 21:00Z/23:30Z on 15 June group to 15 June in UTC and 16 June in Asia/Kolkata."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_set_config", "label": "set_config for bindable timezone", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET has no parameter slots (42601 at $1). set_config($1,$2,true) is the LOCAL form; interpolating a user zone is an injection hole."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_iana_names", "label": "IANA time zone names", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follow DST and historical rules. Abbreviations like IST are ambiguous; fixed offsets silently get DST wrong. Store the name, not an offset."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_pool_pin_utc", "label": "Pin pool timezone to UTC", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "options: '-c timezone=UTC'. Plain SET leaks across pooled release(); SET LOCAL is safe inside a transaction."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_session_timezone", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_timestamptz", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_at_time_zone", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_session_timezone", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_pool_pin_utc", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_session_timezone", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_set_config", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_session_timezone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_iana_names", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_at_time_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_time_zones_pool_pin_utc", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_set_local_never_set", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/time-zones.html", "source_location": null, "weight": 1.0}], "hyperedges": []}