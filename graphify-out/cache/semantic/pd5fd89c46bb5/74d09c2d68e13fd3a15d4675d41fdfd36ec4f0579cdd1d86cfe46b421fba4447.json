{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_the_three_states", "label": "The three promise states", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_promise", "label": "Promise", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An object representing eventual completion or failure. You attach callbacks to the returned object instead of passing them into a function."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_pending", "label": "Pending", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_fulfilled", "label": "Fulfilled", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_rejected", "label": "Rejected", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_settled", "label": "Settled", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_resolved", "label": "Resolved", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved describes the decision, not the outcome. resolve(anotherPromise) locks onto the inner promise immediately while leaving the outer pending."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_oneshot_state_machine", "label": "One-shot promise state machine", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The transition happens at most once and is irreversible. That is why a promise cannot model a stream of events."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_thenable", "label": "Thenable", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The language asks whether an object has a callable then, not whether it is a native Promise. An unrelated then field gets assimilated."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_internal_slots", "label": "Promise state is not readable", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No promise.state or promise.value. A synchronous isSettled() would reintroduce Zalgo."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_mdn_promise", "label": "MDN Promise", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_the_three_states", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_mdn_promise", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_promise", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_oneshot_state_machine", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_pending", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_fulfilled", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/the-three-states.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_pending", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises