{"nodes": [{"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_blocking_the_event_loop", "label": "Blocking the event loop", "file_type": "document", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_one_block_stalls_all", "label": "One slow function slows every request", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The users who suffer are not the ones who called the slow endpoint. They are everyone else."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_monitor_event_loop_delay", "label": "monitorEventLoopDelay", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values are in nanoseconds. Healthy web process: mean delay under a few milliseconds, p99 under ~50ms."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_sync_in_request_path", "label": "Sync suffix in a request path is a bug", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync is fine at startup \u2014 reading a config file before the server listens blocks nothing."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_four_fixes", "label": "Four fixes for a blocked loop", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the async version; chunk and yield with setImmediate; move to worker_threads; queue it and return 202."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_async_does_not_unblock", "label": "Wrapping blocking code in async does not unblock it", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "async only changes how the function returns a value. Unless you await something that genuinely yields, the code still runs to completion on the main thread."}, {"id": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_dont_block_docs", "label": "Don't block the event loop", "file_type": "document", "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "source_url": "https://nodejs.org/en/learn/asynchronous-work/dont-block-the-event-loop", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_blocking_the_event_loop", "target": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_one_block_stalls_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-blocking-the-event-loop.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_blocking_the_event_loop", "target": "docs_nodejs_pages_phase_0_runtime_model_03_blocking_the_event_loop_monitor_event_loop_delay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-0-runtime-model/03-bloc