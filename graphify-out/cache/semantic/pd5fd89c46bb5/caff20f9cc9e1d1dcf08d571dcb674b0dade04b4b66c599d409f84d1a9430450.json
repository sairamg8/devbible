{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_arity_never_enforced", "label": "Arity is never enforced", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Too few arguments become undefined; extras are ignored by the parameter list but still counted by arguments."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_rest_parameters", "label": "Rest parameters", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real array, empty rather than undefined when nothing extra is passed. Must be last; cannot have a default."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_arguments_object", "label": "arguments object", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array-like, no array methods, absent in arrows. Prefer rest in new code."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_sloppy_arguments_aliasing", "label": "Sloppy-mode arguments aliasing", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a simple sloppy parameter list, arguments[i] and the parameter share one slot. Strict, default, rest, or destructuring turns it off."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_nonsimple_parameter_list", "label": "Non-simple parameter list", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any default, rest, or destructured parameter. Disables aliasing, forbids a body 'use strict', and changes .length."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_destructured_parameter_default", "label": "Destructured parameter = {}", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x = 0 defaults a missing property; = {} defaults a missing object. Every nesting level needs its own default."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_positional_plus_options", "label": "Positional plus options object", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/parameters/rest-destructuring-arguments.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two or three required positionals, then a destructured options object. JavaScript will not check arity for you."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_rest_parameters", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_parameters_rest_destructuring_arguments_arguments_object", "relatio