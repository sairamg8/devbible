{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner", "label": "The app role should not own the schema", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_two_connection_strings", "label": "Two connection strings owner vs app", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations connect as owner; the service must not be able to read MIGRATION_DATABASE_URL. Two variables in one .env is the pattern without the protection."}, {"id": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_ddl_ownership", "label": "DDL is an ownership right", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No GRANT DROP or GRANT ALTER. App role with DML still gets 42501 on DROP TABLE. Does not protect rows; TRUNCATE is grantable and should be withheld."}, {"id": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_grant_usage", "label": "GRANT USAGE not CREATE on schema", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE is grantable; objects the app creates are then owned by the app and the boundary erodes."}, {"id": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_default_privileges", "label": "ALTER DEFAULT PRIVILEGES FOR ROLE owner", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops a manual grant on every new table. A hand-created table with a different owner never receives those defaults."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_two_connection_strings", "target": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_ddl_ownership", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_grant_usage", "target": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_ddl_ownership", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_default_privileges", "target": "docs_postgresql_pages_phase_13_ops_03_app_role_not_owner_two_connection_strings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/03-app-role-not-owner.md", "source_location": null, "weight": 1.0}], "hyperedges": []}