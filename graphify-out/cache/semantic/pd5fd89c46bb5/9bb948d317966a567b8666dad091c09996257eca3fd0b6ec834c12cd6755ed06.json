{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_19_inheritance_table_inheritance", "label": "Table inheritance", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predates declarative partitioning. Parent PK is not inherited: two child rows with id 1 accepted. Use essentially never for new work."}, {"id": "docs_postgresql_pages_phase_3_ddl_19_inheritance_pk_not_inherited", "label": "Primary keys are not inherited", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT NULL and CHECK inherit. PK, UNIQUE, and FK do not. A FK pointing at the parent misses child rows. SELECT on parent sees children."}, {"id": "docs_postgresql_pages_phase_3_ddl_19_inheritance_declarative_partitioning", "label": "Declarative partitioning", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces the key across partitions (duplicate 23505). No matching partition \u2192 23514. Worth it for detach-drop or partition-key pruning; not below tens of millions of rows."}, {"id": "docs_postgresql_pages_phase_3_ddl_19_inheritance_partition_key_in_unique", "label": "Unique constraint must include partition key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global uniqueness on id alone is not enforceable without checking every partition. Generate ids centrally and accept uniqueness on trust, or add the partition key."}, {"id": "docs_postgresql_pages_phase_3_ddl_19_inheritance_only_keyword", "label": "ONLY excludes children", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE FROM parent includes children unless ONLY. pg_inherits also backs partitioning; check relkind = 'p' for a partitioned parent."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_19_inheritance_table_inheritance", "target": "docs_postgresql_pages_phase_3_ddl_19_inheritance_pk_not_inherited", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_19_inheritance_declarative_partitioning", "target": "docs_postgresql_pages_phase_3_ddl_19_inheritance_table_inheritance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_19_inheritance_partition_key_in_unique", "target": "docs_postgresql_pages_phase_3_ddl_19_inheritance_declarative_partitioning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_19_inheritance_only_keyword", "target": "docs_postgresql_pages_phase_3_ddl_19_inheritance_table_inheritance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/19-inheritance.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_19_inheritance_pk_not_inherited", "target": "docs_postgresql