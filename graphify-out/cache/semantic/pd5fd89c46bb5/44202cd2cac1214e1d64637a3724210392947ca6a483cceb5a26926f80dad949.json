{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_self_join", "label": "Self join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ordinary join where both sides are the same table. Aliases are mandatory (42712 without them). One self join walks one hierarchy level."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_adjacency_list", "label": "Adjacency-list hierarchy", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FK pointing at the same table. Cheapest hierarchy to write (one UPDATE moves a subtree) and most expensive to read. Use LEFT JOIN so a NULL parent id does not drop the root."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_with_recursive", "label": "WITH RECURSIVE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor plus recursive term joined to the previous iteration until none. UNION ALL is almost always correct. A cycle loops forever; CYCLE (PG 14+) or a path array is the defence."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_cycle_detection", "label": "Recursive CTE cycle detection", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CYCLE id SET is_cycle USING path_arr on PostgreSQL 14+, or WHERE NOT e.id = ANY(c.path_arr). A depth cap plus statement_timeout limits damage but does not detect the cycle."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_recursive_term_restrictions", "label": "Recursive term restrictions", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "May reference the CTE once only; may not appear on the right of a LEFT JOIN, in a subquery, or under EXCEPT/INTERSECT; no aggregates or ORDER BY/LIMIT inside the recursive term."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_lag_beats_id_minus_one", "label": "lag over self-join on id-1", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lag() scans once and defines previous by ORDER BY. A self join on b.id = a.id - 1 breaks as soon as ids have gaps."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_page", "label": "Self joins page", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_page", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_self_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_self_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_adjacency_list", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_adjacency_list", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_null_extension_left_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_self_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_with_recursive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_with_recursive", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_cycle_detection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_recursive_term_restrictions", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_with_recursive", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_with_recursive", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union_all", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_self_join_lag_beats_id_minus_one", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_lead", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/self-join.html", "source_location": null, "weight": 1.0}], "hyperedges": []}