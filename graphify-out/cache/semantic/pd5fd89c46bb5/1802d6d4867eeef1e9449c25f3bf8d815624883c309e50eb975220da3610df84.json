{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_insert_named_insert_columns", "label": "Always name INSERT columns", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INSERT INTO t VALUES binds to current column order; adding a column silently rewires statements. Omit columns that have defaults. Explicit NULL overrides DEFAULT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_insert_insert_returning", "label": "INSERT RETURNING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only correct way to learn a generated id. A follow-up SELECT can see another transaction's row under concurrency."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_insert_insert_speed_ladder", "label": "INSERT speed ladder", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10k rows: per-row autocommit 19551 ms; one tx 2262 ms (8.6\u00d7); multi-row VALUES 148 ms; unnest 81 ms; COPY 243 ms. WAL flush per statement plus round trips dominate."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_insert_parameter_65535_limit", "label": "65535 bind-parameter ceiling", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/insert.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocol stores parameter count in 16 bits. 21845\u00d73 ok; 21846 \u2192 08P01 about parameter formats, not the limit. Chunk or unnest one array per column."}], "edges": [{"so