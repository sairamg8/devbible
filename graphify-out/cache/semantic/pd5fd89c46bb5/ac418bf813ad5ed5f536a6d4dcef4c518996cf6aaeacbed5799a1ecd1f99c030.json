{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_page", "label": "BEGIN, COMMIT, ROLLBACK from Node", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/begin-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_autocommit", "label": "Autocommit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/begin-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every unwrapped statement is its own transaction. Two pool.query calls get two xids."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_pool_query_begin_bug", "label": "pool.query BEGIN bug", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/begin-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN via pool.query works on an idle pool (same connection) and fails under load: UPDATE autocommits on another backend while ROLLBACK hits an empty transaction. Load-dependent."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_with_transaction", "label": "withTransaction helper", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/begin-commit.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pool.connect(), BEGIN on that client, COMMIT, ROLLBACK.catch in catch, release() in finally. Isolation goes on BEGIN itself (25001 if SET after first query). Nested BEGIN only warns 25001."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_be