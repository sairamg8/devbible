{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_mongoose", "label": "Mongoose schemas, models, middleware", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mongoose adds the schema MongoDB does not have. Every convenience has an edge where it does something you did not ask for."}, {"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_validators_skip_update", "label": "Validators skip on update", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "updateOne wrote a 40-character name past maxlength 30. Pass runValidators: true; they only see fields in the update."}, {"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_pre_save_hooks", "label": "Hooks are per-operation", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pre('save') does not fire for updates. Password hashing in pre-save plus updateOne writes plaintext."}, {"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_lean", "label": "Mongoose .lean()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain objects instead of hydrated documents. 5001 docs: 136 ms hydrated vs 57 ms lean. Lose save, virtuals, getters."}, {"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_autoindex", "label": "Mongoose autoIndex", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults true; every instance of every deploy issues createIndex. Turn off in production; create indexes in a migration."}, {"id": "docs_nodejs_pages_phase_6_data_access_09_mongoose_query_buffering", "label": "Mongoose query buffering", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queries issued before connect hang for bufferTimeoutMS (10s) instead of failing at boot. Await connect at startup."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_indexes_in_migrations", "target": "docs_nodejs_pages_phase_6_data_access_09_mongoose_autoindex", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "weight": 0.95}, {"source": "docs_nodejs_pages_phase_6_data_access_09_mongoose_mongoose", "target": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_from_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_09_mongoose_autoindex", "target": "docs_nodejs_pages_phase_6_data_access_11_migrations_migrations_as_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/09-mongoose.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_09_mongoose_lean", "target": "docs_nodejs_pages_phase_6_data_access_16_cursors_cursors_and_streaming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/node