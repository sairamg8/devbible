{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_page", "label": "The three flavors", "file_type": "document", "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every fs operation exists as promise, callback, and sync. Promise is the default after listen."}, {"id": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_three_fs_flavors", "label": "fs callback, sync, and promise flavors", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import from node:fs/promises by default; node:fs callbacks are error-first; *Sync blocks the whole process."}, {"id": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_sync_blocks_event_loop", "label": "Sync fs blocks the event loop", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200 readFileSync calls blocked a 1 ms timer for 86 ms with zero ticks; one thread owns JS until the syscall returns."}, {"id": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_sync_only_at_startup", "label": "Sync fs only at startup, CLI, workers, crash handlers", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before server.listen there is no concurrency to protect. After listen, request paths use fs/promises."}, {"id": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_hidden_sync_io", "label": "Hidden sync I/O", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require(), existsSync, template-engine loaders, and console.log to a file all do synchronous disk I/O."}], "edges": [{"source": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_page", "target": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_three_fs_flavors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_sync_blocks_event_loop", "target": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_three_fs_flavors", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_sync_only_at_startup", "target": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_three_fs_flavors", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_02_the_three_flavors_hidden_sync_io", "target": "docs_nodejs_pages_phase_4_filesystem_08_stat_and_existence_exists_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/02-the-three-flavors.md", "source_location": null, "weight": 1.0}], "hyperedges": []}