{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_pool_end", "label": "pool.end", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/13-pool-end.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for in-flight queries, closes every connection, permanently retires the pool. Second end() throws. Queries after end reject."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_graceful_shutdown_order", "label": "HTTP close then pool.end", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/13-pool-end.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "server.close first, drain in-flight requests, then pool.end. Reverse order turns every deploy into a burst of 500s."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_client_end", "label": "client.end vs release", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/13-pool-end.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "end() closes a standalone Client. A client from pool.connect() gets release(). end() on a pooled client is a bug."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_event_loop_keepalive", "label": "Module-scope pool keeps the event loop alive", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/13-pool-end.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An open socket keeps Node running. Tests hang after results; scripts never exit. await pool.end() in teardown or finally."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_13_pool_end_pool_end", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_statement_timeout", "rela