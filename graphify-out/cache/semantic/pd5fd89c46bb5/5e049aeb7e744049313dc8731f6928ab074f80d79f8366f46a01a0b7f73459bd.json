{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_value_vs_promise", "label": "Returning a value vs a promise", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_six_outcomes", "label": "Six then-handler outcomes", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_adoption", "label": "Promise adoption / flattening", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return a plain value and it is wrapped. Return a promise or thenable and it is adopted, never nested as Promise<Promise<T>>."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_forgotten_return", "label": "Forgotten return in then", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A handler that returns nothing fulfils immediately with undefined; the inner promise floats and its rejection is unhandled."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_async_function_adoption", "label": "async function adoption", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "return somePromise from an async function does not produce a nested promise. return await p and return p usually behave identically."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_six_outcomes", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_adoption", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_forgotten_return", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_six_outcomes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_adoption", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_the_three_states_thenable", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_async_function_adoption", "target": "build_css_p2_docs_javascript_pages_phase_7_async_promises_value_vs_promise_adoption", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/promises/value-vs-promise.html", "source_location": null, "weight": 1.