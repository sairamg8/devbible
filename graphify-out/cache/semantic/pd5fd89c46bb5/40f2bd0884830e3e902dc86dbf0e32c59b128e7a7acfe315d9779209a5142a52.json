{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_connection_string", "label": "connectionString", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of three config sources (URL, object, PG* env). Mixing URL with database/user looks like overrides and is not \u2014 the parsed string wins with no warning. Pool-level options (max, idleTimeoutMillis, ssl object) combine safely. Percent-encode passwords."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_sslmode_require", "label": "sslmode=require", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In pg 8.x treated as verify-full \u2014 encrypts AND verifies, stricter than libpq. pg 9.0 will adopt libpq semantics so connections that verify today will silently stop verifying. Write sslmode=verify-full now."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_sslmode_verify_full", "label": "sslmode=verify-full", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encrypt and verify certificate and hostname. What production should write explicitly. For a private CA pass ssl:{ca:...}; rejectUnauthorized:false is local-dev only."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_password_function", "label": "password as function", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated when a connection is opened, not per query. Measured called 1\u00d7 for 2 queries on 1 connection. Makes IAM/RDS tokens work. Keep idleTimeoutMillis below token TTL."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_options", "label": "connection options passthrough", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "options: '-c search_path=app,public -c statement_timeout=5000' applies on every connection the pool opens. SET through pool.query() lands on one arbitrary connection and is lost."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_connection_string", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_sslmode_require", "target": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_sslmode_verify_full", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_sslmode_require", "target": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_connection_string", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_password_function", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_options", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_03_connection_config_options", "target": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pool_connect", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/03-connection-config.md", "source_location": null, "weight": 1.0}], "hyperedges": []}