{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_memory_settings", "label": "The memory settings", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four settings account for most tuning; only one allocates the memory people think it does. Phase 0 shared_buffers benchmark was confounded and is not reused."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_shared_buffers", "label": "shared_buffers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocated once at startup (postmaster, restart). Default 128 MB. Dedicated server guidance ~25% of RAM because OS page cache is the second tier."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem", "label": "work_mem per sort or hash operation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worst case \u2248 work_mem \u00d7 operations \u00d7 concurrent queries. Raising globally is the classic OOM path. SET LOCAL or ALTER ROLE, never plain SET on a pool."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_effective_cache_size", "label": "effective_cache_size allocates nothing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planner hint for shared buffers plus OS page cache. Higher makes index scans look cheaper. Default 4 GB on a large server biases sequential scans."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_maintenance_work_mem", "label": "maintenance_work_mem", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One maintenance op per session \u2014 safer to raise than work_mem. Autovacuum multiplies it by worker count; decouple with autovacuum_work_mem."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_autovacuum_work_mem", "label": "autovacuum_work_mem", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps background vacuum so N workers cannot each claim the large maintenance_work_mem used for interactive index builds."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_hash_mem_multiplier", "label": "hash_mem_multiplier", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 2.0: hash nodes may use work_mem \u00d7 multiplier. Hashes degrade worse on spill than sorts."}, {"id": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem_vs_max_connections", "label": "max_connections forces work_mem down", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each backend can allocate work_mem several times. Higher max_connections lowers the safe work_mem. Strongest argument for a pooler."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_hash_mem_multiplier", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem_vs_max_connections", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_maintenance_work_mem", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_autovacuum_work_mem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_effective_cache_size", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_random_page_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_work_mem", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_temp_bytes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_10_config_keys_01_memory_shared_buffers", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_pg_settings_context", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/10-config-keys/01-memory.md", "source_location": null, "weight": 1.0}], "hyperedges": []}