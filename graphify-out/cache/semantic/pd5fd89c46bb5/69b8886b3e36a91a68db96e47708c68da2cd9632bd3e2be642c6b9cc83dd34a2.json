{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_path_join", "label": "path.join", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concatenates and normalises. An absolute later argument is treated as a relative segment, so join(root,'/etc/passwd') looks contained."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_path_resolve", "label": "path.resolve", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always absolute; restarts at any absolute argument. The right tool for validating user input against a root."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_path_posix", "label": "path.posix", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use for URL paths, S3 keys, tar entries, Docker and git paths \u2014 always forward slashes. Default path.join writes backslashes on Windows."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_import_meta_dirname", "label": "import.meta.dirname", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESM replacement for __dirname on Node 21.2+. Undefined for non-file: URLs; then use fileURLToPath(import.meta.url)."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_extname_last_only", "label": "path.extname last only", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/