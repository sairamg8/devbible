{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_unique_nulls_distinct", "label": "Unique column accepts unlimited NULLs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two NULLs are not equal under SQL three-valued logic. Measured: 3 NULLs inserted into a UNIQUE column. SQL-standard, not a PostgreSQL quirk."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_nulls_not_distinct", "label": "NULLS NOT DISTINCT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15+: NULLs compare as equal so only one is allowed (second \u2192 23505). Works on index and constraint forms; no sentinel COALESCE needed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_vs_index", "label": "Unique constraint vs unique index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same btree. FK can only target a constraint. Only an index can be partial, on an expression, or built CONCURRENTLY. Production: CONCURRENTLY then UNIQUE USING INDEX."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_partial_unique_index", "label": "Partial unique index for soft delete", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE among live rows: CREATE UNIQUE INDEX \u2026 (email) WHERE deleted_at IS NULL. Constraints cannot be partial, so tombstones would block re-registration."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_case_insensitive_unique", "label": "Case-insensitive uniqueness", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE (email) treats Alice@x.com and alice@x.com as different. Fix with unique index on lower(email) (queries must match the expression) or a non-deterministic ICU collation."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_only_correctness", "label": "Uniqueness only under concurrency via the constraint", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Application pre-check has a window between read and write. 20 workers produced 20 duplicates and no errors. Map 23505 to 409 via err.constraint."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_unique_nulls_distinct", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_nulls_not_distinct", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_vs_index", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_partial_unique_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_vs_index", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_case_insensitive_unique", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_only_correctness", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_vs_index", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_partial_unique_index", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_soft_delete_is_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_constraint_only_correctness", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_constraint_names_as_api", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/unique-nulls.html", "source_location": null, "weight": 1.0}], "hyperedges": []}