{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes", "label": "Indexing foreign key columns", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/18-fk-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes_referencing_column", "label": "Referencing-side FK index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/18-fk-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL indexes the referenced PK/UNIQUE side automatically and never the referencing column. Without that index every parent DELETE scans the child \u2014 33.2 ms vs 6.2 ms on 300000 children."}, {"id": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes_audit_query", "label": "FK-without-index audit query", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/18-fk-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_constraint contype=f vs a valid index whose leading columns match the FK columns. Composite counts if leftmost prefix and order match; indisvalid required."}, {"id": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes_on_delete_cascade", "label": "ON DELETE CASCADE needs child FK index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/18-fk-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes", "target": "docs_postgresql_pages_phase_10_indexes_18_fk_indexes_referencing_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/18-fk-indexes.md", "sour