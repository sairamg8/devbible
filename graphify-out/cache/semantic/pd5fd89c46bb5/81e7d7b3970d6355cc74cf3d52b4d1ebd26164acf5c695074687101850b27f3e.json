{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_12_typescript_natively_type_stripping", "label": "Type stripping", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/12-typescript-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node replaces type annotations with whitespace and runs the result. Enabled by default since v23.6.0; Stability 2 as of v24.12.0."}, {"id": "docs_nodejs_pages_phase_1_modules_12_typescript_natively_node_not_a_type_checker", "label": "Node is not a type checker", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/12-typescript-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native execution removes the build, not the check. Dropping tsc --noEmit means type errors reach production."}, {"id": "docs_nodejs_pages_phase_1_modules_12_typescript_natively_erasable_syntax", "label": "Erasable vs non-erasable syntax", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/12-typescript-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Annotations, interface, generics, import type erase cleanly. enum, runtime namespace, and parameter properties must generate JavaScript."}, {"id": "docs_nodejs_pages_phase_1_modules_12_typescript_natively_err_unsupported_typescript_syntax", "label": "ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/12-typescript-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thrown for TypeScript enum in strip-only mode. --experimental-transform-types works but drops the stability guarantee."}, {"id": "docs_nodejs_pages_phase_1_modules_12_typescript_natively_no_node_modules_stripping", 