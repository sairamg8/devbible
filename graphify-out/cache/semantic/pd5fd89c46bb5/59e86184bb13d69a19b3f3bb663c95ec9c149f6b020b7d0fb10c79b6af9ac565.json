{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_models_compared_schema_per_tenant", "label": "Schema-per-tenant", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/models-compared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right when isolation is contractual, schemas genuinely differ, or per-tenant restore is routine. Cost: N migrations, UNION reports, growing catalog, safety-critical search_path."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_models_compared_database_per_tenant", "label": "Database-per-tenant", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/models-compared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rare: tens of large tenants needing strict isolation and resource limits. Pooling multiplies; onboarding is provisioning; no cross-tenant SQL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_models_compared_tenancy_decision_order", "label": "Tenancy decision order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/models-compared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contractual isolation first, then tenant count (thousands force shared), then cross-tenant query frequency, then genuine schema variation. Default shared + RLS."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_models_compared_shared_to_separated", "label": "Shared \u2192 separated is reversible", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/models-compared.html", "source_location": null, "source_url": null, "captured_at": null, "author