{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_page", "label": "The event loop phases", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_event_loop_phases", "label": "Event loop phases", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One thread, six phases in fixed order: timers, pending, idle/prepare, poll, check, close."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_timers_phase", "label": "Timers phase", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs expired setTimeout/setInterval; delay is a minimum, not a promise."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_check_phase", "label": "Check phase", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs setImmediate; immediately after poll, so I/O callbacks see setImmediate before the next timers lap."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_close_callbacks", "label": "Close callbacks phase", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last phase of a tick \u2014 socket/server close events run after check even if destroy was called first."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_nexttick_and_microtasks", "label": "nextTick and microtasks are not phases", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drained between every phase and every individual callback, so phase order alone does not predict output."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_settimeout_vs_setimmediate_race", "label": "setTimeout(0) vs setImmediate race from main", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From the main module the order depends on startup vs timer threshold; inside an I/O callback setImmediate is first."}, {"id": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_unref_active_resources", "label": "process.getActiveResourcesInfo and unref", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The process exits when no phase has work and nothing waits on I/O; unref excludes a handle from that count."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_page", "target": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_event_loop_phases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/01-event-loop-phases.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_timers_phase", "target": "docs_nodejs_pages_phase_2_async_01_event_loop_phases_event_loop_phases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_