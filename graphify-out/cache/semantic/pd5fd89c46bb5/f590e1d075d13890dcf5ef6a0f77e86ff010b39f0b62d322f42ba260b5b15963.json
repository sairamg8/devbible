{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_12_migration_tools_migration_tools", "label": "Migration tools", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/12-migration-tools.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tool implements a tracking table. Choose on workflow assumption: you write SQL, or the tool derives it."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_12_migration_tools_node_pg_migrate", "label": "node-pg-migrate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/12-migration-tools.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL or JS files, you own the schema. Natural next step from the hand-written runner for raw SQL and pg."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_12_migration_tools_graphile_migrate", "label": "graphile-migrate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/12-migration-tools.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One idempotent current.sql re-run on every save, then committed as a numbered file. Fits functions, triggers, views, RLS; poor for incremental ALTER TABLE."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_12_migration_tools_prisma_migrate", "label": "Prisma Migrate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/12-migration-tools.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "schema.prisma is source of truth; migrations are generated by diff. Do not use without Prisma Client."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_12_migration_tools_drizzle_kit", "label": "drizzle-kit", "