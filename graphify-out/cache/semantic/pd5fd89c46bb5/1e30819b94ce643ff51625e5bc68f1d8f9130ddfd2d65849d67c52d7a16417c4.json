{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_from_node", "label": "MongoDB from Node", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The official driver is not a thin wrapper around Mongoose \u2014 it is the other way round."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongoclient_pool", "label": "MongoClient is the pool", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per process at module scope. Default maxPoolSize 100; one client per request opens unbounded connections."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_write_concern_majority", "label": "w=majority", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write acknowledged by a majority so it survives failover. Costs latency; single-node ack can vanish when the primary steps down."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_objectid_type_strict", "label": "ObjectId type-strict equality", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "findOne({_id: urlString}) returns null forever. Wrap with new ObjectId after ObjectId.isValid."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_updateone_vs_replaceone", "label": "updateOne vs replaceOne", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "updateOne applies operators to named fields. replaceOne substitutes the whole document, so omitted fields disappear."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_find_cursor", "label": "find() returns a cursor", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is sent until toArray() or iteration. 200000 docs: 486 MB RSS vs 143 MB iterating."}, {"id": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_indexes_in_migrations", "label": "Indexes belong in migrations", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createIndex at boot in every pod triggers expensive index builds N times during deploy."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_from_node", "target": "docs_nodejs_pages_phase_6_data_access_09_mongoose_mongoose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_from_node", "target": "docs_nodejs_pages_phase_6_data_access_16_cursors_cursors_and_streaming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/05-mongodb-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_fr