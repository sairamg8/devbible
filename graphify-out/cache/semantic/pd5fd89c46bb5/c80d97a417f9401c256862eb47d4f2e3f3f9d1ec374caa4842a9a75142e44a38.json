{"nodes": [{"id": "docs_react_syllabus_01_the_react_model_part", "label": "Part 1 \u2014 The React model", "file_type": "document", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_syllabus_01_the_react_model_render_reconcile_commit", "label": "Render, reconcile, commit", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render is pure and can be thrown away; commit touches the DOM and cannot be undone. Almost every React rule follows from this split."}, {"id": "docs_react_syllabus_01_the_react_model_fiber", "label": "Fiber", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit of work and linked tree that made the render phase interruptible (work loop, double buffering, alternate)."}, {"id": "docs_react_syllabus_01_the_react_model_strictmode", "label": "StrictMode", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double-renders components and double-mounts effects in development only. A bug detector; switching it off ships the bug."}, {"id": "docs_react_syllabus_01_the_react_model_state_as_snapshot", "label": "State is a snapshot", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The value in a given render is frozen for that render. This is the whole explanation for stale closures, and it is not a bug."}, {"id": "docs_react_syllabus_01_the_react_model_automatic_batching", "label": "Automatic batching", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple setState calls become one render, including inside promises, timeouts and native handlers since React 18; flushSync is the escape."}, {"id": "docs_react_syllabus_01_the_react_model_react_19", "label": "React 19 and 19.2 changes", "file_type": "concept", "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_react_syllabus_01_the_react_model_part", "target": "docs_react_syllabus_01_the_react_model_render_reconcile_commit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_01_the_react_model_fiber", "target": "docs_react_syllabus_01_the_react_model_render_reconcile_commit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_01_the_react_model_fiber", "target": "docs_react_syllabus_03_concurrent_and_server_concurrent_rendering", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/react/syllabus/01-the-react-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_01_the_react_model_render_reconcile_commit", "target": "docs_react_syllabus_03_concurrent_and_server_concurrent_rendering", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/01-the-react-model.md", "source_locatio