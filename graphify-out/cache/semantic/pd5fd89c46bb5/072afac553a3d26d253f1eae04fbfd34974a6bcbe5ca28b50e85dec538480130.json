{"nodes": [{"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_page", "label": "The middleware contract", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_signature", "label": "Middleware signature (req, res, next)", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(req, res, next) => void for normal middleware; four args for errors. An Express app is a series of middleware function calls."}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_three_legal_endings", "label": "Three legal middleware endings", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Respond, next(), or next(err). Returning without one of those is not an ending Express understands \u2014 the socket waits."}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_route_handlers_are_middleware", "label": "Route handlers are middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same contract with a method and path filter in front."}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_hanging_request", "label": "Hanging request", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If middleware does not end the cycle it must call next(); otherwise the request is left hanging. Audit if-arms and async paths."}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_return_next", "label": "return next() style", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "return next() only returns from your function; next is what continues the chain. return avoids running code after next by accident."}, {"id": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_using_middleware_guide", "label": "Express using-middleware guide", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_page", "target": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_signature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_page", "target": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_three_legal_endings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-2-middleware/01-middleware-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_signature", "target": "docs_expressjs_pages_phase_2_middleware_01_middleware_contract_three_legal_endings", "relation