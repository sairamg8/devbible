{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_rounding_round_once", "label": "Round money once at the end", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/arithmetic-and-rounding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounding at each step discards information that compounds. Carry full precision, round at the charging boundary, and store both inputs and rounded outputs."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_rounding_largest_remainder", "label": "Largest-remainder allocation", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/arithmetic-and-rounding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100/3 \u2192 33.33\u00d73 = 99.99. Floor each share, then give leftover pennies to largest remainders so parts sum exactly to the whole."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_rounding_store_fx_rate", "label": "Store FX rate with the transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/arithmetic-and-rounding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fx_rate numeric(18,8) and fx_rate_at timestamptz are part of the record. Converting at query time makes historical reports change."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_rounding_round_once", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_half_away_from_zero", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file