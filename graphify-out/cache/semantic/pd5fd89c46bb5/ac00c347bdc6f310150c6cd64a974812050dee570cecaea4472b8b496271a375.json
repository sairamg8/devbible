{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_the_three_flavors_three_flavors", "label": "Three fs flavors", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/the-three-flavors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise (default), callback (legacy), sync (startup only). Sync returns inline; promise on a microtask; callback in a later phase."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_the_three_flavors_sync_blocks_event_loop", "label": "Sync fs blocks the event loop", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/the-three-flavors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200 readFileSync blocked a 1 ms timer for 86 ms with zero ticks. One thread runs all JS; a sync syscall owns it."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_the_three_flavors_when_sync_is_ok", "label": "When sync fs is correct", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/the-three-flavors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before listen (config, certs), CLI/build scripts, a dedicated worker_thread, and crash handlers with no future event-loop turn."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_the_three_flavors_hidden_sync_io", "label": "Hidden sync I/O", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/the-three-flavors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require() inside a handler, existsSync, template engines loading with readFileSync, and console.log to a file are all sync."}], "edges": [{"source": "build_css_p2_