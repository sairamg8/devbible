{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_generated_always_as_identity", "label": "GENERATED ALWAYS AS IDENTITY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL-standard key. Refuses a manual id with 428C9 so the sequence cannot drift. Catalog property is_identity, not column_default."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_serial", "label": "serial", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a type: integer plus owned sequence plus default. Accepts manual ids without advancing the sequence, later 23505."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_primary_key", "label": "bigint primary key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "int stops at 2147483647 and sequences advance on attempts. int\u2192bigint is a full rewrite under ACCESS EXCLUSIVE (431 ms / 200k)."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_as_js_string", "label": "pg returns bigint as a string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "64-bit exceeds JavaScript safe integer range. user.id + 1 yields '11'. Treat ids as opaque strings; do not install a global int8 parser."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_natural_key", "label": "Natural key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right for immutable reference data (ISO 4217). Needing ON UPDATE CASCADE is the signal the key is mutable and wrong."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_surrogate_key", "label": "Surrogate key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles identity, not uniqueness. A users table with id and no UNIQUE(email) accumulates duplicate accounts."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_uuidv7", "label": "UUIDv7", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-ordered UUID restores insert locality. Random v4 scatters btree inserts. 16 bytes vs 8. Adding uuid DEFAULT gen_random_uuid() rewrites (902 ms / 200k)."}, {"id": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_composite_primary_key", "label": "Composite primary key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Natural fit for a join table. The pair is the uniqueness rule. Index serves the leading column only."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_generated_always_as_identity", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_serial", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_generated_always_as_identity", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_primary_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_primary_key", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_as_js_string", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_bigint_primary_key", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_natural_key", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_surrogate_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_surrogate_key", "target": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-3-ddl/02-primary-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_uuidv7", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_volatile_default_rewrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score"