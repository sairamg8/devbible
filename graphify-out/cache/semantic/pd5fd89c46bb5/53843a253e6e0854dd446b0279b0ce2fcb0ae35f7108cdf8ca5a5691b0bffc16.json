{"nodes": [{"id": "docs_react_pages_phase_2_components_10_component_boundaries_page", "label": "Component boundaries", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_by_responsibility", "label": "Split by responsibility, not length", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thinking in React: one concern, less granular than CSS classes. A 200-line one-thing component is fine."}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_five_reasons", "label": "Five reasons that justify a split", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second caller; owns state nothing above needs; different update frequency; different data source; server/client boundary."}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_split_hurts", "label": "When splitting hurts", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides flow, manufactures a props contract for local variables, invites speculative variants. More than about five local-variable props is a smell."}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_colocation", "label": "Colocation", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep a component next to its only caller. Location communicates scope; deleting a feature deletes its parts. Promote on a second caller."}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_naming", "label": "Naming as a design check", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "And in the name is two components. Wrapper/Inner often means no responsibility. Position names go stale when the design moves."}, {"id": "docs_react_pages_phase_2_components_10_component_boundaries_thinking_in_react", "label": "react.dev Thinking in React", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "source_url": "https://react.dev/learn/thinking-in-react", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_react_pages_phase_2_components_10_component_boundaries_page", "target": "docs_react_pages_phase_2_components_10_component_boundaries_by_responsibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_10_component_boundaries_page", "target": "docs_react_pages_phase_2_components_10_component_boundaries_five_reasons", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/10-component-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_10_component_boundaries_page", "target": "docs_react_pages_phase_2_components_10_component_boundaries_split_hurts", "relation": "refer