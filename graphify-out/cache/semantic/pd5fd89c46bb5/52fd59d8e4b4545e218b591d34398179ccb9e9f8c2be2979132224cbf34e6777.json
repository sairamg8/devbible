{"nodes": [{"id": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_ecma262", "label": "ECMA-262 living standard", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read tc39.es/ecma262, not a numbered-edition PDF. Host APIs like fetch and document live in WHATWG, not ECMA-262."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_abstract_operations", "label": "Abstract operations", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal non-callable algorithms in SmallCaps \u2014 ToPrimitive, ToNumber, Get \u2014 reused so every operator shares one set of rules."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_toprimitive", "label": "ToPrimitive", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hint string tries toString then valueOf; number and default try valueOf then toString. Symbol.toPrimitive overrides. + uses default; templates use string; arithmetic uses number."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_array_sort_default", "label": "Array sort default string compare", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[10,9,1].sort() is [1,10,9] because SortCompare converts to strings. Specified, not a quirk."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_date_toprimitive", "label": "Date Symbol.toPrimitive default-as-string", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Date overrides default hint to behave as string, so date + '' is a date string while date * 1 is a timestamp."}], "edges": [{"source": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_abstract_operations", "target": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_toprimitive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_toprimitive", "target": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_ecma262", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_date_toprimitive", "target": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_toprimitive", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/12-reading-the-spec.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_array_sort_default", "target": "docs_javascript_pages_phase_0_how_javascript_runs_12_reading_the_spec_ecma262", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javasc