{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_page", "label": "Optimistic concurrency version column", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_lost_update", "label": "Lost update across requests", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two concurrent read-modify-writes both reported ok and left 120 instead of 130. No transaction can span GET then later PUT."}, {"id": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_version_column", "label": "Version column guard", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE ... SET version = version + 1 WHERE version = $n. Increment must be in the same statement. updated_at fails when two updates share now()."}, {"id": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_rowcount_ambiguous", "label": "rowCount 0 is 404 or 409", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing row and stale version both yield rowCount 0. Re-read or a data-modifying CTE distinguishes them."}, {"id": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_retry_relative", "label": "Retry only recomputable operations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry add-N. Do not retry an absolute assignment the user made against stale data \u2014 that is a 409."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_page", "target": "docs_postgresql_pages_phase_9_api_crud_14_for_update_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_page", "target": "docs_postgresql_pages_phase_9_api_crud_17_timestamps_trigger_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_version_column", "target": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_lost_update", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_rowcount_ambiguous", "target": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_version_column", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_retry_relative", "target": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_version_column", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/13-optimistic.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_versi