{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_01_push_pop_shift_unshift_push", "label": "Array.prototype.push", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/01-push-pop-shift-unshift.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds at the back; returns the new length, not the array. Cannot be chained."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_01_push_pop_shift_unshift_pop", "label": "Array.prototype.pop", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/01-push-pop-shift-unshift.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes the last element; returns it, or undefined if empty. Constant work."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_01_push_pop_shift_unshift_shift", "label": "Array.prototype.shift", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/01-push-pop-shift-unshift.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes the first element and shifts all remaining values left by 1. Work proportional to length."}, {"id": "docs_javascript_pages_phase_5_built_in_library_02_adding_and_removing_01_push_pop_shift_unshift_unshift", "label": "Array.prototype.unshift", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/02-adding-and-removing/01-push-pop-shift-unshift.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inserts at the front by re-indexing everything. Returns the new length."}, {"id": "docs_javascript_pages_phase_5_bui