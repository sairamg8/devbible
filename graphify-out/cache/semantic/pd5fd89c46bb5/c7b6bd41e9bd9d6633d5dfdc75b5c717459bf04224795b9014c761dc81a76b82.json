{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_distinction", "label": "Expression vs statement", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expressions produce a value; statements perform an action. Only expressions are legal where a value is expected."}, {"id": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_curly_ambiguity", "label": "{} block vs object literal", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "{}+[] as a statement is 0 (empty block then +[]); as an expression is '[object Object]'. Same reason destructuring and arrow object returns need parens."}, {"id": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_iife", "label": "IIFE needs parentheses", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "function at statement start is a declaration and requires a name. Parens force expression position. Remaining uses: top-level await in non-modules, multi-statement const."}, {"id": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_jsx_expressions", "label": "JSX interpolation is expression-only", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "if is a statement, so JSX uses && and ternaries. Arrow ()=>{id:1} parses id: as a label and returns undefined."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_jsx_expressions", "target": "docs_javascript_pages_phase_2_operators_03_logical_operators_jsx_zero_trap", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_iife", "target": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_distinction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_jsx_expressions", "target": "docs_javascript_pages_phase_2_operators_11_expressions_vs_statements_distinction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/11-expressions-vs-statements.md", "source_location": null, "weight": 1.0}], "hyperedges": []}