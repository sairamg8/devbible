{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_spawn", "label": "child_process.spawn", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No shell, streams stdout/stderr. Output bounded by what you consume. Child blocks if the pipe fills and nobody reads."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_exec", "label": "child_process.exec", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs through /bin/sh -c so pipes and globs work. Buffers with maxBuffer 1 MB. Never interpolate untrusted input."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_execfile", "label": "child_process.execFile", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No shell; argv array to execve. Default choice for running one binary. Same 1 MB maxBuffer as exec."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_fork", "label": "child_process.fork", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Another Node process plus an IPC message channel."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_maxbuffer", "label": "maxBuffer", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cap on buffered stdout/stderr for exec/execFile, 1 MB default. Exceeding kills the child with ERR_CHILD_PROCESS_STDIO_MAXBUFFER."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_explicit_env", "label": "Explicit child env", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Children inherit process.env by default, handing DB URLs and API keys to ffmpeg. Pass a minimal env with PATH only."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_workers_vs_child_processes", "label": "Workers vs child processes", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child process ~56 ms to ready and ~49 MB RSS. Four workers ~23 MB vs ~196 MB for four processes. Children are for other programs or crash isolation."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_exec", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_maxbuffer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/child-process.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_execfile", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_child_process_maxbuffer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-proc