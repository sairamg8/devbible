{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_cost", "label": "OFFSET cost grows with depth", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET is produce-then-discard. 500k rows LIMIT 20: 1.22 ms at 0 vs 105.85 ms at 499980; EXPLAIN shows rows=500000 feeding Limit 20. Index cannot skip counting."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_keyset_pagination", "label": "Keyset pagination", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE id > $1 ORDER BY id LIMIT 20 seeks the index. Same depth: 0.93 ms and 4 buffers vs 105.85 ms and 5045. Loses random access to page N."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_drift", "label": "OFFSET pages drift under writes", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An insert between requests shifts later pages; item 16 served twice. A delete hides a row. Keyset uses a value, not a count."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_unique_tiebreaker", "label": "Unique ORDER BY tiebreaker", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-unique sort: paging 100 rows by 5 gave 54 distinct ids and 46 repeats on a static table. ORDER BY grp, id is a total order."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_limit_without_order", "label": "LIMIT without ORDER BY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No default order. An UPDATE rewrote a tuple at heap end and changed which five rows came back. Only correct when identity of rows does not matter."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_count_star_cost", "label": "count(*) vs reltuples vs LIMIT n+1", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact count 25.69 ms on 500k; reltuples 0.49 ms. LIMIT n+1 answers 'is there a next page?' for free. Clamp user-supplied limit."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_cost", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_keyset_pagination", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_drift", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_unique_tiebreaker", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_keyset_pagination", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_limit_without_order", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_unique_tiebreaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_count_star_cost", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_offset_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_limit_offset_limit_without_order", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_logical_order_logical_processing_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/limit-offset.html", "source_location": null, "weight": 1.0}], "hyperedges": []}