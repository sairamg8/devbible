{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_joins", "label": "Semi joins: EXISTS and IN", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A semi join filters the left side by existence, emits the left row at most once, and exposes no right-hand columns \u2014 so it cannot fan out."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "label": "Semi join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-circuits after the first match. Written as EXISTS or IN. Use EXISTS when correlated, IN/= ANY for independent lists."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_hash_semi_join", "label": "Parallel Hash Semi Join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXISTS and IN both plan to Parallel Hash Semi Join. The millisecond gap is noise; choosing between them is readability, not performance."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_join_plus_distinct", "label": "JOIN plus DISTINCT costs 2.5x", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HashAggregate at 189.98 ms vs Hash Semi Join at ~73\u201391 ms. The join materialises duplicates the semi join never produces. Gap grows with children per parent."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_exists_correlation", "label": "EXISTS must be correlated", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncorrelated EXISTS is true whenever the inner table has any row. Extra conditions belong inside the subquery. SELECT 1 is convention; the select list is never evaluated."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_any_array_parameter", "label": "= ANY($1::int[]) for IN lists", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter instead of N placeholders. Avoids string assembly and the 65535-parameter protocol ceiling."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_lateral_limit_1", "label": "LATERAL LIMIT 1 when columns are needed", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A semi join exposes no right-hand columns. Need the matched row? Rewrite as LEFT JOIN LATERAL \u2026 LIMIT 1, not by adding columns to EXISTS."}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_joins", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_hash_semi_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_join_plus_distinct", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_exists_correlation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_any_array_parameter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_lateral_limit_1", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/01-semi-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_joins", "target": "docs_postgresql_pages_phase_5_joins_0