{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_typeof_and_why_its_a_feature_typeof_tdz_throw", "label": "typeof throws in the TDZ", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/typeof-and-why-its-a-feature.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof still reads the binding. It returns 'undefined' only for names with no binding at all."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_typeof_and_why_its_a_feature_tdz_is_a_feature", "label": "TDZ is a feature", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/typeof-and-why-its-a-feature.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fails at the wrong line instead of later undefined; lets const have one observable value; makes a shadow own the name for the whole block."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_typeof_and_why_its_a_feature_tdz_error_messages", "label": "Engine TDZ error messages", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/typeof-and-why-its-a-feature.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8 names the variable; SpiderMonkey says lexical declaration; JavaScriptCore omits the name."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_typeof_and_why_its_a_feature_globalthis_feature_detect", "label": "globalThis feature detection", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/typeof-and-why-its-a-feature.html", "source_location": null, "source_url": null, "captured_at