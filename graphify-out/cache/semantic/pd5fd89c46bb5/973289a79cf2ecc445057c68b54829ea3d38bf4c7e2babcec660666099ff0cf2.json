{"nodes": [{"id": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_when_cleanup_is_not_the_answer", "label": "When cleanup is not the answer", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some effects fire twice because the code was never an effect. No cleanup will fix them."}, {"id": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_buying_a_product", "label": "Buying a product is not an Effect", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You want to buy when the user clicks, not when they visit. Back-navigation remounts and would buy again. Same HTTP verb as analytics, opposite answer."}, {"id": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_remount_principle", "label": "Remount principle", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visiting a page should match visiting, clicking a link, then Back. StrictMode remounts once in development because that journey remounts in production."}, {"id": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_module_level_init", "label": "Application init belongs at module level", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module code runs once per page load. No component-scoped mechanism can promise once, because components mount more than once."}, {"id": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_typeof_window_guard", "label": "typeof window guard around module init", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The module is also evaluated during server rendering, where localStorage does not exist. Without the guard the import throws."}], "edges": [{"source": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_buying_a_product", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_versus_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_remount_principle", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_module_level_init", "target": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_typeof_window_guard", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/04-cleanup/03-when-cleanup-is-not-the-answer.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effe