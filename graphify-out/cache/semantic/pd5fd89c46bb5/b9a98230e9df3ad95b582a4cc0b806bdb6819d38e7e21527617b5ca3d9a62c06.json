{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_method_shorthand", "label": "Method shorthand is not a function property", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Methods cannot be constructors and only methods have super, because they have a home object. Prefer method shorthand in literals."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_arrow_this_in_literal", "label": "Arrow this in an object literal", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither method nor function-valued property gives lexical this. An arrow in a literal captures enclosing this, undefined at module top level."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_accessor_properties", "label": "Getter and setter properties", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessors look like data from outside but run functions. Spread and Object.assign invoke getters and store values, converting accessors to data."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_spread", "label": "Object spread own enumerable shallow", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spread copies own enumerable properties shallowly, excluding the prototype. Spreading a class instance drops methods. Later spreads win as a replace, not a deep merge."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_assign", "label": "Object.assign triggers setters", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object.assign mutates the target and runs its setters. Spread defines properties on a fresh Object.prototype object. Reach for spread by default."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_duplicate_keys_last_wins", "label": "Duplicate keys last wins", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After ES2015 duplicate names are legal even in strict mode because computed keys cannot be checked at parse time. A spread after an explicit key is almost always a bug. Private elements must still be unique."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_spread", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_assign", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_spread", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_accessor_properties", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_duplicate_keys_last_wins", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_01_shorthand_and_computed_keys_computed_property_names", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/02-methods-accessors-and-spread.md", "source_location": null, "weight": 1.0}], "hyperedges": []}