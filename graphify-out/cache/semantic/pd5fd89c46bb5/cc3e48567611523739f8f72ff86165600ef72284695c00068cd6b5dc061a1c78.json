{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_schema_namespace", "label": "Schema as namespace", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A schema is a namespace inside a database. Identical SELECT FROM items returns different rows under tenant_a vs tenant_b via search_path."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "label": "search_path", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered list of schemas for unqualified names. Default is \"$user\", public. SET search_path persists on a pooled connection and leaks across requests."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_three_tenancy_layouts", "label": "Three multi-tenant layouts", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared tables + tenant_id (cheapest, weakest); schema per tenant (catalog multiplies, stops at low thousands); database per tenant (strongest, a pool each)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_set_local_search_path", "label": "SET LOCAL search_path", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET LOCAL inside a transaction reverts on commit/rollback. Schema names cannot be $1; validate against pg_namespace then escapeIdentifier."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_rls_tenant_isolation", "label": "RLS tenant isolation", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ENABLE ROW LEVEL SECURITY with USING (tenant_id = current_setting('app.tenant_id')::bigint) so a forgotten WHERE cannot leak another tenant."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_public_schema_create", "label": "public CREATE revoked since PG15", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PostgreSQL 15, public no longer grants CREATE to PUBLIC. SECURITY DEFINER functions need an explicit search_path to avoid shadowing."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_schema_namespace", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_three_tenancy_layouts", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_set_local_search_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_three_tenancy_layouts", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_rls_tenant_isolation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_public_schema_create", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_three_tenancy_layouts", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_shared_schema_default", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/schemas-tenancy.html", "source_location": null, "weight": 1.0}], "hyperedges": []}