{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_render_blocking_css_render_blocking", "label": "Render-blocking CSS", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/render-blocking-css.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser will not paint until matching stylesheets arrive, choosing a blank frame over FOUC. Measured: no CSS FCP 47 ms vs delayed matching sheet 671 ms."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_render_blocking_css_media_off_critical_path", "label": "Non-matching media does not block paint", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/render-blocking-css.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "media=print or a non-matching query is still fetched at low priority but does not wait. Basis of the print+onload non-critical CSS trick; styles land after first paint."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_render_blocking_css_render_blocking", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_render_blocking_css_media_off_critical_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/render-blocking-css.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_render_blocking_css_render_blocking", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_how_stylesheets_reach_the_page_four_delivery_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/render-blocking-css.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phas