{"nodes": [{"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_state_that_belongs_elsewhere", "label": "State that belongs elsewhere", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The effect papers over a state-location problem. The fix moves the state and the effect disappears."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_notify_parent_too_late", "label": "Notifying the parent from an Effect runs too late", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child sets state, renders, then the effect notifies the parent \u2014 two commits. Both updates in one handler batch into one render."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_lift_state_up", "label": "Lift the state up instead of copying", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If two components need the same value, ask which should own it, not how to copy it. One source of truth cannot disagree with itself."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_pass_data_down", "label": "Pass data down, do not push it up", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A child pushing via onFetched breaks the one-directional walk that makes a wrong value traceable. Fetch in the parent and pass down."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_usesyncexternalstore", "label": "useSyncExternalStore", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the value when React needs it, takes a server snapshot, and will not resubscribe while subscribe keeps the same identity. Prevents tearing."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_subscribe_stable_identity", "label": "subscribe must be declared outside the component", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inline it is a new function every render, so React tears down and rebuilds the subscription every time."}], "edges": [{"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_notify_parent_too_late", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_lift_state_up", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_pass_data_down", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_lift_state_up", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_usesyncexternalstore", "target": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_subscribe_stable_identity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_notify_parent_too_late", "target": "docs_react_pages_phase_4_effects_10_useeffectevent_useeffectevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_03_state_that_belongs_elsewhere_usesyncexternalstore", "target": "docs_react_pages_phase_4_effects_07_fetching_data_fetching_data_in_an_effect", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/03-state-that-belongs-elsewhere.md", "source_location": null, "weight": 1.0}], "hyperedges": []}