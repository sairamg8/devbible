{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_01_connecting_three_forms", "label": "Three psql connection forms", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags (-h -p -U -d), postgresql:// URI, or PG* environment. Mixable; omitted values fall back to env then OS username. URI is the same DATABASE_URL the app uses."}, {"id": "docs_postgresql_pages_phase_1_psql_01_connecting_four_failures", "label": "Four connection failure messages", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connection refused never reached a server. database does not exist proves host/port/user/password. Wrong user and wrong password both say password authentication failed, deliberately."}, {"id": "docs_postgresql_pages_phase_1_psql_01_connecting_conninfo", "label": "\\conninfo", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First thing to run when something is confusing. Backend PID matches pg_stat_activity. Superuser explains works-in-psql-not-in-app."}, {"id": "docs_postgresql_pages_phase_1_psql_01_connecting_unix_socket_exec", "label": "podman exec psql over unix socket", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "podman exec -it devbible-pg psql -U devbible -d devbible. No host, port, or password. Fastest check that the server itself is healthy."}, {"id": "docs_postgresql_pages_phase_1_psql_01_connecting_musl_glibc_sort", "label": "musl vs glibc sort order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "version() names the platform (x86_64-pc-linux-musl on alpine). musl and glibc sort text differently, which can explain local-vs-production ORDER BY differences."}, {"id": "docs_postgresql_pages_phase_1_psql_01_connecting_ex31_psql_basics", "label": "ex31-psql-basics.sh", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sandbox/pg-api measurement script for Phase 1 psql pages. Verified 2026-08 on PostgreSQL 18.4 and psql 18.4."}], "edges": [{"source": "docs_postgresql_pages_phase_1_psql_01_connecting_three_forms", "target": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_connection_uri", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_01_connecting_three_forms", "target": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_pg_env_vars", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_01_connecting_three_forms", "target": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_database_url", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/01-connecting.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_