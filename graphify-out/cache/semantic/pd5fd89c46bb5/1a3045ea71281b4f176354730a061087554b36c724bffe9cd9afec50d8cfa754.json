{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_strict_mode", "label": "Strict mode", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES modules and class bodies are always strict. Know sloppy mode to recognise old files, not to opt in."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_silent_failures_become_errors", "label": "Strict mode turns silent failures into errors", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undeclared assignment throws, frozen writes throw, this in a plain call is undefined, duplicate params and octals are SyntaxErrors."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_detached_this", "label": "Detached method this is undefined", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In a class body, a detached method throws immediately. In sloppy mode this is globalThis and the bug becomes a silent leak."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_toplevel_this", "label": "Top-level this differs by host", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined in ESM, module.exports in CJS, window in a classic script. Use globalThis for the global object."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_strict_mode", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_three_passes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_silent_failures_become_errors", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_strict_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_detached_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_this", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_toplevel_this", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_globalthis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/strict-mode.html", "source_location": null, "weight": 1.0}], "hyperedges": []}