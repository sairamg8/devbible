{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_strings_are_utf16_page", "label": "10 \u00b7 Strings are UTF-16", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/strings-are-utf16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_strings_are_utf16_utf16_code_units", "label": "UTF-16 code units", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/strings-are-utf16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".length, charAt and slice count UTF-16 code units. Code points above U+FFFF are surrogate pairs, so '\ud83d\uded2'.length is 2. Naive slice can emit a lone high surrogate."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_strings_are_utf16_grapheme_clusters", "label": "Grapheme clusters and Intl.Segmenter", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/strings-are-utf16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_strings_are_utf16_normalization", "label": "Unicode NFC vs NFD", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/strings-are-utf16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00e9 can be one code point (NFC) or e plus combining acute (NFD). They render identically and are not ===. Normalise to NFC at the boundary. macOS filenames are NFD."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_strings_are_utf16_intl_collator", "label": "Intl