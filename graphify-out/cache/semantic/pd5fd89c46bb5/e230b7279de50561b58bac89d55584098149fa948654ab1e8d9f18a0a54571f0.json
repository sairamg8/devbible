{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring", "label": "Destructuring", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pattern-matching on the left-hand side of an assignment: the shape of the expected value becomes bindings."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_array_vs_object_destructuring", "label": "Array vs object destructuring", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array destructuring matches by position; object destructuring matches by name. Array elements cannot be renamed; object properties can."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring_defaults", "label": "Destructuring defaults apply to undefined only", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults fire only when the value is undefined, not null. JSON payloads use null for missing, so defaults are routinely bypassed."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_nested_destructuring", "label": "Nested destructuring", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intermediate names are paths, not bindings. Nesting throws when an intermediate is missing; default each risky level or use optional chaining."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_object_rest", "label": "Object rest omit-a-key", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rest must be last. Object rest is the idiomatic omit-a-key, better than delete: new object, stable shape, no mutation. Shallow; own enumerable only."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_swap_idiom", "label": "Destructuring swap idiom", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RHS array is fully evaluated before assignment, so [a, b] = [b, a] needs no temporary."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_assignment_parentheses", "label": "Parentheses for object assignment", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A statement starting with { is a block. Assigning without declaring needs ({ a, b } = obj). Arrays have no such problem."}, {"id": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructure_null_throws", "label": "Destructuring null or undefined throws", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throws even with empty patterns. Guard with ?? {} or a = {} parameter default. Other values coerce to objects."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring", "target": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_array_vs_object_destructuring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring", "target": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring_defaults", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_destructuring", "target": "build_css_p2_docs_javascript_pages_phase_6_iteration_and_destructuring_destructuring_the_patterns_nested_destructuring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-6-iteration-and-destructuring/destructuring/the-patterns.html", "source_locati