{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_savepoints_and_duration", "label": "Savepoints, aborts and duration", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_25p02", "label": "25P02 aborted transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the first error every later statement is refused, including SELECT 1. COMMIT on an aborted transaction rolls back and reports success."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_savepoint", "label": "SAVEPOINT for an optional step", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROLLBACK TO SAVEPOINT rewinds to the savepoint, not the failing statement \u2014 both item inserts vanished including the one that succeeded. Thousands of savepoints overflow the 64-XID subtransaction cache."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_idle_in_transaction", "label": "Idle in transaction from a non-query await", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 1240 ms payment call held the transaction open 1223 ms: occupies a pool slot, holds locks, and pins xmin so VACUUM cannot clean tables the endpoint never touches."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_savepoint", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_25p02", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_idle_in_transaction", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_the_wrapper_with_transaction", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/transactions-request/savepoints-and-duration.html", "source_location": null, "weight": 1.0}], "hyperedges": []}