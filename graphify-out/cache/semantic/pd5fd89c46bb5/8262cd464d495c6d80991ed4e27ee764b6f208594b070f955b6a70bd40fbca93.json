{"nodes": [{"id": "docs_react_syllabus_02_hooks_part", "label": "Part 2 \u2014 Hooks, completely", "file_type": "document", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_syllabus_02_hooks_useeffect_synchronization", "label": "useEffect as synchronization", "file_type": "concept", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An effect synchronizes a component with an external system. Not a lifecycle callback and not the place to respond to a click."}, {"id": "docs_react_syllabus_02_hooks_useeffectevent", "label": "useEffectEvent", "file_type": "concept", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable in 19.2. Read latest props and state from an effect without making them dependencies. Call only from effects in the same component."}, {"id": "docs_react_syllabus_02_hooks_react_compiler", "label": "React Compiler v1.0", "file_type": "concept", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build-time automatic memoization, stable as of Oct 2025. Changes the ending of the memoization story, not the reasoning."}, {"id": "docs_react_syllabus_02_hooks_rules_of_hooks", "label": "Rules of Hooks", "file_type": "concept", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call at the top level only, from a component or another hook. Hooks are stored positionally; a conditional hook shifts the list."}, {"id": "docs_react_syllabus_02_hooks_usesyncexternalstore", "label": "useSyncExternalStore", "file_type": "concept", "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscribe to an external mutable store without tearing under concurrent rendering."}], "edges": [{"source": "docs_react_syllabus_02_hooks_part", "target": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_01_the_react_model_strictmode", "target": "docs_react_syllabus_02_hooks_useeffect_synchronization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_02_hooks_part", "target": "docs_react_syllabus_03_concurrent_and_server_part", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_02_hooks_useeffect_synchronization", "target": "docs_react_pages_phase_4_effects_11_removing_dependencies_readme_overview", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_02_hooks_useeffectevent", "target": "docs_react_syllabus_02_hooks_useeffect_synchronization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/syllabus/02-hooks.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_syllabus_02_hooks_react_compiler", "target": "docs_react_syllabus_02_hooks_rules_of_hooks", "relation": "conceptually_related_to"