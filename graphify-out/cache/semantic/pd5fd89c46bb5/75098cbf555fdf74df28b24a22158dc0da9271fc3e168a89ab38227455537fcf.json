{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_09_boolean_dates_boolean", "label": "boolean type", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 byte. true/t/yes/y/on/1 and false/f/no/n/off/0; else 22P02. Three-valued unless NOT NULL. Count trues with count(*) FILTER (WHERE b); sum(b::int) is NULL-poisoned."}, {"id": "docs_postgresql_pages_phase_2_types_09_boolean_dates_date_arithmetic", "label": "date arithmetic", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4 bytes, no time or zone. date - date is an integer day count. date + integer is a date. date + interval is a timestamp. Month arithmetic clamps: 31 Jan + 1 month = 28 Feb, and is not associative."}, {"id": "docs_postgresql_pages_phase_2_types_09_boolean_dates_interval_rules", "label": "interval comparison versus addition", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 bytes: months, days, microseconds. interval '1 month' = interval '30 days' is true for comparison, but addition uses the calendar. Compare timestamps (created_at < now() - interval '1 month'), not intervals. age() is a human calendar breakdown; subtraction is an exact duration."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_09_boolean_dates_date_arithmetic", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_date_js_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_09_boolean_dates_interval_rules", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_dst_intervals", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_09_boolean_dates_boolean", "target": "docs_postgresql_pages_phase_2_types_06_null_aggregates_ignore_null", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-2-types/09-boolean-dates.md", "source_location": null, "weight": 1.0}], "hyperedges": []}