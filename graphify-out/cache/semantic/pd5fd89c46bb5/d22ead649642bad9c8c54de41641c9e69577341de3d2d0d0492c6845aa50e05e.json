{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "label": "ACID in PostgreSQL", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_acid", "label": "ACID", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomicity via abort-on-error, consistency via constraints, isolation via snapshots, durability via WAL flush before COMMIT returns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_aborted_transaction_25p02", "label": "Aborted transaction 25P02", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a statement error the transaction accepts nothing but ROLLBACK. COMMIT on an aborted transaction is silently executed as ROLLBACK."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_deferrable_constraint", "label": "DEFERRABLE constraint", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE/PK/EXCLUDE/FK can be deferred to commit, enabling legal intermediate states such as a unique-column swap. CHECK and NOT NULL are always immediate."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_synchronous_commit", "label": "synchronous_commit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off buys ~6\u00d7 on 500 single-row commits (1042\u2192170 ms) for a window of lost recent commits, not corruption. One transaction of 500 inserts was faster (128 ms) with durability on."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_wal", "label": "WAL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every change writes a WAL record before the data file. Measured 112 bytes for one small UPDATE. WAL volume is what replication and PITR ship."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_acid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_aborted_transaction_25p02", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_deferrable_constraint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_synchronous_commit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_wal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_acid", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_mvcc_mvcc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_synchronous_commit", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_wal", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_acid_aborted_transaction_25p02", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_begin_commit_with_transaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/acid.html", "source_location": null, "weight": 1.0}], "hyperedges": []}