{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "label": ":is() vs :where() specificity", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They match identically. :is() contributes the most specific argument (an id raises every match); :where() always contributes zero. Both have forgiving argument lists."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_where_for_defaults", "label": ":where() for overridable defaults", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resets, library base styles, and .prose rules should weigh nothing so a consumer class always wins. Zero specificity does not mean no effect \u2014 anything else wins."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "target": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_where_for_defaults", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_where_for_defaults", "target": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_forgiving_is", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "specificity_takes_maximum_argument", "label": "Specificity takes the most specific argument", "nodes": ["build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_specificity_difference", "build_css_p2_docs_css_pages_phase_1_selectors_has_parent_selector", "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_not", "build_css_p2_docs_css_pages_phase_1_selectors_nesting_specificity_growth"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/is-and-where.html"}]}