{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_roles_and_membership", "label": "Roles and membership", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_postgresql_role", "label": "PostgreSQL role", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no user type. LOGIN is an attribute. CREATE USER is CREATE ROLE \u2026 LOGIN. A group is a role nobody logs in as."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_pg_authid", "label": "pg_authid cluster-wide roles", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles live in pg_authid and are shared by every database. A pg_dump contains grants but not roles unless pg_dumpall --roles-only ran first."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_inherit_and_set_role", "label": "INHERIT and SET ROLE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INHERIT (default) activates group privileges automatically. NOINHERIT or WITH INHERIT FALSE leaves membership available until SET ROLE. SET ROLE is not SET SESSION AUTHORIZATION and leaks on a pooled connection until RESET ROLE or DISCARD ALL."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_valid_until", "label": "VALID UNTIL and CONNECTION LIMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role attributes, not grants. CONNECTION LIMIT 1 yields 53300. Expired VALID UNTIL reports 28P01, identical to a wrong password, and only affects password auth."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_scram_sha_256", "label": "SCRAM-SHA-256 verifier", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PostgreSQL 14 the default store is a verifier in pg_authid.rolpassword, not the password. The exposure is CREATE ROLE \u2026 PASSWORD plaintext in logs and pg_stat_activity; \\password computes the verifier client-side."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_drop_role_sequence", "label": "REASSIGN OWNED then DROP OWNED", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DROP ROLE fails with 2BP01 while the role owns objects or holds grants. REASSIGN then DROP OWNED, in that order, in every database; reverse order drops the objects. DROP ROLE is cluster-wide."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_separate_owner_app_roles", "label": "Separate owner and app roles", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate roles cost a bootstrap step and a second connection string for migrations. A leaked app credential is then bounded by a readable grant list instead of superuser."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_postgresql_role", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_pg_authid", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_inherit_and_set_role", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_postgresql_role", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_separate_owner_app_roles", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_postgresql_role", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_scram_sha_256", "target": "docs_postgresql_pages_phase_13_ops_02_secrets_01_where_secrets_leak_alter_role_password_log", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_pg_authid", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_roles_not_in_pg_dump", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_valid_until", "target": "docs_postgresql_pages_phase_13_ops_02_secrets_02_storing_and_rotating_short_lived_credentials", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_roles_and_membership", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_grant_and_revoke", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/01-roles-and-membership.md", "source_location": null, "weight": 1.0}], "hyperedges": []}