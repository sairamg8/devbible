{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_offset_vs_keyset", "label": "OFFSET versus keyset at depth", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OFFSET 499980 produced 500000 rows and 501918 buffers to return 20 (295.87 ms). Keyset sought with Index Cond, 23 buffers, 1.23 ms."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_tuple_comparison", "label": "Row-constructor tuple comparison", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(created_at, id) < ($1, $2) is one lexicographic comparison, the same rule ORDER BY uses, and becomes a single B-tree seek."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_index_cond_vs_filter", "label": "Index Cond versus Filter", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index Cond chooses where the scan starts and stops. Filter is applied after rows are produced. A Filter on a large table is usually why a query is slow despite using the index."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_expanded_or_form", "label": "Expanded OR comparison is 160\u00d7 slower", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a < $1 OR (a = $1 AND b < $2) looks equivalent and returned the same rows, but became a Filter that discarded 250001 rows (158.12 ms vs 0.99 ms)."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_matching_index", "label": "Index must match ORDER BY column order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(created_at DESC, id DESC) matches the sort. A B-tree can be read backwards, so both-ASC also serves. (id, created_at) is useless for ORDER BY created_at, id."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_total_order", "label": "ORDER BY must be total", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "created_at alone tied 100 rows per timestamp. Without unique id, the same row can appear on two pages. WHERE must use the same columns in the same order."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_tuple_comparison", "target": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_offset_vs_keyset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/01-the-tuple-comparison.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_tuple_comparison", "target": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_index_cond_vs_filter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/10-key