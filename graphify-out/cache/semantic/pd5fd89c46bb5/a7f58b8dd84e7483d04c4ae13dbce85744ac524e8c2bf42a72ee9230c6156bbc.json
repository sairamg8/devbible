{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_shape_sql_vs_js", "label": "Shaping the response in SQL vs in JavaScript", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_jsonb_agg", "label": "jsonb_agg nested shaping", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slowest option measured: 284.8 ms vs 90.7 ms JS grouping. 232 ms was server CPU parsing jsonb. json_agg was 131.2 ms. Payload 2.0 MB vs 1.2 MB flat."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_js_grouping", "label": "Flat join grouped in JavaScript", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default: one join, Map-group in JS behind the repository mapper. Two queries + JS was 103.3 ms \u2014 a wash. Keeps one query serving several response shapes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_n_plus_one", "label": "N+1 one query per parent", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "298.6 ms for 500 orders; 2986 ms extrapolated to 5000. The one to avoid."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_empty_children_trap", "label": "jsonb_agg empty-children trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LEFT JOIN plus jsonb_agg yields [{sku:null}]. Need FILTER (WHERE child.id IS NOT NULL) and coalesce(..., '[]'::jsonb) because an aggregate over zero rows is NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_jsonb_type_change", "label": "Types change through jsonb", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric as a column is the string '11.00'; through jsonb it is the number 11. timestamptz goes Date \u2192 string. jsonb also reorders keys."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_jsonb_agg", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_js_grouping", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_js_grouping", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_repository_rows_to_domain_todomain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/shape-sql-vs-js.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_empty_children_trap", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_shape_sql_vs_js_jsonb_agg", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "co