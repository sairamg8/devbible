{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_props_are_read_only", "label": "Props are read-only", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_immutable_by_contract", "label": "Props immutable by contract not enforcement", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React does not freeze props or nested objects. Ask the parent for a new object instead of mutating."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_mutation_appears_to_work", "label": "Mutating a prop appears to work", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The write and the read are microseconds apart. Failure arrives later via remount, siblings, memo, StrictMode or abandoned renders."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_one_way_data_flow", "label": "One-way data flow", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Props down, events up. Only the owner can change a value, so debugging walks up to that useState."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_mutating_array_methods", "label": "Mutating array methods on props", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sort, reverse, splice, push mutate in place. Use a copy or toSorted, toReversed, toSpliced."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_reassign_local_is_legal", "label": "Reassigning a destructured prop is not a mutation", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A local rebinding is unobservable outside the call. Writes through the object are the violation."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_immutable_by_contract", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_mind_your_own_business", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_one_way_data_flow", "target": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_inverse_data_flow", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/react/pages/phase-2-components/props-are-read-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_props_are_read_only_mutating_array_methods", "target": "build_css_p2_docs_react_pages_phase_2_components_purity_the_two_rules_the_two_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/