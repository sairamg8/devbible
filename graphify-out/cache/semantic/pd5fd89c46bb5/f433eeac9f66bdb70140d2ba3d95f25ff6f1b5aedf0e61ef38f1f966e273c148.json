{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_build_object", "label": "jsonb_build_object", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternating key, value. The API contract is written in the query so adding a table column cannot change the response shape."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_to_jsonb", "label": "to_jsonb of a row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emits every column named by column name. Never point it at a table whose columns you do not control \u2014 later migrations leak into the API. Safe form: to_jsonb over a subquery that names columns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_object_agg", "label": "jsonb_object_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL key raises 22023 field name must not be null. Duplicate keys silently keep the last value. Aggregate over a pre-grouped subquery."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_json_vs_jsonb", "label": "json versus jsonb", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "json stores source text (duplicates, whitespace, key order). jsonb parses to binary, collapses duplicates, reorders keys. Difference is invisible from Node because JSON.parse also collapses duplicates. jsonb is 2.6\u00d7 larger here (60 vs 23 bytes) but indexable with GIN."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_agg", "label": "jsonb_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrives as a real JavaScript array; pg already JSON.parsed it. JSON.parse on the result throws. Same internal ORDER BY rule as array_agg."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_build_object", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_to_jsonb", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_aggregate_internal_order_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/json-shapes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_array_agg", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json