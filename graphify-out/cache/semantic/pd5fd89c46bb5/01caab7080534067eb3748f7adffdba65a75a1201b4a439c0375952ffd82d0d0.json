{"nodes": [{"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_page", "label": "First and last middleware slots", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_canonical_skeleton", "label": "Canonical Express skeleton", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "disable x-powered-by, json parser, routes, 404 (3-arg), error handler (4-arg). Keep one composition root instead of ad-hoc app.use across files."}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_parsers_early", "label": "Body parsers early", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handlers and validators read req.body. If they run before express.json(), req.body is empty. Size limits also need to apply before business logic."}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_error_middleware_last", "label": "Error middleware last", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Error-handling middleware is defined last, after other app.use() and routes. If registered before routes, those routes never fall into it."}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_four_arg_handler", "label": "Four-argument error middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You must provide four arguments to identify it as error-handling middleware, even when next goes unused."}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_not_found_handler", "label": "404 handler", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goes at the very bottom of the stack below all other functions, just above errors. A 404 is not an error and never reaches the error handler."}, {"id": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_faq", "label": "Express FAQ 404 guidance", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_page", "target": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_canonical_skeleton", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_canonical_skeleton", "target": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_parsers_early", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-2-middleware/05-first-and-last.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_canonical_skeleton", "target": "docs_expressjs_pages_phase_2_middleware_05_first_and_last_error_middleware_last", "relation": "