{"nodes": [{"id": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_page", "label": "Health checks and boot order", "file_type": "document", "source_file": "docs/expressjs/pages/phase-10-app-factory/05-health-and-boot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_liveness_vs_readiness", "label": "Liveness vs readiness", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-10-app-factory/05-health-and-boot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failing readiness stops new traffic; failing liveness restarts the process. Conflating them causes restart storms. Liveness is cheap; readiness checks pool/redis."}, {"id": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_boot_order", "label": "App boot order", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-10-app-factory/05-health-and-boot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "validate env \u2192 connect pool \u2192 createApp(deps) \u2192 server.listen \u2192 signal ready. Production listens only after deps are ready."}, {"id": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_restart_storms", "label": "Restart storms", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-10-app-factory/05-health-and-boot.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A readiness failure that is treated as liveness kills and respawns the process in a loop."}], "edges": [{"source": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_page", "target": "docs_expressjs_pages_phase_10_app_factory_05_health_and_boot_liveness_vs_readiness", "relation": "references", "confidence": "EXTRACTED