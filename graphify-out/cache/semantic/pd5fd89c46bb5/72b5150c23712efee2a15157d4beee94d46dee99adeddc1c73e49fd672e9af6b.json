{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_totp", "label": "TOTP", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/mfa-totp.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC of the 30-second time step with a shared secret, dynamically truncated to six digits. RFC 6238."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_drift_and_replay", "label": "TOTP drift window and replay", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/mfa-totp.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accept \u00b11 step. Record the accepted step and reject anything not newer, or the code is reusable for 90s."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_not_phishing_resistant", "label": "TOTP is not phishing-resistant", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/mfa-totp.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A proxy can relay the code in its window. WebAuthn/passkeys are origin-bound and will not sign a lookalike."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_recovery_codes", "label": "Hashed MFA recovery codes", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/mfa-totp.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten single-use codes hashed like passwords. Without them, support becomes a weaker recovery path."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_drift_and_replay", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_mfa_totp_totp", "relation": "conceptually_related