{"nodes": [{"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler", "label": "StrictMode, the Compiler and how purity is enforced", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_doubling", "label": "StrictMode doubling is the test", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React cannot inspect purity, so it runs the function twice in development. The second call is the detector, not overhead."}, {"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_cannot_catch", "label": "What StrictMode cannot catch", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production-only paths, unrun branches, idempotent writes, event handlers, and effects after the first mount. A clean dev run is not proof."}, {"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_compiler", "label": "React Compiler is a static purity checker", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It bails out instead of rewriting impure components. Skipped components are a purity report covering code that never ran."}, {"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_useref_guard", "label": "useRef guard is the wrong StrictMode fix", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It hides the symptom. The effect still cannot be re-run on remount, Fast Refresh or Activity restore."}, {"id": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_features_depend", "label": "Features that assume calling is free", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batching, memo, Compiler, transitions, Suspense, Activity, SSR and offscreen prerendering all assume render has no consequences."}], "edges": [{"source": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler", "target": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_doubling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_doubling", "target": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_cannot_catch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/02-purity/03-strictmode-and-the-compiler.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_compiler", "target": "docs_react_pages_phase_2_components_02_purity_01_the_two_rules_purity", "relation": "co