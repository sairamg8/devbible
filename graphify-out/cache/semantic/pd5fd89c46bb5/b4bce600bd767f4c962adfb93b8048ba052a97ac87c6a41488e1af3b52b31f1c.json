{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_page", "label": "11 \u00b7 Bailing out", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "label": "useState bail-out", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the new value is Object.is-identical, React skips re-rendering the component and its children. React may still call the component first; the optimisation is safe only because purity is assumed."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_object_is_comparison", "label": "Object.is state comparison", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_same_value_updater", "label": "Same-value updater idiom", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return the existing reference from an updater to signal no change. More reliable than wrapping the setter when the current value is out of scope."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_memo_vs_bailout", "label": "memo vs useState bail-out", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bail-out compares new state vs old on every set. memo compares props shallowly when the parent re-renders. Neither substitutes for the other."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_page", "target": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "target": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_object_is_comparison", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "target": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_immutable_updates", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "target": "build_css_p2_docs_react_pages_phase_3_state_infinite_render_loops_effect_sets_own_dep", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/bailing-out.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_same_value_updater", "target": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/react/pa