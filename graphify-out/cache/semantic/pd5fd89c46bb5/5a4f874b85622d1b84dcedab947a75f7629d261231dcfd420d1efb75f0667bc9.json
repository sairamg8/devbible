{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_content_addressed_store", "label": "Content-addressed object store", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git is a key-value store keyed by the SHA of the content, plus names pointing into it. Deduplication is unavoidable once the name is the hash."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_hash_header_plus_content", "label": "Hash is over type size NUL content", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "blob 6\\0hello\\n hashed with sha1sum reproduces ce013625\u2026 with no Git involved."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_hash_object_w", "label": "hash-object without -w only computes a name", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computing a name is not storing it. cat-file fails until hash-object -w writes the object."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_history_immutable_cumulative", "label": "History is immutable and cumulative", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reachable objects are never collected. A committed secret or binary is an incident; deleting the file later does not remove the blob."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_content_addressed_store", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_hash_header_plus_content", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_history_immutable_cumulative", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_content_addressed_store", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_hash_object_w", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_content_addressed_store", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is.html", "source_location": null, "weight": 1.0}], "hyperedges": []}