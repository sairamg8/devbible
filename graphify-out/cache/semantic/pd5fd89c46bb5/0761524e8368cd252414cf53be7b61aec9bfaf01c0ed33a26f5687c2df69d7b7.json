{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_ua_stylesheet", "label": "User-agent stylesheet", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A page with no CSS is still styled: body 8px margin, heading sizes, list indent as padding, img inline, box-sizing content-box."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_form_control_font", "label": "Form controls do not inherit font", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UA sets an explicit 13.3333px sans-serif on button/input, beating inheritance. Fix: font: inherit, then set the page font on body or :root."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_cascade_origin_order", "label": "Cascade origin order", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal: user-agent < user < author. !important inverts so a user accessibility override beats author !important. Any author type selector beats any UA default."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_ua_stylesheet", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_form_control_font", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_ua_stylesheet", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_cascade_origin_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_user_agent_stylesheets_ua_stylesheet", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_modern_small_reset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/user-agent-stylesheets.html", "source_location": null, "weight": 1.0}], "hyperedges": []}