{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_using_microtasks", "label": "Using microtasks deliberately", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_queue_microtask", "label": "queueMicrotask", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs after the current JS execution context exits but before event handlers, timeouts, or other callbacks. Prefer it over Promise.resolve().then when you only want scheduling: no promise allocation, and exceptions surface as uncaught errors."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_sometimes_async", "label": "Sometimes-async / Releasing Zalgo", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function that is synchronous on a cache hit and asynchronous on a miss fires events before the caller can attach a listener. A function should be always-async or never-async, never sometimes."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_microtask_batching", "label": "Batching within one event-loop turn", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The length===1 check schedules one queueMicrotask flush; later calls in the same turn join the array. Microtasks run after all synchronous code and before rendering, so the batch is complete and nothing paints twice."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_scheduling_primitives", "label": "Scheduling primitive choice", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_microtask_try_catch_gap", "label": "Microtask try/catch gap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A surrounding try/catch only guards the synchronous act of scheduling. Handle errors inside the callback."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_mdn_microtask_guide", "label": "MDN Using microtasks in JavaScript", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/microtasks-vs-macrotasks/using-microtasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_using_microtasks", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_using_microtasks_queue_microtask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_