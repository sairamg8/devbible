{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_not_exists", "label": "NOT EXISTS anti join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/anti-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps left rows with no match. Plans as Hash Anti Join. Correct with NULLs because a NULL row simply fails to match."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_not_in_trap", "label": "NOT IN NULL trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/anti-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x NOT IN (a,b,NULL) expands to x <> a AND x <> b AND x <> NULL. The last conjunct is NULL for any x, so WHERE keeps nothing. One NULL customer_id turned Dee into []."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_four_spellings", "label": "Four anti-join spellings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/anti-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT EXISTS (default), LEFT JOIN \u2026 WHERE pk IS NULL (older, fragile), EXCEPT (different whole-row semantics), NOT IN (avoid for subqueries)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_not_exists", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_not_in_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/anti-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_