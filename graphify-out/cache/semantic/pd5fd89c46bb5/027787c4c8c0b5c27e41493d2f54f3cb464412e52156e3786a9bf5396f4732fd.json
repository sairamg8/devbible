{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_window_evaluation_order", "label": "Where windows run", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows run after GROUP BY and HAVING, before DISTINCT and ORDER BY. Cannot filter a window in the same query level; can window over an aggregate."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_error_42p20", "label": "42P20 windowing_error", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE or HAVING on a window is circular: WHERE decides which rows exist and the window value depends on those rows. Compute the window in a subquery or CTE and filter outside."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_window_over_aggregate", "label": "sum(count(*)) OVER ()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) is computed per GROUP BY group; then the window sums those group rows. Standard percentage-of-total on a grouped report without a self-join."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_named_window_clause", "label": "Named WINDOW clause", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming convenience between HAVING and ORDER BY. Planner already merges identical definitions. Can extend with ORDER BY and a frame; cannot change PARTITION BY or override an existing ORDER BY."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_distinct_after_windows", "label": "DISTINCT runs after windows", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A window value such as row_number makes every row unique, so SELECT DISTINCT stops de-duplicating. De-duplicate at an inner level first."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_window_evaluation_order", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_error_42p20", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_error_42p20", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/02-where-windows-run.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_window_over_aggregate", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_window_evaluation_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-a