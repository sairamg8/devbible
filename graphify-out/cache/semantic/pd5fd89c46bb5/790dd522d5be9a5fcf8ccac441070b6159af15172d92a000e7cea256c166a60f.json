{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_create_table_contract", "label": "CREATE TABLE as the client contract", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/create-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity, FKs, CHECKs, money type, timestamptz and FK indexes are decisions every client must obey. DDL via pg returns command CREATE and null rowCount."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_create_table_identity_vs_serial", "label": "GENERATED ALWAYS AS IDENTITY vs serial", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/create-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALWAYS rejects a manual id with 428C9, preventing the sequence from drifting out of step."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_create_table_types_expensive", "label": "Types are expensive to reverse", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/create-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Be liberal with constraints, conservative with types. Constraints relax with NOT VALID; type representation changes rewrite under ACCESS EXCLUSIVE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_create_table_search_path", "label": "Unqualified CREATE TABLE follows search_path", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/create-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default \"$user\", public can land the table in an unexpected schema. Schema-qualify DDL in migrations."}], "edges": [{"source": "build_css_p2_docs_postgres