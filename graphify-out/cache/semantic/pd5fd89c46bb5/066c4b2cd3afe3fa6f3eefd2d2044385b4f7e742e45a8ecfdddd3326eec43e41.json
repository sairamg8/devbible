{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_groups_vs_rows", "label": "Filtering groups, not rows", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HAVING can see aggregates; WHERE cannot, because when WHERE runs no aggregate has been computed yet."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_where_vs_having", "label": "WHERE vs HAVING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE status='paid' is a row predicate. HAVING count(*)>1 is a group predicate. HAVING may use an aggregate not in the select list. HAVING a non-key column is 42803."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_having_without_group_by", "label": "HAVING without GROUP BY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters the single implicit group. HAVING count(*)>99 on six rows returns zero rows, not a row containing 6. The only way an ungrouped aggregate returns nothing."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_having_no_aliases", "label": "HAVING cannot see output aliases", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both WHERE and HAVING run before SELECT materialises. Error is 42703. Repeat the expression, or wrap and filter outside \u2014 the only way to filter a window result."}, {"id": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_having_count_star_left_join", "label": "HAVING count(*) > 0 after LEFT JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The NULL-extended row makes count(*) at least 1. Use count(o.id) or EXISTS. 'Customers who have ordered' is a semi-join."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_groups_vs_rows", "target": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_where_vs_having", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_where_vs_having", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_evaluation_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_having_without_group_by", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_one_row_vs_zero", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/03-having/01-groups-vs-rows.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_03_having_01_groups_vs_rows_having_no_aliases", "target