{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_arity_never_enforced", "label": "Arity is never enforced", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Too few arguments become undefined; extras are ignored by the parameter list but still counted by arguments.length. Downstream TypeError is the usual symptom."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_rest_parameters", "label": "Rest parameters", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real array, empty rather than undefined when nothing extra is passed. Must be last; cannot have a default. Works in arrows."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_arguments_object", "label": "arguments object", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array-like ([object Arguments]), no .map, absent in arrows. Prefer rest in new code."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_sloppy_arguments_aliasing", "label": "Sloppy-mode arguments aliasing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a simple parameter list, arguments[i] and the parameter share one slot both ways. Off in strict, and if any default, rest, or destructured parameter makes the list non-simple."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_nonsimple_parameter_list", "label": "Non-simple parameter list", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any default, rest, or destructured parameter. Turns off sloppy arguments aliasing, forbids a body use-strict directive, and changes .length."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_destructured_parameters", "label": "Destructured parameters", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Property defaults cover missing keys; = {} covers a missing object. Every optional destructured level needs its own default."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_signature_design", "label": "Positional plus options-object signature", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two or three required positionals, then an options object destructured with defaults. Explicit guards replace the arity check JavaScript will not do."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_rest_parameters", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_arguments_object", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_rest_parameters", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_nonsimple_parameter_list", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_destructured_parameters", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_nonsimple_parameter_list", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_sloppy_arguments_aliasing", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_nonsimple_parameter_list", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/02-rest-destructuring-arguments.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_sloppy_arguments_aliasing", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_arguments_object", "rela