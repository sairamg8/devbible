{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_8_security_encryption_and_keys_aes_256_gcm", "label": "AES-256-GCM AEAD", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/encryption-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidentiality plus integrity. CBC decrypts tampered ciphertext with no error; GCM authenticates."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_encryption_and_keys_iv_reuse", "label": "GCM IV reuse", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/encryption-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same key and IV produce the same keystream. c1 XOR c2 XOR known plaintext recovers the other message."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_encryption_and_keys_envelope_encryption", "label": "Envelope encryption", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/encryption-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KEK wraps a per-row DEK stored with v and kid. Rotation re-wraps DEKs instead of re-encrypting data."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_encryption_and_keys_ed25519", "label": "Ed25519 over RSA for new work", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/encryption-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faster keygen and signing, 64-byte signatures, no parameters. RSA only for interoperability or verify-heavy legacy."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_8_security_encryption_and_keys_aes_256_gcm", "target": "build_css_p2_docs_nodejs