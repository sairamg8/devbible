{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "label": "Session TimeZone setting", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display and interpretation, not storage. Affects timestamptz printing, bare timestamp literals, current_date, date_trunc, and ::date. Precedence: SET, PGTZ/options, postgresql.conf, OS at initdb. Pin server and database to UTC."}, {"id": "docs_postgresql_pages_phase_2_types_05_time_zones_group_by_day", "label": "GROUP BY day depends on session zone", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events at 21:00Z and 23:30Z on 15 June bucket to 15 June in UTC and 16 June in Asia/Kolkata. Always name the zone: date_trunc('day', at AT TIME ZONE ...)."}, {"id": "docs_postgresql_pages_phase_2_types_05_time_zones_iana_names", "label": "IANA time zone names", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abbreviations like IST are ambiguous. Fixed offsets miss DST. Store users' zones as IANA names so history and legislation are applied correctly."}, {"id": "docs_postgresql_pages_phase_2_types_05_time_zones_pool_utc", "label": "Pin the pg pool to UTC", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "options: '-c timezone=UTC'. Plain SET leaks across pooled release(). SET LOCAL TIME ZONE $1 fails 42601; use set_config(name, value, true) or put AT TIME ZONE in the query."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_timestamptz_vs_timestamp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_05_time_zones_group_by_day", "target": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_05_time_zones_group_by_day", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_at_time_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_05_time_zones_iana_names", "target": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_05_time_zones_pool_utc", "target": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_05_time_zones_session_timezone", "target": "docs_postgresql_pages_phase_2_types_04_timestamptz_date_js_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/05-time-zones.md", "source_location": null, "weight": 1.0}], "hyperedges": []}