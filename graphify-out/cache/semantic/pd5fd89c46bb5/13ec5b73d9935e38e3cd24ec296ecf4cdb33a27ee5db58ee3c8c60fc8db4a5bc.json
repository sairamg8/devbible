{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_map_does_not_serialise", "label": "Map does not serialise", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.stringify(map) is {}. Convert with fromEntries (string keys only) or JSON.stringify([...map]) to keep key types."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_keys_are_data", "label": "Map when keys are data", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Map when keys come from data; use an object when keys are a small fixed set you wrote. JSON edges stay objects."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_map_groupby", "label": "Map.groupBy vs Object.groupBy", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer Map.groupBy: any key type and insertion order. Object.groupBy stringifies and re-sorts integer-like keys."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_weakmap", "label": "WeakMap weak keys", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys must be objects; entries are collectable. Not iterable, no size. A strong Map here leaks memory."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_map_does_not_serialise", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_silent_drops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_map_does_not_serialise", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_stringify_tojson", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_keys_are_data", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_the_six_differences_six_differences", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_choosing_and_costs_map_groupby", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_reduce_when_not_to_use_it_named_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object/choosing-and-costs.html", "source_location": null, "weight