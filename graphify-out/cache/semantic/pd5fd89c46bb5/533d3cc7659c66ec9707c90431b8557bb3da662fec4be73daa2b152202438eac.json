{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_strict_null_checks", "label": "strictNullChecks", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it, null and undefined belong to every type and | null is decoration. With it they are ordinary union members (TS18047). Defaults true via strict in TypeScript 7."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_null_vs_undefined", "label": "null vs undefined", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined is not provided; null is deliberately empty. Produce undefined internally, accept null from JSON/SQL, normalise at the boundary. JSON.stringify drops undefined and keeps null."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_nullish_coalescing", "label": "?? vs ||", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "?? falls back only on null/undefined. || falls back on every falsy value, so a legitimate 0 or '' is replaced."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_optional_chaining", "label": "Optional chaining ?.", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-circuits the whole chain to undefined, never to null, even when the missing link was null. Result is always T | undefined."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_non_null_assertion", "label": "Non-null assertion !", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes null/undefined with no check. A claim, not a proof. An explicit throw fails at the cause instead of Cannot read properties of null later."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_narrowing_lost_in_callback", "label": "Narrowing lost inside a callback", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured on 7.0.2: narrowing of a property survives await in the same function and is discarded inside forEach, which could run later. Copy to a const first."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_strict_null_checks", "target": "docs_typescript_pages_phase_0_how_typescript_runs_readme_strict_defaults_true", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_strict_null_checks", "target": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_null_vs_undefined", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/10-null-and-undefined.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_10_null_and_undefined_nullish_coal