{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_what_bind_does_what_bind_does", "label": "What bind does", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/what-bind-does.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bound function is an exotic object: prefixed name, reduced length, no own prototype, permanent this."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_what_bind_does_permanence", "label": "bind permanence", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/what-bind-does.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Later call/apply/bind cannot change this; further bind still accumulates leading arguments."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_what_bind_does_bind_and_new", "label": "bind and new", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/what-bind-does.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new discards bound this but keeps bound args; [[Construct]] delegates so instanceof still holds."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_call_apply_bind_what_bind_does_handwritten_bind", "label": "Handwritten bind", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/call-apply-bind/what-bind-does.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naive apply misses new; new.target plus prototype linking restores construct, but .name/.length/absent prototype are exotic."}], "edges": [{"source": "bui