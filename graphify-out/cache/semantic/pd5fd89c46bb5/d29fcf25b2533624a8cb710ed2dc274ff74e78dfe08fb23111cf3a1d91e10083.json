{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex", "label": "Index bloat and REINDEX", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_index_bloat", "label": "Index bloat", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every UPDATE of an indexed column writes a new index entry and leaves the old one dead. Measured 8792 kB \u2192 34 MB after six rewrites of a third of 400000 rows, row count unchanged."}, {"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_vacuum_no_shrink", "label": "VACUUM does not shrink indexes", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same asymmetry as heap VACUUM: dead entries become reusable inside the file so growth stops, but 34 MB stays 34 MB. Only REINDEX rebuilds the file."}, {"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_reindex_concurrently", "label": "REINDEX CONCURRENTLY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a new index, swaps, drops old under SHARE UPDATE EXCLUSIVE. Measured 34 MB \u2192 9968 kB in 783 ms. Cannot run in a transaction; needs disk for both copies; can leave invalid _ccnew/_ccold."}, {"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_pgstatindex", "label": "pgstatindex leaf_fragmentation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_ccnew", "label": "Invalid _ccnew index leftover", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex", "target": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_index_bloat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_vacuum_no_shrink", "target": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_index_bloat", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_reindex_concurrently", "target": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_index_bloat", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_reindex_concurrently", "target": "docs_postgresql_pages_phase_10_indexes_17_bloat_reindex_ccnew", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/17-bloat-reindex.md", "source_location": null, "weight": 1.0}, {"source": 