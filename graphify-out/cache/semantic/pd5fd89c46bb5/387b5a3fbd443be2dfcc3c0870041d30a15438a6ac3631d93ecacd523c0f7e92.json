{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_nontransactional", "label": "Sequences are non-transactional", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nextval takes a value and releases immediately so concurrent inserters never block. Rollbacks and failed inserts keep their values \u2014 gaps are the design."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_gaps", "label": "Sequence gaps", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sources: rollback, unique failure, CACHE n, crash recovery (last_value WAL-logged periodically). Gapless invoice numbers need a serialised counter row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_ownership", "label": "Sequence OWNED BY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "serial/identity sequences drop with the table (0 left after DROP). Hand-created sequences survive unless ALTER SEQUENCE \u2026 OWNED BY. Ownership does not restrict nextval."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_setval_repair", "label": "setval sequence repair", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After explicit ids: setval(seq, max(id)+1, false). is_called false means next nextval returns the given value; true returns the one after."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_returning_over_currval", "label": "RETURNING over currval", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "currval is session state and errors 55000 if nextval was never called; lastval() is whichever sequence was touched last. RETURNING is unambiguous and one round trip."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_nontransactional", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_gaps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_ownership", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_nontransactional", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_setval_repair", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_gaps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/sequences.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_returning_over_currval", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_sequences_sequence_nontransactional", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":