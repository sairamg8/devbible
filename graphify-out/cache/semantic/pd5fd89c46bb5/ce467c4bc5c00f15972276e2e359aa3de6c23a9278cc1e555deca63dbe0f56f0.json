{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "label": "try/catch with await", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rejected promise throws at the await. Without await the try finishes synchronously and the rejection is unhandled."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_catch_placement", "label": ".catch() placement", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mid-chain .catch recovers and the chain continues fulfilled. End-of-chain is a final net. Covers only upstream."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_catch_where_you_can_act", "label": "Catch only what you can handle", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A giant try cannot say what failed. Recover or add {cause} locally; let the rest propagate to a boundary."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_catch_where_you_can_act", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_catch_placement", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_floating_promise", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_error_design_error_cause", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_error_handling_try_catch_await", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_async_await_async_await", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/error-handling.html", "source_location": null, "weight": 1.0}], "hyperedges": []}