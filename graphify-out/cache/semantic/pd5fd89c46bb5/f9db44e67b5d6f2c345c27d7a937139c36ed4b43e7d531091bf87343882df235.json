{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_vacuum", "label": "VACUUM", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/vacuum.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks dead row versions reusable under SHARE UPDATE EXCLUSIVE. Does not return space to the OS."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_vacuum_full", "label": "VACUUM FULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/vacuum.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrites the table under ACCESS EXCLUSIVE and returns space. Use only after a permanent shrink; pg_repack is the live-table answer."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_autovacuum", "label": "Autovacuum", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/vacuum.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires at threshold + scale_factor \u00d7 live_rows (default 50 + 20%). Large hot tables need a per-table override."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_hot_updates", "label": "HOT updates", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/vacuum.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fillfactor 70 raised HOT from 0.1% to 76.6% and cut a 24 MB table to 13 MB. An index on the updated column drives HOT to 0%."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_vacuum", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_vacuum_vacuum_full", "relation": "semantically_similar_to", "confidence": "INFERRED",