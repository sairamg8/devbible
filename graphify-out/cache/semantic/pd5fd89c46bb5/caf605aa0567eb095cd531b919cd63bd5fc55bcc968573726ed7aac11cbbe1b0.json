{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_12_ssrf_ssrf", "label": "SSRF", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_dns_rebinding", "label": "DNS rebinding", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check-then-fetch resolves twice. A one-second TTL can return public to the validator and private to the connection. Only a check at connect time closes it."}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_redirect_follow", "label": "Unvalidated fetch redirects", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fetch follows redirects by default. A public URL that 302s to 169.254.169.254 passes any up-front check. Use redirect:manual and re-validate each hop."}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_literal_ip_bypasses_lookup", "label": "Literal IPs bypass custom lookup", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lookup is NEVER CALLED for http://127.0.0.1/ \u2014 there is no name. Parse-time net.isIP is required alongside the connect-time guard."}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_three_part_defence", "label": "Parse, connect-time, and redirect re-check", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowlist http/https at parse (data: returns 200). guardedLookup rejects private names. Re-parse every Location. Need all three."}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_egress_proxy", "label": "Egress proxy for user URLs", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowlist hosts when destinations are knowable. For webhooks, send outbound through a host whose firewall permits public ranges only. Node 24 has no --allow-net."}, {"id": "docs_nodejs_pages_phase_8_security_12_ssrf_url_normalization", "label": "WHATWG URL IP normalisation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2130706433, 0x7f000001, 0177.0.0.1 and 127.1 all become hostname 127.0.0.1. Strip IPv6 brackets; ::ffff:127.0.0.1 becomes ::ffff:7f00:1."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_12_ssrf_ssrf", "target": "docs_nodejs_pages_phase_8_security_12_ssrf_dns_rebinding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_12_ssrf_ssrf", "target": "docs_nodejs_pages_phase_8_security_12_ssrf_redirect_follow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_12_ssrf_ssrf", "target": "docs_nodejs_pages_phase_8_security_12_ssrf_literal_ip_bypasses_lookup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/12-ssrf.md", "s