{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_4_responses_status_and_headers_status_contract", "label": "HTTP status as contract", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-4-responses/status-and-headers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Useful APIs pick 201/204/400/401/403/404/409 deliberately \u2014 not always 200. Rich codes help clients; over-fine codes confuse them."}, {"id": "build_css_p2_docs_expressjs_pages_phase_4_responses_status_and_headers_headers_before_body", "label": "Headers fixed once body starts", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-4-responses/status-and-headers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cannot set a header after the body is already sent. Set headers first."}, {"id": "build_css_p2_docs_expressjs_pages_phase_4_responses_status_and_headers_status_families", "label": "HTTP status families", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-4-responses/status-and-headers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_expressjs_pages_phase_4_responses_status_and_headers_rpc_over_http", "label": "Always-200 RPC-over-HTTP", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-4-responses/status-and-headers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always HTTP 200 with {success:false} is an RPC-over-HTTP habit. Use real statuses; keep error body for details."}, {"id": "build_css_p2_docs_expressjs_pages_phase_4_responses_status_and_headers_401_vs_403", "label": "401 vs 403", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-