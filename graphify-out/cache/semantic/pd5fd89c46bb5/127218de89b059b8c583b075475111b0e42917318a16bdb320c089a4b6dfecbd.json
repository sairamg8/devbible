{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_empty_groups_and_keys", "label": "Empty groups and grouping keys", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two things decide result shape: one row vs zero over an empty selection, and what the grouping key does with NULLs and expressions."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_one_row_vs_zero", "label": "No GROUP BY always returns one row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicit group over everything. With GROUP BY, empty selection emits zero rows. Check rows[0].n without GROUP BY; check rows.length with it."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_sum_empty_null", "label": "sum over nothing is NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count over nothing is 0. NULL propagates: sum(total)+shipping is NULL. coalesce(sum(x),0) in SQL before any arithmetic."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_null_grouping_key", "label": "NULL as a grouping key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three NULL coupons form one group. Grouping, DISTINCT, UNION and PARTITION BY use IS NOT DISTINCT FROM. Predicates use three-valued =."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_missing_combinations", "label": "GROUP BY omits missing combinations", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No (IN, paid) row showing 0. A grid UI goes ragged. Manufacture the spine with a cross join of the dimensions and LEFT JOIN the aggregate."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_date_trunc_timezone", "label": "date_trunc uses session time zone", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UTC server groups by UTC days. An 18:00+00 order is already tomorrow in Delhi. Name AT TIME ZONE explicitly. Bug only appears for rows past local midnight."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_date_local_midnight", "label": "pg parses date as local midnight", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/02-empty-groups-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TZ=Asia/Calcutta turns 2026-03-01 into 2026-02-28T18:30:00.000Z. Return the day as to_char text so the driver cannot reinterpret it."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_empty_groups_and_keys", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_one_row_vs_zero", "relation": "references", "confide