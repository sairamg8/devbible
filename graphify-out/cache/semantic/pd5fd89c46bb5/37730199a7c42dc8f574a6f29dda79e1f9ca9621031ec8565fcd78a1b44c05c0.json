{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_exists", "label": "EXISTS semi join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/semi-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters the left side by whether a match exists, short-circuits, emits the left row at most once, exposes no right-hand columns. Must be correlated."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_in", "label": "IN as semi join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/semi-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positive IN and EXISTS both plan as Parallel Hash Semi Join. Prefer EXISTS when correlated, IN or = ANY($1::int[]) for an independent list."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_join_distinct_cost", "label": "JOIN plus DISTINCT costs 2.5\u00d7", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/semi-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HashAggregate at 189.98 ms versus Hash Semi Join at 73\u201391 ms. The join materialises duplicates then hashes them away; a semi join never produces them."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_exists", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_in", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/semi-anti/semi-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_page