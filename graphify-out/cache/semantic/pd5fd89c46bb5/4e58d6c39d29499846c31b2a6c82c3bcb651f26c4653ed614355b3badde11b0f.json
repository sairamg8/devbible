{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_over_vs_group_by_partition_by", "label": "PARTITION BY does not collapse rows", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/over-vs-group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same sums as GROUP BY, different row count: one row per group vs every input row with the group's value attached. Measured 3 grouped rows vs 5 windowed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_over_vs_group_by_over_empty", "label": "OVER () whole-result partition", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/over-vs-group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every row is one partition \u2014 the canonical way to attach a grand total or percentage without a self-join. Use 100.0 * not 100 * or integer division floors to zero. FILTER goes before OVER."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_over_vs_group_by_running_total", "label": "ORDER BY inside OVER running total", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/over-vs-group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implies RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW. Inner ORDER BY changes values; outer ORDER BY only presentation. RANGE includes peers so equal keys share a running total."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_over_vs_group_by_partition_by", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_over_vs_group_by_over_empty", "re