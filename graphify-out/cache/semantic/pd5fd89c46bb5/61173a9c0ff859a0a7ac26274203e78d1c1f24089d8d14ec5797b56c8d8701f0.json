{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_page", "label": "unhandledRejection and uncaughtException", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_unhandled_rejection", "label": "unhandledRejection", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fatal by default since Node 15 (exit code 1). --unhandled-rejections=warn restores the old warn-and-continue for a temporary audit only."}, {"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_uncaught_exception", "label": "uncaughtException", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronous throw escaped every try/catch. State afterwards is unknown, likely corrupt. Definitely not safe to continue."}, {"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_crash_handler", "label": "Process crash handler", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log first, stop accepting, drain in-flight, hard-cap with unrefed setTimeout, be idempotent. Pair with SIGTERM. Set exitCode rather than immediate process.exit so stdout drains."}, {"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_log_and_continue_wrong", "label": "Log and continue is wrong", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After an uncaught exception a function stopped partway \u2014 lock, transaction, counter, half-written file. Restart into a known state."}, {"id": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_rejection_handled", "label": "rejectionHandled", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A handler attached on a later tick fires this after Node already reported unhandled. Attach handlers at creation time."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_page", "target": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_unhandled_rejection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_page", "target": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_uncaught_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_page", "target": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_crash_handler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/15-unhandled-rejections.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_log_and_continue_wrong", "target": "docs_nodejs_pages_phase_2_async_15_unhandled_rejections_uncaught_exception", "relation