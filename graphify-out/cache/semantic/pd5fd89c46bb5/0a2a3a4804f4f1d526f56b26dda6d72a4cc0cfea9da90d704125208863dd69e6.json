{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_row_level_security", "label": "Row-level security", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves which rows a user may see into the database so a missing WHERE stops being a data breach. Default-deny: enable with no policy and the table looks empty."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_force_row_level_security", "label": "FORCE ROW LEVEL SECURITY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Table owners bypass RLS by default. An app connecting as schema owner is unprotected and its tests pass."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_using_vs_with_check", "label": "USING vs WITH CHECK", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE needs WITH CHECK as well as USING, otherwise a user can modify a row they own into one they should not."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_set_local", "label": "SET LOCAL for RLS identity", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain SET persists on a pooled connection into the next request \u2014 measured \u2014 which is a cross-tenant exposure."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_row_level_security", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_force_row_level_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_row_level_security", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_using_vs_with_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_row_level_security", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_set_local", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_force_row_level_security", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_app_role_not_owner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_set_local", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pgbouncer_transaction_pooling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/rls.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_rls_row_level_security", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_security_invoker", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgre