{"nodes": [{"id": "docs_javascript_pages_phase_7_async_06_chaining_01_flattening_then_returns_new_promise", "label": "then returns a new promise", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/01-flattening.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each link represents the previous step and the handler. Combined with adoption, that is why a chain is flat where a callback pyramid was not."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_01_flattening_chain_is_sequential", "label": "A promise chain is sequential", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/01-flattening.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each link waits for the previous to settle. Chaining independent fetches is an accidental waterfall; Promise.all is the composition tool."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_01_flattening_reduce_idiom", "label": "reduce sequential composition", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/01-flattening.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[f1,f2,f3].reduce((p, f) => p.then(f), Promise.resolve()). Seed is an already-fulfilled promise; pass functions by reference."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_06_chaining_01_flattening_then_returns_new_promise", "target": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_adoption", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/01-flattening.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_01_flattening_then_returns_n