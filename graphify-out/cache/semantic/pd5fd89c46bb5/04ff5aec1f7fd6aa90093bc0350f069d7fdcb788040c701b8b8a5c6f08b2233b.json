{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_csrf", "label": "CSRF", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser attaches the victim's cookie to an attacker-composed write. Authority problem, not input."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_samesite_lax", "label": "SameSite=Lax", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser default withholds cookies from cross-site POST. Set it explicitly; Node writes no flags by default."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_origin_check", "label": "Origin allowlist check", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare new URL(origin).origin. Guard Origin: null. Prefer Origin, fall back to Referer."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_signed_double_submit", "label": "Signed double-submit CSRF token", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC the nonce over the session id. Plain double-submit fails if a subdomain can set the cookie."}, {"id": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_cors_not_csrf", "label": "CORS does not prevent CSRF", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CORS governs reading the response. A form POST still writes. Simple requests have no preflight."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_samesite_lax", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_csrf", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_origin_check", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_csrf", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_signed_double_submit", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_csrf", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_cors_not_csrf", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_csrf", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_8_security_csrf_signed_double_submit", "target": "build_css_p2_docs_nodejs_pages_phase_8_security_https_hsts_cookies_cookie_flags", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/nodejs/pages/phase-8-security/csrf.html", "source_location": null, "weight": 1.0}], "hyperedges": []}