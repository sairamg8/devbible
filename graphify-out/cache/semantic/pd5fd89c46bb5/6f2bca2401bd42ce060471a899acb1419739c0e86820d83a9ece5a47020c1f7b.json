{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_caching_strategy", "label": "Caching strategy", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_ttl_invalidation", "label": "TTL and write-path invalidation", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TTL bounds how wrong you can be; it is not the only invalidation. Delete or overwrite on write when updates must show sooner. Pick TTLs from product tolerance and origin load."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_cache_stampede", "label": "cache stampede", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many concurrent misses on one expired hot key overload the origin. Mitigate with single-flight, distributed locks, jittered TTLs, or stale-while-revalidate."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_single_flight", "label": "single-flight cache fill", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process Map of inflight promises collapses concurrent misses. Does not protect a multi-pod fleet \u2014 that needs a distributed lock or soft TTL."}, {"id": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_inprocess_vs_redis", "label": "in-process vs Redis cache", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process is fastest and per pod; after scale-out you have N independent caches. Redis is shared, networked, operational. Choose by coherence needs."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_caching_strategy", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_ttl_invalidation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_caching_strategy", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_cache_stampede", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_cache_stampede", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_single_flight", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_caching_strategy", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_inprocess_vs_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_10_observability_caching_strategy_inprocess_vs_redis", "target": "build_css_p2_docs_nodejs_pages_phase_10_observability_common_leak_sources_unbounded_cache", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-10-observability/caching-strategy.html", "source_location": null, "weight": 1.0}], "hyperedges": []}