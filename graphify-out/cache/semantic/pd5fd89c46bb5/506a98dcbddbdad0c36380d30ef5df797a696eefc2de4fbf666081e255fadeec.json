{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on_page", "label": "DISTINCT and DISTINCT ON", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on", "label": "DISTINCT ON", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the first row per group as ORDER BY produced them, whole row included. PostgreSQL-specific. Index (group, sort) removes the Sort."}, {"id": "docs_postgresql_pages_phase_4_crud_12_distinct_on_order_by_rule", "label": "DISTINCT ON ORDER BY rule", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DISTINCT ON expressions must be the leading ORDER BY expressions or 42P10. Omitting ORDER BY is legal and returns an arbitrary row per group."}, {"id": "docs_postgresql_pages_phase_4_crud_12_distinct_on_vs_alternatives", "label": "DISTINCT ON versus row_number versus LATERAL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DISTINCT ON for top-1 over a whole table. row_number for top-N or the rank. LATERAL when the outer set is small and indexed, and to keep groups with no match."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on_page", "target": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_12_distinct_on_order_by_rule", "target": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_12_distinct_on_distinct_on_page", "target": "docs_postgresql_pages_phase_4_crud_09_logical_order_logical_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/12-distinct-on.md", "source_location": null, "weight": 1.0}], "hyperedges": []}