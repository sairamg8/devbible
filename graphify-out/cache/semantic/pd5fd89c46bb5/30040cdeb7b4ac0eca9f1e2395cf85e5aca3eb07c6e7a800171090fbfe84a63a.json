ks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounds only the wait for a lock (55P03). Prefer SET LOCAL so it does not leak on a pooled connection \u2014 pg does not reset session state on release()."}, {"id": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_tuple_header", "label": "Row locks live in the tuple header", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/07-row-locks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_pg_blocking_pids", "label": "pg_blocking_pids", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/07-row-locks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_07_row_locks", "target": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_for_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/07-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_for_update", "target": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_lock_modes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/07-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_for_key_share", "target": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_lock_modes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/07-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_07_row_locks_