{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_pino", "label": "pino", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fast JSON logger with the knobs production uses: child bindings, redaction paths, and serializers."}, {"id": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_child_loggers", "label": "pino child loggers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bind reqId and orderId once so every subsequent line carries them. One child per request or job. base is process-lifetime facts."}, {"id": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_redact", "label": "pino redact", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redact at the logger, not in every call site. Defense in depth, not a substitute for not putting secrets on the object."}, {"id": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_serializers", "label": "pino serializers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stdSerializers.err pulls type, message, and stack. Pass the error under an err field on the merge object."}, {"id": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_no_pretty_in_prod", "label": "Do not pretty-print in production", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregators parse JSON. Colourized multi-line output is for humans on a laptop."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_pino", "target": "docs_nodejs_pages_phase_10_observability_01_structured_logging_structured_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_child_loggers", "target": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_pino", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_child_loggers", "target": "docs_nodejs_pages_phase_10_observability_03_correlation_ids_asynclocalstorage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_redact", "target": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_pino", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/02-pino-in-practice.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_02_pino_in_practice_redact", "target": "docs_nodejs_pages_phase_10_observability_04_what_to_log_never_log_secrets", "relation": "references", "confidence": "EXTRACTED", "confidence_scor