{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameterized_queries", "label": "Parameterized queries", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values go in as $1, never into the SQL string. Safety is the wire protocol, not escaping."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_extended_query_protocol", "label": "Extended query protocol", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parse then bind. Multi-statement text fails with 42601. An empty params array stays on the simple protocol."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_simple_query_protocol", "label": "Simple query protocol", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The SQL string is a script and may contain several statements. Concatenated ORDER BY dropped a table in one request."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_cannot_be_identifiers", "label": "Parameters cannot be identifiers", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY $1 sorts by a constant string with no error. Table, column, and ASC/DESC slots are structure, not values."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_identifier_allowlist", "label": "Identifier allowlist", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map user input to a hard-coded identifier and reject the rest. Interpolate only your own object values."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_format_percent_i", "label": "format %I identifier quoting", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For genuinely unknown names, format('%I') quotes the payload as one identifier. %s quotes nothing."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_like_wildcard_abuse", "label": "LIKE wildcard abuse", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parameter keeps % as data, but LIKE still matches everything. Escape % and _ when the user means them literally."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameter_ceiling", "label": "65535 parameter ceiling", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The protocol stores the count in 16 bits. 21845 three-column rows succeed; one more fails with 08P01."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_extended_query_protocol", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameterized_queries", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_simple_query_protocol", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_extended_query_protocol", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_cannot_be_identifiers", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameterized_queries", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_identifier_allowlist", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_cannot_be_identifiers", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_format_percent_i", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_cannot_be_identifiers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/parameters.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_like_wildcard_abuse", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameterized_queries", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresq