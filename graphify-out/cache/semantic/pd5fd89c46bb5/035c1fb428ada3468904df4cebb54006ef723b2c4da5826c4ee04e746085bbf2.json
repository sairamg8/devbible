{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_06_null_three_valued_logic", "label": "NULL three-valued logic", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL is absence. NULL = NULL is unknown. WHERE keeps only true, so col = NULL matches nothing. Use IS NULL or IS NOT DISTINCT FROM."}, {"id": "docs_postgresql_pages_phase_2_types_06_null_not_in_with_null", "label": "NOT IN with NULL returns nothing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2 NOT IN (1, NULL) is NULL because it expands to true AND (2 <> NULL). Prefer NOT EXISTS, which handles NULL and usually plans as an anti-join."}, {"id": "docs_postgresql_pages_phase_2_types_06_null_unique_nulls", "label": "UNIQUE allows many NULLs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULLs are not equal, so they do not conflict. Measured three NULLs accepted. UNIQUE NULLS NOT DISTINCT (PostgreSQL 15+) allows at most one."}, {"id": "docs_postgresql_pages_phase_2_types_06_null_aggregates_ignore_null", "label": "Aggregates ignore NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) counts rows; count(col) counts non-nulls. sum() over no rows or all NULLs is NULL, not 0 \u2014 wrap with coalesce. NULLs sort last ASC and first DESC."}, {"id": "docs_postgresql_pages_phase_2_types_06_null_empty_string_not_null", "label": "Empty string is not NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oracle conflates them; PostgreSQL does not. || with a NULL operand yields NULL; concat() and concat_ws() skip NULLs. undefined parameters become NULL in pg."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_06_null_not_in_with_null", "target": "docs_postgresql_pages_phase_2_types_06_null_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_06_null_unique_nulls", "target": "docs_postgresql_pages_phase_2_types_06_null_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_06_null_aggregates_ignore_null", "target": "docs_postgresql_pages_phase_2_types_06_null_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_06_null_empty_string_not_null", "target": "docs_postgresql_pages_phase_2_types_06_null_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/06-null.md", "source_location": null, "weight": 1.0}], "hyperedges": []}