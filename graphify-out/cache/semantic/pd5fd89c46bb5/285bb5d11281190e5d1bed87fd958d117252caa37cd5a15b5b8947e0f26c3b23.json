{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_timestamptz", "label": "timestamptz", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8-byte UTC instant. Does not store a zone; converts on input/output. Same instant displays as 04:30+00, 10:00+05:30, 00:30-04."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_timestamp", "label": "timestamp without time zone", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores the digits and discards the offset. Same value means different instants to every reader. Only for floating wall-clock values with a stored zone name."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_now_vs_clock", "label": "now() vs clock_timestamp()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "now() is transaction start and stays constant; clock_timestamp() is wall clock per call."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_date_nodejs_midnight", "label": "date to JS Date midnight trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg turns date into Date at local midnight; in Asia/Calcutta that is 18:30 UTC the previous day. Fix with to_char or setTypeParser(1082, v => v)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_timestamptz", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_timestamp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_timestamptz_now_vs_clock", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_default_now_txn_start", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/timestamptz.html", "source_location": null, "weight": 1.0}], "hyperedges": []}