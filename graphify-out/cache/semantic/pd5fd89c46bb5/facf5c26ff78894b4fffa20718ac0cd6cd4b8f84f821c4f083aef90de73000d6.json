{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_lexical_this", "label": "Lexical this and missing bindings", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An arrow has no this; this is a free variable resolved through the scope chain."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_free_variable_this", "label": "Arrow this is a free variable", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup finds the nearest ordinary function; object literals are not scopes so method arrows see module undefined."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_bind_ignored", "label": "call/apply/bind cannot change arrow this", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They fail silently on this while still passing arguments; bind still returns a function."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_missing_prototype", "label": "Arrow has no prototype", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prototype is genuinely absent; new throws TypeError: A is not a constructor. this/arguments/super/new.target are inherited, not missing."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_inherited_arguments", "label": "Arrow inherited arguments", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inside a function an arrow reports the outer arguments.length; use rest parameters."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_lexical_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_free_variable_this", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_lexical_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_bind_ignored", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_lexical_this", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_arrow_functions_and_this_lexical_this_missing_prototype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/arrow-functions-and-this/lexical-this.html", "source