{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "label": "Foreign key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The database refuses a row that points at nothing. Application check-then-insert cannot close the concurrency window."}, {"id": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_on_delete_actions", "label": "ON DELETE actions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NO ACTION 23503, RESTRICT 23001, CASCADE deletes children, SET NULL, SET DEFAULT. Map both error codes to HTTP 409."}, {"id": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_no_action_vs_restrict", "label": "NO ACTION vs RESTRICT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Difference appears only when deferred. NO ACTION can check at COMMIT; RESTRICT always fires immediately."}, {"id": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_index_referencing_column", "label": "Index every FK referencing column", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL indexes the referenced side only. Unindexed child FK: parent delete 33.6 ms vs 8.7 ms indexed at 300k children."}, {"id": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_app_cannot_enforce", "label": "Application cannot enforce referential integrity", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Between findParent and insertChild another transaction can delete the parent. Only the database evaluates the constraint as part of the write."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_on_delete_actions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_on_delete_actions", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_no_action_vs_restrict", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_index_referencing_column", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_app_cannot_enforce", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/03-foreign-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_natural_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl