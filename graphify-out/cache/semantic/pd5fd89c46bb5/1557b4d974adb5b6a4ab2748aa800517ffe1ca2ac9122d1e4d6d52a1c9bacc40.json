{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_02_references_vs_values_copy_vs_share", "label": "Primitives copied objects shared", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/02-references-vs-values.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always pass-by-value; for objects the value is a reference. A function can mutate the referent but cannot rebind the caller's name."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_02_references_vs_values_shallow_copy", "label": "Shallow copy", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/02-references-vs-values.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spread and Object.assign copy one level. Nested arrays stay shared; pushing to shallow.items mutates cart.items."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_02_references_vs_values_structuredclone", "label": "structuredClone", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/02-references-vs-values.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default deep copy: handles cycles, Map, Set, Date. Throws DataCloneError on functions and DOM nodes. JSON round-trip mangles those plus undefined, Symbol, NaN."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_02_references_vs_values_structural_sharing", "label": "Structural sharing", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/02-references-vs-values.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React change detection is a reference compare. Return new objects along the changed path; leave untouc