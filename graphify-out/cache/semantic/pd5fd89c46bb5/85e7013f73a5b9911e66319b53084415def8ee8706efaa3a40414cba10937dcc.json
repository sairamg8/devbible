{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_foreach", "label": "Array.prototype.forEach", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always returns undefined and is not chainable. No way to stop other than throwing. Wrong tool if you need break/await."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_map", "label": "Array.prototype.map", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New array, same length, callback return values. Misused as a loop it allocates an array of undefined."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_filter", "label": "Array.prototype.filter", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New array of matches; visits every element. filter(...)[0] is a common misuse of find."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_find", "label": "Array.prototype.find", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First matching element or undefined; stops at the match. findLast searches from the end."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_findindex", "label": "Array.prototype.findIndex", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index of first match, or -1. if (i) is inverted: 0 is falsy and -1 is truthy. Always compare !== -1."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_some", "label": "Array.prototype.some", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "true if any element matches; stops on first true. Empty array \u2192 false."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_every", "label": "Array.prototype.every", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "true if all match; stops on first false. Empty array returns true (vacuous). Gates need length > 0 &&."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_every_empty_true", "label": "every is vacuously true on []", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MDN: for-all over the empty set. cart.every(inStock) passes for an empty cart."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_for_of_control_flow", "label": "for...of for control flow", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "break, continue, return, and await work in for...of and none of them work in forEach. Use the loop when the body is control flow."}, {"id": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_page", "label": "04.1 \u00b7 Choosing a method", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_page", "target": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_foreach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_page", "target": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_methods_01_choosing_a_method_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/04-array-iteration-methods/01-choosing-a-method.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_04_array_iteration_m