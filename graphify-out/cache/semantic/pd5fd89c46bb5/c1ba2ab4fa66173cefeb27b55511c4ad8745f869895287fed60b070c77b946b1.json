{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "label": "The lost update, and four ways to stop it", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_lost_update", "label": "Lost update", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-modify-write under READ COMMITTED: 20 concurrent increments produced qty=2 with no error. Last writer wins with a stale absolute value."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_sql_arithmetic_update", "label": "SQL arithmetic UPDATE", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET qty = qty + 1 is atomic in one statement. Fastest fix (20/20, 37.9 ms) when the new value is expressible in SQL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_select_for_update", "label": "SELECT FOR UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Row lock serialises the read-modify-write so application logic can run. 20/20 correct at 58 ms. Hold the lock only until COMMIT; no I/O in the window."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_optimistic_version_column", "label": "Optimistic version column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE ... WHERE version = $2; rowCount 0 means lost the race. Right for edit forms spanning requests or low contention. Worst on a hot row: 170 retries, 337 ms."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_lost_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_sql_arithmetic_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_select_for_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_optimistic_version_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/lost-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_lost_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_isolation_levels