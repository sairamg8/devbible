{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_sqlstate_http_map", "label": "SQLSTATE to HTTP status map", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "23505\u2192409, 23503\u2192400/409, 23514/23502/22P02/22003\u2192400, 40001/40P01 retry then 503, 42xxx stay 500."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_tohttperror", "label": "toHttpError", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowlists known codes to statuses; unrecognised errors are rethrown so they stay 500s. Returns constraint when present."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_unique_violation_23505", "label": "unique_violation 23505", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every unique index shares code 23505. Switch on err.constraint (named in DDL) to tell email_taken from username_taken."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_42xxx_stay_500", "label": "42xxx codes must stay 500s", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "42703/42601/42P01 mean deployed SQL is wrong. Mapping them to 400 blames the client and hides a broken deploy."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_constraint_name_switch", "label": "Switch on constraint name not message", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "err.message is locale-dependent prose. constraint is populated only for 23xxx; column only for 23502. Name constraints explicitly in DDL."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_detail_leak", "label": "err.detail leaks submitted values", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "23505 detail echoes the key value; 23514 detail is the entire failing row. Log it; return a mapped machine-readable string."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_middleware_not_repository", "label": "Map SQLSTATE in middleware not the repository", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same 23505 is a 409 from signup and a retry signal inside an idempotent write. Only the caller knows which. Translate to domain errors in the repository only when it has intent the middleware cannot."}, {"id": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_app_check_and_constraint", "label": "Validate in the app and still map 23505", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT then INSERT races. Only the unique index closes uniqueness. App checks are UX; the constraint is the correctness boundary."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_tohttperror", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_sqlstate_http_map", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_unique_violation_23505", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_constraint_name_switch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_unique_violation_23505", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_sqlstate_http_map", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_42xxx_stay_500", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_sqlstate_http_map", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/01-repository/03-errors-to-http.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_errors_to_http_constraint_name_switch", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_03_err