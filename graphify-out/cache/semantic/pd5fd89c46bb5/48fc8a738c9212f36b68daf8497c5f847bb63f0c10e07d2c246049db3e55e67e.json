{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_loose_objects", "label": "Loose objects", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One zlib-compressed file per object, written on commit. Path is first two hash characters plus the rest."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_packfile", "label": "Packfile", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".pack holds delta-compressed objects; .idx is hash\u2192offset; .rev is reverse index. Measured 51 objects 204K packed to 6.03 KiB."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_cruft_pack", "label": "Cruft pack", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unreachable objects held with .mtimes for a two-week grace period. Why gc does not shrink a rewritten repo immediately."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_model_unaffected", "label": "Delta compression is below the model", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cat-file still returns whole objects. Hashes are over content, never stored form. Deltas are chosen by similarity, not commit adjacency."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_binaries_no_delta", "label": "Compressed binaries do not delta", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JPEGs, zips, and compiled artefacts neither delta nor compress. Each version is stored near full size forever."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_packfile", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_loose_objects", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_cruft_pack", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_packfile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_loose_objects_and_packfiles_model_unaffected", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/loose-objects-and-packfiles.html", "source_location": null, "weight": 1.0}, {"source": "build_