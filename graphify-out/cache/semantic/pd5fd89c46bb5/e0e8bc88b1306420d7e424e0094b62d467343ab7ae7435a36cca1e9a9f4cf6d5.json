{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_shared_schema_rls", "label": "Shared schema with RLS", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default tenancy model: one migration, trivial cross-tenant queries, scales to millions. Schema/DB-per-tenant for contractual isolation, not reassurance."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_set_local_never_set", "label": "SET LOCAL never SET for tenant identity", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain SET persists on a pooled connection into the next request \u2014 cross-tenant exposure under concurrency when RLS keys on that setting."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_tenant_id_leads", "label": "tenant_id leads every index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query is tenant-scoped via code and RLS, so an index that does not lead with tenant_id cannot serve the filter."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_schema_per_tenant", "label": "Schema- or database-per-tenant", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural isolation at the cost of N migrations, hard cross-tenant queries, and a permanent operational tax. Choose when isolation is a contract."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_shared_schema_rls", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_schema_per_tenant", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_set_local_never_set", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_shared_schema_rls", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_tenant_id_leads", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_shared_schema_rls", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy.html", "source_location": null, "weight": 1.0}], "hyperedges": []}