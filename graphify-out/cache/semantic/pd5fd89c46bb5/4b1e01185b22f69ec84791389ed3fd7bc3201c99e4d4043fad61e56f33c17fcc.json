{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_06_error_tracking_error_tracking", "label": "Error tracking", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/06-error-tracking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sentry, Bugsnag, GlitchTip group the same crash across thousands of events, show the release that introduced it, and page on rate changes."}, {"id": "docs_nodejs_pages_phase_10_observability_06_error_tracking_fingerprinting", "label": "Error fingerprinting", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/06-error-tracking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groups events into issues by root cause. Unique ids in the message string split one bug into hundreds of issues."}, {"id": "docs_nodejs_pages_phase_10_observability_06_error_tracking_release_metadata", "label": "Error tracker release", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/06-error-tracking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An identifier for the code version, often git SHA. Without it, new in this deploy is guesswork."}, {"id": "docs_nodejs_pages_phase_10_observability_06_error_tracking_capture_handled", "label": "captureException on handled failures", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-10-observability/06-error-tracking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you log and continue without captureException, the tracker never sees production's most common failures \u2014 the ones you already catch."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_06_error_tracking_error_tracking", "target": "docs_node