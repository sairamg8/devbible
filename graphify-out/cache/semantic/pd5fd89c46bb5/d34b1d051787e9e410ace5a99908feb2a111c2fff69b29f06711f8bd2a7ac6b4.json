{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_recursive_alias", "label": "Recursive type aliases", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A type may refer to itself through an object, array, or function member. Direct self-reference in an intersection circularly references itself."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_json_value", "label": "JsonValue", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue }. Honest alternative to any for arbitrary JSON. Interfaces lack an implicit index signature and may not satisfy it."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_ts2589", "label": "TS2589 instantiation too deep", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth 50 and 500 compiled; 5000 tripped it on 7.0.2. Means type-level arithmetic or a deep mapped type, not that ordinary nested data is too deep."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_reduce_type_argument", "label": "reduce type argument pins accumulator", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without reduce<number>, the accumulator infers from the array element type (JsonValue), not from the initial 0. Measured TS18047 and TS2365 until the type argument was supplied."}], "edges": [{"source": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_recursive_alias", "target": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_json_value", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_recursive_alias", "target": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_ts2589", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_json_value", "target": "docs_typescript_pages_phase_1_type_vocabulary_06_any_unknown_never_void_any", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_json_value", "target": "docs_typescript_pages_phase_1_type_vocabulary_07_type_vs_interface_type_alias", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/15-recursive-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_reduce_type_argument", "target": "docs_typescript_pages_phase_1_type_vocabulary_15_recursive_types_json_value", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-1-type-vocabulary/1