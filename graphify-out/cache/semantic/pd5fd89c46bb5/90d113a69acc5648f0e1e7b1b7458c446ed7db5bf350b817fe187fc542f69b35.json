{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_key_to_sql_map", "label": "Allowlist is a lookup not validation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the request key into an object whose values are SQL you authored. The user's string never reaches the query. Unknown key is 400."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_orderclause", "label": "orderClause", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Looks up SORTABLE[sortKey], ternaries direction, appends id ASC as a stable tiebreaker so pagination does not duplicate or drop rows."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_direction_ternary", "label": "Direction is a ternary never interpolated", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dir === 'desc' ? 'DESC' : 'ASC' yields one of two literals. Interpolating ${dir} after a looks-like-direction check is the same class of bug."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_null_prototype", "label": "Null-prototype or Map for user keys", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain object resolves ?sort=constructor or __proto__ to something truthy that is not a column."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_filterable_map", "label": "FILTERABLE column and operator map", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any field name (filter, groupBy, fields) has the same hole. Both column and operator come from the map; a client-supplied op is injection."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_quote_ident", "label": "quote_ident and format('%I')", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quoting wraps a payload so ; and -- are characters in a name. It does not check existence, authorization, or sensibility. Use in addition to an allowlist."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_format_placeholders", "label": "format %I %L %s", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "%I quotes as an identifier, %L as a literal, %s is plain substitution. %s on user-influenced input is injection."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_lookup_not_validation", "label": "Allowlist is also the index contract", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sortable columns are a deliberate API decision and the set you have agreed to index. Reflecting information_schema re-adds the leak and exposes internal names."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_orderclause", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_key_to_sql_map", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_orderclause", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_direction_ternary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_key_to_sql_map", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_null_prototype", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_filterable_map", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_02_building_the_allowlist_key_to_sql_map", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/02-building-the-allowlist.md", "source_location": null, "weight": 1.0}