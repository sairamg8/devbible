{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "label": "pg type parsing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL sends text; pg converts by column type OID. json/jsonb arrive parsed, arrays as arrays, bytea as Buffer, NULL as null."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_bigint_as_string", "label": "bigint arrives as string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JS number is exact only to 2^53-1. int8 goes to 2^63-1. Auto-convert would silently corrupt. count(*) therefore returns '12'."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_numeric_as_string", "label": "numeric arrives as string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric is arbitrary precision; float rounding is unacceptable for money. Keep the string and use a decimal library."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_date_local_midnight", "label": "date and timestamp read in Node timezone", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "date becomes Date at local midnight; timestamp assumes local offset. Passes UTC CI and is wrong east of UTC. Keep date as a string."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_timestamptz", "label": "timestamptz as instant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz is a genuine instant and converts correctly. Prefer it for every moment in time."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_postgres_interval", "label": "PostgresInterval object", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Months and days are not fixed durations, so there is no correct millisecond value. Use extract(epoch FROM \u2026) for a number."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_oid", "label": "Type OID parser key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fields[i].dataTypeID selects the parser. Array OIDs are distinct from element OIDs. Custom types get per-database OIDs."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_outbound_json_stringify", "label": "Outbound objects need JSON.stringify", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameters do not auto-serialise objects. Insert JSON.stringify(obj) with $1::jsonb or the column stores [object Object]."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_oid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_bigint_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_numeric_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_date_local_midnight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_timestamptz", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_postgres_interval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/08-type-parsing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_date_local_midnight", "ta