{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff", "label": "Retry and backoff on transient failures", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/retry-backoff.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff_transient_errors", "label": "Transient database errors", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/retry-backoff.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry ECONNREFUSED/57P01/08006 and 40001/40P01 (serialization/deadlock). Never retry 23505, 42601, 28P01. Retry the whole transaction from BEGIN, never one statement (25P02)."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff_idempotent_write", "label": "Idempotent write retry", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/retry-backoff.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A timeout is not knowing whether the write committed. Retry only reads or writes keyed with ON CONFLICT DO NOTHING. Mongo already retries once via retryWrites."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff_transient_errors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/retry-backoff.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff_idempotent_write", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_retry_backoff_transient_errors", "rel