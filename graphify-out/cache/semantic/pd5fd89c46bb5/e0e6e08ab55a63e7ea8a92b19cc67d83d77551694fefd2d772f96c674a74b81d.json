{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_set", "label": "Form-state pseudo-classes", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":checked, :required/:optional, :valid/:invalid, :user-valid/:user-invalid, :placeholder-shown, :indeterminate, :in-range/:out-of-range, :autofill."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_user_invalid", "label": ":invalid vs :user-invalid", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":invalid matches from page load so empty required fields paint red on arrival. :user-invalid waits until the user has interacted \u2014 the CSS replacement for a JS touched flag."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_placeholder_shown", "label": ":placeholder-shown empty-field test", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no :empty for inputs. :placeholder-shown requires a placeholder attribute \u2014 often placeholder=\" \" just to make the selector work."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_appearance_none", "label": "Custom checkbox via appearance: none", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the real input and style it. Hiding it and styling a sibling div removes tab order and accessibility tree membership."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_set", "target": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_user_invalid", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_set", "target": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_placeholder_shown", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_appearance_none", "target": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_set", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_user_invalid", "target": "build_css_p2_docs_css_pages_phase_1_selectors_has_parent_selector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/form-state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_aria_styling", "target": "build_css_p2_docs_css_pages_phase_1_selectors_form_state_pseudo_classes_appearance_none", "relation": "semantically_similar_to", "conf