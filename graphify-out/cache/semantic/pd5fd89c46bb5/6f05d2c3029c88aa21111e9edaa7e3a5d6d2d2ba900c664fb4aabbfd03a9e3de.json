{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "label": "Prototype pollution", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_recursive_merge", "label": "Recursive merge pollution", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading target['__proto__'] returns Object.prototype; the recursive write then assigns isAdmin onto it. Process-wide, persists until restart. constructor.prototype is the other door."}, {"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_json_parse_inert", "label": "JSON.parse is not the vulnerability", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse creates __proto__ as an ordinary own property and does not invoke the setter. Damage happens in the merge, config loader, or path-setter that walks it."}, {"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_blocked_keys", "label": "Block __proto__, constructor, prototype", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three keys, at every nesting level. JSON.parse reviver is a free place. Schema validation that strips unknown keys scales better than remembering each merge."}, {"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_null_prototype_or_map", "label": "Object.create(null) or Map", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No prototype to pollute or inherit from. Map treats keys as values so __proto__ is just a string. Strongest structural defence."}, {"id": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_disable_proto", "label": "--disable-proto and freeze", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--disable-proto=throw aborts the merge. Object.freeze prevents the write but is a silent no-op in sloppy CJS. Neither covers constructor.prototype. structuredClone does not sanitise."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_json_parse_inert", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_recursive_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_blocked_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_null_prototype_or_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_prototype_pollution", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_disable_proto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_recursive_merge", "target": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_blocked_keys", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_13_prototype_pollution_blocked_keys", "target": "docs_nodejs_pages_phase_8_security_08_injection_nosql_injection", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-8-security/13-prototype-pollution.md", "source_location": null, "weight": 1.0}], "hyperedges": []}