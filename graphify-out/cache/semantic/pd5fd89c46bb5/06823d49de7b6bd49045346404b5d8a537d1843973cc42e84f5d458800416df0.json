{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_audit_history_tables_audit_trigger", "label": "Audit trigger", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/audit-history-tables.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AFTER ROW trigger writing to_jsonb(OLD/NEW). Attached to the table so migrations and psql cannot bypass it. Measured ~1.24\u00d7 write cost."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_audit_history_tables_when_is_distinct_from", "label": "WHEN IS DISTINCT FROM", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/audit-history-tables.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated before entering plpgsql so no-op updates skip the call (0.86\u00d7). <> is NULL when either side is NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_audit_history_tables_after_vs_before", "label": "AFTER versus BEFORE triggers", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/audit-history-tables.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEFORE to change the row, AFTER to react. NEW assignment in AFTER is silently discarded; RETURN NULL in BEFORE silently drops the row."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_audit_history_tables_when_is_distinct_from", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_audit_history_tables_audit_trigger", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/audit-history-tables.html", "source_location": n