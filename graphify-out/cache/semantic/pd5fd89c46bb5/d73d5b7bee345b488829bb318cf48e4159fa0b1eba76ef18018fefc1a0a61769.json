{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_rollup", "label": "ROLLUP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROLLUP (a, b) expands to GROUPING SETS ((a,b), (a), ()) \u2014 drop columns from the right. Hierarchy shorthand. n+1 sets. Does not produce per-b totals. ROLLUP (a,b) GROUPING levels are 0, 1 and 3 \u2014 never 2."}, {"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_cube", "label": "CUBE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CUBE (a, b) is every subset: ((a,b), (a), (b), ()). 2^n sets. Three columns is 8, four is 16. Measured 12 rows vs 9 ROLLUP vs 5 plain. Ask for the sets you need instead of reaching for CUBE."}, {"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_empty_grouping_set", "label": "Empty grouping set ()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group by nothing \u2014 the grand-total row over the whole filtered table."}, {"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_mixedaggregate", "label": "MixedAggregate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan node that maintains several hash tables from one pass. One Hash Key line per grouping set over a single Seq Scan."}, {"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_not_parallelized", "label": "Grouping sets are not parallelised", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like-for-like on the same three sets, cached 500k table: GROUPING SETS 293.67 ms vs three separate GROUP BYs 170.22 ms (0.58\u00d7 \u2014 one scan loses). Plain GROUP BY got Gather Merge and two workers. One-pass wins when I/O dominates, not when CPU does."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_rollup", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_readme_grouping_sets", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_cube", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_readme_grouping_sets", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_empty_grouping_set", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_readme_grouping_sets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_mixedaggregate", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_readme_grouping_sets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_not_parallelized", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_readme_grouping_sets", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/01-sets-rollup-cube.md", "source_location": null, "weight": 1.0}], "hyperedges": []}