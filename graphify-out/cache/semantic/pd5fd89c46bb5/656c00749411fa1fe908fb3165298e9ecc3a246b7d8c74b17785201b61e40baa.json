{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_page", "label": "Wrapping a migration in BEGIN/COMMIT", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL transactional DDL is why a failed migration leaves nothing and why forward-only is practical here unlike MySQL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed third CREATE rolled back two successful tables. Tracking insert must share the transaction or applied and recorded diverge."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_no_tx_statements", "label": "Statements that cannot be in a transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE/DROP INDEX CONCURRENTLY, VACUUM, CREATE DATABASE fail with 25001. Runners use a per-file -- migrate: no-transaction directive."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_invalid_index", "label": "INVALID leftover CONCURRENTLY index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed CONCURRENTLY build leaves an unused index that still costs writes. Find with pg_index WHERE NOT indisvalid; DROP and rebuild."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_set_local_lock_timeout", "label": "SET LOCAL lock_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET LOCAL scopes to the transaction so it does not leak onto a pooled connection. 55P03 plus transactional DDL means retry is safe."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/tx-migration.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_tx_migration_transactional_ddl", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_forward_only",