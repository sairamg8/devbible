{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "label": "INSERT \u2026 ON CONFLICT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic upsert. Only correct insert-if-absent. Check-then-insert raced: 20 workers, 20 duplicates, 0 errors. Conflict target needs a unique index (42P10 otherwise)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_excluded_row", "label": "EXCLUDED row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The row that would have been inserted. SET qty = stock.qty + EXCLUDED.qty accumulates; SET qty = EXCLUDED.qty overwrites. WHERE on DO UPDATE skips no-op writes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_xmax_was_insert", "label": "xmax = 0 as was_insert", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RETURNING (xmax = 0) is true for insert, false for update. Implementation detail; prefer created_at vs updated_at if the distinction is load-bearing."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_do_nothing_no_returning", "label": "DO NOTHING returns no row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rowCount 0 and empty RETURNING on skip. Workarounds: no-op DO UPDATE (a real write) or follow-up SELECT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_identity_consumed_on_conflict", "label": "Identity consumed before conflict", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity is generated before conflict detection. Three idempotent two-row seeds left last_value at 6. Harmless because sequences are not gapless."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_excluded_row", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_xmax_was_insert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_do_nothing_no_returning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/on-conflict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_identity_consumed_on_conflict", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, 