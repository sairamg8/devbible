{"nodes": [{"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_event_loop", "label": "Event loop", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent has a heap of objects, a LIFO stack of execution contexts, and a FIFO queue of jobs. The loop pulls one job, runs until the stack is empty, then pulls the next."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_heap", "label": "Heap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large unstructured memory region populated as objects are created. No order."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_call_stack", "label": "Call stack", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIFO execution contexts. Finite; V8 does not implement proper tail calls. An async continuation starts a fresh stack."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_queue", "label": "Job queue", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIFO jobs from platform completions and from .then, queueMicrotask and await. Enables async while remaining single-threaded."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_complete_when_stack_empty", "label": "A job is complete when the stack is empty", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MDN definition of run-to-completion. Nothing else \u2014 timer, event, rendering \u2014 runs until the call stack fully unwinds."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_settimeout_minimum", "label": "setTimeout delay is a minimum", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The callback also waits for the current job, every job queued ahead, and the entire microtask queue. A floor, not a schedule."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_no_tail_call_optimisation", "label": "No tail-call optimisation in V8", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec defines proper tail calls; V8 does not implement them. Deep recursion overflows regardless of how it is written."}, {"id": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_node_vs_browser_event_loop", "label": "Node vs browser event loops", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "libuv phases plus process.nextTick versus the HTML loop with rendering. Only 'microtasks before tasks' is asserted for both."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_event_loop", "target": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_heap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_event_loop", "target": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_call_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_event_loop", "target": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_complete_when_stack_empty", "target": "docs_javascript_pages_phase_7_async_01_sync_vs_async_01_one_thread_run_to_completion", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/02-the-event-loop/01-stack-queue-heap.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_job_complete_when_stack_empty", "target": "docs_javascript_pages_phase_7_async_02_the_event_loop_01_stack_queue_heap_event_loop", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/ph