{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_shared_schema_default", "label": "Shared schema as the tenancy default", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/choosing-a-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only model that scales to thousands of tenants; migrations run once; reporting is ordinary SQL. Weak isolation is bought back with repository + RLS + tests."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_tenant_id_leads_indexes", "label": "tenant_id leads every index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/choosing-a-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query is tenant-scoped (explicitly and via RLS). Index (created_at) is nearly useless; (tenant_id, created_at) serves the real filter. Most common shared-schema perf failure."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_per_tenant_uniqueness", "label": "Uniqueness is per tenant", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/choosing-a-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE (tenant_id, slug) so tenant B can reuse a slug tenant A took. A global unique is unintended cross-tenant coupling."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_rls_restrictive_force", "label": "RESTRICTIVE RLS plus FORCE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/choosing-a-model.html", "source_location": null, "source_url": null, "captured_at": 