{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints", "label": "Savepoints and partial rollback", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "label": "SAVEPOINT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only way to survive a statement error inside a transaction. Must be taken before the risky statement. Prefer ON CONFLICT when a single statement can express recovery."}, {"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_rollback_to", "label": "ROLLBACK TO SAVEPOINT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_release", "label": "RELEASE SAVEPOINT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_subtransaction_xid", "label": "Savepoint subtransaction XIDs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each writing savepoint burns a real xid. 2000 inserts 2.3\u00d7 slower wrapped in SAVEPOINT/RELEASE (599.8 ms \u2192 1362.5 ms). Past 64 subxids the cache overflows and other sessions hit SubtransSLRU."}, {"id": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_no_nested_tx", "label": "No nested transactions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORMs implement nesting as SAVEPOINT. An inner commit is RELEASE; the outer rollback still discards it."}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_09_savepoints", "target": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_rollback_to", "target": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_release", "target": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "target": "docs_postgresql_pages_phase_11_mvcc_01_acid_25p02", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/09-savepoints.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_subtransaction_xid", "target": "docs_postgresql_pages_phase_11_mvcc_09_savepoints_savepoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "