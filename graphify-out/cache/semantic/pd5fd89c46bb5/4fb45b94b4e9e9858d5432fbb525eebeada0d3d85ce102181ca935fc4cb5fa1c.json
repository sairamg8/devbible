{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "label": "pool.connect and release", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checkout is yours until release(). A missed release never returns the connection. release() does not close, roll back, or reset session state."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_counters", "label": "Pool total idle waiting counters", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "totalCount, idleCount, waitingCount. A request past max waits rather than errors. Sustained waitingCount > 0 is the leak or undersize signal."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_connection_leak", "label": "Pooled connection leak", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thrown query before release() loses the client for process lifetime. After max leaks, later requests hang until connectionTimeoutMillis."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_with_client", "label": "withClient helper", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never write checkout by hand. connect, run fn(client), release in finally so every path returns the client."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_with_transaction", "label": "withTransaction helper", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN/COMMIT must share one connection. Wrap ROLLBACK so a dead connection does not mask the original error. release() stays in finally."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_release_true", "label": "release(true) destroys the connection", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Truthy release discards the socket. Use after FATAL, client-side query_timeout, or unknown session state so one bad request cannot poison later borrows."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_discard_all", "label": "DISCARD ALL before release", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "release() keeps search_path, temp tables, and prepared statements. DISCARD ALL resets them but cannot run inside a transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_connection_leak", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_counters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_with_client", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_connection_leak", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_with_transaction", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_release_true", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_query_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_discard_all", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_connection_leak", "target": "docs_postgresql_pages_phase_7_pg_driver_11_timeouts_connection_timeout_millis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/07-connect-release.md", "source_location": null, "weight": 1.0}], "hyperedges": []}