{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_postgresql_from_node", "label": "PostgreSQL from Node", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg is the driver Knex, Drizzle, Prisma adapters and TypeORM sit on; learn it so the layer above is never magic."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_pool_vs_client", "label": "pg Pool vs Client", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pool is the default for servers. Client or pool.connect() only when consecutive statements must share one connection: transactions, cursors, LISTEN, migrations."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_int8_numeric_as_string", "label": "int8 and numeric as strings", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither fits JS number safely. Returning a float would corrupt money and large ids, so count(*) + 1 concatenates to \"50001\"."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_date_column_trap", "label": "pg date column trap", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DATE becomes a Date at local midnight; JSON.stringify ships yesterday in UTC+05:30. Keep DATE as YYYY-MM-DD via setTypeParser(1082)."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_returning", "label": "RETURNING", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated row in the same round trip as the write, with no race. select max(id) after insert can see another transaction."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_prepared_statements", "label": "Named prepared statements", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server plans once per connection. Measured 120 ms to 78 ms for 200 lookups. One name must always mean one SQL."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_listen_notify", "label": "LISTEN / NOTIFY", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs a dedicated Client. Fire-and-forget: a disconnected listener misses payloads. Cache invalidation or wake-up, never a queue."}, {"id": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_sqlstate_codes", "label": "SQLSTATE error codes", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match err.code not err.message. 23505 unique, 23503 FK, 25P02 aborted tx, 57014 timeout, 53300 too many clients."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_postgresql_from_node", "target": "docs_nodejs_pages_phase_6_data_access_10_repository_pattern_repository_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_postgresql_from_node", "target": "docs_nodejs_pages_phase_6_data_access_05_mongodb_from_node_mongodb_from_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_listen_notify", "target": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_pool_vs_client", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_int8_numeric_as_string", "target": "docs_nodejs_pages_phase_6_data_access_10_repository_pattern_driver_types_must_not_leak", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_listen_notify", "target": "docs_nodejs_pages_phase_7_background_work_02_job_queues_queue_properties", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/04-postgresql-from-node.md", "source_location": null, "weight": 1.0}], "hyperedges": []}