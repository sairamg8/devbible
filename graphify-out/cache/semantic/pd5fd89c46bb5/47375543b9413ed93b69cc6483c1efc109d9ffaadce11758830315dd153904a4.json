{"nodes": [{"id": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_topic", "label": "TypeScript is a checker, not a runtime", "file_type": "document", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/01-static-checker-not-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_emit_on_error", "label": "tsc emit-on-error default", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/01-static-checker-not-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tsc reports errors and emits JavaScript anyway, exit 2. --noEmitOnError stops output. A build that ignores the exit code ships broken output."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_tsc_noemit", "label": "tsc --noEmit CI gate", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/01-static-checker-not-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If tsc --noEmit does not run somewhere automatic, you are writing JavaScript with extra syntax."}], "edges": [{"source": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_topic", "target": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_emit_on_error", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/01-static-checker-not-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_0_how_typescript_runs_01_static_checker_not_runtime_topic", "target": "docs_typescript_pages_phase_0_how_typescript_runs_01_static