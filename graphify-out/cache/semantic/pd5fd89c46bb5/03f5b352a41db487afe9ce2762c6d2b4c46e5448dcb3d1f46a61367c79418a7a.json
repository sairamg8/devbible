{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery", "label": "Naming a subquery", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_cte_named_subquery", "label": "CTE as named subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WITH names a query so the outer statement can read it like a table."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_no_forward_refs", "label": "No forward references", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE cannot refer to a later sibling unless the WITH is RECURSIVE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_shadowing", "label": "CTE name shadowing", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE name hides a same-named table in that statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_with_on_dml", "label": "WITH on DML", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WITH can wrap INSERT/UPDATE/DELETE and RETURNING, not only SELECT."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_cte_named_subquery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_no_forward_refs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_shadowing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_with_on_dml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/naming-a-subquery.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_naming_a_subquery_cte_named_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries", "