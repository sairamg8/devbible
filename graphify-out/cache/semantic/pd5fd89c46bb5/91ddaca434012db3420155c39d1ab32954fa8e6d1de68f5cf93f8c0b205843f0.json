{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_parameter_trap", "label": "Parameters do not protect the log", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured: pg_stat_activity shows $1, but log_statement=all writes DETAIL Parameters. log_parameter_max_length defaults to -1 (full). Treat logs as credential-bearing."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_alter_role_password_log", "label": "ALTER ROLE PASSWORD logs plaintext", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCRAM stores a verifier; the statement still contains the literal. log_statement=ddl captures it. Use psql \\password to send only the verifier."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_auto_explain", "label": "auto_explain", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs the plan at the moment a query was slow. Load via shared_preload_libraries (restart), session_preload_libraries, or LOAD."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_log_analyze_overhead", "label": "auto_explain.log_analyze instruments every statement", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs warn of extremely negative impact: per-node timing applies to all statements, not only logged ones. Mitigate with log_timing=off or sample_rate; enable only while investigating."}, {"id": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_log_parameter_max_length_on_error", "label": "log_parameter_max_length_on_error defaults to 0", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failed statements do not log parameters by default. Why many developers never see parameter logging and conclude it never happens."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_parameter_trap", "target": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_statement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_alter_role_password_log", "target": "docs_postgresql_pages_phase_13_ops_11_logging_01_what_to_log_log_statement", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-explain.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_log_analyze_overhead", "target": "docs_postgresql_pages_phase_13_ops_11_logging_02_parameters_and_auto_explain_auto_explain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/11-logging/02-parameters-and-auto-exp