{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_default_string_sort", "label": "Default sort is string sort", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts to strings and compares UTF-16 code units, so [1,30,4,21,100000] becomes [1,100000,21,30,4]."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_comparator_contract", "label": "sort comparator contract", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Negative before, positive after, zero or NaN equal. Only the sign matters, so a-b works for numbers."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_five_consistency", "label": "Five comparator consistency rules", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure, stable, reflexive, anti-symmetric, transitive. Violations do not throw; order is implementation-defined."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_fisher_yates", "label": "Fisher-Yates shuffle", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sort(() => Math.random()-0.5) breaks every consistency rule. Use Fisher-Yates."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_decorate_sort_undecorate", "label": "Decorate-sort-undecorate", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map to {item,key}, sort on key, map back. Avoids O(n log n) key recomputation and unstable computed keys."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_default_string_sort", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_comparator_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_five_consistency", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_comparator_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/sort/the-default-and-the-comparator.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_fisher_yates", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_sort_the_default_and_the_comparator_five_consistency", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0,