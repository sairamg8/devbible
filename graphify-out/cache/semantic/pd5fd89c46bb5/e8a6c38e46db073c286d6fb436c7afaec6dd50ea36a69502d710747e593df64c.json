{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_readme_zero_downtime_ddl", "label": "Zero-downtime schema changes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The migration that takes the site down is fast; it spends its time waiting. Deployment view; statement timings live in Phase 3."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_readme_waiting_access_exclusive", "label": "Waiting ACCESS EXCLUSIVE blocks the queue", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New queries do not jump the queue. A DDL blocked by one slow reader makes the table unavailable before it has run. lock_timeout is not optional."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_readme_schema_code_never_simultaneous", "label": "Schema change and code deploy are never simultaneous", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "During a rolling deploy old and new code share one schema. Never remove in the same step that adds a replacement."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_readme_waiting_access_exclusive", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_access_exclusive_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pag