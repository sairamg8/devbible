{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_package_managers", "label": "npm, pnpm, yarn and workspaces", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_hoisting", "label": "node_modules hoisting", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm and yarn flatten transitive deps into top-level node_modules so duplicates collapse; that is how undeclared imports can accidentally resolve."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_phantom_dependencies", "label": "phantom dependencies", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A package your code imports without declaring it because hoisting put it at top-level. Breaks when the real dependent drops it."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_pnpm_store", "label": "pnpm content-addressable store", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One copy per version in a global store; node_modules is symlinks exposing only declared deps. Undeclared require fails immediately; disk is shared across projects."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_corepack", "label": "Corepack", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pins package manager version via packageManager field. Ships with Node but must be enabled once per machine."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_workspaces", "label": "npm workspaces", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One install and one lockfile; local packages are symlinked. Do not give build orchestration. Root needs private:true to block accidental publish."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_package_managers", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_hoisting", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_phantom_dependencies", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_pnpm_store", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_managers_phantom_dependencies", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-managers.html", "source_location": null, "weight": 