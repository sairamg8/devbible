{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo", "label": "15.2 Restoring, timelines and RPO/RTO", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_pitr", "label": "Point-in-time recovery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PITR trades procedure for precision: more steps than a logical restore, in exchange for landing on the exact second before the damage. Value is contingent on rehearsal."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_recovery_signal", "label": "recovery.signal versus standby.signal", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_timelines", "label": "PostgreSQL timelines", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new timeline after recovery keeps original WAL history intact so a wrong PITR is not fatal."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_rpo", "label": "Recovery point objective", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_rto", "label": "Recovery time objective", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A restore you have never timed is not a recovery plan, it is a hope."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_recovery_target_action", "label": "recovery_target_action pause", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default pause lets you verify the landing point before promoting; promote immediately forecloses a retry."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_pitr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_pitr", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_physical_backup_restoring_and_rpo_timelines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/physical-backup/restoring-and-rpo.html", "source_location": null, "weight":