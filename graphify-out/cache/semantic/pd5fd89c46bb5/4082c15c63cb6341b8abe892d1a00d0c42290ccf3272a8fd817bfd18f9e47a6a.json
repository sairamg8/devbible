{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_if_not_exists_not_a_migration", "label": "IF NOT EXISTS is not a migration system", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/if-not-exists.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent, not concurrency-safe, not a definition check, and leaves no version record. Migrations fail loudly when a database is in an unexpected state."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_if_not_exists_race", "label": "CREATE TABLE IF NOT EXISTS race", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/if-not-exists.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "228 of 500 concurrent attempts failed with 23505 on pg_type_typname_nsp_index. Catalog check and insert are not one atomic step."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_if_not_exists_name_only", "label": "IF NOT EXISTS is a name-only check", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/if-not-exists.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not compare columns, types, constraints or indexes. ADD COLUMN IF NOT EXISTS with a different type is a silent no-op and a type mismatch."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_if_not_exists_not_a_migration", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_if_not_exists_race", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/if-not-exists.html", "source_location"