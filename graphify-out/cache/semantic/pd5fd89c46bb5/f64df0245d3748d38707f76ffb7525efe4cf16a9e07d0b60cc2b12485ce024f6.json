{"nodes": [{"id": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost", "label": "The cost, and how to pay less of it", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_blast_radius", "label": "Lifting moves the re-render", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A state change re-renders that component and all descendants by default. Children re-render because the parent did, not because a prop changed."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_push_down", "label": "Push state down", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If only one branch reads the state, extract that branch and move the state into it. The large component stops re-rendering."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_memo_last", "label": "memo is last resort", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shallow compare is not free, fails on fresh objects, and does not stop context. Structural fixes survive the Compiler; hand memoization largely does not."}, {"id": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_lift_vs_context", "label": "Lift then compose then context then store", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two or three siblings lift. Threads through unused layers compose. Rarely changing many-depth values use context. Frequent sliced updates use an external store. Server data is a cache."}], "edges": [{"source": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost", "target": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_blast_radius", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_children_skip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_memo_last", "target": "docs_react_pages_phase_2_components_15_purecomponent_shallow_comparison", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_memo_last", "target": "docs_react_pages_phase_2_components_02_purity_03_strictmode_and_the_compiler_compiler", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/05-lifting-state-up/02-the-cost.md", "source_location": null, "weigh