{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_03_json_and_hand_written_json_round_trip_clone", "label": "JSON round-trip clone", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/03-json-and-hand-written.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse(JSON.stringify(x)) is still the most-written deep clone and is lossy in seven documented ways. Acceptable only when data is already JSON-shaped with no cycles."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_03_json_and_hand_written_json_seven_losses", "label": "JSON.stringify seven losses", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/03-json-and-hand-written.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined/functions/symbols dropped in objects and nulled in arrays; NaN/Infinity become null; Date becomes a string; Map/Set become {}; BigInt and cycles throw; symbol keys and non-enumerable properties ignored."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_03_json_and_hand_written_handwritten_deep_clone", "label": "Hand-written deep clone with WeakMap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/03-json-and-hand-written.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register the clone in a WeakMap before recursing so cycles terminate and shared identity is preserved. Handle Date, RegExp, Map and Set with their constructors. In production call structuredClone."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_03_jso