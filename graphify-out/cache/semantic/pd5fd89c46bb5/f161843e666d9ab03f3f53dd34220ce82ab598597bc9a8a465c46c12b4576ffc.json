{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_silent_error_recovery", "label": "CSS fails silently", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mistake is discarded with no console message, exception, or build failure. A typo and a future feature are indistinguishable to the engine."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_blast_radii", "label": "Declaration vs selector blast radius", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An invalid declaration is dropped locally; an invalid selector in a plain comma list discards the whole rule; an unclosed brace swallows following rules."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_forward_compatibility", "label": "Silent drop enables forward compatibility", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If unknown syntax were fatal, no new CSS feature could ship without breaking older browsers. Progressive enhancement depends on this generosity."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_css_supports", "label": "CSS.supports and style round-trip", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only APIs that volunteer validity: CSS.supports(property, value), or assign to element.style and read back \u2014 empty string means rejected."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_forward_compatibility", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_silent_error_recovery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_silent_error_recovery", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_blast_radii", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_silent_error_recovery", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_css_supports", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_forward_compatibility", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_supports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/css-fails-silently.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_silent_error_recovery", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_baseline_and_shipping_three_states", "relation": "re