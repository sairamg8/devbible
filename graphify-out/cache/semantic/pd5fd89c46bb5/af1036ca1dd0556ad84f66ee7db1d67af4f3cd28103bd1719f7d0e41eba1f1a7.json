{"nodes": [{"id": "static_img_docusaurus_social_card", "label": "Docusaurus Social Card", "file_type": "image", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default Docusaurus Open Graph / social-share card. Landscape branding layout: gradient wordmark on top, dinosaur mascot holding a document on the left, two-line value proposition on the right. Soft mint-to-white-to-sky background keeps the mark readable as a link preview."}, {"id": "static_img_docusaurus_social_card_docusaurus", "label": "Docusaurus", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "static_img_docusaurus_social_card_wordmark", "label": "Docusaurus Gradient Wordmark", "file_type": "image", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large sans-serif product name centered at the top. Letters shift from brand blue on the left through teal to green on the right, matching the keyword-highlight green used in the taglines."}, {"id": "static_img_docusaurus_social_card_dinosaur_mascot", "label": "Docusaurus Dinosaur Mascot", "file_type": "image", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat green cartoon dinosaur (alligator-like body, four back spikes, closed smiling eyes, wavy mouth, rounded feet) standing on the left. The mascot personifies the Docusaurus name and makes the docs-site brand approachable rather than enterprise-formal."}, {"id": "static_img_docusaurus_social_card_lined_document", "label": "Yellow Lined Document", "file_type": "image", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yellow page with four horizontal text lines, held against the mascot's chest. Visual stand-in for authored documentation \u2014 the content the product exists to publish."}, {"id": "static_img_docusaurus_social_card_build_optimized_websites", "label": "Build Optimized Websites", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First tagline. 'optimized' is painted in brand green so performance of the generated site is the claimed differentiator."}, {"id": "static_img_docusaurus_social_card_focus_on_your_content", "label": "Focus on Your Content", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second tagline. 'content' is painted in brand green. Pairs with the yellow document the mascot holds: authors write docs, the framework handles the site."}, {"id": "static_img_docusaurus_social_card_content_first_authoring", "label": "Content-First Authoring", "file_type": "rationale", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The card's second promise and the document-in-arms illustration argue that Docusaurus exists so writers stay in markdown/docs rather than site-engineering."}, {"id": "static_img_docusaurus_social_card_optimized_static_sites", "label": "Optimized Static Websites", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "static_img_docusaurus_social_card_open_graph_preview", "label": "Open Graph Social Preview", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filename and landscape composition mark this as the site's default social-share image: brand identity plus a two-beat pitch that remain readable at thumbnail size."}, {"id": "static_img_docusaurus_social_card_keyword_highlight", "label": "Green Keyword Highlight", "file_type": "rationale", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 'optimized' and 'content' are green; the rest of each line is black. The two highlighted words are the product claims the card wants a scroller to retain."}, {"id": "static_img_docusaurus_social_card_brand_palette", "label": "Blue Teal Green Brand Palette", "file_type": "concept", "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "static_img_docusaurus_social_card", "target": "static_img_docusaurus_social_card_docusaurus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "weight": 1.0}, {"source": "static_img_docusaurus_social_card", "target": "static_img_docusaurus_social_card_wordmark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "static/img/docusaurus-social-card.jpg", "source_location": null, "weight": 1.0}, {"source": "static_img_docusaurus_social_card", "target": "static_img_docusaurus_social_card_dinosaur_mascot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "static/img/docusaurus-social-card.jpg", "