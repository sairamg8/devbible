{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_set_type_parser", "label": "pg.types.setTypeParser", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One process-wide registry. Affects every pool, query, and library using pg. Register once before opening the pool."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_date_to_string", "label": "Override date OID 1082 to string", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The almost-always-right global override. A date is a calendar label; Date-at-local-midnight produces off-by-one days."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_int8_override", "label": "int8 parser Number vs BigInt", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number is silent-lossy above 2^53-1. BigInt is exact but contagious and JSON.stringify throws. Corpus default: cast per query."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_type_overrides", "label": "TypeOverrides per query", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes a parser to one query or one pool. Safe form when a single report needs numbers and the rest of the app does not."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_sql_casts", "label": "SQL casts instead of global parsers", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No global state, visible at the call site. Overflow raises rather than silently truncating."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_array_oids", "label": "Array types have their own OIDs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing 1700 (numeric) does not change 1231 (numeric[]). Override both or aggregated columns surprise you."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_custom_type_oid", "label": "Custom type OID lookup in pg_type", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enums, domains, composites get OIDs at creation. Look them up at startup; never hard-code."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_set_type_parser", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_parsing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_set_type_parser", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_parsing_type_oid", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/09-pg-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_09_pg_types_date_to_string", "target": "docs_postgresql_pages_phase_7_pg_driver_08_type_p