{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_window_sort_cost", "label": "Window sort dominates cost", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One window over 500k: 530 ms, 8560 kB disk sort. Plain count(*) is 26.73 ms. Matching btree (PARTITION BY then ORDER BY) dropped it to 283 ms index-only scan, 575 buffers, no temp I/O."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_shared_window_sort", "label": "Compatible windows share one sort", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same partition: one Sort, 999 ms. Different partitions: two Sorts, 1518 ms, 3.4\u00d7 temp I/O. Second WindowAgg is not free even sharing a sort (~470 ms). Align PARTITION BY or split queries."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_windowagg_not_parallel", "label": "WindowAgg is not parallel-aware", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Gather in the plan. Extra cores do not help. Two 530 ms queries overlapped from the app beat one 1518 ms serial dual-window query."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_window_sort_cost", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_shared_window_sort", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_windowagg_not_parallel", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_window_sort_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_shared_window_sort", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_rank", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/what-windows-cost.html", "source_location": null, "weight": 1.0}], "hyperedges": []}