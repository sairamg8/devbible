{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_06_roles_role", "label": "Role", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/06-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real catalog object (CREATE ROLE). User and group are both roles wearing different habits."}, {"id": "docs_postgresql_pages_phase_0_architecture_06_roles_login_vs_nologin", "label": "LOGIN user vs NOLOGIN group", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/06-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user is a role with LOGIN. A group is usually a role without LOGIN used for membership. GRANT group TO login."}, {"id": "docs_postgresql_pages_phase_0_architecture_06_roles_session_user_current_user", "label": "session_user vs current_user", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/06-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "session_user is who authenticated; current_user can change after SET ROLE. Node uses the connection-string role unless SET ROLE is used."}, {"id": "docs_postgresql_pages_phase_0_architecture_06_roles_least_privilege", "label": "Least-privilege app role", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/06-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container bootstrap user is a superuser \u2014 fine for local learning, wrong as the production app role. App should do DML on app tables, not drop the database or bypass RLS."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_06_roles_role", "target": "docs_postgresql_pages_phase_0_architecture_06_roles_login_v