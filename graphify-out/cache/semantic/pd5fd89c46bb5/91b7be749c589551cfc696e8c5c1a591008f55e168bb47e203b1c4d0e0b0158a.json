{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter", "label": "Exponential backoff and jitter", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/backoff-and-jitter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter_full_jitter", "label": "Full jitter", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/backoff-and-jitter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "random(0, backoff) breaks synchronized retry waves. 500 clients no-jitter all landed in one 100 ms bucket; full jitter max bucket 122. Equal jitter when a minimum spacing is required."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter_thundering_herd", "label": "Thundering herd of retries", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/backoff-and-jitter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlated failures plus deterministic backoff make every client retry at once, knocking a recovering service over again. Backoff sets rate; jitter breaks sync. A circuit breaker stops calls."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter", "target": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter_full_jitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/backoff-and-jitter.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter", "target": "buil