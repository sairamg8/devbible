{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_page", "label": "Callbacks, promisify and callbackify", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_error_first_callback", "label": "Error-first callback convention", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cb(err) or cb(null, value), exactly once, always asynchronously. Mixed sync/async firing is why you defer early returns with process.nextTick."}, {"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_promisify", "label": "util.promisify", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assumes last argument is error-first (err, value) called once. Multiple success values, wrong this, or non-standard shape need a manual wrapper or promisify.custom."}, {"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_callbackify", "label": "util.callbackify", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hands an async function to a callback consumer. Rare in apps; for libraries keeping a callback API over promises."}, {"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_promisify_custom", "label": "util.promisify.custom", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Author-defined promise form when the mechanical translation is wrong. promisify checks that symbol first."}, {"id": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_new_promise_only_for_wrapping", "label": "new Promise only wraps callback APIs", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one legitimate use of the Promise constructor. Prefer built-in fs/promises, dns/promises, timers/promises, stream/promises over promisify."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_page", "target": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_error_first_callback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_page", "target": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_promisify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_page", "target": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_callbackify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/13-callbacks-and-promisify.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_13_callbacks_and_promisify_promisify_custom", "target": "docs_nodejs_pages_phase_2_async_13_callbacks