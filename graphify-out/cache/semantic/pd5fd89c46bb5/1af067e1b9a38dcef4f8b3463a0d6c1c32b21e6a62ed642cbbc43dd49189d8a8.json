{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_the_cost", "label": "The cost of lifting state", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_blast_radius", "label": "Re-render blast radius moves up", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A child re-renders because its parent did. Prop comparison is not the default path."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_right_level", "label": "Own state at the closest common parent", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every extra level adds a subtree. Push state down when only one branch reads it."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_children_isolation", "label": "Pass expensive subtrees as children", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The element object is created outside the stateful wrapper, so React skips that subtree without memo."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_split_by_frequency", "label": "Split state or components by update frequency", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_memo_last", "label": "memo is last, not first", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparison cost, silent failure on fresh objects, no context stop. Structural fixes survive the Compiler."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_vs_context_store", "label": "Lift vs composition vs context vs store", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server data is a cache, not lifted UI state. Props first, composition next, context when props become unwieldy."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_blast_radius", "target": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_right_level", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cost.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_cost_children_isolation", "target": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_context_hole", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-cos