{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_08_index_only_index_only_scans", "label": "Index-only scans, INCLUDE and the visibility map", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/08-index-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_08_index_only_index_only_scan", "label": "Index-only scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/08-index-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers from the index alone only if every selected column is in the index and the visibility map says heap pages are all-visible."}, {"id": "docs_postgresql_pages_phase_10_indexes_08_index_only_visibility_map", "label": "Visibility map", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/08-index-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VACUUM sets all-visible bits. Without them PostgreSQL must check each row in the heap; one UPDATE took Heap Fetches from 0 to 58."}, {"id": "docs_postgresql_pages_phase_10_indexes_08_index_only_include", "label": "INCLUDE columns", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/08-index-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payload in the leaves only \u2014 returnable, not searchable or sortable. Required when the index is UNIQUE and the key must not change."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_08_index_only_index_only_scans", "target": "docs_postgresql_pages_phase_10_indexes_08_index_only_index_only_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgr