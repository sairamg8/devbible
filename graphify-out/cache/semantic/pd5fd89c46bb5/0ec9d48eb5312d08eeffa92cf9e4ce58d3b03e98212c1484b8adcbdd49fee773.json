{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_09_delete_soft_hard_page", "label": "delete hard vs soft", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/09-delete-soft-hard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_09_delete_soft_hard_hard_delete", "label": "Hard delete with RETURNING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/09-delete-soft-hard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ON DELETE CASCADE fires. Missing row is rowCount 0, not an error \u2014 map to 404."}, {"id": "docs_postgresql_pages_phase_9_api_crud_09_delete_soft_hard_soft_delete", "label": "Soft delete as UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/09-delete-soft-hard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET deleted_at = now() WHERE deleted_at IS NULL. Foreign keys do not cascade. Every query must filter forever."}, {"id": "docs_postgresql_pages_phase_9_api_crud_09_delete_soft_hard_partial_unique", "label": "Partial unique index for live emails", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/09-delete-soft-hard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A full unique index blocks re-registration with 23505. CREATE UNIQUE INDEX ... WHERE deleted_at IS NULL. The partial index is unusable if the query omits that predicate."}, {"id": "docs_postgresql_pages_phase_9_api_crud_09_delete_soft_hard_not_audit", "label": "Soft delete is not an audit log", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/09-delete-soft-hard.md", "source_location": null, "source_url": n