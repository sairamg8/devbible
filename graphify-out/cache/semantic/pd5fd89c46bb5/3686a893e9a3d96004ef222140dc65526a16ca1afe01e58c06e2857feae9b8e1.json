{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin_and_trigrams", "label": "GIN for jsonb, arrays and full text; pg_trgm for LIKE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin", "label": "GIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexes the parts of a value so @>, @@ and LIKE '%x%' become indexable. 130\u00d7 faster on a one-row match, slower than seq scan on a 16% match."}, {"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_jsonb_ops_vs_path_ops", "label": "jsonb_ops vs jsonb_path_ops", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path_ops is smaller and faster for @> but cannot serve ? / ?| / ?&. Default to jsonb_ops."}, {"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_pg_trgm", "label": "pg_trgm", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes infix LIKE indexable. Short patterns under three characters return most of the table and can be slower than a sequential scan."}, {"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gist_trgm", "label": "gist_trgm_ops distance ordering", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIN cannot do <-> nearest-neighbour at all; GiST did it in 110 ms versus 766 ms seq scan, at 48 MB against GIN's 13 MB."}, {"id": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_pending_list", "label": "GIN pending list", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffers inserts so the 3.2\u00d7 write cost is deferred into VACUUM or a later query; fastupdate=off trades insert speed for predictable reads."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin_and_trigrams", "target": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin", "target": "docs_postgresql_pages_phase_10_indexes_02_btree_btree", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_jsonb_ops_vs_path_ops", "target": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_pg_trgm", "target": "docs_postgresql_pages_phase_10_indexes_11_gin_trgm_gin", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/11-gin-trgm.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_pha