{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_the_dependency_array", "label": "The dependency array is not a preference", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_reactive_values", "label": "Reactive values", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Props and all variables and functions declared directly inside the component. Setters, dispatch, and ref objects are stable and not dependencies."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_cannot_choose", "label": "You cannot choose Effect dependencies", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every reactive value the setup reads must be declared. The list is determined by the surrounding code."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_stale_forever", "label": "Omitted deps freeze the first render", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty array means only the first setup ever runs, so the effect keeps that render's roomId forever. No error, quietly wrong."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_exhaustive_deps", "label": "react-hooks/exhaustive-deps", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes the correct array from the code. Disabling converts a compile-time complaint into a runtime bug months later."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_cannot_choose", "target": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_reactive_values", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_stale_forever", "target": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_exhaustive_deps", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_the_dependency_array", "target": "build_css_p2_docs_react_pages_phase_4_effects_useeffectevent_useeffectevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_the_dependency_array", "target": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_removing_dependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/the-dependency-array.html", "source_location": null, "weight": 1.0}], "hyperedges": []