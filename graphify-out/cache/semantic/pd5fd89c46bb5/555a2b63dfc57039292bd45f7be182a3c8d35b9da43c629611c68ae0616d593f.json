{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates", "label": "Fan-out and aggregates", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_fan_out", "label": "Join fan-out", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicated parent rows make sum(o.total) 450 against a true 350. The join changes grain; the aggregate is then applied at the wrong grain."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_grain", "label": "Result grain", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A join sets grain to the finest side. Aggregates are correct only on columns at that grain."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_pre_aggregate", "label": "Pre-aggregate the child then join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduce the child to one row per parent before joining so no multiplication happens."}, {"id": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_count_distinct", "label": "count(DISTINCT) rescues counts only", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum(DISTINCT o.total) collapses different orders that share a total. DISTINCT on the query removes rows, not contributions."}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_fan_out", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_grain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_pre_aggregate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates", "target": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_and_aggregates_count_distinct", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/01-inner-join/02-fan-out-and-aggregates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_01_inner_join_02_fan_out_a