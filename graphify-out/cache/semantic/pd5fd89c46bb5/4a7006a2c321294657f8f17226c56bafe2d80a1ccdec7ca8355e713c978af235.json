{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_values_as_table", "label": "VALUES as a table", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/values-unnest.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT FROM (VALUES \u2026) AS t(cols) joins a client list without a temp table. Types are inferred from the first row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_unnest", "label": "unnest", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/values-unnest.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several arrays unnest in parallel, not as a cross join. Shorter arrays pad with NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_bulk_bridge", "label": "unnest bulk-parameter bridge", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/values-unnest.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5000 rows through exactly 3 parameters. One statement shape forever, so the plan cache does not fragment."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_any_array", "label": "col = ANY($1::type[])", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/values-unnest.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter replaces a generated IN list and avoids the NOT IN NULL trap."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_unnest", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_values_unnest_values_as_table", "relation": "conceptually_related_to"