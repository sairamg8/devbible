{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_rule", "label": "Shorthand writes all longhands", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shorthand is a complete statement of a concept, not a patch. Omitted sub-values reset to initial, so they override earlier longhands you never named."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_border_image", "label": "border resets border-image", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "border sets border-image to none even though the name does not imply it. Declare border first, then border-image."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_font", "label": "font resets line-height", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "font resets line-height to normal unless the size/line-height form is used, collapsing vertical rhythm."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_grid_template", "label": "grid vs grid-template", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "grid resets implicit-grid longhands including grid-auto-flow; grid-template is the narrower shorthand."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_mdn_shorthand", "label": "MDN Shorthand properties", "file_type": "document", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_rule", "target": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_border_image", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_rule", "target": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_font", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_rule", "target": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_grid_template", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_rule", "target": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_mdn_shorthand", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/the-shorthand-reset-trap.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_the_shorthand_reset_trap_border_image", "ta