{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_pool_modes", "label": "Pool modes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_transaction_pooling", "label": "Transaction pooling", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server connection returns when the transaction finishes. Measured: 40 sequential clients used 1 backend; 40 concurrent used exactly default_pool_size=5. Session mode pins a backend for the client lifetime and saves nothing behind pg.Pool."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_session_state_breaks", "label": "Session features broken in transaction mode", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET/RESET, LISTEN/NOTIFY, WITH HOLD cursors, SQL PREPARE, temp tables, LOAD and session advisory locks never work. Failures are intermittent because they appear only when the next transaction lands on a different backend."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_set_local", "label": "SET LOCAL on a pooled connection", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain SET persists across a pooled handoff; SET LOCAL does not. A leaked tenant id is a cross-tenant exposure. Use pg_advisory_xact_lock, not session advisory locks."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_protocol_prepared_statements", "label": "Protocol-level prepared statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PgBouncer 1.21.0, named extended-protocol statements work in transaction mode when max_prepared_statements is non-zero (default 200). SQL-level PREPARE is still unsupported."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_server_reset_query", "label": "server_reset_query unused in transaction mode", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DISCARD ALL runs in session mode on client disconnect. In transaction pooling it is not used; there is no automatic cleanup between transactions."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_transaction_pooling", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_session_state_breaks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_set_local", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_session_state_breaks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_server_reset_query", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_transaction_pooling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_set_local", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_inherit_and_set_role", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_set_local", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_synchronous_commit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_pool_modes", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_exhaustion_and_sizing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/02-pool-modes.md", "source_location": null, "weight": 1.0}], "hyperedges": []}