{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pg_copy_streams", "label": "pg-copy-streams", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns client.query into a writable stream. Needs a checked-out client because COPY is a distinct protocol mode."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pipeline", "label": "pipeline not pipe for COPY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pipeline propagates errors and destroys both ends. .pipe() leaves the connection stuck mid-COPY and poisons the pool."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_csv_vs_text", "label": "COPY text vs csv format", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text is default: tab delimiter, \\N is NULL. csv needs WITH (FORMAT csv). Comma data on text dumps the line into column one."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_null_representation", "label": "COPY NULL representation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text: \\N is NULL, empty field is ''. csv: unquoted empty is NULL, \"\" is ''. Common NOT NULL violation source."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_staging_table", "label": "UNLOGGED all-text staging table", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COPY is all-or-nothing. Stage as text, then INSERT SELECT with validation to restore ON CONFLICT and inspect rejects. UNLOGGED skips WAL."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pg_copy_streams", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_copy_from_stdin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pg_copy_streams", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_unnest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pg_copy_streams", "target": "docs_postgresql_pages_phase_7_pg_driver_07_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pipeline", "target": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_streams_pg_copy_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/09-copy-streams.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_09_copy_str