{"nodes": [{"id": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_modeled_after_sync", "label": "Chain error propagation modeled after try", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promises catch all errors, even thrown exceptions and programming errors. A TypeError in a handler lands in the same catch as a network failure."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_then_vs_then_catch", "label": "then(f, g) is not then(f).catch(g)", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-argument then handles only upstream rejections. A throw inside f rejects the next promise. Trailing catch handles both."}, {"id": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_nested_catch_scope", "label": "Nesting to scope a catch", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A nested catch only swallows failures in its scope. Flat mid-chain catch would swallow critical errors too. Nesting is a scoping tool, not a style."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_modeled_after_sync", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_identity_and_thrower", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_then_vs_then_catch", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_is_then", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_nested_catch_scope", "target": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_forgotten_return", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_nested_catch_scope", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_restores_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/06-chaining/02-error-propagation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}