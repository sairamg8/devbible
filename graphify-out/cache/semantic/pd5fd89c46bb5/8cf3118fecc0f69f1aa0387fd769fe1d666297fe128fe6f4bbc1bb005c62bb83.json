{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "label": "Encryption, signing and key management", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most app code needs AES-256-GCM used correctly, plus the key management that makes rotation possible."}, {"id": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_aes_256_gcm", "label": "AES-256-GCM AEAD", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ECB leaks structure. CBC decrypts tampered data with no error and its padding is an oracle. GCM fails authentication on tamper. AAD binds context."}, {"id": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_iv_reuse", "label": "GCM IV reuse", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same key+IV \u2192 same keystream; c1 XOR c2 XOR known plaintext recovers the other message. Random 96-bit IV per message, or a persisted never-reset counter."}, {"id": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_envelope_encryption", "label": "Envelope encryption", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KEK wraps a per-row DEK stored beside ciphertext with v and kid. Rotating the KEK re-wraps DEKs and never re-encrypts data. Two keys valid during overlap."}, {"id": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_ed25519", "label": "Ed25519 vs RSA-2048", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ed25519 for new work: keygen 0.4 vs 107 ms, sign 151 vs 998 \u00b5s, 64 vs 256-byte signatures. RSA verifies faster. HMAC when both sides share a secret."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_aes_256_gcm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_iv_reuse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_envelope_encryption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_ed25519", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_iv_reuse", "target": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_aes_256_gcm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_envelope_encryption", "target": "docs_nodejs_pages_phase_8_security_18_secrets_secret_rotation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_ed25519", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_hmac_length_extension", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_25_web_crypto_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_26_encryption_and_keys_page", "target": "docs_nodejs_pages_phase_8_security_27_audit_logging_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/26-encryption-and-keys.md", "source_location": null, "weight": 1.0}, 