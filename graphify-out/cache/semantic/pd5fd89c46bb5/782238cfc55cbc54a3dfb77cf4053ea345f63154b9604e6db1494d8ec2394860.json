{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_expand_and_contract", "label": "Expand and contract", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expand additively, migrate data and dual-write, contract later. Every deploy compatible with schema before and after; every migration compatible with code before and after."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_valid_validate", "label": "NOT VALID then VALIDATE CONSTRAINT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips the lengthy scan; new rows are enforced immediately. Do not leave convalidated=false indefinitely."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_null_via_check", "label": "SET NOT NULL via validated CHECK", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK (col IS NOT NULL) NOT VALID \u2192 VALIDATE \u2192 SET NOT NULL. Since PG 12 the validated check lets SET NOT NULL skip its ACCESS EXCLUSIVE scan."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_batched_backfill", "label": "Batched backfill with SKIP LOCKED", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIMIT + ORDER BY + FOR UPDATE SKIP LOCKED, commit per batch, pause so autovacuum keeps up. One huge UPDATE bloats and loses work on failure."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_valid_validate", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_null_via_check", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_expand_and_contract", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_valid_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_expand_and_contract", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_batched_backfill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_batched_backfill", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_dead_tuples_autovacuum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/02-expand-and-contract.md", "source_location": null, "weight": 1.0}], "hyperedges": []}