{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_04_constraints_check_constraint", "label": "CHECK constraint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/04-constraints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects only when the expression is false. SQLSTATE 23514. Pair with NOT NULL or write CHECK (col IS NULL OR \u2026)."}, {"id": "docs_postgresql_pages_phase_3_ddl_04_constraints_check_passes_on_null", "label": "CHECK passes on NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/04-constraints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL >= 18 is unknown, not false. Measured: CHECK (age >= 18) accepted a NULL age."}, {"id": "docs_postgresql_pages_phase_3_ddl_04_constraints_explicit_null_bypasses_default", "label": "Explicit NULL bypasses DEFAULT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/04-constraints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEFAULT applies only when the column is omitted or given DEFAULT. ORMs that send null for unset fields override every default."}, {"id": "docs_postgresql_pages_phase_3_ddl_04_constraints_not_null", "label": "NOT NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/04-constraints.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column property, not DEFERRABLE. Default to NOT NULL. WHERE status != 'archived' silently excludes NULL rows."}, {"id": "docs_postgresql_pages_phase_3_ddl_04_constraints_constraint_sqlstates", "label": "Constraint SQLSTATE to HTTP map", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/04-constraints.md", "source_location": null, "source_url"