{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_implicit_final", "label": "Unlayered implicit final layer", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlayered declarations behave as if they were in an implicit final layer. Last wins for normal, first wins for important \u2014 so unlayered wins all normal and loses all important."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_invert", "label": "!important inverts layer order", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foundational layers hold the most binding constraints. A utility layer must not !important past a reset or design-system invariant."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_vendor", "label": "Swallow a vendor stylesheet", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@import vendor into an early layer so a later one-class rule wins without !important. Vendor !important still beats you via inversion."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_revert_layer", "label": "revert-layer", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolls a property back to the previous layer in the same origin, not to initial or the previous origin (that is revert)."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_order", "label": "Recommended layer order", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reset, vendor, base, layout, components, utilities \u2014 utilities always win with one class."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_implicit_final", "target": "build_css_p2_docs_css_pages_phase_2_cascade_layer_at_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_invert", "target": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_implicit_final", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_vendor", "target": "build_css_p2_docs_css_pages_phase_2_cascade_layer_declaring_and_ordering_import", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/layer/precedence-and-important.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_vendor", "target": "build_css_p2_docs_css_pages_phase_2_cascade_layer_precedence_and_important_invert", "relation": "concept