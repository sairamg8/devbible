{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_10_arrays_postgresql_arrays", "label": "PostgreSQL arrays", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any type can be an array. 1-based; out-of-range subscript is NULL, not an error. Prefer cardinality() (0 for empty) over array_length() (NULL for empty). pg maps JS arrays natively."}, {"id": "docs_postgresql_pages_phase_2_types_10_arrays_gin_contains", "label": "GIN @> not ANY for array membership", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200k rows: @> 73.2 ms seq scan \u2192 4.8 ms with GIN. 't42' = ANY(tags) is not GIN-indexable (41.8 ms parallel seq scan). Write tags @> ARRAY['t42']. Scalar id = ANY($1) is a different, indexable IN-list idiom."}, {"id": "docs_postgresql_pages_phase_2_types_10_arrays_array_vs_child", "label": "Array versus child table", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No FK from array elements (42804). No per-element constraints or extra columns. Any element change rewrites the whole MVCC row. Arrays for values that travel with the row; child tables for entities."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_10_arrays_gin_contains", "target": "docs_postgresql_pages_phase_2_types_10_arrays_postgresql_arrays", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_10_arrays_array_vs_child", "target": "docs_postgresql_pages_phase_2_types_10_arrays_postgresql_arrays", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_10_arrays_gin_contains", "target": "docs_postgresql_pages_phase_2_types_08_jsonb_gin_index", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-2-types/10-arrays.md", "source_location": null, "weight": 1.0}], "hyperedges": []}