{"nodes": [{"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_strictmode_double_invocation", "label": "StrictMode double-invocation", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One extra setup+cleanup cycle in development before the first real setup. It tests the mount path only."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "label": "Extra setup+cleanup cycle", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mount is setup \u2192 cleanup \u2192 setup where production is setup. If those are indistinguishable to the user, cleanup is complete."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_doubles_mount_only", "label": "StrictMode only doubles the mount", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extra cycle is before the first real setup, not every setup. A leak on the dependency-change path passes StrictMode."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_double_render_vs_effect_cycle", "label": "Double render versus extra effect cycle", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double render finds impurity in the component body and useState/useMemo/useReducer functions. Extra effect cycle finds missing cleanup. Event handlers are in neither."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_callback_ref_extra_cycle", "label": "Callback refs get the same extra cycle", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 ref cleanup functions make the symmetry expressible. A missing cleanup doubles registry counts."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_partial_strictmode", "label": "Partial StrictMode skips the extra effect cycle", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When StrictMode is not at the root, React will not double child effects without parent effects, because that cannot happen in production."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_devtools_dimmed_logs", "label": "DevTools dims second-render logs", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing second log is not evidence of a single render. Effect setup logs are not dimmed."}, {"id": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_doubled_analytics_not_a_bug", "label": "Doubled development analytics is not a bug", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You do not want development traffic in production metrics. The real bug nearby is a doubled mutation that belonged in a handler."}], "edges": [{"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_strictmode_double_invocation", "target": "docs_react_pages_phase_4_effects_04_cleanup_01_the_cleanup_contract_indistinguishable_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_doubles_mount_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_double_render_vs_effect_cycle", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_double_render_vs_effect_cycle", "target": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_buying_a_product", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_doubled_analytics_not_a_bug", "target": "docs_react_pages_phase_4_effects_04_cleanup_02_cleanup_recipes_analytics_no_cleanup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_partial_strictmode", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/05-strictmode-double-invocation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}