{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_class_lexical_declaration", "label": "Class lexical declaration", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "class is TDZ, block-scoped, and never creates globalThis properties \u2014 like let, not like function."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_class_inner_immutable_binding", "label": "Class inner immutable binding", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inside the class body the class name is const-like. Outside it is a reassignable let-like binding."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_extends_evaluated_at_declaration", "label": "extends evaluated at declaration", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "extends is an expression run when the class statement executes, not at new. Mutual extends is impossible."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_circular_esm_import_tdz", "label": "Circular ES module import TDZ", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth-first evaluation can read a hoisted import before the exporter initialises it. Same error string as a local let."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_import_live_readonly_view", "label": "Import live read-only view", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imports are const-like live views. Only the exporting module can reassign; property mutation is allowed."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_commonjs_circular_require", "label": "CommonJS circular require", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require has no dead zone: a cycle returns a partially populated module.exports, usually with undefined properties."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_class_lexical_declaration", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_temporal_dead_zone_temporal_dead_zone", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/classes-and-circular-imports.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_classes_and_circular_imports_class_inner_immutable_binding", "target": 