{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_page", "label": "Trimming, padding and replacing", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_trim", "label": "String trim family", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes Unicode whitespace, takes no argument, and belongs at the input boundary. Use Start/End names, not Left/Right."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_padstart", "label": "String.prototype.padStart", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First argument is target total length. Already-long strings are unchanged; multi-character pads are repeated then cut."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_repeat", "label": "String.prototype.repeat", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Negative count throws RangeError. Replaces the old new Array(n+1).join(str) idiom."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replace", "label": "String.prototype.replace", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A string pattern replaces only the first occurrence \u2014 the most common string bug."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replaceall", "label": "String.prototype.replaceAll", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throws TypeError if a regex lacks the g flag. Equivalent to replace with a global regex; the difference exists only for string patterns."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_never_regex_from_user", "label": "Never build a regex from user input", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A string in replaceAll matches literally. new RegExp(userInput) treats metacharacters as syntax and is a backtracking DoS vector."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_dollar_patterns", "label": "Replacement $ patterns", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$&, $1 and $<name> are interpreted in a replacement string. Use the function form when the replacement is data-derived."}, {"id": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_turkish_i", "label": "Locale-dependent case mapping", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turkish i uppercases to dotted \u0130. Prefer localeCompare with sensitivity accent over lowercasing both sides."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replace", "target": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replaceall", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_never_regex_from_user", "target": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replaceall", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_dollar_patterns", "target": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_replace", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_turkish_i", "target": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_localecompare", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_02_trimming_padding_replacing_trim", "target": "docs_javascript_pages_phase_5_built_in_library_07_string_methods_01_slicing_and_splitting_string_immutability", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-5-built-in-library/07-string-methods/02-trimming-padding-replacing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}