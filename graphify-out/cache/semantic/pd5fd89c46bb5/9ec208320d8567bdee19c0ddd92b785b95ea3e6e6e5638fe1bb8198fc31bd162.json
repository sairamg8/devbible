{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_agg", "label": "json_agg and jsonb_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nest children into a parent row for a one-query API payload. Do not skip NULL inputs, so LEFT JOIN NULLs become [null] instead of []."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_array_string_agg", "label": "array_agg and string_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "string_agg skips NULL inputs; array_agg keeps them as elements. That inconsistency is the source of most surprises in this family."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_empty_array_trap", "label": "Empty-array [null] trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parent with no children yields NULL or [null], not []. FILTER alone is not the fix; the two-level payload needs coalesce around an inner aggregate that already excluded the NULL row."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_array_string_agg", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_empty_array_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_empty_array_trap", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_null_skip_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg.html", "source_location": null, "weight": 1.0}], "hyperedges": []}