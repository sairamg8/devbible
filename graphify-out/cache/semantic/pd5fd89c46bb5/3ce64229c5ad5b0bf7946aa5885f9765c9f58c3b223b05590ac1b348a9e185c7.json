{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_how_it_executes", "label": "How GROUP BY executes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two strategies: hash table or sort-and-walk. Same query over 500000 rows was 59 ms or 118 ms depending on work_mem."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "label": "HashAggregate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hash table, one entry per group. Memory scales with group count, not row count. Output is hash order. Chosen when groups fit in work_mem."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_groupaggregate", "label": "GroupAggregate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sort by the key, then one pass. Needs sorted input. Output is grouped-key order. Over an ordered index scan it uses O(1) memory."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_work_mem", "label": "work_mem is per node per worker", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plan with three hashes and three sorts peaks at a multiple of the setting. Raise with SET LOCAL inside a transaction, never globally."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_partial_finalize", "label": "Partial and Finalize aggregation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workers produce combinable partials; leader merges. count/sum/min/max/avg combine. count(DISTINCT x) cannot. actual rows=166666.67 is average per loop."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_batches_spill", "label": "HashAggregate Batches spill", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batches: 1 fits. Batches: 5 with Disk Usage 3696kB spilled (PG 13+ partitions instead of exceeding work_mem). 59.57 ms \u2192 117.68 ms at work_mem=64kB."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_compare_buffers", "label": "Compare Buffers before milliseconds", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical plans, shared hit=3783, 59.57 ms vs 83.22 ms. Clock said 40% worse; buffers said identical work. Scan dominates: 4 groups 58.59 ms vs 5000 groups 59.57 ms."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_index_only_groupaggregate", "label": "GroupAggregate over ordered index scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 64kB work_mem the index dropped 117.68 ms to 85.19 ms and buffers 3801 to 577. At default work_mem the index changed nothing. Heap Fetches: 0 is a true index-only scan."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_how_it_executes", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_how_it_executes", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_groupaggregate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_groupaggregate", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_work_mem", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_batches_spill", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/05-how-it-executes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_partial_finalize", "target": "docs