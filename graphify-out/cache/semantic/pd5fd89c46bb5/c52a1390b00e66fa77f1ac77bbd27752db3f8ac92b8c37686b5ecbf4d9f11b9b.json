{"nodes": [{"id": "docs_javascript_pages_phase_0_how_javascript_runs_09_transpilation_polyfills_transpiler", "label": "Transpiler", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/09-transpilation-polyfills.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrites syntax at build time so an older parser can read it. Syntax fails at parse time and takes the whole file down."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_09_transpilation_polyfills_polyfill", "label": "Polyfill", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/09-transpilation-polyfills.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a missing API at runtime. A missing method fails at call time on one interaction. Patches the global."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_09_transpilation_polyfills_ponyfill", "label": "Ponyfill", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/09-transpilation-polyfills.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports the implementation instead of patching the global. Prefer in libraries; reserve true polyfills for an app entry you control."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_09_transpilation_polyfills_browserslist", "label": "browserslist", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/09-transpilation-polyfills.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single control for Babel and bundlers. Stale IE11 targets force ES5 plus a large core-js for everyone."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_09_transpilation_p