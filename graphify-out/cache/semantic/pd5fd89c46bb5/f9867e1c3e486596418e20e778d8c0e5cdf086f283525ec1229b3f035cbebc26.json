{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update", "label": "The lost update, and four ways to stop it", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_lost_update", "label": "Lost update", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-modify-write under READ COMMITTED: last writer wins with a stale value. 20 concurrent increments produced qty=2. No error, no deadlock."}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_sql_arithmetic", "label": "SQL arithmetic UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET qty = qty + 1 is atomic in one statement. Fastest of the four (37.9 ms, 20/20). Limited to values expressible in SQL."}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_select_for_update", "label": "SELECT FOR UPDATE then UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialises the read-modify-write so application logic can live in JS. 58.0 ms. Lock held until COMMIT."}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_optimistic_version", "label": "Optimistic version column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE version = $2; rowCount 0 means retry. Right for think-time / cross-request edits. Worst under single-row contention: 170 retries, 337.4 ms."}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_rr_as_error", "label": "REPEATABLE READ turns lost updates into 40001", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_bounded_retry", "label": "Bounded retry with jitter", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unbounded retry is livelock; no jitter collides in lockstep. Cap attempts; backoff with jitter. Retry 40001 and 40P01 only."}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_04_lost_update", "target": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_lost_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_lost_update", "target": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_read_committed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_sql_arithmetic", "target": "docs_postgresql_pages_phase_11_mvcc_04_lost_update_lost_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/04-lost-update.md", "source_location": null, "weight": 1.0}, {