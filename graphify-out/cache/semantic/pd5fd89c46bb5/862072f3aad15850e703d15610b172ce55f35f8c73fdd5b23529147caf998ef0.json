{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets", "label": "WebSockets", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_upgrade_handshake", "label": "WebSocket HTTP upgrade handshake", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client GET with Upgrade: websocket and Sec-WebSocket-Key; server replies 101 Switching Protocols. Begins as HTTP so it carries cookies and traverses HTTP proxies."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_ws_npm", "label": "ws npm WebSocketServer", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node ships only a WebSocket client (global WebSocket, stable from v22.4.0). Server side is ws from npm \u2014 what Socket.IO and Fastify wrap."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_ping_pong_heartbeat", "label": "WebSocket ping/pong heartbeat", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleeping laptops, dropped mobile signal and expired NAT mappings leave TCP open. Periodic ping plus isAlive and terminate() reaps dead sockets."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_origin_check", "label": "WebSocket Origin check", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handshakes are not covered by CORS or same-origin policy. Any origin can open a socket with the user's cookies. Validate Origin and authenticate on upgrade."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_streaming_and_sse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_upgrade_handshake", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_ws_npm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_ping_pong_heartbeat", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_ws_npm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/websockets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_websockets_origin_check", "