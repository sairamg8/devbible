{"nodes": [{"id": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "label": "Express as middleware engine with a router", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a language and not an application architecture. Programmable routing and middleware on top of Node's http.Server. Business rules, databases, and queues are called from handlers."}, {"id": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_app_is_listener", "label": "app is a request listener", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "express() returns a function. Pass it to http.createServer(app) or call app.listen. Express fills the function Node already expects. Sandbox-measured: typeof app === 'function' and app.handle exists."}, {"id": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_not_full_stack", "label": "What Express is not", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a language, ORM, or auth product. Password hashing lives in Node; Express only mounts identity middleware. Debugging hangs still needs node:http."}, {"id": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_ecosystem_tradeoff", "label": "Ecosystem over peak throughput", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express optimises for ecosystem and familiarity. Fastify can win raw benchmarks; you pay with a smaller middleware universe. Right default for most MERN/PERN APIs."}], "edges": [{"source": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_not_full_stack", "target": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "target": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_app_is_listener", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_ecosystem_tradeoff", "target": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_not_full_stack", "target": "docs_expressjs_readme_boundary_rule", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_01_what_express_is_express", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_object_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/01-what-express-