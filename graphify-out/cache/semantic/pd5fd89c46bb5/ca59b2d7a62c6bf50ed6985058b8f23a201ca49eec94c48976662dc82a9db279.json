{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_transactional_outbox", "label": "Transactional outbox", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/06-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_dual_write", "label": "Dual-write problem", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/06-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two systems cannot commit together. Queue down: order exists, jobs enqueued = 0. try/catch is a third write that can also fail."}, {"id": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_outbox_table", "label": "Outbox table", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/06-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insert the intent in the same transaction as the business row. Rollback left neither. Same checked-out client required."}, {"id": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_relay", "label": "Outbox relay", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/06-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks published_at then enqueues; crash republishes. At-least-once with jobId outbox:${id}. A jobs table in the same DB is the outbox."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_dual_write", "target": "docs_nodejs_pages_phase_7_background_work_06_transactional_outbox_outbox_table", "relation": "rationale_for", "conf