{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_page", "label": "createRoot and root.render", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_createroot", "label": "createRoot", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only client entry in React 19. From react-dom/client. Two methods: render and unmount."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_hydrateroot", "label": "hydrateRoot", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expects server-rendered HTML and attaches handlers. Argument order is container first, opposite of render."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_reactdom_render_removed", "label": "ReactDOM.render removed", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gone in 19, not deprecated: TypeError: ReactDOM.render is not a function. Also hydrate, findDOMNode, unmountComponentAtNode."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_one_root", "label": "One root per container", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second createRoot warns; two roots then throw NotFoundError: Node.removeChild on unmount. Cache the root for HMR."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_unmount_dead", "label": "Unmounted root cannot be reused", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unmount() runs cleanups and empties the container. Further render throws Cannot update an unmounted root."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_error_options", "label": "createRoot error options", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onUncaughtError, onCaughtError, onRecoverableError \u2014 the hook for reporting a whole tree."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_createroot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_hydrateroot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/createroot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_createroot_page", "target": "build_css_p2_docs_react_pages_phase_0_how_r