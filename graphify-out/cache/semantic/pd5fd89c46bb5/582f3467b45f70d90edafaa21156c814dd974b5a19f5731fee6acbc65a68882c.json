{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_03_path_page", "label": "node:path", "file_type": "document", "source_file": "docs/nodejs/pages/phase-4-filesystem/03-path.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never build paths with + or templates. join vs resolve is a security boundary."}, {"id": "docs_nodejs_pages_phase_4_filesystem_03_path_path_join", "label": "path.join", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/03-path.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concatenates and normalises; an absolute later argument is treated as a relative segment."}, {"id": "docs_nodejs_pages_phase_4_filesystem_03_path_path_resolve", "label": "path.resolve", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/03-path.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always absolute; restarts at any absolute argument, discarding earlier segments."}, {"id": "docs_nodejs_pages_phase_4_filesystem_03_path_join_vs_resolve_security", "label": "join vs resolve is a security boundary", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/03-path.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "resolve gives the true final path to validate against a root; join can look contained after an absolute input."}, {"id": "docs_nodejs_pages_phase_4_filesystem_03_path_path_posix", "label": "path.posix", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/03-path.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use for URL paths, S3 keys, tar and git paths \u2014 always forward slashes. Default path is the