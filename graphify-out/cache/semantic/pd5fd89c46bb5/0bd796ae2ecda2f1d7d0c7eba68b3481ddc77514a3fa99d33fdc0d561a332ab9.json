{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "label": "CSRF", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_11_csrf_authority_not_input", "label": "CSRF is an authority problem", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing in the request is malformed. The browser attaches the destination's cookie to a request the attacker composed. The server sees a valid authenticated POST."}, {"id": "docs_nodejs_pages_phase_8_security_11_csrf_samesite_lax", "label": "SameSite=Lax default", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Withholds cookies from cross-site POST/fetch/XHR. Node writes the Set-Cookie string unvalidated \u2014 measured sid=abc123; Path=/; HttpOnly with no SameSite. Set it explicitly."}, {"id": "docs_nodejs_pages_phase_8_security_11_csrf_cors_not_csrf", "label": "CORS does not stop CSRF", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CORS governs whether the attacker may read the response. The write still happens. A form-urlencoded POST is a simple request with no preflight."}, {"id": "docs_nodejs_pages_phase_8_security_11_csrf_origin_check", "label": "Origin allowlist check", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare new URL(origin).origin. Origin:null is a real value and new URL('null') throws. Prefer Origin; Referer is often stripped."}, {"id": "docs_nodejs_pages_phase_8_security_11_csrf_signed_double_submit", "label": "Signed double-submit CSRF token", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain double-submit trusts only you can write the cookie; a subdomain XSS breaks that. HMAC over sid.nonce so a token from another session fails. Verified."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_11_csrf_authority_not_input", "target": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "target": "docs_nodejs_pages_phase_8_security_11_csrf_samesite_lax", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "target": "docs_nodejs_pages_phase_8_security_11_csrf_cors_not_csrf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "target": "docs_nodejs_pages_phase_8_security_11_csrf_origin_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_csrf", "target": "docs_nodejs_pages_phase_8_security_11_csrf_signed_double_submit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_samesite_lax", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_samesite", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_signed_double_submit", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_double_submit_csrf", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_11_csrf_signed_double_submit", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_timing_safe_equal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/11-csrf.md", "source_location": null, "weight": 1.0}], "hyperedges": []}