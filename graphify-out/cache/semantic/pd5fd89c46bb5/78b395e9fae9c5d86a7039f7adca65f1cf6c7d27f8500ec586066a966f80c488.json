{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_page", "label": "Why an index is not being used", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_function_wrapped_column", "label": "Function-wrapped column", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lower(email) or created_at::date defeats a B-tree on the bare column. Index the expression or rewrite so the column is bare."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_cast_on_indexed_side", "label": "Cast on the indexed side", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Casting the indexed column casts every row and skips the index. Cast the literal or parameter instead. Hand-added :: is the trap; pg sends untyped text."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_low_selectivity", "label": "Low selectivity", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a value matches most of the table the planner correctly ignores the index. Forcing it for 99.89% active rows was slower than seq scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_stale_statistics", "label": "Stale planner statistics", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A never-analyzed table has reltuples=-1 (unknown). Stale stats after 200\u00d7 growth estimated 1 row vs 400001 actual and chose a bad index-only scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_nonindexable_predicate", "label": "Non-indexable predicate shape", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<> , NOT IN and leading-wildcard LIKE cannot seek a B-tree. OR is fine only if every branch has its own usable index (BitmapOr)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_function_wrapped_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_cast_on_indexed_side", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-not-used.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_low_selectivity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/po