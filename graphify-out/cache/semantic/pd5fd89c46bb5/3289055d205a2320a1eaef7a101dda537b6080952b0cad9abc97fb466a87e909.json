{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_string_functions", "label": "PostgreSQL string functions", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everyday set is case, trim, substring, split, pad, replace, and format. SQL strings are 1-indexed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_one_indexed", "label": "SQL strings are 1-indexed", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "substring('abcdef' FROM 2 FOR 3) is 'bcd'. FOR is a length, not an end position."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_length_vs_octet_length", "label": "length vs octet_length", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'h\u00e9llo' is 5 characters and 6 bytes. varchar(n) counts characters; btree entries have a byte limit."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_format", "label": "format %I %L %s", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "%I quotes identifiers, %L quotes literals, %s does nothing. Application values still belong in $1 parameters."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_case_insensitive", "label": "Case-insensitive matching", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lower() needs an expression index; ILIKE needs pg_trgm for leading wildcards; citext or a CI collation compare directly."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_one_indexed", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_string_functions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_length_vs_octet_length", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_string_functions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_format", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_format_percent_i", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_case_insensitive", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_order_by_order_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/string-functions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_string_functions_format",