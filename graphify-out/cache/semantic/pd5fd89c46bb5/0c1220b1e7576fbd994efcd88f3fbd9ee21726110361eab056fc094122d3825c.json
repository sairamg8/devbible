{"nodes": [{"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_page", "label": "Mutating req and res", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_req_attachments", "label": "req field attachments", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attaching fields on req is how identity and timing flow down the chain. Typical later attachments: req.user, req.validated."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_req_user", "label": "req.user", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication middleware attaches it after verifying session or token. Implicit req.user is convenient and hides dependencies."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_namespaced_ctx", "label": "Namespaced req.ctx", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs do not enumerate a reserved list; treat request and response references as the list. A single namespaced object is the safe habit."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_do_not_clobber", "label": "Do not clobber core req/res properties", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not overwrite req.url, method, headers, query, params, or res.end/json wholesale. Routing and security depend on them."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_res_locals", "label": "res.locals", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented request-scoped place for values."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_res_finish", "label": "res.on('finish') timing", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only store scalars you need; do not retain req in global arrays or you leak memory."}, {"id": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_inject_deps", "label": "Inject deps via factory not req", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid putting DB clients on req. Lifecycle and testing \u2014 inject via app.locals or factory deps instead."}], "edges": [{"source": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_page", "target": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_req_attachments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-2-middleware/06-mutating-req-res.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_2_middleware_06_mutating_req_res_req_attachments", "target": "docs_expressjs_pages_phase_2_middleware_06_m