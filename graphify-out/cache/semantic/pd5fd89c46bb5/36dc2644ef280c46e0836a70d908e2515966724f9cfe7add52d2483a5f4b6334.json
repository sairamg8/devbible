{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_create_table", "label": "CREATE TABLE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes the contract every client must obey. Type changes on a large table rewrite it under a lock that blocks everything."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_text_plus_check", "label": "text plus CHECK not varchar or enum", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text and varchar(n) have identical performance; narrowing varchar rewrites (433 ms / 200k). Enums cannot drop or reorder values."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_timestamptz", "label": "timestamptz not timestamp", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamp stores no zone so the same value means different instants. timestamptz stores an instant. Converting later rewrites the table."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_char_n_blank_pad", "label": "char(n) blank-pads", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "char(3) holding 'US' compares and returns as 'US '. Use only for genuinely fixed-width codes; prefer text."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_now_transaction_start", "label": "now() is transaction start time", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two inserts 150ms apart in one transaction share created_at. Use clock_timestamp() for per-row wall-clock time. now() cannot be a generated column (42P17)."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_schema_qualify_ddl", "label": "Schema-qualify DDL in migrations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unqualified CREATE TABLE follows search_path (\"$user\", public). A role with its own schema silently creates tables elsewhere."}, {"id": "docs_postgresql_pages_phase_3_ddl_01_create_table_liberal_constraints_conservative_types", "label": "Liberal constraints conservative types", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraints can be relaxed with ALTER and NOT VALID. Type changes that alter on-disk representation rewrite under ACCESS EXCLUSIVE."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_01_create_table_create_table", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_generated_always_as_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_01_create_table_create_table", "target": "docs_postgresql_pages_phase_3_ddl_04_constraints_check_constraint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/01-create-table.md", "source_location": null, "weight": 1.0}, {"source": 