{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_alter_table_access_exclusive", "label": "ALTER TABLE ACCESS EXCLUSIVE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/alter-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every ALTER takes ACCESS EXCLUSIVE. A 3 ms change can outage if it queues behind a long read; later queries queue behind it. Use SET LOCAL lock_timeout."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_alter_table_rewrite", "label": "ALTER TABLE rewrite vs catalog-only", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/alter-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "relfilenode change means rewrite. int\u2192bigint, narrowing varchar, volatile DEFAULT, SET LOGGED/UNLOGGED rewrite; widening varchar, DROP COLUMN, varchar\u2192text do not."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_alter_table_add_backfill_swap", "label": "Add-backfill-swap type change", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/alter-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add new column, batch-backfill, keep current with a trigger, then drop/rename in a short lock_timeout transaction. Interruptible unlike one ALTER TYPE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_alter_table_batch_subcommands", "label": "Batch ALTER subcommands", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/alter-table.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One statement = one lock acquisition and at most one rewrite pass covering all changes."}], "edges": [{"s