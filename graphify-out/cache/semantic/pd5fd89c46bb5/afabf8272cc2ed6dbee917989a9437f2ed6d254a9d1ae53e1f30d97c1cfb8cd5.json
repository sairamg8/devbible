{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_test_reset", "label": "Resetting between test runs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strategy sets suite speed. Timed on 10000 rows: DELETE 12.7 ms, TRUNCATE 4.4 ms, RESTART IDENTITY 4.7 ms, BEGIN/ROLLBACK 0.8 ms."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_transaction_rollback", "label": "Transaction rollback per test", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16x faster than TRUNCATE because seeds survive. Requires every query on the injected client. Cannot test commit-only behaviour."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_truncate", "label": "TRUNCATE for test reset", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "List every table in one statement, CASCADE for FKs, RESTART IDENTITY for sequences. Separate TRUNCATEs deadlock under parallel files."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_restart_identity", "label": "TRUNCATE RESTART IDENTITY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain TRUNCATE left next id at 10001. Tests asserting id === 1 fail on the second run. Prefer not asserting on generated ids."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_client_injection", "label": "Inject client into repositories", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-level pool writes commit outside the test transaction and leak. Testability is why repositories take a client first."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_test_reset", "target": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_transaction_rollback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_test_reset", "target": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_truncate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_truncate", "target": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_restart_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_client_injection", "target": "docs_postgresql_pages_phase_8_schema_from_node_11_test_reset_transaction_rollback", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/11-test-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_