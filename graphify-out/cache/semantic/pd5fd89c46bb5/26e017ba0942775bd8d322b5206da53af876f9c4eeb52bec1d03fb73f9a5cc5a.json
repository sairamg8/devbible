{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_grouping_column_rewrite", "label": "HAVING on grouping columns rewritten to WHERE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A HAVING that references only grouping columns is constant per group, so the planner drops the extra grouping key and evaluates the predicate as a scan Filter. Measured plans were identical (55.08 ms vs 57.21 ms). The rewrite needs a non-volatile predicate."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_on_aggregate", "label": "HAVING on an aggregate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filter sits on Finalize HashAggregate because the value does not exist until every group row is read. Selectivity cannot reduce work: HAVING count(*) > 100 keeping 0 of 5000 groups was not cheaper than keeping all. Tune the input, not the HAVING."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_exists_rewrite", "label": "HAVING count > 0 rewritten as EXISTS", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(...) > 0 forces a full count of every group. EXISTS stops at the first match and can use an index. Does not apply when the threshold is a real count (> 5)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_window_42p20", "label": "Window functions forbidden in HAVING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "42P20: windows run after HAVING so the value does not exist yet. Compute the window in a subquery and filter outside. rank() OVER (ORDER BY count(*) DESC) is legal because windows run after grouping."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_grouping_column_rewrite", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_on_aggregate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_exists_rewrite", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_on_aggregate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_window_42p20", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_pipeline_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_what_having_costs_having_exists_rewrite", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_in_exists_and_not_in_exists", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having/what-having-costs.html", "source_location": null, "weight": 1.0}], "hyperedges": []}