{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_roles_grant_page", "label": "Roles, GRANT and REVOKE", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/roles-grant.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Least privilege is GRANT statements; a new role can do almost nothing. Role=identity, privilege=verb on an object, ownership outranks both, effective privileges are the union of inherited roles."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_roles_grant_least_privilege", "label": "Least privilege as GRANT statements", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/roles-grant.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Least privilege is not a written policy; it is GRANT statements, and a new role can do almost nothing."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_roles_grant_role", "label": "PostgreSQL role", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/roles-grant.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_roles_grant_privilege", "label": "Privilege", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/roles-grant.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_roles_grant_ownership", "label": "Object ownership", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/roles-grant.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages