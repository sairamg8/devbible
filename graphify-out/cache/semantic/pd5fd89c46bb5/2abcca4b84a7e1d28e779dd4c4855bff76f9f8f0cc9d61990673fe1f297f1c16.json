{"nodes": [{"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_effect_lifecycle", "label": "An effect has its own lifecycle", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Components mount, update and unmount. Effects only start and stop synchronizing. One mount can contain many start/stop cycles."}, {"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_start_and_stop", "label": "Start and stop, not mount and unmount", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ask what start means and what stop means. If both have clean answers the effect is resilient to being started and stopped as many times as needed."}, {"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_door_lock_analogy", "label": "Door-lock analogy", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React starts and stops the Effect one extra time in development to check the lock \u2014 that start and stop are a matched pair."}, {"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_one_sync_process_per_effect", "label": "One synchronization process per Effect", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A connection and a visit log start together but are unrelated. The test: if you need the word and, split."}, {"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_mutable_outside_react", "label": "Mutable-outside-React values cannot be dependencies", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "location.pathname and ref.current can change outside the render data flow. A dependency array records what a render produced."}, {"id": "docs_react_pages_phase_4_effects_09_effect_lifecycle_all_linter_errors_legitimate", "label": "All linter errors on dependencies are legitimate", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is always a way to fix the code without breaking the rules. The array is the input React uses to decide whether to re-synchronize."}], "edges": [{"source": "docs_react_pages_phase_4_effects_09_effect_lifecycle_effect_lifecycle", "target": "docs_react_pages_phase_4_effects_04_cleanup_01_the_cleanup_contract_cleanup_not_unmount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_09_effect_lifecycle_door_lock_analogy", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_09_effect_lifecycle_start_and_stop", "target": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_cleanup_then_setup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/09-effect-lifecy