{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_08_openapi_openapi_contract", "label": "OpenAPI contract", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/08-openapi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The contract is part of the product. Write or generate OpenAPI 3.x for public routes. Swagger UI is optional sugar \u2014 the artifact is the spec. Even internal APIs gain onboarding, client generation, contract tests, and explicit breaking-change review."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_08_openapi_schema_drift", "label": "OpenAPI and handler drift", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-6-rest-surface/08-openapi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drift between OpenAPI and handlers is a bug. CI should fail on breaking changes or route/doc mismatch. Use the same schemas as Zod when possible to avoid double sources of truth."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_08_openapi_schema_drift", "target": "docs_expressjs_pages_phase_6_rest_surface_08_openapi_openapi_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/08-openapi.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_08_openapi_openapi_contract", "target": "docs_expressjs_pages_phase_4_responses_03_response_shapes_bare_resource", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/expressjs/pages/phase-6-rest-surface/08-openapi.md", "source_location": null, "weight": 1.0}], "hyperedges": []}