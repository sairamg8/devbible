{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "label": "package.json essentials", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_type_field", "label": "package.json type field", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most consequential field: decides how every .js file is parsed. Absent type triggers MODULE_TYPELESS_PACKAGE_JSON and a reparse cost. Set explicitly; type is scoped to the nearest package.json."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_main_vs_exports", "label": "main vs exports", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main is the old single entry; exports takes precedence, supports subpaths and conditions, and blocks unlisted deep imports."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_scripts", "label": "package.json scripts", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts prepend node_modules/.bin to PATH. Avoid pre/post hooks because they run implicitly; postinstall is a supply-chain risk."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_node_run", "label": "node --run", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal script runner: no pre/post scripts, no .npmrc, faster startup; use npm run when a script needs npm's environment."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_engines", "label": "package.json engines", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declaration not enforcement unless engine-strict=true. State a floor not a ceiling so future Node majors are not locked out."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_files_allowlist", "label": "package.json files allowlist", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without files, npm publishes almost everything. README, LICENSE and package.json always ship; node_modules never does. Verify with npm pack --dry-run."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_dependency_kinds", "label": "dependencies vs devDependencies vs peerDependencies", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dependencies ship to consumers; devDependencies are omitted in production; peerDependencies expect the host to provide the package so plugins do not duplicate a framework."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_postinstall", "label": "postinstall scripts", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run automatically on every install of the package \u2014 debugging surprise and supply-chain risk. Prefer an explicit user-run script."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_type_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_main_vs_exports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_scripts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_scripts", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_node_run", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_scripts", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_postinstall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_engines", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_files_allowlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_package_json_essentials", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_dependency_kinds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_package_json_type_field", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_typescript_natively_type_stripping", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/package-json.html", "source_location": null, "weight": 1.0}], "hyperedges": []}