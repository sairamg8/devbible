{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "label": "numeric vs float", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric is exact software decimal; double precision and real are approximate IEEE floats. 1000 additions of 0.01 gave 9.999999999999831 in float8 and 10.00 in numeric. numeric(p,s) overflow is 22003; extra scale rounds silently."}, {"id": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_money_never_float", "label": "Money never in float", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.01 has no exact binary form. An unbalanced ledger costs more than any query. Default numeric(12,2); move to integer cents only when a measurement says you must."}, {"id": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_integer_cents", "label": "Integer cents in bigint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact and as fast as float: 27.7 ms vs 76.8 ms for 300k-row sum, 8 bytes vs 10. Units become implicit; a missed conversion is a 100\u00d7 error."}, {"id": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_js_string", "label": "pg returns numeric as a string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converting to a JavaScript number would throw away exactness. Prefer SQL arithmetic or a decimal library. Never setTypeParser(1700, parseFloat)."}, {"id": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_rounding", "label": "numeric rounds half away from zero", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2.5::numeric(2,0) is 3. Float-to-int uses half-to-even (2.5 \u2192 2). numeric NaN compares equal to itself so it can be sorted and indexed."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_money_never_float", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_integer_cents", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_js_string", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/02-numeric-vs-float.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_rounding", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-t