{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pg_client", "label": "pg.Client", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one connection you own from connect() to end(). Right when a session must outlive a single query and pooling buys nothing. Single-use; connect() twice raises Client has already been connected."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pool_connect", "label": "pool.connect()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks one connection out of the pool. Use for transactions, SET, cursors, advisory locks, named prepared statements \u2014 anything session-stateful. release() in finally. Not a bare Client."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_listen_dedicated_client", "label": "LISTEN needs a dedicated Client", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LISTEN via pool.query() returns the connection to the pool with no handler; notifications are lost. The real new pg.Client() case. Also honest for one-shot migration/admin scripts."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_waiting_count", "label": "waitingCount", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "max is a queue depth, not a speed limit. Fourth query against max:3 raised waitingCount to 1. Persistent waitingCount>0 means the pool is the bottleneck. Unreleased clients exhaust it."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pg_client", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pool_connect", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_listen_dedicated_client", "target": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_pg_client", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_02_pool_vs_client_waiting_count", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/02-pool-vs-client.md", "source_location": null, "weight": 1.0}], "hyperedges": []}