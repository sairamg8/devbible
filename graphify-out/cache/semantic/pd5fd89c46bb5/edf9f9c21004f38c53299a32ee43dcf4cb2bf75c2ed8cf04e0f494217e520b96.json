{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_page", "label": "AsyncLocalStorage", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_async_local_storage", "label": "AsyncLocalStorage", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-request store that Node restores across await, timers and I/O. Solves request-id-in-every-log without a ctx parameter. A module-level variable is overwritten by interleaved requests."}, {"id": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_als_run", "label": "AsyncLocalStorage.run", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes the store to fn and its async descendants. getStore() is undefined outside any run. Prefer a fresh object per request."}, {"id": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_enterwith_leaks", "label": "enterWith leaks context", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets the store for the rest of the current async context with no visible boundary. Prefer run(). enterWith is for framework points with no callback."}, {"id": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_hidden_state_cost", "label": "ALS is hidden state with a cost", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use only for cross-cutting concerns (trace ids, tenant, current transaction). Pass real arguments for domain data. Async context tracking makes operations measurably slower."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_page", "target": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_async_local_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_page", "target": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_als_run", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_enterwith_leaks", "target": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_als_run", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_hidden_state_cost", "target": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_async_local_storage", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_20_asynclocalstorage_page", "target": "docs_nodejs_pages_phase_2_async_21_async_hooks_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/20-asynclocalstorage.md", "source_