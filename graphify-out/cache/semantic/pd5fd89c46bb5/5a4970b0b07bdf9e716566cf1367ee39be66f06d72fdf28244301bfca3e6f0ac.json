{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_page", "label": "What PostgreSQL is", "file_type": "document", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Understand-tier. PostgreSQL is a free open-source object-relational database server, not a library, not a document store, not SQL syntax alone."}, {"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_server", "label": "PostgreSQL object-relational server", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-running program that stores data, enforces rules, and answers queries over a network protocol. Custom types, jsonb, arrays, full-text, extensions."}, {"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_cluster", "label": "Database cluster", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One data directory on disk; may contain many databases. Distinct from the server process, the SQL catalog, and the client."}, {"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_guest", "label": "App is a guest with a connection", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL owns the durable truth. Application code is bad at concurrent writers, crash recovery, indexes, and access control. The server does not care whether the client is psql or pg."}, {"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_license", "label": "PostgreSQL License", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permissive BSD-style. No single commercial owner of the core. The engine is free; hosting is the product."}, {"id": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_version_184", "label": "select version() PostgreSQL 18.4", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 via psql and pg.Pool against 127.0.0.1:55432. PostgreSQL 18.4 on x86_64-pc-linux-musl, Alpine gcc 15.2.0."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_guest", "target": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_server", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_cluster", "target": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_server", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/01-what-postgresql-is.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_version_184", "target": "docs_postgresql_pages_phase_0_architecture_01_what_postgresql_is_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":