{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_phase_3", "label": "Phase 3 \u2014 State and the render cycle", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_usestate", "label": "useState", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State belongs to a position, and React finds it by counting hook calls."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_state_is_a_snapshot", "label": "State is a snapshot", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-3-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting state only changes it for the next render."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_object_is", "label": "Object.is comparison", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React compares state with Object.is. Mutate and the update vanishes with no error."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_state_belongs_to_position", "label": "State belongs to a position", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-3-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Together with snapshot and Object.is, this is why lists, keys and remounts behave as they do."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_updater_functions", "label": "Updater functions", "file_type": "concep