{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_coalesce", "label": "COALESCE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First non-null argument; short-circuits. NULLIF(a,b) returns NULL when equal \u2014 x / NULLIF(y,0) avoids 22012."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_greatest_least_skip_nulls", "label": "GREATEST/LEAST skip nulls", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opposite of most SQL: GREATEST(NULL, 2) is 2. NULL only if every argument is null. Row-wise, not aggregates."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_case_expression", "label": "CASE expression", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First matching WHEN wins. Implicit ELSE NULL if none match. Short form uses = and cannot express IS NULL. Useful for custom ORDER BY."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_concat_vs_pipe", "label": "|| vs concat vs concat_ws", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "|| propagates null ('x' || NULL is NULL). concat treats null as empty. concat_ws skips null values but a null separator voids the result."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_coalesce", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_concat_vs_pipe", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_greatest_least_skip_nulls", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_case_expression", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_concat_vs_pipe", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_case_expression", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_expressions_coalesce", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_logical_order_alias_visibility", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/expressions.html", "source_location": null, "weight": 1.0}], "hyperedges": []}