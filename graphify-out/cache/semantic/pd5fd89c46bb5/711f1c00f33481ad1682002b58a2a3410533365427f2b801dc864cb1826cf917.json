{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_prototype_chain", "label": "Prototype chain", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every object has an internal [[Prototype]] link. Lookup walks until it finds a name or reaches null, then returns undefined. Nothing is copied onto instances."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_property_shadowing", "label": "Property shadowing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first match wins and own properties are always first. The prototype's value is untouched and still reachable via Object.getPrototypeOf."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_missing_property_full_walk", "label": "A miss traverses the entire chain", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessing a non-existent property walks to null. A miss is the most expensive lookup, not the cheapest."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_this_is_receiver", "label": "this is the receiver not the home", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inherited method is found on the prototype but this is the object it was called on. Finding the method and resolving each property are two separate lookups."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_property_shadowing", "target": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_prototype_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_missing_property_full_walk", "target": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_prototype_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_this_is_receiver", "target": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_prototype_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/05-the-prototype-chain/01-how-lookup-walks.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_01_how_lookup_walks_prototype_chain", "target": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_operator", "relati