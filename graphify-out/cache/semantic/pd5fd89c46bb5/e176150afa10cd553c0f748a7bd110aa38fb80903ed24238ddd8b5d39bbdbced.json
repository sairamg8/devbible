{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_spec_engine_host", "label": "Spec, engine and host", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ECMA-262 has no I/O. A language feature works wherever the engine is new enough; a host feature works only where that host provides it."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_v8", "label": "V8", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships in Chrome, Edge, Node, Deno, Electron. Semantics match other engines; performance and feature timing do not."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_javascriptcore", "label": "JavaScriptCore", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safari and Bun. Broken in Safari almost always means JSC lacks a feature V8 shipped first."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_globalthis", "label": "globalThis", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One spec name for the global object: window, self, or global. Measured globalThis === global on Node 24."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_fetch_is_host", "label": "fetch is a host API", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not in ECMA-262. Node 18 shipped it via undici for portability. An older Node lacking it is a host-version problem."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_settimeout_is_host", "label": "setTimeout is a host API", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not in ECMA-262. HTML spec in browsers, separately by Node. A bare engine has no timers."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_navigator_node_trap", "label": "navigator exists on Node 21+", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof navigator !== 'undefined' is true on Node 24. It never tested for a browser, only a name."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_spec_engine_host", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_v8", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_spec_engine_host", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_fetch_is_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_spec_engine_host", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_settimeout_is_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_navigator_node_trap", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_feature_detection_capability_not_environment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_v8", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_the_jit_v8_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/engine-runtime-spec.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_engine_runtime_spec_globalthis", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_toplevel_this", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.8