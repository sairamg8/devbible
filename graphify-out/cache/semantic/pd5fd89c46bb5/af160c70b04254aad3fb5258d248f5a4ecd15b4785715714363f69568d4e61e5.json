{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_caching_strategy", "label": "Caching strategy", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cache is a correctness trade: stale in exchange for not hitting the expensive path. If you cannot name the invalidation rule, you have a future incident."}, {"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_ttl_invalidation", "label": "TTL and write-path invalidation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TTL bounds how wrong you can be; it is not the only invalidation. Delete or overwrite the key on write when updates must show sooner."}, {"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_cache_stampede", "label": "Cache stampede", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many concurrent misses on one expired hot key overload the origin. Mitigate with single-flight, distributed locks, jittered TTLs, or stale-while-revalidate."}, {"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_single_flight", "label": "Single-flight cache fill", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process Map of inflight promises collapses concurrent misses in one process. Does not protect a 20-pod fleet."}, {"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_inprocess_vs_redis", "label": "In-process vs Redis cache", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process is fastest and per pod; after scale-out you have N independent caches. Redis is shared, networked, operational."}, {"id": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_negative_cache", "label": "Negative cache", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caching 'not found' without TTL, or caching 5xx, turns a transient failure into a long outage."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_ttl_invalidation", "target": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_caching_strategy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_single_flight", "target": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_cache_stampede", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_inprocess_vs_redis", "target": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_caching_strategy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_negative_cache", "target": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_ttl_invalidation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_16_caching_strategy_inprocess_vs_redis", "target": "docs_nodejs_pages_phase_10_observability_18_common_leak_sources_unbounded_cache", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/16-caching-strategy.md", "source_location": null, "weight": 1.0}], "hyperedges": []}