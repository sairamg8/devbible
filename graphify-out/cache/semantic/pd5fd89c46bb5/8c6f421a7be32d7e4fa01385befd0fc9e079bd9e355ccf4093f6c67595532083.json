{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_retry_and_backoff", "label": "Retry and backoff", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_transient_vs_permanent", "label": "Transient vs permanent errors", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry ECONNREFUSED, 57P01, 40001, 40P01. Never retry 23505, 42601, 28P01. A timeout is not knowing whether the write committed."}, {"id": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_full_jitter", "label": "Exponential backoff with full jitter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Math.random() * backoff spreads correlated failures. Without jitter every instance retries in a synchronised wave."}, {"id": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_retry_whole_transaction", "label": "Retry the whole transaction", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never retry a statement inside an aborted tx (25P02). Retry from BEGIN on a fresh checkout. Correct for 40001 and 40P01."}, {"id": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_pg_retries_nothing", "label": "pg retries nothing; mongodb retries once", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mongodb retryWrites/retryReads attach a server-side txn id. pg is one query, one outcome. Mongo selection timeout stacks under your loop."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_06_transactions_25p02_savepoint", "target": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_retry_whole_transaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_transient_vs_permanent", "target": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_sqlstate_codes", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_retry_whole_transaction", "target": "docs_nodejs_pages_phase_6_data_access_06_transactions_withtransaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_full_jitter", "target": "docs_nodejs_pages_phase_7_background_work_04_retries_and_stalled_jobs_retries_and_stalled", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-6-data-access/14-retry-backoff.md", "source_location": null, "weight": 0.85}, {"source": "docs_nodejs_pages_phase_6_data_access_14_retry_backoff_transient_vs_permanent", "target": "docs_nodejs_pages_phase_7_background_work_05_job_idempotency_domain_derived_key", "relation": "conceptually_related_to