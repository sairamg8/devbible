{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_03_node_prefix_node_prefix", "label": "node: prefix", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/03-node-prefix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks a specifier as a built-in. Node returns it immediately \u2014 no node_modules walk, no filesystem probing."}, {"id": "docs_nodejs_pages_phase_1_modules_03_node_prefix_prefix_only_builtins", "label": "Prefix-only built-ins", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/03-node-prefix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Node 24 four built-ins exist only as node:sea, node:sqlite, node:test, node:test/reporters. Bare names fall through to npm packages."}, {"id": "docs_nodejs_pages_phase_1_modules_03_node_prefix_core_wins_first", "label": "Core modules resolve before node_modules", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/03-node-prefix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A package named path or fs cannot hijack require('path') or require('fs'). Core wins already in both CJS and ESM."}, {"id": "docs_nodejs_pages_phase_1_modules_03_node_prefix_builtinmodules", "label": "module.builtinModules", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/03-node-prefix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array of every built-in name. Node 24 has 72 built-ins; four names start with node:."}, {"id": "docs_nodejs_pages_phase_1_modules_03_node_prefix_bundler_signal", "label": "Prefixed imports as bundler signal", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-1-modules/03-node-prefix.md", "source_location": nul