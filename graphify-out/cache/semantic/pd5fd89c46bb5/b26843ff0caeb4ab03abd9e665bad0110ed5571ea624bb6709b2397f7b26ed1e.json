{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures", "label": "Procedures versus functions", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_commit_in_body", "label": "Procedure can COMMIT mid-body", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same COMMIT inside a FUNCTION raises 2D000. A function runs inside the caller's transaction and may not end it."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_call", "label": "CALL vs SELECT for procedures", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT a procedure raises 42809. Procedures return no rows and cannot appear in a query."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_outermost_only", "label": "Procedure transaction control only when outermost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CALL inside an explicit BEGIN raises 2D000. Inside an application withTransaction wrapper a procedure behaves like a function."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures", "target": "docs_postgresql_pages_phase_12_beyond_tables_12_plpgsql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_commit_in_body", "target": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_outermost_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_call", "target": "docs_postgresql_pages_phase_12_beyond_tables_15_procedures_commit_in_body", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/15-procedures.md", "source_location": null, "weight": 1.0}], "hyperedges": []}