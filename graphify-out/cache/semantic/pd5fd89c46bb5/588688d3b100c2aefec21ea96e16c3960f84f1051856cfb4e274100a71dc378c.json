{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_node_and_observing", "label": "The Node side, observing, and alternatives", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/04-node-and-observing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_connection_timeout_millis", "label": "connectionTimeoutMillis", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/04-node-and-observing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unset by default, so pool.connect() waits forever on a saturated pool. Set it shorter than the upstream HTTP timeout."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_client_release_finally", "label": "client.release() in finally", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/04-node-and-observing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A client never released on the error path is the most common way to produce pool exhaustion."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_show_pools", "label": "SHOW POOLS", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/04-node-and-observing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cl_waiting and maxwait are the leading indicator of the 120-second failure. Pair with pg_stat_activity state = idle in transaction for the cause."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_connection_timeout_millis", "target": "docs_postgresql_pages_