{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_14_for_update_page", "label": "SELECT FOR UPDATE inside a request", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "label": "SELECT ... FOR UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locks writers until commit. Meaningless without BEGIN because autocommit releases immediately. Readers still see the old MVCC version."}, {"id": "docs_postgresql_pages_phase_9_api_crud_14_for_update_lock_last", "label": "Do slow work then lock last", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight requests \u00d7 100 ms: 863 ms with work inside the lock, 143 ms with lock taken only to write. Re-read the locked row before acting."}, {"id": "docs_postgresql_pages_phase_9_api_crud_14_for_update_nowait_skip_locked", "label": "NOWAIT vs SKIP LOCKED", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOWAIT raises 55P03. SKIP LOCKED omits locked rows and is wrong for a point lookup. lock_timeout also raises 55P03 with a different message."}, {"id": "docs_postgresql_pages_phase_9_api_crud_14_for_update_lock_order", "label": "Lock rows in deterministic order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opposite lock orders deadlock with 40P01. ORDER BY id FOR UPDATE. FOR UPDATE OF table restricts which join rows lock."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "target": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_version_column", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "target": "docs_postgresql_pages_phase_9_api_crud_13_optimistic_lost_update", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_14_for_update_lock_last", "target": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_14_for_update_nowait_skip_locked", "target": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_14_for_update_lock_order", "target": "docs_postgresql_pages_phase_9_api_crud_14_for_update_select_for_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/14-for-update.md", "