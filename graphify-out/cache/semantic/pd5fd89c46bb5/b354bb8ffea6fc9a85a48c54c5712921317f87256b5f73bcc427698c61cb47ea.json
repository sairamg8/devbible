{"nodes": [{"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_object_graph", "label": "http.Server, app, and Router object graph", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "http.Server owns the socket. app owns settings and the top-level stack. Router is a portable mountable stack. Only the server listens. Confusing them is how middleware never runs."}, {"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_http_server", "label": "http.Server", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created by http.createServer(app) or app.listen. Owns port, SIGTERM, and server.close. Express does not own process signals."}, {"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_express_app", "label": "Express app", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "express() result: settings, top-level middleware, mounts. Itself a request listener. Only app owns application settings."}, {"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_express_router", "label": "express.Router", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A portable stack of routes/middleware you mount on app or another router. Has no mountpath; inside a request the equivalent is req.baseUrl."}, {"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_app_listen_sugar", "label": "app.listen is createServer sugar", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.listen(port) is http.createServer(app).listen(port). Prefer explicit server for TLS, WebSockets, or tests that import app without listening."}, {"id": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_shallow_routers", "label": "Prefer shallow feature routers", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many routers keep files small. Deep nested mounts make req.baseUrl vs req.path debugging harder."}], "edges": [{"source": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_object_graph", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_http_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_object_graph", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_express_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/02-app-router-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_object_graph", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_express_router", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,