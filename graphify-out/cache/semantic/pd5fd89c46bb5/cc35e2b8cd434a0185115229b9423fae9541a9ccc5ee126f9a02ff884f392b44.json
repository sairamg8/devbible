{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_anatomy_and_this", "label": "Class anatomy, state and this", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_not_deprecated", "label": "Class components still supported", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not recommended for new code, no new features, not scheduled for removal. defaultProps kept; string refs and legacy context gone."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_setstate_merges", "label": "this.setState merges", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useState replaces. Porting a state object wholesale silently drops unspread fields."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_this_binding", "label": "this binding in class handlers", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracted methods lose the receiver; class bodies are strict so this is undefined. Prefer class-field arrows."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_one_context", "label": "One contextType per class", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second context needs a render prop or wrapper. useContext has no such limit."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_instance_fields_to_useref", "label": "Instance fields become useRef", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer ids, sockets and caches persist without triggering a render. useState would re-render on every assignment."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_setstate_merges", "target": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_not_deprecated", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_this_binding", "target": "build_css_p2_docs_react_pages_phase_2_components_purecomponent_shallow_comparison", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/class-components/anatomy-and-this.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_class_components_anatomy_and_this_one_context", "target": "build_css_p2_docs_react_pages_phase_2_components_r