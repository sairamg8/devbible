{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_16_timing_attacks_page", "label": "Timing attacks", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/16-timing-attacks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How long code takes is data. Naive compare staircase 5.4\u2192141.2 ms; the exploited leak is 83 ms user enumeration on login."}, {"id": "docs_nodejs_pages_phase_8_security_16_timing_attacks_timing_attack", "label": "Timing attack", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/16-timing-attacks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A first-mismatch loop leaks the matching prefix. Remote byte-level attacks need thousands of samples; endpoint-level millisecond leaks survive jitter."}, {"id": "docs_nodejs_pages_phase_8_security_16_timing_attacks_timing_safe_equal", "label": "crypto.timingSafeEqual", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/16-timing-attacks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compares every byte. Throws ERR_CRYPTO_TIMING_SAFE_EQUAL_LENGTH on unequal lengths. Takes Buffer/TypedArray, not strings. ~0.2 \u00b5s per call."}, {"id": "docs_nodejs_pages_phase_8_security_16_timing_attacks_user_enumeration", "label": "Login user enumeration", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/16-timing-attacks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skipping the password hash for unknown emails is an 83 ms oracle. Same error text, status, and signup/reset behaviour are also required."}, {"id": "docs_nodejs_pages_phase_8_security_16_timing_attacks_dummy_password_hash", "label": "Dummy password hash", "file_type":