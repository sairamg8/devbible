{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_page", "label": "What React is", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_react_package", "label": "react package", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "42 public exports. No render, no createRoot, no document.createElement anywhere in source."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_react_dom", "label": "react-dom package", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7148 KB vs react 168 KB (42.7\u00d7). Events, hydration, streaming, DOM property tables."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_declarative", "label": "Declarative UI", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write what the UI is for a given value; never write transitions. Trade-off: give up direct DOM control and pay a diff."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_version_match", "label": "react / react-dom version-match rule", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They share private internals. A mismatch is undefined behaviour, usually a crash inside the renderer."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_duplicate_react", "label": "Duplicate React hook error", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two copies of react: hooks live in module-level internals so copy A calling copy B finds nothing."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_react_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_react_dom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_declarative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/what-react-is.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_what_react_is_version_match", "relation": "re