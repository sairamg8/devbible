{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_json_stringify", "label": "JSON.stringify", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lossy and silent except BigInt and cycles (TypeError). undefined/functions/symbols omitted in objects, nulled in arrays. Sees the same own enumerable string-keyed set as Object.keys. Map/Set become {}."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_json_parse", "label": "JSON.parse", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SyntaxError on trailing commas, single quotes, empty bodies. The parse itself is safe from prototype pollution; the merge afterwards is not."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_reviver", "label": "JSON.parse reviver", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must end with return value or every other key is deleted. Innermost-first. Only place to repair stringify losses (e.g. revive *At dates). context.source for 64-bit precision."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_json_stringify", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_shallow_vs_deep_copy_json_and_hand_written_json_clone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json.html", "source_location": null, "weight":