{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/transactional-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE/ALTER/DROP roll back like DML. A later failure vanished a successfully created table. Most engines commit DDL implicitly; PostgreSQL does not."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_concurrent_not_in_tx", "label": "CONCURRENTLY cannot run in a transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/transactional-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE/DROP INDEX CONCURRENTLY, VACUUM, CREATE/DROP DATABASE fail with 25001. A failed CONCURRENTLY build leaves an INVALID index still maintained on writes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_keep_ddl_tx_short", "label": "Keep DDL transactions short", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/transactional-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ACCESS EXCLUSIVE is held until commit; an open transaction pins VACUUM's cleanup horizon database-wide. Atomicity is free; duration is not."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_transactional_ddl", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_concurrent_not_in_tx", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/transactional-ddl.html", "source_location": null, "weight": 1.0}, {"source": 