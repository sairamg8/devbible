{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_unique_unlimited_nulls", "label": "UNIQUE accepts unlimited NULLs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two NULLs are not equal under three-valued logic. Measured: three NULLs inserted into a unique column."}, {"id": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_nulls_not_distinct", "label": "NULLS NOT DISTINCT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15+. Treats NULLs as equal so only one is allowed (23505). Works on constraint and index forms."}, {"id": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "label": "UNIQUE constraint vs unique index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same btree. FK can only target a constraint. Only an index can be partial, on an expression, or built CONCURRENTLY."}, {"id": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_partial_unique_index", "label": "Partial unique index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE UNIQUE INDEX \u2026 WHERE deleted_at IS NULL allows re-registration after soft delete. Constraints cannot be partial."}, {"id": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_case_insensitive_unique", "label": "Case-insensitive unique email", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index on lower(email) requires WHERE lower(email)=lower($1). Non-deterministic ICU collation makes plain equality case-insensitive but disables LIKE."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_unique_unlimited_nulls", "target": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_nulls_not_distinct", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "target": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_create_index_concurrently", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_partial_unique_index", "target": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_case_insensitive_unique", "target": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/08-unique-nulls.md", "source_location": null, "weight": 1.0}], "hyperedges": []}