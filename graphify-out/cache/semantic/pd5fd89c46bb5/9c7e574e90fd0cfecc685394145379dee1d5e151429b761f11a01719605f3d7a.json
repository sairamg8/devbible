{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_page", "label": "Outbound timeouts", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fetch with no timeout has no upper bound. One slow dependency takes down the service."}, {"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_no_default", "label": "fetch has no default timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCP connect may give up around 130s on Linux. Once connected, a silent server never times out."}, {"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_abort_signal_timeout", "label": "AbortSignal.timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers the whole exchange including a dribbling body. Unref'd so a pending timeout does not keep the process alive."}, {"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_slow_worse_than_down", "label": "Slow dependency worse than dead", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Down fails in microseconds with ECONNREFUSED. Slow holds pooled connections and handlers until the pool and health checks collapse."}, {"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_shared_deadline", "label": "One deadline for the whole handler", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three sequential 5s timeouts are a 15s worst case. Share AbortSignal.timeout and combine with AbortSignal.any."}, {"id": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_timeout_is_unknown", "label": "A timed-out write is unknown not failed", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abort does not undo server work. Retrying POST /charge without an idempotency key charges twice."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_no_default", "target": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_abort_signal_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_slow_worse_than_down", "target": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_no_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_shared_deadline", "target": "docs_nodejs_pages_phase_5_http_processes_06_outbound_timeouts_abort_signal_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/06-outbound-timeouts.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_p