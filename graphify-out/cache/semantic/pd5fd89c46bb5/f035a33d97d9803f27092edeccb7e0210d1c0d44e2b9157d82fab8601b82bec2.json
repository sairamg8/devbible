{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_arrays_and_strings", "label": "Arrays and strings", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "array_agg and string_agg collect a group into one value and disagree about NULL handling, empty groups, and what arrives in JavaScript."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_string_agg", "label": "string_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops NULLs and emits no delimiter for them. Empty group is NULL not ''. text-only; integer needs ::text or 42883. coalesce before concatenation."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_array_agg", "label": "array_agg", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps NULLs as elements. Prefer FILTER (WHERE x IS NOT NULL) over array_remove: if every value is NULL, remove gives {} and FILTER gives NULL. Arrives as a real JS array."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_order_by_inside_aggregate", "label": "ORDER BY inside the collection aggregate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unordered array_agg changed order when a sibling aggregate with its own ORDER BY was added, because the executor sorted the shared input. Outer ORDER BY orders result rows, not aggregate input."}, {"id": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_distinct_order_by_42p10", "label": "42P10 DISTINCT ORDER BY must match arguments", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "array_agg(DISTINCT status ORDER BY id) is incoherent: after de-duplicating by status there is no single id. De-duplicate in a subquery if you need min(id)."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_arrays_and_strings", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_string_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_arrays_and_strings", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_array_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_array_agg", "target": "docs_postgresql_pages_phase_6_aggregation_05_json_agg_01_arrays_and_strings_string_agg", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-6-aggregation/05-json-agg/01-arrays-and-strings.md", "source_location": null