{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_14_concurrency_control_page", "label": "Concurrency control", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_14_concurrency_control_unbounded_promise_all", "label": "Unbounded Promise.all", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts every item immediately. Hits 429s, pool timeouts, EMFILE, memory, then a burst of callbacks. Fine at 20 items; an outage at 10,000."}, {"id": "docs_nodejs_pages_phase_2_async_14_concurrency_control_maplimit_pool", "label": "mapLimit worker pool", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly N workers claim the next index with next++. Single-threaded so the increment needs no lock. results[i] preserves order. First worker rejection can abandon the rest."}, {"id": "docs_nodejs_pages_phase_2_async_14_concurrency_control_batching_vs_pool", "label": "Chunked Promise.all vs worker pool", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each batch waits for its slowest member so one slow item idles workers. A pool keeps every worker busy. Batching is fine when items are uniform."}, {"id": "docs_nodejs_pages_phase_2_async_14_concurrency_control_concurrency_limit", "label": "Picking a concurrency limit", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derive from the bottleneck: API rate limit, pool size, or in-flight memory. Right value is where throughput stops improving. CPU-bound work is not helped by concurrency."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_page", "target": "docs_nodejs_pages_phase_2_async_14_concurrency_control_unbounded_promise_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_page", "target": "docs_nodejs_pages_phase_2_async_14_concurrency_control_maplimit_pool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_batching_vs_pool", "target": "docs_nodejs_pages_phase_2_async_14_concurrency_control_maplimit_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_unbounded_promise_all", "target": "docs_nodejs_pages_phase_2_async_09_combinators_promise_all", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_page", "target": "docs_nodejs_pages_phase_2_async_22_cpu_bound_work_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_14_concurrency_control_concurrency_limit", "target": "docs_nodejs_pages_phase_2_async_14_concurrency_control_maplimit_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/14-concurrency-control.md", "source_location": null, "weight": 1.0}], "hyperedges": []}