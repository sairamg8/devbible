{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_floating_promise", "label": "Floating promise", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/floating-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A promise-returning call nobody awaited or .catch'd. Since Node 15 an unhandled rejection terminates the process."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_unhandled_rejection_fatal", "label": "Unhandled rejection is fatal", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/floating-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node 15+ exits with code 1 on unhandledRejection by default. A process handler is a detector, not a fix."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_void_catch_fire_and_forget", "label": "void plus .catch for fire-and-forget", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/floating-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate background work must be explicit and handled. void signals intent; .catch is what makes it safe."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_floating_promises_no_floating_promises_lint", "label": "@typescript-eslint/no-floating-promises", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/floating-promises.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lint that flags discarded promises. Needs TypeScript type information; strongest practical TS argument in Node."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_f