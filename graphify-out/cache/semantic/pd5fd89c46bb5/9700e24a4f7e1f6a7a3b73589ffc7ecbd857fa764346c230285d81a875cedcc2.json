{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_native_nesting", "label": "Native CSS nesting", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baseline Widely since 2023-12-11. & is the parent selector reference, not string concatenation. At-rules nest too. Write the &."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_not_sass_concat", "label": "Native nesting is not Sass concatenation", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sass &__title builds .card__title. Native CSS treats that as invalid and drops it. BEM suffix generation cannot survive dropping the preprocessor."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_specificity_growth", "label": "Nesting hides specificity growth", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each level compiles to another descendant class. Four tidy levels become 0,4,0. & in a compound with a list behaves like :is() and takes the highest parent specificity. Keep nesting to two levels."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_native_nesting", "target": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_not_sass_concat", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/nesting.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_nesting_specificity_growth", "target"