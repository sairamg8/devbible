{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_two_failure_modes_two_failure_modes", "label": "Why identifiers cannot be parameters", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/two-failure-modes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_two_failure_modes_order_by_placeholder", "label": "ORDER BY $1 silent no-op", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/two-failure-modes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The parameter binds as a constant string, so every row sorts by the same value. Sorting by name and by price returned byte-identical output and no error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_two_failure_modes_concatenated_identifier_injection", "label": "Concatenated identifier injection", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/two-failure-modes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No parameter array uses the simple query protocol, which permits stacked statements. ?sort=name; DROP TABLE fs_items CASCADE; -- executed 2 statements and the table was gone. Same payload as $1 left the table intact."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_allowlists_two_failure_modes_concatenated_identifier_injection", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_safe_dynamic_where_safe_dynamic_where", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/allowlists/two-failure