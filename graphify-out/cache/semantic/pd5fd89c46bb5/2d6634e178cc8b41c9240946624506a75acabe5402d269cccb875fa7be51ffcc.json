{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_page", "label": "cluster and sticky sessions", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_node_cluster", "label": "node:cluster", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Node process uses one core. cluster forks a worker per core sharing one listening port. On Kubernetes prefer replicas; cluster is for a single VM and zero-downtime reload."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_availableparallelism", "label": "os.availableParallelism", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Respects cgroup CPU limits and affinity. cpus().length reports the host and over-forks in a constrained container."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_sched_rr", "label": "SCHED_RR connection round-robin", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round-robin distributes accepts, not requests. Keep-alive pins many requests to one worker."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_sticky_sessions", "label": "Sticky sessions", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinning clients to a worker hides in-memory state. Prefer Redis sessions, rate limits, and pub/sub so workers stay stateless."}, {"id": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_prefer_replicas", "label": "Prefer container replicas over cluster", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_page", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_node_cluster", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_node_cluster", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_availableparallelism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_node_cluster", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_sched_rr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-5-http-processes/cluster.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_cluster_sched_rr", "target": "build_css_p2_docs_nodejs_pages_phase_5_http_processes_keep_alive_and_agents_http_agent", "relation": "conceptually_related_to", "confidence": "EXTRACTED"