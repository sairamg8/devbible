{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_event_loop_phases", "label": "Event loop phases", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed order per tick: timers \u2192 pending \u2192 idle/prepare \u2192 poll \u2192 check \u2192 close. nextTick and microtasks drain between phases."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_poll_phase", "label": "Poll phase", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for I/O then runs I/O callbacks. An idle server spends its life blocked here consuming no CPU."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_check_phase", "label": "Check phase (setImmediate)", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs setImmediate. After poll in the same tick, so inside an I/O callback setImmediate always beats setTimeout(0)."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_settimeout_vs_setimmediate", "label": "setTimeout(0) versus setImmediate from main", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From the main module their order is a genuine race. Inside I/O it is always setImmediate first."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_getactiveresourcesinfo", "label": "process.getActiveResourcesInfo", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists handles keeping the process alive. unref() excludes a handle from the exit count without cancelling it."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_poll_phase", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_event_loop_phases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_check_phase", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_event_loop_phases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_settimeout_vs_setimmediate", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_check_phase", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_getactiveresourcesinfo", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_event_loop_phases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/event-loop-phases.html", "source_location": null, "we