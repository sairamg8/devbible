{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable", "label": "Readable stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source: for await, pipe/pipeline, or events. Mixing consumers loses data. Paused mode is pull \u2014 backpressure comes free."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_writable", "label": "Writable stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_write callback means done with this chunk. Forget it and the stream hangs with no error. end() is required for final/finish."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_duplex", "label": "Duplex stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent read and write halves, e.g. net.Socket. end() sends FIN on write only; stream.finished waits for both."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_transform", "label": "Transform stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplex where output derives from input. Transform is a Duplex is a Readable, so it can sit anywhere in a pipeline."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_passthrough", "label": "PassThrough", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transform that changes nothing. Used to tap a pipeline, expose a stream before its source exists, or fan out."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable_from", "label": "Readable.from", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns an array, iterable, or async generator into a stream. Replaces most custom Readables."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_write_callback_contract", "label": "_write callback contract", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call callback exactly once on every path. Never calling it hangs forever; twice throws ERR_MULTIPLE_CALLBACK."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_transform", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_duplex", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_passthrough", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_transform", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_write_callback_contract", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_writable", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable_from", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable", "target": "docs_nodejs_pages_phase_3_buffers_streams_09_backpressure_backpressure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "four_stream_types", "label": "The four Node stream types", "nodes": ["docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable", "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_writable", "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_duplex", "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_transform"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/08-stream-types.md"}]}