{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_07_uuid_uuid_v4_vs_v7", "label": "uuid v4 versus uuid v7", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200k inserts: bigint 947 ms / 4408 kB index; v4 1727 ms / 8552 kB; v7 1356 ms / 6184 kB. Random keys scatter B-tree writes. uuidv7 first 48 bits are a millisecond timestamp."}, {"id": "docs_postgresql_pages_phase_2_types_07_uuid_btree_locality", "label": "B-tree locality for sequential keys", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential keys append to the rightmost leaf, stay in cache, and fill completely. Random keys split pages half-empty and make the working set the entire index."}, {"id": "docs_postgresql_pages_phase_2_types_07_uuid_uuidv7", "label": "uuidv7() built-in", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 18 built-in, no extension. uuid_extract_timestamp recovers creation time \u2014 a free created_at and a leak of when the row was created. Use v4 for public ids when timing is sensitive."}, {"id": "docs_postgresql_pages_phase_2_types_07_uuid_never_text", "label": "Never store a UUID as text", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 bytes as uuid, 40 as text, plus string comparison and no format validation. Common middle path: bigint PK for joins, uuid unique column for public ids."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_07_uuid_btree_locality", "target": "docs_postgresql_pages_phase_2_types_07_uuid_uuid_v4_vs_v7", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_07_uuid_uuidv7", "target": "docs_postgresql_pages_phase_2_types_07_uuid_uuid_v4_vs_v7", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_07_uuid_never_text", "target": "docs_postgresql_pages_phase_2_types_07_uuid_uuid_v4_vs_v7", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_07_uuid_uuid_v4_vs_v7", "target": "docs_postgresql_pages_phase_2_types_01_integers_bigint_surrogate_pk", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/07-uuid.md", "source_location": null, "weight": 1.0}], "hyperedges": []}