{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_app_role_not_owner", "label": "App role should not own the schema", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DDL is an ownership right with no GRANT form. Injected DROP TABLE is 42501 for a non-owner and a completed migration for an owner."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_two_connection_strings", "label": "Two connection strings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations as owner, request path as app. If both live in the same .env a compromised process reads both."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_schema_usage_not_create", "label": "GRANT USAGE not CREATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE on the schema lets the app create tables it then owns, silently eroding the boundary."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_alter_default_privileges", "label": "ALTER DEFAULT PRIVILEGES", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops every migration from needing a manual GRANT. Keyed FOR ROLE the owner, so hand-created tables miss it."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_app_role_not_owner", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_two_connection_strings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_app_role_not_owner", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_schema_usage_not_create", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_app_role_not_owner", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_app_role_not_owner_alter_default_privileges", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/app-role-not-owner.html", "source_location": null, "weight": 1.0}], "hyperedges": []}