{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_page", "label": "Schema compatibility \u2014 breaking vs non-breaking", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0 with zod 4.4.3. Mechanical answer to is this change breaking."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_direction_rule", "label": "Response add-safe, request tighten-unsafe", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Response: adding is safe, removing or narrowing is not. Request: relaxing is safe, tightening is not. Adding a required request field is breaking; adding a response field is not."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_rename_is_removal", "label": "Rename is removal plus addition", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumer error is identical to a deletion: createdAt expected string, received undefined. There is no just renaming a field across an API boundary."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_enum_add_breaking", "label": "Adding a response enum value is breaking", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consumer with an exhaustive switch or TypeScript union meets a value it has no branch for. Ship handling first, wait for deploy, then emit."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_meaning_change", "label": "Changing a field's meaning, same type", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worst change on the table: amount in euros becoming cents validates perfectly and is off by a hundred. Never redefine a field \u2014 add a new one and deprecate the old."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_expand_migrate_contract", "label": "Expand, migrate, contract", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add the new field alongside the old, let consumers move, remove the old when telemetry shows zero usage. Version only for restructures that cannot expand."}, {"id": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_deprecation_headers", "label": "Deprecation and Sunset headers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard headers a client can log. Pair with a usage metric so the contract step is a decision from data, not an announcement."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_direction_rule", "target": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_rename_is_removal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_expand_migrate_contract", "target": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_rename_is_removal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_meaning_change", "target": "docs_nodejs_pages_phase_9_testing_19_contract_testing_independent_schema", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_deprecation_headers", "target": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_expand_migrate_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_enum_add_breaking", "target": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_direction_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/20-schema-compatibility.md", "source_location": null, "weight": 1.0}], "hyperedges": []}