{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "label": "Time on the server", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_store_utc_convert_at_edge", "label": "Store UTC, convert at the edge", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An instant is unambiguous; a calendar date depends on who is looking. User timezone is data you must store \u2014 it cannot be recovered from an instant."}, {"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_instant_vs_calendar_date", "label": "Instant vs calendar date", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "toISOString().slice(0,10) is always the UTC day. 2026-08-10T18:45Z is the 10th in UTC and the 11th in IST. Format with an explicit timeZone."}, {"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_calendar_vs_elapsed_time", "label": "Calendar arithmetic vs elapsed milliseconds", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding 7*24*3600*1000 across DST moved 7:00 a.m. New York to 8:00 a.m. Use Temporal, date-fns-tz, Luxon, or PostgreSQL interval in a named zone."}, {"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_timestamptz", "label": "timestamptz not timestamp", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz stores an instant. timestamp stores a wall-clock reading with no zone and silently means different moments after a region change."}, {"id": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_job_clock_distrust", "label": "Do not trust a scheduled job's clock", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jobs run late, twice, or in another zone. Pass the window in and select on state (processed_at is null) so a 2:47 run matches a 2:00 run."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_store_utc_convert_at_edge", "target": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "target": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_instant_vs_calendar_date", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "target": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_calendar_vs_elapsed_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "target": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_timestamptz", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_time_on_the_server", "target": "docs_nodejs_pages_phase_7_background_work_10_time_on_the_server_job_clock_distrust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/10-time-on-the-server.md", "source_location": null, "weight": 1.0}], "hyperedges": []}