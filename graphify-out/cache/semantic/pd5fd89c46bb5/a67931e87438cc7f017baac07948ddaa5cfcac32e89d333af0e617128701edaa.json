{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_reverse_proxy", "label": "Behind a reverse proxy", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TLS usually terminates at the load balancer. Trust hop-by-hop headers only from that proxy or attackers forge client IPs."}, {"id": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_x_forwarded_headers", "label": "X-Forwarded-* headers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X-Forwarded-For, Proto, Host, and RFC 7239 Forwarded. Only trust if the socket peer is your proxy."}, {"id": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_trust_proxy", "label": "trust proxy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tell the framework how many hops of forwarded headers to trust when computing IP and protocol. Not blind true without understanding hop count."}, {"id": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_tls_termination", "label": "TLS termination at the edge", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node often speaks HTTP on a private network. Redirects and Secure cookies must use X-Forwarded-Proto, not req.socket.encrypted."}, {"id": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_spoofed_client_ip", "label": "Spoofed X-Forwarded-For", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If Node is reachable directly, anyone can send X-Forwarded-For: 1.2.3.4 and break rate limits, redirects, and cookies."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_x_forwarded_headers", "target": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_trust_proxy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_spoofed_client_ip", "target": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_trust_proxy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_tls_termination", "target": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_x_forwarded_headers", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_spoofed_client_ip", "target": "docs_nodejs_pages_phase_11_deployment_06_reverse_proxy_x_forwarded_headers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/06-reverse-proxy.md", "source_location": null, "weight": 1.0}], "hyperedges": []}