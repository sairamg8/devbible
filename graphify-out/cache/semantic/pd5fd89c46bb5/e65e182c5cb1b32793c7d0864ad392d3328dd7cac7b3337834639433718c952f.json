{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "label": "pg.Pool", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Pool, created once at module scope, exported, shared by every request. pg 8.23.0, pure JavaScript, no libpq. Default import then pg.Pool is the form that has never broken."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_lazy_connection", "label": "Lazy pool connection", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Pool() performs no I/O. Measured totalCount 0 idleCount 0 after construct, 1 and 1 after first query. Bad host is ECONNREFUSED on first query, not at startup. Add await pool.query('SELECT 1') before listen()."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pool_on_error", "label": "pool.on('error')", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idle pooled connections can be killed server-side. Unhandled 'error' on the pool is an uncaught exception that kills the process. Handler usually just logs; the pool discards the dead connection."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_application_name", "label": "application_name", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears in pg_stat_activity so every connection is attributable. Costs nothing. Without it the column is empty strings during an incident."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_one_pool_per_process", "label": "One pool per process", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two pools of max 10 are 20 connections against default max_connections 100 shared by every client. Exceptions: replica pool, dedicated Client for LISTEN, short-lived migration pool. Per-request pools defeat pooling."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_lazy_connection", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pool_on_error", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_application_name", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/01-install-wire.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_one_pool_per_process", "target": "docs_postgresql_pages_phase_7_pg_driver_01_install_wire_pg_pool", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/p