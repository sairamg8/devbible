{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_models_compared", "label": "The models compared", "file_type": "document", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_schema_per_tenant", "label": "Schema-per-tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right when isolation is contractual or regulatory, schemas genuinely differ, or per-tenant restore is routine. Cost: migrations run N times, cross-tenant queries become UNION over N, catalog grows, search_path is safety-critical."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_database_per_tenant", "label": "Database-per-tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rare: a small number of large tenants needing strict isolation, per-tenant restore and resource limits. Connection pooling multiplies per database; onboarding is provisioning."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "label": "Shared schema with RLS", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default: cheapest operations, weakest structural isolation, most isolation bought back with RESTRICTIVE RLS plus FORCE ROW LEVEL SECURITY. Only reversible starting point."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_tenancy_decision_order", "label": "Tenancy decision order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contract or regulation first; then tenant count (thousands force shared); then cross-tenant query frequency; then genuine schema variation. Do not choose for hypothetical isolation."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_migration_asymmetry", "label": "Shared-to-separated migration asymmetry", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared to separated is filter-and-copy. Separated to shared remaps colliding identity values everywhere they are referenced."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_set_local_mandatory", "label": "SET LOCAL mandatory for tenant context", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain SET persists on a pooled connection into the next request. With RLS keyed on app.tenant_id this is a concurrency-only leak. Use set_config(..., true)."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_tenant_id_leads_indexes", "label": "tenant_id leads every index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query is tenant-scoped in application code and via the RLS predicate, so an index that does not lead with tenant_id cannot serve the filter on every query."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_models_compared", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_schema_per_tenant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_models_compared", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_database_per_tenant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_models_compared", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_tenancy_decision_order", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/02-models-compared.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_migration_asymmetry", "target": "docs_postgresql_pa