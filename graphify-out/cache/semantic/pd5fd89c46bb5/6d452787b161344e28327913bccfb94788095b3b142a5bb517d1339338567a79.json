{"nodes": [{"id": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_then_always_async", "label": "then always runs asynchronously", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even on an already-settled promise the handler is a microtask. The returned promise is always pending when returned."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_identity_and_thrower", "label": "Identity and thrower default handlers", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing onFulfilled is (x) => x; missing onRejected is (x) => { throw x; }. Error propagation is the default thrower firing per link."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_is_then", "label": "catch is then(undefined, onRejected)", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No separate error channel. A rejection is the second argument's turn. catch internally calls then."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_restores_chain", "label": "catch restores the chain", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A catch that returns normally fulfils, so later then handlers run. Re-throw to keep failing. A log-only catch swallows the error as undefined."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_finally_transparency", "label": "finally transparency", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onFinally receives no argument; a return is ignored and the original outcome passes through. A throw or rejected return replaces the outcome, destroying the original error."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_then_always_async", "target": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_01_the_drain_order_microtask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_then_always_async", "target": "docs_javascript_pages_phase_7_async_04_callbacks_03_inversion_of_control_promise_three_guarantees", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_is_then", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_identity_and_thrower", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_identity_and_thrower", "target": "docs_javascript_pages_phase_7_async_06_chaining_02_error_propagation_modeled_after_sync", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_restores_chain", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_is_then", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_finally_transparency", "target": "docs_javascript_pages_phase_7_async_05_promises_02_then_catch_finally_catch_restores_chain", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/javascript/pages/phase-7-async/05-promises/02-then-catch-finally.md", "source_location": null, "weight": 1.0}], "hyperedges": []}