{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "label": "node:test \u2014 the built-in runner", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No dependency to test a Node app. describe/it, hooks, mocks, timers, coverage, snapshots, watch. Verified Node 24.19.0, 8 cores."}, {"id": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_node_test", "label": "node:test runner", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test fails when it throws. test and it are the same function. Hooks may be async; a rejected before fails every test in the suite."}, {"id": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_file_discovery", "label": "node --test file discovery", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picks up *.test.*, *-test.*, and everything in test/. Not *.spec.* \u2014 that suite runs zero tests and still exits 0. A directory positional is a module, not a search."}, {"id": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_process_isolation", "label": "Test process isolation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default --test-isolation=process: one child per file. none is ~2\u00d7 faster and hides cross-file state. Local loop, not CI."}, {"id": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_test_concurrency", "label": "node:test concurrency", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files run in parallel up to core count. Tests in one file are serial unless {concurrency: true}. it.only needs --test-only or it is ignored."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "target": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_node_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "target": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_file_discovery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "target": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_process_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "target": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_test_concurrency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/01-node-test-runner.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_01_node_test_runner_page", "target": "docs_nodejs_pages_phase_8_security_27_audit_logging_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 