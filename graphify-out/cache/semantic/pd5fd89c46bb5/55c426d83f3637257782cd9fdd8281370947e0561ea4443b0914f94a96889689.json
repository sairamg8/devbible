{"nodes": [{"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children", "label": "Slots, children and the context hole", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_children_slot", "label": "children is the free slot", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hole the parent fills with arbitrary JSX. Use when there is one content area and no opinion about it."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_slots_pattern", "label": "Slots pattern", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named element props for fixed regions. Community name, not a React API. Do not slice children by index."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_compound_components", "label": "Compound components", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent provides shared state through context; parts consume it and can be arranged freely. Parts only work inside the parent."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_context_hole", "label": "Context hole", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create the element in the scope that has the value and pass the finished object down. Intermediates never mention the value."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_rsc", "label": "RSC composition requirement", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Client Component cannot import a Server Component but can receive one as children. Composition keeps server code out of the client bundle."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_react19_provider", "label": "React 19 context as provider", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render the context object directly as ThemeContext value={theme}. The .Provider form still works."}, {"id": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_children_skip", "label": "Passing children skips wrapper re-renders", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The element object is created by the outer owner. When the wrapper re-renders, props.children is identical so React skips that subtree."}], "edges": [{"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_slots_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_slots_pattern", "target": "docs_react_pages_phase_2_components_16_element_manipulation_children_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children", "target": "docs_react_pages_phase_2_components_12_render_props_render_prop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_context_hole", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_rsc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_children_skip", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_context_hole", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_compound_components", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_react19_provider", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/02-slots-and-children.md", "source_location": null, "weight": 1.0}], "hyperedges": []}