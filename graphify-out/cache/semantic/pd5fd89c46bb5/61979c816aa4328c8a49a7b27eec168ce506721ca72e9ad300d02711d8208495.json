{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_prometheus_metrics", "label": "Exposing metrics for Prometheus", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expose low-cardinality time series that map to the golden signals \u2014 not every event as a metric."}, {"id": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_pull_scrape", "label": "Prometheus pull scrape", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prometheus scrapes GET /metrics. Pull keeps service discovery, failure detection, and timestamps with the collector. Pushgateway is for short-lived jobs."}, {"id": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_metric_types", "label": "Counter, gauge, histogram, summary", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counters only go up (requests, errors). Gauges for lag, heap, pool wait. Histograms enable p50/p95/p99. Summaries are less common in modern setups."}, {"id": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_cardinality", "label": "Metric cardinality", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each unique label combination is a separate time series. userId, orderId, full URL, or exception message unbounded-series the cluster."}, {"id": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_metrics_endpoint", "label": "/metrics endpoint", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal only \u2014 NetworkPolicy, sidecar scrape, or a separate port. Same public API hostname without auth is a leak."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_prometheus_metrics", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_pull_scrape", "target": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_metrics_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_metric_types", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_latency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_14_prometheus_metrics_cardinality", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_low_cardinality_labels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/14-prometheus-metrics.md", "source_location": null, "weight": 1