{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_testable_code", "label": "Writing testable code \u2014 dependency injection", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/testable-code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_testable_code_dependency_injection", "label": "Dependency injection", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/testable-code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass the dependency in. Injection needs no flag, no import-order rule, and makes mocking mostly unnecessary."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_testable_code_hidden_dependencies", "label": "Hidden dependencies", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/testable-code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_testable_code_no_di_container", "label": "No DI container in Node", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/testable-code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function taking an object already is DI. A container adds indirection and a second language. Wire the graph by hand in main.mjs."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_testable_code_inject_db_handle", "label": "Inject database handle", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/testable-code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caller hands a