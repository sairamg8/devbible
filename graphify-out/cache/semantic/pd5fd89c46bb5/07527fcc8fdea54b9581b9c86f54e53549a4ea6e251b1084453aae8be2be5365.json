ull, "contributor": null, "rationale": "Signature is estimated rows=1 against actual rows=400001; ANALYZE dropped the query from 157 ms to 58 ms."}, {"id": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_non_indexable_predicate", "label": "Non-indexable predicate shape", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/05-index-not-used.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<> / NOT IN / leading wildcard cannot seek; OR is fine only when every branch has its own usable index."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_index_not_used", "target": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_function_wraps_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/05-index-not-used.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_index_not_used", "target": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_cast_on_indexed_side", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/05-index-not-used.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_index_not_used", "target": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_low_selectivity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/05-index-not-used.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_index_not_used", "target": "docs_postgresql_pages_phase_10_indexes_05_index_not_used_stale_statistics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file