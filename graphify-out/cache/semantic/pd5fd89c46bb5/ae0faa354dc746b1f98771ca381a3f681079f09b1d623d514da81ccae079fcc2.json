{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_operating_it", "label": "Operating a multi-tenant database", "file_type": "document", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_onboarding", "label": "Tenant onboarding", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared schema is an INSERT; schema-per-tenant is CREATE SCHEMA plus migrations; database-per-tenant is provisioning. Must be idempotent and transactional."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_deletion", "label": "Deleting a tenant completely", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separated models DROP SCHEMA CASCADE or DROP DATABASE. Shared schema DELETEs every table in FK order, ideally ON DELETE CASCADE plus information_schema-generated lists. Backups still hold data for the retention window."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_noisy_neighbours", "label": "Noisy neighbours", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL offers no intra-database isolation. Mitigate with per-role statement_timeout and work_mem, separate pools per tier, app rate limits, a reporting replica, or move a large tenant out."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_hybrid_tenancy", "label": "Hybrid tenancy", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long tail on shared schema, dedicated databases for the largest or contractually separated few. Arriving from shared is the reversible direction."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_bypassrls_analytics_role", "label": "BYPASSRLS analytics role", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global billing and admin queries must bypass RLS via a dedicated named role, not the table owner, so unrestricted access is explicit."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_application_name_tenant", "label": "application_name includes the tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_stat_statements normalises tenant id into a parameter and aggregates across tenants. application_name gives pg_stat_activity and the slow-query log per-tenant attribution."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_isolation_tests", "label": "Tenant isolation tests", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run as the application role. The forgotten case is two sequential requests for different tenants on one pooled connection, which catches SET versus SET LOCAL."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_shared_schema_shards_later", "label": "Shared schema shards later", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tenant_id is already the natural partition key. Keep it on every table and avoid cross-tenant foreign keys so splitting clusters later is routing."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_operating_it", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_onboarding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_operating_it", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_deletion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_operating_it", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_noisy_neighbours", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_hybrid_tenancy", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_hybrid_tenancy", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_database_per_tenant", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_bypassrls_analytics_role", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_tenant_isolation_tests", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_set_local_mandatory", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_shared_schema_shards_later", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_shared_schema_with_rls", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_03_operating_it_operating_it", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_02_models_compared_models_compared", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/03-operating-it.md", "source_location": null, "weight": 1.0}], "hyperedges": []}