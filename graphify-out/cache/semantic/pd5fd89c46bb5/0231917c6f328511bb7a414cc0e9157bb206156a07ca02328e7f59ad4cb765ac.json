{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_package_managers", "label": "npm, pnpm, yarn", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three install packages. The difference that matters is the shape of node_modules and whether an undeclared dependency can accidentally work."}, {"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_hoisting", "label": "Hoisted node_modules", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm and yarn flatten transitive dependencies into top-level node_modules so duplicates collapse."}, {"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_phantom_dependencies", "label": "Phantom dependencies", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A package your code imports without declaring it, because a hoisted transitive sat at the top level. It breaks when the real dependent drops it."}, {"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_pnpm_store", "label": "pnpm content-addressable store", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One copy of each version on disk; node_modules is symlinks exposing only declared dependencies. Undeclared imports fail immediately."}, {"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_corepack", "label": "Corepack", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pins the package manager per project via packageManager. Ships with Node but is not enabled by default."}, {"id": "docs_nodejs_pages_phase_1_modules_11_package_managers_workspaces", "label": "Workspaces", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One repo, several packages, one install, one lockfile. Siblings are symlinked. They do not give you build orchestration."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_11_package_managers_hoisting", "target": "docs_nodejs_pages_phase_1_modules_11_package_managers_package_managers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_11_package_managers_phantom_dependencies", "target": "docs_nodejs_pages_phase_1_modules_11_package_managers_hoisting", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_11_package_managers_hoisting", "target": "docs_nodejs_pages_phase_1_modules_05_module_resolution_node_modules_walk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/11-package-managers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_11_package_managers_pnpm_store", "target": "docs_nodejs_pages_phase_1_modules_11_package_managers_phantom_dependencies", "relation": 