{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions", "label": "Transactions from Node", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_pool_begin_bug", "label": "pool.query BEGIN bug", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pool.query may use a different connection. Concurrent flows can ROLLBACK each other's transactions. Appears to work when the process is idle."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_with_transaction", "label": "withTransaction helper", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checkout one client, BEGIN, run fn(client), COMMIT or ROLLBACK, release in finally. Propagate via explicit executor or AsyncLocalStorage. No HTTP inside a transaction."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_aborted_25p02", "label": "25P02 aborted transaction", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed statement poisons the Postgres transaction. Further commands return 25P02 until ROLLBACK. Continue only via SAVEPOINT / ROLLBACK TO SAVEPOINT."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_mongo_session", "label": "Mongo session.withTransaction", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires a replica set. Every operation must pass {session} or it commits independently. withTransaction retries the callback \u2014 it must be idempotent."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_pool_begin_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_with_transaction", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_pool_begin_bug", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_aborted_25p02", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_mongo_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/transactions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_transactions_po