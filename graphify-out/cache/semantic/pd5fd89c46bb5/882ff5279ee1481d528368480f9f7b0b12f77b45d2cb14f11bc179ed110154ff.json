{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_page", "label": "React vs the alternatives", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_signals", "label": "Signals vs re-render", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React's unit of update is the component; signals update bindings. Stale closures, deps and memo are consequences of React's choice."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_preact", "label": "Preact", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "13.0 KB min / 5.4 KB gzip vs React 189.8 / 59.2 for the same counter. Near-identical API; no RSC."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_when_not_react", "label": "When not to choose React", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embedded widget (Preact), mostly-static site (Astro), or a team already fluent in Vue/Svelte."}, {"id": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_compiler_vs_signals", "label": "Compiler is React's answer to signals", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the re-render model; move memoization into a build step."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_preact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_when_not_react", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_page", "target": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_compiler_vs_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-0-how-react-runs/react-vs-alternatives.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_0_how_react_runs_react_vs_alternatives_c