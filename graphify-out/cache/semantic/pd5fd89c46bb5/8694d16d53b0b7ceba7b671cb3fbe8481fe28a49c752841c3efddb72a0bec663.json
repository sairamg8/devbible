{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_semver_and_lockfiles", "label": "Semver, ranges and lockfiles", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_semver", "label": "semantic versioning", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MAJOR.MINOR.PATCH records maintainer intent, not a guarantee. A patch that fixes a bug your code depended on is still a break. 0.x anything may break; ^0.3.1 allows only 0.3.x."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_caret_tilde", "label": "caret and tilde ranges", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "^1.2.3 allows <2.0.0; ~1.2.3 allows <1.3.0. ^ is npm default so package.json does not describe what you are running."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_package_lock", "label": "package-lock.json", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records exact version, resolved URL and integrity hash for the whole tree. Commit it always including for libraries; consumers ignore it and use their own lockfile."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_integrity", "label": "lockfile integrity hash", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes install verifiable not just reproducible. A tampered tarball fails even if the version number matches."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_npm_ci", "label": "npm ci", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs the lockfile exactly, deletes node_modules first, never writes the lockfile, fails if package.json and lock disagree. Use in CI, Docker, production."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_overrides", "label": "package.json overrides", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Force a nested dependency version when the parent has not updated. You override the parent's declared compatibility \u2014 verify it works."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_semver_and_lockfiles", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_semver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/semver-and-lockfiles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_semver", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_semver_and_lockfiles_caret_tilde", "relation": "conceptually_related_to", "confi