{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_16_statistics", "label": "Statistics, ANALYZE and extended statistics", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_analyze", "label": "ANALYZE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The planner looks at a sample, not the data. A table analyzed at 2000 rows and grown to 402000 estimated 1 row of 400001 and took 157 ms instead of 58 ms. Last statement of every bulk load."}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_pg_stats", "label": "pg_stats", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_extended_statistics", "label": "Extended statistics", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-column stats assume independence and multiply selectivities. CREATE STATISTICS (dependencies, ndistinct) moved 33607 \u2192 100990 against an actual 100000. Must be created by hand and take effect only after ANALYZE."}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_default_statistics_target", "label": "default_statistics_target", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Histogram buckets and most-common-values. Raise per column, not globally: 101 buckets at 100, 1001 at 1000, ANALYZE 1309 ms."}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_autoanalyze", "label": "Autoanalyze threshold", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires at threshold + scale_factor \u00d7 reltuples \u2014 50 + 10% by default. On a 10-million-row table that is a million modifications; lower scale_factor to 0.01 on large tables."}, {"id": "docs_postgresql_pages_phase_10_indexes_16_statistics_reltuples_unknown", "label": "reltuples = -1 unknown", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_16_statistics", "target": "docs_postgresql_pages_phase_10_indexes_16_statistics_analyze", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_16_statistics_analyze", "target": "docs_postgresql_pages_phase_10_indexes_16_statistics_pg_stats", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_16_statistics_extended_statistics", "target": "docs_postgresql_pages_phase_10_indexes_16_statistics_analyze", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/16-statistics.md", "s