{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_scope_donut_scoping", "label": "@scope donut scoping", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@scope (.root) to (.limit) styles inside the root and stops at the limit inclusive. No combinator/:not() chain expresses a hole. Baseline Newly available 2025-12-12."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_scope_no_specificity", "label": "@scope does not add specificity", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@scope (.card) { .title } stays 0,1,0; .card .title would be 0,2,0. Containment equivalent of :where()."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_scope_proximity", "label": "@scope proximity cascade", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/scope.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When two scoped rules match, the nearer scoping root wins before specificity. The only place DOM distance participates in the cascade; enables nearest-ancestor theming."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_scope_donut_scoping", "target": "build_css_p2_docs_css_pages_phase_1_selectors_scope_no_specificity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/scope.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_scope_donut_scoping", "target": "build_css_p2_docs_css_pages_phase_1_selectors_scope_proximity", "relation": "conceptu