{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_local_dev_db_podman_postgres", "label": "Local PostgreSQL in Podman/Docker", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/local-dev-db.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin postgres:18-alpine on host port 55432. POSTGRES_* vars apply only on first data-directory init."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_local_dev_db_use_127_0_0_1", "label": "Connect on 127.0.0.1 never localhost", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/local-dev-db.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node resolves localhost to ::1 first. A container published on IPv4 only is not listening there."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_local_dev_db_pg_isready", "label": "Wait on pg_isready not sleep", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/local-dev-db.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The container reports running before TCP accepts. First-time init starts the server twice. A fixed sleep is flaky or slow."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_local_dev_db_alpine_collation", "label": "alpine vs debian collation", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/local-dev-db.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same PostgreSQL 18.4 and en_US.utf8: musl sorts by byte value, glibc applies locale rules. ORDER BY changes if the base image does not match prod