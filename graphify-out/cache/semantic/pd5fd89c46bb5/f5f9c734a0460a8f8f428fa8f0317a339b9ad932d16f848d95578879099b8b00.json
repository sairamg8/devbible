{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/07-transactional-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE ALTER DROP roll back like any statement. Most engines commit DDL implicitly. A created table vanished after a later 42P07 in the same transaction."}, {"id": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_atomic_migrations", "label": "Atomic migrations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/07-transactional-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing applied and nothing recorded stay consistent. Makes forward-only migrations practical. Still holds ACCESS EXCLUSIVE until commit."}, {"id": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_create_index_concurrently", "label": "CREATE INDEX CONCURRENTLY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/07-transactional-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "25001 cannot run inside a transaction. VACUUM and CREATE/DROP DATABASE also cannot. A failed CONCURRENTLY build leaves an INVALID index."}, {"id": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_invalid_index", "label": "INVALID concurrent index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/07-transactional-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignored by the planner and still maintained on every write. Find with pg_index WHERE NOT indisvalid, then drop and rebuild."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_07_transactional_ddl_atomi