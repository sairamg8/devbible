{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility", "label": "Schema compatibility \u2014 breaking vs non-breaking", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_direction_rule", "label": "Request vs response compatibility direction", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Response: adding is safe, removing or narrowing is not. Request: relaxing is safe, tightening is not. Same verb, opposite answers."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_expand_migrate_contract", "label": "Expand-migrate-contract", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rename is a removal plus an addition. Add the new field, migrate consumers, remove the old only after telemetry shows zero usage."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_enum_response", "label": "Adding an enum value to a response", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaking: exhaustive switches and TypeScript unions meet a value they have no branch for. Ship handling first, then emit."}, {"id": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_meaning_change", "label": "Field meaning change same type", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worst change: euros becoming cents validates perfectly and is off by 100. Never redefine a field \u2014 add a new one and deprecate."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_direction_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_expand_migrate_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_enum_response", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_direction_rule", "target": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility_expand_migrate_contract", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_9_testing_schema_compatibility", "target": "build_css_p2_docs_nodejs_syllabus_application_contract_testing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-9-testing/schema-compatibility.html", "source_location": null, "weight": 1.0}], "hyperedges": []}