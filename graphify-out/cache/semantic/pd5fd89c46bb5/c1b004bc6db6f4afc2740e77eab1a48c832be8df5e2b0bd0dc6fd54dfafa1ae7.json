{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_09_xss_xss", "label": "XSS and output encoding", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_09_xss_output_encoding", "label": "Encode on output, not input", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same string is safe in one context and executable in another. Input filters guess every future context, miss one, and corrupt O'Brien."}, {"id": "docs_nodejs_pages_phase_8_security_09_xss_json_in_script_tag", "label": "JSON.stringify inside a script tag", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "</script> inside the JSON string terminates the block. Replace < with \\u003c; also escape U+2028/U+2029. Or use type=application/json."}, {"id": "docs_nodejs_pages_phase_8_security_09_xss_content_type_nosniff", "label": "Content-Type and nosniff", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node sets no Content-Type. The browser sniffs and may parse JSON as HTML. Set the type plus X-Content-Type-Options: nosniff."}, {"id": "docs_nodejs_pages_phase_8_security_09_xss_javascript_url", "label": "javascript: URL in href", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSX escapes interpolation but treats javascript:alert(1) as a valid attribute. Validate scheme against http/https. dangerouslySetInnerHTML is the other hole."}, {"id": "docs_nodejs_pages_phase_8_security_09_xss_dompurify_allowlist", "label": "Allowlist HTML sanitiser", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not write the sanitiser. Allowlist tags and attributes; sanitise on output as well as storage so a library update improves stored content."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_09_xss_output_encoding", "target": "docs_nodejs_pages_phase_8_security_09_xss_xss", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_09_xss_xss", "target": "docs_nodejs_pages_phase_8_security_09_xss_json_in_script_tag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_09_xss_xss", "target": "docs_nodejs_pages_phase_8_security_09_xss_content_type_nosniff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_09_xss_xss", "target": "docs_nodejs_pages_phase_8_security_09_xss_javascript_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/09-xss.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_09_xss_xss", "target": "docs_nodejs_pages_phase_8_security_09_xss_dompurify_allowlist", "relation": 