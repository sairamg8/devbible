{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_method_borrowing", "label": "Method borrowing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array methods are generic: they need length and integer keys. [].slice.call(arrayLike) and push on a plain object both work. Array.from replaced most of this."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_tostring_call_typecheck", "label": "Object.prototype.toString.call type check", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the internal tag. typeof cannot distinguish array, null, Date, or Map. Defeated by Symbol.toStringTag; user classes are always [object Object]."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_apply_argument_limit", "label": "apply and spread argument limit", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both hit RangeError Maximum call stack size exceeded at large arity. Spread is not a fix. Use reduce or chunk."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_partial_application_bind", "label": "Partial application with bind", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills arguments from the left only. Bindings accumulate. null thisArg is safe only if the function never touches this."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_call_apply_cost", "label": "call apply bind cost", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct call is about 3x faster than any indirect form. call, apply, and spread are indistinguishable. Hoist bind out of loops. Tens of nanoseconds per call."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_method_borrowing", "target": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_call_apply_bind", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_method_borrowing", "target": "docs_javascript_pages_phase_3_functions_02_parameters_02_rest_destructuring_arguments_arguments_object", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/03-borrowing-and-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_03_borrowing_and_cost_tostring_call_typecheck", "target": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_call_apply_bind", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/