{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_loading_scripts_defer_vs_async", "label": "defer vs async vs type=module", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/loading-scripts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "defer waits for parse and keeps document order. async runs on arrival with no order. type=module is deferred automatically because the import graph must be fetched first."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_loading_scripts_module_waterfall", "label": "Native ESM request waterfall", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/loading-scripts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The graph is discovered one level at a time. modulepreload or bundling is why bundlers remain standard despite universal ESM."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_loading_scripts_nomodule", "label": "nomodule two-bundle pattern", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/loading-scripts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-aware browsers ignore nomodule; older ones ignore type=module. Largely historical in 2026."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_loading_scripts_defer_vs_async", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_strict_mode_strict_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/loading-scripts.html", "source_location": null, "