{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_page", "label": "HTTP in practice", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Methods, status codes, negotiation and CORS \u2014 the parts argued in review."}, {"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_safe_vs_idempotent", "label": "Safe vs idempotent methods", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe means no state change. Idempotent means n identical requests leave the same state as one. POST retries need a key."}, {"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_status_semantics", "label": "HTTP status semantics", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "401 vs 403 is who vs may-not; 400 vs 422 is parse vs business rule. Node drops bodies on 204 and HEAD."}, {"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_vary", "label": "Vary header", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any response that varies by a request header must say so or shared caches poison representations."}, {"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_cors_not_auth", "label": "CORS is a browser rule not authorization", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node fetch with a spoofed Origin read the whole response with no CORS headers. Protects the browser user only."}, {"id": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_cors_preflight", "label": "CORS preflight", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-simple requests (JSON, custom headers, PATCH/DELETE) send OPTIONS. * and credentials are mutually exclusive."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_cors_not_auth", "target": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_cors_preflight", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_cors_preflight", "target": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_vary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_03_http_fundamentals_safe_vs_idempotent", "target": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_idempotency_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/03-http-fundamentals.md", "source_location": null, "weight": 1.0}], "hyperedges": []}