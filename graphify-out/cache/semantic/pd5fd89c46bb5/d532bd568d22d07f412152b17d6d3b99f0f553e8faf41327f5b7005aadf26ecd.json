{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_uselayouteffect", "label": "useLayoutEffect", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_blocks_paint", "label": "useLayoutEffect blocks paint", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The guarantee is the blocking: React refuses to let the browser paint until the code and its state updates finish. Prefer useEffect."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_measure_then_place", "label": "Measure then place", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tooltip renders anywhere, measures height, re-renders in the right place. Two renders either way; layout effect only hides the first."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_server_warning", "label": "useLayoutEffect does nothing on the server", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No layout information and no paint on the server. Options: useEffect, client-only, isMounted, or useSyncExternalStore."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_drags_passive_effects", "label": "Layout-effect setState runs remaining Effects immediately", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A state update inside useLayoutEffect executes all remaining Effects including useEffect, dragging unrelated work onto the paint-blocking path."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_blocks_paint", "target": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_measure_then_place", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_uselayouteffect", "target": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_what_an_effect_is_for", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_uselayouteffect_uselayouteffect", "target": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_useeffect_anatomy", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/uselayouteffect.html", "source_location": null, "weight": 1.0}], "hyperedges": []}