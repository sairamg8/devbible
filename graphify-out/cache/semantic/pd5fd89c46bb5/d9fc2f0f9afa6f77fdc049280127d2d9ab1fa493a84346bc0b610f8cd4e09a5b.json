{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction", "label": "Idle in transaction", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_idle_in_transaction", "label": "idle in transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN then silence. wait_event=ClientRead: the server waits on the client. Holds a pool slot, locks, and possibly the horizon until COMMIT/ROLLBACK."}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_25p03", "label": "idle_in_transaction_session_timeout 25P03", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_transaction_timeout", "label": "transaction_timeout 25P04", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 17+. Kills any transaction older than N, busy or idle. Covers the always-active case the idle timeout misses."}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_statement_timeout_nohelp", "label": "statement_timeout does not kill idle transactions", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A session idle 600 ms with statement_timeout=200ms was still alive. No statement is running."}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_pool_error", "label": "pg pool error event on backend kill", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timeouts kill the backend. pg emits an error event, not a rejected promise. Unhandled, it crashes Node. pool.on('error') is mandatory; release(true) to destroy the client."}, {"id": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_pool_leak", "label": "Leaked transaction costs a pool slot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction", "target": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_idle_in_transaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_idle_in_transaction", "target": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_25p03", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/14-idle-in-transaction.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_transaction_timeout", "target": "docs_postgresql_pages_phase_11_mvcc_14_idle_in_transaction_idle_in_transaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source