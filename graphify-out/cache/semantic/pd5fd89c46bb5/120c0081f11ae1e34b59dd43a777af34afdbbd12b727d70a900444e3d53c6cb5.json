{"nodes": [{"id": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "label": "Whitespace and text", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_compile_rules", "label": "JSX whitespace rules", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Newline-adjacent whitespace is stripped at compile time. Newline between elements is removed; between words becomes one space. Within a line, spaces are kept."}, {"id": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_disappearing_space", "label": "Disappearing space between elements", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaking <b>Hello</b> <i>world</i> across lines deletes the space. {' '} is an expression and survives Prettier."}, {"id": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_nbsp", "label": "{' '} vs &nbsp;", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "U+0020 collapses and may break. U+00A0 does neither. Entities work in JSX text, not inside {}."}, {"id": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_braces_literal", "label": "Strings in braces are literal", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compile-time whitespace rules apply only to JSX text. Template literals keep newlines; CSS still has to not collapse them."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_compile_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_disappearing_space", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_nbsp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_braces_literal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_13_form_elements_readme_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/14-whitespace-and-text.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_14_whitespace_and_text_page", "target": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "relation": "references", "