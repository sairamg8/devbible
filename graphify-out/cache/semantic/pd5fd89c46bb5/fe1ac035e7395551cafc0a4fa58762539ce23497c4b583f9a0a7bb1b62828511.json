{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_13_psqlrc_psqlrc", "label": ".psqlrc, the prompt and history", "file_type": "document", "source_file": "docs/postgresql/pages/phase-1-psql/13-psqlrc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_1_psql_13_psqlrc_startup_file", "label": ".psqlrc", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/13-psqlrc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes interactive psql pleasant and everyone else's psql different; configure freely, pass -X in every script."}, {"id": "docs_postgresql_pages_phase_1_psql_13_psqlrc_dash_x", "label": "psql -X / --no-psqlrc", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/13-psqlrc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A colleague's .psqlrc can change how a script's output parses; measured NULL displayed as (null) with the file and blank with -X."}, {"id": "docs_postgresql_pages_phase_1_psql_13_psqlrc_on_error_rollback", "label": "ON_ERROR_ROLLBACK interactive", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/13-psqlrc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicit savepoint before each interactive statement so a typo does not abort the whole transaction (25P02); deliberately does not apply to scripts."}, {"id": "docs_postgresql_pages_phase_1_psql_13_psqlrc_prompt1", "label": "PROMPT1 %x and %#", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/13-psqlrc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "%x shows an open transaction; %# shows superuser. Colour the producti