{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_03_token_storage_token_storage", "label": "Where to store tokens", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_03_token_storage_httponly_cookie", "label": "HttpOnly cookie credential", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript cannot read it. XSS can still act as the user on that page but cannot exfiltrate a portable credential. Flags: httpOnly, secure, sameSite; leave domain unset."}, {"id": "docs_nodejs_pages_phase_8_security_03_token_storage_localstorage", "label": "localStorage token", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readable by any script on the page, including a compromised dependency. sessionStorage is equally readable. Stolen JWTs often cannot be revoked."}, {"id": "docs_nodejs_pages_phase_8_security_03_token_storage_double_submit_csrf", "label": "Double-submit CSRF token", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random value in a readable cookie must be echoed in a header. Attacker can cause a request carrying cookies but cannot read them. Compare with timingSafeEqual."}, {"id": "docs_nodejs_pages_phase_8_security_03_token_storage_samesite", "label": "SameSite cookie attribute", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lax is the current browser default and stops classic cross-site POSTs. Strict logs users out from external links. None re-opens CSRF and requires Secure plus a token."}, {"id": "docs_nodejs_pages_phase_8_security_03_token_storage_in_memory_access_token", "label": "In-memory SPA access token", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-lived JWT in memory; refresh in an HttpOnly cookie scoped to /auth/refresh. Persisting the access token for convenience undoes the design."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_03_token_storage_token_storage", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_httponly_cookie", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_03_token_storage_token_storage", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_localstorage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_03_token_storage_token_storage", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_double_submit_csrf", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/03-token-storage.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_03_token_storage_token_storage", "target": "docs_nodejs_pages_phase_8_security_03_token_storage_samesite", "relati