{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_call_time", "label": "Defaults evaluated at call time", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored unevaluated; run left to right only for omitted arguments. order(1,undefined,3) evaluates only b."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_undefined_not_null", "label": "Only undefined triggers a default", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null is a value: greet(null) is 'hi null'. Missing key vs DB NULL are not interchangeable. Use ?? in the body if null should fall back."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_parameter_tdz", "label": "Parameter-list TDZ", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Later defaults can read earlier parameters (h=w*2). Forward refs throw at runtime only when that default runs. (a=a) is TDZ too."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_shared_default_myth", "label": "Shared-default myth", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "list=[] is fresh each call. list=shared mutates one outer array. Constructing defaults are safe; referencing defaults are not."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_fn_length", "label": "fn.length stops at first default", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a=1,b)=>0 reports 0. Express error handlers (length===4) silently stop routing if a default is added. Default in the body instead."}, {"id": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_two_scopes", "label": "Parameter scope vs body scope", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any default creates two scopes. A default closure keeps the parameter x; var x in the body is a different binding. scopes('param') is ['body','param']."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_06_spread_and_rest_rest_length", "target": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_fn_length", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults_and_scope_undefined_not_null", "target": "docs_javascript_pages_phase_2_operators_03_logical_operators_nullish_default", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-3-functions/02-parameters/01-defaults-and-scope.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_02_parameters_01_defaults