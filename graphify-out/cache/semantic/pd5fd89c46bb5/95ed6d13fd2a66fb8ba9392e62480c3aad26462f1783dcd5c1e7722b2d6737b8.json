{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_pagination_counts_what_total_costs_limit_plus_one", "label": "LIMIT pageSize + 1 has-more", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/pagination-counts/what-total-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2.10 ms vs 2.11 ms for the plain page \u2014 free and exact. Slice the extra row before responding or the last page returns 21 items. Compose with keyset, not OFFSET."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_pagination_counts_what_total_costs_count_over_window", "label": "count(*) OVER () plus page", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/pagination-counts/what-total-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WindowAgg must see every matching row before emitting the first, so LIMIT cannot stop early. 152.77 ms vs 48.83 ms for a separate count(*); plan showed WindowAgg actual rows=125000 feeding Limit 20."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_pagination_counts_what_total_costs_exact_count", "label": "Exact count(*) for pagination total", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/pagination-counts/what-total-costs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "48.83 ms against 2.11 ms for the page (~23\u00d7). Scales with matching rows while the page stays bounded by LIMIT. Count once when the filter changes, not on every page."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_pagination_counts_what_total_costs_limit_plus_one", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_pagination_co