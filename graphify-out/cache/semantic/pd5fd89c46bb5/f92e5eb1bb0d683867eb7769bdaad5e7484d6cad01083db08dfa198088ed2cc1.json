{"nodes": [{"id": "docs_expressjs_pages_phase_5_errors_05_operational_vs_programmer_operational_errors", "label": "Operational errors", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-5-errors/05-operational-vs-programmer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected at the edge: bad input, not found, 409. Client sees a clear message + code."}, {"id": "docs_expressjs_pages_phase_5_errors_05_operational_vs_programmer_programmer_errors", "label": "Programmer errors", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-5-errors/05-operational-vs-programmer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bugs such as Cannot read properties of undefined. Client sees a generic 500. Messages leak paths, schemas, and exploit detail."}, {"id": "docs_expressjs_pages_phase_5_errors_05_operational_vs_programmer_request_scoped", "label": "Request-scoped vs process-level errors", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-5-errors/05-operational-vs-programmer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At the HTTP edge: expose operational, hide programmer, log both. Do not keep the process alive after unknown programmer errors in a bad state. Express error middleware is for request-scoped failures; uncaughtException is Node."}], "edges": [{"source": "docs_expressjs_pages_phase_5_errors_05_operational_vs_programmer_request_scoped", "target": "docs_expressjs_pages_phase_5_errors_05_operational_vs_programmer_operational_errors", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-5-errors/05-operational-vs-programmer.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_5_errors_05_operatio