{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "label": "Graceful worker shutdown", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigterm_drain", "label": "SIGTERM drain via worker.close", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured: killed 1.2s into a 3s job, await worker.close() finished in 2125 ms and completed exactly once. Stop claiming, finish in-flight, then close resources."}, {"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigkill_active_stuck", "label": "SIGKILL leaves the job active", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error, no retry scheduled. Recovered only when the visibility timeout expires and the stall sweep redelivers from the beginning \u2014 the deploy-duplication bug."}, {"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_ack_last", "label": "Acknowledge after the effect", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ack after the effect and a crash is a duplicate, which idempotency handles. Ack first and a crash is silent loss, which nothing handles."}, {"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_pid1_exec_form", "label": "node must be PID 1", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMD npm run worker or sh -c makes the shell PID 1; SIGTERM never reaches the handler. Use exec-form CMD [\"node\", \"src/worker.js\"]."}, {"id": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_close_order", "label": "Close worker before resources", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closing the pool first turns every in-flight job into a connection error \u2014 graceful-looking SIGKILL. Drain timeout must sit under terminationGracePeriodSeconds."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigterm_drain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigkill_active_stuck", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_ack_last", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_pid1_exec_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_graceful_shutdown", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_close_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigterm_drain", "target": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_sigkill_active_stuck", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_11_graceful_shutdown_ack_last", "target": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_timeout_is_unknown", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-7-background-work/11-graceful-shutdown.md", "source_location": null, "weight": 1.0}], "hyperedges": []}