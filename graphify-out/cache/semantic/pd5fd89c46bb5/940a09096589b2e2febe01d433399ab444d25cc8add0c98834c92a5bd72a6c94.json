{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_03_seeding_seeding", "label": "Seeding", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/03-seeding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seed runs more than once. If twice is not identical to once, it is a data-corruption script."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_03_seeding_on_conflict_do_nothing", "label": "ON CONFLICT DO NOTHING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/03-seeding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires a unique constraint. Idempotency is enforced by the database. SELECT-then-INSERT is not safe under concurrency."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_03_seeding_on_conflict_do_update", "label": "ON CONFLICT DO UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/03-seeding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reassert reference data the code depends on. EXCLUDED is the row that would have been inserted. Use DO NOTHING when a human may edit the row."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_03_seeding_identity_consumed", "label": "Identity consumed on skipped conflict", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/03-seeding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ON CONFLICT DO NOTHING draws the identity before detecting conflict. Two rows, three runs, sequence at 6. Sequences are not gapless."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_03_seeding_deterministic_fixtures", "label": "Deterministic fixtures"