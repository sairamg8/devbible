{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_shape", "label": "SELECT clause skeleton", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written order is SELECT FROM WHERE GROUP BY HAVING ORDER BY LIMIT. Evaluation order differs."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_alias_in_where", "label": "SELECT alias invisible in WHERE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE runs before the select list. WHERE total > 10 raises 42703; ORDER BY total works."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_star", "label": "SELECT * is for psql", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Star silently widens payloads, defeats index-only scans, and collapses duplicate join column names."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_bigint_as_string", "label": "bigint and numeric as JS strings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg returns bigint and numeric as text to preserve precision. id === 5 is false for id '5'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_optional_null_or", "label": "Optional filter $1 IS NULL OR col = $1", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One statement serves filtered and unfiltered lists so the plan cache stays warm. Cast $1 so the type can be inferred."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_alias_in_where", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_shape", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_star", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_shape", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_bigint_as_string", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_select_shape", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_optional_null_or", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_parameters_parameterized_queries", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/select-shape.html", "source_location": null, "weight": 1.0}], "hyperedges": []}