{"nodes": [{"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "label": "Reading the ordering", "file_type": "document", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_three_pass_method", "label": "Three-pass ordering method", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walk the synchronous path, drain the microtask queue, then run one task. The interview question is always an ordering question."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_requeues_at_back", "label": "Each await re-queues at the back of the microtask queue", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function with two awaits does not resume all at once \u2014 it rejoins the back of the queue at each one, which is why interleaving with other microtasks is possible."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_does_not_block_thread", "label": "await suspends the function, not the thread", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await cannot rescue a synchronous hot loop. Once the continuation resumes, it runs to completion like any other job."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_async_interleaving", "label": "Two async functions interleave", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both run synchronously to their first await, then resume in queue order. Concurrency without parallelism: one thread, two suspended functions taking turns."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_in_loop_waterfall", "label": "await in a for loop is sequential", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each iteration suspends until its request settles. The loop is the correct shape when each step depends on the previous one, and the wrong shape when the steps are independent."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_in_foreach", "label": "await inside forEach does nothing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach discards the callback's return value, so the promises are never awaited and their rejections float free."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "target": "docs_javascript_pages_phase_7_async_07_async_await_02_where_it_suspends_where_it_suspends", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_three_pass_method", "target": "docs_javascript_pages_phase_7_async_07_async_await_02_where_it_suspends_sync_until_first_await", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_three_pass_method", "target": "docs_javascript_pages_phase_7_async_07_async_await_02_where_it_suspends_one_tick_minimum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_requeues_at_back", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_does_not_block_thread", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_requeues_at_back", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_async_interleaving", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_in_loop_waterfall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_reading_the_ordering", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_in_foreach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_requeues_at_back", "target": "docs_javascript_pages_phase_7_async_07_async_await_02_where_it_suspends_continuation_is_microtask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_async_interleaving", "target": "docs_javascript_pages_phase_7_async_07_async_await_03_reading_the_ordering_await_requeues_at_back", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/03-reading-the-ordering.md", "source_location": null, "weight": 1.0}, {"source": "