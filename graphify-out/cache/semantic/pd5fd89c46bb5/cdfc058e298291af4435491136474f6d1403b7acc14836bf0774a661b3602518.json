{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_shared_buffers", "label": "Shared buffers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/04-shared-buffers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL's shared-memory cache of 8 KB table/index pages used by all backends. Measured alpine default 128MB. Too large fights the OS cache."}, {"id": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_os_page_cache", "label": "OS page cache", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/04-shared-buffers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kernel caches file pages the server read or wrote. PostgreSQL benefits from it but does not manage it as its own API. A shared-buffer miss may still be an OS-cache hit."}, {"id": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_work_mem", "label": "work_mem", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/04-shared-buffers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend-private sort/hash memory. Not the main row cache. Distinct from shared buffers."}, {"id": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_eight_kb_pages", "label": "8 KB pages", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/04-shared-buffers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit of table/index I/O in shared buffers and on disk."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_shared_buffers", "target": "docs_postgresql_pages_phase_0_architecture_04_shared_buffers_os_page_cache", "relati