{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_explicit_conversion_number_vs_parseint", "label": "Number vs parseInt", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/explicit-conversion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number('42px') is NaN; parseInt('42px') is 42. Number('') is 0; parseInt('') is NaN. Use Number for validation."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_explicit_conversion_map_parseint", "label": "map(parseInt) radix trap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/explicit-conversion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "map passes (value, index). parseInt('2', 1) and parseInt('3', 2) are NaN. Use map(Number)."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_explicit_conversion_convert_at_boundary", "label": "Convert at the boundary", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/explicit-conversion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Form values, query params, localStorage and env vars are strings. Parse once on the way in. Apply ?? default before Number because Number(null) is 0."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_explicit_conversion_number_vs_parseint", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_explicit_conversion_map_parseint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/explicit-conversion.html", "source_location