{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking", "label": "Ranking window functions", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_row_number", "label": "row_number()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always unique within the partition; ties still get consecutive numbers in ORDER BY order."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_rank", "label": "rank()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tied peers share a rank; the next rank skips so the sequence has gaps."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_dense_rank", "label": "dense_rank()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tied peers share a rank; the next rank does not skip."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_ntile", "label": "ntile()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits the partition into N buckets as evenly as possible; remainder buckets get one extra row."}, {"id": "build_css_p