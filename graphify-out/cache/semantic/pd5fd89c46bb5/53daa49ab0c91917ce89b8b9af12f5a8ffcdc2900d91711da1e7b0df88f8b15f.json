{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_dump_formats", "label": "Dump formats and what is in them", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_custom_format_fc", "label": "Custom dump format -Fc", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default choice: compressed, indexed, selective and parallel restore, one file. Same size as gzipped plain text; unlike -Fp the format cannot be changed after the dump."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_table_of_contents", "label": "pg_restore table of contents", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_restore -l lists restorable items. TABLE vs TABLE DATA enables schema-only or data-only. SEQUENCE SET captures identity positions; skip them and the first insert duplicates keys."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_roles_not_in_pg_dump", "label": "Roles are not in pg_dump", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The GRANT is dumped; CREATE ROLE is not. A complete logical backup is pg_dumpall --roles-only plus pg_dump. Also absent: tablespaces, other databases, postgresql.conf, pg_hba.conf, replication slots."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_dump_version_compat", "label": "pg_dump version compatibility", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_dump may be newer than the server, never older. Restoring into an older major is unsupported. Downgrading is a logical-replication job."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_roles_not_in_pg_dump", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_01_roles_and_membership_pg_authid", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_custom_format_fc", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_table_of_contents", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_table_of_contents", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_selective_restore_indexes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_dump_formats", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_restoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/01-dump-formats.md", "source_location": null, "weight": 1.0}], "hyperedges": []}