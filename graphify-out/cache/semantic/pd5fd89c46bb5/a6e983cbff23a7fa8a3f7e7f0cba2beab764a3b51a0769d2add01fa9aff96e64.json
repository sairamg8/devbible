{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_05_session_management_session_management", "label": "Session management", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_05_session_management_session_fixation", "label": "Session fixation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attacker gets the victim to use a known session id, then rides it after login. Works whenever the identifier survives the privilege change."}, {"id": "docs_nodejs_pages_phase_8_security_05_session_management_rotation_on_privilege", "label": "Rotate session on privilege change", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Destroy and recreate on login, logout, password/email change, MFA completion, role elevation. 32 bytes from randomBytes, never Math.random."}, {"id": "docs_nodejs_pages_phase_8_security_05_session_management_server_side_logout", "label": "Server-side logout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "clearCookie only removes this browser's copy. Anyone who captured the id still has a working credential. Delete the Redis row."}, {"id": "docs_nodejs_pages_phase_8_security_05_session_management_idle_and_absolute_timeout", "label": "Idle and absolute session timeouts", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idle alone lets a daily session live forever; absolute alone interrupts active users. Redis TTL is only idle; absolute reads stored createdAt."}, {"id": "docs_nodejs_pages_phase_8_security_05_session_management_user_session_index", "label": "Per-user session index", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "user-sessions:userId is how 'log out everywhere' and password-change revocation work. Cannot be added retroactively for sessions already issued."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_05_session_management_session_management", "target": "docs_nodejs_pages_phase_8_security_05_session_management_session_fixation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_05_session_management_rotation_on_privilege", "target": "docs_nodejs_pages_phase_8_security_05_session_management_session_fixation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_05_session_management_session_management", "target": "docs_nodejs_pages_phase_8_security_05_session_management_server_side_logout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/05-session-management.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_05_session_management_session_manag