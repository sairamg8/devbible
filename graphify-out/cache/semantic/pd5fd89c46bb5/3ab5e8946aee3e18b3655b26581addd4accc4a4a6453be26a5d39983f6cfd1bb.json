{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_drill", "label": "Disaster drill", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An untested backup is a belief. A drill converts an unknown RTO into a known one."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_rto", "label": "Recovery Time Objective", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measure detection, decision, fetch, restore, verify, repoint. Restore usually dominates \u2014 measured 4\u00d7 dump time."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_pitr", "label": "Point-in-time recovery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most likely disaster is a bad migration or wrong DELETE. Replicas replicate the mistake; only PITR helps."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_runbook", "label": "Disaster runbook", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must live outside the systems it describes. Someone who did not write it must be able to follow it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_backup_retention_window", "label": "Backup retention window", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose against how long a problem might go unnoticed. Slow corruption discovered weeks later defeats a 7-day window."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_drill", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_rto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_drill", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_pitr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_drill", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_disaster_runbook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_pitr", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_backup_retention_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/disaster-drill.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_disaster_drill_rto", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_dump_restore_pg_dump_restore