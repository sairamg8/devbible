{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_whats_happening_now", "label": "What is happening right now", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_pg_stat_activity", "label": "pg_stat_activity", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per server process. Filter backend_type = client backend and state <> idle, order by xact_start. xact_age vs query_age distinguishes a slow statement from idle in transaction. Remembers nothing."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_idle_in_transaction", "label": "idle in transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN then the application went away. Holds locks, pins the vacuum horizon, and occupies a pooled backend. query shows the last statement, the clue to the missing COMMIT or release()."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_wait_events", "label": "Wait events", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lock means find the blocker. Client/ClientRead means the application is slow, not the database. IO is disk-bound."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_pg_blocking_pids", "label": "pg_blocking_pids", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns pids holding locks the waiter needs. Fix the root of the chain, not the queue. pg_locks is the detail when lock mode and object matter."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_cancel_vs_terminate", "label": "pg_cancel_backend vs pg_terminate_backend", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancel stops the running query and keeps the session; it does nothing to idle in transaction. Terminate closes the session and rolls back. Prefer cancel first; set idle_in_transaction_session_timeout so humans are the fallback."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_pg_stat_activity", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_idle_in_transaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_pg_stat_activity", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_wait_events", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/01-whats-happening-now.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_