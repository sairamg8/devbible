{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_outbound_side_effects_outbound_as_jobs", "label": "Outbound side-effects as jobs", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/outbound-side-effects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Email, webhooks and CRM calls belong on the queue so a provider outage delays a job instead of failing checkout."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_outbound_side_effects_four_properties", "label": "Outbound job four properties", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/outbound-side-effects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent on a domain key, bounded by a timeout, classified 4xx vs 5xx/429, recorded locally."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_outbound_side_effects_webhook_fanout", "label": "Webhook fan-out", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/outbound-side-effects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One dispatcher enqueues one delivery job per subscriber. A loop over N subscribers retries the ones that already succeeded."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_outbound_side_effects_outbound_as_jobs", "target": "build_css_p2_docs_nodejs_pages_phase_7_background_work_sync_vs_background_request_path_minimum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/outbound-side-effects.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_p