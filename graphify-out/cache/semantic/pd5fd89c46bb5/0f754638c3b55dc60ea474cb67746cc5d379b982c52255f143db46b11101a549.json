{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_named_prepared_statements", "label": "Named prepared statements", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding name issues server-side PREPARE. Measured 1.6\u00d7 on 2000 trivial lookups (772 ms unnamed vs 481 ms named)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_generic_vs_custom_plan", "label": "Generic vs custom plan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom plans for the first five executions; from the sixth PostgreSQL may switch to a generic plan. Skewed data then gets the wrong plan. force_custom_plan restores per-value planning."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_per_session", "label": "Prepared statements are per session", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A statement prepared on pid 1932 is invisible to pid 1933. A pool of N prepares up to N times. Dynamic names leak server memory."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_pgbouncer_break", "label": "PgBouncer breaks named statements", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transaction/statement pooling routes consecutive queries to different backends \u2192 26000 prepared statement does not exist. Use session pooling or disable names."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_named_prepared_statements", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_dollar_placeholders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_named_prepared_statements", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_generic_vs_custom_plan", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_per_session", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_named_prepared_statements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_pgbouncer_break", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_prepared_per_session", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/prepared.html", "source_location": null, "weight": 1.0}], "hyperedges": []}