{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_joins", "label": "Anti joins and the NOT IN trap", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT EXISTS implements the anti join correctly. NOT IN returns the empty set the moment the subquery contains one NULL."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "label": "Anti join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps left rows with no match. Default spelling is NOT EXISTS. Must prove absence, so it cannot short-circuit the way a semi join does."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_not_in_null_trap", "label": "NOT IN NULL trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x NOT IN (a,b,NULL) expands to AND of inequalities including x <> NULL, which is NULL for any x. WHERE keeps only true, so every row vanishes. Measured: Dee became []."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_hash_anti_join", "label": "Hash Anti Join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT EXISTS gets Parallel Hash Anti Join. NOT IN gets Seq Scan plus subplan because the planner cannot assume the column is NULL-free."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_left_join_is_null", "label": "LEFT JOIN \u2026 WHERE pk IS NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older idiom that plans as Hash Anti Join. Correctness depends on the tested column being NOT NULL \u2014 test the primary key, not a nullable column."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_except_vs_anti_join", "label": "EXCEPT is not an anti join", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXCEPT compares whole rows, de-duplicates the left side, and plans as HashSetOp. It answers set difference, not 'which left rows have no related row'."}, {"id": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join_index", "label": "Anti join needs the child FK index more", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absence must be proven for every unmatched left row. Without an index on the correlated child column that is a scan per left row."}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_joins", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_semi_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_not_in_null_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_hash_anti_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_left_join_is_null", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_except_vs_anti_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join_index", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_anti_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_03_semi_anti_02_anti_joins_hash_anti_join", "target": "docs_postgresql_pages_phase_5_joins_03_semi_anti_01_semi_joins_hash_semi_join", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-5-joins/03-semi-anti/02-anti-joins.md", "source_location": null, "weight": 1.0}], "hyperedges": []}