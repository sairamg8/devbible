{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_hooks_async_hooks", "label": "async_hooks", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Experimental lifecycle hooks (init/before/after/destroy) that track the async context tree. For APM vendors, not app code."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_hooks_asyncresource_bind", "label": "AsyncResource.bind", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures the current async context and restores it when a callback later runs \u2014 the fix for EventEmitter and queue context loss."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_hooks_execution_trigger_ids", "label": "executionAsyncId and triggerAsyncId", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Id of the executing async context and the id that created it. The tree AsyncLocalStorage walks."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_hooks_diagnostics_channel", "label": "node:diagnostics_channel", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supported instrumentation: named channels with near-zero cost when nobody is subscribed. Prefer over createHook."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_hooks_avoid_createhook", "label": "Do not use createHook in application code", "file_ty