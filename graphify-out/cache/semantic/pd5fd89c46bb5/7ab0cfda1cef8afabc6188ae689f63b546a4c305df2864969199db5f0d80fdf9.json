{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_14_redos_page", "label": "ReDoS", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One backtracking regex on the event loop stalls the whole Node process. Verified Node 24.19.0: 28 chars \u2192 3.6 s CPU, 10 ms interval fired zero times."}, {"id": "docs_nodejs_pages_phase_8_security_14_redos_redos", "label": "Regular expression denial of service", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slow regex is a security problem because Node matches synchronously on the only request thread. Node 24 has no engine-level regex timeout."}, {"id": "docs_nodejs_pages_phase_8_security_14_redos_catastrophic_backtracking", "label": "Catastrophic backtracking", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nested quantifiers, overlapping alternation, or a quantified group that can fail. The failing near-match is the expensive case; valid inputs short-circuit."}, {"id": "docs_nodejs_pages_phase_8_security_14_redos_input_length_cap", "label": "ReDoS input length cap", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Input length is the exponent. Cap then reject \u2014 do not truncate, which can turn a hostile non-match into an accidental match. Cheapest mitigation."}, {"id": "docs_nodejs_pages_phase_8_security_14_redos_worker_threads_timeout", "label": "Worker-thread regex timeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AbortSignal and setTimeout cannot interrupt a synchronous match. A worker_threads worker can be terminate()d; re2 is the linear-engine alternative."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_14_redos_page", "target": "docs_nodejs_pages_phase_8_security_14_redos_redos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_14_redos_page", "target": "docs_nodejs_pages_phase_8_security_14_redos_catastrophic_backtracking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_14_redos_page", "target": "docs_nodejs_pages_phase_8_security_14_redos_input_length_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_14_redos_page", "target": "docs_nodejs_pages_phase_8_security_14_redos_worker_threads_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_14_redos_catastrophic_backtracking", "target": "docs_nodejs_pages_phase_8_security_14_redos_redos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/14-redos.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages