{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins", "label": "RIGHT and FULL OUTER", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_right_join", "label": "RIGHT JOIN is LEFT JOIN with operands swapped", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer LEFT so the preserved table is read first. RIGHT earns its keep when FROM order is not yours to choose."}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_full_outer", "label": "FULL OUTER JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps unmatched rows from both sides. The reconciliation, migration-verify, and snapshot-diff tool."}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_hash_merge_only", "label": "FULL JOIN only merge or hash joinable", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must track unmatched rows on both sides. Nested loop has no cheap bookkeeping, so inequality FULL JOIN is rejected."}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_emulate_union_all", "label": "Emulate FULL OUTER with LEFT plus anti-join UNION ALL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_using_coalesce", "label": "USING on FULL JOIN coalesces the key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merged column is coalesce(left, right), never NULL for a row present on either side."}, {"id": "docs_postgresql_pages_phase_5_joins_06_outer_joins_is_distinct_from", "label": "IS DISTINCT FROM for snapshot diffs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<> yields NULL when either side is NULL and silently drops the differing row."}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_06_outer_joins", "target": "docs_postgresql_pages_phase_5_joins_06_outer_joins_right_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_06_outer_joins", "target": "docs_postgresql_pages_phase_5_joins_06_outer_joins_full_outer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_06_outer_joins", "target": "docs_postgresql_pages_phase_5_joins_06_outer_joins_hash_merge_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/06-outer-joins.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_5_joins_06_outer_joins", "target": "docs_postgresql_pages_phase_5_joins_06_outer_joins_emulate_union_all", "relation": "re