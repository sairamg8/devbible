{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_window_cost", "label": "What windows cost", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every window needs input sorted by PARTITION BY then ORDER BY. One window over 500000 rows took 530 ms; two sharing a sort 999 ms; two that cannot 1518 ms."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_windowagg_not_parallel", "label": "WindowAgg is not parallel-aware", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Gather in the plan. Extra cores do not help. Reduce input, share partitions, or provide an ordered index."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_shared_sort_prefix", "label": "Compatible windows share one sort", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If one partition/order spec is a prefix of the other, one Sort serves both WindowAgg nodes. Different partitions re-sort the whole intermediate (temp blocks 1070 \u2192 3671)."}, {"id": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_covering_index_for_window", "label": "Index matching PARTITION BY then ORDER BY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(user_id, amount DESC) turned 530 ms external merge into 283 ms index-only scan, 3783 \u2192 575 buffers. Incremental Sort appears when the index supplies only a prefix."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_window_cost", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_windowagg_not_parallel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_window_cost", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_shared_sort_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_covering_index_for_window", "target": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_03_what_windows_cost_window_cost", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/06-windows-intro/03-what-windows-cost.md", "source_location": null, "weight": 1.0}], "hyperedges": []}