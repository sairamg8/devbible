{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_page", "label": "Deserialization, open redirects, mass assignment", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three bugs, one root: the request decided the data shape and the code accepted it. Fix: name what you accept and ignore the rest."}, {"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_insecure_deserialization", "label": "Insecure deserialization", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse is inert data. RCE appears when eval, new Function, vm, YAML custom tags, or function-reviving libraries sit on top."}, {"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_open_redirect", "label": "Open redirect", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "//evil and /\\evil both start with / and resolve off-origin. includes(own-domain) matches fragments. Bypass of OAuth redirect_uri is account takeover."}, {"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_safe_next", "label": "safeNext origin check", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parse with new URL(next, BASE), compare origin, return pathname+search+hash only. Fail closed to a fixed path, never throw on malformed next."}, {"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_mass_assignment", "label": "Mass assignment", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreading req.body onto a record lets the client set isAdmin/credits. prisma.user.update({ data: req.body }) is the same bug with a DB round trip."}, {"id": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_field_allowlist", "label": "Field allowlist over denylist", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A denylist fails open on the column added next month. An allowlist (or schema that strips unknown keys) fails safe when the schema grows."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_page", "target": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_insecure_deserialization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignment.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_page", "target": "docs_nodejs_pages_phase_8_security_15_deserialization_redirects_mass_assignment_open_redirect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/15-deserialization-redirects-mass-assignmen