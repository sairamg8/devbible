{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_intersection", "label": "Intersection types A & B", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both at once. Every member of every operand is required. Mixin pattern for composing named fragments."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_union_vs_intersection", "label": "Union widens values, intersection widens members", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "| widens the set of values and narrows usable members; & does the reverse. Or feels permissive for values but makes the type less useful until narrowed."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_conflicting_never", "label": "Conflicting intersection members become never", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "type TB = {x:string} & {x:number} is silent. TB['x'] is never. Failure appears at assignment: Type 'string' is not assignable to type 'never'."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_extends_vs_and", "label": "interface extends vs intersection", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "extends reports TS2430 at the declaration. & produces an unsatisfiable type silently. Prefer extends for layered domain shapes."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_distributes", "label": "Intersections distribute over unions", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(A | B) & C becomes (A & C) | (B & C). Adds a shared field to every branch of a discriminated union without breaking the discriminant."}, {"id": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_branded_type", "label": "Branded type via intersection", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "string & { readonly __brand: 'UserId' } \u2014 a string no ordinary string has. Created at a validated boundary; exists only in the type system."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_union_vs_intersection", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_intersection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-1-type-vocabulary/intersection-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_conflicting_never", "target": "build_css_p2_docs_typescript_pages_phase_1_type_vocabulary_intersection_types_intersection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/d