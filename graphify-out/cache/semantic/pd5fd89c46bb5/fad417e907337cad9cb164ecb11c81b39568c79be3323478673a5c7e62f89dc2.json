{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_collapsing_rows", "label": "Collapsing rows", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An aggregate takes many values and returns one. GROUP BY decides which values go into each many. Every aggregate except count(*) skips NULL inputs."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_null_skipping_rule", "label": "NULL-skipping aggregate rule", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) counts rows; count(expr) counts non-NULL expr. sum/avg/min/max skip NULLs. Open group: two rows, avg 50.00 over one priced value."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_avg_vs_sum_over_count", "label": "avg(x) is sum(x)/count(x)", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not sum(x)/count(*). Measured 50.00 vs avg(coalesce(total,0))=25.00 on the open group. Which is correct is a product question."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_aggregate_return_types", "label": "Aggregate return types", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count and sum(int) return bigint; sum(bigint) and avg return numeric; min/max keep the input type. avg is numeric so money does not drift."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_bigint_as_string", "label": "bigint and numeric arrive as strings", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg will not guess a JS number that cannot represent the range. rows[0].n + 1 is '61'. Cast ::int for bounded counts or setTypeParser OID 20."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_int_cast_overflow", "label": "sum()::int overflow 22003", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ::int that makes JS convenient reintroduces the overflow bigint exists to prevent. (sum(amount)*20)::int raised 22003; left as bigint returned 3936859560."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_collapsing_rows", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_null_skipping_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_avg_vs_sum_over_count", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_01_collapsing_rows_null_skipping_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/01-collapsing-rows.md", "source_location": null, "weight":