{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_keys_string_or_symbol", "label": "Keys are string or symbol only", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything else is coerced to a string. o[1] and o['1'] are the same property; two plain objects collide on [object Object]. Map is the answer for identity or non-string keys."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_three_tier_key_order", "label": "Three-tier property enumeration order", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer-index keys first, ascending; then other strings by insertion; then symbols by insertion. An object keyed by numeric IDs reorders itself."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_integer_index_keys", "label": "Integer-index keys", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the canonical string form of a non-negative integer. -1, 01, 1.5 and 1e2 are ordinary strings. Zero-padded IDs sort into a different tier."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_enumeration_methods", "label": "Enumeration method comparison", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object.keys is own enumerable strings. Reflect.ownKeys is the only one-call way to get all own keys including symbols. for...in walks the prototype chain."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_map_for_identity_keys", "label": "Map for identity and ordered keys", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The moment keys are not naturally strings \u2014 objects, or numbers you care about as numbers \u2014 use a Map. Map is insertion-ordered for every key type."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_integer_index_keys", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_three_tier_key_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_map_for_identity_keys", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_keys_string_or_symbol", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/03-keys-and-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_03_keys_and_order_enumeration_methods", "target": "docs_javascript_pages_phase_4_objects_and_classes_0