{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_10_version_policy_major_vs_minor", "label": "Major vs minor versions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/10-version-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Major (17\u219218) needs planned upgrade via pg_upgrade, dump/restore, or logical replication. Minor (18.3\u219218.4) is same on-disk major: install and restart."}, {"id": "docs_postgresql_pages_phase_0_architecture_10_version_policy_five_year_support", "label": "Five-year major support", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/10-version-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL ships a new major roughly once a year and supports each major for about five years. Upgrade minors promptly; treat majors as a project."}, {"id": "docs_postgresql_pages_phase_0_architecture_10_version_policy_server_version_num", "label": "server_version_num", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/10-version-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer form useful in scripts. Measured 180004 = 18.4. Gate multi-major features on this, rarely needed for one product database."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_10_version_policy_major_vs_minor", "target": "docs_postgresql_pages_phase_0_architecture_10_version_policy_five_year_support", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/10-version-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_10_version_policy_server_version_num", "t