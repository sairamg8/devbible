{"nodes": [{"id": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "label": "typeof narrowing", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A typeof check changes the type inside the branch. Works on string, number, bigint, boolean, symbol, undefined, function. object is a bucket. Narrows the else by elimination too."}, {"id": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof_object_null", "label": "typeof object includes null", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof null === 'object' is a 1995 JavaScript bug that TypeScript models. Measured: string | number | null | undefined | string[] narrows to string[] | null. Pair with !== null."}, {"id": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_array_isarray", "label": "Array.isArray type guard", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in type guard. Narrows to string[] cleanly where typeof object cannot tell an array from a Date, a plain object, or null."}, {"id": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_reveal_type", "label": "Reveal narrowed type via impossible assignment", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const r: 1 = v reports Type 'X' is not assignable to type '1', naming the exact type the checker holds. Settles narrowing arguments without a runtime print."}], "edges": [{"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "target": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof_object_null", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "target": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_array_isarray", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_reveal_type", "target": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "target": "docs_typescript_pages_phase_1_type_vocabulary_05_union_types_union", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof", "target": "docs_typescript_pages_phase_2_narrowing_02_truthiness_and_equality_truthiness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/01-typeof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_01_typeof_narrowing_typeof_ob