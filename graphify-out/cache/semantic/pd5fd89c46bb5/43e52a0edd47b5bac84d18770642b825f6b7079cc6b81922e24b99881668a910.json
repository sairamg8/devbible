{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_string_agg", "label": "string_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops NULLs and emits no delimiter for them. Empty group is NULL not ''. text-only: 42883 on integer without ::text. coalesce(string_agg(...), '') before concatenation."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_array_agg", "label": "array_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps NULLs as elements \u2014 opposite of string_agg. FILTER (WHERE x IS NOT NULL) preferred over array_remove; if every value is NULL, FILTER yields NULL and array_remove yields {}."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_aggregate_internal_order_by", "label": "ORDER BY inside collection aggregates", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query's outer ORDER BY orders result rows, not aggregate input. Put ORDER BY inside the parentheses of every collection whose order a consumer can see."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_sibling_order_inheritance", "label": "Unordered aggregate inherits sibling ORDER BY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When one aggregate has an internal ORDER BY, the executor may sort the shared input once. An unordered sibling silently inherits that order \u2014 output can change when an unrelated column is added."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_distinct_order_by_42p10", "label": "DISTINCT aggregate ORDER BY 42P10", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "array_agg(DISTINCT a ORDER BY b) is rejected: after de-duplicating by a there is no single b. ORDER BY must use the DISTINCT expressions."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_string_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_array_agg", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_array_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_the_empty_array_trap_empty_array_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_sibling_order_inheritance", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_aggregate_internal_order_by", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_arrays_and_strings_array_agg", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_json_agg_json_shapes_jsonb_agg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/json-agg/arrays-and-strings.html", "source_location": null, "weight": 1.0}], "hyperedges": []}