{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_six_criteria", "label": "Cascade sorting order", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Origin+importance, context, inline styles, layers, specificity, appearance. First distinguishing criterion wins; the rest are never consulted."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_origin_importance", "label": "Origin and importance ladder", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight levels: transitions, important UA/user/author, animations, then normal author/user/UA. Important reverses origin order for accessibility."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_inline_styles", "label": "Inline styles are criterion 3", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not 'specificity 1000'. A normal inline beats every normal author rule; it loses to author !important because importance already separated them."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_author_ladder", "label": "Author cascade ladder", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weakest: normal first layer \u2192 later layers \u2192 unlayered \u2192 normal inline \u2192 animations \u2192 important unlayered \u2192 important later layers \u2192 important first layer \u2192 important inline."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_transitions", "label": "Transitions vs animations", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transitions sit above everything. Animations sit below important author, so !important is how you defeat a @keyframes value."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_w3c_cascade_l5", "label": "W3C CSS Cascade Level 5 \u00a76.1", "file_type": "document", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_six_criteria", "target": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_origin_importance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_six_criteria", "target": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_inline_styles", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/what-the-cascade-compares.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_what_the_cascade_compares_six_criteria", "target": "build_css_p2_docs_css_pages_phase_2_cascade_laye