{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_skip_locked", "label": "SKIP LOCKED", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omit locked rows instead of waiting. Turns a table into a concurrent work queue; trades FIFO for parallelism."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_job_queue", "label": "SKIP LOCKED job queue", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT ... FOR UPDATE SKIP LOCKED then commit the claim before work. 8 workers, 200 jobs: 168.6 ms, 0 duplicates vs 593 without locking."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_at_least_once", "label": "At-least-once job delivery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Committing the claim early leaves crashed workers' rows in running. A reaper plus idempotent handlers is the guarantee; exactly-once is not configurable."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_skip_locked", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_job_queue", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_skip_locked", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_at_least_once", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_job_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_skip_locked_job_queue", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_listen_notify_listen_notify", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/skip-locked.html", "source_location": null, "weight": 1.0}], "hyperedges": []}