{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_2_operators_conditionals_page", "label": "08 \u00b7 Conditionals", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/conditionals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_conditionals_guard_clauses", "label": "Guard clauses", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/conditionals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Early returns for failures so the happy path is last and unindented. Highest-value refactor for nested conditionals."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_conditionals_ternary_vs_if", "label": "Ternary vs if", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/conditionals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ternary chooses a value; if chooses an action. One level inline; two or more align as a decision table or extract a function."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_conditionals_always_braces", "label": "Always use braces", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/conditionals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A brace-less body contains only the first statement. Apple's goto-fail TLS bug. Also interacts badly with ASI. Enable ESLint curly."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_conditionals_lookup_table", "label": "Object lookup instead of branching", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-2-oper