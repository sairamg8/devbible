{"nodes": [{"id": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap", "label": "The configuration trap", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_trap", "label": "Configuration trap", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A component becomes an interpreter of a private option language. API grows without bound, combinations go untested, every caller pays unused imports, and markup is hidden."}, {"id": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_composition", "label": "Composition over configuration", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A prop that exists only to be rendered should have been the rendered thing. Pass the Button, not actionLabel plus onAction plus actionVariant."}, {"id": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_elements_are_values", "label": "Elements are ordinary values", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating an element does not render it. Where it is created decides what it can close over."}, {"id": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_when_config", "label": "When configuration is the right answer", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep a prop for data, component-owned behaviour, closed design-system variants, or consistency. Design decisions are props; caller markup is composition."}], "edges": [{"source": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap", "target": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_composition", "target": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_elements_are_values", "target": "docs_react_pages_phase_2_components_03_composition_02_slots_and_children_context_hole", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/03-composition/01-the-configuration-trap.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_when_config", "target": "docs_react_pages_phase_2_components_03_composition_01_the_configuration_trap_composition", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_