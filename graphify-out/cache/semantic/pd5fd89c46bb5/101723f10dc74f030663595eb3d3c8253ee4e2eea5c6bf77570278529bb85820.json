{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_page", "label": "ESLint flat config, Prettier, or Biome", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08: eslint 10.8.1, prettier 3.9.6, @biomejs/biome 2.5.8 on Node 24.19.0."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_linter_vs_formatter", "label": "Linter vs formatter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A formatter rewrites layout and has no opinion about correctness; a linter finds legal code that is probably wrong. You need both, from two tools or one."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_eslint_flat_config", "label": "ESLint flat config", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eslint.config.mjs is the only format in ESLint 9+. No extends (spread objects), no env (globals package), no nested-file cascade \u2014 one file scoped by files globs."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_prettier", "label": "Prettier", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formatting only, almost unconfigurable. Pair with eslint-config-prettier so ESLint stylistic rules do not fight it on save."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_biome", "label": "Biome", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 0.09s vs 0.75s for ESLint plus Prettier, doing lint, format and import organisation. No JS plugin API and no type-aware rules."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_type_aware_rules", "label": "Type-aware lint rules", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "no-floating-promises needs the type checker. Biome cannot replace typescript-eslint. Highest-value Node rule: catches a missing await at write time."}, {"id": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_cheapest_layer", "label": "Linting as cheapest testing layer", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A type-aware linter catches a floating promise, unused variable and == in milliseconds on every file. Wire it into CI via verify, not just the editor."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_linter_vs_formatter", "target": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_eslint_flat_config", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_prettier", "target": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_eslint_flat_config", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_biome", "target": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_eslint_flat_config", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_type_aware_rules", "target": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_biome", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_cheapest_layer", "target": "docs_nodejs_pages_phase_9_testing_readme_phase_9", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_page", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/16-lint-and-format.md", "source_location": null, "weight": 1.0}], "hyperedges": []}