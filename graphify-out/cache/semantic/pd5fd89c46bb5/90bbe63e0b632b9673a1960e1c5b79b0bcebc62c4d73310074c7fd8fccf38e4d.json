{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews", "label": "Materialized views and REFRESH CONCURRENTLY", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_stores_result", "label": "Materialized view stores its result", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "256 kB against a plain view's 0 bytes. Needs its own indexes. Not automatically faster if the view already pushes down."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_refresh_concurrently", "label": "REFRESH CONCURRENTLY unique index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONCURRENTLY diffs old against new and needs a key. Without a unique index it raises 55000. 1.6\u00d7 slower than plain REFRESH."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_access_exclusive_lock", "label": "Plain REFRESH AccessExclusiveLock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readers waited 32 ms of a 142 ms plain REFRESH. CONCURRENTLY waited 2 ms. No incremental refresh exists."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_staleness", "label": "Matview staleness is yours to manage", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing refreshes it. Prefer a scheduled refresh. A trigger-driven full recompute inside a write is almost always wrong."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_with_no_data", "label": "CREATE MATERIALIZED VIEW WITH NO DATA", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Querying before populate raises 55000. Check pg_class.relispopulated in a health check."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_stores_result", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views_stored_query", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_refresh_concurrently", "target": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_access_exclusive_lock", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/11-matviews.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_11_matviews_staleness", "target": "docs_postgresql_pages_phase_12_beyond_tables_08_triggers", "relation": "conceptually_related_to", "confidence": "INFERRED", "