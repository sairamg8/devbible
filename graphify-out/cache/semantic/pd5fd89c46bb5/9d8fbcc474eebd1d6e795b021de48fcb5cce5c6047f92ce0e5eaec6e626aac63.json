{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "label": "RETURNING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only way to read what a write did without a second query that can see a different transaction's data."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_vs_later_select", "label": "RETURNING vs later SELECT", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under READ COMMITTED a follow-up SELECT takes a fresh snapshot and can race. RETURNING is the same statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_old_new", "label": "RETURNING old. and new.", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 18 can return both versions of an updated row. On 17 and below this is a syntax error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_do_nothing_trap", "label": "ON CONFLICT DO NOTHING RETURNING trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A skipped conflict returns no row. DO UPDATE of a harmless column plus xmax = 0 always returns a row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_cte_pipeline", "label": "RETURNING into a CTE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE \u2026 RETURNING can feed an INSERT in one atomic statement. Sibling CTEs share a snapshot and see only RETURNING output."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_no_defined_order", "label": "Multi-row RETURNING has no order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RETURNING takes no ORDER BY. Wrap in a CTE and sort the outer SELECT."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_vs_later_select", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_old_new", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_do_nothing_trap", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_cte_pipeline", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_no_defined_order", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_returning_returning", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_select_shape_bigint_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/returning.html", "source_location": null, "weight": 1.0}], "hyperedges": []}