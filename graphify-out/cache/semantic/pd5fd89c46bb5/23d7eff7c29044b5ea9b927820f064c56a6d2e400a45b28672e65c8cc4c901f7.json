{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "label": "Join fan-out", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A joined parent row is repeated once per child. sum(o.total) after joining items returned 450 against a true 350. The join does not corrupt data; it changes grain."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_grain", "label": "Result grain", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What one row represents. A join sets grain to the finest side. An aggregate is only correct on columns at that grain. Detect fan-out with count(*) versus count(DISTINCT parent.id)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_pre_aggregate", "label": "Pre-aggregate then join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduce the child to one row per parent before joining so the grain stays one row per parent. LEFT JOIN plus coalesce so parents with no children survive as 0."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_count_distinct", "label": "count(DISTINCT) after fan-out", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rescues counts only. sum(DISTINCT o.total) collapses two orders that happen to share a total. There is no useful sum(DISTINCT) for money."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_grain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_pre_aggregate", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_count_distinct", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_group_by", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/fan-out-and-aggregates.html", "source_location": null, "weight": 1.0}], "hyperedges