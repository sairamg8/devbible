{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_page", "label": "node:http \u2014 the server", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createServer hands you two streams. Frameworks are a router on exactly this."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_create_server", "label": "http.createServer", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "req is IncomingMessage, res is ServerResponse. Header names are lower-cased; req.url is path plus query only."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_headers_sent", "label": "ERR_HTTP_HEADERS_SENT", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headers flush on the first body byte. Guard error paths with res.headersSent and destroy if too late."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_timeouts", "label": "headersTimeout requestTimeout connectionsCheckingInterval", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timeouts are swept every 30s by default. Lowering requestTimeout alone does nothing until the next check."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_handler_uncaught", "label": "Thrown handler is not a 500", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node:http has no error handling. Exceptions become uncaughtException or unhandledRejection and the client hangs."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_client_error", "label": "server clientError", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Malformed request line or illegal header never becomes req/res. Write 400 on the raw socket."}, {"id": "docs_nodejs_pages_phase_5_http_processes_01_http_server_keep_alive_timeout", "label": "server.keepAliveTimeout", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 5s. If a proxy idle timeout is longer, reuse of a closing socket surfaces as 502."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_01_http_server_create_server", "target": "docs_nodejs_pages_phase_5_http_processes_01_http_server_headers_sent", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_01_http_server_handler_uncaught", "target": "docs_nodejs_pages_phase_5_http_processes_01_http_server_create_server", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/01-http-server.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_01_http_server_timeouts", "target": "docs_nodejs_pages_phase_5_http_processes_01_http_server_create_server"