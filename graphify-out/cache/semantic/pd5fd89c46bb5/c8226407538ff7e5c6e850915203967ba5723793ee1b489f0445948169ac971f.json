{"nodes": [{"id": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_defer", "label": "script defer", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads in parallel, runs after HTML is parsed, in document order. Safe default for classic scripts; DOM is complete so no DOMContentLoaded wrapper is needed."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_async", "label": "script async", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the moment it arrives; no order between async scripts. Only for independent third-party code."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_type_module", "label": "script type=module", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred automatically and strict; the whole import graph must be fetched and parsed before execute, so deferral is a consequence of modules."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_module_request_waterfall", "label": "Module request waterfall", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The graph is discovered one level at a time. modulepreload or bundling flattens it; this is why bundlers remain standard despite native ESM."}, {"id": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_nomodule_two_bundle", "label": "nomodule two-bundle pattern", "file_type": "concept", "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-aware browsers ignore nomodule; older ones ignore type=module. Exactly one of the pair runs. Mostly historical in 2026."}], "edges": [{"source": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_defer", "target": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_async", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_type_module", "target": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_defer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_type_module", "target": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_module_request_waterfall", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_nomodule_two_bundle", "target": "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_type_module", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "script_loading_forms", "label": "HTML script loading forms and the module waterfall", "nodes": ["docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_defer", "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_async", "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_script_type_module", "docs_javascript_pages_phase_0_how_javascript_runs_07_loading_scripts_module_request_waterfall"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-0-how-javascript-runs/07-loading-scripts.md"}]}