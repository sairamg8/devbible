{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_then_returns_new_promise", "label": "then returns a new promise", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/flattening.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each link represents the previous step and this handler. Combined with adoption, each result becomes the next argument at the same level."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_floating_promise", "label": "Floating promise", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/flattening.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A started promise that was not returned. Sequencing breaks (next handler gets undefined immediately) and its rejection cannot reach the chain catch."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_always_return_the_promise", "label": "Always return the promise", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/flattening.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MDN's most consequential chaining rule. Prefer concise arrow bodies so a missing return is impossible."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_chain_is_sequential", "label": "A chain is strictly sequential", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/flattening.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each link waits for the previous. Independent work belongs in Promise.all and friends. Chaining indepen