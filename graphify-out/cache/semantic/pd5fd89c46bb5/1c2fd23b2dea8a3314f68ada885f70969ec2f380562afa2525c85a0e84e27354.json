{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_09_copy_copy_vs_backslash_copy", "label": "\\copy vs COPY", "file_type": "document", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_1_psql_09_copy_sql_copy", "label": "SQL COPY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COPY is SQL executed by the server and reads the server filesystem; it needs superuser or pg_read_server_files / pg_write_server_files."}, {"id": "docs_postgresql_pages_phase_1_psql_09_copy_backslash_copy", "label": "psql \\copy", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default to \\copy: it trades throughput for reach, needs no server privileges, and is the only option against a managed or containerised database."}, {"id": "docs_postgresql_pages_phase_1_psql_09_copy_copy_all_or_nothing", "label": "COPY is one transaction", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One malformed value rolls back the entire load; a three-row file with one bad value loaded zero rows."}, {"id": "docs_postgresql_pages_phase_1_psql_09_copy_staging_table_pattern", "label": "All-text staging table for untrusted CSV", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load into text columns then INSERT \u2026 SELECT with casts and a filter; there is no skip-bad-rows option except ON_ERROR ignore on PostgreSQL 17+."}, {"id": "docs_postgresql_pages_phase_1_psql_09_copy_copy_to_stdout", "label": "\\copy TO STDOUT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streams row by row rather than buffering the full result, so it is the right tool for exports larger than memory."}], "edges": [{"source": "docs_postgresql_pages_phase_1_psql_09_copy_copy_vs_backslash_copy", "target": "docs_postgresql_pages_phase_1_psql_09_copy_sql_copy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_09_copy_copy_vs_backslash_copy", "target": "docs_postgresql_pages_phase_1_psql_09_copy_backslash_copy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_09_copy_backslash_copy", "target": "docs_postgresql_pages_phase_1_psql_09_copy_sql_copy", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_09_copy_sql_copy", "target": "docs_postgresql_pages_phase_1_psql_09_copy_copy_all_or_nothing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-1-psql/09-copy.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_1_psql_09_copy_backslash_copy", "target": "docs_postgresql_pages_phase_1_psql_09_copy_copy_all_or_nothing", 