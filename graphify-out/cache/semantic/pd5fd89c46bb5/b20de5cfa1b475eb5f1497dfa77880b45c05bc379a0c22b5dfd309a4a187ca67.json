{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_pipeline_order", "label": "Window evaluation pipeline", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM \u2192 WHERE \u2192 GROUP BY \u2192 HAVING \u2192 SELECT \u2192 windows \u2192 DISTINCT \u2192 ORDER BY \u2192 LIMIT. Filter on a window needs another query level. DISTINCT after windows means row_number prevents de-duplication."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_42p20", "label": "42P20 window functions not allowed in WHERE/HAVING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE deciding which rows exist while the window depends on those rows would be circular. Fix: subquery or CTE, then filter. Planner flattens it and can push rn <= N as Run Condition."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_window_over_aggregate", "label": "Window over an aggregate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum(count(*)) OVER () is legal: GROUP BY produces per-group counts, then the window sums those group rows. Standard percentage-of-total without a self-join."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_named_window", "label": "Named WINDOW clause", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming convenience between HAVING and ORDER BY; planner already merges identical definitions. Can extend with ORDER BY/frame if the named window has none; cannot override existing ORDER BY or change PARTITION BY."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_pipeline_order", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_42p20", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_window_over_aggregate", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_pipeline_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_named_window", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_what_windows_cost_shared_window_sort", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/windows-intro/where-windows-run.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro_where_windows_run_42p20", "target": "build_css_p2_docs_postgresql_pages_