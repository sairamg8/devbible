{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where", "label": "ON vs WHERE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/02-on-vs-where.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where_where_cancels", "label": "WHERE on right table cancels LEFT JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/02-on-vs-where.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ON is the match rule; WHERE runs after NULL extension. NULL = 'paid' is unknown and discarded. Measured 4 rows vs 2."}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where_classification", "label": "Outer-join predicate classification", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/02-on-vs-where.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right-table predicates belong in ON; left-table predicates in WHERE; the join key in ON. A left filter in ON does not filter."}, {"id": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where_logical_order", "label": "FROM including ON then WHERE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/02-on-vs-where.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where", "target": "docs_postgresql_pages_phase_5_joins_02_left_join_02_on_vs_where_where_cancels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-5-joins/02-left-join/02-on-vs-where.md", "source_locat