{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_page", "label": "Seeding", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seed runs more than once. If twice is not identical to once, it is a data-corruption script."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_on_conflict_do_nothing", "label": "ON CONFLICT DO NOTHING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires a unique constraint. Measured rowCount 2, 0, 0. Bare INSERT raises 23505. SELECT-then-INSERT is not idempotent under concurrency."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_identity_consumed", "label": "Identity consumed on skipped conflict", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ON CONFLICT still evaluates the row and draws identity first. Three runs of two rows left last_value at 6. Sequences are not gapless."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_do_nothing_vs_do_update", "label": "DO NOTHING versus DO UPDATE", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DO NOTHING for rows a human may edit. DO UPDATE SET col = EXCLUDED.col for reference data the code depends on."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_not_migration", "label": "Seeding is not migration", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations change schema, run once, not edited after shipping. Seeds run every time and are editable. Reference data later migrations depend on belongs in a migration."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_on_conflict_do_nothing", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_silent_seed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_not_migration", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/seeding.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_seeding_on_conflict_do_nothing", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_idempotent_writes_key", "relation": "semantically_similar_to", "confidence": "INFERRE