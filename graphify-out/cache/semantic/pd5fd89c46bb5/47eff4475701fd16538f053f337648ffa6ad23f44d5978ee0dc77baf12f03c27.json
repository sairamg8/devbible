{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_whatwg_url", "label": "WHATWG URL", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URL and URLSearchParams are globals implementing the same standard as the browser. Handle encoding and relative resolution string concat gets wrong."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_url_parse_deprecated", "label": "url.parse deprecated", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEP0169. Known parsing differences from the standard have caused SSRF bypasses. Use new URL()."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_host_vs_hostname", "label": "host vs hostname", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "host includes the port; hostname does not. An allowlist on host fails the moment a port appears."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_urlsearchparams", "label": "URLSearchParams", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decodes on read, encodes on write. get returns only the first repeated key \u2014 a real authorisation-bypass shape. Use getAll."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_ssrf_url_check", "label": "SSRF URL check", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check protocol and hostname on the parsed object, never a regex on the raw string. Incomplete without pinning the resolved IP."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_fileurltopath", "label": "fileURLToPath / pathToFileURL", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only correct file: conversions. file://+path misses %20 and Windows drive letters. Most fs APIs accept a file: URL directly."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_url_parse_deprecated", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_whatwg_url", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_host_vs_hostname", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_whatwg_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_urlsearchparams", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_whatwg_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/url.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_ssrf_url_check", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_url_whatwg_url", "relation": "r