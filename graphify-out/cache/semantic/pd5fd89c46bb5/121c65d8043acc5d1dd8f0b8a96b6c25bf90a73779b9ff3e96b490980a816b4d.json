{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_scalar_subquery", "label": "Scalar subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/scalar-and-row.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must return one row and one column. Uncorrelated form is evaluated once for the statement. Zero rows is NULL, not an error. Derived tables in FROM need an alias and cannot see siblings without LATERAL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_error_21000", "label": "21000 more than one row from scalar subquery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/scalar-and-row.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced at runtime, not plan time. LIMIT 1 without ORDER BY converts a loud error into a silently arbitrary answer. Prefer an aggregate or a unique-key constraint."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_row_constructor", "label": "Row constructor comparison", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/subqueries/scalar-and-row.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a, b) > (1, 5) is lexicographic: a > 1 OR (a = 1 AND b > 5), not AND of both. Correct spelling for keyset pagination. NULL in any component yields unknown."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_scalar_subquery", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_subqueries_scalar_and_row_error_21000", "relation": "conceptually_related_to", "confidence":