{"nodes": [{"id": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_02_using_microtasks_queuemicrotask", "label": "queueMicrotask", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/03-microtasks-vs-macrotasks/02-using-microtasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs after the current execution context exits but before event handlers and timeouts. Prefer over Promise.resolve().then: no allocation, exceptions surface as uncaught errors."}, {"id": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_02_using_microtasks_releasing_zalgo", "label": "Releasing Zalgo (sometimes-async)", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/03-microtasks-vs-macrotasks/02-using-microtasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function should be always-async or never-async. Cache-hit sync vs miss async fires events before listeners attach. Defer the fast path with queueMicrotask."}, {"id": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_02_using_microtasks_length_equals_1_batching", "label": "length === 1 microtask batching", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/03-microtasks-vs-macrotasks/02-using-microtasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First call schedules the flush; later calls in the same turn join the array. Runs after all sync code and before paint \u2014 the mechanism behind framework batching."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_02_using_microtasks_queuemicrotask", "target": "docs_javascript_pages_phase_7_async_03_microtasks_vs_macrotasks_01_the_drain_order_microtask", "relation": "conceptually_related_to", "confidence": "E