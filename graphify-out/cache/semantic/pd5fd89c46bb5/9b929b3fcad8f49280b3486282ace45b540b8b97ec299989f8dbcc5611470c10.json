{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_choosing_tenancy_model", "label": "Choosing a tenancy model", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision page, not mechanism. Migrations and cross-tenant reporting pull opposite isolation. Shared schema is the usual SaaS default."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_shared_schema_default", "label": "Shared schema default", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scales to millions of tenants, migrations run once, reporting is one query. Isolation is configuration (RLS, non-owner role, SET LOCAL) not structure."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_tenant_id_leads_indexes", "label": "tenant_id leads every index", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query is tenant-scoped, including the RLS predicate. An index on (created_at) cannot serve the filter on every query."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_per_tenant_uniqueness", "label": "Uniqueness is per tenant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE (tenant_id, slug). A global unique slug is unintended cross-tenant coupling. tenant_id is NOT NULL with an FK."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_rls_restrictive_force", "label": "RESTRICTIVE RLS plus FORCE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RESTRICTIVE applies regardless of permissive policies. FORCE stops the table owner bypassing RLS \u2014 the role a careless app connects as."}, {"id": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_set_config_local", "label": "set_config LOCAL app.tenant_id", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain SET persisted across pooled handoff (ex54). SET LOCAL x = $1 is 42601; use set_config(name, value, true) inside a transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_choosing_tenancy_model", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_choosing_tenancy_model", "target": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_shared_schema_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/20-multi-tenancy/01-choosing-a-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_20_multi_tenancy_01_choosing_a_model_sha