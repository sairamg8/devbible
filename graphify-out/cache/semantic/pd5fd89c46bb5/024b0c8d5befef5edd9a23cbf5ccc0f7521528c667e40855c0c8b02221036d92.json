{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_format_sha1_default", "label": "SHA-1 default object format", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-format.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh repos use sha1. 40 hex characters. No sign of the default changing soon."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_format_sha256", "label": "SHA-256 object format", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-format.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen at init with --object-format=sha256. 64 hex characters. No in-place conversion."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_format_hardened_sha1", "label": "Hardened SHA-1 sha1dc", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-format.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git 2.13+ detects known collision attack patterns and aborts rather than writing the object."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_format_no_interop", "label": "SHA-1 and SHA-256 cannot interoperate", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-format.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object names are the protocol vocabulary. Hosts, tooling, and remotes assume SHA-1, so SHA-256 adoption is blocked."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_format_hardened_sha1", "target": "bui