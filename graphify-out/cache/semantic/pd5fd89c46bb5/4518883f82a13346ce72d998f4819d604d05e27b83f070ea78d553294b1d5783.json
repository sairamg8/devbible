{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_page", "label": "Permissions and symlinks", "file_type": "document", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POSIX octal bits, umask subtracts, and symlinks make a validated path read something else."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_umask", "label": "umask", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-process mask of bits to remove. mode is a maximum: requested 0o666 with umask 022 becomes 644."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_mode_mask", "label": "stat.mode file-type bits", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mask with 0o777 before comparing. A 644 file reports 0o100644. Always write octal literals."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_directory_execute", "label": "Directory execute is traverse", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "r without x lists names and cannot open entries. chmod 644 on a directory is a half-broken state."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_symlink", "label": "symlink", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "symlink(target, path) like ln -s. Relative targets resolve against the link's directory, not cwd."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_readlink_vs_realpath", "label": "readlink vs realpath", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "readlink is the literal maybe-relative target. realpath follows the whole chain to an absolute path."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_hard_link", "label": "Hard link", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second name for the same inode; one filesystem only. Space is freed when last link and last fd are gone."}, {"id": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_atomic_symlink_deploy", "label": "Atomic current symlink deploy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ln -sfn releases/X current.tmp && mv -T current.tmp current swaps the app directory with no missing window."}], "edges": [{"source": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_umask", "target": "docs_nodejs_pages_phase_4_filesystem_13_permissions_and_symlinks_mode_mask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/13-permissions-and-symlinks.md", "source_location": null, "weight": 1.0}, {"s