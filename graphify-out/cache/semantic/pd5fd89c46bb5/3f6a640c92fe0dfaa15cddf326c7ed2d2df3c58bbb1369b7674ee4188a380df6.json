{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_default_isolation", "label": "Default isolation level", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL READ COMMITTED vs MySQL REPEATABLE READ. A second SELECT in one transaction sees new commits on PG and the same rows on MySQL. Silent port behaviour change."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_identifier_case_folding", "label": "Identifier case folding", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL down-cases unquoted identifiers (createdAt \u2192 createdat). Quoted MixedCol keeps case forever. MySQL and SQLite preserve what you typed. Corpus convention is snake_case."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_returning", "label": "RETURNING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL returns affected rows in one round trip. MySQL ERROR 1064 near returning."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_update_order_by_limit", "label": "UPDATE \u2026 ORDER BY \u2026 LIMIT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL allows a bounded ordered UPDATE. PostgreSQL syntax error at order. On PG use WHERE id IN (SELECT id \u2026 ORDER BY \u2026 LIMIT n)."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_real_boolean", "label": "Real BOOLEAN type", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only PostgreSQL has a real boolean and rejects non-booleans. MySQL BOOLEAN is TINYINT(1) and stores 2. SQLite reports integer for true."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_sqlite_one_writer", "label": "SQLite single-writer lock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-database write lock. Second writer errors with database is locked rather than waiting. PostgreSQL row-locks and both succeed. Line between application and embedded database."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_pg_bigint_as_string", "label": "pg bigint as string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg hands bigint and numeric as strings to protect precision. node:sqlite throws above Number.MAX_SAFE_INTEGER. Quiet failure vs loud throw."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_returning", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_update_order_by_limit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_sqlite_one_writer", "target": "docs_postgresql_pages_phase_0_architecture_02_client_server_model_process_per_connection", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_identifier_case_folding", "target": "docs_postgresql_pages_phase_0_architecture_03_namespace_search_path", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_default_isolation", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_sqlite_one_writer", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/02-real-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_02_real_differences_real_boolean", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_strict_mode", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source