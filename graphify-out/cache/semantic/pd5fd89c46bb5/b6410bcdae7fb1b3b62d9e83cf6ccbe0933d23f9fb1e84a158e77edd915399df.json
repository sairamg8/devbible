{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_19_cpu_heap_profiling_cpu_heap_profiling", "label": "CPU and heap profiling", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/19-cpu-heap-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the event loop is hot or CPU is pegged, a profile shows which functions ate the samples."}, {"id": "docs_nodejs_pages_phase_10_observability_19_cpu_heap_profiling_cpu_prof", "label": "--cpu-prof", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/19-cpu-heap-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Samples during the run and writes .cpuprofile on exit. Hard kill (-9) skips flush. Wrong tool when lag is low and you are I/O bound."}, {"id": "docs_nodejs_pages_phase_10_observability_19_cpu_heap_profiling_heap_prof", "label": "--heap-prof", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/19-cpu-heap-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocation timeline-style profile. For what is retained right now, prefer heap snapshots."}, {"id": "docs_nodejs_pages_phase_10_observability_19_cpu_heap_profiling_inspector", "label": "Node Inspector --inspect", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/19-cpu-heap-profiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live CPU/Memory session without waiting for exit. Exposing --inspect on a public IP is a remote code surface \u2014 treat like a root shell."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_19_cpu_heap_profiling_cpu_prof", "target": "docs_nodejs_pages_phase_10_observability_19_cpu_hea