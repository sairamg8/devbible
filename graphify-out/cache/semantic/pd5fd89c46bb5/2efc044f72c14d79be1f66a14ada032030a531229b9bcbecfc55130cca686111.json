{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_13_transform_streams_01_transform_and_boundaries_transform_methods", "label": "_transform and _flush", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/13-transform-streams/01-transform-and-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_transform handles each chunk and emits zero or more outputs. _flush runs after input ends and emits buffered state such as a trailing partial line."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_13_transform_streams_01_transform_and_boundaries_boundary_problem", "label": "Transform chunk boundary problem", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/13-transform-streams/01-transform-and-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-chunk regex misses a token that straddles two chunks. A tok_live_ secret split across chunks was not redacted."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_13_transform_streams_01_transform_and_boundaries_splitlines", "label": "SplitLines framing Transform", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/13-transform-streams/01-transform-and-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds everything after the last newline as #tail; _flush emits the remainder. Frame into records first, then operate on whole records."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_13_transform_streams_01_transform_and_boundaries_framing_first", "label": "Frame then match", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/13-transform-streams/01-transform-and-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "au