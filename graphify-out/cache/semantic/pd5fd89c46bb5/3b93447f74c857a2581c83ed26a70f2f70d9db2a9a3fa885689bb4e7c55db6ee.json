{"nodes": [{"id": "docs_expressjs_pages_phase_1_routing_07_app_route_and_hosts_app_route", "label": "app.route / router.route", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/07-app-route-and-hosts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chain verbs on one path to reduce redundancy and typos. Organizational sugar, not required. Harder to split across files when handlers grow."}, {"id": "docs_expressjs_pages_phase_1_routing_07_app_route_and_hosts_mountpath_app_only", "label": "mountpath is an app property", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/07-app-route-and-hosts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Router never gets mountpath \u2014 mounted or not. Measured undefined before and after app.use. A sub-app (express()) reports /reports. Use req.baseUrl during a request."}, {"id": "docs_expressjs_pages_phase_1_routing_07_app_route_and_hosts_mount_event", "label": "sub-app mount event", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/07-app-route-and-hosts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sub-app fires a mount event when attached, with the parent app passed to the callback."}, {"id": "docs_expressjs_pages_phase_1_routing_07_app_route_and_hosts_host_based_routing", "label": "Host-based routing", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/07-app-route-and-hosts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch on req.hostname via vhost-style middleware. For most JSON APIs, path prefixes beat multi-host apps. Multi-host usually belongs on Nginx."}], "edges": [{"source": "docs_expressjs_pages_phase_1_routing_07