{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_01_acid", "label": "ACID in PostgreSQL", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_atomicity", "label": "Atomicity and aborted transactions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed statement aborts the whole transaction. Later commands return 25P02. COMMIT on an aborted transaction is executed as ROLLBACK."}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_consistency", "label": "Consistency as constraints", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistency is whatever constraints say. UNIQUE, PRIMARY KEY, EXCLUDE and foreign keys can be DEFERRABLE; CHECK and NOT NULL are always immediate."}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_deferrable_unique", "label": "DEFERRABLE UNIQUE for swaps", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_isolation_default", "label": "Default isolation READ COMMITTED", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL's default trades isolation for concurrency; the anomalies it allows are the source of most real transaction bugs."}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_durability", "label": "Durability and WAL flush", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COMMIT does not return until the WAL record is flushed. 112 bytes for one UPDATE. Batching 500 inserts in one transaction (128 ms) beat turning synchronous_commit off (170 ms)."}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_synchronous_commit", "label": "synchronous_commit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off buys 6\u00d7 write throughput (1042 ms \u2192 170 ms) for a window of lost recent commits. Not corruption \u2014 lost commits. Check commit frequency first."}, {"id": "docs_postgresql_pages_phase_11_mvcc_01_acid_25p02", "label": "SQLSTATE 25P02 transaction aborted", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_01_acid", "target": "docs_postgresql_pages_phase_11_mvcc_01_acid_atomicity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_01_acid", "target": "docs_postgresql_pages_phase_11_mvcc_01_acid_consistency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/01-acid.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_01_acid", "target": "docs_postgresql_pages_phase_11_mvcc_01_acid_isolation_default", "relation":