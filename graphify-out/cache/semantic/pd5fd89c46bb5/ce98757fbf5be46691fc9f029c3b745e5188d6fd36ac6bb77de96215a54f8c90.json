{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_column_vs_json_column_vs_jsonb", "label": "Column versus jsonb", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/column-vs-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you can name the field in a requirement it is a column. jsonb is for unenumerable shape. Same two facts: 22 MB vs 1736 kB (~13\u00d7)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_column_vs_json_generated_column_hybrid", "label": "Generated column hybrid", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/column-vs-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promote queried keys to GENERATED ALWAYS AS (payload->>'k') STORED columns. Derived from the document so it cannot drift."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_column_vs_json_jsonb_fk_limit", "label": "No foreign key on a jsonb key", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/column-vs-json.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK on a jsonb key works; a FOREIGN KEY cannot reference one (42601). Referential integrity is the guarantee you actually give up."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_column_vs_json_generated_column_hybrid", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_column_vs_json_column_vs_jsonb", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/column-vs-json.html", "source_location": null, "weight": 1.0}, {"source": "build_c