{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_and_lead_lag", "label": "lag", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/lag-and-lead.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Value n rows back (default 1), optional default when the offset falls outside the partition. Frame-independent. Never crosses PARTITION BY. ORDER BY is optional in syntax and always a bug without it. Non-constant offset is accepted and can yield an all-NULL column."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_and_lead_lead", "label": "lead", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/lag-and-lead.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Value n rows forward. Same offset/default/partition/ORDER BY rules as lag. First row has no predecessor and last has no successor \u2014 both NULL unless a default is supplied."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_and_lead_date_spine", "label": "generate_series date spine for lag", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/lag-lead/lag-and-lead.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lag counts rows, not days. Missing days make day-over-day skip the gap silently. Generate a dense spine and LEFT JOIN; use count(o.id) not count(*) or empty days report 1."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_and_lead_lag", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_lag_lead_lag_and_lead_lead", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_sc