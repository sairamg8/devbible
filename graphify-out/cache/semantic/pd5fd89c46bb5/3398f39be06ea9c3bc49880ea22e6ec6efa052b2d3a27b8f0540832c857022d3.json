{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_unnest", "label": "VALUES and unnest", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_as_table", "label": "VALUES as a table expression", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs AS t(cols). Types inferred from the first row. Join a client list without a temp table. Each batch size is a different statement for the plan cache."}, {"id": "docs_postgresql_pages_phase_4_crud_19_values_unnest_unnest", "label": "unnest parallel arrays", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column-wise not a cross join. Mismatched lengths pad the short array with NULL, no error. Always cast $1::text[]. Prefer FROM unnest over select-list SRFs."}, {"id": "docs_postgresql_pages_phase_4_crud_19_values_unnest_unnest_parameter_bridge", "label": "unnest N rows through one parameter per column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5000 rows through 3 parameters. Multi-row VALUES would need 15000 and hit 65535 at 21845 rows. One statement shape so the plan cache stays warm. 81 ms versus COPY 243 ms at 10000 rows."}, {"id": "docs_postgresql_pages_phase_4_crud_19_values_unnest_any_array", "label": "= ANY($1) for IN lists", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter, no generated $1..$n, no ceiling, avoids the NOT IN null trap."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_unnest", "target": "docs_postgresql_pages_phase_4_crud_07_update_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_unnest", "target": "docs_postgresql_pages_phase_4_crud_04_insert_insert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_unnest", "target": "docs_postgresql_pages_phase_4_crud_08_parameters_parameters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_19_values_unnest_values_as_table", "target": "docs_postgresql_pages_phase_4_crud_19_values_unnest_unnest", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_19_values_unnest_unnest_parameter_bridge", "target": "docs_postgresql_pages_phase_4_crud_04_insert_parameter_ceiling_65535", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/19-values-unnest.md", "source_location": null, "weight":