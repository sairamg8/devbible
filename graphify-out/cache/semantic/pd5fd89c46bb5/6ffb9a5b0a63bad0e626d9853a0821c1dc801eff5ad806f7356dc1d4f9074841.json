{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "label": "INNER JOIN matching pairs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Output is the set of pairs that satisfy ON. Simultaneously a filter (no match \u2192 dropped) and a multiplier (N matches \u2192 N copies). JOIN is INNER JOIN; INNER is optional."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_cardinality", "label": "Join cardinality from FK", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Child to parent via a NOT NULL FK yields exactly one row per child. Parent to child yields the children and silently drops unmatched parents. A nullable FK removes the guarantee both ways."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_join_strategies", "label": "Nested Loop Hash Merge join strategies", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equijoin unlocks all three. Non-equality leaves only nested loop. Planner reorders inner joins freely; outer-join order is semantic."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_comma_join", "label": "Comma join silent CROSS JOIN", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM a, b WHERE \u2026 is an inner join, but omitting the condition is a silent cross join. Explicit JOIN \u2026 ON makes the same omission a syntax error."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_cardinality", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_join_strategies", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_comma_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_fan_out_and_aggregates_fan_out", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/inner-join/matching-pairs.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_match