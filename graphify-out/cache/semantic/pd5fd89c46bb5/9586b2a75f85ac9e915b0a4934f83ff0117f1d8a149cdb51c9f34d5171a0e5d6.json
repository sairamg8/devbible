{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_18_disaster_drill", "label": "Disaster drill", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_untested_backup", "label": "An untested backup is a belief", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Having backups, being able to restore, and being able to restore in time under pressure are three different claims. Only rehearsal establishes the third."}, {"id": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_rto", "label": "Measured RTO from a drill", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logical restore measured at 4\u00d7 dump time. -j 4 bought nothing when one table held 97% of the data. If RTO exceeds the business assumption, that is the finding."}, {"id": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_pitr_most_likely", "label": "Most likely disaster is a bad write", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replicas faithfully replicate a bad DELETE. Only PITR with a long enough retention window helps. Retention is chosen against how long a bug might go unnoticed."}, {"id": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_runbook", "label": "Disaster runbook outside the system", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact commands, who decides, credentials, verification queries, endpoint change, measured timings. Someone who did not write it must be able to follow it."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_18_disaster_drill", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_18_disaster_drill", "target": "docs_postgresql_pages_phase_13_ops_17_major_upgrades", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_untested_backup", "target": "docs_postgresql_pages_phase_13_ops_18_disaster_drill", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_pitr_most_likely", "target": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_rto", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_18_disaster_drill_runbook", "target": "docs_postgresql_pages_phase_13_ops_17_major_upgrades_logical_cutover", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/18-disaster-drill.md", "source_location": 