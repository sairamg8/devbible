{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_lag_and_read_your_writes", "label": "08.1 Lag and why read-your-writes breaks", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/lag-and-read-your-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_lag_and_read_your_writes_read_your_writes", "label": "Read-your-writes", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/lag-and-read-your-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async replicas do not provide the guarantee that a client sees its own committed writes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_lag_and_read_your_writes_physical_replica", "label": "Physical streaming replica", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/lag-and-read-your-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_lag_and_read_your_writes_pg_stat_replication", "label": "pg_stat_replication LSN stages", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/lag-and-read-your-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "flush_lsn is durability; replay_lsn is visibility. Replication separates the two."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_lag_and_read_your_writes_synchronous_commit", "label": "synchronous_commit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replicatio