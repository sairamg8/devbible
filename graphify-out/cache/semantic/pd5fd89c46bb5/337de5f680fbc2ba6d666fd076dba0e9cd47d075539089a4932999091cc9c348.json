{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_pool_end", "label": "pool.end()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-end.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for in-flight queries then permanently retires the pool. A 300 ms query held end() 319 ms. A second end() throws."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_shutdown_order", "label": "Shutdown order: server then pool", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-end.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "server.close() first, then wait for in-flight requests, then pool.end(). Reversed, deploys burst 500s."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_client_end_vs_release", "label": "client.end() vs release()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-end.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "end() closes a standalone Client. A pooled client from pool.connect() gets release(). Calling end() on a pooled client is a bug."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_shutdown_order", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_pool_end", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-end.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_end_pool_end", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_statement_timeout", "relation