{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_queue", "label": "The lock queue", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 5 ms ALTER can cause a 30-second outage because ACCESS EXCLUSIVE queues and later ACCESS SHARE cannot jump it."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_access_exclusive_queue", "label": "ACCESS EXCLUSIVE lock queue", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default ALTER TABLE lock conflicts with every mode including SELECT's ACCESS SHARE. Blast radius is the longest transaction on the table, not DDL duration."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_timeout_retry", "label": "lock_timeout plus retry on 55P03", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET LOCAL lock_timeout, retry lock_not_available with backoff. statement_timeout does not reliably bound lock wait. Cancel the blocker, not the migration."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_add_column_constant_default", "label": "ADD COLUMN constant default is catalog-only", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PG 11 a non-volatile default is stored in metadata. Volatile defaults, identity, stored generated, and constrained domains still rewrite."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_validate_constraint_lock", "label": "VALIDATE CONSTRAINT uses SHARE UPDATE EXCLUSIVE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not block reads or writes. ADD FOREIGN KEY is SHARE ROW EXCLUSIVE and still blocks writes on both tables."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_transactional_ddl_locks", "label": "Transactional DDL holds locks until commit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transaction wrapping five ALTERs holds the first ACCESS EXCLUSIVE for all five. Split scans/rewrites. CREATE INDEX CONCURRENTLY cannot run in a transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_access_exclusive_queue", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_timeout_retry", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_timeout_retry", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_lock_timeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_lock_timeout_retry", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_02_planner_wal_and_changing_statement_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_add_column_constant_default", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_expand_and_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_validate_constraint_lock", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_02_expand_and_contract_not_valid_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_transactional_ddl_locks", "target": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_03_indexes_and_checklist_create_index_concurrently", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/01-the-lock-queue.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_01_the_lock_queue_access_exclusive_queue", "target": "