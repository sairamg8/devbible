{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_unforgiving", "label": "Unforgiving selector lists", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-lists.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One invalid selector in a plain comma list discards the entire rule. Adding :popover-open to a shared list silently unstyles every other component in unsupported engines."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_forgiving_is", "label": "Forgiving :is() argument lists", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-lists.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":is() and :where() drop invalid members and keep valid ones. :not() and :has() are unforgiving. Uncertain selectors get their own rule or wrap in :is()."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_unforgiving", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_forgiving_is", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-lists.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_unforgiving", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_css_fails_silently_blast_radii", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-lists.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_lists_forgiving_is", "target": "build_css_p2_docs_css_pages_phase_1_selectors_is_and_where_speci