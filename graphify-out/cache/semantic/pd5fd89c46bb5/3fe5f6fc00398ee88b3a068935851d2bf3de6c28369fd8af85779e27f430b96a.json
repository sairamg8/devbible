{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_01_the_eight_types_eight_types", "label": "JavaScript eight types", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/01-the-eight-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven primitives plus object. Arrays, dates, regexes, Map and class instances are objects. typeof function is a convenience, not a ninth type."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_01_the_eight_types_typeof_null_bug", "label": "typeof null === object", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/01-the-eight-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historic type-tag bug: objects used tag 000 and null was the all-zero pointer. A fix was rejected. Detect null with v === null."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_01_the_eight_types_array_isarray", "label": "Array.isArray", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/01-the-eight-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instanceof Array fails across realms because each iframe or vm has its own Array constructor."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_01_the_eight_types_primitive_vs_object", "label": "Primitive versus object", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/01-the-eight-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primitives copy on assignment, compare by value, and are immutable. Objects share by reference, compare by identity, and are mutable."}], "edges": [{"source": "docs_javascript_pages