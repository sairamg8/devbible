{"nodes": [{"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_page", "label": "instanceof narrowing", "file_type": "document", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_instanceof", "label": "instanceof narrowing", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instanceof is precise, needs no helper, and narrows unknown in one step inside a single application. It is nominal, so it breaks across realms and duplicate package copies, and cannot see plain object types."}, {"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_unknown_catch", "label": "instanceof on unknown catch", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "catch (err) is unknown under strict. Check most-specific class first, then Error, then stringify non-Error throws \u2014 JavaScript can throw anything."}, {"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_realm_failure", "label": "instanceof fails across realms", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A value from an iframe, vm context, worker, or a duplicate package copy has a different constructor identity, so instanceof Error is false."}, {"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_structural_iserror", "label": "Structural isError predicate", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof e === 'object' && e !== null && 'message' in e && 'stack' in e survives realm and duplicate-package boundaries. Node also provides util.types.isNativeError."}, {"id": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_symbol_hasinstance", "label": "Symbol.hasInstance", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_page", "target": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_instanceof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_instanceof", "target": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_unknown_catch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_instanceof", "target": "docs_typescript_pages_phase_2_narrowing_04_instanceof_narrowing_realm_failure", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-2-narrowing/04-instanceof-narrowing.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_2_narrowing_04_