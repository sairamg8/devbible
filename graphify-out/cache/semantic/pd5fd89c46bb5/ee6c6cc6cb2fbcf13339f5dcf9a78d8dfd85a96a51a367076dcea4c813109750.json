{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_update", "label": "FOR UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strongest row lock; conflicts with every other row-lock mode. Held until the transaction ends, not the statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_no_key_update", "label": "FOR NO KEY UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Update non-key columns only. Conflicts with all modes except KEY SHARE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_share", "label": "FOR SHARE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Row must not change while you read it. Conflicts with UPDATE and NO KEY UPDATE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_key_share", "label": "FOR KEY SHARE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weakest mode; what an FK insert takes. Conflicts only with FOR UPDATE so parent non-key updates are not blocked."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_nowait", "label": "FOR UPDATE NOWAIT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail immediately with 55P03 if any selected row is locked. For 'someone else is editing this'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_lock_timeout", "label": "lock_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounds wait for a lock without killing a slow-but-progressing query. Prefer SET LOCAL so it does not leak on pooled connections."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_tuple_header_locks", "label": "Tuple-header row locks", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Row locks live in xmax plus flag bits, not the lock manager. pg_locks is empty; use pg_blocking_pids()."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_update", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_share", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_key_share", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/row-locks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_for_no_key_update", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_lo