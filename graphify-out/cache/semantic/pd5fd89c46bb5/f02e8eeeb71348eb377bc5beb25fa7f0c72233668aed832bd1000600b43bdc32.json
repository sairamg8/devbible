{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_custom_readable", "label": "Custom Readable _read", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_read is a request: eventually push or push(null). push() false means stop. Never throw \u2014 this.destroy(err). Never call _read yourself."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_custom_writable", "label": "Custom Writable _write _writev _final", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_writev receives the queued batch \u2014 one INSERT per drain instead of per row. _final flushes the partial batch; forget it and last rows vanish."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_destroy", "label": "_destroy resource cleanup", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs exactly once on success and failure. Only correct place to release a connection or delete a temp file. pipeline calls destroy on every stream."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_prefer_generator", "label": "Prefer Readable.from over a class", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write the class only for pull control, _writev batching, or _destroy cleanup. Generators have no _read/callback contract."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_custom_readable", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_custom_writable", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_writable", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_destroy", "target": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipeline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_prefer_generator", "target": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_custom_readable", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writable.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_17_custom_readable_writable_prefer_generator", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable_from", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/17-custom-readable-writ