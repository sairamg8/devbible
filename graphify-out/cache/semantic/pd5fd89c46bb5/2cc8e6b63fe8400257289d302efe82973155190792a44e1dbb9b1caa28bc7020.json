{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_work_mem", "label": "work_mem", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/config-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per sort/hash operation. Worst case is work_mem \u00d7 operations \u00d7 concurrency \u2014 how servers get OOM-killed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_effective_cache_size", "label": "effective_cache_size", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/config-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocates nothing. Leaving it at 4 GB on a large server biases the planner to sequential scans."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_random_page_cost", "label": "random_page_cost", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/config-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 4.0 models a spinning disk. On SSD, 1.1 is the usual highest-value one-line change."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_pg_settings_context", "label": "pg_settings.context", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/config-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tells you restart vs reload before planning a change. Read pending_restart after."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_work_mem", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_config_keys_effective_cache_size", "relation": "conceptually_related_to", "c