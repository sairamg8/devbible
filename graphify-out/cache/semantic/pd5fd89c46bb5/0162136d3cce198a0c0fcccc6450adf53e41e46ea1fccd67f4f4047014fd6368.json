{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "label": "MFA and TOTP", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_totp", "label": "TOTP", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC of the current 30-second time step with a shared secret, dynamically truncated to six digits. A second factor turns a stolen password into a failed login."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_hotp", "label": "HOTP", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC-SHA1 over an 8-byte counter with dynamic truncation. TOTP is HOTP of floor(unix/step)."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_rfc_6238", "label": "RFC 6238", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementation reproduced SHA-1 and SHA-256 test vectors. HMAC-SHA1 is not weakened by SHA-1 collision attacks and is what authenticator apps implement."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_drift_window", "label": "TOTP drift window", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adjacent steps produce unrelated codes. \u00b11 accepts a 90-second span. Wider gets sloppy; narrower generates support tickets."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_step_replay_protection", "label": "Record accepted TOTP step", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without storing the last accepted step, TOTP is not single-use. A code observed in transit can be replayed for the rest of the step."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_webauthn_passkeys", "label": "WebAuthn / passkeys", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credential bound to origin; the browser will not sign for a lookalike. TOTP is a shared secret and can be relayed in real time. Passkeys are phishing-resistant; TOTP is the pragmatic fallback."}, {"id": "docs_nodejs_pages_phase_8_security_07_mfa_totp_recovery_codes", "label": "Hashed MFA recovery codes", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten single-use codes hashed like passwords. Without them, support becomes the recovery path \u2014 a social-engineering surface weaker than the password you just strengthened."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_totp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_hotp", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_rfc_6238", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_drift_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_step_replay_protection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_webauthn_passkeys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_mfa_totp", "target": "docs_nodejs_pages_phase_8_security_07_mfa_totp_recovery_codes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/07-mfa-totp.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_07_mfa_totp_totp", "target": "docs_nodejs_pages_phase_8_security_01_password_storage_timing_safe_equal", "relation": "references", "confidence": "EXT