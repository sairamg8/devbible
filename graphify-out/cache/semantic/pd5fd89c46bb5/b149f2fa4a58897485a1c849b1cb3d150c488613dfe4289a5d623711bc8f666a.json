{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_12_templates_create_database", "label": "CREATE DATABASE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/12-templates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copies an existing database as a template (default template1). Only superusers or CREATEDB roles. App runtime roles must not. Cannot run inside a transaction."}, {"id": "docs_postgresql_pages_phase_0_architecture_12_templates_template1", "label": "template1", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/12-templates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default source for CREATE DATABASE. May hold encodings/extensions you want on every new DB. A dirty template1 puts unexpected objects in every new database."}, {"id": "docs_postgresql_pages_phase_0_architecture_12_templates_template0", "label": "template0", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/12-templates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pristine factory image. datallowconn is usually false. Use TEMPLATE template0 when template1 was customized."}, {"id": "docs_postgresql_pages_phase_0_architecture_12_templates_postgres_db", "label": "postgres database", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/12-templates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary DB created for admin connections; not magic beyond convention. Not a template (datistemplate false)."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_12_templates_create_database", "target": "docs_postgresql_pages_phase_0_architecture_12_te