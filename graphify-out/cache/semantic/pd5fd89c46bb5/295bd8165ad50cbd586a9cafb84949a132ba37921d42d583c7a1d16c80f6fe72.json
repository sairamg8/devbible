{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_17_comments_comment_on", "label": "COMMENT ON", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/17-comments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog documentation via obj_description/col_description. information_schema does not expose comments. \\d hides them; \\d+ shows them. NULL deletes."}, {"id": "docs_postgresql_pages_phase_3_ddl_17_comments_comments_in_migrations", "label": "Comments in migrations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/17-comments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-typed comments vanish on rebuild. pg_dump includes them. Lost when an object is dropped and recreated; not inherited by partitions."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_17_comments_comments_in_migrations", "target": "docs_postgresql_pages_phase_3_ddl_17_comments_comment_on", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/17-comments.md", "source_location": null, "weight": 1.0}], "hyperedges": []}