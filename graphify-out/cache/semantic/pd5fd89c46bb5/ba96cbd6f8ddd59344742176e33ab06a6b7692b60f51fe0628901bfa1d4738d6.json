{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_ordinals_and_distinct", "label": "Ordinals, aliases and DISTINCT", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where 1 and an output alias are legal, and why GROUP BY x with no aggregate is SELECT DISTINCT x, all fall out of evaluation order."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_evaluation_order", "label": "SQL evaluation order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM \u2192 WHERE \u2192 GROUP BY \u2192 HAVING \u2192 SELECT (aliases born) \u2192 windows \u2192 DISTINCT \u2192 ORDER BY \u2192 LIMIT. WHERE cannot see aliases (42703); ORDER BY can."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_ordinals", "label": "GROUP BY ordinals", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY 1,2 breaks silently when a column is inserted in the select list. Reserve ordinals for long expressions; name columns in anything that ships."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_output_alias_extension", "label": "GROUP BY output alias is a PG extension", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY runs before SELECT, yet PostgreSQL permits output names including computed expressions. Standard SQL does not; it will not port."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_is_distinct", "label": "GROUP BY without aggregate is DISTINCT", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "54.49 ms vs 55.74 ms on 500000 rows, both HashAggregate. DISTINCT cannot HAVING-filter. Combining DISTINCT + GROUP BY is almost always undiagnosed fan-out."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_does_not_order", "label": "GROUP BY does not order", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HashAggregate emits hash order. GroupAggregate happens to emit sorted. A report that ships without ORDER BY reshuffles when the planner switches."}, {"id": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_42703_vs_42803", "label": "42703 vs 42803", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "42703 is no such column (alias too early or typo). 42803 is grouping error (column exists but is not one-per-group). Aggregate in GROUP BY is 42803 because it is circular."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_ordinals_and_distinct", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_evaluation_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_ordinals", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_evaluation_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_output_alias_extension", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_evaluation_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_is_distinct", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/01-group-by/04-ordinals-and-distinct.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_01_group_by_04_ordinals_and_distinct_group_by_does_not_order", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_05_how_it_executes_hashaggregate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-a