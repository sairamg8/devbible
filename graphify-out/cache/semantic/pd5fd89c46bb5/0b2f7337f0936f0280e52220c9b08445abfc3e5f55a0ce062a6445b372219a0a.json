"author": null, "contributor": null, "rationale": "The only way to preserve array input order once values become rows. pos is bigint; pg returns it as text."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_in_from", "label": "Put SRFs in FROM not SELECT", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/10-srf.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SRFs produce rows. Two SRFs in SELECT run in lockstep with NULL padding. An SRF in WHERE raises 0A000. ROWS FROM makes zipping explicit."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_10_srf", "target": "docs_postgresql_pages_phase_12_beyond_tables_07_views", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/10-srf.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_in_from", "target": "docs_postgresql_pages_phase_12_beyond_tables_10_srf", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/10-srf.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_unnest", "target": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_jsonb_to_recordset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/10-srf.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_with_ordinality", "target": "docs_postgresql_pages_phase_12_beyond_tables_10_srf_unnest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/10-srf.md", "source_location": null,