{"nodes": [{"id": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_adoption", "label": "Promise adoption", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/03-value-vs-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return a value and it is wrapped; return a promise or thenable and it is adopted, never nested. Lets a handler switch between sync and async without callers changing."}, {"id": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_forgotten_return", "label": "Forgotten return / floating promise", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/05-promises/03-value-vs-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A handler that returns nothing fulfils immediately with undefined. The inner promise floats: sequencing breaks and its rejection becomes unhandled."}], "edges": [{"source": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_adoption", "target": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_resolved_vs_fulfilled", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/03-value-vs-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_adoption", "target": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_thenable", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/05-promises/03-value-vs-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_forgotten_return", "target": "docs_javasc