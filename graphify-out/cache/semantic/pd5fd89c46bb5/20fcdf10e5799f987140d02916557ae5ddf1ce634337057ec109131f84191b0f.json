{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_page", "label": "DDL locks and blocking", "file_type": "document", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_access_exclusive", "label": "ACCESS EXCLUSIVE lock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALTER TABLE takes ACCESS EXCLUSIVE, which conflicts with every mode including ACCESS SHARE from SELECT."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_lock_queue", "label": "DDL lock queue pile-up", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 12 ms ALTER queued behind a long read blocked later SELECTs for 2.4 s because locks are granted in request order."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_lock_timeout", "label": "lock_timeout for migrations", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET lock_timeout fails with 55P03 instead of stalling the table. statement_timeout is not a substitute because a lock wait is not executing."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_create_index_locks", "label": "CREATE INDEX lock modes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE INDEX takes ShareLock (reads ok, writes block). CONCURRENTLY permits writes at the cost of two scans and no transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_page", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_access_exclusive", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_lock_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_lock_timeout", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_lock_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/02-locks-and-blocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_02_locks_and_blocking_create_index_locks", "target": "docs_postgresql_pages_phase_8_schema_from_node_0