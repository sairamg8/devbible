{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_05_fetch_page", "label": "fetch", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/05-fetch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global stable undici fetch. Two outage behaviours: no throw on HTTP errors, unread bodies pin the pool."}, {"id": "docs_nodejs_pages_phase_5_http_processes_05_fetch_res_ok", "label": "fetch does not throw on 4xx or 5xx", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/05-fetch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rejected promise means the exchange failed. Check res.ok (200-299) before treating the body as data."}, {"id": "docs_nodejs_pages_phase_5_http_processes_05_fetch_single_use_body", "label": "Response body is single-use", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/05-fetch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "json/text/arrayBuffer consume a ReadableStream. Second read is Body is unusable. clone buffers."}, {"id": "docs_nodejs_pages_phase_5_http_processes_05_fetch_unread_holds_pool", "label": "Unread fetch body holds the connection", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/05-fetch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With connections:1 the second request never starts. Consume or res.body.cancel() including on error paths."}, {"id": "docs_nodejs_pages_phase_5_http_processes_05_fetch_failed_cause", "label": "TypeError fetch failed cause", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/05-fetch.md", "source_location": null, "source_url": null, "captured_at": null, "