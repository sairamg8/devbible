{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_within_group", "label": "Ordered-set aggregates", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Need input in order first, via WITHIN GROUP (ORDER BY \u2026). Percentiles are the usual meeting point. Cost 3.1\u00d7 an avg() because sorting is unavoidable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentile", "label": "percentile_cont and percentile_disc", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cont interpolates at fraction f; disc returns the first actual value at or past f. Several percentiles can share one sort."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_mode_bool_and", "label": "mode and bool_and empty-set surprises", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mode() hides ties by the WITHIN GROUP ordering. bool_and returns NULL for all-of-nothing, the same empty-set NULL rule as other aggregates."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_within_group", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ordered_set_percentile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ordered-set.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pag