{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pg_types_set_type_parser", "label": "pg.types.setTypeParser", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pg-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single process-wide registry including third-party pg users. Register once before opening a pool. Never called for NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pg_types_type_overrides", "label": "pg TypeOverrides", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pg-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes a parser change to one query or one pool. The safe form when a single report needs numbers."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pg_types_date_as_string", "label": "Override date (1082) to string", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pg-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A date is a calendar label. Converting it to Date at local midnight produces off-by-one days. The almost-always-right global override."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pg_types_numeric_not_number", "label": "Do not parse numeric to Number", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pg-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric exists because floats cannot represent decimal fractions. Keep the string or store integer minor units."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pg_types_set_type_par