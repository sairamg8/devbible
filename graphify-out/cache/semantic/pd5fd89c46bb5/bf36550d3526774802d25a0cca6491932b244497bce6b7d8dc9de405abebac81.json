{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "label": "Amount plus currency", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An amount alone is not money. Store numeric(14,2) plus char(3) currency. A composite FK (invoice_id, currency) referencing invoices (id, currency) makes mismatched lines impossible. Always declare scale; unconstrained numeric allows 16383 fractional digits."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_avoid_money_type", "label": "Do not use the money type", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locale-dependent via lc_monetary; dump/restore can break across locales; no currency identity. The documentation's own best-practice note prefers numeric."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_iso4217_minor_units", "label": "ISO 4217 minor units", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not every currency has two decimals: JPY has none, some have three. Hard-coded \u00f7100 is wrong by 10 or 100. Store minor_units per currency. Unit prices need more scale than totals."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_vs_float", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_money_never_float", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_avoid_money_type", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_iso4217_minor_units", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_iso4217_minor_units", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_integer_cents", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/01-storing-money.md", "source_location": null, "weight": 1.0}], "hyperedges": []}