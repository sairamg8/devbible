{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_three_passes", "label": "Parse, compile, execute", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/parse-compile-execute.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine reads the entire file before running a line. SyntaxError happens before any code runs; ReferenceError happens during execute."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_hoisting", "label": "Hoisting as the creation pass", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/parse-compile-execute.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not code moving. Pass 2 registers declarations: functions fully built, var as undefined, let/const/class with no value."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_tdz", "label": "Temporal dead zone", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/parse-compile-execute.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The binding exists but has no value. typeof on a TDZ name throws; typeof on a never-declared name is undefined. TDZ turns silent NaN into an immediate ReferenceError."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_three_passes", "target": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_parse_compile_execute_hoisting", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javas