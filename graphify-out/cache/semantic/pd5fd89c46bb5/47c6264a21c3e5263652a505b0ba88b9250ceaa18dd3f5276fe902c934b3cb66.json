{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_02_first_and_last_last_value_default_frame", "label": "last_value default-frame trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/02-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY implies RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, so last_value is the current row. Fix with ROWS \u2026 UNBOUNDED FOLLOWING, or first_value over the reverse order."}, {"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_02_first_and_last_first_value", "label": "first_value", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/02-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns expr from the first row of the frame. Correct under the default frame only because the frame starts at UNBOUNDED PRECEDING. Prefer it over last_value with reversed ORDER BY."}, {"id": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_02_first_and_last_nth_value", "label": "nth_value", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-lead/02-first-and-last.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1-based index into the frame. With the default frame, nth_value(x, 2) is NULL until the frame contains two rows. No negative form \u2014 reverse the order."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_02_first_and_last_last_value_default_frame", "target": "docs_postgresql_pages_phase_6_aggregation_08_lag_lead_02_first_and_last_first_value", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/08-lag-l