{"nodes": [{"id": "docs_css_pages_phase_1_selectors_06_has_has_parent_selector", "label": ":has() the parent selector", "file_type": "document", "source_file": "docs/css/pages/phase-1-selectors/06-has.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_css_pages_phase_1_selectors_06_has_has", "label": ":has()", "file_type": "concept", "source_file": "docs/css/pages/phase-1-selectors/06-has.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent selector and previous-sibling selector. Widely available since 2023-12-19. Unforgiving; no nested :has()."}, {"id": "docs_css_pages_phase_1_selectors_06_has_replaces_js_class", "label": ":has() replaces ancestor class toggles", "file_type": "rationale", "source_file": "docs/css/pages/phase-1-selectors/06-has.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "body:has(dialog[open]) cannot get out of sync the way classList.add/remove on an error path can."}, {"id": "docs_css_pages_phase_1_selectors_06_has_cost", "label": ":has() matching cost", "file_type": "concept", "source_file": "docs/css/pages/phase-1-selectors/06-has.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5000 rows: querySelectorAll class 0.15 ms vs :has(:checked) 1.25 ms. Not free; JS to keep a class in sync costs more."}], "edges": [{"source": "docs_css_pages_phase_1_selectors_06_has_has_parent_selector", "target": "docs_css_pages_phase_1_selectors_06_has_has", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/css/pages/phase-1-selectors/06-has.md", "source_location": null, "weight": 1.0}, {"source": "docs_css_pages_phase_1_selectors_06_has_has_parent_selector", "target": "docs_css_pages_phase_1_selectors_06_has_replaces_js_class"