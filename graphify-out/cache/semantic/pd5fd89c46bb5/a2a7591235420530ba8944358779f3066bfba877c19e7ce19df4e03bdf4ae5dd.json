{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_cursor_encoding", "label": "base64url cursor encoding", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON of [ISO timestamp, String(id)] as base64url. Preserve full precision; bigint id as string. Base64 is not security \u2014 sign if unforgeable."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_limit_plus_one", "label": "Fetch limit + 1 for hasMore", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extra row is whether another page exists. Costs one row instead of count(*). nextCursor is null at the end."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_mixed_sort_directions", "label": "Tuple form cannot express mixed directions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a,b) < (x,y) means DESC on both. Against ORDER BY a DESC, b ASC it returns a plausible wrong page. Write the comparison out and index (a DESC, b ASC), or avoid mixed directions."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_nullable_sort_column", "label": "Nullable sort column silently truncates the walk", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparisons against NULL are never true. Page 1 includes nulls (no WHERE); later pages drop them. Measured 250000 of 500000 excluded. NULLS LAST does not fix the predicate. Prefer NOT NULL."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_when_offset_is_right", "label": "OFFSET is still right for shallow page-number UIs", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 50 pages OFFSET was 0.9\u00d7 (slightly faster). At 500 pages keyset was 6.4\u00d7 faster. Keyset for feeds, APIs, exports, crawlers; OFFSET for admin tables with page numbers."}, {"id": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_immutable_sort_key", "label": "Order by an immutable key", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyset is stable against inserts elsewhere. A row whose sort key changes (updated_at) can be seen twice or missed. Prefer created_at or the primary key."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_cursor_encoding", "target": "docs_postgresql_pages_phase_9_api_crud_01_repository_02_rows_to_domain_bigint_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/10-keyset/02-cursors-and-traps.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_10_keyset_02_cursors_and_traps_cursor_encoding", "target": "docs_postgresql_pages_phase_9_api_crud_10_keyset_01_the_tuple_comparison_tuple_comparison", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "d