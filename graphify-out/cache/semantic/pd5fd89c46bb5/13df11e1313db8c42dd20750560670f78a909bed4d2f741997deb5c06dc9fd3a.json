{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_event_loop_lag", "label": "Event loop lag", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metric that turns 'the server feels slow' into a number you can alert on. One thread runs all JS \u2014 if the loop is late, every request on that process is late."}, {"id": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_monitor_event_loop_delay", "label": "monitorEventLoopDelay histogram", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values are nanoseconds; divide by 1e6 for milliseconds. Enable process-wide at boot; export p99 and max each scrape; reset or slide the window so one incident does not poison the day."}, {"id": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_idle_p50_resolution_floor", "label": "Idle p50 is the sampling resolution", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At resolution 10, idle p50 sits near 10 ms. Alerting on p50 > 5 ms at that resolution is alerting on arithmetic."}, {"id": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_max_vs_p99", "label": "Lag max vs p99", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 100 ms block moved only max (10.29 \u2192 115.34 ms). Five blocks raised p99 to ~109 ms. max is the smoke alarm; p99 is the trend."}, {"id": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_lag_not_io_wait", "label": "Lag is not downstream I/O wait", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slow downstream API is I/O wait, not lag. Sync bcrypt, image resize, GC thrash, and stdout backpressure do show up as lag."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_event_loop_lag", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_monitor_event_loop_delay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_monitor_event_loop_delay", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_idle_p50_resolution_floor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_monitor_event_loop_delay", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_max_vs_p99", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/09-event-loop-lag.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_idle_p50_resolution_floor", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_max_vs_p99", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/