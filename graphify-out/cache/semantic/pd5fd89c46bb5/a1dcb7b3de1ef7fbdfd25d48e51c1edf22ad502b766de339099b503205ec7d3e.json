{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_rendering_pipeline_stages", "label": "Rendering pipeline stages", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-rendering-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Style \u2192 layout (reflow) \u2192 paint (repaint) \u2192 composite. A change at one stage forces every later stage, never earlier ones."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_rendering_pipeline_composite_only_properties", "label": "Composite-only properties", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-rendering-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "transform and opacity run after layout and paint. Neighbours do not reflow around a transformed box, so they can overlap."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_rendering_pipeline_layout_properties", "label": "Layout-invalidating properties", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-rendering-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "width, height, padding, margin, inset, font-size, display, flex/grid tracks. Never animate these; left and transformX can land in the same place but only left recomputes geometry."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_rendering_pipeline_stages", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_rendering_pipeline_composite_only_properties", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-rendering-pipeline.html", "source_locatio