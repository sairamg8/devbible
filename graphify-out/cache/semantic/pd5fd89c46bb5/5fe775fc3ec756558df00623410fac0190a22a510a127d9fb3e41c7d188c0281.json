{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_bulk_insert", "label": "Bulk insert that scales", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per query is the common Node performance bug. 10000 rows: 20165 ms autocommit loop vs 84 ms unnest \u2014 240x."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_autocommit_wal", "label": "Autocommit WAL flush cost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each standalone INSERT commits and flushes WAL. One transaction around the loop: 20165 to 2559 ms. Remaining cost is 10000 round trips."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_unnest", "label": "INSERT SELECT unnest", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array per column; statement text is constant. Casts required. Supports ON CONFLICT and RETURNING. Materialises all values in heap."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_copy_from_stdin", "label": "COPY FROM STDIN from Node", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streaming, bounded memory, no ON CONFLICT or RETURNING. From Node, unnest beat pg-copy-streams 2.7\u20133x because of JS CSV formatting."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_65535_parameter_limit", "label": "65535 parameter wire limit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocol encodes parameter count in 16 bits. 21845 rows of 3 columns ok; 21846 is 08P01. Batch by floor(65535/columns) or use unnest."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_bulk_insert", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_autocommit_wal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_bulk_insert", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_unnest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_bulk_insert", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_copy_from_stdin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_65535_parameter_limit", "target": "docs_postgresql_pages_phase_8_schema_from_node_04_bulk_insert_unnest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/04-bulk-insert.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_pha