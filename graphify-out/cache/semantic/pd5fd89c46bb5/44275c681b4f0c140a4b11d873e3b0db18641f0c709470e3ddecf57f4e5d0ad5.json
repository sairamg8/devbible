{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_connection_pooling", "label": "Connection pooling", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/connection-pooling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_connection_pooling_pg_pool", "label": "pg.Pool", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/connection-pooling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One pool per process at module scope. max is a concurrency ceiling, not a speed limit \u2014 callers queue as waitingCount. Size from max_connections / processes."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_connection_pooling_connection_leak", "label": "Connection leak", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/connection-pooling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pool.connect() without release() is invisible until the pool is exhausted hours later. Prefer pool.query(); if you check out, release in finally."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_connection_pooling_error_listener", "label": "pool.on('error') idle listener", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/connection-pooling.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idle pooled connections can die (failover, pg_terminate_backend). Unhandled 'error' on the pool kills Node. Log and do not rethrow; the pool replaces the socket."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_connection_pooling", "target":