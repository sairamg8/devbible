{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_cursors_and_traps", "label": "Cursors and the traps", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_base64url_cursor", "label": "base64url cursor encoding", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "base64 + and / are not URL-safe. Keep timestamp precision; keep bigint id as a string. Base64 is not security \u2014 sign if the cursor must not be forgeable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_limit_plus_one", "label": "Fetch limit + 1 for hasMore", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extra row is cheaper than count(*) over the predicate. nextCursor is null at the end of the collection."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_mixed_directions", "label": "Mixed-direction keyset trap", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(a,b) < (x,y) means DESC on both. Against ORDER BY created_at DESC, id ASC it returned plausible wrong ids. Needs the expanded comparison plus a matching mixed-direction index."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_nullable_sort_column", "label": "Nullable sort column excludes later pages", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparison against NULL is never true. Page 1 includes nulls (no WHERE); later pages drop them. Measured 250000 of 500000 excluded. NULLS LAST does not fix the predicate."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_when_offset_is_right", "label": "When OFFSET is still right", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 50 pages OFFSET was 0.9\u00d7 keyset. At 500 pages keyset was 6.4\u00d7 faster. Use OFFSET for shallow page-number UIs; keyset for feeds, APIs, exports, crawlers."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_mixed_directions", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_the_tuple_comparison_row_constructor", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_mixed_directions", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_the_tuple_comparison_index_cond_vs_filter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_base64url_cursor", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_repository_rows_to_domain_bigint_as_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_cursors_and_traps_when_offset_is_right", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_keyset_the_tuple_comparison_offset_vs_keyset", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/keyset/cursors-and-traps.html", "source_location": null, "weight": 1.0}], "hyperedges": []}