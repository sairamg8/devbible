{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_page", "label": "Runner flags worth knowing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. Several flags find bugs in the suite; two can make a broken suite report green."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_test_randomize", "label": "--test-randomize", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not --test-random-order, which does not exist. Shared-state three-test suite: seeds 1/2/3/7/11 gave 2/1/1/0/3 failures. Seed 7 passed entirely."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_rerun_failures", "label": "--test-rerun-failures", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State file records passes and replays them without executing. A test edited to throw still printed \u2714 (passed on attempt 0) and exited 0. Local iteration only; never CI."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_tag_filter", "label": "--experimental-test-tag-filter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key is tags, plural, array. Singular tag: is silently ignored \u2014 a filtered CI job can run zero tests and exit 0. Filename globs are safer until this leaves experimental."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_force_exit", "label": "--test-force-exit", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exits after the last test regardless of open handles. Legitimate for a third-party leak you cannot close. On your own code it hides a production shutdown bug."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_global_setup", "label": "--test-global-setup", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "globalSetup runs before any file, teardown after the summary. Start one database for the whole run; pass the connection string via env because files are separate processes."}, {"id": "docs_nodejs_pages_phase_9_testing_14_runner_flags_test_shard", "label": "--test-shard", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheapest honest CI speed-up. Unlike rerun-failures or tag filtering it cannot make a broken suite look green."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_14_runner_flags_test_randomize", "target": "docs_nodejs_pages_phase_9_testing_14_runner_flags_rerun_failures", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_14_runner_flags_global_setup", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_start_cost", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_14_runner_flags_page", "target": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_14_runner_flags_test_shard", "target": "docs_nodejs_pages_phase_9_testing_14_runner_flags_rerun_failures", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/14-runner-flags.md", "source_location": null, "weight": 1.0}], "hyperedges": []}