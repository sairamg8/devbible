{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_08_conditionals_guard_clauses", "label": "Guard clauses", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Early returns for failures so the happy path is last and unindented. Highest-value refactor for nested ifs."}, {"id": "docs_javascript_pages_phase_2_operators_08_conditionals_ternary", "label": "Ternary chooses a value", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong for actions. One level inline; two or more align as a decision table or extract a function."}, {"id": "docs_javascript_pages_phase_2_operators_08_conditionals_object_lookup", "label": "Object lookup instead of branching", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When every branch maps a key to a value, STATUS_LABEL[status]??'Unknown' beats switch. Not for branches with different shapes or side effects."}, {"id": "docs_javascript_pages_phase_2_operators_08_conditionals_always_braces", "label": "Always brace if bodies", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brace-less bodies caused Apple goto-fail TLS. Interacts badly with ASI. Enable ESLint curly."}, {"id": "docs_javascript_pages_phase_2_operators_08_conditionals_toboolean", "label": "if uses ToBoolean", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "if(stock) treats 0 as absent. Compare explicitly: stock>0 or stock!=null."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_08_conditionals_toboolean", "target": "docs_javascript_pages_phase_2_operators_03_logical_operators_return_operands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_08_conditionals_always_braces", "target": "docs_javascript_pages_phase_2_operators_12_asi_asi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_08_conditionals_guard_clauses", "target": "docs_javascript_pages_phase_2_operators_08_conditionals_toboolean", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_08_conditionals_object_lookup", "target": "docs_javascript_pages_phase_2_operators_09_switch_strict_equality", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/08-conditionals.md", "source_location": null, "weight": 1.0}], "hyperedges": []}