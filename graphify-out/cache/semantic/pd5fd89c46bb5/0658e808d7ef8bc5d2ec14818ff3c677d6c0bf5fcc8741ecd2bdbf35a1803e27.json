{"nodes": [{"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "label": "Express request lifecycle", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server accepts \u2192 app stack top to bottom \u2192 handler or 404 \u2192 or four-arg error middleware. No parallel Express event loop; it is Node's loop."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next", "label": "next()", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each middleware sends and stops, calls next() to continue, or next(err) to jump to error middleware. Express will not auto-continue."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next_err", "label": "next(err)", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip remaining normal middleware and jump to the error-handling stack."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_four_arg_error_middleware", "label": "Four-argument error middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signature must be exactly (err, req, res, next). Register last. Express 5 forwards thrown/rejected handlers here."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_hang_without_next", "label": "Hang if no next and no response", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If nothing calls next and nothing writes a response, the client hangs. next() after res.json yields Cannot set headers after they are sent."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_404_after_routes", "label": "404 middleware after all routes", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After all routes, as normal middleware that sends 404 \u2014 not as error middleware (no err)."}, {"id": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_one_js_thread", "label": "One JS thread", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express does not process two requests on two threads. Concurrency is async I/O, not multi-threaded handlers."}], "edges": [{"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "target": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next_err", "target": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_four_arg_error_middleware", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next", "target": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_hang_without_next", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "target": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_404_after_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "target": "docs_expressjs_pages_phase_0_express_basics_02_app_router_server_http_server", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_one_js_thread", "target": "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-0-express-basics/03-request-lifecycle.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "express_request_lifecycle", "label": "Express request lifecycle", "nodes": ["docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_request_lifecycle", "docs_expressjs_pages_phase_0_express_basics_03_request_lifecycle_next", "docs_expressjs_pages