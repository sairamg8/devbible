{"nodes": [{"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "label": "The classic runtime and @jsxImportSource", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_classic_vs_automatic", "label": "Classic vs automatic JSX runtime", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic emits React.createElement and needs React in scope, children as rest args, key in props. Automatic emits jsx/jsxs from react/jsx-runtime."}, {"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_react_not_defined", "label": "ReferenceError: React is not defined", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signature of the classic transform without an import. A build-config problem \u2014 nested .babelrc, leftover @jsx pragma, test runner mismatch."}, {"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_jsximportsource", "label": "@jsxImportSource", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes which package the automatic runtime is imported from \u2014 preact or a CSS-in-JS jsx factory. Compiler option preferred over per-file pragma."}, {"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_createelement", "label": "createElement is not deprecated", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Still exported in 19.2.8 and correct without a build step. createFactory, ReactDOM.render, hydrate and unmountComponentAtNode were removed."}, {"id": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_jsx_preserve", "label": "TypeScript jsx: preserve", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leave JSX for Babel/SWC/the bundler. A file compiled that way and never passed downstream ships literal JSX."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "target": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_classic_vs_automatic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "target": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_react_not_defined", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "target": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_jsximportsource", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/15-the-classic-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_page", "target": "docs_react_pages_phase_1_jsx_15_the_classic_runtime_createelement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "d