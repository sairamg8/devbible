{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_16_error_design_page", "label": "Error design", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_codes_not_messages", "label": "Branch on err.code not err.message", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messages are prose \u2014 reworded, translated, interpolated. code is the contract. Node uses ENOENT. instanceof fails across dual package copies; code survives."}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_custom_error_class", "label": "Custom error class", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend Error, set name and a stable code, carry structured context as properties, forward options so cause works. Keep the hierarchy shallow."}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_operational_vs_programmer", "label": "Operational vs programmer errors", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational (timeout, 404, disk full) is expected \u2014 handle it. Programmer (TypeError, typo) is a bug \u2014 crash. Retrying TypeError loops forever; crashing on 404 is absurd."}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_is_operational", "label": "isOperational flag", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boundary returns statusCode and code for operational errors; programmer errors shut the process down."}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_never_leak_internals", "label": "Never leak internals in error responses", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return a stable code plus requestId. Log the stack server-side. Never send SQL or stack traces to the client."}, {"id": "docs_nodejs_pages_phase_2_async_16_error_design_aggregate_error", "label": "AggregateError", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several failures, one reason is not enough. Promise.any throws one; use it for batches where the caller needs every failure."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_16_error_design_page", "target": "docs_nodejs_pages_phase_2_async_16_error_design_custom_error_class", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_16_error_design_codes_not_messages", "target": "docs_nodejs_pages_phase_2_async_16_error_design_custom_error_class", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/16-error-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_16_error_design_page", "target": "docs_nodejs_pages_phase_2_async_16_error_design_operational_vs_programmer", "relation": "references", "confidence": "EXTRACTED