{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash", "label": "GiST, BRIN and hash", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_brin", "label": "BRIN index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores min/max per 128-page range; 24 kB vs 64 MB B-tree on 3 M ordered rows. A filter not a lookup \u2014 always a bitmap scan with recheck. Useless when physical correlation is near 0."}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_physical_correlation", "label": "pg_stats.correlation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Check before creating BRIN. Near 1 or \u22121 is excellent; measured 0.0119 on shuffled data and the planner ignored the index."}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_hash_index", "label": "Hash index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equality only; 16 MB vs 28 MB B-tree here. Cannot UNIQUE (0A000), ranges, INCLUDE, or index-only scans. WAL-logged and crash-safe since PostgreSQL 10."}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_gist", "label": "GiST index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A framework for predicates with no total order: overlap, containment, distance. Backs exclusion constraints; serves <-> ordering that GIN cannot."}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_exclusion_constraint", "label": "EXCLUDE USING gist", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No two bookings for the same room may overlap. Cannot be expressed with UNIQUE or CHECK; app-level checks race. Use '[)' bounds so back-to-back bookings do not overlap."}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_btree_gist", "label": "btree_gist extension", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_23p01", "label": "SQLSTATE 23P01 exclusion violation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_specialist_vs_btree", "label": "Specialist indexes vs default B-tree", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If unsure which applies, the answer is B-tree. BRIN, hash and GiST exist only when you know exactly why the B-tree is wrong."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_brin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_hash_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_gist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_brin", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_physical_correlation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_gist", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_exclusion_constraint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-hash.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_exclusion_constraint", "target": "docs_postgresql_pages_phase_10_indexes_15_gist_brin_hash_btree_gist", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/15-gist-brin-h