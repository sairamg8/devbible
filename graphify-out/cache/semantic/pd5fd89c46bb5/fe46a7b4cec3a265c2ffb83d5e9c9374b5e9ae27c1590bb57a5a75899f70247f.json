{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_page", "label": "Issuing DDL through the driver", "file_type": "document", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_ddl_via_query", "label": "DDL as ordinary query", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE TABLE via client.query returns command CREATE, rowCount null, empty fields. Success is no thrown error."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_identifiers_not_params", "label": "Identifiers cannot be parameters", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE TABLE $1 raises 42601 at parse time. Dynamic identifiers need format('%I') plus an allowlist."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL rolls DDL back with the transaction. CREATE INDEX CONCURRENTLY, VACUUM, CREATE DATABASE cannot run inside BEGIN (25001)."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_simple_vs_extended", "label": "Simple vs extended query protocol", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No params or [] uses simple protocol and returns an array of results. A non-empty params array forces extended protocol: 42601 cannot insert multiple commands."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_add_column_no_rewrite", "label": "ADD COLUMN DEFAULT no rewrite", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since PostgreSQL 11, ADD COLUMN NOT NULL DEFAULT is O(1); relfilenode unchanged. Changing a column type usually rewrites."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_page", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_readme_creating_tables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_page", "target": "docs_postgresql_pages_phase_8_schema_from_node_13_schema_drift_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/01-ddl-from-node/01-issuing-ddl.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_identifiers_not_params", "target": "docs_postgresql_pages_phase_8_schema_from_node_01_ddl_from_node_01_issuing_ddl_ddl_via