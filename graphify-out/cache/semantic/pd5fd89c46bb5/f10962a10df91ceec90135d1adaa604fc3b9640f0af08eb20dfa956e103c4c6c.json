{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_publishing_a_package", "label": "Publishing a package", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_scoped_names", "label": "scoped package names", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoped packages default to private (paid). Public publish needs --access public or publishConfig.access. Forgetting this is the common first-publish failure."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_npm_pack", "label": "npm pack dry-run", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only way to see the tarball contents before publish. Catch secrets going out and needed files staying home. Then install the tgz as a consumer smoke test."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_npm_version", "label": "npm version", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edits package.json, commits and tags. Refuses a dirty tree. A published version is permanent; unpublish is 72 hours and unused only."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_npm_deprecate", "label": "npm deprecate", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Realistic recovery from a bad release: deprecate plus a new version. Treat every publish as permanent."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_provenance", "label": "npm publish --provenance", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CI-only signed attestation linking the tarball to commit and workflow. Meaningful because no human laptop was involved."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_dist_tag", "label": "npm dist-tags", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-releases need --tag so they do not become latest. Without it every plain npm install gets the beta."}, {"id": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_dual_package", "label": "dual CJS/ESM packages", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESM-only is the default now that require(esm) works on Node 22.12+/24.15. Shipping both costs the dual-package hazard of two copies of module state."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_publishing_a_package", "target": "build_css_p2_docs_nodejs_pages_phase_1_modules_publishing_scoped_names", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-1-modules/publishing.html", "source_location": null, "weight": 1.0}, {"sour