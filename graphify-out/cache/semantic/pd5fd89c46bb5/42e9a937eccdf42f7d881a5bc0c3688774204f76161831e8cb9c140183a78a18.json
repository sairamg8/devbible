{"nodes": [{"id": "docs_expressjs_pages_phase_1_routing_04_route_ordering_first_match_wins", "label": "First match wins", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/04-route-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A param route registered before a static sibling steals the static path. Express will not warn. /users/export hits :id with id export."}, {"id": "docs_expressjs_pages_phase_1_routing_04_route_ordering_static_before_param", "label": "Static segments before params", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-1-routing/04-route-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More specific paths before general ones. No universal catch-all until every real route is registered. Express does not rank by specificity."}, {"id": "docs_expressjs_pages_phase_1_routing_04_route_ordering_spa_fallback_last", "label": "SPA fallback last", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/04-route-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catch-all before API routers serves API JSON as index.html. API mounts first, static + /*splat fallback last."}], "edges": [{"source": "docs_expressjs_pages_phase_1_routing_04_route_ordering_static_before_param", "target": "docs_expressjs_pages_phase_1_routing_04_route_ordering_first_match_wins", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-1-routing/04-route-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_1_routing_04_route_ordering_first_match_wins", "target": "docs_expressjs_pages_phase_1_routing_02_params_and_query_req_params", "relation": "conceptually_related_to", "c