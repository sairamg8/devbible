{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_page", "label": "Snapshot testing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. t.assert.snapshot() needs no flag on this version."}, {"id": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_assert_snapshot", "label": "t.assert.snapshot()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records output and fails when it changes. First run needs --test-update-snapshots. Commit the .snapshot file \u2014 it is the expected value."}, {"id": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_blind_update", "label": "Blind --test-update-snapshots trap", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured: after changing the renderer the flag rewrote the file and reported \u2714 with zero failures. The regression became the new expectation. Run without the flag first; review the diff."}, {"id": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_normalization", "label": "Snapshot normalization", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scrub ids and timestamps, sort collections, or inject a clock and id generator. Multiple snapshot() calls in one test are keyed by call order \u2014 prefer one per test."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_blind_update", "target": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_assert_snapshot", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_normalization", "target": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_assert_snapshot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_15_snapshot_testing_page", "target": "docs_nodejs_pages_phase_9_testing_16_lint_and_format_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/15-snapshot-testing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}