{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v4", "label": "uuid v4 (random)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random PK: 1727 ms / 8552 kB index vs bigint 947 ms / 4408 kB on 200k inserts. Scatters B-tree writes and splits pages half-empty."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v7", "label": "uuidv7() time-ordered", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 18 built-in. First 48 bits are a millisecond timestamp, recovering locality (1356 ms / 6184 kB) but leaking creation time via uuid_extract_timestamp()."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_bigint_identity", "label": "bigint identity primary key", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential appends stay on the rightmost leaf. Smaller, faster, readable. Common pattern: bigint PK plus a uuid unique column for public ids."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_never_store_as_text", "label": "Never store UUID as text", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 bytes as uuid vs 40 as text, plus string comparison and no format validation. pg sends uuid as a string; invalid values fail with 22P02."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v7", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_bigint_identity", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_never_store_as_text", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_uuid_uuid_v4", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/uuid.html", "source_location": null, "weight": 1.0}], "hyperedges": []}