{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_03_ledgers_and_node_append_only_ledger", "label": "Append-only ledger", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/03-ledgers-and-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not store a mutable balance. Immutable signed entries; derive the balance with SUM. When reads get slow, add a materialised snapshot plus entries since. A wrong UPDATE permanently corrupts a mutable balance and loses history."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_03_ledgers_and_node_never_parsefloat", "label": "Never parseFloat numeric", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/03-ledgers-and-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg returns numeric as a string on purpose. parseFloat or overriding the type parser reintroduces IEEE-754 imprecision. Compute in SQL or a decimal library. Mixing SQL and JS-float totals is how two parts of one system disagree."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_03_ledgers_and_node_never_parsefloat", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_js_string", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/03-ledgers-and-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_03_ledgers_and_node_append_only_ledger", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-type