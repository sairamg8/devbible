{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_page", "label": "File handles", "file_type": "document", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "open returns a FileHandle owning an OS descriptor. One leak per request takes the server down with EMFILE."}, {"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_filehandle", "label": "FileHandle", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positional I/O, fh.stat on the descriptor, fh.sync, exclusive-create flags. GC does not reliably close it."}, {"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_emfile", "label": "EMFILE too many open files", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-process fd limit. Exhaustion fails every subsequent file and socket. ulimit varies by orders of magnitude."}, {"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_wx_exclusive_create", "label": "wx exclusive create", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic create-if-absent; fails with EEXIST. How you implement a lock file without a check-then-create race."}, {"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_filehandle_sync", "label": "FileHandle.sync fsync", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "write resolving means the OS accepted bytes, not that they reached disk. datasync skips metadata."}, {"id": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_close_in_finally", "label": "Close FileHandle in finally", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any throw between open and close leaks the descriptor for the process lifetime. close is idempotent."}], "edges": [{"source": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_close_in_finally", "target": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_filehandle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_close_in_finally", "target": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_emfile", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_filehandle_sync", "target": "docs_nodejs_pages_phase_4_filesystem_10_atomic_writes_and_temp_files_atomic_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/09-file-handles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_09_file_handles_wx_exclusive_create", "target": "docs_nodejs_pages_phase_4_filesystem_08_stat_and_existence_toctou", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesyst