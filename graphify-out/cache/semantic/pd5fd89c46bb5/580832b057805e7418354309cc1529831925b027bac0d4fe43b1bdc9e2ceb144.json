{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_path_traversal", "label": "Path traversal", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any filesystem path built from user input is a security boundary. ../, absolute paths, encoded separators, and symlinks each escape."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_safe_resolve_check", "label": "safeResolve containment check", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path.resolve(ROOT, input), require equal-to-root or startsWith(ROOT+sep), then realpath and repeat to defeat symlinks."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_root_plus_sep", "label": "ROOT + path.sep prefix", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "startsWith('/srv/uploads') is true for /srv/uploads-evil/x. The separator plus exact-equal for the root itself is required."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_generated_storage_keys", "label": "Generated storage keys", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best defence: store under UUIDs, keep original name as metadata, address by ID. No user string reaches the filesystem."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_zip_slip", "label": "Zip-slip", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Archive entries named ../../etc/cron.d/x write outside the extract root. Apply the same containment check to every entry."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_safe_resolve_check", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_path_traversal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_root_plus_sep", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_safe_resolve_check", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_generated_storage_keys", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_path_traversal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_zip_slip", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_path_traversal_safe_resolve_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/path-traversal.html", "source_location": null, "we