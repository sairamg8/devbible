{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_no_where", "label": "DELETE with no WHERE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE is optional. Measured: DELETE FROM d_all removed 10 rows with no warning. Wrap in BEGIN and check the count. To empty a table, prefer TRUNCATE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_no_limit", "label": "DELETE takes no LIMIT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE \u2026 LIMIT is 42601. Batch via ctid IN (SELECT ctid \u2026 LIMIT n). Never store ctid; it changes on update."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_on_delete_restrict_vs_noaction", "label": "ON DELETE RESTRICT vs NO ACTION", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both refuse; 23001 vs 23503. NO ACTION is deferrable to commit (default). RESTRICT checks immediately and cannot be deferred. CASCADE is transitive and silent."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_batched_delete", "label": "Batched DELETE on live tables", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 100k DELETE 115 ms vs 10 batches 484 ms (4.2\u00d7 slower). Batching releases locks, stays interruptible, does not pin VACUUM, bounds WAL/replication lag."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_dead_tuples", "label": "DELETE leaves dead tuples", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "47 MB table stayed 47 MB after deleting half and after VACUUM. VACUUM FULL rewrote to 24 MB under ACCESS EXCLUSIVE. VACUUM truncates only trailing empty pages."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_soft_delete_is_update", "label": "Soft delete is an UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting deleted_at fires no cascade, unique constraints still see the row, every query needs WHERE deleted_at IS NULL. Idempotent: second delete rowCount 0."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_no_where", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_no_limit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_no_limit", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_batched_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_on_delete_restrict_vs_noaction", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_many", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_delete_dead_tuples", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_batched_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_soft_delete_is_update", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_unique_nulls_partial_unique_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_batched_delete", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_transactional_ddl_keep_ddl_tx_short", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_delete_on_delete_restrict_vs_noaction", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_self_referencing_tree", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/delete.html", "source_location": null, "weight": 1.0}], "hyperedges": []}