{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_function_vs_block_scope", "label": "Function scope vs block scope", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "var ignores blocks and attaches to the nearest function. let/const attach to the nearest block."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_const_binding_not_immutable", "label": "const fixes the binding not the value", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The name cannot be pointed at something else; object and array contents can still change."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_object_freeze", "label": "Object.freeze", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shallow. Nested objects remain mutable. Strict mode throws on a frozen write; sloppy fails silently."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_module_toplevel_not_global", "label": "Module top level is not global", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level var is a global only in a classic script. ES modules and CommonJS keep it off globalThis."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_accidental_global", "label": "Accidental global", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigning to an undeclared name creates a global in sloppy mode and throws ReferenceError in strict/modules."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_const_by_default", "label": "const by default", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const first, let when you reassign, var never. Use-before-declaration then throws instead of producing undefined."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_function_vs_block_scope", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_the_scope_chain_scope_creators", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_const_binding_not_immutable", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_lexical_scope_var_let_const_object_freeze", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/lexical-scope/var-let-const.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phas