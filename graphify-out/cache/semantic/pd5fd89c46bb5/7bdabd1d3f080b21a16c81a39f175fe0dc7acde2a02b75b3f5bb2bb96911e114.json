{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_page", "label": "Property-based and mutation testing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08: fast-check 4.9.0, @stryker-mutator/core 9.6.1 on Node 24.19.0."}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "label": "Property-based testing", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State a rule for all inputs; the library generates cases and shrinks failures. Asks: are there inputs you did not think of?"}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_fast_check", "label": "fast-check", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Found a slugify trailing-dash bug after a 12-char cap: Counterexample [\"0 0 00 A AA    0\"], shrunk 35 times. Default fc.string() never reached the cap."}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_good_properties", "label": "Round-trip, idempotence, invariant, oracle", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round-trip is the highest-value backend property: encoders, JWT, query-string builders, money formatting. Not useful for orchestration."}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "label": "Mutation testing", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes source (>= to >, + to -) and reruns. A surviving mutant means nothing checked that line's behaviour. Asks: do your tests actually check anything?"}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_stryker", "label": "Stryker", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On discount() with 100% line coverage: 13 killed, 2 survived at total >= 10, mutation score 86.67%. Directory positional node --test test/ fails the initial run."}, {"id": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_cost", "label": "Mutation testing cost", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the suite once per mutant. Fifteen mutants on a tiny file took 2 seconds; a codebase is hours. Scope to one module; run occasionally, not per commit."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_fast_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_stryker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "target": "docs_nodejs_pages_phase_9_testing_11_coverage_execution_not_assertion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_good_properties", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_cost", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "target": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_page", "target": "docs_nodejs_pages_phase_9_testing_18_load_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_9_verification_strength_stack", "label": "Coverage, mutation testing, and property-based testing attack untested behaviour from opposite ends", "nodes": ["docs_nodejs_pages_phase_9_testing_11_coverage_execution_not_assertion", "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_mutation_testing", "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_property_based", "docs_nodejs_pages_phase_9_testing_17_property_and_mutation_stryker"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/17-property-and-mutation.md"}]}