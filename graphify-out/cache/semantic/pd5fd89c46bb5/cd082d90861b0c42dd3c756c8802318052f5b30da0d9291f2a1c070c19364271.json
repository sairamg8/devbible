{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_database_health", "label": "Database health and alerting", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database-level statistics plus the 3am alert list: disk, connections, oldest xact, idle-in-transaction, lag, dead tuples, deadlocks, temp_bytes."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_pg_stat_database", "label": "pg_stat_database", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per database: cache hit, temp spills, deadlocks, rollback ratio, stats_reset. Read stats_reset first."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_cache_hit_ratio", "label": "Cache hit ratio understates OS cache", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "blks_read counts shared-buffer misses, many served from the OS page cache. A sharp drop matters; 97% is not a RAM purchase."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_temp_bytes", "label": "temp_bytes spill signal", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorts or hashes exceeded work_mem. Gather this trend before raising work_mem."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_alerting_minimum", "label": "Defensible production alert set", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alert on few things: connections >80% of max, oldest xact >5 min, idle-in-transaction, lag, dead tuples >20%, deadlock rate, rising temp_bytes, disk >80%."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_disk_space_alert", "label": "Disk space and WAL fill", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL handles a full disk badly. A stuck replication slot accumulating WAL can fill one surprisingly fast."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_approximate_counters", "label": "Database statistics are approximate by design", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cumulative, approximate, reported after statements complete, reset with stats_reset. For trends and triage, not accounting."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_database_health", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_pg_stat_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/05-database-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_05_database_health_pg_stat_database", "target": "docs_postgresql_pages_phase_