{"nodes": [{"id": "docs_expressjs_pages_phase_2_middleware_04_middleware_factories_page", "label": "Middleware factories", "file_type": "document", "source_file": "docs/expressjs/pages/phase-2-middleware/04-middleware-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_2_middleware_04_middleware_factories_factory_pattern", "label": "Configurable middleware factory", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/04-middleware-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function that accepts options and returns middleware. Every built-in follows it: express.json({limit}), express.static(root, options), express.urlencoded({extended})."}, {"id": "docs_expressjs_pages_phase_2_middleware_04_middleware_factories_no_module_globals", "label": "No module-level middleware options", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-2-middleware/04-middleware-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-level let options lets tests and concurrent apps clobber each other. Closure over options makes each instance independent."}, {"id": "docs_expressjs_pages_phase_2_middleware_04_middleware_factories_forgot_to_call", "label": "Factory passed as middleware", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-2-middleware/04-middleware-factories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.use(requireHeader) passes the factory, not the instance \u2014 wrong arity and behaviour. Call it: app.use(requireHeader('x-api-key'))."}, {"id": "docs_expressjs_pages_phase_2_middleware_04_middleware_factories_validate_schema", "label": "validate(schema) factory", "file