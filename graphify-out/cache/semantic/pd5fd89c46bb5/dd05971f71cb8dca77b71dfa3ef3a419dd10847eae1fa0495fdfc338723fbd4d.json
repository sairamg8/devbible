{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_many", "label": "One-to-many", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FK on the many side. NOT NULL makes it mandatory. Index the referencing column. Choose ON DELETE CASCADE or RESTRICT."}, {"id": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_one", "label": "One-to-one", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make the FK the primary key. Without uniqueness it is one-to-many wearing a 1-1 name (second profile \u2192 23505)."}, {"id": "docs_postgresql_pages_phase_3_ddl_06_relationships_many_to_many", "label": "Many-to-many join table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PRIMARY KEY (a_id, b_id) is the uniqueness rule. A surrogate id permits the duplicate you meant to forbid. Name it from the domain once it carries attributes."}, {"id": "docs_postgresql_pages_phase_3_ddl_06_relationships_join_table_trailing_index", "label": "Join table trailing-column index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PK (post_id, tag_id) serves WHERE post_id. WHERE tag_id is a Seq Scan on 20k rows until a second index exists."}, {"id": "docs_postgresql_pages_phase_3_ddl_06_relationships_self_referencing_tree", "label": "Self-referencing tree", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "parent_id nullable marks a root. ON DELETE CASCADE deletes whole subtrees. Arbitrary depth needs a recursive CTE."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_many", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_many", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_index_referencing_column", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_one", "target": "docs_postgresql_pages_phase_3_ddl_06_relationships_one_to_many", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_06_relationships_many_to_many", "target": "docs_postgresql_pages_phase_3_ddl_02_primary_keys_composite_primary_key", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/06-relationships.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_06_relationships_join_table_trailing_index", "target": "docs_postgresql_pages_phase_3_ddl_06_relationships_many_to_many", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-dd