{"nodes": [{"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_refs_and_head", "label": "Refs and HEAD", "file_type": "document", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "label": "Git ref", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ref is a file containing a hash. Namespaces: refs/heads, refs/tags, refs/remotes, refs/stash. Inspectable as text, but a bad hash write is not prevented."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_branch", "label": "Branch is a moving ref", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A branch is a ref under refs/heads that advances on commit. Creating one writes 41 bytes and no objects; deleting one deletes no commits."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_tag", "label": "Tag is an immovable ref", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_head", "label": "HEAD", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_symbolic_ref", "label": "Symbolic ref", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_detached_head", "label": "Detached HEAD", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legitimate for inspecting a commit or building a tag. Commits made there are abandoned on switch-away unless you branch first; recovery is via reflog."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_reftable", "label": "reftable backend", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_packed_refs", "label": "packed-refs", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_branching_is_free", "label": "Branching is a 41-byte file write", "file_type": "rationale", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git branch writes 41 bytes; object count is unchanged. Delete-the-branch is recoverable because objects stay reachable via the reflog."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_update_ref", "label": "git update-ref", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer update-ref over editing ref files: it writes the reflog entry recovery depends on."}], "edges": [{"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_refs_and_head", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_refs_and_head", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_branch", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_tag", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_head", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_symbolic_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_detached_head", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_head", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_branching_is_free", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_branch", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_reftable", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_packed_refs", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/git/pages/phase-0-how-git-stores-things/06-refs-and-head.md", "source_location": null, "weight": 1.0}, {"source": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_update_ref", "target": "docs_git_pages_phase_0_how_git_stores_things_06_refs_and_head_git_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, 