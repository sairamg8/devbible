{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_not_not_backup", "label": "Git is not a backup", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is-not.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git versions what you committed and by default lives on one machine. Uncommitted and ignored files are outside it."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_not_not_deploy", "label": "Git is not a deployment tool", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is-not.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git pull on a server leaves .git on the host, no atomic switch, no rollback, no build step."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_not_not_secrets", "label": "Git is not a place for secrets", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is-not.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting a credential in a later commit removes nothing. Rotate first, then rewrite, then force-push."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_not_not_binaries", "label": "Git is not a large-file store", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/what-git-is-not.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already-compressed binaries get almost none of packfile savings. git-lfs is not installed on this machine."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_h