{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_vs_next_err", "label": "next() vs next(err)", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "next() continues the stack. next(err) jumps to error handlers. On Express 5, async throws are forwarded like next(err)."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_hang", "label": "Hang: no next and no response", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither response nor next means the request hangs until the client times out."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_after_response", "label": "next() after a terminal response", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calling next after res.send lets a later layer write again and throw headers-already-sent. First body still wins."}], "edges": [{"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_vs_next_err", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_middleware_contract_three_legal_endings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_hang", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_middleware_contract_three_legal_endings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_after_response", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_vs_next_err", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_next_semantics_next_vs_next_err", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_first_and_last_four_arg_error_middleware", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/next-semantics.html", "source_location": null, "weight": 1.0}], "hyperedges": []}