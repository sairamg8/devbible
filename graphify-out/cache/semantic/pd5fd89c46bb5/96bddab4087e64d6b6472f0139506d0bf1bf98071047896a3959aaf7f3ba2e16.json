{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_virtual_filesystems_virtual_filesystem", "label": "Virtual filesystem", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/virtual-filesystems.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An object implementing the fs interface without a disk. Stream constructors accept an fs option so you can substitute without monkey-patching."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_virtual_filesystems_memfs", "label": "memfs", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/virtual-filesystems.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full in-memory fs for tests. Fast and isolated, but one device so EXDEV, umask, permissions, and EMFILE never appear."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_virtual_filesystems_sea_getasset", "label": "node:sea getAsset", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/virtual-filesystems.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assets live inside a single executable, not on disk. Branch on isSea(); prefix-only builtin (require('sea') hits npm)."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_virtual_filesystems_inject_fs_dependency", "label": "Inject fs as a dependency", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/virtual-filesystems.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests pass memfs, production passes fs/promises, no global mock. Leaves the door open for S3 later. Do not mock tests whose subject is the filesystem."}], "edges": [{