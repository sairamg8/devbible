{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_zlib", "label": "node:zlib streams", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gzip, deflate, and brotli as Transform streams so compression drops into a pipeline with constant memory."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_brotli_default_quality_11", "label": "Brotli default quality 11", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createBrotliCompress() with no options uses quality 11: 75.7 s on 19 MB vs 0.78 s for gzip 6. Intended for pre-compressed static assets."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_gzip_level", "label": "gzip level trade-off", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Level 9 is 2.2\u00d7 CPU of level 6 for 0.8% smaller. Level 1 is usually right for dynamic responses; 9 belongs in a build step."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_libuv_thread_pool", "label": "zlib on libuv thread pool", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stream zlib runs on the 4-thread libuv pool shared with fs and dns.lookup. Four concurrent gzips match one; eight double wall time."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_maxoutputlength", "label": "maxOutputLength zip-bomb cap", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A few KB of gzip can expand 1000\u00d7+. Cap decompressed size; maxOutputLength throws ERR_BUFFER_TOO_LARGE."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_compress_outside_node", "label": "Compress in nginx or CDN", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep CPU out of the event loop and thread pool. Compress in Node only for files you write, required upstreams, or no-proxy environments."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_zlib", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_brotli_default_quality_11", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_zlib", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_gzip_level", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_zlib_zlib", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/zlib.html", "source_location": null, "weight": 1.0}, {"