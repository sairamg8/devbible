{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_09_explicit_conversion_number_vs_parseint", "label": "Number versus parseInt", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/09-explicit-conversion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number demands the whole string; Number('42px') is NaN. parseInt reads a prefix. Number('') is 0; parseInt('') is NaN. Use Number plus Number.isFinite."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_09_explicit_conversion_map_parseint", "label": "map(parseInt) radix trap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/09-explicit-conversion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "map passes (value, index); index becomes radix so ['1','2','3'].map(parseInt) is [1, NaN, NaN]. Always pass radix 10."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_09_explicit_conversion_boundary_conversion", "label": "Convert at the boundary", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/09-explicit-conversion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Form fields, query params, localStorage, dataset and env vars are always strings. Parse and validate once on the way in. Apply ?? before Number because Number(null) is 0."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_09_explicit_conversion_number_vs_parseint", "target": "docs_javascript_pages_phase_1_values_and_coercion_08_type_coercion_tonumber", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/09-explicit-conversion.md", "source_location": null, "weight