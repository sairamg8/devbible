{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_node_os", "label": "node:os", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/os.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports what the host looks like. In a container that is a lie for cores and memory."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_container_host_lie", "label": "os.cpus / totalmem container lie", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/os.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 0.5-CPU / 512 MB pod on a 64-core node still sees 64 CPUs and host RAM. Sizing a WorkerPool from cpus().length is a classic production bug."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_availableparallelism", "label": "os.availableParallelism", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/os.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Respects CPU affinity masks but still misses CFS quota (--cpus=0.5). Prefer configured WORKER_CONCURRENCY."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_process_vs_os", "label": "process vs os", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/os.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "process.memoryUsage / cpuUsage describe this process. os.totalmem / loadavg describe a machine you may be sharing."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_container_host_lie", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_os_node_os", "relation": "rationale_for", "confidence": "