{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "label": "ROWS vs RANGE frames", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_default_range_peers", "label": "Default RANGE peer frame", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default frame is RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, so peers share the current row's frame."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_rows_vs_range", "label": "ROWS vs RANGE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROWS counts physical offsets; RANGE groups by ORDER BY value so ties expand the frame."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_ranking_ignores_frame", "label": "Ranking ignores the frame", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "row_number, rank, dense_rank, and ntile use the partition and ORDER BY, not the frame clause."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_ranking_ignores_frame", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_row_number", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_default_range_peers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_rows_vs_range", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range_ranking_ignores_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_windows_intro", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/frames/rows-vs-range.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_frames_rows_vs_range", "target": "build_css_p2_docs_postgresql_pages