{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_procedures_procedure", "label": "CREATE PROCEDURE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/procedures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists so it can COMMIT mid-body. Invoked with CALL. Useless inside an application BEGIN/COMMIT wrapper (2D000)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_procedures_mid_body_commit", "label": "Procedure mid-body COMMIT", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/procedures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same COMMIT in a FUNCTION is 2D000. Only works when no transaction is already open. Failures leave work partly done; the procedure must be resumable."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_procedures_mid_body_commit", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_procedures_procedure", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/procedures.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_procedures_procedure", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_plpgsql_plpgsql", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/procedures.html", "source_location": null, "weight": 1.0}], "hyperedges": []}