{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_04_multi_join", "label": "Multi-table joins", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/04-multi-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_04_multi_join_chain", "label": "Joins chain left to right", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/04-multi-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each ON may reference any table already introduced. Referencing a later table is 42P01."}, {"id": "docs_postgresql_pages_phase_5_joins_04_multi_join_inner_reorder", "label": "Inner joins reorder, outer joins do not", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/04-multi-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_04_multi_join_downstream_inner_cancels", "label": "Downstream INNER JOIN cancels LEFT JOIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/04-multi-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL-extended rows fail the later equijoin. Continue LEFT, or parenthesise the inner pair \u2014 those are different queries."}, {"id": "docs_postgresql_pages_phase_5_joins_04_multi_join_join_collapse_limit", "label": "join_collapse_limit default 8", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/04-multi-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past the limit the planner stops exploring and textual order starts to matter. Split wide joins rather than raising it."}, {"id": "docs_postgresql_pages_ph