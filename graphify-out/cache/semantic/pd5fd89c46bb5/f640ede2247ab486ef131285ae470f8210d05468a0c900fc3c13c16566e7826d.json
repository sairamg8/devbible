{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_job_idempotency_job_idempotency", "label": "Job idempotency", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/job-idempotency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every job will run twice because delivery is at-least-once. A non-repeatable handler is a pending incident."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_job_idempotency_domain_derived_key", "label": "Domain-derived idempotency key", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/job-idempotency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "order-paid-email:${orderId} is stable across attempts. crypto.randomUUID() inside the job deduplicates nothing."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_job_idempotency_jobid_vs_handler", "label": "jobId vs handler dedup", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/job-idempotency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jobId stops a duplicate enqueue. Only a handler-level unique insert stops redelivery of a claimed job."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_job_idempotency_ledger_guard", "label": "Ledger-guarded balance update", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/job-idempotency.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insert a ledger row on conflict do nothing, then apply the delta only if rowCount is 1, in one transaction."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_bac