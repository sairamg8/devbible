{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "label": "Map", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any key type, insertion order for all keys, size, direct iteration, cheaper add/remove. NaN is a usable key via SameValueZero. JSON.stringify(map) is {}."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_weakmap", "label": "WeakMap", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required when keys must not keep objects alive (visited-set in a clone, per-object metadata). Not iterable and not serialisable."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_keys_are_data", "label": "Map when keys are data", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a Map when keys are data; an object when keys are code. Tells: delete in a loop, Object.keys(o).length in a hot path, or Object.create(null) for user keys."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_samevaluezero", "label": "SameValueZero Map keys", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map key equality treats NaN as equal to NaN, so m.set(NaN,\"ok\"); m.get(NaN) works. Objects cannot have a NaN key."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_keys_are_data", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "target": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_object_literals_keys_and_order_three_tier_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_json_stringify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_samevaluezero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/map-vs-object.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_weakmap", "target": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_map_vs_object_map", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javas