{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_migrations", "label": "Migrations", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/02-migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A numbered file that runs exactly once, inside a transaction, with the fact that it ran recorded in the database."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_schema_migrations", "label": "schema_migrations tracking table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/02-migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "version PRIMARY KEY, applied_at, checksum. The database records its own version. Second run applies nothing."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_forward_only", "label": "Forward-only migrations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/02-migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Down migrations are untested, run months later, and cannot restore DROP COLUMN data. Recovery is a new forward file plus backup."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_checksum", "label": "Migration file checksum", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/02-migrations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never edit a shipped file. Hash comparison fails the deploy when two environments share a version and differ in schema."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_lexical_ordering", "label": "Lexical migration filename order", "fi