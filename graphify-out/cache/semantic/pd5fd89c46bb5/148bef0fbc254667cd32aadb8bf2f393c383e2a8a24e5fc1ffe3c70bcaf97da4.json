{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_supports", "label": "@supports feature queries", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/supports-feature-queries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks the engine whether it can parse a declaration or selector, then styles accordingly. Parentheses required; selectors need selector()."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_cascade_safe_fallback", "label": "Cascade-safe fallback without @supports", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/supports-feature-queries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declare the fallback value first and the modern value second. Engines that cannot parse the second keep the first. Use @supports only when the fallback needs different properties."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_parse_not_correctness", "label": "@supports tests parse not correctness", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/supports-feature-queries.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An engine can parse a property, apply it partially, and pass. Cannot test at-rules directly \u2014 test a declaration that implies them, e.g. container-type: inline-size."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_supports", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_supports_feature_queries_cascade_safe_fallback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-