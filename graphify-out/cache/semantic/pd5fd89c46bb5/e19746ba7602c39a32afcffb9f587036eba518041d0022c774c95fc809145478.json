{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_naming_a_subquery", "label": "Naming a subquery", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE binds a name to a subquery for one statement. It is not a temp table. One WITH, comma-separated list; lives only while the statement runs."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "label": "CTE (WITH)", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readability feature, not a performance feature. Referenced like a table anywhere a table can appear. WITH attaches to SELECT, INSERT, UPDATE, DELETE and MERGE."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_forward_reference_42p01", "label": "CTE forward reference 42P01", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE sees only earlier declarations. Forward reference is 42P01 relation does not exist. WITH RECURSIVE lifts the restriction for the whole list. Duplicate names are 42712."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte_shadows_table", "label": "CTE name shadows a real table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No warning. Inside the statement the CTE wins and the table is unreachable by that name. Give CTEs names that cannot collide."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_naming_a_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_forward_reference_42p01", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte_shadows_table", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_inlining_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_01_naming_a_subquery_cte", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_readme_data_modifying_ctes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/01-naming-a-subquery.md", "source_location": null, "weight": 1.0}], "hyperedges": []}