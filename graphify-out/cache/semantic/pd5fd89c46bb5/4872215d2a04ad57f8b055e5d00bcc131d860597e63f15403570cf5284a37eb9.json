{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_where_predicates", "label": "WHERE predicates", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_three_valued_logic", "label": "Three-valued logic in WHERE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE keeps only true. Unknown is discarded like false, silently. NULL != 5 is unknown so the NULL row is dropped."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_is_distinct_from", "label": "IS DISTINCT FROM", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Null-safe comparison: NULL differs from everything except another NULL. NULL = NULL is null; NULL IS NOT DISTINCT FROM NULL is true."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_in_null_trap", "label": "NOT IN with NULL returns nothing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x NOT IN (a, NULL) expands to x != a AND x != NULL, which can never be true. Usually arrives from a subquery with a nullable column."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_exists", "label": "NOT EXISTS over NOT IN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Null-safe anti-join and usually plans better. Prefer NOT EXISTS for subqueries always."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_half_open_ranges", "label": "Half-open time ranges", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BETWEEN is inclusive on both ends so monthly reports double-count midnight. Use >= start AND < end."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_index_defeating_wrappers", "label": "Predicates that defeat indexes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An index on col serves a predicate on bare col. date(created_at), lower(email), or col + 1 require a rewrite or a matching expression index."}, {"id": "docs_postgresql_pages_phase_4_crud_02_where_predicates_like_ilike", "label": "LIKE ILIKE and POSIX regex", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Btree serves only anchored LIKE prefix. ILIKE and leading-wildcard LIKE need lower() plus expression index or pg_trgm. Escape user wildcards."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_where_predicates", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_three_valued_logic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_is_distinct_from", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_in_null_trap", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_exists", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_exists", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_not_in_null_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_half_open_ranges", "target": "docs_postgresql_pages_phase_4_crud_17_datetime_functions_date_trunc", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_like_ilike", "target": "docs_postgresql_pages_phase_4_crud_02_where_predicates_index_defeating_wrappers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_02_where_predicates_where_predicates", "target": "docs_postgresql_pages_phase_4_crud_03_limit_offset_limit_offset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/02-where-predicates.md", "source_location": null, "weight": 1.0}], "hyperedges": []}