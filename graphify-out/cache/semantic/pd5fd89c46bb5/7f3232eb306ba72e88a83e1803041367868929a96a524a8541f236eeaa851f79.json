{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_20_benchmarking_benchmarking", "label": "Benchmarking", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/20-benchmarking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A benchmark answers a specific question under a specific load shape. A microbenchmark answers a different question with confidence it has not earned."}, {"id": "docs_nodejs_pages_phase_10_observability_20_benchmarking_autocannon", "label": "autocannon HTTP load", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/20-benchmarking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right tool when the claim is about the running service: RPS plus p50/p95/p99, error rate, and server saturation under concurrency."}, {"id": "docs_nodejs_pages_phase_10_observability_20_benchmarking_microbenchmarks", "label": "Microbenchmarks lie", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/20-benchmarking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8 over-optimizes monomorphic toys, DCE can erase unused work, and a 3 ns win does not move p99 when the DB takes 40 ms."}, {"id": "docs_nodejs_pages_phase_10_observability_20_benchmarking_observe_result_sink", "label": "Observe-result sink", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/20-benchmarking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consume the microbench result into a sink the runtime cannot prove unused, or the work may vanish."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_20_benchmarking_autocannon", "target": "docs_nodejs_pages_phase_10_observability_20_b