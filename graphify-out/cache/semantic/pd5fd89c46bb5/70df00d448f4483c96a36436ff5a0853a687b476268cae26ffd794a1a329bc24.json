{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_pseudo_elements_not_in_dom", "label": "Pseudo-elements are not in the DOM", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/pseudo-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine-created boxes with no node. querySelector('::before') is null; generated text is absent from textContent. Reachable only via getComputedStyle(el, '::before')."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_pseudo_elements_content_mandatory", "label": "content is mandatory on ::before/::after", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/pseudo-elements.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without content the pseudo-element does not exist. content:\"\" still creates the box. They sit as first/last children, so padding and overflow apply and they can be flex/grid items."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_pseudo_elements_not_in_dom", "target": "build_css_p2_docs_css_pages_phase_1_selectors_pseudo_elements_content_mandatory", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/pseudo-elements.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_pseudo_elements_content_mandatory", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_box_sizing_border_box", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/pseudo-elements.html", "source_location": null, "weight": 1.0}], "hyperedges": []}