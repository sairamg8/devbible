{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_unused_indexes", "label": "Unused and duplicate indexes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/13-unused-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_idx_scan_audit", "label": "Unused-index audit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/13-unused-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "idx_scan=0 is necessary not sufficient: exclude UNIQUE/constraint-backing indexes, check stats_reset, audit every replica, wait a full business cycle."}, {"id": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_duplicate_indexes", "label": "Duplicate indexes", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/13-unused-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PRIMARY KEY and UNIQUE already create indexes; grouping pg_index by full definition finds exact duplicates."}, {"id": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_stats_fetch_consistency", "label": "stats_fetch_consistency cache", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/13-unused-indexes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backends flush counters on a timer and the reader caches its snapshot; never conclude unused from a reading taken seconds after the query."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_unused_indexes", "target": "docs_postgresql_pages_phase_10_indexes_13_unused_indexes_idx_scan_audit", "relation": "references", "confidence": "EXTRACTED",