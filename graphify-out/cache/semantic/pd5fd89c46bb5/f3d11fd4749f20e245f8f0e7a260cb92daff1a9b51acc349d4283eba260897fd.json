{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_2_operators_comma_void_in_delete_page", "label": "15 \u00b7 Comma, void, in and delete", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/comma-void-in-delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_comma_void_in_delete_delete_holes", "label": "delete creates array holes", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/comma-void-in-delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "delete arr[1] does not shorten the array; it leaves a hole that map preserves. Use splice or filter/toSpliced. Never delete on arrays."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_comma_void_in_delete_in_vs_hasown", "label": "in vs Object.hasOwn", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/comma-void-in-delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "in walks the prototype chain so 'toString' in {} is true. Object.hasOwn checks own keys only."}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_comma_void_in_delete_void", "label": "void operator", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/comma-void-in-delete.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_2_operators_comma_void_in_delete_comma", "label": "Comma operator", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-2-operators/comma-void-in-delete.html", "source_location": null, "source_url": null, "captured_at": null, "auth