{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_02_holes_and_length_writable_length", "label": "Array length is writable", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/02-holes-and-length.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writable nonnegative integer < 2^32. Shrinking truncates; growing appends holes. arr.length=0 empties in place. Invalid lengths throw RangeError."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_02_holes_and_length_three_index_states", "label": "Three states of an array index", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/02-holes-and-length.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Present with a value; present holding undefined; a hole (property absent). Reading gives undefined for the last two; only in/hasOwn distinguish them."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_02_holes_and_length_hole_creation", "label": "Four ways to create holes", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/02-holes-and-length.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Array(n); elision [1,,3]; arr.length = larger; delete arr[i] (length unchanged). All avoidable."}, {"id": "docs_javascript_pages_phase_5_built_in_library_01_array_creation_and_shape_02_holes_and_length_hole_skipping_methods", "label": "Methods that skip holes", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/01-array-creation-and-shape/02-holes-and-length.md", "source_location": null, "so