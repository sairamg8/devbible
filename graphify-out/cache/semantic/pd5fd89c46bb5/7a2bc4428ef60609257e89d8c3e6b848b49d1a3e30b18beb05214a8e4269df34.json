{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_parse_and_the_reviver_json_parse", "label": "JSON.parse", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/parse-and-the-reviver.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invalid JSON throws SyntaxError. Trailing commas and single quotes are illegal. Empty body throws."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_parse_and_the_reviver_reviver", "label": "JSON.parse reviver", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/parse-and-the-reviver.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transforms parsed values depth-first, children first, root last under key \"\". Must return value or the property is deleted."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_parse_and_the_reviver_context_source", "label": "reviver context.source", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/parse-and-the-reviver.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primitives only. Original JSON text before double rounding. Use to rebuild BigInt IDs past MAX_SAFE_INTEGER."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_json_parse_and_the_reviver_proto_ordinary_property", "label": "JSON __proto__ is ordinary", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/json/parse-and-the-reviver.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse treats __proto__ as an own property. Pollution comes from