{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_page", "label": "HTTPS, HSTS and cookie flags", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TLS encrypts; HSTS stops the plaintext first request; cookie flags remain if either fails. Node validates no cookie attribute."}, {"id": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_hsts", "label": "HTTP Strict Transport Security", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignored on plaintext by spec. includeSubDomains makes uncertified hosts unreachable. preload takes months to remove. Ramp max-age from 300."}, {"id": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_cookie_flags", "label": "Session cookie flags", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HttpOnly, Secure, SameSite=Lax, Path=/, Max-Age, __Host- prefix. Node sends invalid flags with 200; browsers drop them silently. ~4096-byte cap."}, {"id": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_x_forwarded_proto", "label": "X-Forwarded-Proto trust", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-settable. Trust req.socket.encrypted when Node terminates TLS; trust the header only if a controlled proxy overwrites it and the origin is unreachable."}, {"id": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_tls_session_resumption", "label": "TLS 1.3 session resumption trap", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getSession() in the connect callback does not resume on TLS 1.3. Cache the ticket from the session event. Measured 3.82 ms resumed vs 5.58 ms full."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_page", "target": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_hsts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_page", "target": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_cookie_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_page", "target": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_x_forwarded_proto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_page", "target": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_tls_session_resumption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/19-https-hsts-cookies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_19_https_hsts_cookies_hsts", "target": "docs_nodejs_pages_phase_8_security