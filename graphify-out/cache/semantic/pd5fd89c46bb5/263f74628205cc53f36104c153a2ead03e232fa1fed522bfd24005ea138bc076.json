{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_create_page", "label": "create \u2014 INSERT ... RETURNING", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/create.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answer with the row the database stored, not the one the client sent. RETURNING avoids a second query and a race."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_create_insert_returning", "label": "INSERT ... RETURNING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/create.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated id, DEFAULT now(), GENERATED columns and trigger-set values come back in one round trip. currval is session-scoped and unsafe through a pool."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_create_named_columns", "label": "Name RETURNING columns", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/create.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RETURNING * publishes whatever the table has, including a later password_hash. Name the mapper's columns. 201 + Location is the usual response."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_create_unnest_many", "label": "createMany via unnest", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/create.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter per column stays under the 65535-parameter cap. RETURNING order is not guaranteed; return a correlating column."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_a