{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_18_deferrable_deferrable_constraint", "label": "Deferrable constraint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked at COMMIT. Applies to UNIQUE, PRIMARY KEY, EXCLUDE, FK. Not NULL and CHECK in practice cannot be deferred. Cannot serve as ON CONFLICT arbiter."}, {"id": "docs_postgresql_pages_phase_3_ddl_18_deferrable_circular_foreign_keys", "label": "Circular foreign keys", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEFERRABLE INITIALLY DEFERRED lets both inserts succeed; immediate fails 23503. Often a modelling smell versus a nullable FK plus is_primary."}, {"id": "docs_postgresql_pages_phase_3_ddl_18_deferrable_initially_immediate", "label": "DEFERRABLE INITIALLY IMMEDIATE", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail fast by default; SET CONSTRAINTS \u2026 DEFERRED opts in. Preferred declaration so nothing pays until a transaction asks."}, {"id": "docs_postgresql_pages_phase_3_ddl_18_deferrable_unique_swap", "label": "Deferred unique column swap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swapping unique positions collides mid-statement (23505). Needs a deferrable constraint, not a bare unique index."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_18_deferrable_circular_foreign_keys", "target": "docs_postgresql_pages_phase_3_ddl_18_deferrable_deferrable_constraint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_18_deferrable_initially_immediate", "target": "docs_postgresql_pages_phase_3_ddl_18_deferrable_deferrable_constraint", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_18_deferrable_unique_swap", "target": "docs_postgresql_pages_phase_3_ddl_08_unique_nulls_constraint_vs_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_18_deferrable_deferrable_constraint", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_no_action_vs_restrict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_18_deferrable_circular_foreign_keys", "target": "docs_postgresql_pages_phase_3_ddl_03_foreign_keys_foreign_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/18-deferrable.md", "source_location": null, "weight": 1.0}], "hyperedges": []}