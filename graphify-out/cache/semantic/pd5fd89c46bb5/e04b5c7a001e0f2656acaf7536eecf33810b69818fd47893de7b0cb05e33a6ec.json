{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_05_returning_returning", "label": "RETURNING", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_05_returning_returning_clause", "label": "RETURNING on every write", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INSERT and UPDATE return the row after the change; DELETE returns it just before disappearing. Same statement, no READ COMMITTED race, one round trip."}, {"id": "docs_postgresql_pages_phase_4_crud_05_returning_old_new_aliases", "label": "RETURNING old and new (PostgreSQL 18)", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New in 18: RETURNING old.qty AS was, new.qty AS now. Pre-18 needs a self-join. INSERT old is null; DELETE new is null."}, {"id": "docs_postgresql_pages_phase_4_crud_05_returning_do_nothing_returning_trap", "label": "ON CONFLICT DO NOTHING RETURNING trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A skipped row is not returned. Retry path reading rows[0].id crashes. Force a row with a no-op DO UPDATE; xmax = 0 distinguishes insert from update."}, {"id": "docs_postgresql_pages_phase_4_crud_05_returning_returning_cte", "label": "RETURNING feeding a CTE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE RETURNING into INSERT archive is one atomic statement. Sub-statements share a snapshot and can only see another CTE via its RETURNING output. No ORDER BY on RETURNING itself."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_05_returning_returning", "target": "docs_postgresql_pages_phase_4_crud_05_returning_returning_clause", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_05_returning_do_nothing_returning_trap", "target": "docs_postgresql_pages_phase_4_crud_06_on_conflict_on_conflict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_05_returning_do_nothing_returning_trap", "target": "docs_postgresql_pages_phase_4_crud_06_on_conflict_xmax_was_insert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_05_returning_returning_clause", "target": "docs_postgresql_pages_phase_4_crud_04_insert_insert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/05-returning.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "write_returning_cycle", "label": "Write statements and RETURNING", "nodes": ["docs_postgresql_pages_phase_4_crud_04_insert_insert", "docs_postgresql_pages_phase_4_crud_07_update_update", "docs_postgresql_pages_phase_4_crud_11_delete_delete", "docs_postgresql_pages_phase_4_crud_05_returning_returning_clause", "docs_postgresql_pages_