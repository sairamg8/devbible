{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_finally_and_timing_finally_is_a_link", "label": "finally is a link, not a clause", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/finally-and-timing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "finally attaches to the promise immediately before it. It is transparent and does not mark a rejection handled. A chain ending in finally still reports unhandled rejection."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_finally_and_timing_executor_is_synchronous", "label": "Promise executor is synchronous", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/finally-and-timing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new Promise(fn) calls fn immediately on the current stack. Wrapping slow work in a promise does not offload it."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_finally_and_timing_each_link_one_microtask", "label": "Each chain link costs a microtask", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/chaining/finally-and-timing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handlers always run asynchronously even when already settled. A hundred-link chain of sync handlers freezes the frame; yield a task to paint."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_finally_and_timing_finally_is_a_link", "target": "build_css_p2_docs_javascript_pages_phase_7_async_chaining_flattening_then_returns_new_promise", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/