{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_transactional_ddl", "label": "Transactional DDL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL and SQLite can roll back CREATE TABLE. MySQL cannot. Inverts the usual the-embedded-one-is-limited assumption. Measured on PG 18.4, MySQL 8.4.11, SQLite 3.53.3."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_implicit_commit", "label": "MySQL implicit commit on DDL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE TABLE ends the transaction before the statement runs, so a later failure leaves the schema half-migrated. Why MySQL tools ship down scripts."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_strict_mode", "label": "MySQL strict mode", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default since 5.7. Measured MySQL 8.4 rejects out-of-range smallint (1264) and oversized varchar (1406). CHECK enforced since 8.0.16. ONLY_FULL_GROUP_BY in default sql_mode since 5.7."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sqlite_type_affinity", "label": "SQLite type affinities", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column types are affinities, not constraints. Text sits in an integer column; varchar(3) holds eight characters. Prototype-on-SQLite surprises appear on PostgreSQL."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sqlite_strict_tables", "label": "SQLite STRICT tables", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite 3.37+ opt-in type enforcement. Use when prototyping on SQLite and deploying on PostgreSQL."}, {"id": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sequence_gaps", "label": "Non-transactional sequence gaps", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rolled-back insert consumes its id on PostgreSQL and MySQL (1,3). Sequences never block. Never present ids as a count. First measurement was wrong because batched psql -c shared a transaction."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_implicit_commit", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_transactional_ddl", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sqlite_strict_tables", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sqlite_type_affinity", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_strict_mode", "target": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_sqlite_type_affinity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_11_vs_other_databases_01_outdated_folklore_mysql_implicit_commit", "target": "docs_postgresql_pages_phase_1_psql_06_scripting_on_error_stop", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-0-architecture/11-vs-other-databases/01-outdated-folklore.md", "source_location": null, "weight": 1.0}], "hyperedges": []}