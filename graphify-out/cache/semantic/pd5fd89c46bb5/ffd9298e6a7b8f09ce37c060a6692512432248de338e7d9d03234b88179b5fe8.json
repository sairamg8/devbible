{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_01_esm_esm", "label": "ESM \u2014 the standard module system", "file_type": "document", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_named_vs_default_export", "label": "Named versus default exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default export is just a named export whose name happens to be default. Prefer named exports so grep and refactors work."}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_extension_required", "label": "ESM import extension is required", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESM does not guess .js or /index.js. That is what makes resolution fast and cacheable."}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_imports_hoisted", "label": "Imports are hoisted and run first", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_live_bindings", "label": "ESM live read-only bindings", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An import is a view onto the exporting module's variable, not a copy. CommonJS destructure copies the number once and never sees the update."}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_top_level_await", "label": "ESM top-level await", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every importer waits for it, transitively, and the module cannot be require()d from CommonJS (ERR_REQUIRE_ASYNC_MODULE)."}, {"id": "docs_nodejs_pages_phase_1_modules_01_esm_dynamic_import", "label": "Dynamic import()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a promise for the module namespace. The module is still evaluated once no matter how many times you import it."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_01_esm_esm", "target": "docs_nodejs_pages_phase_1_modules_01_esm_named_vs_default_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_01_esm_esm", "target": "docs_nodejs_pages_phase_1_modules_01_esm_extension_required", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_01_esm_esm", "target": "docs_nodejs_pages_phase_1_modules_01_esm_imports_hoisted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_01_esm_esm", "target": "docs_nodejs_pages_phase_1_modules_01_esm_live_bindings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/01-esm.md", "source_location":