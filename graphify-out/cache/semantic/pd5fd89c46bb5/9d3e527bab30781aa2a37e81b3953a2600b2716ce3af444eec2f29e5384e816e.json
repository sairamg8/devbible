{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_savepoint", "label": "SAVEPOINT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only way to survive a statement error inside a transaction. PostgreSQL has no real nested transactions."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_rollback_to_savepoint", "label": "ROLLBACK TO SAVEPOINT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undoes work after the marker and leaves the transaction open. Plain ROLLBACK ends it. Must be taken before the failing statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_release_savepoint", "label": "RELEASE SAVEPOINT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discards the marker but keeps the work. Later ROLLBACK TO that name is 3B001."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_subtransaction", "label": "Savepoint subtransaction", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each writing savepoint burns a real xid. Per-statement SAVEPOINT/RELEASE cost 2.3\u00d7; past 64 subxids the cache overflows and other sessions pay SubtransSLRU waits."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_rollback_to_savepoint", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_savepoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_release_savepoint", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_savepoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_subtransaction", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_savepoint", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_savepoints_subtransaction", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_xid_wraparound", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/savepoints.html", "source_location": null, "weight": 1.0}], "hyperedges": []}