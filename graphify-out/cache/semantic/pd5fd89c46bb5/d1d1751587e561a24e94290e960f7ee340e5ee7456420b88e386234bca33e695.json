{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_blob", "label": "Blob", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File bytes only. No name, path, mode, or timestamp. Filename lives in the tree that points at the blob."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_tree", "label": "Tree", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorted directory listing of mode, type, hash, name. Empty directories cannot be committed because there are no entries to store."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_commit", "label": "Commit object", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tree, parents, author, committer, message. Author and committer diverge on rebase, cherry-pick, and apply."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_annotated_tag", "label": "Annotated tag", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/object-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real object with tagger, date, message, optional signature. Releases should use git tag -a."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_lightweight_tag", "label": "Lightweight tag", "file_type": "concept", "source_f