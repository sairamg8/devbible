{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_partitioning", "label": "Partitioning", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payoff is dropping a month in milliseconds, not query speed. RANGE for time series, LIST for enums, HASH to spread writes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_pruning", "label": "Partition pruning", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips partitions that cannot match. 15.6 ms with the key vs 32.9 ms Parallel Append across five partitions \u2014 about 2\u00d7, not 5\u00d7."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_detach_drop", "label": "DETACH and DROP PARTITION", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DETACH 5 ms (metadata); DROP 10 ms for 103353 rows vs a DELETE that writes a dead tuple per row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_default_partition", "label": "DEFAULT partition", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches keys outside every range; without it INSERT is 23514. Keep it empty by creating future partitions ahead of time."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_key_in_pk", "label": "Partition key in primary key", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every unique constraint must include the partition key. No global index, so uniqueness on any other column cannot be enforced across partitions."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_pruning", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_partitioning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_detach_drop", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_partitioning", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_default_partition", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_partitioning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/partitioning.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_key_in_pk", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_partitioning_partitioning", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "so