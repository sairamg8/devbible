{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zlib_streams", "label": "zlib Transform streams", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createGzip, createDeflate, createBrotliCompress drop into a pipeline with constant memory. Use streams for file- or response-sized data."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_gzip_level", "label": "gzip compression level", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 6. Level 9 is 2.2\u00d7 CPU for 0.8% smaller. Level 1 is half the CPU for 16% larger \u2014 usually right for dynamic responses."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_brotli_quality", "label": "brotli default quality 11", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "75.7 s on 19 MB vs 0.78 s gzip level 6. Intended for pre-compressed static assets. Per-request brotli needs quality 4."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_thread_pool", "label": "zlib on libuv thread pool", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async zlib runs on the four-thread pool shared with fs and dns.lookup. *Sync variants block the main thread for the whole duration."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zip_bomb", "label": "Zip bomb maxOutputLength", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A few KB of gzip can expand to gigabytes. maxOutputLength throws ERR_BUFFER_TOO_LARGE. Never decompress untrusted input without a ceiling."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_compress_at_proxy", "label": "Compress in nginx or CDN", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps CPU off the event loop and the libuv pool. Compress in Node only for files you write, required upstreams, or no proxy."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_gzip_level", "target": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zlib_streams", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_brotli_quality", "target": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zlib_streams", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_thread_pool", "target": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zlib_streams", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/16-zlib.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zip_bomb", "target": "docs_nodejs_pages_phase_3_buffers_streams_16_zlib_zlib_streams", "relation": "conceptual