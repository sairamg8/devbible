{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_23_startup_time_startup_time", "label": "Startup time", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/23-startup-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cold-start and deploy latency until readiness. Optimize when you scale to zero or restart often; ignore it on a long-lived API that starts once a week."}, {"id": "docs_nodejs_pages_phase_10_observability_23_startup_time_enable_compile_cache", "label": "module.enableCompileCache", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/23-startup-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persists compilation artifacts. Measured status 1 under /tmp/node-compile-cache. Ephemeral /tmp in Kubernetes gives no cross-restart benefit."}, {"id": "docs_nodejs_pages_phase_10_observability_23_startup_time_lazy_imports", "label": "Lazy imports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/23-startup-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eager slows boot, speeds first request. Lazy speeds boot, moves cost to first use. Eager-import the hot path."}, {"id": "docs_nodejs_pages_phase_10_observability_23_startup_time_time_to_readiness", "label": "Time to readiness", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/23-startup-time.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measure the full ready path \u2014 load config, import routes, connect DB, listen \u2014 not only import time. DNS to Postgres can be 80% of the wait."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_23_startup_time_time_to_readin