{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_transactions_from_node", "label": "Transactions from Node", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transaction lives on one connection. Every statement must go through that connection, and nothing else may."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_pool_query_begin_bug", "label": "pool.query BEGIN bug", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pool.query takes a free connection. Concurrent flows scatter; one flow's ROLLBACK can run on another's connection. Quiet processes hide it."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_withtransaction", "label": "withTransaction helper", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pool.connect, BEGIN, fn(client), COMMIT or ROLLBACK, release in finally. Write it once; never write BEGIN in a handler."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_executor_vs_als", "label": "Pass executor vs AsyncLocalStorage", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repos take a db that is pool or tx client, or ALS holds the client. Explicit is greppable; ALS keeps call sites clean. One statement on the wrong executor undoes the point."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_25p02_savepoint", "label": "25P02 and SAVEPOINT", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed statement poisons the Postgres transaction. Continuing requires a SAVEPOINT taken beforehand."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_no_http_in_tx", "label": "No HTTP inside a transaction", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transaction pins a connection and locks. Four open txs in a max:4 pool left the next query waiting 103 ms."}, {"id": "docs_nodejs_pages_phase_6_data_access_06_transactions_mongo_session", "label": "Mongo session.withTransaction", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retries the callback on transient errors, so it must be idempotent. Omitting {session} commits outside the transaction with no warning."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_06_transactions_pool_query_begin_bug", "target": "docs_nodejs_pages_phase_6_data_access_06_transactions_withtransaction", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_06_transactions_withtransaction", "target": "docs_nodejs_pages_phase_6_data_access_04_postgresql_from_node_pool_vs_client", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/06-transactions.md", 