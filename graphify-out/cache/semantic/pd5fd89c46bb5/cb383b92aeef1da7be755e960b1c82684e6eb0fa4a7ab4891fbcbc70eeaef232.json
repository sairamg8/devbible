{"nodes": [{"id": "docs_postgresql_pages_phase_1_psql_02_daily_meta_commands_backslash_not_sql", "label": "Backslash commands are not SQL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-1-psql/02-daily-meta-commands.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "psql interprets them locally and issues catalog queries. Unavailable from pg, Prisma, or any driver. Line-oriented; cannot mix into a statement."}, {"id": "docs_postgresql_pages_phase_1_psql_02_daily_meta_commands_d_family", "label": "\\d family", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/02-daily-meta-commands.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\\l databases, \\dn schemas, \\dt tables, \\di indexes, \\dv views, \\ds sequences, \\df functions, \\dm materialized views. + adds detail; S includes system objects."}, {"id": "docs_postgresql_pages_phase_1_psql_02_daily_meta_commands_patterns", "label": "psql name patterns", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/02-daily-meta-commands.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use * and ?, not SQL % and _. Unquoted names fold to lower. \\dt *.* lists every table in every schema."}, {"id": "docs_postgresql_pages_phase_1_psql_02_daily_meta_commands_reconnect", "label": "\\c reconnect", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-1-psql/02-daily-meta-commands.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connects to another database or user. Discards SET, temp tables, prepared statements, and any open transaction."}, {"id": "docs_postgresql_pages_phase_1_psql_02_daily_meta_commands_echo_hidden", "label": "psql -E echo hidden", "file_type": "