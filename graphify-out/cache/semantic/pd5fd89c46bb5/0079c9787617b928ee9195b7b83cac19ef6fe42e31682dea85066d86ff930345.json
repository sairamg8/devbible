{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_page", "label": "Choosing and what Map costs", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_no_serialize", "label": "Map does not serialise", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Biggest reason objects survive at network and storage edges. JSON.stringify([...map]) keeps key types; fromEntries stringifies them."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_no_literal", "label": "Map has no literal syntax", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_no_structural_typing", "label": "Map has no structural typing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Map of string keys cannot catch config.get(\"retires\") the way config.retires would."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_groupby", "label": "Map.groupBy vs Object.groupBy", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouping keys are data. Map.groupBy keeps any key type and insertion order; Object.groupBy stringifies and re-sorts numeric keys."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_weakmap", "label": "WeakMap", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds keys weakly so entries die with the key object. A plain Map in that role is a memory leak. Not iterable, no size."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_page", "target": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_no_serialize", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_map_set_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/02-choosing-and-costs.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_02_choosing_and_costs_page", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/j