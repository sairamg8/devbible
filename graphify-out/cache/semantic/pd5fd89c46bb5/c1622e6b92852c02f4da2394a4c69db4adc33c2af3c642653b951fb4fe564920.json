{"nodes": [{"id": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_trust_proxy", "label": "trust proxy", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-9-hardening/01-trust-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.set('trust proxy', 1) for one hop of reverse proxy you control. Never set true on an open internet edge without understanding spoofed X-Forwarded-For."}, {"id": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_req_ip", "label": "req.ip behind a proxy", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-9-hardening/01-trust-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without trust proxy, req.ip is the load balancer. Rate limits and secure cookies misbehave. All traffic appears as one IP and rate limiting bans everyone."}, {"id": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_x_forwarded_for_spoof", "label": "X-Forwarded-For spoofing", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-9-hardening/01-trust-proxy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trust proxy true on an open edge trusts client-supplied forwarded headers. Nginx syllabus covers termination in depth."}], "edges": [{"source": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_trust_proxy", "target": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_req_ip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-9-hardening/01-trust-proxy.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_trust_proxy", "target": "docs_expressjs_pages_phase_9_hardening_01_trust_proxy_x_forwarded_for_spoof", "relation": "rationale_for", "confidence": "EXT