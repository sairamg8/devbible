{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_page", "label": "The six Map vs object differences", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_accidental_keys", "label": "Object accidental inherited keys", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Map has no default keys. An object dictionary keyed by user input inherits toString and friends."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_key_types", "label": "Map keys can be any value", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object keys stringify, so 1 collides with \"1\" and any two objects become [object Object]. Map compares object keys by identity."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_key_order", "label": "Map insertion order vs object order", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer-like object keys enumerate ascending first. A Map keyed by numeric IDs keeps insertion order."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_size", "label": "Map.size vs Object.keys length", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_iteration", "label": "Map is directly iterable", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for...of over a Map yields [k, v] pairs. Objects need Object.entries and are not iterable."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_frequent_changes", "label": "Map add/remove performance", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you are calling delete in a loop, you wanted a Map. No multiplier is claimed."}, {"id": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_samevaluezero", "label": "SameValueZero key equality", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NaN equals NaN and 0 equals -0. Same algorithm as Set and Array.prototype.includes."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_samevaluezero", "target": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_key_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_10_map_vs_object_01_the_six_differences_iteration", "target": "docs_javascript_pages_phase_6_iteration_and_destructuring_02_loop_forms_01_what_each_iterates_for_of", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/javascript/pages/phase-5-built-in-library/10-map-vs-object/01-the-six-differences.md", "source_location": null, "weight": 1.0}], "hyperedges": []}