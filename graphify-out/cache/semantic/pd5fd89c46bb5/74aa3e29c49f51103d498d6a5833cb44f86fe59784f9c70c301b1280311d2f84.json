{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_round_once", "label": "Round once at the charging boundary", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounding at each step discards fractions that compound. Carry full precision through; store both inputs and the rounded charge so a historical invoice can be reproduced and explained. Implement jurisdiction-specific rules explicitly."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_largest_remainder", "label": "Largest-remainder allocation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100/3 \u2192 33.33\u00d73 = 99.99. No rounding rule fixes indivisibility. Floor each share in minor units, then give leftover units to the largest remainders (33.34, 33.33, 33.33). Assert parts sum to the whole."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_store_fx_rate", "label": "Store the FX rate with the transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without fx_rate and fx_rate_at, next year's report reconverts at today's rate. Never convert for comparison on the fly. Rates need numeric(18,8) against amounts numeric(14,2)."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_round_once", "target": "docs_postgresql_pages_phase_2_types_02_numeric_vs_float_numeric_rounding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_largest_remainder", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_round_once", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_02_arithmetic_and_rounding_store_fx_rate", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_01_storing_money_amount_and_currency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/02-arithmetic-and-rounding.md", "source_location": null, "weight": 1.0}], "hyperedges": []}