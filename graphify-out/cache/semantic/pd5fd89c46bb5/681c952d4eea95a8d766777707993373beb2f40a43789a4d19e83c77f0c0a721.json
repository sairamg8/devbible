{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_page", "label": "TRUNCATE versus DELETE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate", "label": "TRUNCATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near O(1) new empty files. 4.4 ms versus DELETE 12.7 ms on 10000 rows. No WHERE, no RETURNING, ACCESS EXCLUSIVE, own privilege, blocked by inbound FKs."}, {"id": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_transactional", "label": "TRUNCATE is transactional in PostgreSQL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100 rows, TRUNCATE inside a transaction, ROLLBACK, all 100 back. Unlike MySQL and Oracle where TRUNCATE commits implicitly."}, {"id": "docs_postgresql_pages_phase_4_crud_14_truncate_restart_identity", "label": "TRUNCATE RESTART IDENTITY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain TRUNCATE left next id at 10001. Sequences are separate objects. Tests asserting id === 1 fail on the second run without RESTART IDENTITY."}, {"id": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_cascade", "label": "TRUNCATE CASCADE versus DROP CASCADE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TRUNCATE CASCADE empties referencing tables transitively. DROP CASCADE removes dependent objects and leaves child data. Prefer naming every table."}, {"id": "docs_postgresql_pages_phase_4_crud_14_truncate_no_row_triggers", "label": "TRUNCATE fires no row triggers", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AFTER DELETE FOR EACH ROW logged 2 for DELETE and nothing more for TRUNCATE. Audit and counters silently skip. Use AFTER TRUNCATE FOR EACH STATEMENT."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_page", "target": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate", "target": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_page", "target": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_14_truncate_restart_identity", "target": "docs_postgresql_pages_phase_4_crud_04_insert_identity_consumed_on_conflict", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-4-crud/14-truncate.md", "source_location": null, "weight": 1.0}], "hyperedges": []}