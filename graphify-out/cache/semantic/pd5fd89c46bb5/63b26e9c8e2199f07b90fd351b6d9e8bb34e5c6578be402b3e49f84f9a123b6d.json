{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_connection_uri", "label": "postgresql:// connection URI", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgresql://USER:PASSWORD@HOST:PORT/DATABASE. Sandbox example: postgresql://devbible:devbible@127.0.0.1:55432/devbible. Easy to pass around and easy to log by accident."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_pg_env_vars", "label": "PG* environment variables", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE. PGPASSWORD is convenient and easy to leak in process lists."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_database_url", "label": "DATABASE_URL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Common app convention; not read by psql by default. Never print it in error handlers or APM breadcrumbs."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_pg_hba_conf", "label": "pg_hba.conf", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides who may connect how (trust, scram-sha-256, peer) from which addresses. Missing entry yields no pg_hba.conf entry for host."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_sqlstate_28p01", "label": "SQLSTATE 28P01", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "invalid_password / authentication failure. Measured from Node as err.code 28P01 on a wrong DATABASE_URL password."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_pgpass", "label": ".pgpass", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hostname:port:database:username:password file for psql. Permissions must be tight (0600) or psql silently ignores it."}, {"id": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_inet_server_port", "label": "inet_server_port()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the server listen port inside its network namespace (5432), not Docker's published host port (55432)."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_connection_uri", "target": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_database_url", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/08-connection-and-auth.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_connection_uri", "target": "docs_postgresql_pages_phase_0_architecture_08_connection_and_auth_pg_env_vars", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0