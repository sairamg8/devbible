{"nodes": [{"id": "docs_react_pages_phase_2_components_01_function_components_02_identity_and_nesting", "label": "Component identity and the nesting rule", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/01-function-components/02-identity-and-nesting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_01_function_components_02_identity_and_nesting_nesting_rule", "label": "Nesting rule", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/01-function-components/02-identity-and-nesting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciliation compares type by Object.is. A new function each render is a different component, so the subtree remounts. Never nest definitions."}, {"id": "docs_react_pages_phase_2_components_01_function_components_02_identity_and_nesting_remount_cost", "label": "Type change remount cost", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/02-identity-and-nesting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State, refs, effects, DOM, focus, scroll, animations and uncontrolled inputs are all destroyed and recreated."}, {"id": "docs_react_pages_phase_2_components_01_function_components_02_identity_and_nesting_four_disguises", "label": "Four disguises of unstable identity", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/02-identity-and-nesting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local arrows, HOCs in render, and memo or lazy called during render. A map of module-level components is safe."}, {"id": "docs_react_pages_phase_2_components_01_function_components_02