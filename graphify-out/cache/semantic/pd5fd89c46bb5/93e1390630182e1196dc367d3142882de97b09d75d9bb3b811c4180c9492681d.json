{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_page", "label": "JSON.stringify and what it drops", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_silent_losses", "label": "JSON.stringify is silently lossy", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It sees the same own enumerable string-keyed set as Object.keys. Prototype, symbols and non-enumerables are gone."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_omit_vs_null", "label": "undefined omitted in objects, nulled in arrays", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined, functions and symbols vanish from objects and become null in arrays \u2014 same values, opposite treatment."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_nan_infinity_null", "label": "NaN and Infinity become null", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_date_tojson", "label": "Date.toJSON ISO string", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most common JSON bug: a parsed clone holds a string, so .getTime() throws far from the serialisation."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_map_set_empty", "label": "Map and Set stringify as {}", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contents live in internal slots, not own enumerable properties."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_throws_bigint_cycles", "label": "stringify throws on BigInt and cycles", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BigInt refusal forces an explicit serialisation. A cycle is a hard limit; structuredClone clones but does not produce a string."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_tojson", "label": "toJSON hook", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The return value is serialised instead of the object. Lives with the type, unlike a per-call-site replacer."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_replacer", "label": "JSON.stringify replacer", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function form returning undefined omits a key at every level. Array form is a deny-by-default allowlist. Symbol keys stay ignored."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_not_deep_equality", "label": "stringify is not deep equality", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key order follows enumeration, so same content in different insertion order produces different strings."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_silent_losses", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_omit_vs_null", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_silent_losses", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_map_set_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_date_tojson", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_tojson", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/01-stringify.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_tojson", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_map_set_empty", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence