{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_endianness", "label": "Endianness", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BE stores the most significant byte first (network byte order). LE stores the least first. Wrong order yields a valid but wrong number with no error."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_typed_read_write", "label": "Buffer typed read and write", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniform family: read/write + type + BE/LE. Named methods throw ERR_BUFFER_OUT_OF_BOUNDS or ERR_OUT_OF_RANGE; index assign wraps modulo 256."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_readbigint64", "label": "readBigInt64 / readBigUInt64", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A JS number holds integers exactly only to 2^53\u22121. Database IDs and Snowflake IDs must stay BigInt."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_length_prefixed_protocol", "label": "Length-prefixed framing", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed header of type plus payload length, then payload. Buffer remainder on incomplete frames. Validate attacker-controlled length before allocating."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_dataview", "label": "DataView endianness API", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same ground with per-call littleEndian. Portable to the browser. Use in shared code; Buffer named methods in Node-only parsers."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_index_assign_wraps", "label": "Index assign skips validation", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "buf[i] = 256 stores 0 with no throw. writeUInt8 throws ERR_OUT_OF_RANGE, which a parser wants on a malformed frame."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_typed_read_write", "target": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_endianness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_readbigint64", "target": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_typed_read_write", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/06-binary-data-and-endianness.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_06_binary_data_and_endianness_length_prefixed_protocol", 