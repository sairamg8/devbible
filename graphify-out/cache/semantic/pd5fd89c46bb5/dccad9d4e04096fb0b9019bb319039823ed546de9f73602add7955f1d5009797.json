{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_idle_in_transaction_page", "label": "Idle in transaction", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/idle-in-transaction.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_idle_in_transaction_idle_in_transaction", "label": "Idle in transaction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/idle-in-transaction.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN then silence. wait_event=ClientRead: the server waits on the client. Holds a pool slot, locks, and possibly the vacuum horizon. Distinct from idle (no transaction)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_idle_in_transaction_idle_in_transaction_session_timeout", "label": "idle_in_transaction_session_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/idle-in-transaction.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kills a backend idle in transaction longer than N (25P03). statement_timeout does not help \u2014 no statement is running. Terminates the connection; pg emits 'error', not a rejected promise."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_idle_in_transaction_transaction_timeout", "label": "transaction_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/idle-in-transaction.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 17+. Kills any transaction older than N whether idle or busy (25P04). Covers the always-active long batch the idle timeout misses."}], "edges": [{"s