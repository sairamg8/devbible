{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_three_sources", "label": "Three connection config sources", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URL, config object, or libpq env vars (PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE). They do not merge as expected."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_connection_string_wins", "label": "connectionString overwrites object fields", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A URL plus database: 'postgres' still connects to the URL database, with no warning. Mix only pool-level options (max, timeouts, ssl object)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_sslmode_verify_full", "label": "sslmode=require is changing", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg 8.x treats require as verify-full (stricter than libpq). pg 9.0 will adopt libpq semantics and silently stop verifying. Write sslmode=verify-full now."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_options_passthrough", "label": "Pool options string for server settings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "options: '-c search_path=app,public -c statement_timeout=5000' applies on every new connection. A SET via pool.query lands on one arbitrary connection."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_password_function", "label": "password as a function", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated when a connection opens, not per query. Pair with idleTimeoutMillis shorter than an IAM token TTL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_localhost_ipv6", "label": "Prefer 127.0.0.1 over localhost", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "localhost can resolve to ::1 first; a container published only on IPv4 refuses it. Node 24 autoSelectFamily hides this; the literal address does not depend on it."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_three_sources", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_connection_string_wins", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_sslmode_verify_full", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connection_config_three_sources", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/connection-config.html", "source_location": null, "weight