{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "label": "StringDecoder", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffers a trailing incomplete UTF-8 sequence and prepends it to the next write so chunk.toString() cannot permanently replace a split character with U+FFFD."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_chunk_tostring_corruption", "label": "Per-chunk toString corruption", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunk boundaries fall on byte offsets, so decoding each chunk independently substitutes U+FFFD for both halves of a multi-byte character."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_setencoding", "label": "stream.setEncoding", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs a StringDecoder internally. Prefer this in application code; stay in buffers when bytes matter."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_token_vs_character_boundaries", "label": "Character vs token boundaries", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "StringDecoder fixes character boundaries only. A regex still misses a token split across chunks; that needs a framing Transform."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_chunk_tostring_corruption", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_setencoding", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_token_vs_character_boundaries", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/string-decoder.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_token_vs_character_boundaries", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_transform_streams_transform_and_boundaries_splitlines_framing", "relation": "references", "confidence": "EX