{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_drop_cascade_restrict_2bp01", "label": "DROP defaults to RESTRICT (2BP01)", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/drop-cascade.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dependent_objects_still_exist. The error/NOTICE list is the dry-run. Prefer dropping named dependents over blanket CASCADE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_drop_cascade_schema_not_data", "label": "DROP CASCADE is schema not data", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/drop-cascade.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops views and the child's FK constraint; the child table and its rows survive, now orphanable. Opposite of ON DELETE CASCADE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_drop_cascade_rename_before_drop", "label": "Rename before drop", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/drop-cascade.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rename to old_deprecated_DATE so leftover code fails with 42703 immediately; drop a deploy later. Turns irreversible data loss into a reversible mistake."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_drop_cascade_schema_not_data", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_on_delete_actions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/drop-cascade.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_drop_cascade_rename_before_drop", "target": "build_cs