{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_generated_always_as_identity", "label": "GENERATED ALWAYS AS IDENTITY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL-standard identity refuses manual inserts with 428C9. serial accepts them without advancing the sequence, later colliding with 23505."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_serial_shorthand", "label": "serial is not a type", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "serial creates an integer, a sequence, and a default. The sequence is owned by the column and dropped with the table. Identity is is_identity, not column_default."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_bigint_not_int", "label": "bigint identity, not int", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "int stops at 2,147,483,647. Sequences advance on attempts, so failures burn the range faster than row count. Migrating int\u2192bigint rewrites under ACCESS EXCLUSIVE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_bigint_as_js_string", "label": "bigint ids as JavaScript strings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg returns bigint as a string because 64-bit exceeds Number.SAFE_INTEGER. Treat ids as opaque strings; user.id + 1 becomes '11'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_natural_vs_surrogate", "label": "Natural vs surrogate keys", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surrogate keys win because natural keys change. Natural keys fit immutable reference data (ISO codes). A surrogate does not replace UNIQUE on the natural key."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_uuid_primary_keys", "label": "UUID primary keys", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 bytes vs 8; v4 UUIDs destroy btree insert locality. Prefer UUIDv7 if client-generated ids are required. Adding uuid DEFAULT gen_random_uuid() rewrites the table."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_composite_primary_keys", "label": "Composite primary keys", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Natural fit for join tables: PRIMARY KEY (post_id, tag_id) is the uniqueness rule. Leading column serves one direction; the other needs its own index."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_generated_always_as_identity", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_serial_shorthand", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_generated_always_as_identity", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_bigint_not_int", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_bigint_not_int", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_bigint_as_js_string", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_natural_vs_surrogate", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_generated_always_as_identity", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_uuid_primary_keys", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_natural_vs_surrogate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_primary_keys_composite_primary_keys", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_many_to_many", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/primary-keys.html", "source_location": null, "weight": 1.0}, {"source": "bui