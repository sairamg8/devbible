{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_page", "label": "Vitest and Jest \u2014 when they earn their place", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08: node:test 0.22s, Vitest 4.1.10 1.43s, Jest 30.4.2 1.52s on the same 50-test suite."}, {"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_node_test_default", "label": "node:test as default backend runner", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "describe/it, hooks, mocks, timers, coverage, snapshots, watch, sharding, JUnit with zero dependencies. Startup ~6\u00d7 faster than Vitest or Jest."}, {"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_vitest", "label": "Vitest", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earns its place for a shared frontend runner, DOM (jsdom/happy-dom), expect/vi.mock, interactive UI, and first-class TypeScript."}, {"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_jest_esm", "label": "Jest native ESM friction", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs NODE_OPTIONS=--experimental-vm-modules plus transform: {}. Without them: SyntaxError Cannot use import statement outside a module. Hardest of the three to justify on a new ESM project."}, {"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_vi_mock_hoisting", "label": "vi.mock hoisting", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vitest's transform hoists vi.mock above imports, so it avoids the import-order trap that mock.module suffers. Bought with a transform step."}, {"id": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_toequal_vs_deepstrictequal", "label": "toEqual vs deepStrictEqual", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "expect(a).toEqual(b) ignores undefined properties and does not compare prototypes; deepStrictEqual does both. Migrations surface real object-shape mismatches."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_vi_mock_hoisting", "target": "docs_nodejs_pages_phase_9_testing_08_module_mocking_import_order_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_node_test_default", "target": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_vitest", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_vitest", "target": "docs_nodejs_pages_phase_9_testing_12_vitest_and_jest_jest_esm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/12-vitest-and-jest.md", "source_location": null, "weight": 1.0}, {"source": "