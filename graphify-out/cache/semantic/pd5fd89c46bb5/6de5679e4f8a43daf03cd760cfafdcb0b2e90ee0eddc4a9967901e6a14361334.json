{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_unlogged_tables", "label": "UNLOGGED tables", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip WAL: ~1.5\u00d7 faster (150\u219298 ms / 100k inserts). Truncated on crash recovery, never replicated, survive clean restart. Right for regenerable staging and caches."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temporary_tables", "label": "TEMPORARY tables", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private to one session in pg_temp_N, dropped with the session. Shadow permanent names via search_path. Live in temp_buffers (default 8 MB), not shared_buffers."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temp_pooling_hazard", "label": "Temp tables vs connection pooling", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE on connection A and INSERT on B \u2192 42P01. Hold one checked-out client. ON COMMIT DROP prevents leftover temp data on reused pooled connections."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_cte_instead_of_temp", "label": "CTE instead of a temp table", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the data is only needed in one statement, WITH staging AS (\u2026) avoids DDL, locks, catalog churn and the pooling problem."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_unlogged_tables", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temporary_tables", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temporary_tables", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temp_pooling_hazard", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_cte_instead_of_temp", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temporary_tables", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temporary_tables", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_search_path", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_temp_unlogged_temp_pooling_hazard", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_schemas_tenancy_set_local_search_path", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/temp-unlogged.html", "sour