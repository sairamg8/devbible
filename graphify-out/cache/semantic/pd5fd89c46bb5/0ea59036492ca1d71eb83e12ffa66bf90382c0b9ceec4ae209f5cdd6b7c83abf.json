{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_build_json_sql_jsonb_build_object", "label": "jsonb_build_object", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/build-json-sql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit key allowlist. Prefer over to_jsonb(row) for client payloads so new columns do not leak."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_build_json_sql_jsonb_agg", "label": "jsonb_agg", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/build-json-sql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over zero rows returns NULL not []; over a LEFT JOIN with no match returns [{nulls}]. Need FILTER plus coalesce to []."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_build_json_sql_jsonb_to_recordset", "label": "jsonb_to_recordset", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/build-json-sql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns a JSON array parameter into typed rows for INSERT ... SELECT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_build_json_sql_shape_in_js", "label": "Shape JSON in JS not SQL", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/build-json-sql.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jsonb_agg 284.8 ms vs flat join + JS 90.7 ms; json_agg 131.2 ms. Use SQL constructors when the shape is the point, not serialisation."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_build_json_sql