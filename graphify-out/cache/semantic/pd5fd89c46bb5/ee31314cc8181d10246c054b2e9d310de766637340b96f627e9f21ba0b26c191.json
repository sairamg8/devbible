{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_10_lateral", "label": "LATERAL", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/10-lateral.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_10_lateral_lateral", "label": "LATERAL correlated FROM subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/10-lateral.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a FROM subquery see tables to its left and run once per driving row, returning many columns and many rows."}, {"id": "docs_postgresql_pages_phase_5_joins_10_lateral_left_on_true", "label": "LEFT JOIN LATERAL ON true", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/10-lateral.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CROSS JOIN LATERAL drops empty driving rows. ON true is required syntax; matching already happened in the subquery WHERE."}, {"id": "docs_postgresql_pages_phase_5_joins_10_lateral_top_n", "label": "LATERAL top-N per group", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/10-lateral.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a real dimension table and an index, 9.3 ms vs 51.8 ms for row_number() on 200k rows \u2014 5.6\u00d7. Probe ~1500 rows instead of numbering all 200000."}, {"id": "docs_postgresql_pages_phase_5_joins_10_lateral_implicit_srf", "label": "Set-returning functions are implicitly LATERAL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/10-lateral.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_postgresql_pages_