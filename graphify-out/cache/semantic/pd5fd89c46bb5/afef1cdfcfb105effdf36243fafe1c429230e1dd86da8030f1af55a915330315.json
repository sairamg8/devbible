{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_page", "label": "Migration tools", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tool implements a tracking table. Choose on workflow assumption, not feature list. Own-runner until CONCURRENTLY or baselining; node-pg-migrate for raw SQL; schema-derived tools only with their client."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_four_models", "label": "The four migration models", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node-pg-migrate and graphile-migrate: you write SQL. Prisma Migrate and drizzle-kit: the tool diffs a schema file. Split: do you write the schema, or does the tool derive it?"}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_node_pg_migrate", "label": "node-pg-migrate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v9.0.0. SQL or JS files, optional down. You own the schema; SQL is source of truth. Natural next step from a hand-written runner."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_graphile_migrate", "label": "graphile-migrate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1.4.1. One idempotent current.sql re-run on save, then committed as a numbered file. Fits functions/triggers/views/RLS; poor fit for incremental ALTER TABLE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_prisma_migrate", "label": "Prisma Migrate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v7.9.1. schema.prisma is source of truth; migrations are generated by diff. Do not use without Prisma Client."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_drizzle_kit", "label": "drizzle-kit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v0.31.10. TypeScript schema objects; SQL generated by diff. Same derived-schema trade-off as Prisma."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_baselining", "label": "Baselining an existing database", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_dump --schema-only as one baseline, mark applied without running. History before the baseline is no longer replayable."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migration_tools_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/migration-tools.html"