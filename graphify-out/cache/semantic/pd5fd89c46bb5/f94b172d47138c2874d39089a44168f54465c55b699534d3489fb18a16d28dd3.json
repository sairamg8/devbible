{"nodes": [{"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_logic_that_belongs_to_an_event", "label": "Logic that belongs to an event", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logic triggered by a user action ended up in an effect, where the information about what the user did no longer exists."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_share_with_plain_function", "label": "Share handler logic with a plain function", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hoisting shared follow-up into an effect fires it on mount and every product change, so a user already in-cart sees Added on page load."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_post_causation", "label": "POST placement depends on causation", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analytics stays in an Effect because the form was displayed. Registration belongs in the submit handler. Same verb, opposite answers."}, {"id": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_state_as_message_queue", "label": "State as a message queue", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handler sets jsonToSubmit so an effect will POST. Extra render, null skip, StrictMode double-submit. Delete both and call the function."}], "edges": [{"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_share_with_plain_function", "target": "docs_react_pages_phase_4_effects_01_what_an_effect_is_for_effects_versus_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_post_causation", "target": "docs_react_pages_phase_4_effects_04_cleanup_03_when_cleanup_is_not_the_answer_buying_a_product", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_06_you_might_not_need_an_effect_01_logic_that_belongs_to_an_event_state_as_message_queue", "target": "docs_react_pages_phase_4_effects_05_strictmode_double_invocation_extra_setup_cleanup_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/06-you-might-not-need-an-effect/01-logic-that-belongs-to-an-event.md", "source_location": null, "weight": 1.0}], "hyperedges": []}