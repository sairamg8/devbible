{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys", "label": "Empty groups and keys", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/empty-groups-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys_no_groupby_one_row", "label": "No GROUP BY is one row", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/empty-groups-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An aggregate query with no GROUP BY always returns exactly one row, even on an empty table."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys_sum_empty_null", "label": "sum of empty set is NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/empty-groups-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum over no rows is NULL, not 0."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys_null_groups_together", "label": "NULL keys group together", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/empty-groups-and-keys.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY treats all NULLs as one key even though NULL = NULL is unknown."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_empty_groups_and_keys_no_g