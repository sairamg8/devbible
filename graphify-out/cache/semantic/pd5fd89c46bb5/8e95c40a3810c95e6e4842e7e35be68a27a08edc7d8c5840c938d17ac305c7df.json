{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_call_apply_bind", "label": "call apply bind", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/01-the-three-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three set this. Only bind defers the call. apply takes an array. bind returns a new function every time."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_thisarg_coercion", "label": "thisArg coercion", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/01-the-three-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict passes thisArg untouched. Sloppy boxes primitives and replaces null/undefined with globalThis."}, {"id": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_sloppy_primitive_boxing", "label": "Sloppy primitive boxing", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/01-the-three-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each call(42) boxes a fresh Number, so state written to this is discarded. Strict throws TypeError on the write."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01_the_three_methods_call_apply_bind", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_explicit_binding", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/05-call-apply-bind/01-the-three-methods.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_05_call_apply_bind_01