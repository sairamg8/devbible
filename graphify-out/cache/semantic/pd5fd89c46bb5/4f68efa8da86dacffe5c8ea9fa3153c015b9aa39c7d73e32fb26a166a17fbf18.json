{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_transactional_outbox", "label": "Transactional outbox", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You cannot write to a database and a queue atomically. Write the event in the same transaction as the business row, then publish separately."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_dual_write", "label": "Dual-write bug", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Save-then-enqueue has no spanning transaction. Measured: orders=1 | jobs enqueued=0 when Redis was down."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_outbox_relay", "label": "Outbox relay", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate process claims unpublished rows and publishes them. At-least-once: can publish then crash before setting published_at."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_skip_locked", "label": "FOR UPDATE SKIP LOCKED", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Competing relays must not claim the same row. Measured 3 workers / 20 jobs: 20 unique claims, 94ms vs 189ms serialised."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_at_least_once", "label": "At-least-once delivery", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishing to the broker and marking published_at are two systems. Exactly-once delivery does not exist; exactly-once effect does."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_idempotent_consumer", "label": "Idempotent consumer", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique idempotency key plus ON CONFLICT DO NOTHING; rowCount=0 means already handled."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_partial_unpublished_index", "label": "Partial index on unpublished rows", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_listen_notify_hint", "label": "LISTEN/NOTIFY as wake hint", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOTIFY is at-most-once; keep the poll as backstop. The table is the source of truth."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_transactional_outbox", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_dual_write", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_transactional_outbox", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_outbox_relay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_outbox_relay", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_skip_locked", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_outbox_relay", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_at_least_once", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/transactional-outbox.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_at_least_once", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_transactional_outbox_idempotent_consumer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/ph