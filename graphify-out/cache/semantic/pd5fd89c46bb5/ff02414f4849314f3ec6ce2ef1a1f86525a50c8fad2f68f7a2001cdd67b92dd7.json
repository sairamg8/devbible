{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_this_call_time_binding", "label": "this is bound at call time", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a property of the function. Behaves like a hidden first parameter the call site fills in."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "label": "Four this binding rules", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new, then explicit call/apply/bind, then implicit obj.fn(), then default. Arrows are outside the tree."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_default_binding", "label": "Default this binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bare fn() is undefined in strict and globalThis in sloppy. Strict turns a silent global write into TypeError."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_implicit_binding", "label": "Implicit this binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "obj.fn() binds this to whatever is left of the last dot. nested.inner.read() binds inner, not nested."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_explicit_binding", "label": "Explicit this binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "call and apply invoke immediately; bind returns a new function with this fixed forever."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_new_binding", "label": "new this binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh object, prototype linked to Fn.prototype, this bound, returned unless the constructor returns an object. A returned primitive is ignored."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_this_precedence", "label": "this precedence", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new beats bind beats call/apply beats implicit beats default. new on a bound function discards bound this but keeps bound arguments."}, {"id": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_module_toplevel_this", "label": "Module top-level this", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES module top-level this is undefined. CommonJS top-level this is module.exports. Use globalThis for the global object."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_new_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_explicit_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_implicit_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_default_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_this_precedence", "target": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_four_this_binding_rules", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/03-this/01-the-four-rules.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_03_this_01_the_four_rules_this_precedence", "target": "docs_javascript_page