{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth_oidc", "label": "OAuth 2.0 and OIDC", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth2", "label": "OAuth 2.0", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegated authorization. Issues an access token so an application can act on the user's behalf. Says nothing reliable about who the user is."}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oidc", "label": "OpenID Connect", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication layered on OAuth. ID token is a JWT with sub, iss, aud, exp addressed to your client. Sign in with Google is OIDC."}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_authorization_code_pkce", "label": "Authorization Code with PKCE", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only flow to use for web, SPA, and mobile. PKCE binds the code to the starter so an intercepted code is useless without the verifier. Implicit and ROPC are deprecated."}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_confused_deputy", "label": "Access token as identity (confused deputy)", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An access token is a bearer credential for an API, not addressed to you. A token from another app may still call /userinfo. Validate an ID token whose aud is your client id."}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_state_parameter", "label": "OAuth state parameter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSRF defence for the callback. Without it an attacker feeds you their authorization code and links their provider account to the victim's session."}, {"id": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_iss_sub_link", "label": "(iss, sub) account link", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sub is unique only within an issuer; email is mutable and can be reassigned. After OIDC, mint your own session rather than depending on provider tokens."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth_oidc", "target": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth_oidc", "target": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oidc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/06-oauth-oidc.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oidc", "target": "docs_nodejs_pages_phase_8_security_06_oauth_oidc_oauth2", "relation": "conceptually_re