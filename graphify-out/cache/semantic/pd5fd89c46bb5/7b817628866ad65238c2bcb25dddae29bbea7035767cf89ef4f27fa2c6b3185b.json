{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_state_that_belongs_elsewhere_state_that_belongs_elsewhere", "label": "State that belongs elsewhere", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/state-that-belongs-elsewhere.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_state_that_belongs_elsewhere_notify_in_handler", "label": "Notify the parent in the same event", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/state-that-belongs-elsewhere.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Effect calling onChange(isOn) runs too late and costs two renders. Calling setIsOn and onChange in the same handler batches into one."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_state_that_belongs_elsewhere_lift_state_up", "label": "Lift state up instead of copying it", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/state-that-belongs-elsewhere.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If two components need the same value, the question is which one should own it, not how to copy it with an Effect."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_state_that_belongs_elsewhere_lift_state_up", "target": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_state_that_belongs_elsewhere_notify_in_handler", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/state-that-belongs-elsewhere.html", "source_location": null, "weight": 1.0}], "hyperedges": []}