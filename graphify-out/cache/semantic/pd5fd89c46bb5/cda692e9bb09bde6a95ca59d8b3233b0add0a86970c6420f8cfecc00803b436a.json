{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_and_fan_out", "label": "The LEFT JOIN trap and fan-out", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LEFT JOIN invents a row for every unmatched left row. count(*) counts it. Eve is reported as having one order."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_count_star_trap", "label": "LEFT JOIN count(*) trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never count(*) inside a LEFT JOIN. Count a NOT NULL column of the right table \u2014 its PK. count(o.total) under-counts real orders that are unpriced. HAVING count(*) > 0 matches everyone."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_fan_out_inflates_sum", "label": "Join fan-out inflates sum", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order 10 has two items, so its 100 is added twice. Measured 650 against true 550. Two child joins multiply."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_sum_distinct_not_a_fix", "label": "sum(DISTINCT) is not a fan-out fix", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It de-duplicates values, not rows. Two different 200s collapse. Measured 350 \u2014 a third wrong answer. There is no DISTINCT-shaped fix for sum."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_lateral_preaggregation", "label": "LATERAL pre-aggregation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregate the child before joining so no duplication reaches parent columns. Measured 6 orders, 550 revenue, 5 item rows. LEFT JOIN LATERAL \u2026 ON true keeps childless parents."}, {"id": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_count_distinct_survives_fanout", "label": "count(DISTINCT) survives fan-out", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "De-duplicating ids is idempotent under row duplication; addition is not. Diagnose fan-out by comparing count(*) to count(DISTINCT parent pk)."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_and_fan_out", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_count_star_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_count_star_trap", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_01_three_questions_three_count_forms", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_fan_out_inflates_sum", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_sum_distinct_not_a_fix", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_lateral_preaggregation", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_fan_out_inflates_sum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_count_distinct_survives_fanout", "target": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_fan_out_inflates_sum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/02-count-variants/02-left-join-and-fan-out.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_02_count_variants_02_left_join_and_fan_out_left_join_and_fan_out", "target": "docs_postgresql_pages_phase_6_aggregation_01_group_by_02_empty_groups_and_keys_sum_empty_null", "relation": "reference