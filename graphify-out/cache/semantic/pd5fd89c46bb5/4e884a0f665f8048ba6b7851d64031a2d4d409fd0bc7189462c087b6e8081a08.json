{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_phase_7", "label": "Phase 7 Background work and resilience", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_skip_locked_queue", "label": "FOR UPDATE SKIP LOCKED job queue", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 jobs, 3 workers, 20 unique claims and no double delivery."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_transactional_outbox", "label": "Transactional outbox", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The order committed and nothing was ever enqueued. One transaction fixes it."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_job_idempotency", "label": "Job idempotency", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run twice: 2 emails, or 1 and a rowCount of 0."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_backoff_and_jitter", "label": "Backoff and jitter", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without jitter all 500 clients retried in one 100 ms bucket."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_backgr