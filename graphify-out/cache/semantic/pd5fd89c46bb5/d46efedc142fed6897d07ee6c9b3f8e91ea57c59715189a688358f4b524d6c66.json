{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_subqueries", "label": "Subqueries", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A subquery is a query used as a value, a set, or a table. Which of those three it is decides row cardinality, how often it runs, and whether a NULL in a negated set form empties the result."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_scalar_subquery", "label": "Scalar subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns exactly 1 row \u00d7 1 column. Runs once if uncorrelated. Error 21000 if more than one row, often only in production."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_set_subquery", "label": "Set subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used with IN / ANY / EXISTS. Any number of rows. Runs once as a semi join when uncorrelated."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_table_subquery", "label": "Table subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears in FROM; alias required. Any rows \u00d7 any columns. Runs once if uncorrelated."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_correlated_subquery", "label": "Correlated subquery", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reference to an outer column makes any of the three kinds correlated and changes the cost class entirely \u2014 SubPlan loops per outer row, an N+1 inside one statement."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_not_in_vs_not_exists", "label": "NOT IN versus NOT EXISTS", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three spellings of one membership question. Negated IN returns nothing when a NULL appears, because of three-valued logic. NOT EXISTS does not have that trap."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_subqueries", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_scalar_subquery", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_subqueries", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_set_subquery", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_subqueries", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_table_subquery", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_correlated_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_subqueries", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_not_in_vs_not_exists", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_set_subquery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/README.md", "source_location": null, "weight": 1.0}], "hyperedges": []}