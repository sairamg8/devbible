{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_page", "label": "JSON.parse and the reviver", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_syntaxerror", "label": "JSON.parse SyntaxError", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trailing commas, single quotes and empty bodies throw. JSON is stricter than object-literal syntax."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_reviver_return_value", "label": "Reviver must return value", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returning undefined deletes the property. Doing so for the root deletes the entire result."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_innermost_first", "label": "Reviver is innermost-first", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth-first: children are transformed before parents. Root is called last with key \"\"."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_revive_dates", "label": "Reviving Date from JSON", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match ISO strings or key.endsWith(\"At\"). A loose pattern turns version strings into dates."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_context_source", "label": "reviver context.source", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "value is already a double past MAX_SAFE_INTEGER. context.source is the original text, only for primitives."}, {"id": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_no_prototype_pollution", "label": "JSON.parse is not prototype pollution", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"__proto__\" is an ordinary own property in JSON. Pollution happens later if a merge assigns through that key."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_page", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/09-json/02-parse-and-the-reviver.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_09_json_02_parse_and_the_reviver_revive_dates", "target": "docs_javascript_pages_phase_5_built_in_library_09_json_01_stringify_date_tojson", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confide