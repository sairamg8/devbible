{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_etag", "label": "ETag", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/07-etag-and-cache.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conditional requests avoid useless transfers. Express can generate weak ETags; for APIs, explicit version fields or hashes are often clearer."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_if_none_match", "label": "If-None-Match 304", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/07-etag-and-cache.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If-None-Match matching the current ETag yields 304 Not Modified when the client already has the current representation."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_if_match", "label": "If-Match lost-update 412", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/07-etag-and-cache.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If-Match: v2 \u2192 412 if current is v3. Detects lost updates."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_private_nostore", "label": "Cache-Control private no-store", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/07-etag-and-cache.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authenticated JSON is usually Cache-Control: private, no-store. Public catalog may use public, max-age carefully. Static hashed assets use long max-age + immutable."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_etag", "target": "docs_expressjs_pages_phase_6_rest_surface_07_e