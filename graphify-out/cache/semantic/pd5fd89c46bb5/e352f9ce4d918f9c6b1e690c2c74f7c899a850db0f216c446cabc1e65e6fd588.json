{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox", "label": "The transactional outbox", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_dual_write", "label": "Dual write bug", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No transaction spans database and queue. Measured: order committed, enqueue failed, jobs = 0. Reversing order just moves the failure."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_table", "label": "Outbox table in the same transaction", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business row and event row commit or neither does. Partial index on published_at IS NULL keeps the relay query small."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_skip_locked", "label": "SKIP LOCKED relay claim", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three workers, 20 rows: 20 unique claims, 94 ms. Without SKIP LOCKED: 189 ms serialised behind one row."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_at_least_once", "label": "Outbox is at-least-once", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relay can publish then crash before setting published_at. Exactly-once effect needs an idempotent consumer."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_idempotent_consumer", "label": "Idempotent consumer ON CONFLICT DO NOTHING", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique idempotency key; rowCount 0 means already handled. Naive job sent 2 emails, idempotent sent 1."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox", "target": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_table", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_dual_write", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_skip_locked", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_table", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_at_least_once", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox_idempotent_consumer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox", "target": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify_at_most_once", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/18-transactional-outbox.md", "source_location": null, "weight": 1.0}], "hyperedges": []}