{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "label": "Mocking \u2014 mock.fn, mock.method and timers", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in mocking. t.mock auto-restores; the top-level mock leaks. Verified Node 24.19.0."}, {"id": "docs_nodejs_pages_phase_9_testing_07_mocking_t_mock", "label": "t.mock vs top-level mock", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level mock.method stayed fake in the next test. Use t.mock, or mock.restoreAll() in afterEach."}, {"id": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_fn", "label": "mock.fn", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records callCount and calls[].arguments/result/error/this/target. mockImplementationOnce varies per call. resetCalls clears history; restore puts the original back."}, {"id": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_method", "label": "mock.method spy vs stub", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two args spies (original runs); a third stubs. Zero recorded calls usually means the code captured the original reference before the mock."}, {"id": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_timers", "label": "mock.timers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enable only the APIs needed; tick one ms before the boundary then over it. Do not mix fake time with real I/O. Pass now when faking Date."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_07_mocking_t_mock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_fn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_07_mocking_mock_timers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_06_async_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/07-mocking.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_07_mocking_page", "target": "docs_nodejs_pages_phase_9_testing_05_api_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_