{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_08_on_using_natural", "label": "ON vs USING vs NATURAL", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/08-on-using-natural.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_08_on_using_natural_on", "label": "JOIN ON explicit condition", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/08-on-using-natural.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_08_on_using_natural_using", "label": "USING merged join column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/08-on-using-natural.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires identical names. SELECT * emits one merged column. On outer joins that column is coalesced."}, {"id": "docs_postgresql_pages_phase_5_joins_08_on_using_natural_natural", "label": "NATURAL JOIN infers from schema", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/08-on-using-natural.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared created_at silently cut two rows to one. No shared names degenerates to a cross join. Do not write NATURAL JOIN."}, {"id": "docs_postgresql_pages_phase_5_joins_08_on_using_natural_select_star_collapse", "label": "pg SELECT * duplicate names last-wins", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/08-on-using-natural.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server sent six columns; JS object had four keys. Alias columns or use rowMode array."}, {"id": "docs_postgresql_pages_pha