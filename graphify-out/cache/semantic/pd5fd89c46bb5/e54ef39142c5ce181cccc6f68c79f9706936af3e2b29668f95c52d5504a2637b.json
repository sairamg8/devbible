{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_writing_and_mutation_write_shadows", "label": "Writes create own properties", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/writing-and-mutation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads walk the chain; assignment does not. Inherited setters intercept the write; inherited read-only throws in strict mode. Inherited defaults work because assignment shadows."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_writing_and_mutation_shared_mutable", "label": "Shared mutable prototype state", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/writing-and-mutation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fn.prototype.items = [] is one array. push mutates after a read, so no shadow is created and every instance sees the change. Put mutable values on the instance (class field or constructor)."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_writing_and_mutation_setprototypeof", "label": "Object.setPrototypeOf", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/the-prototype-chain/writing-and-mutation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engines specialise access on the creation-time chain; changing it de-optimises compiled code. Prefer {__proto__: proto} or Object.create at creation. Deep chains tax every miss."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_the_prototype_chain_writing_and_mutation_