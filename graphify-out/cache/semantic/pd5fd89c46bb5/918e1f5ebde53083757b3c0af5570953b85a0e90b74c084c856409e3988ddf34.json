{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_order_by_parameter_noop", "label": "ORDER BY $1 is a silent no-op", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The parameter binds as a constant string, so every row sorts by the same value. Sorting by name and price returned byte-identical output and no error. ORDER BY 1 is a column index; $1 is not."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_concatenated_identifier_injection", "label": "Concatenated ORDER BY drops the table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "?sort=name; DROP TABLE fs_items CASCADE; -- executed as two statements. The same payload as $1 left the table intact."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_simple_query_protocol", "label": "Simple query protocol stacked statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "query() with no parameter array uses the simple protocol, which permits multiple statements separated by ;. pg reported 2 statements executed."}, {"id": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_value_vs_identifier", "label": "The payload is not the problem \u2014 the position is", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A value can always be a parameter and is then inert. An identifier can never be a parameter, so concatenation is the only way to vary it \u2014 which is why it needs an allowlist."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_order_by_parameter_noop", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_value_vs_identifier", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_concatenated_identifier_injection", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_simple_query_protocol", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_value_vs_identifier", "target": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_concatenated_identifier_injection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-two-failure-modes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_04_allowlists_01_two_failure_modes_concatenated_identifier_injection", "target": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_parameter_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/04-allowlists/01-t