{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_range_offset", "label": "RANGE value offset", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures the frame in ORDER BY units, so a missing day narrows the window rather than silently widening it. Only correct frame over a sparse series. Exactly one ORDER BY column (42P20). Type must support subtraction (0A000 on text). '6 days' PRECEDING AND CURRENT ROW is 7 inclusive days."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_groups_frame", "label": "GROUPS frame", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts distinct ordering values present in the data. Previous two trading days, not last 48 hours. Accepts multi-column ORDER BY \u2014 workaround when 42P20 blocks a RANGE offset. Agrees with RANGE on a dense series; diverges on gaps."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_current_row", "label": "EXCLUDE CURRENT ROW", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes this row from the frame. Leave-one-out: others = 210 minus own amount. Shape for compare-to-the-rest."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_group", "label": "EXCLUDE GROUP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes this row and its peers. Compare this day against all other days. GROUP = TIES + CURRENT ROW."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_ties", "label": "EXCLUDE TIES", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes peers but keeps the current row. Only option that keeps this row while dropping equals. For a row with one peer: 6\u21925 versus GROUP 6\u21924; alone: TIES removes nothing."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_no_others", "label": "EXCLUDE NO OTHERS", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default EXCLUDE. Writing it changes nothing; exists to make the default explicit."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_error_42p20", "label": "42P20 RANGE offset one ORDER BY column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RANGE with offset PRECEDING/FOLLOWING requires exactly one ORDER BY column. Collides with the unique-tiebreaker advice. Drop the tiebreaker or use GROUPS."}, {"id": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_error_0a000", "label": "0A000 RANGE offset unsupported type", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RANGE offset is not supported for text \u2014 no defined subtraction. Hits when ordering by a formatted date string instead of the date."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_range_offset", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_range_frame", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_error_42p20", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_range_offset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_error_0a000", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_range_offset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_groups_frame", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_range_offset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_group", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_ties", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_group", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_current_row", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_no_others", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_readme_window_frames", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_14_frames_02_range_groups_exclude_exclude_group", "target": "docs_postgresql_pages_phase_6_aggregation_14_frames_01_rows_vs_range_window_peers", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/14-frames/02-range-groups-exclude.md", "source_location": null, "weight": 1.0}], "hyperedges": []}