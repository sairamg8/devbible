{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_inversion_of_control_inversion_of_control", "label": "Inversion of control", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/inversion-of-control.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You hand the rest of your program to someone else's function. They decide when, how often, and with what arguments it runs. Failures are silent."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_inversion_of_control_callback_trust_table", "label": "Callback trust-table failures", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/inversion-of-control.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Too early (Zalgo), too late, never, twice, wrong arguments, swallowed throw. None produce an exception."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_inversion_of_control_once_wrapper", "label": "once wrapper", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/inversion-of-control.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A called flag that ignores a second invocation. Exactly what a promise provides structurally by settling once."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_callbacks_inversion_of_control_promise_three_guarantees", "label": "MDN three promise guarantees", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/callbacks/inversion-of-control.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invoked before the current event-loop run completes; invo