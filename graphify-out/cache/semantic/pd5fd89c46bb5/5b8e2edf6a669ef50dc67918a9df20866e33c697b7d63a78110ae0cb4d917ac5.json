{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_12_native_node_api_n_api", "label": "Node-API (N-API)", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/node-api.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable C ABI for native addons so a binary can survive Node major upgrades better than NAN/V8-bound addons."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_node_api_node_addon_api", "label": "node-addon-api", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/node-api.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C++ wrappers over Node-API (types, maybe-unwrap) that make addon code less error-prone."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_node_api_process_versions_napi", "label": "process.versions.napi", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/node-api.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports the Node-API version of the runtime; Node 24.19.0 reports 10."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_node_api_prebuilds", "label": "Native addon prebuilds", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/node-api.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship per-platform binaries (prebuildify/prebuild) so users and CI do not need a compiler."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_node_api_stable_abi", "label": "Node-API sits between C++ and V8", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/node-api.html", "source_location": null, "source_url": null, "captured_at": null, "autho