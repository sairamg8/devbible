{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_object_fromentries", "label": "Object.fromEntries", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transforms any iterable of key-value pairs into a plain object. Reverse of Object.entries. Does not use this; always a plain object."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_entries_map_fromentries", "label": "entries \u2192 map/filter \u2192 fromEntries", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objects have no map or filter. Convert to pairs, use array methods, convert back. A pick built this way is safer than delete."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_map_object_bridge", "label": "Map \u2194 Object conversion", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object.fromEntries(map) and new Map(Object.entries(obj)). The bridge into real insertion order and non-string keys."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_urlsearchparams_lossy", "label": "URLSearchParams to object is lossy", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated keys cannot live on an object. tag=a&tag=b becomes {tag:'b'}. Use getAll or keep URLSearchParams."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_roundtrip_losses", "label": "entries/fromEntries round-trip losses", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops symbols, non-enumerables, inherited, prototype, accessors (getters invoked), descriptors, and numeric key order. Shallow."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_page", "label": "08.2 \u00b7 Transforming objects", "file_type": "document", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_page", "target": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_object_fromentries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/08-keys-values-entries/02-transforming-objects.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_page", "target": "docs_javascript_pages_phase_4_objects_and_classes_08_keys_values_entries_02_transforming_objects_entries_map_fromentries", "relation": "references", "confidence": "EXTRACTED", "confi