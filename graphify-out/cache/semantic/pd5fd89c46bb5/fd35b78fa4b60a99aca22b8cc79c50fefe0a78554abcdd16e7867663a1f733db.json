{"nodes": [{"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this", "label": "Anatomy, state and this", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_not_deprecated", "label": "Class components still supported", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not recommended for new code and receive no new features. Not scheduled for removal. Read them; do not write them except error boundaries."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_setstate_merges", "label": "setState merges useState replaces", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Porting a state object wholesale to useState silently drops unrespread fields. The classic conversion bug."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_this_binding", "label": "this binding in class handlers", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracting this.handleClick loses the receiver. Class bodies are strict so this is undefined. Prefer a class-field arrow; call-site arrows defeat PureComponent."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_string_refs_removed", "label": "String refs removed in React 19", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_legacy_context_removed", "label": "Legacy context removed in React 19", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "contextTypes and getChildContext are gone. A class consumes one context via static contextType."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_defaultprops", "label": "Class defaultProps survives", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept because there is no ES6 default-parameter equivalent for a class."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_force_update", "label": "forceUpdate", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces a re-render without a state change. Almost always means state is kept somewhere React cannot see."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_error_boundaries", "label": "Error boundaries stay classes", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The conversion that cannot be done. A hook cannot implement an error boundary."}, {"id": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_instance_to_useref", "label": "Class instance fields become useRef", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer ids, sockets and caches persist without triggering a render. useState would re-render on every assignment."}], "edges": [{"source": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this", "target": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_not_deprecated", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_setstate_merges", "target": "docs_react_pages_phase_2_components_15_purecomponent_mutation_exclusive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_14_class_components_01_anatomy_and_this_this_binding", "target": "docs_react_pages_phase_2_components_12_render_props_inline_defeats_memo", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/react/pages/phase-2-components/14-class-components/01-anatomy-and-this.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_14_class_components_01