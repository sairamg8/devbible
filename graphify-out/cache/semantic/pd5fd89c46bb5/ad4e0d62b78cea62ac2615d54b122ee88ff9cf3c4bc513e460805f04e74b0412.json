{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_testing_real_pg", "label": "Testing against a real PostgreSQL", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_per_test_rollback", "label": "Per-test transaction rollback", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN in beforeEach, ROLLBACK in afterEach. 1.66 ms vs 42.50 ms truncate-and-reseed (25\u00d7). Parallel-safe because nothing is committed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_sequences_not_transactional", "label": "Sequences are not transactional", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rolled-back insert still consumed an id (last_value 2002 \u2192 2003). Never assert on a literal id."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_pool_invisible_fixture", "label": "Pool cannot see the test fixture", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncommitted data is invisible to other connections. Test client saw 1 row; pool saw 0. The harness enforces the executor contract."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_savepoint_remap", "label": "Remap BEGIN/COMMIT to savepoints in tests", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL has no nested transactions. An inner COMMIT ends the test transaction; 1 row leaked. After remapping, 0 rows survived."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_pool_invisible_fixture", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_repository_the_executor_contract_executor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_savepoint_remap", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_savepoints_and_duration_savepoint", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_testing_real_pg_per_test_rollback", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_transactions_request_the_wrapper_with_transaction", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/testing-real-pg.html", "source_location": null, "weight": 1.0}], "hyperedges": []}