{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_type_coercion_page", "label": "08 \u00b7 Type coercion", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/type-coercion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_type_coercion_toprimitive", "label": "ToPrimitive", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/type-coercion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_type_coercion_tonumber", "label": "ToNumber", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/type-coercion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null becomes 0; undefined becomes NaN. A missing value fails loudly; a null price silently becomes free."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_type_coercion_plus_concatenation", "label": "+ concatenation vs arithmetic", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/type-coercion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If either operand of + is a string after ToPrimitive, + concatenates. -, *, / and % always ToNumber both sides."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_type_coercion_block_plus_array", "label": "{} + [] parse vs coerce", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/type-coercion.html", "source_location": null, "source_url": null, "c