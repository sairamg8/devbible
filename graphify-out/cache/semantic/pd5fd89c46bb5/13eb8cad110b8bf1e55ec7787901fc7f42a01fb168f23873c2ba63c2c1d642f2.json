{"nodes": [{"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_page", "label": "Status and headers", "file_type": "document", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_status_contract", "label": "HTTP status as contract", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Useful APIs pick 201/204/400/401/403/404/409 deliberately \u2014 not always 200. Align with OpenAPI and stick to it."}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_headers_before_body", "label": "Headers fixed once body starts", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "res.set, res.type, and res.vary are only meaningful before the first write. res.headersSent flips once headers go out."}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_express5_status_range", "label": "Express 5 status 100\u2013999", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express 5 restricts res.status() to 100\u2013999 and rejects anything outside that range. An Express 4 habit of passing a made-up code now throws."}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_status_204", "label": "204 No Content", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Success with no response body (e.g. DELETE). Use res.status(204).end()."}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_401_vs_403", "label": "401 vs 403", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "401 unauthenticated; 403 authenticated but not allowed."}, {"id": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_rpc_over_http", "label": "Always-200 RPC-over-HTTP", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always HTTP 200 with {success:false} is an RPC-over-HTTP habit. Use real statuses; keep error body for details."}], "edges": [{"source": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_page", "target": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_status_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_page", "target": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_headers_before_body", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/02-status-and-headers.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_02_status_and_headers_headers_before_body", "target": "docs_expressjs_pages_phase_2_middleware_03_next_semantics_headers_sent", "relation": "conceptuall