{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba", "label": "pg_hba.conf", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs before privileges exist. First matching rule only; if its method fails the connection fails \u2014 no fall-through."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_first_match_wins", "label": "First matching HBA rule wins", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A broad rule near the top makes every rule below it dead. Order specific before general."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_scram_sha_256", "label": "scram-sha-256", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default password method. A scram rule cannot authenticate an md5-stored password; the reverse works."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_trust_method", "label": "trust authentication", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not check the password. Measured: a deliberately wrong password connected. POSTGRES_HOST_AUTH_METHOD=trust replaces the image's scram line."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba_file_rules", "label": "pg_hba_file_rules", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsed view with evaluation order. A syntax error survives reload (old rules stay); a restart turns it into an outage."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_hba_error_messages", "label": "HBA failure messages", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "no entry = no match; rejects connection = reject method; password failed covers wrong password, missing role, and expired VALID UNTIL."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_first_match_wins", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_scram_sha_256", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_trust_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/pg-hba.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pg_hba_pg_hba_file_rules", "relation": "references", "confidence": "E