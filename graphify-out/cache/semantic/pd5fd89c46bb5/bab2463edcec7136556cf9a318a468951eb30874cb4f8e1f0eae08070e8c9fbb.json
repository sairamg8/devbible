{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_model", "label": "A commit is a snapshot, not a diff", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model is snapshots; the storage uses deltas. Confusing the two makes packfiles sound like they contradict the snapshot claim."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_commit_contents", "label": "Commit object contents", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tree, zero or more parents, author, committer, message. No file contents and no diff."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_not_expensive", "label": "Unchanged files reuse existing blobs", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Change one file in 10 000: one new blob, one new tree per directory on the path, one commit. Every other entry is a pointer."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_diffs_are_derived", "label": "Diffs are derived output", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git never recorded what you did, only what things became. A rename is inferred; git diff output depends on myers, histogram, or patience."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_model", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_what_git_is_content_addressed_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_commit_contents", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_commit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_not_expensive", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_diffs_are_derived", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_is_a_snapshot_snapshot_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-is-a-snapshot.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "git_storage_layers", "label": "Snapshot model with content addressing and packfile deltas", "nodes": ["build_css_p2_docs_git_p