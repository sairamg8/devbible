{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_not_index_arbitrated", "label": "MERGE is not index-arbitrated", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge/vs-on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ON CONFLICT uses a unique index as arbiter. Concurrent MERGE can both take NOT MATCHED and raise 23505 or insert duplicates."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_source_duplicate_21000", "label": "MERGE 21000 source duplicate", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge/vs-on-conflict.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two source rows matching one target raise 21000. Deduplicate with DISTINCT ON before merging."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_not_index_arbitrated", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_three_actions_merge", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge/vs-on-conflict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_source_duplicate_21000", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_three_actions_merge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/merge/vs-on-conflict.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_not_index_arbitrated", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_returning