{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_string_methods_trimming_padding_replacing_trim", "label": "String trim family", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/string-methods/trimming-padding-replacing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trim/trimStart/trimEnd remove whitespace only; no trim(char). Use at the input boundary."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_string_methods_trimming_padding_replacing_padstart", "label": "padStart target length", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/string-methods/trimming-padding-replacing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First arg is total length, not pad count. Never truncates. Multi-char pads repeat then cut."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_string_methods_trimming_padding_replacing_replace", "label": "String.prototype.replace", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/string-methods/trimming-padding-replacing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a string pattern replaces only the first match."}, {"id": "build_css_p2_docs_javascript_pages_phase_5_built_in_library_string_methods_trimming_padding_replacing_replaceall", "label": "String.prototype.replaceAll", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-5-built-in-library/string-methods/trimming-padding-replacing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces all. Regex must be global or TypeError. String pa