{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_exhaustion_and_sizing", "label": "Exhaustion and sizing", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_query_wait_timeout", "label": "query_wait_timeout", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 120 s. With pool size 5, two extra clients holding BEGIN waited 120204 ms then 08P01. Upstream timeouts fire first, so the symptom is the service hanging."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_idle_in_transaction_exhaustion", "label": "Idle-in-transaction pool exhaustion", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In transaction pooling the backend is held for the whole transaction. Five open transactions filled a pool of 5. Set idle_in_transaction_session_timeout and statement_timeout; both default to 0 (disabled)."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_small_pool_faster", "label": "A smaller pool is usually faster", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past cores \u00d7 2, extra backends add contention not throughput. Size default_pool_size small and query_wait_timeout short, or neither. Large max_client_conn, small default_pool_size."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_max_client_conn", "label": "max_client_conn vs default_pool_size", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "max_client_conn (default 100) bounds cheap connections to PgBouncer. default_pool_size (default 20) bounds expensive backends per user/database pair."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_query_wait_timeout", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_idle_in_transaction_exhaustion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_idle_in_transaction_exhaustion", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_transaction_pooling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_small_pool_faster", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_max_client_conn", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_idle_in_transaction_exhaustion", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_idle_in_transaction", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_03_exhaustion_and_sizing_exhaustion_and_sizing", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_04_node_and_observing_node_and_observing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/03-exhaustion-and-sizing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}