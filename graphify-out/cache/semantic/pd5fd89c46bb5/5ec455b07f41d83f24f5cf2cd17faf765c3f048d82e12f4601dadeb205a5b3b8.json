{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_focus_visible", "label": ":focus vs :focus-visible", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":focus matches any focus including mouse click; :focus-visible is the keyboard/AT ring so outline:none on :focus is no longer needed."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_focus_within", "label": ":focus-within", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent selector for focus containment that predates :has(); highlight a field or keep a menu open."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_lvha", "label": "LVHA link order", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equal-specificity link states must be :link :visited :hover :active or visited links lose hover."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_visited", "label": ":visited privacy restrictions", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only colour properties apply and getComputedStyle lies, so sites cannot leak browsing history."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_target", "label": ":target", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches the element whose id equals the URL fragment; can drive tabs without JS at the cost of history entries."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_disabled", "label": ":disabled vs aria-disabled", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "disabled removes the control from tab order and the accessibility tree; aria-disabled keeps it announceable."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_focus_visible", "target": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_focus_within", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_lvha", "target": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_visited", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_state_pseudo_classes_focus_within", "target": "build_css_p2_docs_css_syllabus_how_css_works_has", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/state-pseudo-classes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_