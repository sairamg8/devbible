{"nodes": [{"id": "docs_expressjs_pages_phase_1_routing_01_http_methods_route_method_plus_path", "label": "Route is method + path", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/01-http-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register the methods you mean. Path match is not enough. Helpers: get, post, put, patch, delete, all, plus use."}, {"id": "docs_expressjs_pages_phase_1_routing_01_http_methods_method_mismatch_404", "label": "Wrong method is 404 not 405", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/01-http-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express has no built-in 405 or Allow header. FAQ: 404 is not an error \u2014 all middleware and routes ran and none responded. Implement 405 yourself for strict APIs."}, {"id": "docs_expressjs_pages_phase_1_routing_01_http_methods_app_all", "label": "app.all", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/01-http-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches all HTTP verbs, including QUERY. Convenient for CORS preflight experiments; hides method mistakes on public APIs."}, {"id": "docs_expressjs_pages_phase_1_routing_01_http_methods_head_via_get", "label": "app.get covers HEAD unless app.head registered first", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-1-routing/01-http-methods.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs caveat: app.get covers HEAD if app.head was not called for the path before app.get. Body is stripped."}], "edges": [{"source": "docs_expressjs_pages_phase_1_routing_01_http_methods_route_method_plus_path", "target": "docs_expressjs_pages_