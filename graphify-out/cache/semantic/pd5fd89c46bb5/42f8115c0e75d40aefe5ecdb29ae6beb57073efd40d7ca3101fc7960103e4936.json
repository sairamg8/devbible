{"nodes": [{"id": "docs_react_pages_phase_4_effects_08_race_conditions_race_conditions", "label": "Race conditions", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The screen shows the answer to a question the user has already moved on from. No error, no failed request \u2014 just the wrong data, sometimes."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_out_of_order_responses", "label": "Responses may arrive out of order", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most recent response is not the most recent request. Both succeed; the last arrival wins. Intermittent on slow or uneven networks."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_ignore_flag", "label": "ignore flag", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let ignore = false inside setup; cleanup sets it true. One flag per request. Fixes the render. Does not cancel the transfer."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_abortcontroller", "label": "AbortController", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops the request. Catch must ignore DOMException named AbortError. Only works with APIs that accept a signal."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_aborterror", "label": "AbortError is not a failure", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An aborted fetch rejects with AbortError. Treating every rejection as failure turns cancel into a visible error."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_neither_is_a_cache", "label": "Race guards are not a cache", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither ignore nor abort deduplicates, remembers a return visit, or starts the request earlier."}, {"id": "docs_react_pages_phase_4_effects_08_race_conditions_mdn_abortcontroller", "label": "MDN AbortController", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "source_url": "https://developer.mozilla.org/en-US/docs/Web/API/AbortController", "captured_at": "2026-08-14", "author": null, "contributor": null}], "edges": [{"source": "docs_react_pages_phase_4_effects_08_race_conditions_race_conditions", "target": "docs_react_pages_phase_4_effects_08_race_conditions_mdn_abortcontroller", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_08_race_conditions_out_of_order_responses", "target": "docs_react_pages_phase_4_effects_08_race_conditions_ignore_flag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/08-race-conditions.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_08_race_conditions_ignore_flag", "target": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_cleanup_then_setu