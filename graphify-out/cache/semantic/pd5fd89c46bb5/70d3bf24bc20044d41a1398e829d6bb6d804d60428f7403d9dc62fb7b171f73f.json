{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_page", "label": "01 \u00b7 Objects and nesting", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_treat_state_readonly", "label": "Treat objects in state as read-only", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutation does not merely skip a render \u2014 it retroactively corrupts every previous snapshot that captured the same object."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_two_mutation_failures", "label": "Two mutation failures", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutate without a setter: React is never asked. Mutate then set the same reference: Object.is bails out. The second looks correct."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_shallow_spread", "label": "Spread is shallow", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "{...person} copies the artwork reference. Mutating next.artwork.city still mutates the original. Copy every level on the path; share the rest."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_local_mutation_exception", "label": "Local mutation exception", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutating a freshly created object nothing else holds is fine. Only the object handed to the setter must be new."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_page", "target": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_treat_state_readonly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_two_mutation_failures", "target": "build_css_p2_docs_react_pages_phase_3_state_bailing_out_usestate_bailout", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_shallow_spread", "target": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_treat_state_readonly", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/immutable-updates/objects-and-nesting.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_immutable_updates_objects_and_nesting_local_mutation_exception", "target": "build_css_p2_docs_react_pa