{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_correlated_subquery", "label": "Correlated subquery", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "References an outer column, so it cannot be computed once. An N+1 written inside one statement: no round trips, same shape of work."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_subplan_loops", "label": "SubPlan loops per outer row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SubPlan plus loops=5000 is the diagnosis. Rewrite as GROUP BY plus LEFT JOIN unless the outer set is small by construction or the planner already un-correlated it."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_count_zero_sum_null", "label": "count() is 0, sum() is NULL over empty", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No rows, a zero total, and a NULL total collapse into two outputs. coalesce when the API wants a number. LEFT JOIN rewrite of count() needs coalesce(o.n, 0) to keep zeros."}, {"id": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_visibility_map_swing", "label": "Correlated cost coupled to visibility map", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best case 145 ms vs GROUP BY 65 ms (2.2\u00d7). After stale visibility map 414 ms vs 90 ms (4.6\u00d7); Heap Fetches 0 \u2192 133359. Do not benchmark on a freshly vacuumed table."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_correlated_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_subplan_loops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_correlated_subquery", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_count_zero_sum_null", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_visibility_map_swing", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_02_correlated_and_cost_subplan_loops", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/11-subqueries/02-correlated-and-cost.md", "source_location": null, "weight": 1.0}], "hyperedges": []}