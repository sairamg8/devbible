{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_shared_buffers", "label": "shared_buffers", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL's shared 8 KB page cache used by all backends. Alpine default measured at 128MB; production is tuned higher."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_os_page_cache", "label": "OS page cache", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kernel caches file pages the server read or wrote. A shared_buffers miss may still be fast if the OS cache is warm."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_pool_not_cache", "label": "Pooling does not replace shared buffers", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooling reuses backends; shared buffers cache data pages. Different layers. Too-large shared_buffers fights the OS cache."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_shared_buffers", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_os_page_cache", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_pool_not_cache", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_shared_buffers", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_pool_not_cache", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_node_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/shared-buffers.html", "source_location": null, "weight": 1.0}], "hyperedges": []}