{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_retry_safe_failures_two_questions", "label": "Retry only transient and safe", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/retry-safe-failures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both questions must be yes. A timeout is transient but retrying an unguarded POST /charge duplicates money."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_retry_safe_failures_timeout_is_unknown", "label": "Timeout is unknown not failure", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/retry-safe-failures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The request may have completed after you stopped waiting. The retry is a second execution."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_retry_safe_failures_single_layer_retry", "label": "Retry at one layer", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/retry-safe-failures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client \u00d7 service \u00d7 job attempts multiply (5\u00d75\u00d75=125). Pick the outermost layer that knows the operation."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_retry_safe_failures_throw_to_queue", "label": "Throw and let the queue retry", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/retry-safe-failures.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inner retry loop multiplies attempts and holds the worker slot while sleeping."}], "edges": [{"source": "build_css_p2_docs_nod