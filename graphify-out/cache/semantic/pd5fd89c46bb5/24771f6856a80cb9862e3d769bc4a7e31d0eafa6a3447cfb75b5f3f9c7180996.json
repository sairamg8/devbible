{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "label": "Error handling with async/await", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_11_error_handling_try_catch_await", "label": "try/catch with await", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rejected promise that you await throws at the await. If there is no await, there is no catch \u2014 the try finishes synchronously."}, {"id": "docs_nodejs_pages_phase_2_async_11_error_handling_catch_where_you_can_handle", "label": "Catch only what you can handle", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A giant try cannot say what failed. Recover, add context, or let the rest propagate to a boundary. Log-and-rethrow unchanged is usually noise."}, {"id": "docs_nodejs_pages_phase_2_async_11_error_handling_error_cause", "label": "error.cause", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "throw new HigherLevelError(msg, { cause: original }) keeps the root attached. Tooling prints the chain."}, {"id": "docs_nodejs_pages_phase_2_async_11_error_handling_catch_placement", "label": ".catch placement", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers everything upstream, nothing downstream. Mid-chain recovers and the chain continues fulfilled; end-of-chain is a safety net."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "target": "docs_nodejs_pages_phase_2_async_11_error_handling_try_catch_await", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_11_error_handling_catch_where_you_can_handle", "target": "docs_nodejs_pages_phase_2_async_11_error_handling_try_catch_await", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "target": "docs_nodejs_pages_phase_2_async_11_error_handling_error_cause", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "target": "docs_nodejs_pages_phase_2_async_11_error_handling_catch_placement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "target": "docs_nodejs_pages_phase_2_async_12_floating_promises_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/11-error-handling.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_11_error_handling_page", "target": "docs_nodejs_pages_phase_2_async_16_error_design_page", "relation": "ref