{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1", "label": "N+1 queries", "file_type": "document", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/n-plus-1.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1_query", "label": "N+1 query", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/n-plus-1.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One query for the list plus one per item. Cost is round trips, not query work \u2014 101 queries 111 ms vs 2 batched 7 ms on localhost. Promise.all makes pool exhaustion worse."}, {"id": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1_batch_any", "label": "Batch with ANY / $in", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/n-plus-1.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect parent ids, one child query with = ANY($1) or $in, group in memory. Works across services where a join is impossible. DataLoader is this per tick."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/n-plus-1.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1_batch_any", "target": "build_css_p2_docs_nodejs_pages_phase_6_data_access_n_plus_1_query", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-6-data-access/n-plus-