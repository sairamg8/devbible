{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_callbacks_and_promisify_error_first_callback", "label": "Error-first callback convention", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/callbacks-and-promisify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cb(err) or cb(null, value), exactly once, always asynchronously. The contract util.promisify depends on."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_callbacks_and_promisify_util_promisify", "label": "util.promisify", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/callbacks-and-promisify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps an error-first last-argument callback API into a promise. Prefer built-in fs/promises etc. when they exist."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_callbacks_and_promisify_promisify_custom", "label": "util.promisify.custom", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/callbacks-and-promisify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Author-supplied promise form checked first when the mechanical (err, value) translation is wrong."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_callbacks_and_promisify_new_promise_only_for_wrap", "label": "new Promise only to wrap callbacks", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/callbacks-and-promisify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one legitimate use of the Promise constructor is wrapping a callback or event API. Wrapping already-promise code is an antipattern."}], "edges": [{"source": "build_css_p2_docs_no