{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_if_not_exists", "label": "CREATE TABLE IF NOT EXISTS", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes a statement idempotent. Not concurrency-safe, not a migration, does not compare definitions. Three gaps the syntax hides."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_not_concurrency_safe", "label": "IF NOT EXISTS is not concurrency-safe", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog check and insert are not one atomic step. 228 of 500 concurrent attempts failed with 23505 on pg_type_typname_nsp_index."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_name_only_check", "label": "IF NOT EXISTS is a name check", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing CREATE to add a column is a silent no-op where the table exists. Migrations express change; IF NOT EXISTS expresses absence."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_add_column_if_not_exists", "label": "ADD COLUMN IF NOT EXISTS type trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches column name only. Existing integer vs expected text is a silent no-op. CREATE INDEX IF NOT EXISTS compares name, not definition."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_if_not_exists", "target": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_not_concurrency_safe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_name_only_check", "target": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_if_not_exists", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_if_not_exists", "target": "docs_postgresql_pages_phase_8_schema_from_node_02_migrations_migrations", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_add_column_if_not_exists", "target": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_name_only_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_07_if_not_exists_if_not_exists", "target": "docs_postgresql_pages_phase_8_schema_from_node_08_minimal_runner_minimal_runner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/07-if-not-exists.md", "source_location": null, "weight": 1.0}, {"source": "do