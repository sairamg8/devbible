{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_desugaring", "label": "What class desugars to", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wiring is identical: methods go on Ctor.prototype. class is sugar for prototype wiring and a genuine language feature for everything else."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_nonsugar_features", "label": "Five non-sugar class features", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always-strict body; TypeError without new; non-enumerable methods; TDZ and block scope; private elements with no desugaring."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_instance_field", "label": "Instance field versus prototype method", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A field is an own enumerable property per instance. A method is one shared non-enumerable function on Ctor.prototype. items = [] must be a field."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_arrow_function_field", "label": "Arrow-function class field", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own property per instance whose this is lexical. Survives being detached as a callback. Cost: one function per instance and it cannot be super-called."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_derived_field_init_order", "label": "Derived class field initialisation order", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base fields run at the start of the constructor. Derived fields run immediately before super() returns, so an overridden method called from the parent constructor sees them still undefined."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_desugaring", "target": "docs_javascript_pages_phase_4_objects_and_classes_05_the_prototype_chain_02_prototype_vs_the_slot_class_is_same_machinery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_nonsugar_features", "target": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_desugaring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/06-class/01-what-class-desugars-to.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_06_class_01_what_class_desugars_to_class_nonsugar_features", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_06_classes_and_circular_import