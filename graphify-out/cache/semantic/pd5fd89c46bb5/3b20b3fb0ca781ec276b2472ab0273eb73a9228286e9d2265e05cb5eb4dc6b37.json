{"nodes": [{"id": "docs_react_pages_phase_2_components_08_children_patterns_page", "label": "Children patterns", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/08-children-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_08_children_patterns_wrapper", "label": "Wrapper children pattern", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/08-children-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds markup or behaviour around arbitrary content and does not inspect children. Cheapest performance tool: the caller's element object is unchanged."}, {"id": "docs_react_pages_phase_2_components_08_children_patterns_layout_slots", "label": "Layout with named element props", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/08-children-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name the region, keep primary content in children, make slots optional. Do not slice children positionally."}, {"id": "docs_react_pages_phase_2_components_08_children_patterns_compound", "label": "Compound components via context", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/08-children-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent provides shared state; caller arranges parts freely. Context beats cloneElement because it ignores intervening structure."}, {"id": "docs_react_pages_phase_2_components_08_children_patterns_function_as_children", "label": "Function as children", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/08-children-patterns.md", "source_location": null, "source_url": null, "