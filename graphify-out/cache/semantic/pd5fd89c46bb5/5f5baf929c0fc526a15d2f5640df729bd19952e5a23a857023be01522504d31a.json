{"nodes": [{"id": "docs_expressjs_pages_phase_7_layering_01_controller_service_repository_csr", "label": "Controller service repository", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-7-layering/01-controller-service-repository.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controllers translate HTTP. Services own rules. Repositories own queries. Driver types do not leak upward. Express owns where the HTTP layer stops."}, {"id": "docs_expressjs_pages_phase_7_layering_01_controller_service_repository_controller", "label": "Controller layer", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-7-layering/01-controller-service-repository.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parse and validate input already on req, call the service, map status. Does not own SQL or business rules."}, {"id": "docs_expressjs_pages_phase_7_layering_01_controller_service_repository_service", "label": "Service layer", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-7-layering/01-controller-service-repository.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns invariants and orchestration. No res.json and no Express types so services stay testable without spinning an HTTP server."}, {"id": "docs_expressjs_pages_phase_7_layering_01_controller_service_repository_repository", "label": "Repository layer", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-7-layering/01-controller-service-repository.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queries and commands via drivers. Does not decide HTTP status. Node Phase 6 owns how repositories and transactions work."}], "edges": [{"source": "docs_expressjs_pages_phase_7_laye