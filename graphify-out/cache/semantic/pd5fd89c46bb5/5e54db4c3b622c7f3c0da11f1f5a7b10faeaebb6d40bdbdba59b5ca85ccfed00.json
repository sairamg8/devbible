{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_modern_small_reset", "label": "Modern small CSS reset", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/resets-and-normalisers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dozen justifiable lines beat a 300-line library: border-box on * plus pseudos, margin 0, line-height 1.5, block media, font inherit on controls, overflow-wrap."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_box_sizing_border_box", "label": "box-sizing: border-box", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/resets-and-normalisers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "width/height include padding and border. Applied to *, *::before, *::after so generated content is not left on content-box."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_reset_vs_normalise", "label": "Reset vs normalise vs nothing", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/resets-and-normalisers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalize.css patched 2012 engine differences that have largely converged. A small modern reset is the 2026 default; hard-resetting list-style or *:focus outline is a defect."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_modern_small_reset", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_resets_and_normalisers_box_sizing_border_box", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/resets-and-n