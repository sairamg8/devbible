{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_all", "label": "Promise.all", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles when all fulfil; rejects on first failure with that reason. Waiting primitive, not a concurrency limiter."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_allsettled", "label": "Promise.allSettled", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for every input; never rejects. Returns {status, value|reason} so partial success is inspectable."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_race", "label": "Promise.race", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles with the first to settle, success or failure. Used for timeouts; does not stop losers."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_promise_any", "label": "Promise.any", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles with the first fulfilment, ignoring rejections. All-reject throws AggregateError with .errors."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_combinators_no_cancellation", "label": "Combinators do not cancel losers", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/combinators.html", "source_locatio