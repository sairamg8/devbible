{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "label": "FileHandle", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "open() returns a handle owning an OS descriptor. Close in finally; GC does not reliably reclaim leaked fds."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_emfile", "label": "EMFILE", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-process fd limit. One leaked handle per request exhausts the budget; every later file and socket fails. Invisible on a high-ulimit laptop."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_wx_exclusive_create", "label": "'wx' exclusive create", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic create-if-absent; fails with EEXIST. How you build a lock file without a check-then-create race."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_fh_stat", "label": "FileHandle.stat", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stats the open descriptor, not the path, so it cannot race with a rename. Closes the Content-Length race."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_fh_sync", "label": "FileHandle.sync", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fsync \u2014 only way to know bytes reached disk rather than the page cache. Required before rename in the atomic-write pattern."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_emfile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_wx_exclusive_create", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_fh_stat", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_fh_sync", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_fh_stat", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_stat_and_existence_stat", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_handles_filehandle", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_fs_promises", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/file-handles.html", "source_location": null, "weight": 1.0}], "hyperedges": []}