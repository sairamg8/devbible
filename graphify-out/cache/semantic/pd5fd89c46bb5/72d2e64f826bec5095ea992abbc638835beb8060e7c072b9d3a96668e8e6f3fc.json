{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_07_package_json_package_json", "label": "package.json essentials", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/07-package-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The file that decides how code is parsed, what ships, and what runs. Six fields carry almost all of it."}, {"id": "docs_nodejs_pages_phase_1_modules_07_package_json_type_module", "label": "package.json type field", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/07-package-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides how every .js file in the package is parsed. Set it explicitly; module for new work."}, {"id": "docs_nodejs_pages_phase_1_modules_07_package_json_main_vs_exports", "label": "main vs exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/07-package-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main is the old single entry point. exports takes precedence wherever both exist."}, {"id": "docs_nodejs_pages_phase_1_modules_07_package_json_files_allowlist", "label": "files allowlist", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/07-package-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it npm publishes everything except a small default-ignored set. README, LICENSE and package.json always ship; node_modules never does."}, {"id": "docs_nodejs_pages_phase_1_modules_07_package_json_engines_floor", "label": "engines as a floor", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/07-package-json.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, 