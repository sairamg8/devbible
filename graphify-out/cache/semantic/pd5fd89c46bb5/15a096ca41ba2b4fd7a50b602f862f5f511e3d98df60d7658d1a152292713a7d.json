{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_09_self_join", "label": "Self joins", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/09-self-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_09_self_join_self_join", "label": "Self join via aliases", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/09-self-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM j_emp JOIN j_emp is 42712. Aliases give two roles. LEFT JOIN keeps the NULL-parent root."}, {"id": "docs_postgresql_pages_phase_5_joins_09_self_join_adjacency_list", "label": "Adjacency-list hierarchy", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/09-self-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheapest hierarchy to write; reads need N joins or WITH RECURSIVE. Opposite trade to materialised path or closure table."}, {"id": "docs_postgresql_pages_phase_5_joins_09_self_join_with_recursive", "label": "WITH RECURSIVE hierarchy walk", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/09-self-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor plus recursive term until empty. UNION ALL. A cycle loops forever; CYCLE (PG14+) or a path array stops it."}, {"id": "docs_postgresql_pages_phase_5_joins_09_self_join_cycle", "label": "Recursive CTE cycle detection", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/09-self-join.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_09_self_join_lag", "label": "lag() beats self join for pre