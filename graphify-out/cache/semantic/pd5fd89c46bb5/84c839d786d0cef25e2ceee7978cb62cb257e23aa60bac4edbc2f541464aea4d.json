{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_page", "label": "Idempotent writes", "file_type": "document", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_idempotency_key", "label": "Idempotency-Key unique constraint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unique index is correctness. Ten racing inserts without ON CONFLICT produced 1 row and 9 23505s. Key must come from the client."}, {"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_do_nothing_trap", "label": "ON CONFLICT DO NOTHING RETURNING trap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflict path writes nothing so RETURNING is empty. Retry cannot answer with the resource."}, {"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_do_update_xmax", "label": "DO UPDATE RETURNING xmax", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET key = EXCLUDED.key makes RETURNING fire. (xmax = 0) AS was_inserted distinguishes 201 from 200."}, {"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_key_table", "label": "Idempotency-key response table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store status, response jsonb, request_hash. In-flight is 409. Hash mismatch is 422. Scope PRIMARY KEY (user_id, key)."}, {"id": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_natural_idempotence", "label": "Naturally idempotent operations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PUT, DELETE, absolute SET are idempotent. Relative SET balance = balance + 10 and POST that creates a resource are not."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_page", "target": "docs_postgresql_pages_phase_9_api_crud_12_client_propagation_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_do_nothing_trap", "target": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_idempotency_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_do_update_xmax", "target": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_do_nothing_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/11-idempotent-writes.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_key_table", "target": "docs_postgresql_pages_phase_9_api_crud_11_idempotent_writes_idempotency_key", "relation": "conceptuall