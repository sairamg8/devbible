{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_run_condition", "label": "WindowAgg Run Condition", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15+ pushes WHERE rn <= N into WindowAgg so each partition stops after N rows. Applies to monotonic windows (row_number, rank, dense_rank, count). The Sort still processes all input rows."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_distinct_on", "label": "DISTINCT ON top-1", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shortest PostgreSQL-only spelling of top-1 per key; one whole consistent row. Cannot do N > 1."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_lateral_top_n", "label": "LATERAL LIMIT per group", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wins when groups are few and indexed; loses when groups approach a fraction of rows. 5000 groups / 500k rows: timeout without index, 906 ms with index vs 435 ms for row_number. Only form that takes OFFSET per group."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_covering_index_backfire", "label": "Non-covering window index backfire", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index (user_id, amount DESC) became Index Scan not Index Only Scan because id was not included \u2014 500574 buffers vs 3783, 534 vs 435 ms. INCLUDE selected columns, or accept the sequential scan plus disk sort."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_run_condition", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_the_four_functions_row_number", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_distinct_on", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_run_condition", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_lateral_top_n", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_run_condition", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ranking/top-n-per-group.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_covering_index_backfire", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ranking_top_n_per_group_run_condition", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6