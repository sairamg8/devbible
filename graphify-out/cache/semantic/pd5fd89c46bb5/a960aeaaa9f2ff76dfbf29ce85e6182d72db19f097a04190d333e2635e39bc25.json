{"nodes": [{"id": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_topic", "label": "Checking is not transpiling", "file_type": "document", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/10-checking-vs-transpiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_isolated_modules", "label": "isolatedModules", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/10-checking-vs-transpiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects constructs a single-file transpiler cannot compile: type re-exports without export type, const enum, ambient-only files."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_whole_program", "label": "Whole-program check vs one-file transpile", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/10-checking-vs-transpiling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transpiler never opens imports. A checker must build a type graph over the whole program. They cannot be the same pass."}], "edges": [{"source": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_whole_program", "target": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_isolated_modules", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/10-checking-vs-transpiling.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_0_how_typescript_runs_10_checking_vs_transpiling_isolated_modules", "target": "docs_typescript_pages_phase_0_how_typescrip