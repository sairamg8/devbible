{"nodes": [{"id": "docs_postgresql_pages_phase_5_joins_12_alias_discipline", "label": "Alias discipline", "file_type": "document", "source_file": "docs/postgresql/pages/phase-5-joins/12-alias-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_5_joins_12_alias_discipline_replaces_name", "label": "Alias replaces the table name", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/12-alias-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Referring to the original name after aliasing is 42P01. That replacement is what makes self joins possible."}, {"id": "docs_postgresql_pages_phase_5_joins_12_alias_discipline_42702", "label": "42702 ambiguous column", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/12-alias-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL refuses rather than guessing. The dangerous case is an unambiguous column rebound after a later migration."}, {"id": "docs_postgresql_pages_phase_5_joins_12_alias_discipline_output_alias_order", "label": "Output alias usable in ORDER BY and GROUP BY not WHERE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-5-joins/12-alias-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE and HAVING run before SELECT so the alias does not exist (42703). GROUP BY accepting it is a PostgreSQL extension."}, {"id": "docs_postgresql_pages_phase_5_joins_12_alias_discipline_qualify_every_column", "label": "Alias every table and qualify every column", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-5-joins/12-alias-discipline.md", "source_location": null, "source_url": null, "captur