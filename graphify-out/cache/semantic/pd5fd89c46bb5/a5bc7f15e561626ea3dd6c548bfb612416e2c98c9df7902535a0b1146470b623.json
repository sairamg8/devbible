{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "label": "HAVING", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters groups after aggregation. WHERE filters rows into groups. When the same predicate is legal in both, prefer WHERE; the planner can move some HAVING predicates and not others."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_vs_where", "label": "HAVING vs WHERE one-line test", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a single row can decide the predicate, it belongs in WHERE; if it needs the whole group, it belongs in HAVING. HAVING count(*) > 0 after a LEFT JOIN matches everything."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_vs_where", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_vs_where", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_group_by", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_evaluation_order", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_having_having", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_exists", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/having.html", "source_location": null, "weight": 1.0}], "hyperedges": []}