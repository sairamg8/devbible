{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_pid1_and_signals", "label": "PID 1 and signal handling", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If PID 1 is a shell or npm that never passes SIGTERM to Node, every deploy becomes a hard kill after the grace period."}, {"id": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_npm_start_swallows_sigterm", "label": "npm start swallows SIGTERM", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm is often PID 1 and may not forward SIGTERM to the Node child, so graceful shutdown never runs."}, {"id": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_sigterm_then_sigkill", "label": "SIGTERM then SIGKILL", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orchestrators send SIGTERM to PID 1, wait terminationGracePeriodSeconds (often 30s), then SIGKILL."}, {"id": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_node_as_pid1", "label": "Node as PID 1", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exec Node directly in the image. Use npm scripts on the laptop. Register SIGTERM and SIGINT to drain and exit."}, {"id": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_tini", "label": "tini / dumb-init", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If you must use a shell wrapper, a tiny init reaps zombies and forwards signals. Prefer avoiding the wrapper."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_npm_start_swallows_sigterm", "target": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_node_as_pid1", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_sigterm_then_sigkill", "target": "docs_nodejs_pages_phase_11_deployment_02_boot_sequence_shutdown_is_reverse", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_node_as_pid1", "target": "docs_nodejs_pages_phase_10_observability_10_health_checks_readiness_drain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_tini", "target": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_node_as_pid1", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/04-pid1-and-signals.md", "source_location": null, "weight": 1.0}], "hyperedges": []}