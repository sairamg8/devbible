{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_page", "label": "SELECT ... FOR UPDATE inside a request", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pessimistic answer to lost updates: lock at read, queue instead of retry. Meaningless outside a transaction."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_select_for_update", "label": "SELECT ... FOR UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locks returned rows until commit. Two concurrent adds produced 130 with no retries. Readers still see the old MVCC version."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_lock_last", "label": "Do slow work first, lock last", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight 100 ms requests: 863 ms with work inside the lock vs 143 ms with lock only to write. Re-read the locked row before writing."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_nowait_skip_locked", "label": "NOWAIT vs SKIP LOCKED", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOWAIT raises 55P03 immediately (409). SKIP LOCKED omits locked rows \u2014 right for job queues, wrong for point lookup (looks like not found). lock_timeout also 55P03, different message."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_lock_order", "label": "Lock rows in consistent order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opposite lock orders deadlock (40P01). ORDER BY id FOR UPDATE. FOR UPDATE OF table restricts join locking."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_page", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_select_for_update", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_lost_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_select_for_update", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_version_column", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_lock_last", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_select_for_update", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/for-update.html", "source_location": null, "weight": 1.0}], "hyperedges": []}