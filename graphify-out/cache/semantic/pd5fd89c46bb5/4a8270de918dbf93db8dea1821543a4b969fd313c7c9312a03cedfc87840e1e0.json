{"nodes": [{"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_page", "label": "Lists and key", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_key_is_identity", "label": "A key is an identity, not an index", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers which sibling from last render this is. Scoped to siblings, not a prop, stringified, compared before position."}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_index_keys_rewrite", "label": "Index keys rewrite text in place", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured: index keys do not remount. React keeps DOM nodes and rewrites contents, so uncontrolled input state stays with the slot."}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_stable_keys_move", "label": "Stable keys move DOM nodes", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "key={item.id} moves real nodes and rewrites no text. Same three Row instances either way."}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_key_placement", "label": "Key on the map callback's outermost child", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A key on an inner element is silent and useless. Shorthand <> cannot take a key \u2014 syntax error; use Fragment."}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_warning_deduped", "label": "Missing-key warning is deduplicated", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first offending list with a given parent tag warns; later ones stay silent even in other components. Absence proves nothing."}, {"id": "docs_react_pages_phase_1_jsx_07_lists_and_keys_duplicate_keys", "label": "Duplicate keys may omit children", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React's own warning: children may be duplicated and/or omitted. A missing row with no error is usually this."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_07_lists_and_keys_page", "target": "docs_react_pages_phase_1_jsx_07_lists_and_keys_key_is_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_07_lists_and_keys_page", "target": "docs_react_pages_phase_1_jsx_07_lists_and_keys_index_keys_rewrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_07_lists_and_keys_page", "target": "docs_react_pages_phase_1_jsx_07_lists_and_keys_stable_keys_move", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/07-lists-and-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_r