{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_grouping_sets", "label": "GROUPING SETS", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/grouping-sets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several grouping levels in one statement. Not parallelised: three sets took 293.67 ms in one scan versus 170.22 ms as three parallel GROUP BYs."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_rollup_cube", "label": "ROLLUP and CUBE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/grouping-sets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROLLUP (a,b) expands to ((a,b),(a),()) \u2014 n+1 sets. CUBE expands to every subset \u2014 2^n. () is the grand total."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_grouping", "label": "GROUPING()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/grouping-sets.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subtotal rows mark rolled-up columns with NULL, indistinguishable from a data NULL. GROUPING(col) returns 1 for the former and 0 for the latter."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_grouping_sets", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_rollup_cube", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/grouping-sets.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_grouping_sets_grouping", "targ