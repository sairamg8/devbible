{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_11_naming_identifier_folding", "label": "Unquoted identifiers fold to lower case", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE TABLE \"UserAccounts\" then SELECT FROM UserAccounts \u2192 42P01 relation useraccounts does not exist. Quoted names must be quoted forever."}, {"id": "docs_postgresql_pages_phase_3_ddl_11_naming_snake_case", "label": "snake_case convention", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What unquoted identifiers become anyway. Plural tables, singular columns, <table>_<cols>_key/fkey/check/idx matching PostgreSQL generated names."}, {"id": "docs_postgresql_pages_phase_3_ddl_11_naming_constraint_names_as_api", "label": "Constraint names are an API", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "err.constraint turns 23505 + users_email_key into a field-level 409. Auto-generated names change on column rename; name them explicitly."}, {"id": "docs_postgresql_pages_phase_3_ddl_11_naming_max_identifier_length", "label": "63-byte identifier limit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Truncated silently with a NOTICE. Two long index names that differ after byte 63 collide and the second CREATE INDEX fails as a duplicate."}, {"id": "docs_postgresql_pages_phase_3_ddl_11_naming_reserved_word_user", "label": "user is reserved", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT * FROM user returns current_user, not a table. Plural users dodges this and most reserved-word collisions."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_11_naming_identifier_folding", "target": "docs_postgresql_pages_phase_3_ddl_11_naming_snake_case", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_11_naming_snake_case", "target": "docs_postgresql_pages_phase_3_ddl_11_naming_identifier_folding", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_11_naming_constraint_names_as_api", "target": "docs_postgresql_pages_phase_3_ddl_04_constraints_constraint_sqlstates", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_11_naming_snake_case", "target": "docs_postgresql_pages_phase_3_ddl_11_naming_reserved_word_user", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/11-naming.md", "source_location": null, "weight": 1.0}], "hyperedges": []}