{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_12_concurrently_create_index_concurrently", "label": "CREATE INDEX CONCURRENTLY", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_12_concurrently_cic", "label": "CREATE INDEX CONCURRENTLY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids the ShareLock that blocks writers; costs two table passes plus a wait for every pre-existing transaction, including idle-in-transaction elsewhere."}, {"id": "docs_postgresql_pages_phase_10_indexes_12_concurrently_sharelock", "label": "CREATE INDEX ShareLock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflicts with RowExclusiveLock; reads continue, writes queue. On a minutes-long build that is an outage."}, {"id": "docs_postgresql_pages_phase_10_indexes_12_concurrently_indisvalid", "label": "indisvalid", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed CONCURRENTLY leaves an index with indisvalid=false: unusable by queries but still maintained by writes. There is no resume."}, {"id": "docs_postgresql_pages_phase_10_indexes_12_concurrently_sqlstate_25001", "label": "SQLSTATE 25001", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE INDEX CONCURRENTLY cannot run inside a transaction block; mark the migration non-transactional."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_12_concurrently_create_index_concurrently", "target": "docs_postgresql_pages_phase_10_indexes_12_concurrently_cic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_12_concurrently_cic", "target": "docs_postgresql_pages_phase_10_indexes_12_concurrently_sharelock", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_12_concurrently_indisvalid", "target": "docs_postgresql_pages_phase_10_indexes_12_concurrently_cic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_12_concurrently_sqlstate_25001", "target": "docs_postgresql_pages_phase_10_indexes_12_concurrently_cic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_12_concurrently_sqlstate_25001", "target": "docs_postgresql_pages_phase_1_psql_14_errverbose_sqlstate", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-10-indexes/12-concurrently.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_i