res-things/07-commit-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit dated 2030 can sit under one dated 2026. Never build logic on dates; use ancestry via merge-base --is-ancestor."}, {"id": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_rev_list", "label": "git rev-list", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/07-commit-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_merge_base", "label": "git merge-base", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/07-commit-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_range_syntax", "label": "Commit range A..B", "file_type": "concept", "source_file": "docs/git/pages/phase-0-how-git-stores-things/07-commit-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_rebase_vs_merge", "label": "Rebase versus merge trade-off", "file_type": "rationale", "source_file": "docs/git/pages/phase-0-how-git-stores-things/07-commit-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DAG records parallel work honestly. Rebase flattens for readability by rewriting what happened; merge keeps truth at the cost of a harder history."}], "edges": [{"source": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_commit_graph", "target": "docs_git_pages_phase_0_how_git_stores_things_07_commit_graph_dag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_