{"nodes": [{"id": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "label": "DELETE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_4_crud_11_delete_on_delete_actions", "label": "ON DELETE RESTRICT NO ACTION CASCADE SET NULL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RESTRICT raises 23001 immediately and cannot defer. NO ACTION raises 23503 and can be DEFERRABLE INITIALLY DEFERRED. CASCADE is transitive. Unindexed FKs scan the child table."}, {"id": "docs_postgresql_pages_phase_4_crud_11_delete_ctid_batch_delete", "label": "ctid batched DELETE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE takes no LIMIT (42601). Batch via ctid IN (SELECT ctid ... LIMIT n). 100000 rows: one shot 115 ms, 10 batches 484 ms, but locks release, VACUUM is not held back, job is interruptible."}, {"id": "docs_postgresql_pages_phase_4_crud_11_delete_delete_does_not_shrink", "label": "DELETE does not shrink the table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "47 MB before and after deleting half the rows, still 47 MB after VACUUM, 24 MB after VACUUM FULL. VACUUM truncates only trailing empty pages."}, {"id": "docs_postgresql_pages_phase_4_crud_11_delete_soft_delete", "label": "Soft delete is an UPDATE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting deleted_at fires no cascade, unique constraints still see the row, every query needs WHERE deleted_at IS NULL. Orphaned orders stayed visible."}], "edges": [{"source": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "target": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "target": "docs_postgresql_pages_phase_4_crud_05_returning_returning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_11_delete_delete", "target": "docs_postgresql_pages_phase_4_crud_07_update_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_11_delete_soft_delete", "target": "docs_postgresql_pages_phase_4_crud_07_update_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_11_delete_delete_does_not_shrink", "target": "docs_postgresql_pages_phase_4_crud_14_truncate_truncate", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-4-crud/11-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_4_crud_11_delete_on_delete_actions", "target": "docs_