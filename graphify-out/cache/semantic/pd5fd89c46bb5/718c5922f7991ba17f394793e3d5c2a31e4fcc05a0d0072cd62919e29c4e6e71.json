{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_time_on_the_server_store_utc", "label": "Store UTC convert at the edge", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/time-on-the-server.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An instant is unambiguous. A calendar date depends on who is looking. Store the user's timezone."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_time_on_the_server_timestamptz", "label": "timestamptz not timestamp", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/time-on-the-server.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timestamptz stores an instant. timestamp is a wall-clock reading with no zone."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_time_on_the_server_calendar_vs_elapsed", "label": "Calendar vs elapsed arithmetic", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/time-on-the-server.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding 7*24h across DST moved 7:00 a.m. New York to 8:00 a.m. Use calendar arithmetic in a named zone."}, {"id": "build_css_p2_docs_nodejs_pages_phase_7_background_work_time_on_the_server_midnight_instant", "label": "Midnight stored as an instant", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-7-background-work/time-on-the-server.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute the deadline once in the zone that owns the rule. Then expires_at <= now() is zone-independent."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_7_background_work_