{"nodes": [{"id": "docs_react_pages_phase_2_components_06_props_are_read_only_page", "label": "Props are read-only", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_immutable_by_contract", "label": "Props are immutable by contract, not enforcement", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React does not freeze props or the objects they reference. Each render builds a fresh props object; a mutation is discarded on the next parent render."}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_mutation_appears_to_work", "label": "Mutating a prop appears to work", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks later: parent refresh drops the field, a sibling reads undefined, memo skips the mutating render, StrictMode doubles, concurrent abandon leaves the write."}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_one_way_data_flow", "label": "One-way data flow", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Props down, events up. Only the owner can change a value, so debugging walks up to the useState. Mutation destroys that guarantee."}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_mutating_array_methods", "label": "Mutating array methods on props", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sort, reverse, splice, push and friends mutate in place. sort is the trap because it reads like a query. Use toSorted / a copy."}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_reassign_local", "label": "Reassigning a destructured prop is legal", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes only a local binding. The violation is a write through the prop to the object it points at."}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_passing_props_docs", "label": "react.dev Passing Props to a Component", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": "https://react.dev/learn/passing-props-to-a-component", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_06_props_are_read_only_keeping_pure_docs", "label": "react.dev Keeping Components Pure", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "source_url": "https://react.dev/learn/keeping-components-pure", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_react_pages_phase_2_components_06_props_are_read_only_page", "target": "docs_react_pages_phase_2_components_06_props_are_read_only_immutable_by_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/06-props-are-read-only.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_ph