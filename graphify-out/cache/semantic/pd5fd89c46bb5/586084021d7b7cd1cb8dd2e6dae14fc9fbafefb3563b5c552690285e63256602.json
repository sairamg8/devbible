{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_shadow_dom_selectors_style_boundary", "label": "Shadow DOM style boundary", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/shadow-dom-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selectors do not cross a shadow root in either direction; that is real encapsulation unlike CSS Modules or @scope."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_shadow_dom_selectors_host", "label": ":host and :host-context()", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/shadow-dom-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ":host styles the component element; :host-context() matches when an ancestor matches, for theme adaptation."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_shadow_dom_selectors_part", "label": "::part()", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/shadow-dom-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Component opts an element in for outside styling; descendants stay private \u2014 ::part(header) .title does not work."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_shadow_dom_selectors_slotted", "label": "::slotted()", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/shadow-dom-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Styles top-level light-DOM slotted nodes only; page rules win because those nodes belong to the light tree."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_shadow_dom_selectors_custom_properties", "label": "Custom properties cross shadow", "fi