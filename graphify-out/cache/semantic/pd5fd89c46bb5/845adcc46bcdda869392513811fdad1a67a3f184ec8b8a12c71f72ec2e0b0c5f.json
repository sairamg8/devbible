{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_identifier_folding", "label": "Identifier folding to lower case", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unquoted identifiers are lower-cased before lookup; quoted ones are stored verbatim. Creating \"UserAccounts\" means every future reference must be quoted."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "label": "snake_case naming convention", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use unquoted snake_case because that is what unquoted identifiers become. Plural tables, singular columns; constraint names follow PostgreSQL generated patterns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_constraint_names_as_api", "label": "Constraint names are an API", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "err.constraint plus SQLSTATE turns a database error into a field-level message (23505 + users_email_key). Auto-generated names change on column rename; name constraints explicitly."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_max_identifier_length", "label": "63-byte identifier limit", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "max_identifier_length is 63 bytes, truncated silently with a notice. Two long names that differ only after byte 63 collide; non-ASCII hits the limit sooner."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_reserved_word_user", "label": "Reserved word user", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SELECT * FROM user resolves to current_user, not a table. Plural users and other plural table names dodge most reserved-word collisions."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_repository_case_mapping", "label": "Repository-layer snake_case to camelCase", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map once in the repository. Unquoted AS userId folds to userid, so per-query aliases need quotes and drift."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_identifier_folding", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_reserved_word_user", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_constraint_names_as_api", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_max_identifier_length", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_repository_case_mapping", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_identifier_folding", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_snake_case_convention", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_normalization_store_every_fact_once", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_naming_constraint_names_as_api", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_on_conflict_on_conflict_upsert", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/naming.html", "source_location": null, "weight": 1.0}], "hyperedges": []}