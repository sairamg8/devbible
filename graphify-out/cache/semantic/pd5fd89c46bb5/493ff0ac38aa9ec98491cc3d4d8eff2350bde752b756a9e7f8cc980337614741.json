{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_nan_not_equal", "label": "NaN !== NaN", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IEEE-754: two failed computations are not the same value. Only JS value not equal to itself. Propagates silently through later arithmetic."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_number_isnan", "label": "Number.isNaN versus isNaN", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global isNaN coerces first so isNaN('abc') is true. Number.isNaN is true only for the NaN value. Prefer Number.isFinite to also reject Infinity."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_includes_vs_indexof", "label": "includes versus indexOf for NaN", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "indexOf uses === so [NaN].indexOf(NaN) is -1. includes and Map/Set keys use SameValueZero so NaN is found and deduped."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_nan_not_equal", "target": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_number_isnan", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_includes_vs_indexof", "target": "docs_javascript_pages_phase_1_values_and_coercion_03_equality_four_algorithms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_11_nan_nan_not_equal", "target": "docs_javascript_pages_phase_1_values_and_coercion_05_null_vs_undefined_nullish_coalescing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/11-nan.md", "source_location": null, "weight": 1.0}], "hyperedges": []}