{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_at_rule_map_at_rule_map", "label": "CSS at-rule map", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-at-rule-map.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About a dozen at-rules worth knowing: @media/@container, @supports, @layer, @scope, @property, @font-face, @keyframes, @starting-style, @page, @counter-style, @import."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_at_rule_map_unknown_at_rule_drops_block", "label": "Unknown at-rule drops its whole block", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-at-rule-map.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unrecognized at-rule is discarded silently with every rule inside it. Base styling must live outside recent at-rules; enhancement only goes inside."}, {"id": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_at_rule_map_block_vs_statement", "label": "Block vs statement at-rules", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-at-rule-map.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Block forms wrap rules and nest; statement forms end at a semicolon. @layer has both: @layer a, b; declares order, @layer a { } fills a layer. First mention sets order."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_at_rule_map_at_rule_map", "target": "build_css_p2_docs_css_pages_phase_0_how_css_runs_the_at_rule_map_unknown_at_rule_drops_block", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-0-how-css-runs/the-at-rule-map.html", "source_location