{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_useeffect_anatomy", "label": "useEffect anatomy", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_three_forms", "label": "Three dependency-array forms", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No array: after every commit. Empty: after initial commit only. Populated: initial plus Object.is change, positionally."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_cleanup_then_setup", "label": "cleanup(old) then setup(new)", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleanup closes over the render that created it, so it disconnects the old room, not the new one."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_async_setup_forbidden", "label": "Async setup is not allowed", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An async function returns a Promise, not a cleanup. Declare an inner async function and return a real cleanup."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_one_effect_per_concern", "label": "One effect per concern", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging concerns unions their dependency lists, so each concern tears down for the other's reasons."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_useeffect_anatomy", "target": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_three_forms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_useeffect_anatomy", "target": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_the_dependency_array", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_cleanup_then_setup", "target": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_ignore_flag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_useeffect_anatomy_one_effect_per_concern", "target": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_restructuring_the_effect_split_effects", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/useeffect-anatomy.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_4_useeffect_anatomy_trio", "label": "useEffect setup, cleanup, and dependency array", "no