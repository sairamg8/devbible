{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_render_props_render_props", "label": "Render props and function-as-children", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/render-props.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_render_props_pattern", "label": "Render prop pattern", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/render-props.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A function prop the component calls to decide what to render. children works and reads better."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_render_props_wrapper_hell", "label": "Wrapper hell", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/render-props.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each render prop adds a JSX nesting level. Hooks compose as lines instead."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_render_props_hooks_replaced", "label": "Why hooks replaced render props", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/render-props.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No extra tree nodes, values usable anywhere in the component, linear composition, better types."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_render_props_still_win", "label": "When render props still win", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/render-props.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": nu