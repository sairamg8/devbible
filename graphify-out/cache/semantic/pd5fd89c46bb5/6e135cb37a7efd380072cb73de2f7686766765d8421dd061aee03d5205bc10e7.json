{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_local_dev_db", "label": "Local development database", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disposable, version-matched to production, on a non-colliding port. postgres:18-alpine on 55432."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_127_0_0_1", "label": "Connect on 127.0.0.1 never localhost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node DNS verbatim order resolves localhost to ::1 first. A container published on IPv4 only yields connection refused."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_pg_isready", "label": "pg_isready readiness loop", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container running is not accepting TCP. First init starts the server twice. sleep 5 is flaky or slow; poll pg_isready or compose healthcheck."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_alpine_vs_debian", "label": "alpine musl vs debian glibc collation", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same PostgreSQL 18.4 and en_US.utf8, different ORDER BY. musl locale is a stub and falls back to byte order. Match base image or pin ICU."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_tmpfs", "label": "tmpfs disposable data directory", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With working migrations and seeds, rebuild in seconds. Faster (no disk sync) and cannot drift. Never mistake it for a real deployment."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_local_dev_db", "target": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_127_0_0_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_local_dev_db", "target": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_pg_isready", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_local_dev_db", "target": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_alpine_vs_debian", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_tmpfs", "target": "docs_postgresql_pages_phase_8_schema_from_node_10_local_dev_db_local_dev_db", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-8-schema-from-node/10-local-dev-db.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_