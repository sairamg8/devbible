{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_drop_restrict", "label": "DROP RESTRICT default", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/13-drop-cascade.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2BP01 dependent_objects_still_exist. The error NOTICE list is the cheapest inventory of dependents."}, {"id": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_drop_cascade", "label": "DROP CASCADE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/13-drop-cascade.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops views, constraints, triggers that cannot exist without the object. Child table survives; only its FK is dropped, then orphans accumulate."}, {"id": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_vs_on_delete_cascade", "label": "DROP CASCADE vs ON DELETE CASCADE", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/13-drop-cascade.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same word, different mechanism. DROP CASCADE acts on schema dependencies; ON DELETE CASCADE acts on row references."}, {"id": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_rename_before_drop", "label": "Rename before drop", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/13-drop-cascade.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two deploys: stop referencing, rename to _deprecated_DATE (42703 for stragglers), drop later. Dropping makes data unreachable immediately."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_drop_restrict", "target": "docs_postgresql_pages_phase_3_ddl_13_drop_cascade_drop_cascade", "relation": "conce