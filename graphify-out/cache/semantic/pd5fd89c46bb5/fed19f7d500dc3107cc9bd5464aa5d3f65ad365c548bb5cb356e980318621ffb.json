{"nodes": [{"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_async_function", "label": "async function always returns a promise", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No path out is not a promise. return wraps or adopts; throw becomes a rejection."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_never_throws_sync", "label": "async function never throws synchronously", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "try { asyncFn() } without await catches nothing. Synchronous argument checks must live in a non-async wrapper."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_return_p_identity", "label": "return p vs Promise.resolve(p) identity", "file_type": "concept", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise.resolve(p) returns the same native promise; an async function must create its own. Breaks caches keyed by promise reference."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_desugar", "label": "async/await desugars to a promise chain", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await 1 becomes Promise.resolve(1).then(() => undefined). Non-promises are wrapped; code after await is a continuation."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_generators_model", "label": "async/await like generators plus promises", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The function suspends and resumes; the awaited promise decides when. Gain is real try/catch, ordinary loops, and locals instead of threaded handler arguments."}, {"id": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_mdn_async_function", "label": "MDN async function", "file_type": "document", "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "source_url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/async_function", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_async_function", "target": "docs_javascript_pages_phase_7_async_05_promises_01_the_three_states_promise", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_async_function", "target": "docs_javascript_pages_phase_7_async_05_promises_03_value_vs_promise_adoption", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-7-async/07-async-await/01-always-a-promise.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_promise_never_throws_sync", "target": "docs_javascript_pages_phase_7_async_07_async_await_01_always_a_