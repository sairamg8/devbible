{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_bigint", "label": "BigInt", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/13-bigint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arbitrary-precision integers past 2^53-1. Create from a string for large values; a number literal is already rounded. Division truncates."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_no_mix", "label": "Cannot mix BigInt and Number", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/13-bigint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1n + 1 throws TypeError. Comparison is allowed: 1n == 1 is true, 1n === 1 is false. Mixing would silently lose precision."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_json_throws", "label": "JSON.stringify throws on BigInt", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/13-bigint.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON has no BigInt type. Use a replacer to string; do not patch BigInt.prototype.toJSON."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_bigint", "target": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_max_safe_integer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/13-bigint.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_no_mix", "target": "docs_javascript_pages_phase_1_values_and_coercion_13_bigint_bigint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "co