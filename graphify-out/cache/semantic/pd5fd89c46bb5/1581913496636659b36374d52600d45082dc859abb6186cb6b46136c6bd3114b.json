{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_14_bitwise_32bit", "label": "Bitwise ToInt32 coercion", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/14-bitwise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every bitwise operator converts to 32-bit signed first. 2**31|0 is -2147483648; 2**32|0 is 0. Only 31 usable flags; 1<<31 is negative."}, {"id": "docs_javascript_pages_phase_2_operators_14_bitwise_double_tilde", "label": "~~ is not Math.trunc", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/14-bitwise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~~1e10 is 1410065408. Valid only below 2^31. Same for x|0, x>>0, x<<0. Use Math.trunc."}, {"id": "docs_javascript_pages_phase_2_operators_14_bitwise_signed_vs_unsigned_shift", "label": ">> vs >>>", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/14-bitwise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ">> keeps the sign (-5>>1 is -3). >>> fills with zeros (-5>>>1 is 2147483645). Only unsigned 32-bit result."}, {"id": "docs_javascript_pages_phase_2_operators_14_bitwise_flag_set", "label": "Bitwise permission flag set", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/14-bitwise.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1<<n, combine with |, test (flags&MASK)!==0, add |=, remove &= ~MASK, toggle ^=. Prefer Set of strings in app code."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_14_bitwise_double_tilde", "target": "docs_javascript_pages_phase_2_operators_14_bitwise_32bit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "