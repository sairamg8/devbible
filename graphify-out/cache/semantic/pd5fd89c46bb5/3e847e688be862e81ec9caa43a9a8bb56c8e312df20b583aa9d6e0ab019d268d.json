{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_03_indexes_and_checklist_create_index_concurrently", "label": "CREATE INDEX CONCURRENTLY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/03-indexes-and-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No write-blocking lock. Cannot run in a transaction. Scans twice and waits for existing transactions. Slower than a regular build."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_03_indexes_and_checklist_invalid_indexes", "label": "Invalid indexes after CONCURRENTLY failure", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/03-indexes-and-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "indisvalid=false: ignored for queries, still maintained on every write. Drop and retry or REINDEX INDEX CONCURRENTLY. Check post-migration."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_03_indexes_and_checklist_rename_expand_contract", "label": "Never rename a column in one step", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/03-indexes-and-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No instant when old and new code agree on the name. Add, dual-write, backfill, switch reads, drop later. Same for int\u2192bigint."}, {"id": "docs_postgresql_pages_phase_13_ops_12_zero_downtime_ddl_03_indexes_and_checklist_migration_checklist", "label": "Zero-downtime migration checklist", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/12-zero-downtime-ddl/03-indexes-and-checklist.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contri