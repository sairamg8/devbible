{"nodes": [{"id": "docs_typescript_pages_phase_1_type_vocabulary_17_symbols_symbol", "label": "symbol", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/17-symbols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique key that cannot collide. Invisible to Object.keys, JSON.stringify, and for...in. let widens to symbol; const keeps unique symbol."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_17_symbols_unique_symbol", "label": "unique symbol", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/17-symbols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type of one specific symbol. Two Symbol('key') values are different types. Symbol.for is typed symbol because it is not unique."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_17_symbols_well_known", "label": "Well-known symbols", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/17-symbols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symbol.iterator, asyncIterator, toPrimitive, hasInstance, toStringTag hook a class into language behaviour."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_17_symbols_json_skip", "label": "Symbol keys skipped by JSON", "file_type": "concept", "source_file": "docs/typescript/pages/phase-1-type-vocabulary/17-symbols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.stringify and Object.keys skip symbol keys. Useful for in-process metadata; silent data loss across a network or structuredClone."}, {"id": "docs_typescript_pages_phase_1_type_vocabulary_17_symbols_computed_key_folklore", "label": "Computed key unique symbol folklore", "file_type": "rationale", "sou