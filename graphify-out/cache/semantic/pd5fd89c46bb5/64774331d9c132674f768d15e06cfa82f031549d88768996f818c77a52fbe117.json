{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "label": "setImmediate vs setTimeout(fn, 0)", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_setimmediate", "label": "setImmediate", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedules into the check phase, after poll in the same lap. Use it to run after the current phase, yield so I/O can run, or chunk CPU work. Does not escape a blocked thread."}, {"id": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_settimeout_zero_clamp", "label": "setTimeout(fn, 0) 1ms clamp", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no true zero delay. The timer is clamped to 1ms and runs in the timers phase on a later lap. Almost always the wrong tool versus setImmediate."}, {"id": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_main_module_race", "label": "Main-module setImmediate vs setTimeout race", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order depends on whether process startup took >=1ms before the first timers phase. Both orders are correct. CI machines are slower so the timer more often wins."}, {"id": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_io_callback_deterministic", "label": "setImmediate wins inside an I/O callback", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I/O callbacks run in poll; check is the next phase in the same lap. A timer must wait a full lap, so setImmediate always runs first inside any I/O callback."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_setimmediate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_settimeout_zero_clamp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_main_module_race", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_settimeout_zero_clamp", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_io_callback_deterministic", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_setimmediate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_setimmediate", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_macrotasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "target": "docs_nodejs_pages_phase_2_async_22_cpu_bound_work_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/04-setimmediate-vs-settimeout.md", "source_location": null, "weight": 1.0}], "hyperedges": []}