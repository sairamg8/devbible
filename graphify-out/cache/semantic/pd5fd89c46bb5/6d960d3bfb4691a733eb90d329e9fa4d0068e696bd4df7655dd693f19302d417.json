{"nodes": [{"id": "docs_postgresql_pages_phase_8_schema_from_node_05_sql_files_sql_files", "label": "SQL in .sql files", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/05-sql-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Template-literal SQL is invisible to formatters, linters, and psql. Files restore tooling, reviewable diffs, and a boundary against concatenation."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_05_sql_files_sql_loader", "label": "Cached sql file loader", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/05-sql-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read once per process into a Map. Skip the cache in development so edits take effect without restart."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_05_sql_files_import_meta_url", "label": "Resolve SQL paths from import.meta.url", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/05-sql-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "process.cwd() is launch directory and differs in tests vs production. import.meta.url is the module location."}, {"id": "docs_postgresql_pages_phase_8_schema_from_node_05_sql_files_named_parameter_shim", "label": "Named parameter shim", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-8-schema-from-node/05-sql-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrite :name to $n at load time. Values never enter SQL text. Regex must not match :: casts."}], "edges": [{"source": "docs_postgresql_pages_phase_8_schema_from_node_05_sql_files_sql_files", "target": "docs_postgresql_pages_phase_8_schema_from_n