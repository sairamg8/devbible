{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_scan_types", "label": "Seq scan vs index scan vs bitmap heap scan", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_index_scan", "label": "Index Scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walk the index and fetch each heap row directly. Chosen for a handful of rows."}, {"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_bitmap_heap_scan", "label": "Bitmap Heap Scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect matching locations first, then read the heap in physical order so each page is visited at most once."}, {"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_seq_scan", "label": "Seq Scan", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a failure: forcing an index on 80% of 500000 rows took 272 ms and 400358 buffers versus 91 ms and 3712 for the sequential scan."}, {"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_enable_seqscan", "label": "enable_seqscan = off", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A diagnostic, not a fix: it prices sequential scans absurdly high. Never leave it in a migration or connection setup."}, {"id": "docs_postgresql_pages_phase_10_indexes_04_scan_types_random_page_cost", "label": "random_page_cost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 4.0 dates from spinning disks; ~1.1 on SSD is the knob that actually shifts the index/seq balance."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_04_scan_types_scan_types", "target": "docs_postgresql_pages_phase_10_indexes_04_scan_types_index_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_04_scan_types_scan_types", "target": "docs_postgresql_pages_phase_10_indexes_04_scan_types_bitmap_heap_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_04_scan_types_scan_types", "target": "docs_postgresql_pages_phase_10_indexes_04_scan_types_seq_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_04_scan_types_enable_seqscan", "target": "docs_postgresql_pages_phase_10_indexes_04_scan_types_seq_scan", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/04-scan-types.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_04_scan_types_random_page_cost", "targ