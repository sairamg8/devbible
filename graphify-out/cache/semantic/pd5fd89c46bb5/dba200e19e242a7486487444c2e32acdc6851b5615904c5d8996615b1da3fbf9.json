{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_statement_timeout", "label": "statement_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side cancel; SQLSTATE 57014; connection stays usable. The only timeout that actually stops the database doing work."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_query_timeout", "label": "query_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side give-up; the server keeps executing. Users retry and the server accumulates work nobody is waiting for. Set slightly above statement_timeout."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_idle_in_transaction", "label": "idle_in_transaction_session_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kills a session that issued BEGIN then waited. Pins xmin and blocks VACUUM. Delivered as an 'error' event, not a rejected query."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_lock_timeout", "label": "lock_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Give up rather than queue behind ACCESS EXCLUSIVE. An ALTER TABLE waiting for that lock is an outage for every query behind it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_pool_timeouts", "label": "connectionTimeoutMillis and idleTimeoutMillis", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "connectionTimeoutMillis covers socket open and waiting for a free pooled connection. idleTimeoutMillis should sit below intermediary idle TCP drops."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_query_timeout", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_statement_timeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_query_timeout", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_release_true", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_idle_in_transaction", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_install_wire_pool_on_error", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_pool_timeouts", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_connect_release_pool_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_statement_timeout", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_errors_sqlstate_err_code", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "pg_timeout_family", "label": "pg timeout family", "nodes": ["build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_statement_timeout", "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_query_timeout", "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_idle_in_transaction", "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_lock_timeout", "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_timeouts_pool_timeouts"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/timeouts.html"}]}