{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_keys_values_entries_transforming_objects_fromentries", "label": "Object.fromEntries", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/keys-values-entries/transforming-objects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inverse of Object.entries. Accepts any pair iterable including Map, URLSearchParams, FormData, Headers. Always builds a plain object; unlike Array.from it ignores this."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_keys_values_entries_transforming_objects_round_trip", "label": "entries-fromEntries object map/filter", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/keys-values-entries/transforming-objects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objects have no map/filter. Convert to pairs, use array methods, convert back. Safer pick than delete. Loses symbols, non-enumerables, inherited keys, prototype, accessors, descriptors, and numeric key order. Shallow."}, {"id": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_keys_values_entries_transforming_objects_urlsearchparams_lossy", "label": "fromEntries duplicate-key loss", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-4-objects-and-classes/keys-values-entries/transforming-objects.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URLSearchParams/FormData can repeat keys; an object cannot. Last assignment wins, so tag=a&tag=b becomes {tag:\"b\"}. Use getAll or keep the params object."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_4_objects_and_classes_keys_values_entries_transforming_obj