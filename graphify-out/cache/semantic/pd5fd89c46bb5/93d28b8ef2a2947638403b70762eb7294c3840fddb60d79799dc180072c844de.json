{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_15_finding_the_bottleneck_finding_the_bottleneck", "label": "Finding the bottleneck", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/15-finding-the-bottleneck.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bottleneck is the resource that is full. Optimizing anything else is a hobby."}, {"id": "docs_nodejs_pages_phase_10_observability_15_finding_the_bottleneck_measure_then_change", "label": "Measure then change one thing", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-10-observability/15-finding-the-bottleneck.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reproduce with a number, check golden signals and loop lag, time dependencies, profile only if the loop or CPU is hot, change one thing, remeasure."}, {"id": "docs_nodejs_pages_phase_10_observability_15_finding_the_bottleneck_lag_high_cpu_bound", "label": "High lag plus high CPU", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/15-finding-the-bottleneck.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync JS, crypto, or JSON on the loop. Profile and move work off the request path."}, {"id": "docs_nodejs_pages_phase_10_observability_15_finding_the_bottleneck_lag_low_io_bound", "label": "Low lag plus high p99", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/15-finding-the-bottleneck.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waiting on I/O or a queue, not blocking the event loop. Look at downstream and pool wait times. CPU profiles show idle."}, {"id": "docs_nodejs_pages_phase_10_observability_15_finding_the_bottleneck_staged_timings", "