{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_18_secrets_page", "label": "Secrets handling", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Getting a secret into the process is configuration; keeping it from leaving is the hard part. Verified sandbox/p8-security/ex17-secrets.mjs."}, {"id": "docs_nodejs_pages_phase_8_security_18_secrets_env_file", "label": "Node --env-file", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No expansion, real env wins, missing file exits 9. Values never enter /proc/self/environ. Development convenience, not a secret manager."}, {"id": "docs_nodejs_pages_phase_8_security_18_secrets_secret_wrapper", "label": "Secret wrapper type", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "toString, toJSON and util.inspect.custom return [redacted]; only .expose() yields the value. Pair with logger key-name redaction."}, {"id": "docs_nodejs_pages_phase_8_security_18_secrets_secret_rotation", "label": "Secret rotation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two values valid at once (kid), read at use not import, schedule so first rotation is not during an incident, expiry beats revocation."}, {"id": "docs_nodejs_pages_phase_8_security_18_secrets_git_history_leak", "label": "Committed secret in git history", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git rm plus .gitignore leaves history intact. Rotate first; history rewrite is optional cleanup that never reaches existing clones."}, {"id": "docs_nodejs_pages_phase_8_security_18_secrets_child_process_env", "label": "Child process environment inheritance", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "spawn/exec/fork inherit the full environment by default. Pass an explicit env allowlist; helpers can dump process.env."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_18_secrets_page", "target": "docs_nodejs_pages_phase_8_security_18_secrets_env_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_18_secrets_page", "target": "docs_nodejs_pages_phase_8_security_18_secrets_secret_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_18_secrets_page", "target": "docs_nodejs_pages_phase_8_security_18_secrets_secret_rotation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_18_secrets_page", "target": "docs_nodejs_pages_phase_8_security_18_secrets_git_history_leak", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/18-secrets.md", "source_location": null, "weight":