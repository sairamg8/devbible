{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_01_integers_integer_types", "label": "PostgreSQL integer types", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "smallint 2 bytes \u00b132767, integer 4 bytes \u00b12.1e9, bigint 8 bytes \u00b19.22e18. No unsigned variant; use CHECK (n >= 0). Overflow raises 22003 rather than wrapping."}, {"id": "docs_postgresql_pages_phase_2_types_01_integers_bigint_surrogate_pk", "label": "bigint for surrogate primary keys", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 17 MB vs 21 MB and same PK index on 500k two-column rows. Exhausting an int sequence is 2200H and a full ACCESS EXCLUSIVE rewrite. Foreign keys must match referenced width or a cast kills the index."}, {"id": "docs_postgresql_pages_phase_2_types_01_integers_generated_as_identity", "label": "GENERATED ALWAYS AS IDENTITY", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard SQL preferred over serial/bigserial, which expand to column plus sequence plus default. ALWAYS prevents explicit inserts from desynchronising the sequence."}, {"id": "docs_postgresql_pages_phase_2_types_01_integers_bigint_js_string", "label": "pg returns bigint as a string", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "int8 exceeds Number.MAX_SAFE_INTEGER. Measured 9007199254740993 arrived as a string. Compare as strings or BigInt. setTypeParser(20, parseInt) is a global decision."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_01_integers_bigint_surrogate_pk", "target": "docs_postgresql_pages_phase_2_types_01_integers_integer_types", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_01_integers_generated_as_identity", "target": "docs_postgresql_pages_phase_2_types_01_integers_bigint_surrogate_pk", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_01_integers_bigint_js_string", "target": "docs_postgresql_pages_phase_2_types_01_integers_integer_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_01_integers_bigint_surrogate_pk", "target": "docs_postgresql_pages_phase_2_types_12_casting_cast_literal_not_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/01-integers.md", "source_location": null, "weight": 1.0}], "hyperedges": []}