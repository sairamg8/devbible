{"nodes": [{"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_one_pass_builder", "label": "One-pass WHERE fragment builder", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push value then fragment in one loop. Numbering follows push order, not request order. Test numeric/boolean filters with != null so 0 is not dropped."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_params_length", "label": "Placeholder from params.length", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$n is 1-based; params.length after the push is the number. A separate i++ drifts when a branch increments without pushing."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_parameter_binding", "label": "Bound parameter cannot become SQL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The statement is parsed before the value is bound. apple'; DROP TABLE \u2026 as $1 returned 0 rows and left the table intact."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_any_array", "label": "= ANY($1::bigint[])", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One array parameter keeps statement text constant across list lengths. Empty ANY('{}') matches nothing; generated IN () is a syntax error."}, {"id": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_omit_empty_where", "label": "Omit WHERE when there are no filters", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emit the keyword only if where.length > 0. WHERE 1=1 works but leaves a permanently true predicate in every plan and log."}], "edges": [{"source": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_one_pass_builder", "target": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_params_length", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_one_pass_builder", "target": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_parameter_binding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-9-api-crud/03-safe-dynamic-where/01-predicates-and-params.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_one_pass_builder", "target": "docs_postgresql_pages_phase_9_api_crud_03_safe_dynamic_where_01_predicates_and_params_omit_empty_where", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgr