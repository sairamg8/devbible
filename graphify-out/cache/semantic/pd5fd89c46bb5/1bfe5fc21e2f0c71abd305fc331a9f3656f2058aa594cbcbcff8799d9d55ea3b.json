{"nodes": [{"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_page", "label": "Outbound client discipline", "file_type": "document", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared client, a deadline, bounded retries with backoff, Retry-After honoured, idempotency on money."}, {"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_one_client", "label": "One client per dependency", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared module owns the pool bound, auth header, default deadline and metrics so payment bursts cannot starve email."}, {"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_retry_policy", "label": "Retry only what is safe", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transport-before-bytes, 502/503/504, 429 after Retry-After, and GETs. Timed-out writes only with a key. Never 4xx besides 429."}, {"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_backoff_jitter", "label": "Exponential backoff with jitter", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without jitter every instance retries together and the recovering upstream meets a thundering herd."}, {"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_retry_after", "label": "Retry-After", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authoritative over computed backoff. Seconds or an HTTP date. Ignoring it turns a rate limit into a ban."}, {"id": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_idempotency_key", "label": "Idempotency-Key", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generate once per logical operation and reuse across retries. A new key per attempt creates a second charge."}], "edges": [{"source": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_one_client", "target": "docs_nodejs_pages_phase_5_http_processes_07_keep_alive_and_agents_undici_dispatcher", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_retry_policy", "target": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_idempotency_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-5-http-processes/08-outbound-client-discipline.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_retry_policy", "target": "docs_nodejs_pages_phase_5_http_processes_08_outbound_client_discipline_retry_after", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/p