{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_triple", "label": "Specificity triple (A,B,C)", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A=ids, B=classes/attributes/pseudo-classes, C=types/pseudo-elements. * combinators and :where() add nothing."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_lexicographic", "label": "Lexicographic specificity compare", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare left to right; no carrying. #nav (1,0,0) beats thirteen classes. Not a base-10 number."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_functional", "label": ":is() :not() :has() specificity", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They add no weight of their own; they take the most specific argument. One id in the list raises every match."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_where", "label": ":where() zero specificity", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always 0,0,0 regardless of contents \u2014 the tool for overridable resets and library defaults."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_nesting", "label": "Nesting & specificity", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "& behaves like :is(): a parent list containing an id raises every nested rule."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_flat", "label": "Flat specificity strategy", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not fight: :where() for defaults, @layer for precedence, one class per component rule, never style by id."}, {"id": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_w3c_selectors_l4", "label": "W3C Selectors Level 4 \u00a717", "file_type": "document", "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_triple", "target": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_lexicographic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-counted-properly.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_functional", "target": "build_css_p2_docs_css_pages_phase_2_cascade_specificity_counted_properly_triple", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-2-cascade/specificity-count