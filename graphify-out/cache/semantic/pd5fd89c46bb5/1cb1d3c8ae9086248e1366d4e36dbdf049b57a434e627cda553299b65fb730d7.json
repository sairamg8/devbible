{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_three_hooks", "label": "Three consumers, three hooks", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Style on class, state on data-*/aria-*, tests on data-testid, script on data-* or js-; one consumer per hook so a rename stays local."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_state_attributes", "label": "State on attributes", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single data-state value cannot accumulate stale classes; styling aria-* keeps visual and announced state the same. Specificity stays 0,1,0."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_data_testid", "label": "Never style on data-testid", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test id must stay stable and meaningless; CSS on it makes renaming a visual regression."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_has_no_hook", "label": ":has() removes state hooks", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "body:has(dialog[open]) and .field:has(:user-invalid) delete the JS that used to sync a class."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_js_prefix", "label": "js- prefix convention", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "js-submit is queried, never styled; btn--primary is styled, never queried."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_three_hooks", "target": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_state_attributes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_three_hooks", "target": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_data_testid", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_three_hooks", "target": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_js_prefix", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_has_no_hook", "target": "build_css_p2_docs_css_syllabus_how_css_works_has", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/styling-hooks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_styling_hooks_state_attributes", "target": "build_css_p2_docs_css_pages_phase_1_selectors_the_selector_families_five_families"