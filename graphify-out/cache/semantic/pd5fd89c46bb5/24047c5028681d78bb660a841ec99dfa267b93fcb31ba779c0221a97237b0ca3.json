{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_09_switch_strict_equality", "label": "switch uses ===", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/09-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "switch(1) and switch('1') differ. switch(NaN) matches no case NaN. Convert form/query strings before switching."}, {"id": "docs_javascript_pages_phase_2_operators_09_switch_fallthrough", "label": "switch fallthrough", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/09-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without break/return/throw, execution continues. Stacked empty cases are idiomatic. Prefer return over break. Comment non-empty fallthrough."}, {"id": "docs_javascript_pages_phase_2_operators_09_switch_single_block", "label": "switch body is one block", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/09-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cases are labels, not scopes. Two let x declarations collide. Brace each case body."}, {"id": "docs_javascript_pages_phase_2_operators_09_switch_exhaustive_default", "label": "Exhaustive default that throws", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-2-operators/09-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Omitted default is a silent no-op. Throw so new statuses are loud; TypeScript never checks pair with this."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_09_switch_strict_equality", "target": "docs_javascript_pages_phase_1_values_and_coercion_16_object_is_and_zero_strict_equality", "relation": "shares_data_with", "confidence": "EXTRA