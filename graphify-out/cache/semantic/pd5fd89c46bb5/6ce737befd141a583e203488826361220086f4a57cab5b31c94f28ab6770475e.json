{"nodes": [{"id": "docs_expressjs_pages_phase_4_responses_03_response_shapes_response_shapes", "label": "Response shapes", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick envelope vs bare resource and keep it consistent. Mixing both is worse than either choice. Express has no opinion; res.json just JSON.stringifies what you hand it."}, {"id": "docs_expressjs_pages_phase_4_responses_03_response_shapes_bare_resource", "label": "Bare resource response", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches pure REST textbooks and OpenAPI components cleanly; no wrapper nesting."}, {"id": "docs_expressjs_pages_phase_4_responses_03_response_shapes_envelope", "label": "Envelope response", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Envelopes extend with pagination meta without breaking clients; they add nesting noise."}, {"id": "docs_expressjs_pages_phase_4_responses_03_response_shapes_stable_error_shape", "label": "Stable error JSON shape", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients parse one schema; you can add code without breaking UIs. Shape is { error: { code, message } }."}, {"id": "docs_expressjs_pages_phase_4_responses_03_response_shapes_json_stringify_omits_undefined", "label": "JSON.stringify omits undefined", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An envelope field set to undefined disappears from the response rather than appearing as null. Make absent-vs-null an explicit decision."}], "edges": [{"source": "docs_expressjs_pages_phase_4_responses_03_response_shapes_response_shapes", "target": "docs_expressjs_pages_phase_4_responses_03_response_shapes_bare_resource", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_03_response_shapes_response_shapes", "target": "docs_expressjs_pages_phase_4_responses_03_response_shapes_envelope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_03_response_shapes_response_shapes", "target": "docs_expressjs_pages_phase_4_responses_03_response_shapes_stable_error_shape", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_03_response_shapes_json_stringify_omits_undefined", "target": "docs_expressjs_pages_phase_4_responses_03_response_shapes_envelope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/03-response-shapes.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_03_response_shapes_bare_resource", "target": "docs_expressjs_pages_phase_4_responses_03