{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_three_approaches", "label": "enum vs CHECK vs lookup table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/11-enum-check-lookup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invalid value SQLSTATEs: enum 22P02, CHECK 23514, FK 23503. Enum 4-byte OID, ~18% smaller (7080 vs 8656 kB / 200k). All three arrive in Node as strings."}, {"id": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_enum_rigidity", "label": "Enum cannot drop values", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/11-enum-check-lookup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0A000 dropping an enum value is not implemented. ALTER TYPE ADD VALUE then using it in the same transaction is 55P04, breaking atomic migrations. Enums sort by declaration order."}, {"id": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_lookup_default", "label": "Default to a lookup table", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/11-enum-check-lookup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a value is an INSERT (3.4 ms), not DDL, and can carry label, colour, sort_order, is_terminal. CHECK re-validates every row (62.9 ms / 200k) unless NOT VALID then VALIDATE."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_enum_rigidity", "target": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_three_approaches", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/11-enum-check-lookup.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_lookup_default", "target": "docs_postgresql_pages_phase_2_types_11_enum_check_lookup_three_approaches", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/11-enum-check-lookup.md", "source_location": null, "weight": 1.0}], "hyperedges": []}