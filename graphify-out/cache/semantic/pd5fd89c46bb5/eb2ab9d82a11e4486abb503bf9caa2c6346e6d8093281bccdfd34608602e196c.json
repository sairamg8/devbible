{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_hybrid_schema", "label": "Hybrid columns plus jsonb", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promote queried keys to columns; keep the varying remainder as jsonb. Generated STORED columns migrate without a write-path change."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_storage_multiplier", "label": "jsonb key-name storage cost", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same two facts: 22 MB as jsonb vs 1736 kB as columns (~13x) because key names repeat per row."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_no_fk_into_jsonb", "label": "No foreign key into a jsonb key", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK on presence/range works; FOREIGN KEY from a jsonb key is 42601."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_hybrid_schema", "target": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_storage_multiplier", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_hybrid_schema", "target": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_02_containment_and_jsonpath_shallow_merge",