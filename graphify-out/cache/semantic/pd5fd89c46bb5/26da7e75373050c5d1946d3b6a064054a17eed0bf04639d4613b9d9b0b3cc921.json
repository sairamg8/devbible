{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector", "label": "pgvector \u2014 embeddings and HNSW", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_not_bundled", "label": "pgvector is not in the stock image", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absent from postgres:18-alpine, not merely uninstalled. Needs pgvector/pgvector:pg18 or a provider that ships it."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_distance_operators", "label": "vector distance operators", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<-> L2, <=> cosine, <#> negative inner product. All are distances so ORDER BY ASC is nearest-first. Dimension mismatches raise 22000."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_hnsw", "label": "HNSW approximate index", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "50000 384-dim vectors: exact 88 ms \u2192 HNSW 2.1 ms (42\u00d7). Build 22.9 s, index 98 MB vs 78 MB table. Results are approximate."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_ef_search", "label": "ef_search recall knob", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On well-separated clusters recall was 10/10 at every setting; raising ef_search only added latency 1.2\u21924.5 ms. Measure recall on your vectors."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_dimension_limit", "label": "HNSW 2000-dimension cap", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vector column holds up to 16000 dimensions; HNSW indexes cap at 2000 (54000 at 2001). halfvec indexes up to 4000."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector", "target": "docs_postgresql_pages_phase_12_beyond_tables_09_extensions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_not_bundled", "target": "docs_postgresql_pages_phase_12_beyond_tables_09_extensions_available_vs_installed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_hnsw", "target": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_distance_operators", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_ef_search", "target": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_hnsw", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_dimension_limit", "target": "docs_postgresql_pages_phase_12_beyond_tables_17_pgvector_hnsw", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/17-pgvector.md", "source_location": null, "weight": 1.0}], "hyperedges": []}