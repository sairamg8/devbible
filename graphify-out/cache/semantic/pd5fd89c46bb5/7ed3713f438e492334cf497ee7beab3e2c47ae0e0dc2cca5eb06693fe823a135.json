{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_page", "label": "nextTick starvation", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_nexttick_starvation", "label": "nextTick starvation", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursive process.nextTick never empties the queue, so the loop never advances. Process stays alive at 100% CPU with no error; timers, I/O and setImmediate never run."}, {"id": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_drain_to_exhaustion", "label": "nextTick drain-to-exhaustion rule", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The nextTick queue drains including entries added during draining. Bounded recursion still delays the loop for the whole drain; await cannot fix it because microtasks also drain before the loop."}, {"id": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_setimmediate_safe_recursion", "label": "Recursive setImmediate does not starve", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setImmediate schedules into check, one turn per lap, so timers fire and I/O is served. Recursion belongs on setImmediate, never on nextTick."}, {"id": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_delay_metric_blind_spot", "label": "Event loop delay cannot detect starvation", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metric is sampled by a timer, and timers never run while starved. Use --cpu-prof or attach the inspector instead."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_page", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_nexttick_starvation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_drain_to_exhaustion", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_nexttick_starvation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_setimmediate_safe_recursion", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_nexttick_starvation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_delay_metric_blind_spot", "target": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_nexttick_starvation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/05-nexttick-starvation.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_05_nexttick_starvation_setimmediate_safe_recursion", "target": "docs_nodejs_pages_phase_2_a