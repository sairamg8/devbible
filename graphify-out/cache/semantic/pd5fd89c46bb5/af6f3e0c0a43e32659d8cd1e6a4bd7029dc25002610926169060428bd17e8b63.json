{"nodes": [{"id": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_ieee754", "label": "Numbers are IEEE-754 doubles", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One numeric type. 0.1 + 0.2 is 0.30000000000000004 because 0.1 is a repeating binary fraction. Not JS-specific."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_money_minor_units", "label": "Money as integer minor units", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store paise or cents. Arithmetic in integers. Round once explicitly. Divide by 100 only when formatting with Intl.NumberFormat."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_max_safe_integer", "label": "Number.MAX_SAFE_INTEGER", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2^53-1 = 9007199254740991. Beyond it distinct integers collapse: MSI+1 === MSI+2."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_json_parse_large_ids", "label": "JSON.parse corrupts large integer IDs", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse turns numbers into doubles. Send IDs as strings, or recover digits via the reviver ctx.source and BigInt."}, {"id": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_tofixed", "label": "toFixed is not a rounding function", "file_type": "concept", "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(1.005).toFixed(2) is '1.00' because 1.005 is stored slightly low. It also returns a string."}], "edges": [{"source": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_ieee754", "target": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_money_minor_units", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_ieee754", "target": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_max_safe_integer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_tofixed", "target": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_money_minor_units", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-1-values-and-coercion/06-numbers-are-doubles.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_max_safe_integer", "target": "docs_javascript_pages_phase_1_values_and_coercion_06_numbers_are_doubles_json_parse_large_ids", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1