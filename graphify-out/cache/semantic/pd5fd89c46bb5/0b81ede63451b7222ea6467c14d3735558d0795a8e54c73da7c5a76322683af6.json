{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_table_inheritance", "label": "Table inheritance", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/inheritance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NOT NULL and CHECK inherit; PK, UNIQUE and FK do not. Two child rows can share id 1. Parent FKs do not see child rows. Avoid for new work."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_declarative_partitioning", "label": "Declarative partitioning", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/inheritance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces the key across partitions (23505). Unmatched partition key \u2192 23514. Every unique constraint must include the partition key."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_only", "label": "ONLY keyword", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/inheritance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without ONLY, SELECT/UPDATE/DELETE on a parent include children. DELETE FROM parent can wipe child rows."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_declarative_partitioning", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_table_inheritance", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/inheritance.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_only", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_inheritance_table_inheritance", "