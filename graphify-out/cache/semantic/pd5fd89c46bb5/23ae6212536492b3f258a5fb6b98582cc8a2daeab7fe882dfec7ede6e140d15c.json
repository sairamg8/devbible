{"nodes": [{"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "label": "node:fs/promises", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default filesystem API. Every operation returns a promise, errors are ordinary exceptions with a code, nothing blocks the event loop."}, {"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_writefile_truncates", "label": "writeFile truncates", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "writeFile overwrites an existing file. appendFile or { flag: 'a' } appends; { flag: 'wx' } fails with EEXIST if the file exists."}, {"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_err_code", "label": "fs error codes", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch on err.code never err.message. ENOENT, EEXIST, EACCES, EISDIR, ENOSPC, EMFILE, EXDEV. Swallowing every error hides EACCES as an empty config."}, {"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_rename_atomic", "label": "rename atomicity", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic within one filesystem. EXDEV across devices \u2014 common when /tmp is a separate mount. Put the temp file in the destination directory."}, {"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_thread_pool", "label": "fs on libuv thread pool", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200 async reads 45 ms with 23 timer ticks; 200 sync reads 86 ms with 0 ticks. Unbounded Promise.all still hits EMFILE."}, {"id": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_readfile_vs_stream", "label": "readFile vs stream", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "readFile is correct for bounded small files. If a user controls size, stream and cap \u2014 peak RSS is file size \u00d7 concurrency."}], "edges": [{"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_writefile_truncates", "target": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_err_code", "target": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_rename_atomic", "target": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_thread_pool", "target": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_readfile_vs_stream", "target": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_fs_promises", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_4_filesystem_01_fs_promises_readfile_vs_stream", "target": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_constant_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-4-filesystem/01-fs-promises.md", "source_location": null, "weight": 1.0}], "hyperedges": []}