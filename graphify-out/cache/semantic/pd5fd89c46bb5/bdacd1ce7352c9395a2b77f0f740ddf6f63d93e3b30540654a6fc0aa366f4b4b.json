{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_pool_vs_client", "label": "Pool vs Client", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-vs-client.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Pool almost always. pool.query borrows, runs, and returns; two calls may land on different connections."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_session_state_needs_checkout", "label": "Session state needs a checked-out client", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-vs-client.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transactions, SET, cursors, advisory locks and named prepared statements cannot use pool.query because session state lives on one connection."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_listen_needs_client", "label": "LISTEN needs a bare Client", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-vs-client.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only common case for new pg.Client(): a long-lived listener with a bound handler. Pooling buys nothing and would hand the connection away."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_pool_vs_client", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_session_state_needs_checkout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/pool-vs-client.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_p