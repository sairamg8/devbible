{"nodes": [{"id": "docs_react_pages_phase_2_components_07_destructuring_and_defaults_page", "label": "Destructuring and default values", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/07-destructuring-and-defaults.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_07_destructuring_and_defaults_defaultprops_removed", "label": "defaultProps removed for function components", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/07-destructuring-and-defaults.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced by ES6 default parameters. Class components keep defaultProps \u2014 there is no ES6 equivalent for a class's props."}, {"id": "docs_react_pages_phase_2_components_07_destructuring_and_defaults_proptypes_silent", "label": "propTypes is silently ignored in React 19", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/07-destructuring-and-defaults.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error, no warning. The migration hazard is the silence. TypeScript is the documented replacement."}, {"id": "docs_react_pages_phase_2_components_07_destructuring_and_defaults_default_only_undefined", "label": "Default parameters fire only on undefined", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/07-destructuring-and-defaults.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null, 0, '' and false suppress the default. For props that can be null, use ?? in the body."}, {"id": "docs_react_pages_phase_2_components_07_destructuring_and_defaults_nullish_vs_or", "label": "?? rather than || for fallbacks", "file_type": "rationale", "source_file": "docs/