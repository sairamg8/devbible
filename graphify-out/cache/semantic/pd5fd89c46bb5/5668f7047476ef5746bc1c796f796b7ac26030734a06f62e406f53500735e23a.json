{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_page", "label": "Unit, integration and e2e", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/03-unit-integration-e2e.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Categories are about what you replace, not size. 50-test unit suite 0.22 s; Postgres container start ~5.6 s."}, {"id": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_test_layers", "label": "Unit vs integration vs e2e", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/03-unit-integration-e2e.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draw the boundary at I/O. Many unit, some integration (one real dependency), few e2e on money paths. Separate by filename glob, not experimental tags."}, {"id": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_mock_if_risk_removed", "label": "Do not mock the thing that can be wrong", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/03-unit-integration-e2e.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If mocking the dependency removes the risk, it is an integration test. Do not mock the DB driver. An in-memory SQLite is not Postgres."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_page", "target": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_test_layers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/03-unit-integration-e2e.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_page", "target": "docs_nodejs_pages_phase_9_testing_03_unit_integration_e2e_mock_if_risk_removed", "relation": "