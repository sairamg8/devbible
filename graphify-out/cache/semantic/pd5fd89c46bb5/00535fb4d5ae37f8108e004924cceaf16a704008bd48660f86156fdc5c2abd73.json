{"nodes": [{"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_four_levels", "label": "Four-level namespace", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cluster \u2192 database \u2192 schema \u2192 relation. Confusing any two levels is the root of relation does not exist bugs and multi-tenant layout mistakes."}, {"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_cluster", "label": "Cluster", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One data directory / one running server instance. You do not switch cluster without a new connection target."}, {"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_database", "label": "Database", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named catalog inside the cluster; a connection picks exactly one. Stronger isolation than schemas, but no ordinary cross-database joins without FDW."}, {"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_schema", "label": "Schema", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Namespace inside one database (public, app, billing). Not a separate database. Default landing place is public."}, {"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_search_path", "label": "search_path", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schemas checked for unqualified names, in order. Measured default \"$user\", public. Session state, changeable with SET search_path; attacker-influenced path is a later least-privilege topic."}, {"id": "docs_postgresql_pages_phase_0_architecture_03_namespace_qualified_names", "label": "Qualify names in migrations", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always write app.users, not bare users, so a path change cannot silently hit another table."}], "edges": [{"source": "docs_postgresql_pages_phase_0_architecture_03_namespace_four_levels", "target": "docs_postgresql_pages_phase_0_architecture_03_namespace_cluster", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_03_namespace_four_levels", "target": "docs_postgresql_pages_phase_0_architecture_03_namespace_database", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_03_namespace_four_levels", "target": "docs_postgresql_pages_phase_0_architecture_03_namespace_schema", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-0-architecture/03-namespace.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_0_architecture_03_namespace_search_path", "target": "docs_postgresql_pages_ph