{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_suspends_at_await", "label": "Exactly where await suspends", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level code up to and including the first await runs synchronously. At await, control exits and returns to the caller."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_awaited_expression_runs_now", "label": "Awaited expression runs immediately", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await fetch(url) starts the request now; only the waiting is deferred. Starting several calls then awaiting them is concurrency."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_always_one_tick", "label": "await always costs one tick", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even an already-fulfilled promise or await null still pauses until the next microtask. No fast path."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_top_level_await", "label": "Top-level await", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowed in modules only, not CommonJS. Delays evaluation of every importing module; reserve for genuine initialisation."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_thenables", "label": "await assimilates thenables", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await cares about the then shape, not the class. An object with an unrelated then field is assimilated."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_suspends_at_await", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_always_a_promise_async_always_returns_promise", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_suspends_at_await", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_awaited_expression_runs_now", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_always_one_tick", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_task_vs_microtask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/where-it-suspends.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javasc