{"nodes": [{"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_page", "label": "Attributes vs props", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_four_outcomes", "label": "Four host-prop outcomes", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A JSX prop on a host element is renamed, passed through, dropped, or \u2014 in React 19 \u2014 class/for accepted with a warning."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_classname_htmlfor", "label": "className and htmlFor", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "class and for are reserved words. Raw class/for also reach the DOM since React 16, with a development warning."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_onclick_dropped", "label": "onclick is silently dropped", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown on* is parsed as an event and discarded. Production prints nothing. Highest-cost typo on the page."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_boolean_attributes", "label": "Boolean host attributes", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known booleans: true emits the empty attribute, false removes it. disabled=\"false\" is truthy. aria-* and data-* stringify."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_null_removes", "label": "null/undefined remove attributes", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idiomatic conditional omit: href={isExternal ? url : undefined}."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_unknown_host_props", "label": "Unknown host props", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "String/number: lowercased with a warning. Boolean: dropped. on*: dropped as unknown event."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_style_must_be_object", "label": "style must be an object", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A string throws. The one attribute where pasted HTML fails loudly."}, {"id": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_prop_vs_attribute", "label": "Prop vs attribute", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/04-attributes-vs-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A prop is a JSX object key. An attribute is what lands in the DOM. Host elements are mapped; custom components are not."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_page", "target": "docs_react_pages_phase_1_jsx_04_attributes_vs_props_four_outcomes", "relation": "references", "confidence": "EXTRACTE