{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_two_jobs", "label": "tsconfig.json two jobs", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines which files are the project (include/exclude/files/references) and what rules they are checked under (compilerOptions)."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_types_empty", "label": "\"types\": [] ambient inclusion off", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default auto-includes every @types/* found walking up node_modules. [] means none unless imported. Measured: 5.9.3 pulled @types/mdx from three directories up."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_exclude_not_absolute", "label": "exclude only removes roots", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An excluded file imported by an included file is still checked. exclude is not a veto."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_isolated_modules", "label": "isolatedModules", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantee every file can be transpiled alone. Rejects type re-exports without export type, const enum, ambient-only scripts."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_verbatim_module_syntax", "label": "verbatimModuleSyntax", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emit imports exactly as written. Forces import type for type-only imports; removes compiler guesswork a single-file transpiler cannot perform."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_tsc_init_scaffold", "label": "tsc --init TypeScript 7 scaffold", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nodenext, esnext, types:[], strict, noUncheckedIndexedAccess, exactOptionalPropertyTypes, verbatimModuleSyntax, isolatedModules, skipLibCheck. No include/outDir/rootDir."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_types_empty", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_two_jobs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/tsconfig-anatomy.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_exclude_not_absolute", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_tsconfig_anatomy_two_jobs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-t