{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_page", "label": "Statistics, ANALYZE and extended statistics", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_analyze", "label": "ANALYZE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The planner plans against a sample, not live data. Last step of every bulk load. Takes SHARE UPDATE EXCLUSIVE so reads and writes continue."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_pg_stats", "label": "pg_stats", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null_frac, n_distinct, most_common_vals/freqs, correlation. n_distinct -1 means unique per row; negative fraction scales with table size. reltuples=-1 means never analyzed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_extended_statistics", "label": "Extended statistics", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE STATISTICS (dependencies, ndistinct, mcv) ON correlated columns. Independence assumed otherwise: 33607 estimated vs 100000 actual, corrected to 100990."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_default_statistics_target", "label": "default_statistics_target", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Histogram buckets and MCV count. Raise per column with ALTER COLUMN SET STATISTICS, not globally. Target 1000 took 1309 ms ANALYZE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_autovacuum_analyze", "label": "autovacuum analyze threshold", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires at threshold + scale_factor \u00d7 reltuples (50 + 10%). Too late on large tables; lower autovacuum_analyze_scale_factor to 0.01."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_analyze", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_pg_stats", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_statistics_extended_statistics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/statistics.html", "source_location": null, "weight": 1.0}, {"source": "bu