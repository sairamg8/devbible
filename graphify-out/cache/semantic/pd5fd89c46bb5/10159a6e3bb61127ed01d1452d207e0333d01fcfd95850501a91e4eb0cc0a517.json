{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "label": "Why streams exist", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process data in chunks so peak memory stays constant. Buffered 216 MB log peaked 670 MB RSS vs 88 MB streamed."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_err_string_too_long", "label": "ERR_STRING_TOO_LONG", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8 strings cap at 0x1fffffe8 characters (~512 MB). readFile(path,'utf8') on a larger file throws with no workaround except streaming."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_time_to_first_byte", "label": "Time to first byte", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A streamed response sends as soon as the first chunk exists; buffering waits for the last byte and can time out proxies."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_default_highwatermark", "label": "Default highWaterMark 64 KB", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stream.getDefaultHighWaterMark(false) is 64 KB (raised from 16 KB in Node 22). Chunks split lines, JSON, and multi-byte characters freely."}, {"id": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_when_not_to_stream", "label": "When not to stream", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer bounded small data (config, 10 KB JSON). Streams add backpressure complexity and cannot JSON.parse or sort without a streaming parser."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_err_string_too_long", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_time_to_first_byte", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_when_not_to_stream", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_default_highwatermark", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_default_highwatermark", "target": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_string_decoder_stringdecoder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_3_buffers_streams_why_streams_constant_memory", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_file_streams_createreadstream", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-3-buffers-streams/why-streams.html", "source_location": null, "weight": 1.0}], "hyperedges": []}