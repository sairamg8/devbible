{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_lateral", "label": "LATERAL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A FROM subquery may reference tables to its left and run once per driving row. Without LATERAL that reference is 42P01."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_left_join_on_true", "label": "LEFT JOIN LATERAL \u2026 ON true", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CROSS JOIN LATERAL drops empty driving rows. LEFT JOIN LATERAL requires ON true because matching already happened in WHERE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_top_n_per_group", "label": "LATERAL top-N per group", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a real 500-row group table and an index, LATERAL was 9.3 ms vs 51.8 ms for row_number(). Drive from a dimension table."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_left_join_on_true", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_lateral", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_top_n_per_group", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_lateral", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_lateral_left_join_on_true", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_left_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/lateral.html", "source_location": null, "weight": 1.0}], "hyperedges": []}