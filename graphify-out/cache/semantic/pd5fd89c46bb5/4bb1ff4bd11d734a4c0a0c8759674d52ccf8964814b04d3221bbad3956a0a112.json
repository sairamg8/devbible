{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_proto_colon_setter", "label": "__proto__ colon form prototype setter", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the literal colon form sets [[Prototype]]. A non-object non-null value does nothing at all. Shorthand and computed forms create ordinary properties. Duplicate colon forms are a SyntaxError."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_json_proto_ordinary", "label": "JSON __proto__ is an ordinary key", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.parse is safe: __proto__ becomes a plain own property. Pollution happens in a later recursive merge that assigns through Object.prototype's accessor."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_prototype_pollution", "label": "Prototype pollution", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigning target['__proto__'] from untrusted JSON pollutes Object.prototype for every object, including ones created earlier. Defend with Object.create(null), skip dangerous keys, or defineProperty."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_object_create_null", "label": "Object.create(null) dictionary", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No inherited keys and no __proto__ accessor. Cost: no toString or hasOwnProperty; string conversion throws. Prefer Map unless you need a plain-object shape."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_proto_colon_setter", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_duplicate_keys_last_wins", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_prototype_pollution", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_json_proto_ordinary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_object_create_null", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_prototype_pollution", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/01-object-literals/04-proto-and-null-prototype.md", "source_location": null, "weight": 1.0}, {"source": "docs_jav