{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_many", "label": "One-to-many relationship", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FK on the many side. NOT NULL makes it mandatory; ON DELETE CASCADE or RESTRICT; always index the referencing column (measured 4\u00d7 slower unindexed)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_one", "label": "One-to-one via unique FK", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make the FK the primary key of the child. Without uniqueness it is one-to-many wearing a one-to-one name (second profile \u2192 23505)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_many_to_many", "label": "Many-to-many join table", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Join table with PRIMARY KEY (a_id, b_id). A surrogate id would permit the duplicate the composite key forbids."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_composite_key_index_trap", "label": "Composite key serves one direction", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 20k join rows, WHERE post_id used Index Only Scan; WHERE tag_id did Seq Scan. Almost always add a second index on the trailing column."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_self_referencing_tree", "label": "Self-referencing tree", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "parent_id nullable marks a root. ON DELETE CASCADE deletes whole subtrees. Arbitrary depth needs a recursive CTE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_join_table_as_entity", "label": "Join table becomes an entity", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the relationship carries role, joined_at, quantity it deserves a domain name (memberships). Add a surrogate only if something must reference the relationship."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_many", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_one", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_one_to_one", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_many_to_many", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/relationships.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_many_to_many", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_relationships_composite_key_index_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "