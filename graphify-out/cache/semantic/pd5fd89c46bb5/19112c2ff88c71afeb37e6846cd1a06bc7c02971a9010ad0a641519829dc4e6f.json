{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_style_invalidation", "label": "Style invalidation breadth", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matching cost is rarely the bottleneck; jank comes from how much of the tree must restyle when state changes."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_right_to_left_matching", "label": "Right-to-left selector matching", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engines start from the rightmost compound so the candidate set is small and failed ancestors prune fast."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_key_selector_bucketing", "label": "Key selector bucketing", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An element is only tested against rules whose rightmost part could match it."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_has_cost", "label": ":has() matching cost", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relational matching is slower than a class (1.25 ms vs 0.15 ms on 5000 nodes) but only hurts when the subject is huge and the argument changes every frame."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_delete_unused_css", "label": "Delete unused CSS", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one selector-performance win that reliably pays: fewer bytes, less parse, fewer rules to bucket."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_style_invalidation", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_right_to_left_matching", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_right_to_left_matching", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_key_selector_bucketing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_has_cost", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_style_invalidation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/selector-performance.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_delete_unused_css", "target": "build_css_p2_docs_css_pages_phase_1_selectors_selector_performance_style_invalidation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selec