{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_restoring", "label": "Restoring", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_restore_cost", "label": "Restore costs far more than dump", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 2.55 s dump vs 10.29 s restore. Restore inserts rows, rebuilds every index, revalidates constraints and writes WAL."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_parallel_across_items", "label": "pg_restore -j parallelises across items", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One dominant table cannot be split. -j 4 was 10.06 s vs 10.29 s serial. Parallel dump requires -Fd; -Fc -j is a hard error."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_pg_restore_continues", "label": "pg_restore continues after errors", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "relation already exists is reported and the run keeps going. Use --exit-on-error in automation, --clean --if-exists to replace, or restore into a new database and rename."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_selective_restore_indexes", "label": "Selective restore leaves indexes behind", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_restore -t restores the table item, not separate index and constraint items. The table accepts duplicates with no error."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_dump_snapshot", "label": "pg_dump REPEATABLE READ snapshot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1000 rows inserted during the dump appeared in the source and zero in the restore. Parallel workers share the leader snapshot via pg_export_snapshot. The long transaction holds the xmin horizon."}, {"id": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_dump_access_share", "label": "pg_dump ACCESS SHARE lock", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads and writes proceed; ALTER/DROP/TRUNCATE/VACUUM FULL wait. A waiting ALTER then blocks everything queued behind it. Do not run migrations and dumps in the same window."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_restore_cost", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_readme_logical_backup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_parallel_across_items", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_custom_format_fc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_dump_snapshot", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_dump_access_share", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_02_restoring_pg_restore_continues", "target": "docs_postgresql_pages_phase_13_ops_04_pg_dump_restore_01_dump_formats_roles_not_in_pg_dump", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/04-pg-dump-restore/02-restoring.md", "source_location": null, "weight": 1.0}], "hyperedges": []}