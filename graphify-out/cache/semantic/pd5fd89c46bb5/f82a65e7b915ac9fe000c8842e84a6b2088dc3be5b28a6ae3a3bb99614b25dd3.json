{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_logic_that_belongs_to_an_event", "label": "Logic that belongs to an event", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_share_with_function", "label": "Share handler logic with a plain function", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hoisting shared follow-up into an Effect fires it on mount and every product change. An ordinary function in the component body is enough."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_post_causation", "label": "Same POST, opposite homes", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "visit_form analytics stays in an Effect because the form was displayed. Registration POST belongs in handleSubmit because the user pressed the button."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_state_as_trigger", "label": "State-as-a-trigger antipattern", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setJsonToSubmit in the handler plus an Effect that posts when it is non-null reconstructs intent after the fact. Both the state and the Effect should disappear."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_post_causation", "target": "build_css_p2_docs_react_pages_phase_4_effects_cleanup_when_cleanup_is_not_the_answer_buying_a_product", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_you_might_not_need_an_effect_logic_that_belongs_to_an_event_share_with_function", "target": "build_css_p2_docs_react_pages_phase_4_effects_what_an_effect_is_for_effects_vs_events", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/you-might-not-need-an-effect/logic-that-belongs-to-an-event.html", "source_location": null, "weight": 1.0}], "hyperedges": []}