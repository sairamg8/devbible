{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npm_day_to_day", "label": "npm day to day", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dozen commands you actually run, and two decisions: which list a package belongs in, and whether this machine should resolve ranges."}, {"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_omit_dev", "label": "npm ci --omit=dev", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What production installs. Getting dependencies vs devDependencies wrong fails only in production."}, {"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npx", "label": "npx", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves a local binary first, then downloads to a cache and executes without installing. A typo'd package name is a real attack vector."}, {"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_avoid_global_installs", "label": "Avoid global npm installs", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global packages are unversioned, invisible to the project, and differ per machine. Put the tool in devDependencies or use npx."}, {"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npm_explain", "label": "npm explain", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prints the dependency chain that pulled a package in. Do not import a transitive package directly."}, {"id": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_save_exact", "label": "save-exact", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes npm install write exact versions instead of ^ ranges. Useful for applications; less so for libraries."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_omit_dev", "target": "docs_nodejs_pages_phase_1_modules_07_package_json_dependency_kinds", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_omit_dev", "target": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_npm_ci", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npx", "target": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npm_day_to_day", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/10-npm-day-to-day.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_avoid_global_installs", "target": "docs_nodejs_pages_phase_1_modules_10_npm_day_to_day_npm_day_to_day", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-m