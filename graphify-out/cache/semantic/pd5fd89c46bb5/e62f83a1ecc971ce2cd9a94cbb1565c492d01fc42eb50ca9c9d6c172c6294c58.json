{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_not_superuser", "label": "Managed role is not SUPERUSER", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RDS gives rds_superuser, not PostgreSQL superuser. No postgresql.conf, pg_hba, often no ALTER SYSTEM, no arbitrary extensions, no server-side COPY from a path."}, {"id": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_parameter_group", "label": "Parameter groups replace config files", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default RDS parameter group cannot be edited. Custom group + attach; static vs dynamic is the same restart/reload distinction as pg_settings.context."}, {"id": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_extension_allowlist", "label": "Extension allowlist", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE EXTENSION only for vetted extensions. pg_stat_statements is usually already in shared_preload_libraries. Check niche extensions before designing around them."}, {"id": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_restore_still_yours", "label": "Provider backups do not make restore yours", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider guarantees a backup exists, not a practised restore, adequate retention, or coverage of a correct-but-wrong-rows migration. Keep pg_dump."}, {"id": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_illusion_of_delegation", "label": "Illusion of delegation", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated backups, failover and instance tuning do not imply durability, availability or performance are handled. Most managed incidents are application-side."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_not_superuser", "target": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_parameter_group", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_not_superuser", "target": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_extension_allowlist", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_13_managed_postgres_01_what_you_give_up_parameter_group", "target": "docs_postgresql_pages_phase_13_ops_10_config_keys_03_changing_a_setting_pg_settings_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/13-managed-postgres/01-what-you-give-up.md", "sour