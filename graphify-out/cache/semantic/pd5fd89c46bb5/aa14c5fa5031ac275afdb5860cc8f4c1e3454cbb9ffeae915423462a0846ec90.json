{"nodes": [{"id": "docs_postgresql_pages_phase_3_ddl_16_temp_unlogged_unlogged_table", "label": "UNLOGGED table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/16-temp-unlogged.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~1.5\u00d7 faster inserts (150\u219298 ms / 100k). Truncated on crash recovery, never replicated, empty after failover. SET LOGGED/UNLOGGED rewrites (230 ms / 200k)."}, {"id": "docs_postgresql_pages_phase_3_ddl_16_temp_unlogged_temporary_table", "label": "TEMPORARY table", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-3-ddl/16-temp-unlogged.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private to one session (pg_temp_N). Shadows same-named permanent tables via search_path. Lives in temp_buffers (default 8 MB)."}, {"id": "docs_postgresql_pages_phase_3_ddl_16_temp_unlogged_on_commit_drop", "label": "ON COMMIT DROP", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-3-ddl/16-temp-unlogged.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooled connections reuse sessions. A leftover temp table leaks into the next request. Hold one checked-out client; prefer a CTE if the data is one-statement only."}], "edges": [{"source": "docs_postgresql_pages_phase_3_ddl_16_temp_unlogged_unlogged_table", "target": "docs_postgresql_pages_phase_3_ddl_05_alter_table_table_rewrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-3-ddl/16-temp-unlogged.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_3_ddl_16_temp_unlogged_temporary_table", "target": "docs_postgresql_pages_phase_3_ddl_10_schemas_tenancy_search_path", "relation": "conceptually_related_to", "confidence": "E