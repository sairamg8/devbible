{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_page", "label": "Contract testing and consumer-driven contracts", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0 with zod 4.4.3. Where a green unit suite still ships a broken frontend."}, {"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_contract", "label": "Contract test", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests the agreement between sides, not each side's beliefs. A createdAt rename failed the provider suite in 18 ms: expected string, received undefined."}, {"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_consumer_owned", "label": "Consumer-owned contract", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the consumer knows which fields it reads. A provider-written contract describes the implementation and grows to cover everything, so it stops constraining anything."}, {"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_independent_schema", "label": "Contract written independently of the model", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A schema generated from the model cannot fail: both sides agree on the new shape while the frontend still breaks. Independence is the entire mechanism."}, {"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_pact", "label": "Pact consumer-driven contracts", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumer publishes a pact file to a broker; provider replays it in its CI; can-i-deploy gates release. Worth it with several independent teams; one team should share a schema package."}, {"id": "docs_nodejs_pages_phase_9_testing_19_contract_testing_shared_zod", "label": "Shared Zod UserResponse schema", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider validates the real handler; consumer validates the mock. Both sides fail on a breaking change; neither can change it alone."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_19_contract_testing_consumer_owned", "target": "docs_nodejs_pages_phase_9_testing_19_contract_testing_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_19_contract_testing_independent_schema", "target": "docs_nodejs_pages_phase_9_testing_19_contract_testing_shared_zod", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_19_contract_testing_pact", "target": "docs_nodejs_pages_phase_9_testing_19_contract_testing_shared_zod", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_19_contract_testing_contract", "target": "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase_9_api_agreement_testing", "label": "Consumer-owned contracts and expand-migrate-contract keep independently tested sides from drifting", "nodes": ["docs_nodejs_pages_phase_9_testing_19_contract_testing_contract", "docs_nodejs_pages_phase_9_testing_19_contract_testing_shared_zod", "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_expand_migrate_contract", "docs_nodejs_pages_phase_9_testing_20_schema_compatibility_direction_rule"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/19-contract-testing.md"}]}