{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipeline", "label": "stream.pipeline", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/10-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors from any stage in one place; every stream destroyed on any outcome; backpressure wired between stages. Import from node:stream/promises."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipe", "label": ".pipe()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/10-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not forward errors or clean up. A mid-chain failure leaves handles open (EMFILE) or an unhandled error event kills the process."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_abort_signal", "label": "pipeline AbortSignal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/10-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass { signal } so client disconnect tears the chain down with AbortError ABORT_ERR. { end: false } keeps the destination open."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipe_unsafe", "label": "Never .pipe() in a server", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/10-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every .pipe() in a request handler is a latent descriptor leak. After a Transform error, src.destroyed and dst.destroyed were both false."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_10_pipeline_pipe_unsafe", "target": "docs_nodejs_pages_phase_3_buffers_streams_10_pipelin