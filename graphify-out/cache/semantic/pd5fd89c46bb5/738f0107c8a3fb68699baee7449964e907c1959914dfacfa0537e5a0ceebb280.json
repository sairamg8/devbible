{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_page", "label": "05 \u00b7 null vs undefined", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/null-vs-undefined.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_undefined", "label": "undefined (engine absence)", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/null-vs-undefined.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "undefined is absence the engine produced: unassigned binding, missing property, unpassed argument, no return. Prefer omitting the property rather than assigning undefined."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_null", "label": "null (deliberate emptiness)", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/null-vs-undefined.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "null is absence you chose. Defaults do not fire on it; JSON.stringify keeps it. Use it at the boundary to mean 'explicitly cleared' (PATCH)."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_default_parameters", "label": "Default parameters fire only on undefined", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/null-vs-undefined.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_null_vs_undefined_nullish_coalescing", "label": "Nullish coalescing 