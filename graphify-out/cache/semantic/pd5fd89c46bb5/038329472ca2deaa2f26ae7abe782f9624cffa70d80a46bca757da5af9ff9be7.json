{"nodes": [{"id": "docs_react_pages_phase_2_components_15_purecomponent", "label": "Component vs PureComponent and shouldComponentUpdate", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_three_levels", "label": "Component PureComponent shouldComponentUpdate", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always render, shallow skip, or custom comparison. Function equivalents are plain, memo, and memo with a compare function."}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_shallow_comparison", "label": "Shallow comparison Object.is", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New objects, arrays or inline functions each render make the check always fail. You pay the comparison and skip nothing."}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_mutation_exclusive", "label": "PureComponent and mutation are mutually exclusive", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutating then setState of the same reference drops the update silently. Wrong UI, not slow UI."}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_context_still_renders", "label": "Memoization does not stop context updates", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_skipping_is_a_hint", "label": "Skipping a render is a hint not a contract", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React may re-render anyway. Returning false does not stop children when their own state changes. Memoization is never a correctness mechanism."}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_never_deep_compare", "label": "Never deep-compare in shouldComponentUpdate", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.stringify makes cost proportional to data size and breaks on undefined, functions, Map, Set, cycles and key order."}, {"id": "docs_react_pages_phase_2_components_15_purecomponent_memo_props_only", "label": "memo compares props only", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike PureComponent, memo does not compare state because useState already bails out on the same value."}], "edges": [{"source": "docs_react_pages_phase_2_components_15_purecomponent", "target": "docs_react_pages_phase_2_components_15_purecomponent_three_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent_three_levels", "target": "docs_react_pages_phase_2_components_15_purecomponent_memo_props_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent_shallow_comparison", "target": "docs_react_pages_phase_2_components_15_purecomponent_three_levels", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent_mutation_exclusive", "target": "docs_react_pages_phase_2_components_02_purity_01_the_two_rules_purity", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent_skipping_is_a_hint", "target": "docs_react_pages_phase_2_components_15_purecomponent_three_levels", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent", "target": "docs_react_pages_phase_2_components_05_lifting_state_up_02_the_cost_memo_last", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_15_purecomponent_context_still_renders", "target": "docs_react_pages_phase_2_components_15_purecomponent_memo_props_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/15-purecomponent.md