{"nodes": [{"id": "docs_react_pages_phase_4_effects_13_effect_ordering_effect_ordering", "label": "Effect ordering", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three kinds of effect in three passes, and inside each pass every cleanup before any setup."}, {"id": "docs_react_pages_phase_4_effects_13_effect_ordering_three_passes", "label": "Three effect passes per commit", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useInsertionEffect, then DOM mutation, then useLayoutEffect before paint, then browser paint, then useEffect. Each pass finishes across the whole commit."}, {"id": "docs_react_pages_phase_4_effects_13_effect_ordering_all_cleanups_then_all_setups", "label": "All cleanups then all setups", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When any setup runs, everything being torn down in that pass is already gone, including other components. Exclusive resources can transfer safely."}, {"id": "docs_react_pages_phase_4_effects_13_effect_ordering_children_before_parents", "label": "Effects run children before parents", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parent measuring a child needs the child's refs attached. That is why ref.current is null during render and populated in effects."}, {"id": "docs_react_pages_phase_4_effects_13_effect_ordering_useinsertioneffect_interleaves", "label": "useInsertionEffect interleaves cleanup and setup", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One component at a time, unlike other Effects. Refs are not attached yet and you cannot update state. Exists for CSS-in-JS."}, {"id": "docs_react_pages_phase_4_effects_13_effect_ordering_order_not_coordination", "label": "Do not use effect order as coordination", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order explains failures; it is not timing under concurrent rendering, a render is not a commit, and insertion vs DOM mutation is unspecified."}], "edges": [{"source": "docs_react_pages_phase_4_effects_13_effect_ordering_three_passes", "target": "docs_react_pages_phase_4_effects_12_uselayouteffect_uselayouteffect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_13_effect_ordering_all_cleanups_then_all_setups", "target": "docs_react_pages_phase_4_effects_02_useeffect_anatomy_cleanup_then_setup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_13_effect_ordering_all_cleanups_then_all_setups", "target": "docs_react_pages_phase_4_effects_04_cleanup_01_the_cleanup_contract_indistinguishable_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_13_effect_ordering_useinsertioneffect_interleaves", "target": "docs_react_pages_phase_4_effects_13_effect_ordering_all_cleanups_then_all_setups", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_13_effect_ordering_order_not_coordination", "target": "docs_react_pages_phase_4_effects_09_effect_lifecycle_one_sync_process_per_effect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/13-effect-ordering.md", "source_location": null, "weight": 1.0}], "hyperedges": []}