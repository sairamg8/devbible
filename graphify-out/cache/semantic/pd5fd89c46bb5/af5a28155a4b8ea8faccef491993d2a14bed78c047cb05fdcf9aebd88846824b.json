{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_05_environment_parity_environment_parity", "label": "Environment parity", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/05-environment-parity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parity is runtime version, config shape, and dependency graph \u2014 not copying production secrets onto laptops."}, {"id": "docs_nodejs_pages_phase_11_deployment_05_environment_parity_same_runtime_and_lockfile", "label": "Same Node major and lockfile", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/05-environment-parity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same Active LTS line in CI, staging, prod. One lockfile; immutable install. Same variable names, different values."}, {"id": "docs_nodejs_pages_phase_11_deployment_05_environment_parity_honest_staging", "label": "Honest staging", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/05-environment-parity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite in staging while prod uses Postgres is a lie for dialects, transactions, and concurrency."}, {"id": "docs_nodejs_pages_phase_11_deployment_05_environment_parity_ci_as_environment", "label": "CI as an environment", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/05-environment-parity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failures that only happen in CI are still production risks if CI matches prod closer than the laptop does."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_05_environment_parity_same_runtime_and_lockfile", "target": "docs_nodejs_pages_phase_11_deployment_01_tw