{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_views", "label": "SQL views", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored query, not stored data. pg_relation_size is 0. Substituted before planning so the planner sees one combined query."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_predicate_pushdown", "label": "View predicate pushdown", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filter on a GROUP BY key: 0.8ms / 60 rows. Filter on the aggregate: 135.8ms / 300000-row seq scan \u2014 170\u00d7. Aggregates, DISTINCT, windows, LIMIT, set ops are fences."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_view_no_parameters", "label": "Views cannot take parameters", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CREATE VIEW ... WHERE customer = $1 raises 42P02. Workaround: LANGUAGE sql STABLE SRF, or filter at the call site."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_updatable_view", "label": "Automatically updatable view", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One base table, no aggregate/DISTINCT/GROUP BY/window/set op. Otherwise 55000; needs INSTEAD OF."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_with_check_option", "label": "WITH CHECK OPTION", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it a write can insert a row that immediately vanishes from the view. With it: 44000 at insert time."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_view_hard_dependency", "label": "View hard dependencies", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2BP01 on DROP COLUMN/TABLE a view uses. CREATE OR REPLACE can only append columns."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_security_invoker", "label": "security_invoker views", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default owner privileges bypass caller RLS. PG15+ security_invoker=true uses the caller's privileges."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_views", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_predicate_pushdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/views.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_views", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_views_view_no_parameters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgre