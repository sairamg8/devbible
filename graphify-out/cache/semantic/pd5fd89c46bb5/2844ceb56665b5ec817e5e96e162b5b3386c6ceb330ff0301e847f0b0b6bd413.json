{"nodes": [{"id": "docs_expressjs_pages_phase_4_responses_05_static_files_express_static", "label": "express.static", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/05-static-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves files from a directory as middleware. Put it after API routes if the same app also hosts a SPA. Prefer a CDN or Nginx for heavy static traffic."}, {"id": "docs_expressjs_pages_phase_4_responses_05_static_files_cache_headers", "label": "Static cache headers", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/05-static-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long maxAge for hashed filenames; short/none for HTML. Fingerprinted assets can be immutable; HTML points at changing hashes. Default weak ETags are fine for many apps."}, {"id": "docs_expressjs_pages_phase_4_responses_05_static_files_static_root", "label": "Static root isolation", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-4-responses/05-static-files.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A static root too high exposes node_modules or .env. Root only the build output directory. Express 5 dotfiles defaults should not serve secrets."}], "edges": [{"source": "docs_expressjs_pages_phase_4_responses_05_static_files_express_static", "target": "docs_expressjs_pages_phase_4_responses_05_static_files_cache_headers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-4-responses/05-static-files.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_4_responses_05_static_files_express_static", "target": "docs_expressjs_pages_phase_4_responses_05_static_files