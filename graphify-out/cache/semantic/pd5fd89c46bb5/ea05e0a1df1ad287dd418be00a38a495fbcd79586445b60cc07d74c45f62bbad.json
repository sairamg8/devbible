{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_06_timers_page", "label": "Timers", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_timeout_object", "label": "Timeout object", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node setTimeout/setInterval return a Timeout with unref, ref and refresh, not a number as in browsers. Treat the return as opaque."}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_delay_is_floor", "label": "Timer delay is a floor", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The callback runs no earlier than the delay, when the loop next reaches timers and the thread is free. A long callback elsewhere delays it arbitrarily."}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_timeout_overflow", "label": "TimeoutOverflowWarning", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delays above 2147483647 ms (~24.8 days) overflow and fire immediately with a warning. Long schedules need stages or an absolute-time check."}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_setinterval_drift", "label": "setInterval drift and overlap", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedules by period, not completion. Slow async work queues and spacing collapses. Prefer a self-scheduling timeout after the work finishes."}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_unref", "label": "Timeout.unref", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes a timer from the handles keeping the process alive without cancelling it. Use for background metrics, cache sweeps, heartbeats. process.getActiveResourcesInfo names leftover handles."}, {"id": "docs_nodejs_pages_phase_2_async_06_timers_timers_promises", "label": "node:timers/promises", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellable sleep, async-iterable interval, awaitable setImmediate, scheduler.yield and scheduler.wait. Stop writing a hand-rolled sleep that leaks when abandoned."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_06_timers_page", "target": "docs_nodejs_pages_phase_2_async_06_timers_timeout_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_06_timers_delay_is_floor", "target": "docs_nodejs_pages_phase_2_async_06_timers_timeout_object", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_06_timers_page", "target": "docs_nodejs_pages_phase_2_async_06_timers_timeout_overflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/06-timers.md", "source_location": null, "weight": 1.