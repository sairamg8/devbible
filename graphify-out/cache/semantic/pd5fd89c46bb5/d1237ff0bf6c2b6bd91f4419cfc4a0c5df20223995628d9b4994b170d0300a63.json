{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_right_join", "label": "RIGHT JOIN", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RIGHT JOIN is LEFT JOIN with the operands swapped. Prefer LEFT so the preserved table is read first. RIGHT earns its keep only when FROM order is fixed by a generated query, view, or join chain."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_full_outer_join", "label": "FULL OUTER JOIN", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps unmatched rows from both sides. The only join with no substitute for reconciliation, migration verification, and snapshot diffs. Requires merge- or hash-joinable equality conditions."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_symmetric_difference_filter", "label": "Symmetric difference filter", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE a.pk IS NULL OR b.pk IS NULL after FULL OUTER JOIN returns only unmatched rows from both sides in one pass."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_is_distinct_from", "label": "IS DISTINCT FROM for diffs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a.col <> b.col is NULL when either side is NULL, so changed rows drop silently. IS DISTINCT FROM treats NULL as a value and keeps them."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_full_join_equijoin_restriction", "label": "FULL JOIN merge/hash restriction", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A full join must track unmatched rows on both sides. Hash marks hits then sweeps unhit entries; merge sees both sorted streams. Nested loop has no cheap bookkeeping, so PostgreSQL rejects non-equijoin FULL JOIN."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_emulate_full_outer", "label": "Emulate FULL OUTER with LEFT plus anti-join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LEFT JOIN UNION ALL the reverse NOT EXISTS branch. Use UNION ALL because the branches are disjoint; UNION only pays the 3.5\u00d7 dedup cost. Fallback when the condition is not hash- or merge-joinable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_using_coalesce", "label": "USING coalesce on FULL JOIN", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "USING merges the join column as coalesce(left.col, right.col), so the key is never NULL for a row present on either side \u2014 the one place USING is clearly better than ON."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_page", "label": "RIGHT and FULL OUTER page", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_page", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_right_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_page", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_full_outer_join", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_right_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_null_extension_left_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_full_outer_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_symmetric_difference_filter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_full_outer_join", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_outer_joins_is_distinct_from", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/outer-joins.html", "source_location": 