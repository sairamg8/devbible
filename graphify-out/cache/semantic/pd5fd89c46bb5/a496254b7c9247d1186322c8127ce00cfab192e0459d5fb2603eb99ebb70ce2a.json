{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning", "label": "Partitioning", "file_type": "document", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_range_list_hash", "label": "RANGE LIST HASH partitioning", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RANGE for time series, LIST for tenant/region/status, HASH to spread writes. Parent holds no rows."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_pruning", "label": "Partition pruning", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the key in WHERE: 15.6 ms one partition. Without: 32.9 ms Parallel Append of all five \u2014 about 2\u00d7 not 5\u00d7. An index would have done more."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_detach_drop", "label": "DETACH and DROP partition for retention", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DETACH 5 ms, DROP 103353 rows in 10 ms. The real payoff is cheap bulk deletion, not query speed."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_default", "label": "DEFAULT partition safety net", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No matching range without DEFAULT raises 23514. Attaching a new range that overlaps the default scans it under ACCESS EXCLUSIVE."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_key_in_pk", "label": "Partition key must be in every unique constraint", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PRIMARY KEY (id) is rejected. No global index across partitions. A partition-key UPDATE is DELETE + INSERT and cannot be HOT."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_pruning", "target": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_range_list_hash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_detach_drop", "target": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_default", "target": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_range_list_hash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-12-beyond-tables/14-partitioning.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_14_partitioning_key_in_pk", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication_replica