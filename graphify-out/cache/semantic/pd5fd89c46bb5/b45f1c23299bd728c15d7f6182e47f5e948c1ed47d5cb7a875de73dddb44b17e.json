{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_portals_portals", "label": "Portals", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_createportal", "label": "createPortal", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createPortal(children, domNode, key?) is renderable, not a component or hook. The node must already exist."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_react_tree_not_dom", "label": "Portals follow the React tree", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only DOM placement changes. Events, context, state, error boundaries and Suspense follow the React parent."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_css_escape", "label": "Portals escape CSS containment", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "overflow:hidden, stacking contexts and transformed fixed ancestors trap overlays. document.body sidesteps all three."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_dialog_top_layer", "label": "dialog showModal top layer", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native top layer escapes stacking without moving the node and brings focus trap, Escape and inertness."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_accessibility", "label": "Portal accessibility obligation", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React provides none of focus move, trap, restore, Escape or inert background. Follow WAI-ARIA Modal practices."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_native_vs_react_events", "label": "Native events follow the DOM", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Click-outside listeners see portal clicks as coming from body. Compare against the portal node."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_portals_ssr_client_only", "label": "createPortal is client-only", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no DOM on the server. Render after mount or use a framework portal."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_portals_createportal", "target": "build_css_p2_docs_react_pages_phase_2_components_portals_react_tree_not_dom", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_portals_css_escape", "target": "build_css_p2_docs_react_pages_phase_2_components_portals_dialog_top_layer", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_portals_react_tree_not_dom", "target": "build_css_p2_docs_react_pages_phase_2_components_portals_native_vs_react_events", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_portals_accessibility", "target": "build_css_p2_docs_react_pages_phase_2_components_portals_dialog_top_layer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_portals_react_tree_not_dom", "target": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_compound_components", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/react/pages/phase-2-components/portals.html", "source_location": null, "weight": 1.0}], "hyperedges": []}