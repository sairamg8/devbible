{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_snapshot_rule", "label": "The snapshot rule", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every part of one statement sees the same pre-statement snapshot. Sibling writes are invisible except via RETURNING. Makes the result independent of unspecified CTE order."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_sibling_cannot_see_write", "label": "Sibling SELECT cannot see the write", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured visible_to_sibling 0, visible_via_returning 1, and 1 row present afterwards. Re-read the table and you get the world before the statement started."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_two_ctes_lost_update", "label": "Two CTEs writing the same row", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No error: a reported 1, b reported 0, final value 1. SERIALIZABLE does not help \u2014 one transaction. Merge into one UPDATE, disjoint WHERE, or separate statements. MERGE would raise 21000 for the analogous mistake."}, {"id": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_when_to_use_a_transaction", "label": "When a transaction beats one multi-CTE write", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use BEGIN when a later step must read an earlier write, the branch is in application code, the same rows are written twice, or the work should be batched. Constraints still fail the whole statement."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_snapshot_rule", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_sibling_cannot_see_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_snapshot_rule", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_two_ctes_lost_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_when_to_use_a_transaction", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_two_ctes_lost_update", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_sibling_cannot_see_write", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_archive_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_06_windows_intro_02_where_windows_run_error_42p20", "target": "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_02_the_snapshot_rule_sibling_cannot_see_write", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-6-aggregation/10-modifying-ctes/02-the-snapshot-rule.md", "source_location": null, "weight": 1.0}], "hyperedges": []}