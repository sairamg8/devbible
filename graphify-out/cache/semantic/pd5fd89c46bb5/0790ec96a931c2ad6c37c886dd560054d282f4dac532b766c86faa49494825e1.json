{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_access_exclusive", "label": "ACCESS EXCLUSIVE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most DDL takes this lock; it conflicts with everything including SELECT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_lock_queue", "label": "DDL lock queue", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A waiting ALTER blocks later SELECTs even though ACCESS SHARE is compatible with the current holder. How a 2 ms ADD COLUMN takes a site down."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_safe_migration", "label": "Safe DDL migration pattern", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET lock_timeout then retry. Split rewrites into a short lock plus unlocked backfill (NOT VALID then VALIDATE, CREATE INDEX CONCURRENTLY)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_metadata_only_ddl", "label": "Metadata-only DDL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADD COLUMN with a constant default is catalog-only since PG 11 (2.0 ms on 200k rows). Volatile defaults and non-coercible type changes rewrite the table."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_lock_queue", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_access_exclusive", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_safe_migration", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_access_exclusive", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_safe_migration", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_row_locks_lock_timeout", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_metadata_only_ddl", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_table_locks_ddl_access_exclusive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/table-locks-ddl.html", "source_location": null, "weight": 1.0}], "hyperedges": []}