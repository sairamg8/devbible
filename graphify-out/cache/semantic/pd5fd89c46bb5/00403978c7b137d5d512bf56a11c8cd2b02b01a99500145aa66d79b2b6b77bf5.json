{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound", "label": "XID wraparound and freezing", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_wraparound", "label": "XID wraparound", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "32-bit XIDs; visibility is modular comparison. If the counter advanced 2^31 past a row's xmin the row would appear future-dated and vanish."}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freezing", "label": "Row freezing", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VACUUM marks old rows frozen: visible to everyone, no id comparison. relfrozenxid tracks progress; age(relfrozenxid) grows with every database transaction, even on idle tables."}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freeze_max_age", "label": "autovacuum_freeze_max_age", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anti-wraparound autovacuum at 200 million, under 10% of the 2^31 budget. Runs even if autovacuum is off."}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_stop_limit", "label": "xidWarnLimit and xidStopLimit", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WARNING at \u22482.134 billion (10 million before stop). Writes refused at \u22482.144 billion. Ten million XIDs is minutes at a few thousand writes/s."}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_alert_500m", "label": "Alert at 500 million not the WARNING", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The WARNING is the you-already-lost line. Alert at 500 million; treat 200 million as the number that matters. Age past 200 million means the anti-wraparound vacuum cannot advance a pinned horizon."}, {"id": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_consumption", "label": "XID consumption rate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One xid per write statement in autocommit (201 for 200 UPDATEs). SELECTs burn zero. Batching 100 writes costs one id. 10000 tx/s exhausts 2^31 in under three days without freezing."}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_wraparound", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freezing", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_wraparound", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freezing", "target": "docs_postgresql_pages_phase_11_mvcc_13_vacuum_vacuum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freeze_max_age", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freezing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_stop_limit", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_wraparound", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_alert_500m", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_stop_limit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_alert_500m", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_freeze_max_age", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/16-xid-wraparound.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_consumption", "target": "docs_postgresql_pages_phase_11_mvcc_16_xid_wraparound_xid_wraparound", "relation": "conceptually_related_to", "con