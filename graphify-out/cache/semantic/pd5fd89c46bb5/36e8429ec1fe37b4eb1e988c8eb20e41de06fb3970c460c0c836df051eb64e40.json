{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels", "label": "REPEATABLE READ and SERIALIZABLE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_repeatable_read", "label": "REPEATABLE READ", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One snapshot for the whole transaction, taken at the first statement. Read-only work cannot fail with 40001. Writers that touch a changed row get 40001 concurrent update."}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_write_skew", "label": "Write skew", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two transactions write different rows after reading an overlapping set and together break an invariant neither saw break. REPEATABLE READ allows it; SERIALIZABLE aborts one."}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_serializable", "label": "SERIALIZABLE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outcome equals some serial execution via SSI. Degrades sharply with conflict rate: 135 attempts and 12.4 s vs ordered FOR UPDATE 20 attempts and 71.2 ms for 20 transfers."}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_40001", "label": "SQLSTATE 40001 serialization failure", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "due to concurrent update = you wrote a row someone else wrote. due to read/write dependencies = SSI found a cycle involving what you read. Same SQLSTATE, different detection."}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_withserializable", "label": "withSerializable retry loop", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-run the whole transaction; retry 40001/40P01 only; bound attempts; jitter; no external side effects. Sleep after release, never inside catch before finally."}, {"id": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_sleep_outside_finally", "label": "Never await while holding a pooled client", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleeping in catch before finally pins a connection while idle and turns a retry storm into a pool shortage."}], "edges": [{"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_repeatable_read", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_serializable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_repeatable_read", "target": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_read_committed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_write_skew", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_repeatable_read", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_serializable", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_write_skew", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_serializable", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_40001", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_repeatable_read", "target": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_40001", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-11-mvcc/06-isolation-levels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_11_mvcc_06_isolation_levels_withserializable", "target": "docs_postgresql_