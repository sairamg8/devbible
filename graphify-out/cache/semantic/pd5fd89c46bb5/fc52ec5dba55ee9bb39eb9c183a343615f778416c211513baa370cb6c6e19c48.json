{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_check_allows_null", "label": "CHECK does not reject NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/constraints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL >= 18 is unknown; CHECK rejects only false. Pair CHECK with NOT NULL, or write CHECK (col IS NULL OR \u2026)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_default_now_txn_start", "label": "DEFAULT now() is transaction start", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/constraints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two inserts 150 ms apart in one transaction got identical timestamps. Use clock_timestamp() for wall-clock per row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_explicit_null_bypasses_default", "label": "Explicit NULL bypasses DEFAULT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/constraints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEFAULT applies only when the column is omitted or DEFAULT. ORMs that send null for unset fields override every default."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_named_constraints", "label": "Named constraints for API mapping", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/constraints.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "err.constraint plus SQLSTATE (23505\u2192409, 23514\u2192422, 23502\u2192422, 23503\u2192409) turns DB errors into field messages. Auto-generated names change on rename."}], "edges": [{"source": "