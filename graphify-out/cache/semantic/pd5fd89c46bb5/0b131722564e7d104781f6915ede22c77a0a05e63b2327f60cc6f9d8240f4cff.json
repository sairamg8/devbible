{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_12_floating_promises_page", "label": "Floating promises", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/12-floating-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_12_floating_promises_floating_promise", "label": "Floating promise", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/12-floating-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A promise-returning call nobody awaited or handled. Rejection is fatal since Node 15; fulfilment may silently skip a side effect. Happens via forgotten await, forEach, or missing return in .then."}, {"id": "docs_nodejs_pages_phase_2_async_12_floating_promises_void_catch", "label": "void plus .catch for fire-and-forget", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/12-floating-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "void marks intent for readers and linters; .catch is what makes it safe. Never leave the catch off."}, {"id": "docs_nodejs_pages_phase_2_async_12_floating_promises_no_floating_promises_lint", "label": "@typescript-eslint/no-floating-promises", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/12-floating-promises.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags discarded promise results; no-misused-promises catches forEach and async callbacks where sync is expected. Both need TypeScript types."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_12_floating_promises_page", "target": "docs_nodejs_pages_phase_2_async_12_floating_promises_floating_promise", "relation": "references", "confidence": "EXTRACTED", "conf