{"nodes": [{"id": "reviews_fable_03_accuracy_findings_page", "label": "Accuracy findings", "file_type": "document", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reviews_fable_03_accuracy_findings_merge_returning", "label": "MERGE RETURNING works on PostgreSQL 17+", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "13-merge.md says seven times that MERGE has no RETURNING in PostgreSQL 18. RETURNING and merge_action() landed in 17 and were executed on the live 18.4 sandbox."}, {"id": "reviews_fable_03_accuracy_findings_merge_action", "label": "merge_action()", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reviews_fable_03_accuracy_findings_not_matched_by_source", "label": "WHEN NOT MATCHED BY SOURCE", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 17 clause that deletes target rows the source omits. The page's proxy WHEN MATCHED AND s.v IS NULL only fires for rows that are in the source."}, {"id": "reviews_fable_03_accuracy_findings_phase13_stamps", "label": "Phase 13 template stamps", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve files, 66 lines each, byte-identical in structure. They pass every structural check while containing nothing. Strip to one honest not-yet-written line."}, {"id": "reviews_fable_03_accuracy_findings_shared_buffers_confound", "label": "Shared buffers measurement confound", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "44.52 ms vs 2.64 ms includes TCP connect, SCRAM, backend fork and session startup on a never-connected Pool. Measure Buffers shared read then hit on one already-warm connection."}, {"id": "reviews_fable_03_accuracy_findings_phase0_thin", "label": "Phase 0 under-explained", "file_type": "concept", "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12 topics, 116 lines each against a corpus median of 226. Treat as a rewrite, not a patch."}], "edges": [{"source": "reviews_fable_03_accuracy_findings_page", "target": "reviews_fable_03_accuracy_findings_merge_returning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "weight": 1.0}, {"source": "reviews_fable_03_accuracy_findings_merge_returning", "target": "reviews_fable_03_accuracy_findings_merge_action", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "weight": 1.0}, {"source": "reviews_fable_03_accuracy_findings_page", "target": "reviews_fable_03_accuracy_findings_not_matched_by_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reviews/fable/03-accuracy-findings.md", "source_location": null, "weight": 1.0}, {"source": "reviews_fable_03_accuracy_findings_page", "target": "reviews_fable_03_accuracy_findings_phase13_stamps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reviews/fable/03-accuracy-findings.md", "source_location":