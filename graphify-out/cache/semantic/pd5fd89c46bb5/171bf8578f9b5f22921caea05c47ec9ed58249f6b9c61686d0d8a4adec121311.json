{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_data_modifying_cte", "label": "Data-modifying CTE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INSERT/UPDATE/DELETE/MERGE inside WITH, chained by RETURNING. One statement is already atomic \u2014 no BEGIN needed. Always MATERIALIZED; NOT MATERIALIZED cannot inline a write."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_archive_pattern", "label": "Archive with DELETE RETURNING then INSERT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WITH moved AS (DELETE \u2026 RETURNING *) INSERT INTO archive SELECT * FROM moved. No window where the row is in neither table or both. Measured: 6 orders \u2192 5, 1 archived."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_unreferenced_write_cte", "label": "Unreferenced write CTE still runs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A SELECT CTE nobody references can be discarded; a write is a promised side effect and executes once regardless. Deleting the reference but not the CTE leaves a write running."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_data_modifying_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_archive_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_unreferenced_write_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_data_modifying_cte", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_one_statement_many_writes_data_modifying_cte", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_modifying_ctes_the_snapshot_rule_snapshot_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/modifying-ctes/one-statement-many-writes.html", "source_location": null, "weight": 1.0}], "hyperedges": []}