{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_page", "label": "Sequential vs parallel await", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_sequential_independent_awaits", "label": "Sequential independent awaits", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three independent awaits sum their latencies. Test: does this line need the previous line's value? If not, start together with Promise.all."}, {"id": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_map_promise_all", "label": "map plus Promise.all", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserves input order regardless of completion. Starts every item at once \u2014 a few dozen is fine; thousands need a bounded pool."}, {"id": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_eager_start_then_await", "label": "Create then await is already parallel", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promises are eager, so creating both before either await is parallel. Separate awaits risk unhandled rejection if one rejects before its await. Promise.all is the safer default."}, {"id": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_when_sequential_is_right", "label": "When sequential is right", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency chains, rate limits, ordered writes, and memory. Parallel is useless for CPU-bound work on one thread."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_page", "target": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_sequential_independent_awaits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_page", "target": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_map_promise_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_map_promise_all", "target": "docs_nodejs_pages_phase_2_async_09_combinators_promise_all", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_eager_start_then_await", "target": "docs_nodejs_pages_phase_2_async_07_promise_states_promises_are_eager", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/10-sequential-vs-parallel.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_when_sequential_is_right", "target": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_sequ