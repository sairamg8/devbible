{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_dollar_placeholders", "label": "$n placeholders", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/query-placeholders.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positional and 1-based. A placeholder may repeat. More values than $n references are silently ignored."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_any_array_parameter", "label": "ANY($1::int[]) for lists", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/query-placeholders.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One parameter regardless of list length, so statement text and the plan stay constant and you avoid the 65535-parameter ceiling."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_identifiers_not_parameters", "label": "Identifiers cannot be parameters", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/query-placeholders.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY $1 sorts by a constant string and raises no error. Column names need an allowlist."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_undefined_becomes_null", "label": "undefined becomes SQL NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/query-placeholders.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A misspelled property inserts NULL instead of failing. Validate the object before building the values array."}], "edges": [{"source": "build_css_