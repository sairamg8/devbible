{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_table_health", "label": "Table health", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Views that tell you something is wrong before anyone notices: dead tuples, unused indexes, whether autovacuum is keeping up."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "label": "pg_stat_user_tables", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per table: seq_scan, idx_scan, n_live_tup, n_dead_tup, last_autovacuum, write mix. Cheap, approximate, for trends and triage."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_seq_scan_hint", "label": "High seq_scan is a hint not a verdict", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential scans are often optimal for small tables or queries that touch most rows. Treat them as EXPLAIN candidates; adding an index can make a query slower."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_dead_tuples_autovacuum", "label": "Dead tuples vs autovacuum pace", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rising n_dead_tup with recent last_autovacuum means not keeping pace (tune per-table scale_factor). Old or NULL last_autovacuum means blocked by a long-open transaction."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_unused_indexes", "label": "Unused indexes via idx_scan = 0", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exclude unique/PK. Check stats_reset, replica stats, and idx_scan lag before DROP INDEX CONCURRENTLY."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_maintain_privilege", "label": "VACUUM silent skip without MAINTAIN", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing MAINTAIN privilege: VACUUM warns, skips the table, and exits successfully. Nightly jobs that lost their grant never fail."}, {"id": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_approximate_counters", "label": "Statistics counters are estimates", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "n_live_tup and n_dead_tup are approximate; stats report after statements complete. Exact counters would need sync on every row operation."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_table_health", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_seq_scan_hint", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_dead_tuples_autovacuum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_unused_indexes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_dead_tuples_autovacuum", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_readme_oldest_transaction_age", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_approximate_counters", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_pg_stat_user_tables", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_maintain_privilege", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_04_table_health_dead_tuples_autovacuum", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-13-ops/09-monitoring/04-table-health.md", "source_location": null, "weight": 1.0}], "hyperedges": []}