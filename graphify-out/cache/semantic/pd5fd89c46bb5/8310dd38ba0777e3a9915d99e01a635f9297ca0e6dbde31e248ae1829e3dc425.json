{"nodes": [{"id": "sandbox_git_p0_ex2_output_git_object_model_probe", "label": "Git object model probe", "file_type": "document", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walks content-addressed objects, the three trees, commits as snapshots, refs, packfiles, config layers, and plumbing-built commits."}, {"id": "sandbox_git_p0_ex2_output_content_addressed_objects", "label": "Content-addressed Git objects", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An object is content addressed by the hash of header+content. The filename is nowhere in the hash: greeting.txt and copy-of-greeting.txt share ce013625030ba8dba906f756967f9e9ca394464a."}, {"id": "sandbox_git_p0_ex2_output_hash_object", "label": "git hash-object", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is stored until -w writes. Without -w, cat-file fails with could not get object info. After -w the object lives at .git/objects/ce/013625\u2026 and is type blob size 6."}, {"id": "sandbox_git_p0_ex2_output_three_trees", "label": "Working tree, index, and HEAD", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git keeps three trees. ?? is working-tree only; A is in the index. git diff is working tree vs index; git diff --staged is index vs HEAD."}, {"id": "sandbox_git_p0_ex2_output_index", "label": "Git index", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The index is a real file with real blobs. ls-files --stage shows mode, blob SHA, stage, and path. file .git/index reports Git index, version 2."}, {"id": "sandbox_git_p0_ex2_output_staged_and_modified", "label": "Staged and modified at once", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing after add leaves the old content staged. Status AM means staged AND modified at the same time."}, {"id": "sandbox_git_p0_ex2_output_commit_snapshot", "label": "Commit is a snapshot", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit is a tree, parents, and metadata. Subdirectories are their own tree objects."}, {"id": "sandbox_git_p0_ex2_output_four_object_types", "label": "Four Git object types", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "blob, tree, commit, and tag. After the first commit: 3 blob, 1 commit, 2 tree. An annotated tag adds a tag object."}, {"id": "sandbox_git_p0_ex2_output_annotated_tag", "label": "Annotated tag object", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An annotated tag is an object (object, type, tag, tagger, message). Lightweight tags are not objects."}, {"id": "sandbox_git_p0_ex2_output_refs_as_files", "label": "Refs and HEAD are plain files", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".git/HEAD is ref: refs/heads/main. The branch file holds the same 40-character SHA that rev-parse HEAD and symbolic-ref HEAD report."}, {"id": "sandbox_git_p0_ex2_output_cheap_branch", "label": "A branch costs 41 bytes", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git branch feature/pricing writes a 41-byte ref file. Object count is unchanged: a branch is a pointer, not a copy."}, {"id": "sandbox_git_p0_ex2_output_commit_graph_parents", "label": "Commit graph is parents not timestamps", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit dated 2030 is still the child of its parent. git log --reverse is ancestry order, not date order."}, {"id": "sandbox_git_p0_ex2_output_git_directory", "label": ".git directory layout", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COMMIT_EDITMSG, config, description, HEAD, hooks, index, info, logs, objects, refs. repositoryformatversion 0, filemode true, bare false, logallrefupdates true."}, {"id": "sandbox_git_p0_ex2_output_packfile", "label": "Loose objects become a packfile", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before gc: 51 loose files, 204K. After git gc: 2 non-pack files, 36K, in-pack 51 across 2 packs totaling 6.03 KiB."}, {"id": "sandbox_git_p0_ex2_output_config_layers", "label": "Git config layers and precedence", "file_type": "concept", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local .git/config user.email is work@example.com. git -c user.email=once@example.com is scope command and wins for that invocation."}, {"id": "sandbox_git_p0_ex2_output_plumbing_vs_porcelain", "label": "Plumbing vs porcelain commit", "file_type": "rationale", "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit built only from blob, tree, and commit plumbing is a real commit (45c50f3 Made with plumbing only) even when reachable from no branch."}], "edges": [{"source": "sandbox_git_p0_ex2_output_git_object_model_probe", "target": "sandbox_git_p0_ex2_output_content_addressed_objects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_content_addressed_objects", "target": "sandbox_git_p0_ex2_output_hash_object", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_git_object_model_probe", "target": "sandbox_git_p0_ex2_output_three_trees", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_three_trees", "target": "sandbox_git_p0_ex2_output_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_three_trees", "target": "sandbox_git_p0_ex2_output_staged_and_modified", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_git_object_model_probe", "target": "sandbox_git_p0_ex2_output_commit_snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_commit_snapshot", "target": "sandbox_git_p0_ex2_output_four_object_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_four_object_types", "target": "sandbox_git_p0_ex2_output_annotated_tag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_git_object_model_probe", "target": "sandbox_git_p0_ex2_output_refs_as_files", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_cheap_branch", "target": "sandbox_git_p0_ex2_output_refs_as_files", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_commit_graph_parents", "target": "sandbox_git_p0_ex2_output_commit_snapshot", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbox/git-p0/ex2-output.txt", "source_location": null, "weight": 1.0}, {"source": "sandbox_git_p0_ex2_output_git_object_model_probe", "target": "sandbox_git_p0_ex2_output_git_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sandbo