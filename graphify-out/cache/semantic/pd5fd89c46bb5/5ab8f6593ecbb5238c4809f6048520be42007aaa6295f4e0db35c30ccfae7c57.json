{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_inet", "label": "inet type", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds a host address with optional netmask, 10 bytes vs 16 as text, validates input (22P02), normalises IPv6 so equivalent forms compare equal, and supports GiST-indexable containment operators."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_cidr", "label": "cidr type", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds a network only; host bits set raise 22P02. That distinction is why both inet and cidr exist: cidr is a range, inet is an address that may know its range."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_macaddr", "label": "macaddr and macaddr8", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "6-byte and 8-byte hardware addresses with the same normalisation pattern as inet."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_geometric_types", "label": "Built-in geometric types", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "point, line, lseg, box, path, polygon, circle with <->, @>, && \u2014 Cartesian and GiST-indexable. point arrives in Node as {x,y}."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_postgis_geography", "label": "PostGIS geography for Earth", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in geometry is Cartesian; <-> on lat/lng degrees is not metres. PostGIS geography, SRS and real distance functions are required for maps."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_citext", "label": "citext", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case-insensitive text plus case-insensitive UNIQUE (23505 on a case variant). Folds case via collation, not Unicode composition; extension required."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_lower_unique_index", "label": "lower() unique expression index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No-extension fallback for case-insensitive uniqueness; every query must use lower() or it silently misses rows."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_inet", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_cidr", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_geometric_types", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_postgis_geography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_citext", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_lower_unique_index", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_network_geo_citext_citext", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_null_unique_allows_many_nulls", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/network-geo-citext.html", "source_location": null, "weight": 1.0}], "hyperedges": []}