{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_18_async_iterators_page", "label": "Async iterators and generators", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/18-async-iterators.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_18_async_iterators_for_await_of", "label": "for await...of", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/18-async-iterators.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Awaits each value so it can iterate sequences that arrive over time. Strictly sequential \u2014 never parallel. Use a pool for independent items."}, {"id": "docs_nodejs_pages_phase_2_async_18_async_iterators_async_generator", "label": "async function*", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/18-async-iterators.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await inside, yield out. Consumer pulls one value at a time so the producer does no work in advance and only one item is in memory."}, {"id": "docs_nodejs_pages_phase_2_async_18_async_iterators_symbol_asynciterator", "label": "Symbol.asyncIterator", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/18-async-iterators.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "for await looks for a next() that returns a promise of {value, done}. Async generators produce this protocol."}, {"id": "docs_nodejs_pages_phase_2_async_18_async_iterators_pull_backpressure", "label": "Pull-based backpressure", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-2-async/18-async-iterators.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ratio