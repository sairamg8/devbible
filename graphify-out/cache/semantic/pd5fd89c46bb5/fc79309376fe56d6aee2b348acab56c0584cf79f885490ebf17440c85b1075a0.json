{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_pg_trgm", "label": "pg_trgm", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/pg-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compares overlapping three-character sequences. Finds typos FTS cannot; has no stemming. Also makes ILIKE '%x%' indexable."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_word_similarity", "label": "word_similarity <%", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/pg-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "% compares whole strings (0.273 vs a long title). <% scores the query against the best word (1.000). Query goes on the left."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_gin_trgm_ops", "label": "gin_trgm_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/pg-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes ILIKE '%x%' a Bitmap Heap Scan: 87.0 ms \u2192 1.13 ms. Cannot serve ORDER BY <->."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_gist_trgm_ops", "label": "gist_trgm_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/pg-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves ORDER BY <-> nearest-neighbour. Larger (22 MB vs 9 MB GIN)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_word_similarity", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_pg_trgm_pg_trgm", "r