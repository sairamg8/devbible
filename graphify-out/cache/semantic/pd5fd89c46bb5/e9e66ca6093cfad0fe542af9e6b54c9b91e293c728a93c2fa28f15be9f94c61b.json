{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule", "label": "The CTE inlining rule", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/the-inlining-rule.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule_pg12_inline", "label": "PostgreSQL 12+ CTE inlining", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/the-inlining-rule.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE is inlined unless it is referenced more than once, marked MATERIALIZED, recursive, volatile, or a data-modifying statement."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule_materialized_fence", "label": "MATERIALIZED fence", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/the-inlining-rule.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MATERIALIZED forces the CTE to be computed once and stored; measured about 6.1\u00d7 the inlined cost when that fence is unnecessary."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule_pg12_inline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/ctes/the-inlining-rule.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_rule", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_ctes_the_inlining_r