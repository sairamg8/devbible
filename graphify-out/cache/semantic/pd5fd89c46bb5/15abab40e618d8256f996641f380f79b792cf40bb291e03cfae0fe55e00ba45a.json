{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_slots_and_children", "label": "Slots, children and the context hole", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/composition/slots-and-children.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_children_slot", "label": "children as the free slot", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/composition/slots-and-children.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wrapper has a hole the parent fills with arbitrary JSX."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_named_element_props", "label": "Named element props (slots)", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/composition/slots-and-children.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Community name, not a React API. Name regions, keep primary content in children, do not slice children by index."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_compound_components", "label": "Compound components", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/composition/slots-and-children.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-form children plus context so parts share state and can be arranged freely."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_composition_slots_and_children_context_hole", "label": "The context hole", "file_type": "rationale", "source_file":