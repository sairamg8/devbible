{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_object_mode", "label": "objectMode", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries arbitrary JS values. High water mark counts items (default 16) not bytes (65536). Writing an object to a byte stream throws ERR_INVALID_ARG_TYPE synchronously."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_one_sided", "label": "One-sided object mode", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "readableObjectMode is bytes in, records out (parser). writableObjectMode is records in, bytes out (serialiser)."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_push_null", "label": "push null is end of stream", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "push(null) terminates in every mode. A legitimate null value must be wrapped. undefined is likewise unusable."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_memory_unmeasured", "label": "Object-mode memory is unmeasured", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sixteen 10 MB documents is 160 MB. No coalescing: each object is a separate _write. Lower the mark or batch with _writev."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_readable_from_hwm_1", "label": "Readable.from high water mark 1", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object mode on, hwm 1 so a generator wrapping a paged API does not prefetch."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_one_sided", "target": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_object_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_push_null", "target": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_object_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_memory_unmeasured", "target": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_object_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_readable_from_hwm_1", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_readable_from", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/14-object-mode.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_14_object_mode_one_sided", "target": "docs_nodejs_pages_phase_3_buffers_streams_08_stream_types_transform", "relation": "conceptua