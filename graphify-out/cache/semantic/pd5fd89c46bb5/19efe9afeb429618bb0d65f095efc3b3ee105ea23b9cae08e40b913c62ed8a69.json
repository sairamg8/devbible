{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_shallow_copy", "label": "Shallow copy", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level properties become independent; nested objects are shared by reference. Spread, Object.assign, slice and Array.from are all shallow."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_spread_drops_prototype", "label": "Spread drops the prototype", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreading a class instance yields fields with no methods. Map, Date, Set and RegExp keep data in internal slots, so { ...new Map(...) } is {}."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_immutable_path_copy", "label": "Copy the path you are changing", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idiomatic React/Redux updates share untouched branches. That identity sharing is what makes prev === next and memoisation work. Deep-cloning state defeats it."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_shallow_copy", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_02_methods_accessors_and_spread_object_spread", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_spread_drops_prototype", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_shallow_copy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_immutable_path_copy", "target": "docs_javascript_pages_phase_4_objects_and_classes_04_shallow_vs_deep_copy_01_what_shallow_means_shallow_copy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/04-shallow-vs-deep-copy/01-what-shallow-means.md", "source_location": null, "weight": 1.0}], "hyperedges": []}