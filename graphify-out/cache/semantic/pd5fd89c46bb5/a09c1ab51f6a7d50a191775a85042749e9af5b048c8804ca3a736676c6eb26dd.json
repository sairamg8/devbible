{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_conditional_aggregation", "label": "FILTER conditional aggregation", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/conditional-aggregation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_conditional_aggregation_filter", "label": "FILTER clause", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/conditional-aggregation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricts which rows enter one aggregate without a second scan or a CASE wrapper."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_conditional_aggregation_filter_vs_case", "label": "FILTER vs CASE", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/conditional-aggregation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER and CASE express the same pivot; FILTER is clearer and does not invent zeros the way COALESCE(sum(CASE\u2026),0) can."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_conditional_aggregation_empty_sum_null", "label": "Empty sum is NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/conditional-aggregation.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum FILTER that matches no rows is NULL, not 0; wrap with COALESCE when a pivot needs zeros."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_cl