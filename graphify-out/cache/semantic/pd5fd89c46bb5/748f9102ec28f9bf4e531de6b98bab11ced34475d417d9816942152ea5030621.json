{"nodes": [{"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_page", "label": "The default and the comparator", "file_type": "document", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_default_string_sort", "label": "Default sort is UTF-16 string order", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elements are converted to strings then compared as UTF-16 code units, so [1, 30, 4, 21, 100000] becomes [1, 100000, 21, 30, 4]."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_comparator_contract", "label": "sort compareFn contract", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Negative means a before b, positive after, zero or NaN equal. Only the sign matters, which is why a - b works."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_five_consistency_requirements", "label": "Well-formed comparator requirements", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure, stable, reflexive, anti-symmetric, transitive. Violations do not throw; they yield implementation-defined order."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_fisher_yates", "label": "Fisher\u2013Yates shuffle", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sort(() => Math.random() - 0.5) breaks every consistency requirement and is a biased, engine-dependent shuffle."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_localecompare", "label": "String.prototype.localeCompare", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default UTF-16 order puts Z before a and mis-sorts accents. localeCompare returns a signed number that plugs into compareFn."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_intl_collator", "label": "Intl.Collator", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build one Collator and reuse compare; creating one per comparison is wasteful on large lists."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_multikey_or_chain", "label": "Multi-key || comparator chain", "file_type": "concept", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tie returns 0, which is falsy, so evaluation falls through. Negate one term for a descending key."}, {"id": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_decorate_sort_undecorate", "label": "Decorate\u2013sort\u2013undecorate", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An expensive key computed inside compareFn runs O(n log n) times and a variable key violates stability. Map to {item, key}, sort, map back."}], "edges": [{"source": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_page", "target": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_default_string_sort", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_page", "target": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_comparator_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-the-comparator.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_five_consistency_requirements", "target": "docs_javascript_pages_phase_5_built_in_library_06_sort_01_the_default_and_the_comparator_comparator_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-5-built-in-library/06-sort/01-the-default-and-t