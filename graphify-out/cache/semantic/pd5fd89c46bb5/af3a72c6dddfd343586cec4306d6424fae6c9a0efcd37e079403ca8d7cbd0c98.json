{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_for_await_of", "label": "for await of Readable", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/11-for-await-of.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default way to read a stream: backpressure, try/catch errors, automatic cleanup. Next chunk is requested only when the loop body finishes."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_stream_consumers", "label": "stream/consumers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/11-for-await-of.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text, json, buffer, arrayBuffer, blob collect a whole stream. No size limit of their own \u2014 never point at unbounded input."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_readline", "label": "readline createInterface", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/11-for-await-of.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Line-oriented async iterable. crlfDelay: Infinity treats \\r\\n as one break so Windows files do not leave a stray \\r."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_iterator_helpers", "label": "Readable iterator helpers", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/11-for-await-of.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "map, filter, take, reduce, toArray and more since v17. Stability 1 Experimental in Node 24. map/filter accept { concurrency }."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_11_for_await_of_break_destroys", "label": "break destroys the strea