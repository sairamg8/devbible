{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_14_node_module_api_node_module_api", "label": "node:module API", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/14-node-module-api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The programmable side of the module system. You go years without needing it, then need it for a loader, a test double, or a startup-time win."}, {"id": "docs_nodejs_pages_phase_1_modules_14_node_module_api_enable_compile_cache", "label": "enableCompileCache", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/14-node-module-api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persists V8 compilation output to disk. Call before heavy imports, or set NODE_COMPILE_CACHE. Keyed by Node version and architecture."}, {"id": "docs_nodejs_pages_phase_1_modules_14_node_module_api_module_register", "label": "module.register()", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/14-node-module-api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers resolve and load customization hooks. Still experimental in Node 24. Register before the modules they affect via --import."}, {"id": "docs_nodejs_pages_phase_1_modules_14_node_module_api_hooks_separate_thread", "label": "Loader hooks run on a separate thread", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/14-node-module-api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops a loader from deadlocking the main thread. No shared memory; communicate through register() data and a MessagePort."}, {"id": "docs_nodejs_pages_phase_1_modules_14_node_module_api_is_builtin", "label": "module.isBuiltin", "file_type": "con