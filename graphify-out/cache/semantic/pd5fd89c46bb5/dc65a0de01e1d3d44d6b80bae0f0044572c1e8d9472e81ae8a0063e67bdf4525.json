{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_commonjs", "label": "CommonJS", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node's original module system: synchronous, dynamic, and cached by resolved path. Not deprecated; most of npm is still published this way."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_module_wrapper", "label": "CommonJS module wrapper", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node wraps every CJS file in a function(exports, require, module, __filename, __dirname). Those five names are parameters, not globals, which is why they do not exist in ESM."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_module_exports_vs_exports", "label": "module.exports vs exports", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exports starts as a second name for the same object as module.exports. Only module.exports is what require returns."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_never_assign_exports", "label": "Never assign to bare exports", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exports = {\u2026} rebinds the local parameter and exports {}. Use module.exports everywhere."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_require_cache", "label": "require.cache", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module body runs once per resolved path per process. Later requires return the same object. Core modules are not in require.cache."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_module_singleton", "label": "CommonJS module singleton", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-scope state is process-wide. That is how you get one connection pool, and how one test leaks state into the next."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_require_synchronous", "label": "require is synchronous", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require reads and compiles on the main thread, blocking the event loop. Fine at startup; a latency spike inside a request handler. Also why CJS cannot load ESM with top-level await."}, {"id": "docs_nodejs_pages_phase_1_modules_02_commonjs_no_live_bindings", "label": "CommonJS has no live bindings", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require returns an object; destructuring copies values at that moment. Export a function or getter, or read through the module object."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_02_commonjs_module_wrapper", "target": "docs_nodejs_pages_phase_1_modules_02_commonjs_commonjs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/02-commonjs.md", "source_location": null, "we