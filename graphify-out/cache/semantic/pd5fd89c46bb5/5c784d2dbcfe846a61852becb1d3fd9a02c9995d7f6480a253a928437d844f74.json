{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_onboarding", "label": "Tenant onboarding", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared: INSERT (ms). Schema: CREATE SCHEMA + N migrations (seconds\u2013minutes). Database: provision + pool. Self-serve signup makes the latter a product constraint."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_deletion", "label": "Tenant deletion and erasure", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separated: DROP SCHEMA/DATABASE CASCADE. Shared: DELETE in FK order, generate table list from information_schema, or ON DELETE CASCADE. Backups retain data for the retention window."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_noisy_neighbour", "label": "Noisy neighbour in shared schema", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL has no intra-database isolation. Per-role timeouts, separate pools per tier, rate limits, reporting replica. Hybrid: long tail shared, whales dedicated."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_bypassrls_admin", "label": "BYPASSRLS analytics role", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-tenant admin/billing queries need a dedicated BYPASSRLS role, not the table owner. Owner bypass is implicit and indistinguishable from an oversight."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_isolation_tests", "label": "Tenant isolation test suite", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reads B by id \u2192 0 rows; insert/update to B's id rejected; no context \u2192 0 or error; sequential requests on one pooled connection must not inherit tenant."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_application_name_tenant", "label": "application_name carries tenant", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_stat_statements normalises tenant id as a parameter. Put tenant in application_name so pg_stat_activity and the slow-query log attribute work per tenant."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_id_as_shard_key", "label": "tenant_id as future shard key", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared schema shards later because tenant_id is already the partition key. Keep it on every table and avoid cross-tenant FKs."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_onboarding", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_deletion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_noisy_neighbour", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_bypassrls_admin", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_isolation_tests", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_set_config_local", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_application_name_tenant", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_noisy_neighbour", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_id_as_shard_key", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_choosing_a_model_shared_schema_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_operating_it_tenant_deletion", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_multi_tenancy_models_compared_schema_per_tenant", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/multi-tenancy/operating-it.html", "source_location": null, "weight": 1.0}], "hyperedges": []}