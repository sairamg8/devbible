{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "label": "GIN for jsonb, arrays and full text; pg_trgm for LIKE", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_gin_index", "label": "GIN index", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIN indexes the parts of a value \u2014 jsonb keys, array elements, lexemes, trigrams \u2014 making @>, @@, ? and LIKE '%x%' indexable. Selective needles win; a 16% match was slower than seq scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_ops", "label": "jsonb_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default GIN opclass stores keys and values separately. Serves @> and existence operators ? / ?| / ?&."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_path_ops", "label": "jsonb_path_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hashes whole paths; smaller and faster for @> only. Existence operators fall back to sequential scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_pg_trgm", "label": "pg_trgm gin_trgm_ops", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigram GIN makes infix LIKE/ILIKE indexable. Patterns shorter than three characters produce too few distinguishing trigrams and can be slower than a seq scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_pending_list", "label": "GIN pending list", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIN buffers inserts in a pending list (gin_pending_list_limit 4MB). Cost is deferred to VACUUM or a query that scans the unmerged list; fastupdate=off pays on insert instead."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_gist_trgm_ops", "label": "gist_trgm_ops distance ordering", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY col <-> 'text' is nearest-neighbour. GIN cannot do it; gist_trgm_ops can, at a larger index size."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_gin_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_path_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_pg_trgm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_pending_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_gist_trgm_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_ops", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_jsonb_path_ops", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/gin-trgm.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_gin_trgm_gin_index", "target": "build_css_p2_docs_postgresql_pages_phas