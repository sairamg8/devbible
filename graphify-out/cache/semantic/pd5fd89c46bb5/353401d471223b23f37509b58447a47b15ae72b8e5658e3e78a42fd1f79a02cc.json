{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_xid_wraparound", "label": "XID wraparound", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/xid-wraparound.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "32-bit xids; if the counter advances 2^31 past xmin the row looks future-dated and vanishes. VACUUM freezes old rows to prevent it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_freezing", "label": "XID freezing", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/xid-wraparound.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marks a row visible to everyone, immune to wraparound. relfrozenxid / age() is what you monitor."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_anti_wraparound", "label": "Anti-wraparound autovacuum", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/xid-wraparound.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts at autovacuum_freeze_max_age = 200 million. Alert here, not at the 2.134-billion WARNING which is only ~10 million xids before writes stop."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_freezing", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_xid_wraparound", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/xid-wraparound.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound_anti_wraparound", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_xid_wraparound