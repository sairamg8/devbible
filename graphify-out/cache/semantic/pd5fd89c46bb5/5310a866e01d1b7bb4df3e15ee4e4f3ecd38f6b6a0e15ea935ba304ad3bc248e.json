{"nodes": [{"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_review", "label": "PostgreSQL cross-phase correctness review", "file_type": "document", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_clustering_measured", "label": "81 pages clustered 169\u2013269 lines", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 81 rewritten pages in phases 1, 2, 5, 10, 11 fall inside 169\u2013269. Not one exceeds 270. Clustering tell: YES."}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_set_bind_params", "label": "SET cannot take bind parameters", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET LOCAL TIME ZONE $1 fails 42601. Replacement is SELECT set_config($1, $2, true)."}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_xid_wraparound", "label": "XID wraparound warning threshold", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warning is near 2.13 billion, not 1 billion. Page on autovacuum_freeze_max_age (200 million), not the wrap warning."}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_advisory_lock_pool_leak", "label": "Session advisory lock pool leak", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_try_advisory_lock on a pooled client plus client.release() without destroy returns a connection that still holds the lock."}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_merge_join_range", "label": "Merge join needs equality", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure range ON clause is nested loop only. Merge join requires mergejoinable btree equality operators."}, {"id": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_resplit_queue", "label": "Item 14 re-split queue", "file_type": "concept", "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 Master-tier single-file pages still inside the clustering band. Write to deserved depth, then chunk on concept boundaries."}], "edges": [{"source": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_review", "target": "docs_reviews_review_prompt_final_rereview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "weight": 1.0}, {"source": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_clustering_measured", "target": "docs_reviews_review_prompt_clustering_tell", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/reviews/postgresql/2026-08-13-cross-phase-correctness.md", "source_location": null, "weight": 1.0}, {"source": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_resplit_queue", "target": "docs_reviews_postgresql_2026_08_13_cross_phase_correctness_cluste