{"nodes": [{"id": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_idempotency_keys", "label": "Idempotency keys", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients retry POSTs. Without an idempotency key you double-charge. Store the first response and replay it. Needed most on POST and some PATCH; GET/PUT are already idempotent when implemented correctly."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_replay_stored_response", "label": "Replay stored idempotent response", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client sends Idempotency-Key on unsafe requests. Server stores key \u2192 response (status + body) under a TTL. Replay returns the same result without re-executing side effects."}, {"id": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_payload_mismatch_409", "label": "Idempotency payload mismatch 409", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same key, different body is a client bug or attack. Reject with 409 if payload hash mismatches stored request."}], "edges": [{"source": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_idempotency_keys", "target": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_replay_stored_response", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_payload_mismatch_409", "target": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_idempotency_keys", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_payload_mismatch_409", "target": "docs_expressjs_pages_phase_5_errors_04_mapping_to_http_status_mapping", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_6_rest_surface_06_idempotency_keys_idempotency_keys", "target": "docs_expressjs_pages_phase_6_rest_surface_07_etag_and_cache_etag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-6-rest-surface/06-idempotency-keys.md", "source_location": null, "weight": 1.0}], "hyperedges": []}