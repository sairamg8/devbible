{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_race_conditions", "label": "Race conditions", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_ignore_flag", "label": "ignore flag", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let ignore = false inside setup so each run has its own flag; cleanup sets it true. Fixes the render, does not cancel the request."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_abortcontroller", "label": "AbortController in an effect", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleanup calls abort(); catch must ignore AbortError or cancel becomes a visible error."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_abort_error", "label": "AbortError", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aborted fetch rejects with a DOMException named AbortError; treating it as failure flashes an error on every keystroke."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_start_with_ignore", "label": "Start with ignore, abort when the request is the cost", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ignore is what react.dev documents and works with any promise. AbortController when payloads, search-as-you-type, or mobile bandwidth make the request itself costly."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_neither_is_a_cache", "label": "Neither race guard is a cache", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both stop the wrong data rendering. Neither deduplicates, caches, or starts the request earlier."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_react_dev_useeffect", "label": "react.dev useEffect", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_race_conditions", "target": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_ignore_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_race_conditions", "target": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_abortcontroller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/race-conditions.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_4_effects_race_conditions_abortcontroller", "target": "build_css_p2_docs_react_pages_phase_4_effects_race_cond