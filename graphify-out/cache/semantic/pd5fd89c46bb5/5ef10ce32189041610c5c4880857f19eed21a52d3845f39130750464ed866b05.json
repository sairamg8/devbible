{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_page", "label": "15 \u00b7 Object wrappers and autoboxing", "file_type": "document", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_autoboxing", "label": "Autoboxing", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Property access on a primitive temporarily wraps it, looks up the method on String/Number/Boolean.prototype, then discards the wrapper. Assignments do not persist. null and undefined have no wrapper."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_wrapper_constructors", "label": "Wrapper constructors", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never new String/Number/Boolean: they produce objects, so typeof is 'object' and new Boolean(false) is truthy. Without new they are conversion functions returning primitives."}, {"id": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_never_extend_builtins", "label": "Never extend built-in prototypes", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype extension is global and collides. Array.prototype.flatten was renamed flat because a library had taken the name. Write a standalone function or ponyfill."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_autoboxing", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_wrapper_constructors", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_wrapper_constructors", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_truthiness_toboolean", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_never_extend_builtins", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_autoboxing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_object_wrappers_page", "target": "build_css_p2_docs_javascript_pages_phase_1_values_and_coercion_symbol_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-1-values-and-coercion/object-wrappers.html", "source_location": null, "weight": 1.0}], "hyperedges": []}