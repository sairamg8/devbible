{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_04_buffer_as_uint8array_buffer_extends_uint8array", "label": "Buffer extends Uint8Array", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/04-buffer-as-uint8array.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same memory model plus encoding methods, numeric read/write, and the pool. Why crypto.subtle, fetch, TextDecoder and Web Streams accept a Buffer."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_04_buffer_as_uint8array_slice_shares_memory", "label": "Buffer.slice shares memory", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/04-buffer-as-uint8array.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer.prototype.slice returns a view; Uint8Array.prototype.slice copies. Use subarray for a view and Buffer.from for a copy."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_04_buffer_as_uint8array_buffer_from_overloads", "label": "Buffer.from copy vs view overloads", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/04-buffer-as-uint8array.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer.from(typedArray) and Buffer.from(buffer) copy. Buffer.from(arrayBuffer[, offset, length]) creates a view."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_04_buffer_as_uint8array_prefer_uint8array_portable", "label": "Prefer Uint8Array outside Node", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/04-buffer-as-uint8array.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer is a Node global. Shared browser/Worker/Deno code should use Uint8Array plus TextEncoder/TextDecoder."}], "e