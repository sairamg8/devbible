{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_ref", "label": "Ref", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file containing a hash. refs/heads/* move on commit; refs/tags/* never move; refs/remotes/* move on fetch."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_symbolic_head", "label": "HEAD is a symbolic ref", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Usually contains ref: refs/heads/<branch>. git rev-parse follows HEAD \u2192 branch file \u2192 commit."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_detached_head", "label": "Detached HEAD", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HEAD holds a raw hash. New commits advance HEAD only. Switching away abandons them unless you branch first."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_reftable", "label": "reftable backend", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in at git init --ref-format=reftable. Default is files plus packed-refs. cat .git/refs/heads/main can fail; rev-parse always works."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_symbolic_head", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_detached_head", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_symbolic_head", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_reftable", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_refs_and_head_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/refs-and-head.html", "source_location": null, "weight": 1.0}], "hyperedges": []}