{"nodes": [{"id": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_ts_check", "label": "// @ts-check", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First comment at the top of a .js file turns the checker on for that file. Types come from JSDoc. Same TS2345 as TypeScript; Node still runs the file unchanged."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_checkjs", "label": "checkJs project-wide", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"checkJs\": true checks every .js in the project. Inverse // @ts-nocheck opts one file out. Needs allowJs."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_types", "label": "JSDoc type annotations", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@param, @returns, @type, @typedef, @template, and import('./x.js').T cover ordinary application code. Conditional, mapped, and satisfies types get unreadable."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_playground", "label": "TypeScript Playground", "file_type": "concept", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolation: reproduce without local tsconfig/@types/editor version, toggle one option, compare compiler versions, inspect emitted JS, share a runnable link."}, {"id": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_vs_convert", "label": "JSDoc checking vs converting to .ts", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSDoc costs no build or rename; converting gives the full language. If types get hard to write in JSDoc, that file wants to be TypeScript."}], "edges": [{"source": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_ts_check", "target": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_ts_check", "target": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_checkjs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_vs_convert", "target": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_types", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/typescript/pages/phase-0-how-typescript-runs/13-playground-and-ts-check.md", "source_location": null, "weight": 1.0}, {"source": "docs_typescript_pages_phase_0_how_typescript_runs_13_playground_and_ts_check_jsdoc_vs_c