{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_unified_role", "label": "Role is user and group", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/roles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user is a role with LOGIN; a group is a role usually without LOGIN used for membership. One catalog concept."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_session_vs_current_user", "label": "session_user vs current_user", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/roles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "session_user is who authenticated; current_user can change after SET ROLE. Node uses the connection-string role."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_least_privilege_app_role", "label": "Least-privilege app role", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/roles.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container bootstrap is a superuser \u2014 fine for learning, wrong as the production app role. App DML only; not arbitrary DDL."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_least_privilege_app_role", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_unified_role", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/roles.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_roles_session_vs_current_user", "target": "build_css_p2_docs_postgresql_pages_phas