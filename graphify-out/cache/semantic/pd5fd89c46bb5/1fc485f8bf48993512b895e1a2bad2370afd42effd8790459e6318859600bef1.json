{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "label": "ON vs WHERE on outer joins", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For inner joins interchangeable. For outer joins, a right-table predicate in WHERE silently converts the join back to inner. Measured 2 rows vs 4."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_evaluation_order", "label": "FROM ON then WHERE pipeline", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FROM (including JOIN \u2026 ON) \u2192 WHERE \u2192 GROUP BY \u2192 HAVING \u2192 SELECT \u2192 ORDER BY. ON participates in matching; WHERE runs on finished join output. NULL = 'paid' is unknown and WHERE drops it."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_classification_rule", "label": "Outer-join predicate classification", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right-table filters belong in ON; left-table filters belong in WHERE (in ON they do not filter); the join key belongs in ON. A later INNER JOIN or HAVING on the right side also cancels the outer join."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_plan_rewritten_to_inner", "label": "Planner rewrites LEFT to Hash Join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPLAIN showing Hash Join where the query says LEFT JOIN means a WHERE predicate made NULL-extended rows unreachable. The node name is the diagnosis."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_evaluation_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_classification_rule", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_null_extension_left_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_plan_rewritten_to_inner", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_left_join_on_vs_where_on_vs_where", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_inner_join_matching_pairs_inner_join", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/left-join/on-vs-where.html", "source_location": null, "weight": 1.0}], "hyperedges": []}