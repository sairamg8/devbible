{"nodes": [{"id": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_operator", "label": "in operator", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True for own or inherited properties, including Object.prototype names. Right for capability detection. Throws on primitives; does not auto-box."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_object_hasown", "label": "Object.hasOwn", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modern default for data. Own-only, works on null-prototype objects, immune to shadowing, coerces primitives. ES2022 static method."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_hasownproperty", "label": "hasOwnProperty", "file_type": "concept", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broken on Object.create(null) and on objects that shadow the method. MDN prefers Object.hasOwn. Fallback is Object.prototype.hasOwnProperty.call."}, {"id": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_for_behaviour_hasown_for_data", "label": "in for behaviour, hasOwn for data", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use in for feature detection where inheritance should count. Never use in for user-supplied keys."}], "edges": [{"source": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_for_behaviour_hasown_for_data", "target": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_operator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_in_for_behaviour_hasown_for_data", "target": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_object_hasown", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_object_hasown", "target": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_hasownproperty", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-4-objects-and-classes/03-existence-checks-and-delete/01-in-and-hasown.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_4_objects_and_classes_03_existence_checks_and_delete_01_in_and_hasown_object_hasown", "target": "docs_javascript_pages_phase_4_objects_and_classes_01_object_literals_04_proto_and_null_prototype_object_create_null