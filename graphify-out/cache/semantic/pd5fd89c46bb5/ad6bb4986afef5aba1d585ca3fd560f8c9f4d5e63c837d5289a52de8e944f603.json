{"nodes": [{"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_n_plus_1_queries", "label": "N+1 queries", "file_type": "document", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_n_plus_1", "label": "N+1 query", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One query for the list, then one per item. Cost is round trips, not query work \u2014 101 queries 111 ms vs 2 queries 7 ms on localhost."}, {"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_promise_all_not_fix", "label": "Promise.all is not the N+1 fix", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "111 ms to 49 ms but 100 simultaneous queries demand 100 pool connections and can exhaust the process."}, {"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_batch_any_in", "label": "Batch with ANY / $in", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect ids, one child query, group in memory. Two queries regardless of page size; works across services. DataLoader does this per tick."}, {"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_json_agg_join", "label": "json_agg join", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One query, JSON arrays already shaped. Need left join plus filter to avoid dropping childless parents or [null]."}, {"id": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_query_count_per_request", "label": "Query count per request", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An endpoint whose query count grows with result size is an N+1. Assert it in tests; slow-query logs miss it."}], "edges": [{"source": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_n_plus_1", "target": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_promise_all_not_fix", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_n_plus_1", "target": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_batch_any_in", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_json_agg_join", "target": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_batch_any_in", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "weight": 0.75}, {"source": "docs_nodejs_pages_phase_6_data_access_07_n_plus_1_n_plus_1", "target": "docs_nodejs_pages_phase_6_data_access_13_prisma_drizzle_include_two_queries", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-6-data-access/07-n-plus-1.md", "source_location": null, "weight": 1.0}], "hyperedges": []}