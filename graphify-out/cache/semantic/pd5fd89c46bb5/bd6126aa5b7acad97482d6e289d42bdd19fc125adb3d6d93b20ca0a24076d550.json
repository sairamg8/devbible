{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_12_pagination_counts_02_estimates_and_caps_planner_estimate", "label": "Planner row estimate", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/12-pagination-counts/02-estimates-and-caps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPLAIN (FORMAT JSON) Plan Rows is free and was 125833 vs actual 125000 (0.7% high) here. Accuracy is not guaranteed: multi-column filters, correlated columns, and stale statistics can miss by orders of magnitude. Label it approximate."}, {"id": "docs_postgresql_pages_phase_6_aggregation_12_pagination_counts_02_estimates_and_caps_capped_count", "label": "Capped count", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/12-pagination-counts/02-estimates-and-caps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) over a subquery with LIMIT cap. Exact below the ceiling, report 1000+ at the cap. Pays only when matches are plentiful: 1.46 ms vs 33.85 ms (23\u00d7) at 125000 matches; 3.01 vs 3.02 ms at 120 matches \u2014 no saving."}, {"id": "docs_postgresql_pages_phase_6_aggregation_12_pagination_counts_02_estimates_and_caps_reltuples", "label": "reltuples", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/12-pagination-counts/02-estimates-and-caps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approximate whole-table row count in pg_class, maintained by VACUUM/ANALYZE. Good for order of magnitude; stale between maintenance; never for a user-reconciled total."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_12_pagination_counts_02_estimates_and_caps_reltuples", "target": "docs_postgresql_pages_phase_6_aggregation_12_pagination_counts_02_estim