{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_conflicts_and_routing", "label": "08.2 Query conflicts and routing reads safely", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/conflicts-and-routing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_conflicts_and_routing_recovery_conflict", "label": "Hot-standby recovery conflict", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/conflicts-and-routing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay of primary VACUUM can cancel a replica SELECT with retryable SQLSTATE 40001."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_conflicts_and_routing_hot_standby_feedback", "label": "hot_standby_feedback", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/conflicts-and-routing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eliminates early-cleanup conflicts by exporting the standby snapshot into the primary vacuum horizon, causing primary bloat."}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_conflicts_and_routing_max_standby_streaming_delay", "label": "max_standby_streaming_delay", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-13-ops/replication/conflicts-and-routing.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_13_ops_replication_conflicts_and_routing_read_routing", "label": "Replica read routing hierarchy", "file_type": "rationale", "source_file": "build-css-p2/docs