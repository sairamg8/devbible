{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union", "label": "UNION", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deduplicates via HashAggregate and blocks until both branches are consumed. Measured 491 ms vs 142 ms for UNION ALL over 600000 rows (3.5\u00d7)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union_all", "label": "UNION ALL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streaming Append that can stop under LIMIT. Default when branches are disjoint. Also the joining operator of a recursive CTE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_intersect", "label": "INTERSECT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-row intersection; same customers-with-orders answer as a semi join but compares entire rows and deduplicates. INTERSECT ALL keeps min(count_left, count_right)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_except", "label": "EXCEPT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole-row set difference. Answers which rows differ, not which entities are missing. EXCEPT ALL keeps count_left \u2212 count_right."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_column_and_type_rules", "label": "Set-op column and type rules", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column counts must match (42601). Types resolve like CASE. Names come from the first branch only. INTERSECT binds tighter than UNION and EXCEPT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_page", "label": "UNION INTERSECT EXCEPT page", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_page", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_union_all", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_intersect", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_semi_joins_exists", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-5-joins/set-ops.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_5_joins_set_ops_except", "target": "build_css_p2_docs_postgresql_pages_phase_5_joins_semi_anti_anti_joins_not_exists", "relation": "semantically_similar_