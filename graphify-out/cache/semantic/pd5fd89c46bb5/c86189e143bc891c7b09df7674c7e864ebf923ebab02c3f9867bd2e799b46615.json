{"nodes": [{"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_the_illegitimate_fixes", "label": "The illegitimate fixes", "file_type": "document", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two ways to silence the linter without changing what the effect depends on. Both freeze one render's values forever."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_suppress_linter", "label": "Suppressing exhaustive-deps is a lie", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There's always a better solution than ignoring the linter. If none of the eight moves apply, the effect probably should not exist."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_counter_stuck_at_one", "label": "Suppressed interval freezes the counter at 1", "file_type": "concept", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onTick from the first render closed over count 0 and increment 1, so every tick calls setCount(0 + 1). Not lagging \u2014 frozen."}, {"id": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_ref_as_smuggler", "label": "Ref used to hide a dependency", "file_type": "rationale", "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same lie with no comment. The sanctioned way to read latest without reacting is useEffectEvent. Test: replace the ref with the value."}], "edges": [{"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_suppress_linter", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_exhaustive_deps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_counter_stuck_at_one", "target": "docs_react_pages_phase_4_effects_03_the_dependency_array_stale_first_render_closure", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_ref_as_smuggler", "target": "docs_react_pages_phase_4_effects_04_cleanup_01_the_cleanup_contract_ref_guard_antifix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes_ref_as_smuggler", "target": "docs_react_pages_phase_4_effects_10_useeffectevent_useeffectevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-4-effects/11-removing-dependencies/03-the-illegitimate-fixes.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_4_effects_11_removing_dependencies_03_the_illegitimate_fixes