{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "label": "Seq scan vs index scan vs bitmap heap scan", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_sequential_scan", "label": "Sequential scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correct when most of the table qualifies. Forced index scan on 80% of 500k rows was 3\u00d7 slower with 400358 vs 3712 buffers."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_index_scan", "label": "Index scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walk the index and fetch each heap row. Chosen for a handful of rows; random I/O but very few of them."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_bitmap_heap_scan", "label": "Bitmap heap scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bitmap Index Scan collects locations, then heap is read in physical order. Recheck Cond / Heap Blocks: lossy= means the bitmap exceeded work_mem."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_random_page_cost", "label": "random_page_cost", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 4.0 assumes spinning disks. On SSD ~1.1 makes index scans more attractive. Change this instead of disable_seqscan."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_sequential_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_index_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_bitmap_heap_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_random_page_cost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/scan-types.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_scan_types_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_not_used_page", "relation": "references", "confidence": "EXTRACTED", "confidence_sco