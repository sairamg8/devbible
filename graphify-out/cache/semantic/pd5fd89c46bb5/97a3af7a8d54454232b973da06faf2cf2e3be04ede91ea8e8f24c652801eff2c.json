{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows", "label": "GROUP BY collapsing rows", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_collapse", "label": "GROUP BY collapse", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GROUP BY reduces the input to one row per key; selected expressions must be keys or aggregates."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_null_skip", "label": "Aggregates skip NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most aggregates skip NULL; count(*) is the exception that still counts the row."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_avg_identity", "label": "avg is sum over count", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "avg(x) is sum(x)/count(x), so NULLs in x do not enter either side."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_js_bigint", "label": "bigint numeric as JS strings", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node-postgres returns bigint and numeric as strings so they are not rounded in JS Number."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_collapse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_null_skip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_avg_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_collapsing_rows_js_bigint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by/collapsing-rows.html", "source_location": null, "weight": 1.0}], "hyperedges": []}