{"nodes": [{"id": "docs_nodejs_pages_phase_2_async_08_async_await_page", "label": "async and await", "file_type": "document", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_2_async_08_async_await_async_function", "label": "async function", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the function return a promise and permits await. Return fulfils; throw rejects. Adds no capability beyond promises, only syntax."}, {"id": "docs_nodejs_pages_phase_2_async_08_async_await_await_yields_microtask", "label": "await is a microtask yield", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Body runs synchronously until the first await; resumption is a microtask. Does not yield to timers or I/O. await setImmediate() is the real phase yield."}, {"id": "docs_nodejs_pages_phase_2_async_08_async_await_await_thenable", "label": "await accepts any thenable", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-promises are wrapped and still cost a microtask. await null is a cheap yield to microtasks only."}, {"id": "docs_nodejs_pages_phase_2_async_08_async_await_toplevel_await", "label": "Top-level await", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ES modules can await outside a function; importers wait. The module cannot be require()d from CommonJS."}, {"id": "docs_nodejs_pages_phase_2_async_08_async_await_await_foreach", "label": "await inside forEach", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Array.prototype.forEach ignores the returned promise, so the callback is fire-and-forget. Use for...of sequentially or Promise.all(map) in parallel."}], "edges": [{"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_async_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_await_yields_microtask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_await_yields_microtask", "target": "docs_nodejs_pages_phase_2_async_03_microtasks_and_macrotasks_await_yields_microtask", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_await_thenable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_toplevel_await", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_08_async_await_await_foreach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_04_setimmediate_vs_settimeout_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_10_sequential_vs_parallel_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_2_async_08_async_await_page", "target": "docs_nodejs_pages_phase_2_async_17_promise_antipatterns_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-2-async/08-async-await.md", "source_location": null, "weight": 1.0}], "hyperedges": []}