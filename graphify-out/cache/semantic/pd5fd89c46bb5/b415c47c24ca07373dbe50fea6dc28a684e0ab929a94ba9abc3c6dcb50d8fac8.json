{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_range_types", "label": "PostgreSQL range types", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-class intervals (int4range, tstzrange, daterange, \u2026) with @>, &&, <<, -|-. pg returns the text form '[1,10)'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_half_open", "label": "Half-open range default", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[1,10) includes 1 excludes 10. Discrete types canonicalise [1,10] to [1,11). Touching intervals do not overlap, so back-to-back bookings are legal."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_exclusion_constraint", "label": "Exclusion constraint", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXCLUDE USING gist (room WITH =, during WITH &&) forbids same-room overlap (23P01). Index-enforced, so concurrent read-then-write cannot both insert."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_btree_gist", "label": "btree_gist extension", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required so GiST can mix scalar equality with range overlap in one exclusion constraint."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_multirange", "label": "Multirange types", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 14+. Plain range union of gapped ranges raises 22000; int4multirange holds {[1,5),[10,15)} as one value."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_exclusion_constraint", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_btree_gist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_exclusion_constraint", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_half_open", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_multirange", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_range_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_exclusion_constraint", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_named_constraints", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/ranges.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_ranges_exclusion_constraint", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_a