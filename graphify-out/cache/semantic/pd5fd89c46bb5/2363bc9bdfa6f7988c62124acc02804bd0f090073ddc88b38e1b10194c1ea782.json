{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_remainder", "label": "Remainder % not modulo", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Result takes the sign of the dividend (C). -7%3 is -1. Breaks wrap-around indices going backwards."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_true_modulo", "label": "True modulo idiom", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "((a%b)+b)%b is always non-negative for a positive divisor. Measured ((-7%3)+3)%3 is 2."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_exponentiation", "label": "Exponentiation ** right-associative", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only right-associative arithmetic operator. 2**3**2 is 512. Replaces Math.pow."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_unary_minus_pow", "label": "-2 ** 2 SyntaxError", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Committee refused to pick between -(2**2)=-4 and (-2)**2=4. Grammar requires parentheses."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_plus_overload", "label": "Overloaded + concatenation", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If either operand is a string after ToPrimitive, + concatenates. Other arithmetic operators coerce to number. Unary + throws on BigInt."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_no_integer_division", "label": "No integer division", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/ always yields a double. trunc vs floor differ on negatives (-3 vs -4 for -7/2). Page count is Math.ceil(total/perPage)."}, {"id": "docs_javascript_pages_phase_2_operators_01_arithmetic_increment", "label": "Prefix vs postfix increment", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postfix returns before mutate; prefix after. Use as statements or in for headers, never nested."}], "edges": [{"source": "docs_javascript_pages_phase_2_operators_01_arithmetic_remainder", "target": "docs_javascript_pages_phase_2_operators_01_arithmetic_true_modulo", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_2_operators_01_arithmetic_exponentiation", "target": "docs_javascript_pages_phase_2_operators_01_arithmetic_unary_minus_pow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-2-operators/01-arithmetic.md", "source_location": null, "weight": 1.0}], "hyperedges": []}