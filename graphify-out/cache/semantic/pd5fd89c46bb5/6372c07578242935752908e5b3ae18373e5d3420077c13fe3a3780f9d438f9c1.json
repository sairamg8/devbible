{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_inlining_rule", "label": "The inlining rule", "file_type": "document", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before PG12 every CTE was an optimization fence. Since 12 a qualifying CTE is folded in. Same query 28.42 ms inlined vs 174.49 ms MATERIALIZED \u2014 6.1\u00d7."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "label": "CTE inlining conditions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inlined when referenced once, not MATERIALIZED, not recursive, does not write, and has no volatile function. Inlined CTE leaves no CTE node; filter can reach the scan and parallelise."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_materialized_hint", "label": "MATERIALIZED fence", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces a CTE Scan after materialising every row (500000 into Disk 21344kB, no parallelism). Use only when the query depends on the fence."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_limit_not_a_fence", "label": "LIMIT does not fence a CTE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CTE is still inlined. Limit stays below the outer filter so 10 rows then filter to 5, not first 10 matching the filter. Protects semantics, not cost."}, {"id": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_volatility_classes", "label": "Volatility classes and CTE inlining", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IMMUTABLE and STABLE (now()) inline. VOLATILE (random(), clock_timestamp()) fences because re-evaluation could change the answer. Same classification as indexability."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_inlining_rule", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_materialized_hint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_limit_not_a_fence", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_volatility_classes", "target": "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "cte_inlining_five_conditions", "label": "CTE inlining five-condition rule", "nodes": ["docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_cte_inlining", "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_materialized_hint", "docs_postgresql_pages_phase_6_aggregation_09_ctes_02_the_inlining_rule_volatility_classes", "docs_postgresql_pages_phase_6_aggregation_09_ctes_03_references_and_hints_multi_ref_once", "docs_postgresql_pages_phase_6_aggregation_10_modifying_ctes_01_one_statement_many_writes_always_fenced"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/09-ctes/02-the-inlining-rule.md"}]}