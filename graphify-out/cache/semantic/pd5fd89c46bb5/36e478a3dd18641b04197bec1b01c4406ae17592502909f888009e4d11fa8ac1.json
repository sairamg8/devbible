{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_the_illegitimate_fixes_the_illegitimate_fixes", "label": "The illegitimate fixes", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/removing-dependencies/the-illegitimate-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_the_illegitimate_fixes_counter_always_one", "label": "Suppressed interval always shows 1", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/removing-dependencies/the-illegitimate-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eslint-disable with [] keeps the first render's onTick, which always calls setCount(0 + 1). The counter is frozen at first-render arithmetic."}, {"id": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_the_illegitimate_fixes_ref_to_hide", "label": "Refs used to hide a dependency", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-4-effects/removing-dependencies/the-illegitimate-fixes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading ref.current is not tracked, so a ref can smuggle a reactive value past the linter and produce the same stale-forever bug."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_4_effects_removing_dependencies_the_illegitimate_fixes_counter_always_one", "target": "build_css_p2_docs_react_pages_phase_4_effects_the_dependency_array_exhaustive_deps", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-4-effects/removing-dependencies/the-illegitimate-fixes.html", "source_location": null, "weight": 1.0}, {"sou