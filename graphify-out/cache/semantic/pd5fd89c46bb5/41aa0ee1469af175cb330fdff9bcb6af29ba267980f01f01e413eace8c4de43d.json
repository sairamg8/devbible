{"nodes": [{"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_page", "label": "dangerouslySetInnerHTML", "file_type": "document", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_escapes_by_default", "label": "React escapes text and attributes by default", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary XSS vectors are closed unless you opt in. The name and nested __html key are deliberate speed bumps."}, {"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_javascript_url", "label": "React 19 rewrites javascript: URLs", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewritten to throw on click, but the href still appears in markup \u2014 scanners flag a finding that is already mitigated."}, {"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_api_shape", "label": "Must be {__html: ...} and exclusive of children", "file_type": "concept", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong shape throws #61. children plus innerHTML throws #60. Nested key prevents an accidental server object from matching."}, {"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_script_vs_onerror", "label": "script tags do not run; img onerror does", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "innerHTML never executes script elements. Measured: img onerror and iframe srcdoc ran. Filtering <script> is not a sanitizer."}, {"id": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_sanitize", "label": "Sanitize with a real library or do not inject", "file_type": "rationale", "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe only if HTML is entirely yours, or DOMPurify (allowlist attributes, not just tags) as close to render as possible."}], "edges": [{"source": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_page", "target": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_escapes_by_default", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_page", "target": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_javascript_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_page", "target": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_api_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-1-jsx/12-dangerously-set-inner-html.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_page", "target": "docs_react_pages_phase_1_jsx_12_dangerously_set_inner_html_sc