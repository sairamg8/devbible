{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_listen_notify_listen_notify", "label": "LISTEN/NOTIFY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transactional wake-up with no extra broker. At-most-once, 8000-byte payload, dedicated listener connection. Use as a hint beside durable state."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_listen_notify_pg_notify", "label": "pg_notify", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes a string channel used exactly as given and can be computed. NOTIFY folds unquoted identifiers."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_listen_notify_notification_queue", "label": "Notification queue", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared 8 GB queue until every listener has read. A stuck listener is a database-wide problem."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_listen_notify_at_most_once", "label": "NOTIFY at-most-once", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A notification sent while nobody is listening is discarded. Combine with a transactional outbox if the event must not be lost."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_bey