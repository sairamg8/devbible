{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_page", "label": "Supply chain", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed code runs at install and at runtime with your env. Verified Node 24.19.0 / npm 12.0.2 / yarn 4.18."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_supply_chain", "label": "npm supply-chain threat", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency minimisation is the only defence that scales. Node stdlib absorbed fetch, --env-file, node:test, parseArgs, randomUUID, structuredClone, glob."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_allow_scripts", "label": "npm 12 allowScripts", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install scripts blocked unless allowlisted. An approved postinstall read 103 env vars. Yarn uses enableScripts; npm ci --ignore-scripts is belt-and-braces."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_lockfile_integrity", "label": "Lockfile integrity", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm ci, never npm install, in CI. Integrity hashes produce EINTEGRITY on a swapped tarball. Review lockfile diffs for packages with no package.json change."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_provenance", "label": "npm provenance attestations", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registry signatures say the registry served what it recorded. Provenance is Sigstore SLSA that a CI workflow built this commit. Signal, not a gate (3 of 11 here)."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_min_release_age", "label": "Release cooldown min-release-age", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most malicious versions are unpublished in days. npm min-release-age / yarn npmMinimalAgeGate of 7\u201314 days. ENOVERSIONS rather than a quiet newer install."}, {"id": "docs_nodejs_pages_phase_8_security_23_supply_chain_npm_audit", "label": "npm audit limits", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches known disclosed advisories only. Misses a package compromised today; reports build-only ReDoS. Pair --audit-level=high with signatures and a cooldown."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_23_supply_chain_page", "target": "docs_nodejs_pages_phase_8_security_23_supply_chain_supply_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_23_supply_chain_page", "target": "docs_nodejs_pages_phase_8_security_23_supply_chain_allow_scripts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/23-supply-chain.md", "source_location": 