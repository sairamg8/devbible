{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_update", "label": "UPDATE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET can reference current values. Forget WHERE and every row changes; read-modify-write loses concurrent increments."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_from", "label": "UPDATE ... FROM", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inner-join a source of new values. Duplicate source keys pick one winner arbitrarily; MERGE raises 21000 instead."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_lost_updates", "label": "Lost updates from read-modify-write", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 concurrent SELECT-then-UPDATE increments produced 2. SET qty = qty + 1 serialises under a row lock and produced 20."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_patch_coalesce", "label": "PATCH via COALESCE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SET col = COALESCE($n, col) leaves unsent fields alone. It cannot set a column to NULL; then build SET from present keys."}, {"id": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_mvcc_new_tuple", "label": "UPDATE writes a new tuple version", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL never updates in place. Dead versions wait for VACUUM; non-HOT updates also write new index entries."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_from", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_lost_updates", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_patch_coalesce", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_mvcc_new_tuple", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_update", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_from", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_source_duplicate_21000", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_4_crud_update_lost_updates", "target": "build_css_p2_docs_postgresql_pages_phase_4_crud_merge_vs_on_conflict_not_index_arbitrated", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-4-crud/update.html", "source_location": null, "weight": 1.0}], "hyperedges": []}