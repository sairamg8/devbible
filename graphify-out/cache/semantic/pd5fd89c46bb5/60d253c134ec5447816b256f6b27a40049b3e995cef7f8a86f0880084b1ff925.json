{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_result_object_result_object", "label": "pg Result object", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/result-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public fields: rows, rowCount, command, fields. oid is legacy. Underscored fields are internal."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_result_object_rowcount_vs_rows", "label": "rowCount vs rows.length", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/result-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rowCount is rows affected; rows.length is rows sent back. UPDATE without RETURNING is 1 and []. DDL rowCount is null, not 0."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_result_object_select_star_join_collapse", "label": "SELECT * join column collapse", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/result-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicate column names collapse in the row object with no error. fields still lists all four; the last name wins. Alias or use rowMode array."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_result_object_rowmode_array", "label": "rowMode: 'array'", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/result-object.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows as positional arrays. Preserves duplicate names and skips object allocation on large results."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_