{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_01_structured_logging_structured_logging", "label": "Structured logging", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A production log line is a searchable record. Every line is one JSON object with a small set of agreed keys."}, {"id": "docs_nodejs_pages_phase_10_observability_01_structured_logging_console_log_blocks", "label": "console.log can block the event loop", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "console is synchronous on some destinations. When stdout is a pipe a slow consumer can block the loop under a traffic spike."}, {"id": "docs_nodejs_pages_phase_10_observability_01_structured_logging_log_levels", "label": "Log levels", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fatal/error, warn, info, debug, trace. Default production to info. Turning on debug fleet-wide fills a disk."}, {"id": "docs_nodejs_pages_phase_10_observability_01_structured_logging_minimum_schema", "label": "Minimum log schema", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "time, level, msg, service/version, reqId/traceId, and domain ids as dedicated fields \u2014 never only buried in msg."}, {"id": "docs_nodejs_pages_phase_10_observability_01_structured_logging_three_signals", "label": "Logs, traces, and metrics", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs are discrete events. Metrics are aggregates. Traces connect work across services. None replaces the others."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_01_structured_logging_console_log_blocks", "target": "docs_nodejs_pages_phase_10_observability_01_structured_logging_structured_logging", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_01_structured_logging_log_levels", "target": "docs_nodejs_pages_phase_10_observability_01_structured_logging_structured_logging", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_01_structured_logging_minimum_schema", "target": "docs_nodejs_pages_phase_10_observability_01_structured_logging_structured_logging", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_01_structured_logging_minimum_schema", "target": "docs_nodejs_pages_phase_10_observability_03_correlation_ids_correlation_ids", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/01-structured-logging.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_01_structured