{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_retry_safe_failures", "label": "Retry only safe transient failures", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_two_questions", "label": "Transient and safe-to-repeat", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both must be yes. Three of four matrix cells say do not retry. Duplicate charges come from retrying a transient but unsafe POST."}, {"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_transient_vs_permanent", "label": "Transient vs permanent HTTP failures", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "429 and 5xx retry. Other 4xx fail identically forever. 409 only after re-read. Retrying 422 burns the attempt budget and looks like an outage."}, {"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_timeout_is_unknown", "label": "A timeout is not a failure", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The request may have succeeded after you stopped listening. Retrying an unguarded POST /charge is a second execution of work that already happened."}, {"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_idempotency_key", "label": "Domain-derived idempotency key", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider header or unique constraint plus ON CONFLICT DO NOTHING. Then repetition is harmless and retrying is free."}, {"id": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_retry_one_layer", "label": "Retry at one layer", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client \u00d7 service \u00d7 job attempts: 5\u00d75\u00d75 is 125 hits on a struggling dependency. In a job, throw and let the queue reschedule \u2014 do not sleep in the handler."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_retry_safe_failures", "target": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_two_questions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_retry_safe_failures", "target": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_transient_vs_permanent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/14-retry-safe-failures.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_timeout_is_unknown", "target": "docs_nodejs_pages_phase_7_background_work_14_retry_safe_failures_two_questions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 