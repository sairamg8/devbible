{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_page", "label": "DDL locks and the blocking they cause", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What the same DDL does to a table being read. ACCESS EXCLUSIVE conflicts with everything including SELECT's ACCESS SHARE."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_access_exclusive", "label": "ACCESS EXCLUSIVE", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALTER TABLE ADD COLUMN takes AccessExclusiveLock. CREATE INDEX takes ShareLock (writes block, reads proceed). CONCURRENTLY permits writes."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_lock_queue", "label": "Lock queue convoy", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12 ms ALTER behind a 3 s read blocked later SELECTs for 2.4 s. Locks grant in request order so strong lockers cannot starve. Pool exhausts as 'too many clients'."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_lock_timeout", "label": "lock_timeout vs statement_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lock_timeout bounds lock wait (55P03). statement_timeout bounds execution; a waiter is not executing. Set lock_timeout per migration session."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_issuing_ddl_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_lock_queue", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_access_exclusive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_locks_and_blocking_lock_timeout", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_nowait_skip_locked", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/ddl-from-node/locks-and-blocking.html", "source_location": null, "weight": 1.0}], "hyperedges": []}