{"nodes": [{"id": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_result", "label": "pg Result object", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public fields: rows, rowCount, command, fields, oid. Underscore fields are internal. Multi-statement without params resolves to an array of Results, so result.rows is undefined."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_rowcount", "label": "rowCount", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows the statement acted on, not rows.length. UPDATE without RETURNING: rowCount 1, rows []. DDL: rowCount null, not 0 \u2014 if (!rowCount) treats CREATE as failure. MERGE sums inserts, updates and deletes."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_fields", "label": "Result.fields", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column metadata: name and dataTypeID (OID). 20=int8, 25=text, 23=int4. Present even when zero rows. Driver uses OID to choose a parser \u2014 why int8 arrives as a string."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_select_star_collapse", "label": "SELECT * duplicate column collapse", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joined SELECT * can return four columns in fields and two keys in the row object. Last name wins, no error. Alias columns or use rowMode array."}, {"id": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_rowmode_array", "label": "rowMode: array", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows as positional arrays. Preserves duplicate names, suits CSV, skips object construction on large results. Cost is position-dependent code."}], "edges": [{"source": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_result", "target": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_rowcount", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_result", "target": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_fields", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_select_star_collapse", "target": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_result", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_rowmode_array", "target": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_select_star_collapse", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_7_pg_driver_06_result_object_rowmode_array", "target": "docs_postgresql_pages_phase_7_pg_driver_04_query_placeholders_pool_query", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-7-pg-driver/06-result-object.md", "source_location": null, "weight": 1.0}], "hyperedges": []}