{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_page", "label": "Deadlocks", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/deadlocks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_deadlock_40p01", "label": "Deadlock 40P01", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/deadlocks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cycle of lock waits. After deadlock_timeout PostgreSQL aborts the cheaper victim with 40P01. DETAIL names both processes; queries are only in the server log."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_consistent_lock_order", "label": "Consistent lock order", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/deadlocks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix is locking rows in a stable order via SELECT ... ORDER BY id FOR UPDATE, not retry. Opposite order deadlocked in 1155 ms; same order both committed in 326 ms."}, {"id": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_deadlock_timeout", "label": "deadlock_timeout", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-11-mvcc/deadlocks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 1s. PostgreSQL does not check for cycles on every wait. Every deadlock costs at least that second. log_lock_waits logs waits past this threshold."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_page", "target": "build_css_p2_docs_postgresql_pages_phase_11_mvcc_deadlocks_deadlock_40p0