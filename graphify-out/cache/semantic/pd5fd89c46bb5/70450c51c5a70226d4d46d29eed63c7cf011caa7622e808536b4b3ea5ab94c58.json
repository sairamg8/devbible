{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_render_order_page", "label": "12 \u00b7 Render order", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/render-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_render_order_top_down_depth_first", "label": "Top-down depth-first render", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/render-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A parent must finish before its children, because React cannot know the children until the parent returns them."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_render_order_bottom_up_effects", "label": "Bottom-up effect order", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/render-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effects run children-first so a parent measuring a child finds mounted refs. ref.current is null during render because refs attach at commit."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_render_order_cannot_update_other_component", "label": "Cannot update a component while rendering a different component", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/render-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_render_order_page", "target": "build_css_p2_docs_react_pages_phase_3_state_render_order_top_down_depth_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/render-order.html", "sourc