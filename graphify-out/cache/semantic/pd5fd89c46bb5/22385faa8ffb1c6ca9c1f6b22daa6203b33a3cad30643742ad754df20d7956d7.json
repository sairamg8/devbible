{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_cookies_and_helpers_cookie_read_write_asymmetry", "label": "Cookie read/write asymmetry", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/cookies-and-helpers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing cookies is built in via res.cookie. Reading them needs cookie-parser or a manual Cookie header parse."}, {"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_cookies_and_helpers_cookie_parser", "label": "cookie-parser", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/cookies-and-helpers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mount cookieParser() for req.cookies; cookieParser('secret') fills req.signedCookies. Session middleware typically depends on it."}, {"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_cookies_and_helpers_signed_not_encrypted", "label": "Signed cookies are not encryption", "file_type": "rationale", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/cookies-and-helpers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed cookies detect tampering; they are not encryption. Secrets still need HTTPS and careful res.cookie flags."}, {"id": "build_css_p2_docs_expressjs_pages_phase_3_requests_cookies_and_helpers_req_helpers", "label": "req.accepts / req.is / req.get", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-3-requests/cookies-and-helpers.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small req helpers avoid reinventing Accept negotiation, Content-Type checks, and case-insensitive header reads."}], "edges": [{"sou