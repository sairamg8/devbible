{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_numeric_plus_currency", "label": "numeric plus currency column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An amount without a currency is incomplete. Composite FK (invoice_id, currency) can force child rows to match the parent currency."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_pg_money_type", "label": "Do not use the money type", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locale-dependent via lc_monetary; dump/restore can misinterpret; no currency identity. Docs warn against it for financial records."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_iso_4217_minor_units", "label": "ISO 4217 minor units", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not every currency has two decimals (JPY 0, some 3). Hard-coded \u00f7100 is wrong by 10\u00d7 or 100\u00d7. Store minor_units per currency."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_declare_scale", "label": "Always declare numeric scale", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bare numeric allows 16383 fractional digits so 19.990000001 \u2260 19.99. Totals numeric(14,2); unit prices more scale; rates numeric(18,8)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_pg_money_type", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_numeric_plus_currency", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_iso_4217_minor_units", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_integer_cents", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_declare_scale", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/modelling-money/storing-money.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "pg_money_exactness_stack", "label": "Exact money modelling stack", "nodes": ["build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_numeric", "build_css_p2_docs_postgresql_pages_phase_2_types_numeric_vs_float_integer_cents", "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_storing_money_numeric_plus_currency", "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_rounding_round_once", "build_css_p2_docs_postgresql_pages_phase_2_types_modelling_money_arithmetic_and_round