{"nodes": [{"id": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value", "label": "Who owns the value", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_definition", "label": "Controlled versus uncontrolled", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Informal terms asked per piece of state. Controlled means the important information is driven by props; uncontrolled means local state the parent cannot influence."}, {"id": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_trade", "label": "Controlled flexibility versus uncontrolled ease", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncontrolled needs less API but cannot coordinate. Controlling lifts state, so updates re-render the owner and everything below."}, {"id": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_five_triggers", "label": "Five triggers to control a value", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordination, persistence, validation, programmatic control, or reflecting external data. Do not control in case."}, {"id": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_naming", "label": "Controlled API naming", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "value/onChange, checked/onChange, open/onOpenChange, defaultX for the uncontrolled initial. Call the handler with the next value."}], "edges": [{"source": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value", "target": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_definition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_definition", "target": "docs_react_pages_phase_2_components_05_lifting_state_up_01_the_procedure_three_steps", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_five_triggers", "target": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the_value_definition", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/04-controlled-vs-uncontrolled/01-who-owns-the-value.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_04_controlled_vs_uncontrolled_01_who_owns_the