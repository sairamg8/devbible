{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_transpilation_polyfills_transpiler_vs_polyfill", "label": "Transpiler vs polyfill", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/transpilation-polyfills.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transpiler rewrites syntax at build time. A polyfill adds a missing API at runtime. Neither substitutes for the other."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_transpilation_polyfills_ponyfill", "label": "Ponyfill", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/transpilation-polyfills.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports the implementation instead of patching the global. Prefer in libraries. Global polyfills only in an application entry point."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_transpilation_polyfills_unpolyfillable", "label": "Unpolyfillable engine features", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/transpilation-polyfills.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxy, WeakRef, BigInt and real #private fields cannot be reconstructed in JavaScript. Raise the floor or design around them."}, {"id": "build_css_p2_docs_javascript_pages_phase_0_how_javascript_runs_transpilation_polyfills_browserslist", "label": "browserslist and useBuiltIns usage", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-0-how-javascript-runs/transpilation-polyfills.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ta