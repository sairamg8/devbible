{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_alloc", "label": "Buffer.alloc", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-fills and never uses the pool. Default for anything holding user data, secrets, or crossing a response boundary."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafe", "label": "Buffer.allocUnsafe", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns recently freed process memory unzeroed \u2014 about 20\u00d7 faster. Must overwrite every byte before anything reads it."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_pool", "label": "Buffer pool", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "64 KB slab (Buffer.poolSize 65536 in Node 24). allocUnsafe below half the pool is carved from the slab. buf.buffer is the whole shared slab."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafeslow", "label": "Buffer.allocUnsafeSlow", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips the pool: own exactly-sized ArrayBuffer, byteOffset 0. Still uninitialized; safe to retain long-term."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_new_buffer_deprecated", "label": "new Buffer deprecated DEP0005", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A numeric argument dispatched to allocUnsafe, so new Buffer(req.body.size) was a remote memory disclosure. Split into Buffer.from and Buffer.alloc."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_memory_disclosure", "label": "allocUnsafe memory disclosure", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After 5000 fake request bodies, 44% of subsequent 80-byte allocUnsafe calls contained the password. Mechanism behind CVE-2016-2216-class bugs."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_memory_disclosure", "target": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafe", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_pool", "target": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafe", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafeslow", "target": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_new_buffer_deprecated", "target": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafe", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_alloc", "target": "docs_nodejs_pages_phase_3_buffers_streams_03_alloc_vs_allocunsafe_buffer_allocunsafe", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/03-alloc-vs-allocunsafe.md", "source_location": null, "weight": 1.0}], "hyperedges": []}