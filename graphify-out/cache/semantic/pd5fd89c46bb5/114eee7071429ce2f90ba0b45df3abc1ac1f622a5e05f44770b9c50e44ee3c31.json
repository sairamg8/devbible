{"nodes": [{"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_side_effects", "label": "Outbound side-effects as jobs", "file_type": "document", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_queue_outbound_calls", "label": "Queue every outbound call", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A third party's latency and availability become yours in the request path. Their p99 is your p99, their 503 is your 500, and the request cannot retry."}, {"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_job_properties", "label": "Four outbound-job properties", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent on a domain-derived key, bounded by a timeout, classified so 4xx die permanently, and recorded locally as the idempotency guard."}, {"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_webhook_fan_out", "label": "One delivery job per webhook subscriber", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dispatcher enqueues N jobs. One job looping over subscribers fails as a unit and re-delivers to those that already succeeded."}, {"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_hmac_webhook_signing", "label": "Signed outbound webhook payload", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC over the body with a per-subscriber secret plus a timestamp so a captured request cannot be replayed. Include an event id for receiver dedup."}, {"id": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_provider_idempotency_key", "label": "Provider idempotency key", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain-derived key such as order-receipt:orderId, plus the provider's own key, closes the window a local sent-table cannot."}], "edges": [{"source": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_queue_outbound_calls", "target": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_side_effects", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_side_effects", "target": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_job_properties", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-7-background-work/09-outbound-side-effects.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_outbound_side_effects", "target": "docs_nodejs_pages_phase_7_background_work_09_outbound_side_effects_webhook_fan_out", "relation": "references", "confidence