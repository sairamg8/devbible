{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_initially_deferred", "label": "DEFERRABLE INITIALLY DEFERRED", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked at COMMIT. INITIALLY IMMEDIATE is usually right: fail-fast unless SET CONSTRAINTS \u2026 DEFERRED. Applies to UNIQUE, PK, EXCLUDE, FK \u2014 not NOT NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_circular_fks", "label": "Circular foreign keys", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immediate insert of mutual references fails 23503. Deferral lets both rows exist before the check. Often a modelling smell versus a nullable FK plus flag."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_unique_swap", "label": "Defer UNIQUE to swap values", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swapping positions 1 and 2 collides midway under immediate UNIQUE. A bare unique index cannot be deferred."}, {"id": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_on_conflict", "label": "Deferrable UNIQUE cannot be ON CONFLICT arbiter", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upsert needs an immediate arbiter. Deferring a unique constraint silently removes it as an ON CONFLICT target."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_circular_fks", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_initially_deferred", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_unique_swap", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_initially_deferred", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_on_conflict", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_initially_deferred", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_3_ddl_deferrable_initially_deferred", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_foreign_keys_no_action_vs_restrict", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-3-ddl/deferrable.html", "source_location": null, "weight": 1.0}], "hyperedges": []}