{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_17_major_upgrades", "label": "Major version upgrades", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/17-major-upgrades.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_17_major_upgrades_minor_vs_major", "label": "Minor vs major upgrade", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/17-major-upgrades.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "18.3\u219218.4 is binaries plus restart. 17\u219218 changes on-disk format. Minor upgrades carry security fixes and should be applied promptly."}, {"id": "docs_postgresql_pages_phase_13_ops_17_major_upgrades_pg_upgrade", "label": "pg_upgrade catalog migration", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/17-major-upgrades.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--check works with the old server running. Install new extension .so files but do not CREATE EXTENSION on the new cluster."}, {"id": "docs_postgresql_pages_phase_13_ops_17_major_upgrades_link_swap", "label": "pg_upgrade --link and --swap destroy rollback", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/17-major-upgrades.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--link makes the old cluster unusable once the new one starts. --swap destructively modifies the old cluster once transfer begins. Verified backup is a precondition."}, {"id": "docs_postgresql_pages_phase_13_ops_17_major_upgrades_statistics_pg18", "label": "PostgreSQL 18 transfers most optimizer statistics", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/17-major-upgrades.md", "so