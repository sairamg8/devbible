{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "label": "Four golden signals", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From Google's SRE workbook. Latency, traffic, errors, and saturation tell you whether a service is healthy \u2014 everything else is a breakdown or a distraction."}, {"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_latency", "label": "Latency signal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How long successful and failed work takes. Histogram by status class. Average latency hides the long tail."}, {"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_traffic", "label": "Traffic signal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demand: requests/sec, jobs enqueued/sec, messages consumed/sec. Alert on sudden drop or spike vs baseline."}, {"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_errors", "label": "Errors signal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate of failed work (5xx ratio, failed jobs). Error ratio, not absolute count. Often only 5xx plus selected 4xx belong in the SLO."}, {"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_saturation", "label": "Saturation signal", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leading indicator: event loop lag, pool wait, heap ratio, queue depth, CPU. Traffic and latency go bad after the constrained resource is full."}, {"id": "docs_nodejs_pages_phase_10_observability_11_golden_signals_low_cardinality_labels", "label": "Low-cardinality metric labels", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "route is the template (/orders/:id), never the raw URL or userId. Unbounded labels kill Prometheus."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_latency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_traffic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "target": "docs_nodejs_pages_phase_10_observability_11_golden_signals_errors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/11-golden-signals.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_11_golden_signals_golden_signals", "target": "docs_nodejs_p