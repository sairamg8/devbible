{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_constant_memory", "label": "Streams keep memory constant", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/07-why-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process data in chunks so peak memory is independent of input size. 216 MB log: 670 MB RSS buffered vs 88 MB streamed."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_max_string_length", "label": "V8 MAX_STRING_LENGTH", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/07-why-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0x1fffffe8 characters (~512 MB). readFile utf8 or toString on a larger file throws ERR_STRING_TOO_LONG with no workaround except streaming."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_when_not_to_stream", "label": "When not to stream", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/07-why-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If data is bounded and small, buffer it. Streaming costs error handling, backpressure, and forbids whole-value ops like JSON.parse."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_chunk_not_a_line", "label": "A chunk is not a line", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/07-why-streams.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default high water mark is 64 KB (raised from 16 KB in Node 22). Chunks split lines, JSON records and multi-byte characters arbitrarily."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_07_why_streams_max_string_len