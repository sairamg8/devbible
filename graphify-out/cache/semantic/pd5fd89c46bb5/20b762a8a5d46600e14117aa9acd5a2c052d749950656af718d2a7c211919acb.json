{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_declaration_hoist", "label": "Function declaration hoisting", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name and body exist from the top of the scope, even out of unreachable code. Only form callable before its line."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_expression_tdz", "label": "Function expression TDZ", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const/let expressions throw ReferenceError: Cannot access before initialization. var f=function(){} hoists as undefined then TypeError: f is not a function."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_arrow_no_prototype", "label": "Arrow functions lack function machinery", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No own this, arguments, prototype, super, or new.target. new A() is TypeError: A is not a constructor. prototype is undefined."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_inferred_name", "label": "Inferred function .name", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigned functions pick up the binding name. Only never-bound expressions have name ''. Named expressions appear in stack traces."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_inner_name", "label": "Named function expression inner binding", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "const fact=function inner(n){\u2026} \u2014 inner is visible only inside the body, a recursion handle that survives reassignment of fact."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_arrow_arguments", "label": "Arrow closes over outer arguments", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-scope arrow: ReferenceError. Nested arrow silently reports the enclosing call's arguments (4 args in, length 2). Use rest."}, {"id": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_tostring", "label": "Function.prototype.toString source", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/01-declarations-expressions-arrows.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns exact source. Method shorthand m(){return 1;} is not a valid standalone expression, so DI that evals toString breaks."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_declaration_hoist", "target": "docs_javascript_pages_phase_3_functions_01_declarations_expressions_arrows_expression_tdz", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/javascript/pages/phase-3-functions/01-declarati