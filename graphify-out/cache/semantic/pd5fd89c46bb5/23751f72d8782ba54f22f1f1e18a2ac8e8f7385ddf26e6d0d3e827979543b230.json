{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_grant_and_revoke", "label": "GRANT and REVOKE", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_schema_usage", "label": "Schema USAGE before table verbs", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GRANT SELECT on a table is unreachable until USAGE on the schema passes. The error noun is the diagnosis: permission denied for schema vs for table."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_truncate_vs_delete", "label": "TRUNCATE is not DELETE", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DELETE is MVCC row removal; TRUNCATE takes ACCESS EXCLUSIVE and discards the file. Withholding TRUNCATE from the app role turns an injected TRUNCATE into 42501."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_maintain_privilege", "label": "MAINTAIN privilege", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 17+ delegates VACUUM, ANALYZE, REINDEX, CLUSTER and REFRESH MATERIALIZED VIEW without ownership. VACUUM without MAINTAIN returns OK and only warns, so nightly jobs can succeed while vacuuming nothing."}, {"id": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_identity_vs_serial", "label": "Identity vs serial sequence grant", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An identity sequence is owned by the column so INSERT needs no USAGE on the sequence. A serial DEFAULT nextval() is an ordinary sequence call and needs GRANT USAGE ON SEQUENCE."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_schema_usage", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_truncate_vs_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_maintain_privilege", "target": "docs_postgresql_pages_phase_13_ops_09_monitoring_01_whats_happening_now_pg_stat_activity", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_identity_vs_serial", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_04_defaults_and_auditing_alter_default_privileges", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_01_roles_grant_02_grant_and_revoke_grant_and_revoke", "target": "docs_postgresql_pages_phase_13_ops_01_roles_grant_03_columns_and_ownership_columns_and_ownership", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/01-roles-grant/02-grant-and-revoke.md", "source_location": null, "weight": 1.0}], "hyperedges": []}