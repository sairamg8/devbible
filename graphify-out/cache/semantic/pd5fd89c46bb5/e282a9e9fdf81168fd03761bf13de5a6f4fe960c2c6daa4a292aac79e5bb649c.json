{"nodes": [{"id": "docs_javascript_pages_phase_2_operators_10_precedence_five_that_bite", "label": "Five precedence bugs", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/10-precedence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not memorise twenty levels. Learn ** right-assoc, + string poison, && tighter than ||, typeof tighter than +, comparisons do not chain."}, {"id": "docs_javascript_pages_phase_2_operators_10_precedence_plus_string_position", "label": "+ string position changes the answer", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/10-precedence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1+2+'3' is '33'; '1'+2+3 is '123'. Left-to-right; first string poisons the rest."}, {"id": "docs_javascript_pages_phase_2_operators_10_precedence_and_tighter_or", "label": "&& binds tighter than ||", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/10-precedence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a||b&&c is a||(b&&c). Always parenthesise mixed &&/||. Mixing ?? is SyntaxError instead."}, {"id": "docs_javascript_pages_phase_2_operators_10_precedence_typeof_plus", "label": "typeof binds tighter than +", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/10-precedence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "typeof 1+1 is 'number1'. Unary operators bind very tightly."}, {"id": "docs_javascript_pages_phase_2_operators_10_precedence_no_chained_compare", "label": "Comparisons do not chain", "file_type": "concept", "source_file": "docs/javascript/pages/phase-2-operators/10-precedence.md", "source_location": null, "source_url": null, "c