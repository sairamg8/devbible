{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_process_per_connection", "label": "Process-per-connection backend", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each client connection is a dedicated OS backend that holds session state and can crash without taking down other clients."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_max_connections", "label": "max_connections", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-wide cap on concurrent backends. Every app, admin session, and tool shares that budget (sandbox default 100)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_node_pool", "label": "Node connection pool", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One global Pool at module scope reuses backends. pool.query borrows a client; it does not fork a new process per query."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_connection_equals_process", "label": "Connection approximates a process", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolation and simpler memory accounting cost RAM and startup per backend. That cost is why PgBouncer exists (Phase 13)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_connection_equals_process", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_process_per_connection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_node_pool", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_process_per_connection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_process_per_connection", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_max_connections", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_connection_equals_process", "target": "build_css_p2_docs_postgresql_pages_phase_13_ops_pgbouncer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/client-server-model.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_client_server_model_node_pool", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_at_module_scope", "relation": "conceptually_relate