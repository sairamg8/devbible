{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_page", "label": "Optimistic concurrency", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default for human-timescale edits. No locks when uncontended. Lost updates span two HTTP requests that no transaction can cover."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_lost_update", "label": "Lost update", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two requests both read 100, wrote 110 and 120; both reported ok; expected 130. No error."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_version_column", "label": "version column", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UPDATE \u2026 SET balance, version = version + 1 WHERE id AND version = $n. Increment in the same statement. Stale write is rowCount 0 \u2192 409. updated_at fails when now() is shared in one transaction."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_rowcount_ambiguous", "label": "rowCount 0 is 404 or 409", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing row and stale version look identical. Re-read or a data-modifying CTE (updated/conflict/empty). Never report 404 for a conflict."}, {"id": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_retry_relative", "label": "Retry only relative operations", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add-N can retry. Absolute 'set to what the user saw' is a 409. Cap attempts and back off. ETag/If-Match is the HTTP spelling (412)."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_page", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_version_column", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_lost_update", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_retry_relative", "target": "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_version_column", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-9-api-crud/optimistic.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "lost_update_defenses", "label": "Lost-update defenses", "nodes": ["build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_lost_update", "build_css_p2_docs_postgresql_pages_phase_9_api_crud_optimistic_version_column", "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for_update_select_for_update", "build_css_p2_docs_postgresql_pages_phase_9_api_crud_for