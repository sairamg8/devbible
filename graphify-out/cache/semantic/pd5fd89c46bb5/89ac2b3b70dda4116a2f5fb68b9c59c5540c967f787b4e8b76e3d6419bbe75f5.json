{"nodes": [{"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_readme_hoisting_and_tdz", "label": "Hoisting and the temporal dead zone", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is moved. Entering a scope creates a binding for every declaration before any code runs. What went into the slot differs by declaration kind."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_readme_nothing_is_moved", "label": "Nothing is moved to the top", "file_type": "rationale", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec has no hoisting. Bindings are created at scope entry. The TDZ is a stretch of time, not a region of source."}, {"id": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_readme_hoisting_kinds_table", "label": "Declaration binding table", "file_type": "concept", "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "function is usable before its line; var is undefined; let/const/class throw ReferenceError; import is a live binding with side effects first."}], "edges": [{"source": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_readme_nothing_is_moved", "target": "docs_javascript_pages_phase_3_functions_08_hoisting_and_tdz_readme_hoisting_and_tdz", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/javascript/pages/phase-3-functions/08-hoisting-and-tdz/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_javascript_pages_phase_3_functions_08