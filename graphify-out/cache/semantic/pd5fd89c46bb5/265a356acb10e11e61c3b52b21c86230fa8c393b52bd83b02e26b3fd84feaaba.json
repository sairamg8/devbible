{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_dockerizing_node", "label": "Dockerizing Node", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A good Node image is small, runs as non-root, caches dependencies separately from app code, and does not copy secrets or laptop node_modules."}, {"id": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_multi_stage_build", "label": "Multi-stage Docker build", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deps / build / runner stages. Copy lockfile + package.json before source so code edits do not invalidate the dependency layer."}, {"id": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_dockerignore", "label": ".dockerignore", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it you send host node_modules and .env into the build context \u2014 slow and dangerous."}, {"id": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_non_root_user", "label": "Non-root container user", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "USER after files are copied with correct ownership. Limits blast radius of filesystem and some remote exploits."}, {"id": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_exec_form_cmd", "label": "Exec-form CMD", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CMD [\"node\", \"dist/server.js\"] so Node is PID 1 and receives signals. CMD npm start is a different footgun."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_exec_form_cmd", "target": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_pid1_and_signals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_multi_stage_build", "target": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_dockerignore", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_dockerignore", "target": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_file_local_only", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_exec_form_cmd", "target": "docs_nodejs_pages_phase_11_deployment_04_pid1_and_signals_node_as_pid1", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-11-deployment/03-dockerizing-node.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_non_root_user", "target": "docs_nodejs_pages_phase_11_deployment_03_dockerizing_node_multi_stage_build"