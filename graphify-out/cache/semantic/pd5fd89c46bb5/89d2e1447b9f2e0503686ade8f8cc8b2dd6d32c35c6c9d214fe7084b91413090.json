{"nodes": [{"id": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements_page", "label": "pg_stat_statements", "file_type": "document", "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements", "label": "pg_stat_statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranks by total time so a 4 ms query run 500 times beats an 87 ms query run twice. Requires shared_preload_libraries and a restart."}, {"id": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_total_vs_mean", "label": "total_exec_time vs mean_exec_time", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean flags rare heavyweight queries; total finds the frequent moderate ones that dominate the workload. Measured 9240 ms versus 173 ms."}, {"id": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_literal_normalisation", "label": "Literal normalisation in pg_stat_statements", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constants become $n so three literal variants collapse to one row; no parameter values are stored, which is why the view is safe to expose."}, {"id": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_dealloc", "label": "pg_stat_statements.max and dealloc", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 5000 distinct statements; unbounded IN-list shapes evict useful rows. Growing dealloc means raise max or fix query generation."}], "edges": [{"source": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements_page", "target": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_total_vs_mean", "target": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_literal_normalisation", "target": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_dealloc", "target": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-10-indexes/14-pg-stat-statements.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_10_indexes_14_pg_stat_statements_pg_stat_statements_p