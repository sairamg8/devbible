{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_withfiletypes", "label": "readdir withFileTypes", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dirent already knows type, avoiding one stat per entry and thousands of extra thread-pool ops on large directories."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_order", "label": "readdir order not guaranteed", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filesystem-dependent (ext4 vs overlayfs). Sort explicitly or numbered migrations run in the wrong order."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_opendir", "label": "opendir walk", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async iterator over one entry at a time for huge trees. Constant memory vs readdir({recursive:true}) materialising the whole array."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_rm_recursive", "label": "rm recursive force", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modern rm -rf. Replaces deprecated rmdir({recursive}) (DEP0147). force makes a missing path a no-op for finally cleanup."}, {"id": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_dirent_parentpath", "label": "Dirent.parentPath", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced deprecated Dirent.path. Full path is path.join(entry.parentPath, entry.name)."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_withfiletypes", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_dirent_parentpath", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_opendir", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_withfiletypes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_order", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_readdir_withfiletypes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_directories_rm_recursive", "target": "build_css_p2_docs_nodejs_pages_phase_4_filesystem_fs_promises_fs_promises", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-4-filesystem/directories.html", "source_location": null, "weight": 1.0}], "hyperedges": []}