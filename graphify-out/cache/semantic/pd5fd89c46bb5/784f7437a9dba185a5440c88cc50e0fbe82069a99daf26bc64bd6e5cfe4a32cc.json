{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_page", "label": "06 \u00b7 Derived state", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_derived_state", "label": "Derived state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a value can be calculated from existing props or state, calculate it during rendering. That removes cascading updates and makes out-of-sync state unrepresentable."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_effect_sync_antipattern", "label": "useEffect-that-syncs-state antipattern", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storing a derivable value and syncing it with an effect costs an extra render and commits a stale frame to the DOM before the effect runs."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_selected_id_pattern", "label": "Store selectedId, derive the object", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored selected object goes stale on edit and dangles on delete. find by id reflects edits automatically and yields null when the item is gone."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_usememo_not_state", "label": "useMemo for expensive derivation", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expensive calculations stay derived via useMemo. State plus an effect creates a second source of truth that only usually agrees."}, {"id": "build_css_p2_docs_react_pages_phase_3_state_derived_state_you_might_not_need_an_effect", "label": "You Might Not Need an Effect (react.dev)", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_3_state_derived_state_page", "target": "build_css_p2_docs_react_pages_phase_3_state_derived_state_derived_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_derived_state_page", "target": "build_css_p2_docs_react_pages_phase_3_state_derived_state_you_might_not_need_an_effect", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_derived_state_effect_sync_antipattern", "target": "build_css_p2_docs_react_pages_phase_3_state_derived_state_derived_state", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-3-state/derived-state.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_3_state_derived_state_selected_id_pattern", "target": "build_css_p2_docs_react_pages_phase_3_state_derived_state_derived_state", "relati