{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_conflicts_and_routing", "label": "Conflicts and routing", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_recovery_conflict", "label": "Recovery conflict 40001", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay of primary VACUUM would remove row versions a standby query still needs. Default max_standby_streaming_delay is 30 s then canceling statement due to conflict with recovery. SQLSTATE 40001 is retryable. Some conflicts terminate the session."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_hot_standby_feedback", "label": "hot_standby_feedback", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default off. The standby reports its oldest snapshot so primary VACUUM defers cleanup. Cost is table bloat on the primary \u2014 the same xmin-horizon problem as a long transaction. vacuum_defer_cleanup_age was removed in PG16."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_read_routing", "label": "Read routing hierarchy", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same-request and post-write reads, and any read that feeds a write decision, stay on the primary. Lists, search, feeds and analytics may go to a replica."}, {"id": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_lsn_wait", "label": "Sticky-to-primary and LSN wait", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sticky window longer than typical replay_lag is simple. Capturing pg_current_wal_lsn() and requiring pg_last_wal_replay_lsn() >= that LSN is exact. Not reading from replicas is often correct."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_recovery_conflict", "target": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_hot_standby_feedback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_read_routing", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_read_your_writes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_08_replication_02_conflicts_and_routing_lsn_wait", "target": "docs_postgresql_pages_phase_13_ops_08_replication_01_lag_and_read_your_writes_wal_lsn_stages", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/08-replication/02-conflicts-and-routing.md", "source_location"