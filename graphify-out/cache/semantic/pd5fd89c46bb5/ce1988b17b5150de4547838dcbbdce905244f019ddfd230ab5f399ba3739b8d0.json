{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_page", "label": "Index-only scans, INCLUDE and the visibility map", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_index_only_scan", "label": "Index-only scan", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers from the index without touching the heap when every selected column is in the index and the visibility map marks pages all-visible."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_visibility_map", "label": "Visibility map", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VACUUM sets all-visible bits (relallvisible). A freshly loaded table has relallvisible=0 so a covering index still heap-scans."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_include_columns", "label": "INCLUDE columns", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payload stored in index leaves but not part of the sort key: returnable, not searchable or sortable. Required when UNIQUE must stay on the key alone."}, {"id": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_heap_fetches", "label": "Heap Fetches", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Count of rows that still needed a heap visit during an index-only scan. One UPDATE took Heap Fetches from 0 to 58."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_index_only_scan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_visibility_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_include_columns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_page", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_heap_fetches", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-10-indexes/index-only.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_index_only_scan", "target": "build_css_p2_docs_postgresql_pages_phase_10_indexes_index_only_visibility_map", "relation": "sha