{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_two_step_scope_entry", "label": "Two-step scope entry", "file_type": "rationale", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is relocated. Scope entry first creates a binding for every declaration, then code runs. What differs is whether the slot is initialised."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_value_hoisting", "label": "Value hoisting", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functions (and function*, async function) are usable before their line because the slot holds the finished function."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_declaration_hoisting", "label": "Declaration hoisting", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "var is referenceable before its line without ReferenceError, but the value is always undefined until assignment."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_behavioral_hoisting", "label": "Behavioral hoisting", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "let/const/class create a dead zone above their line: the binding exists but is uninitialised."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_side_effect_hoisting", "label": "Side-effect hoisting", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "import bindings are available early and the imported module's side effects run before the rest of the file."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_hoistabledeclaration", "label": "HoistableDeclaration", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec term is not 'hoisting'. HoistableDeclaration covers function declarations only."}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_environment_record", "label": "Environment record", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_three_binding_errors", "label": "Three binding error types", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'x is not defined' means no binding; 'x is not a function' means the binding holds a non-callable; 'Cannot access before initialization' means uninitialised TDZ."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_two_step_scope_entry", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_value_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_two_step_scope_entry", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_declaration_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_two_step_scope_entry", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_behavioral_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-3-functions/hoisting-and-tdz/the-two-step-scope-entry.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_two_step_scope_entry", "target": "build_css_p2_docs_javascript_pages_phase_3_functions_hoisting_and_tdz_the_two_step_scope_entry_side_effect_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_sco