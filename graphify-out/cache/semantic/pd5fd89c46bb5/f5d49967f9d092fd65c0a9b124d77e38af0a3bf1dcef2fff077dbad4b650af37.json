{"nodes": [{"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_encodings", "label": "Buffer encodings", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An encoding is the rule for turning bytes into text and back. Wrong choice yields mojibake, silent truncation, or a size limit off by 33% \u2014 nothing throws."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_utf8", "label": "utf8 encoding", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default and lossless for all text. 1\u20134 bytes per character. There is no case where ascii beats utf8."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_vs_base64url", "label": "base64 vs base64url", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "base64url swaps +/ for -_ and drops = padding for JWTs and URL-safe tokens. Node accepts both alphabets; other languages do not."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_latin1_vs_ascii", "label": "latin1 vs ascii", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "latin1 maps every byte 0\u2013255 to the same code point and round-trips bytes. ascii masks the high bit and silently destroys bytes above 127."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_invalid_utf8_replacement", "label": "Invalid UTF-8 becomes U+FFFD", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer.toString('utf8') substitutes the replacement character and does not throw, so corruption travels into storage."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_textdecoder_fatal", "label": "TextDecoder fatal true", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only built-in way to make bad bytes loud: throws TypeError on malformed UTF-8. Use at trust boundaries."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_not_validation", "label": "Base64 decode is not validation", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node's decoder ignores characters outside the alphabet and tolerates missing padding, so garbage still decodes."}, {"id": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_size_cost", "label": "Base64 +33% size cost", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3 bytes become 4 ASCII chars. Acceptable for tokens and data URIs; wrong for file payloads \u2014 use multipart or raw binary."}], "edges": [{"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_utf8", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_encodings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_vs_base64url", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_encodings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_latin1_vs_ascii", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_encodings", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_invalid_utf8_replacement", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_utf8", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_textdecoder_fatal", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_invalid_utf8_replacement", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_not_validation", "target": "docs_nodejs_pages_phase_3_buffers_streams_02_encodings_base64_vs_base64url", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-3-buffers-streams/02-encodings.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_3_buffers_streams