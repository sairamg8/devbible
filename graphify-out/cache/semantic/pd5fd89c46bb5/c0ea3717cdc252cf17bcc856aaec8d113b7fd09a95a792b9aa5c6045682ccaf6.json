{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_write_ahead_log", "label": "Write-ahead log", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/wal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every committed change is recorded in WAL before it is treated as durable. COMMIT succeeds only after the needed WAL is flushed."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_double_write", "label": "WAL then heap double write", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/wal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once to WAL immediately for durability; later to heap/index via dirty shared buffers, checkpoints, and the background writer."}, {"id": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_wal_level_replica", "label": "wal_level replica", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/wal.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Usual default on PostgreSQL 18.4; supports physical replication. Never delete WAL files by hand."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_write_ahead_log", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_double_write", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-0-architecture/wal.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_0_architecture_wal_double_write", "target": "build_css_p2_docs_postgresql_pages_phase_0_architecture_shared_buffers_shared_buffers", "relation": "s