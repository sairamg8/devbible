{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_page", "label": "Load testing", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08 on Node 24.19.0. Testing-phase view of what a load test is for and how it lies. Methodology lives in Phase 10 page 20."}, {"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_autocannon", "label": "autocannon", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick single-URL answer: connections, duration, warmup. Scriptable enough to assert p99 and non2xx. Run against a production-like build."}, {"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_k6", "label": "k6", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the shape of load matters: ramps, user journeys, think time. thresholds make it exit non-zero so CI can gate. Failures cluster at transitions."}, {"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_four_lies", "label": "Four ways a load test lies", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No warmup (JIT/cold caches), generator is the bottleneck, one hot cached row, and reporting the average. A 45 ms mean can hide a 4-second p99."}, {"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_p99", "label": "Report p99 not the average", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With 100 requests per page load, most sessions hit the tail. Report p50, p95, p99 and max. Also check event-loop lag and memory after the run."}, {"id": "docs_nodejs_pages_phase_9_testing_18_load_testing_stress_soak_spike", "label": "Stress, soak, and spike tests", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stress increases until break. Soak is moderate load for hours (leaks, pool exhaustion). Spike is instant 10\u00d7 for autoscaling and cold starts. Nightly against staging, not in the PR pipeline."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_18_load_testing_four_lies", "target": "docs_nodejs_pages_phase_9_testing_18_load_testing_p99", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_18_load_testing_autocannon", "target": "docs_nodejs_pages_phase_9_testing_18_load_testing_k6", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_18_load_testing_stress_soak_spike", "target": "docs_nodejs_pages_phase_9_testing_18_load_testing_k6", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_18_load_testing_page", "target": "docs_nodejs_pages_phase_9_testing_19_contract_testing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_18_load_testing_page", "target": "docs_nodejs_syllabus_04_production_phase_10_observability", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/nodejs/pages/phase-9-testing/18-load-testing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}