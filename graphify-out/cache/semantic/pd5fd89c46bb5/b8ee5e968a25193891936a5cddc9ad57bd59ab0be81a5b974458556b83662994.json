{"nodes": [{"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_first_registered_first", "label": "First registered middleware runs first", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express does not sort middleware by specificity. Registration order on app is absolute."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_app_router_route", "label": "App then router then route middleware", "file_type": "concept", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Application middleware runs before router middleware for that mount. Route-level middleware runs only for that route."}, {"id": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_scope_not_global", "label": "Scope middleware off hot paths", "file_type": "rationale", "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global middleware is easy and expensive \u2014 it runs for health checks and static. Scope auth and loggers to routers that need them."}], "edges": [{"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_first_registered_first", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_app_router_route", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_scope_not_global", "target": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_app_router_route", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_expressjs_pages_phase_2_middleware_execution_order_scope_not_global", "target": "build_css_p2_docs_expressjs_pages_phase_10_app_factory_health_and_boot_liveness_vs_readiness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/expressjs/pages/phase-2-middleware/execution-order.html", "source_location": null, "weight": 1.0}], "hyperedges": []}