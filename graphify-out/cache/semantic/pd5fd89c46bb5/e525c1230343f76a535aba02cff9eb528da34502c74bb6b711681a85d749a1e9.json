{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "label": "node:crypto", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About six calls from 52 hashes and 134 ciphers. Verified Node 24.19.0 / OpenSSL 3.5.7 via sandbox/p8-security/ex19-crypto.mjs."}, {"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_node_crypto", "label": "node:crypto primitives", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "crypto.hash for one-shot, createHash for streams. MD5 is slower than SHA-256 on this CPU (5.11 vs 3.68 \u00b5s). SHA-256 is not password storage."}, {"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_hmac_length_extension", "label": "HMAC vs length-extension", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sha256(secret+msg) is length-extendable. HMAC closes it at 6.87 vs 3.68 \u00b5s. Compare tags with timingSafeEqual. HMAC proves key-holder, not which party."}, {"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_csprng", "label": "CSPRNG APIs", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Math.random is not for secrets. randomUUID 0.45 \u00b5s (122 bits); randomBytes(32) base64url for tokens. Async randomBytes for kilobyte-scale output."}, {"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_modulo_bias", "label": "Modulo bias", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "byte % 100 is 40.7% bucket spread; crypto.randomInt(100) is 2.9%. Use randomInt for ranges, shuffles, numeric OTPs."}, {"id": "docs_nodejs_pages_phase_8_security_20_node_crypto_keyobject", "label": "KeyObject vs Buffer key", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A raw Buffer is converted every call. createSecretKey once at startup: HMAC 9.41 vs 35.91 \u00b5s; GCM 13.07 vs 38.48 \u00b5s."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_node_crypto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_hmac_length_extension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_csprng", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/20-node-crypto.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_20_node_crypto_page", "target": "docs_nodejs_pages_phase_8_security_20_node_crypto_modulo_bias", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodej