{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_startup_snapshot", "label": "Startup snapshot", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/startup-snapshots.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Freezes a V8 heap after bootstrap so the next launch skips re-parsing and re-running init."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_tied_to_v8_build", "label": "Snapshot tied to Node/V8 build", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/startup-snapshots.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots are invalid after a Node patch; rebuild in CI per runtime artifact."}, {"id": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_vs_compile_cache", "label": "Snapshot versus compile cache versus SEA", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/startup-snapshots.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "enableCompileCache stores compilation artifacts; a snapshot stores initialised heap; SEA packages a single binary. Compile cache is the practical first win."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_vs_compile_cache", "target": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_startup_snapshot", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-12-native/startup-snapshots.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_12_native_startup_snapshots_tied_to_v8_build", "target": "build_css_p2_docs_nodejs_pages_phase_12_nativ