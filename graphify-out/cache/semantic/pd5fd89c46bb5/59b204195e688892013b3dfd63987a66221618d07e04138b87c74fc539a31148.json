{"nodes": [{"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_the_procedure", "label": "The lifting procedure", "file_type": "document", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_three_steps", "label": "Remove, hardcode, then add state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoding first separates data-flow bugs from state-update bugs."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_closest_common_parent", "label": "Closest common parent owns the state", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Count components that render based on the value, not pass-throughs. Invent a component solely to own state if needed."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_single_source", "label": "Single source of truth", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One owner per piece, not all state in one store. The same information in two places is the forbidden case."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_inverse_data_flow", "label": "Inverse data flow", "file_type": "concept", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data down as props, changes up as function calls. The child does not know what the parent does with the event."}, {"id": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_handlers_not_setters", "label": "Pass handlers not setters", "file_type": "rationale", "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A setter leaks the owner's shape. A named event callback survives array-to-Map or local-to-server."}], "edges": [{"source": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_three_steps", "target": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_closest_common_parent", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_single_source", "target": "build_css_p2_docs_react_pages_phase_2_components_controlled_vs_uncontrolled_the_switch_warning_no_effect_sync", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/react/pages/phase-2-components/lifting-state-up/the-procedure.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_handlers_not_setters", "target": "build_css_p2_docs_react_pages_phase_2_components_lifting_state_up_the_procedure_inverse_