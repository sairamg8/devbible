{"nodes": [{"id": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_page", "label": "Exhaustiveness with never", "file_type": "document", "source_file": "docs/typescript/pages/phase-2-narrowing/06-exhaustiveness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_never", "label": "Exhaustiveness with never", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/06-exhaustiveness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handle every variant and the residual type becomes never. Miss one and the error names it. Turns adding a status from a bug hunt into a compile error at every site that must change."}, {"id": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_assertnever", "label": "assertNever", "file_type": "concept", "source_file": "docs/typescript/pages/phase-2-narrowing/06-exhaustiveness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A helper whose parameter is never: compile-time error when a variant is added, and a runtime throw if unvalidated data carries an impossible variant. Types are erased; the throw is the only runtime protection."}, {"id": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_default_fallback", "label": "Default fallback swallows variants", "file_type": "rationale", "source_file": "docs/typescript/pages/phase-2-narrowing/06-exhaustiveness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A default that returns a fallback compiles forever no matter how many variants you add. Either assertNever in default, or no default with an explicit return type."}, {"id": "docs_typescript_pages_phase_2_narrowing_06_exhaustiveness_record_map", "label": "Record 