{"nodes": [{"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_dag", "label": "Commit graph is a DAG", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parents point backwards. Directed because pointers go one way; acyclic because a commit hash includes its parents; a graph because merges have multiple parents."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_dates_are_metadata", "label": "Dates are metadata, not structure", "file_type": "rationale", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A commit dated 2030 can sit beneath one dated 2026. Never build logic on commit dates; use merge-base --is-ancestor."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_reachability", "label": "Reachability", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rev-list is the engine under log, fetch negotiation, and gc. main..mybranch means reachable from mybranch, not from main."}, {"id": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_merge_second_parent", "label": "Merge commit second parent", "file_type": "concept", "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second parent is the branch merged in; first parent is the branch you were on. --first-parent reads the trunk."}], "edges": [{"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_dates_are_metadata", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_dag", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_reachability", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_dag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_commit_graph_merge_second_parent", "target": "build_css_p2_docs_git_pages_phase_0_how_git_stores_things_object_types_commit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/git/pages/phase-0-how-git-stores-things/commit-graph.html", "source_location": null, "weight": 1.0}], "hyperedges": []}