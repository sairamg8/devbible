{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_within_group", "label": "WITHIN GROUP", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supplies the ordering an ordered-set aggregate is defined over. Syntax tell of the family. percentile_cont(0.5, amount) is a syntax error; the column goes in WITHIN GROUP."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_cont", "label": "percentile_cont", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interpolates; can return a value not in the input (2.5 from 1,2,3,4). Numeric and interval only. Standard choice for p95/p99 latency. Ignores NULLs. two-arg round needs ::numeric."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_disc", "label": "percentile_disc", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns an actual value from the set. Works on anything sortable. percentile_disc(1.0) is max(); percentile_disc(0.0) is min()."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_array_form", "label": "percentile_cont array form", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "percentile_cont(ARRAY[0.5, 0.9, 0.99]) sorts once and returns an array. Separate calls would sort three times. Dashboard form."}, {"id": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_do_not_compose", "label": "Percentiles do not compose", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "You cannot average hourly p95s to get a daily p95. Store enough per bucket to recompute, or use a mergeable sketch (t-digest). Measured 178.32 ms vs 57.41 ms for avg() on 500k rows."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_cont", "target": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_within_group", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_disc", "target": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_within_group", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_cont", "target": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_percentile_disc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/13-ordered-set/01-percentiles.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_13_ordered_set_01_percentiles_array_form", "target": "