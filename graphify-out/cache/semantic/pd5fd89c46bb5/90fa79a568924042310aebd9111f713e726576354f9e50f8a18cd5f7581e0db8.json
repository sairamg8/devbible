{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_operators", "label": "Attribute selector operators", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven operators: presence, = exact, ~= space-list, |= hyphen prefix (lang), ^= starts, $= ends, *= contains. Specificity 0,1,0. Values case-sensitive unless i flag."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_tilde_vs_star", "label": "[class~=] vs [class*=]", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~= matches a whole space-separated token (like .a). *= is a substring over the whole string and also matches alpha/banana. *= on class is almost always wrong."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_aria_styling", "label": "Style on aria-* attributes", "file_type": "rationale", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual state and accessibility state cannot drift if they are the same attribute. A parallel .is-open class can be forgotten."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_operators", "target": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_tilde_vs_star", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_aria_styling", "target": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_operators", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_attribute_selectors_operators", "target": "build_css_p2_docs_css_pages_phase_1_selectors_not_empty_root_lang_dir", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/attribute-selectors.html", "source_location": null, "weight": 1.0}], "hyperedges": []}