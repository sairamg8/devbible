{"nodes": [{"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_three_pass_ordering", "label": "Three-pass async ordering method", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass 1 walk the synchronous path to each first await. Pass 2 drain microtasks (re-queue at each await). Pass 3 run one task and repeat."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_await_does_not_block_thread", "label": "await does not block the thread", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await suspends the function, not the thread. A hot loop after an await still freezes everything \u2014 run-to-completion applies to continuations."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_await_in_loop_sequential", "label": "await in a for loop is sequential", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each iteration waits for the previous. Correct when steps depend on each other; a waterfall when independent."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_foreach_async_trap", "label": "await inside forEach is ignored", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forEach discards the callback return, so promises are never awaited and rejections float. Use for...of or Promise.all(map)."}, {"id": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_two_async_interleave", "label": "Two async functions interleave", "file_type": "concept", "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both run synchronously to their first await, then resume in queue order. Concurrency without parallelism."}], "edges": [{"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_three_pass_ordering", "target": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_where_it_suspends_await_suspends_at_await", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_three_pass_ordering", "target": "build_css_p2_docs_javascript_pages_phase_7_async_microtasks_vs_macrotasks_the_drain_order_microtask_drain_until_empty", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ordering.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_javascript_pages_phase_7_async_async_await_reading_the_ordering_await_does_not_block_thread", "target": "build_css_p2_docs_javascript_pages_phase_7_async_sync_vs_async_run_to_completion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/javascript/pages/phase-7-async/async-await/reading-the-ord