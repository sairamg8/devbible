{"nodes": [{"id": "docs_nodejs_pages_phase_8_security_24_permission_model_page", "label": "The Permission Model", "file_type": "document", "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process sandbox from the CLI. Blast-radius reduction against chosen dependencies, not a sandbox for untrusted code."}, {"id": "docs_nodejs_pages_phase_8_security_24_permission_model_permission_model", "label": "Node Permission Model", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--permission denies all; grant fs-read/write, child-process, worker, addons, wasi, inspector. No runtime re-grant API. Policy lives only on the command line."}, {"id": "docs_nodejs_pages_phase_8_security_24_permission_model_no_network_permission", "label": "No --allow-net on Node 24", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--allow-net is a bad option. A process with only --allow-fs-read still opened TCP. process.permission.has('net') is false for any unrecognised scope. Cannot contain SSRF."}, {"id": "docs_nodejs_pages_phase_8_security_24_permission_model_allow_child_process", "label": "--allow-child-process escape", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The child is a new process with no permission model. Granting it discards every other restriction. Same for --allow-addons / process.dlopen."}], "edges": [{"source": "docs_nodejs_pages_phase_8_security_24_permission_model_page", "target": "docs_nodejs_pages_phase_8_security_24_permission_model_permission_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_24_permission_model_page", "target": "docs_nodejs_pages_phase_8_security_24_permission_model_no_network_permission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_24_permission_model_page", "target": "docs_nodejs_pages_phase_8_security_24_permission_model_allow_child_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_24_permission_model_no_network_permission", "target": "docs_nodejs_pages_phase_8_security_24_permission_model_permission_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_24_permission_model_allow_child_process", "target": "docs_nodejs_pages_phase_8_security_24_permission_model_permission_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-8-security/24-permission-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_8_security_24_permission_model_page", "target": "docs_nodejs_pages_phase_8_security_23_supply_chain_page", "relation": "references", "confidence": "EXTRACTED", "confi