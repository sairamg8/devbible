{"nodes": [{"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_three_ways", "label": "Three ways to run TypeScript", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tsc checks then emits; esbuild/swc/Vite/Babel strip and emit without checking; Node 24 strips and executes. Only tsc reads types."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_transpiler_blind", "label": "Transpiler is fast because it is blind", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "esbuild deleted a Cart annotation, assigned a string to total, exited 0; runtime TypeError. Speed is skipping the type graph, not doing it better."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_node_direct", "label": "Node 24 type stripping", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node file.ts strips annotations and runs JS with no flag, no tsconfig, no check. Same lying.ts prints HEAVY and exits 0."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_pair_runner_and_checker", "label": "Pair a fast runner with tsc --noEmit", "file_type": "rationale", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whatever runs the code, tsc --noEmit runs beside it. The build step became optional; the check never did."}, {"id": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_libraries_need_tsc", "label": "Published libraries always need tsc", "file_type": "concept", "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node refuses to strip types inside node_modules (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING). Libraries ship .js plus .d.ts from tsc."}], "edges": [{"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_three_ways", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_static_checker_not_runtime_checker_not_runtime", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_transpiler_blind", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_three_ways", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_pair_runner_and_checker", "target": "build_css_p2_docs_typescript_pages_phase_0_how_typescript_runs_three_ways_to_run_three_ways", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/typescript/pages/phase-0-how-typescript-runs/three-ways-to-run.html", "source_location": null, "wei