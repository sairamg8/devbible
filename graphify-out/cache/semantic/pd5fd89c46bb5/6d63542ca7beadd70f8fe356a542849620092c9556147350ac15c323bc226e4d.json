{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_semver", "label": "Semantic versioning", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MAJOR.MINOR.PATCH records the maintainer's intent, not a guarantee. A patch that fixes a bug your code depended on is still a break for you."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_caret_vs_tilde", "label": "Caret vs tilde ranges", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "^1.2.3 allows <2.0.0; ~1.2.3 allows <1.3.0. For 0.x, ^ tightens to patch-level because the minor slot carries breaking changes."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_lockfile", "label": "package-lock.json", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records exact version, resolved URL and integrity hash for every package. package.json ranges do not describe what you are running."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_integrity_hash", "label": "Lockfile integrity hash", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes the install verifiable, not just reproducible. A tampered tarball fails even if the version number matches."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_npm_ci", "label": "npm ci", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs the lockfile exactly, never writes it, deletes node_modules first, and fails if package.json and the lockfile disagree. Use in CI, Docker, production."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_commit_lockfile", "label": "Commit the lockfile", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always, including for libraries. It governs your CI; consumers' own lockfiles govern them. There is no downside and a real supply-chain upside."}, {"id": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_overrides", "label": "package.json overrides", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces a nested dependency version when the parent has not updated. You override the parent's declared compatibility."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_caret_vs_tilde", "target": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_semver", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_lockfile", "target": "docs_nodejs_pages_phase_1_modules_09_semver_and_lockfiles_semver", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/09-semver-and-lockfiles.md", 