{"nodes": [{"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_page", "label": "Multipart uploads", "file_type": "document", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_no_builtin", "label": "No built-in multipart parser", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in list is json, urlencoded, raw, text, static, Router. multipart/form-data is not JSON."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_multer", "label": "Multer 2.x", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multer latest 2.2.0 as of 2026-08-14. Pin multer@2 for Express 5. Parse multipart, enforce counts/sizes, memory vs disk."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_never_global", "label": "Never global multer", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multer README: never add multer as a global middleware since a malicious user could upload files to a route you did not anticipate."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_filesize_infinity", "label": "Multer fileSize defaults to Infinity", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An uncapped upload is the default. Memory storage plus large or many files can OOM."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_untrusted_metadata", "label": "Untrusted upload originalname and mimetype", "file_type": "rationale", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multer README has no explicit warning; this bible's advice. Clients lie. Generate your own object keys. Prefer file-signature checks."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_object_storage", "label": "Object storage for uploads", "file_type": "concept", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large files belong in S3-compatible object storage, not the API container writable layer. Cleanup temp paths on failure."}, {"id": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_multer_readme", "label": "Multer README", "file_type": "document", "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_page", "target": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_no_builtin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/expressjs/pages/phase-3-requests/07-multipart-uploads.md", "source_location": null, "weight": 1.0}, {"source": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_page", "target": "docs_expressjs_pages_phase_3_requests_07_multipart_uploads_multer", "relation": "references", "confidence": "EXTRACTED", "confi