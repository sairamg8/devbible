{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "label": "Writing a minimal migration runner", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A correct runner is about sixty lines. Write it to learn the mechanism; switch when you need CONCURRENTLY, baselining, dry-run, or JS data migrations."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_migrate", "label": "migrate()", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates schema_migrations, checks out one client, BEGIN, pg_advisory_xact_lock, lexical .sql sort, sha256 checksum, apply+INSERT, COMMIT."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_same_client", "label": "One client for lock and apply", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BEGIN, advisory lock and every migration must share one session. pool.query would split them across connections."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_lock_before_read", "label": "Lock before reading tracking table", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_advisory_xact_lock immediately after BEGIN, before SELECT from schema_migrations. Locking after the read leaves a window both runners see empty."}, {"id": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_batch_vs_per_file", "label": "Batch vs per-file transaction", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch is all-or-nothing and simpler. Per-file resumes after failure, releases locks between files, and is the only way a CONCURRENTLY file can opt out. Tools default to per-file."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_migrations_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_startup_races_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "target": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_ddl_from_node_issuing_ddl_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-8-schema-from-node/minimal-runner.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_8_schema_from_node_minimal_runner_page", "target": "build_css_p2_d