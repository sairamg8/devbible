{"nodes": [{"id": "docs_nodejs_pages_phase_10_observability_21_gc_basics_gc_basics", "label": "GC basics", "file_type": "document", "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V8 frees memory you can no longer reach. You control heap size, allocation rate, and whether GC pauses show up as event-loop lag."}, {"id": "docs_nodejs_pages_phase_10_observability_21_gc_basics_generational_gc", "label": "Generational GC", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New objects start young and cheap to collect (scavenges). Survivors age into old space with more expensive major GC."}, {"id": "docs_nodejs_pages_phase_10_observability_21_gc_basics_max_old_space_size", "label": "--max-old-space-size", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roughly the old-space heap budget. Hitting it yields heap OOM; it is not a cgroup RSS limit. Too high on a small container lets the kernel OOMKiller fire first."}, {"id": "docs_nodejs_pages_phase_10_observability_21_gc_basics_heap_size_limit_vs_flag", "label": "heap_size_limit vs flag value", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default limit ~4288 MB; --max-old-space-size=256 produced ~448 MB. The limit includes more than old space."}, {"id": "docs_nodejs_pages_phase_10_observability_21_gc_basics_cgroup_oom_vs_v8", "label": "cgroup OOM vs V8 heap OOM", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kernel kills on container RSS including off-heap. Align the flag and container limits; watch RSS."}], "edges": [{"source": "docs_nodejs_pages_phase_10_observability_21_gc_basics_generational_gc", "target": "docs_nodejs_pages_phase_10_observability_09_event_loop_lag_event_loop_lag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_21_gc_basics_max_old_space_size", "target": "docs_nodejs_pages_phase_10_observability_21_gc_basics_heap_size_limit_vs_flag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_21_gc_basics_max_old_space_size", "target": "docs_nodejs_pages_phase_10_observability_21_gc_basics_cgroup_oom_vs_v8", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_21_gc_basics_gc_basics", "target": "docs_nodejs_pages_phase_10_observability_12_perf_hooks_performance_observer_gc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-10-observability/21-gc-basics.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_10_observability_21_gc_basics_gc_basics", "target": "docs_nodejs_pages_phase_10_observability_17_memory_leaks_memory_leaks", "relation": "references", "confidence": "EXTRAC