{"nodes": [{"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_readme_modelling_money", "label": "Modelling money", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An amount is not a number and arithmetic on it is not ordinary arithmetic. The bugs are the ones that make accounts fail to balance."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_readme_five_money_rules", "label": "Five money modelling rules", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric plus currency; round once; allocate remainders; store the FX rate used; keep it a string in JavaScript. Never double precision (1000\u00d70.01 = 9.999999999999831) or the locale-dependent money type."}, {"id": "docs_postgresql_pages_phase_2_types_17_modelling_money_readme_numeric_rounding_away_from_zero", "label": "numeric rounds 2.5 away from zero", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "numeric 2.5 \u2192 3 (away from zero); double precision 2.5 \u2192 2 (to even). A second independent reason money is never float."}], "edges": [{"source": "docs_postgresql_pages_phase_2_types_17_modelling_money_readme_five_money_rules", "target": "docs_postgresql_pages_phase_2_types_17_modelling_money_readme_modelling_money", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-2-types/17-modelling-money/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_2