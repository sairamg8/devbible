{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_microtasks_vs_macrotasks", "label": "Microtasks versus macrotasks", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Microtasks (then/await/queueMicrotask) drain completely between phases. Macrotasks (timers, setImmediate, I/O) belong to a phase."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_process_nexttick", "label": "process.nextTick", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node-only queue drained at a checkpoint before microtasks. Drains to exhaustion including newly queued ticks \u2014 starvation risk."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_queue_microtask", "label": "queueMicrotask", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web-standard microtask. Prefer over nextTick except when you must run before pending promise continuations."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_nexttick_esm_exception", "label": "nextTick after promises at ESM top level", "file_type": "rationale", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The nextTick-before-promises rule fails at ESM top level because module evaluation is itself a microtask. Inside a timer callback the familiar order returns."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_nexttick_esm_exception", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_process_nexttick", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_process_nexttick", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_microtasks_vs_macrotasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_queue_microtask", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_microtasks_vs_macrotasks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_process_nexttick", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_queue_microtask", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/microtasks-and-macrotasks.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_nodejs_pages_phase_2_async_microtasks_and_macrotasks_microtasks_vs_macrotasks", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_event_loop_phases_event_loop_phases", "relation"