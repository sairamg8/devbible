{"nodes": [{"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_page", "label": "Testcontainers \u2014 real database integration tests", "file_type": "document", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-08: testcontainers 12.1.0, pg 8.23.0, postgres:18-alpine, rootless podman 5.8.4."}, {"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_postgresqlcontainer", "label": "PostgreSqlContainer", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts a real database from inside the test process. getConnectionUri() uses a random host port so parallel files and CI jobs never collide."}, {"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_real_sqlstate", "label": "Real SQLSTATE from a real engine", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 23505 orders_sku_key and 23514 orders_qty_check. A mocked pool can only return whatever you already believed."}, {"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_start_cost", "label": "Container start cost", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5585 ms and 6355 ms on a warm postgres:18-alpine image; queries 15\u201320 ms after. Start once per file in before, not per test. Separate script from the unit suite."}, {"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_podman", "label": "Testcontainers under rootless podman", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DOCKER_HOST=unix:///run/user/1000/podman/podman.sock and TESTCONTAINERS_RYUK_DISABLED=true. Missing first: no working container runtime. Missing second: Ryuk wait '/.*Started.*/' never received."}, {"id": "docs_nodejs_pages_phase_9_testing_13_testcontainers_wait_strategy", "label": "GenericContainer wait strategy", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mapped port exists before the process is listening. Without Wait.forLogMessage or Wait.forListeningPorts you get intermittent ECONNREFUSED."}], "edges": [{"source": "docs_nodejs_pages_phase_9_testing_13_testcontainers_postgresqlcontainer", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_real_sqlstate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_13_testcontainers_start_cost", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_postgresqlcontainer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_9_testing_13_testcontainers_podman", "target": "docs_nodejs_pages_phase_9_testing_13_testcontainers_postgresqlcontainer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-9-testing/13-testcontainers.md", "source_location": null, "weight": 1.0}, {"source": "do