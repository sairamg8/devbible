{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_why_connections_cost", "label": "Why a connection costs something", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_process_per_connection", "label": "Process-per-connection", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres forks a backend per connection with its own caches, prepared statements and snapshot. Isolation is the gain; memory and fork cost are why max_connections=500 is almost never the answer."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_max_connections", "label": "max_connections", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 100, postmaster context, restart-only. Sizes shared memory whether slots are used. superuser_reserved_connections=3 is the last-resort admin reserve. Failure is FATAL: sorry, too many clients already."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_replicas_times_pool_max", "label": "replicas \u00d7 pool max", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg.Pool max is per process. Ten replicas \u00d7 10 is the whole default max_connections before workers and admin sessions. A rolling deploy doubles it."}, {"id": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_pg_pool_vs_pgbouncer", "label": "pg.Pool vs PgBouncer", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg.Pool bounds one Node process. PgBouncer bounds total backends across every client. They are complementary, not alternatives."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_process_per_connection", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_max_connections", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_replicas_times_pool_max", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_pg_pool_vs_pgbouncer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_pg_pool_vs_pgbouncer", "target": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_02_pool_modes_transaction_pooling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/07-pgbouncer/01-why-connections-cost.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_07_pgbouncer_01_why_connections_cost_why_connections_cost", "target": "docs_postg