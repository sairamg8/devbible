{"nodes": [{"id": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_circular_dependencies", "label": "Circular dependencies", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A requires B, B requires A. Neither module system hangs. Neither outcome is one you want to design around."}, {"id": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_cjs_partial_exports", "label": "CommonJS partial exports object", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When B requires A while A is still executing, the cache holds whatever A has assigned so far. Behaviour depends on statement order."}, {"id": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_esm_tdz_cycle", "label": "ESM cycle temporal dead zone", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESM links bindings before evaluating. Reading a const export during the cycle throws ReferenceError. A crash at startup beats a silent undefined."}, {"id": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_function_hoist_survives", "label": "Function declarations survive cycles", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function declarations are hoisted at link time. A cycle can sit for years and break the day someone converts a function to a const arrow."}, {"id": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_extract_shared_module", "label": "Extract the shared piece", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two modules that each need the other are usually one concept that got split. Extract, invert the dependency, or only then defer with await import()."}], "edges": [{"source": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_cjs_partial_exports", "target": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_circular_dependencies", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_esm_tdz_cycle", "target": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_circular_dependencies", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_function_hoist_survives", "target": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_esm_tdz_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_extract_shared_module", "target": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_circular_dependencies", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_1_modules_06_circular_dependencies_cjs_partial_exports", "target": "docs_nodejs_pages_phase_1_modules_02_commonjs_require_cache", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/nodejs/pages/phase-1-modules/06-circular-dependencies.md", "source_location": null, "weight": 1.0}], "hyperedges": []}