{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_three_valued_logic", "label": "SQL three-valued logic", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULL is absence; comparisons yield unknown. WHERE keeps only true, so col = NULL matches nothing. Use IS NULL or IS NOT DISTINCT FROM."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_in_null_trap", "label": "NOT IN with NULL drops all rows", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2 NOT IN (1, NULL) expands to true AND unknown \u2192 NULL, so the row is dropped. Prefer NOT EXISTS."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_exists", "label": "NOT EXISTS anti-join", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles NULL correctly and usually plans as an anti-join rather than a hashed subplan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_is_distinct_from", "label": "IS DISTINCT FROM", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Null-safe comparison; WHERE v IS DISTINCT FROM 30 includes NULLs that v <> 30 drops."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_aggregates_ignore_null", "label": "Aggregates ignore NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "count(*) counts rows; count(col) counts non-nulls. sum() over all-NULL is NULL not 0 \u2014 wrap with coalesce(sum(v), 0)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_unique_allows_many_nulls", "label": "UNIQUE allows many NULLs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULLs are not equal so they do not conflict; three NULLs accepted. PostgreSQL 15+ UNIQUE NULLS NOT DISTINCT allows at most one."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_nulls_not_distinct", "label": "UNIQUE NULLS NOT DISTINCT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15+ option that treats NULLs as equal for uniqueness, raising 23505 on a second NULL."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_null_sort_order", "label": "NULL sort order", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NULLs sort last ASC and first DESC. Reversing a sort changes LIMIT results; override with NULLS FIRST/LAST and match the index."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_null_vs_empty_string", "label": "NULL is not the empty string", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'' IS NULL is false. || with NULL yields NULL; concat() ignores NULLs. Oracle conflates them; PostgreSQL does not."}, {"id": "build_css_p2_docs_postgresql_pages_phase_2_types_null_undefined_becomes_null", "label": "Node undefined becomes SQL NULL", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg converts undefined parameters to NULL, so a missing request key silently nulls a column. Build partial updates from present keys."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_2_types_null_three_valued_logic", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_in_null_trap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_exists", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_in_null_trap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_null_is_distinct_from", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_null_three_valued_logic", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_null_unique_allows_many_nulls", "target": "build_css_p2_docs_postgresql_pages_phase_2_types_null_nulls_not_distinct", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_2_types_null_undefined_becomes_null", "target": "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_explicit_null_bypasses_default", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "pg_three_valued_logic_consequences", "label": "Three-valued logic consequences", "nodes": ["build_css_p2_docs_postgresql_pages_phase_2_types_null_three_valued_logic", "build_css_p2_docs_postgresql_pages_phase_2_types_null_not_in_null_trap", "build_css_p2_docs_postgresql_pages_phase_2_types_null_unique_allows_many_nulls", "build_css_p2_docs_postgresql_pages_phase_3_ddl_constraints_check_allows_null", "build_css_p2_docs_postgresql_pages_phase_2_types_null_aggregates_ignore_null", "build_css_p2_docs_postgresql_pages_phase_2_types_null_is_distinct_from"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-2-types/null.html"}]}