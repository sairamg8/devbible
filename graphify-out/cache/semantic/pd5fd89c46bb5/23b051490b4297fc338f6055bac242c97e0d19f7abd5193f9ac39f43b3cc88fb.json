{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_listen_notify", "label": "LISTEN / NOTIFY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL push to a connected client. Treat as a hint to look, never as a queue: nothing is stored."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_dedicated_client", "label": "LISTEN dedicated Client", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LISTEN is session state. pool.query('LISTEN \u2026') returns the connection with no handler; notifications are lost."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_delivery_on_commit", "label": "NOTIFY delivers on COMMIT", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero delivered while the transaction is open, one after COMMIT, none after ROLLBACK. Notify inside the same transaction as the write."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_dedup_and_payload", "label": "NOTIFY dedup and 8000-byte payload", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical channel/payload pairs in one transaction fold (3 became 1). Payload over 8000 bytes is 22023. Send an id, not the data."}, {"id": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_plus_poll", "label": "NOTIFY plus poll queue table", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The queue table is the truth; NOTIFY only removes latency. FOR UPDATE SKIP LOCKED makes several workers safe. Reconnect and re-LISTEN, then poll once."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_dedicated_client", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_pool_vs_client_listen_needs_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_listen_notify", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_delivery_on_commit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_plus_poll", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_listen_notify", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_listen_notify_dedup_and_payload", "target": "build_css_p2_docs_postgresql_pages_phase_7_pg_driver_query_placeholders_dollar_placeholders", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-css-p2/docs/postgresql/pages/phase-7-pg-driver/listen-notify.html", "source_location": null, "weight": 1.0}], "hyperedges": []}