{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle", "label": "Recursive CTE cycle", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cycle means an iteration never produces no new rows. Measured 107 rows from an 8-row table before d<40 stopped it. A self-referencing FK guarantees the parent exists, not acyclicity. No standard constraint enforces a tree."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_depth_guard", "label": "Recursive depth guard", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WHERE t.d < N in the recursive term. Universal, production-mandatory even on believed trees. Cannot distinguish a deep hierarchy from a loop; truncates both silently. Choose a bound above any legitimate depth."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_union_dedupe", "label": "UNION instead of UNION ALL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discards already-produced rows so a second lap yields nothing and recursion stops. Measured 8 unique rows and termination. Pays comparison cost. Incompatible with depth or path columns \u2014 every lap is a different row. UNION and a path column do not compose."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle_clause", "label": "CYCLE clause", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PG 14+. CYCLE id SET is_cycle USING path. Only option that reports the cycle. Measured root twice, second is_cycle true, then stop. Prefer when cycles may be legitimate. Pair with a depth guard."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_search_clause", "label": "SEARCH clause", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEARCH DEPTH FIRST BY id SET ord (or BREADTH FIRST). Creates a sortable column; you must still ORDER BY ord. Replaces a hand-rolled path used only for sorting."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_error_42p19", "label": "42P19 recursive term restrictions", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursive reference must not appear more than once; aggregates forbidden in the recursive term (would summarise only the previous iteration). Also bars LEFT JOIN against the CTE, ORDER BY and LIMIT inside the term. Aggregate outside."}, {"id": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_missing_recursive_42p01", "label": "Missing RECURSIVE is 42P01", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain WITH cannot self-reference. Error is the ordinary relation does not exist, so it is misdiagnosed as a typo or search_path problem. Keyword attaches to WITH, not the CTE name."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_readme_with_recursive", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_depth_guard", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_union_dedupe", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle_clause", "target": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/15-recursive-cte/02-cycles-and-limits.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_15_recursive_cte_02_cycles_and_limits_search_claus