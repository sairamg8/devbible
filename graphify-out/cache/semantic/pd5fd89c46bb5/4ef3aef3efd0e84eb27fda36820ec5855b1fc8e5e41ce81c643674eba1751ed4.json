{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_when_it_pays", "label": "When FILTER pays", "file_type": "document", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/when-it-pays.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_when_it_pays_same_as_case", "label": "FILTER equals CASE speed", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/when-it-pays.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER is not faster than the equivalent CASE aggregate; both are one scan."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_when_it_pays_vs_n_subqueries", "label": "FILTER vs N subqueries", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/when-it-pays.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One scan with several FILTER aggregates is about 4\u00d7 cheaper than N correlated subqueries."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_when_it_pays_not_scan_filter", "label": "FILTER is not a scan filter", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/filter-clause/when-it-pays.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FILTER does not reduce the scan; WHERE does. FILTER only chooses which already-read rows enter the aggregate."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_filter_clause_when_it_pays", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregatio