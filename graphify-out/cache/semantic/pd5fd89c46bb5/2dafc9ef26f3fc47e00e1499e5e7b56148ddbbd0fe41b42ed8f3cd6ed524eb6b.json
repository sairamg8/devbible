{"nodes": [{"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component", "label": "What makes a function a component", "file_type": "document", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_react_calls_it", "label": "React calls the component not you", "file_type": "rationale", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A helper is a function you call. Ownership of the call is what lets React attach state, effects, position and identity."}, {"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_capital_letter", "label": "Capital letter is a JSX compilation rule", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowercase compiles to a string tag, so React creates an unknown DOM element and the function never runs."}, {"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_element_vs_call", "label": "Element versus direct call", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widget() inlines output into the caller. Hooks join the caller list; a conditional call breaks hook order."}, {"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_props_one_argument", "label": "Props are one argument", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSX builds a fresh object each render so identity comparison on props is always false. React 19 put ref in that same object."}, {"id": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_hooks_call_order", "label": "Hooks matched by call order", "file_type": "concept", "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No name, no key \u2014 just position on the fiber. Conditional hooks shift every subsequent slot."}], "edges": [{"source": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component", "target": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_react_calls_it", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_element_vs_call", "target": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_hooks_call_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/react/pages/phase-2-components/01-function-components/01-what-makes-a-component.md", "source_location": null, "weight": 1.0}, {"source": "docs_react_pages_phase_2_components_01_function_components_01_what_makes_a_component_react_calls_it", "targe