{"nodes": [{"id": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_four_combinators", "label": "Four CSS combinators", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descendant (any depth), child >, next sibling +, subsequent sibling ~. Descendant leaks into nested components; child breaks on extra wrappers."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_owl_selector", "label": "Owl selector * + *", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".flow > * + * applies spacing to every child except the first because + requires a preceding sibling. Vertical rhythm without a :first-child exception."}, {"id": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_right_to_left", "label": "Selectors evaluate right-to-left", "file_type": "concept", "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/combinators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine finds the key (rightmost) selector then walks left. main * is heavier than main > .thing because the candidate set is every element."}], "edges": [{"source": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_four_combinators", "target": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_owl_selector", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/css/pages/phase-1-selectors/combinators.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_css_pages_phase_1_selectors_combinators_four_combinators", "target": "build_css_p2_docs_cs