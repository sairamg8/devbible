{"nodes": [{"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed", "label": "READ COMMITTED and the anomalies it allows", "file_type": "document", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_read_committed", "label": "READ COMMITTED", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fresh snapshot per statement. Allows non-repeatable reads and phantoms; never dirty reads. No 40001, so no retry loop \u2014 silent wrong data instead of errors."}, {"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_non_repeatable_read", "label": "Non-repeatable read", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_phantom_read", "label": "Phantom read", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_dirty_read", "label": "Dirty read never in PostgreSQL", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_11_mvcc_03_read_committed_statement_snapshot", "label": "One statement, one snapshot", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-11-mvcc/03-read-committed.md", "source_lo