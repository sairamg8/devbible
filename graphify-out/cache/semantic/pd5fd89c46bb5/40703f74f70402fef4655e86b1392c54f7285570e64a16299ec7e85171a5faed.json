{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_materialized_view", "label": "Materialized view", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/matviews.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores the query result as a table. Not automatically faster; wins only when the underlying query is genuinely expensive."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_refresh_concurrently", "label": "REFRESH CONCURRENTLY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/matviews.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diffs new vs old so it needs a unique index (else 55000). 1.6\u00d7 slower but does not block readers (2 ms vs 32 ms wait)."}, {"id": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_staleness", "label": "Matview staleness", "file_type": "rationale", "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/matviews.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing refreshes it. Schedule the refresh; a trigger-driven refresh puts a full recompute inside a write transaction."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_refresh_concurrently", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_materialized_view", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/matviews.html", "source_location": null, "weight": 1.0}, {"source": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_staleness", "target": "build_css_p2_docs_postgresql_pages_phase_12_beyond_tables_matviews_materialized_view", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-12-beyond-tables/matviews.html", "source_location": null, "weight": 1.0}], "hyperedges": []}