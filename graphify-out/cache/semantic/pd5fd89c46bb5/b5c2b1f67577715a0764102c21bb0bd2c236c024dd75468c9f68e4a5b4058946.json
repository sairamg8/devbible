{"nodes": [{"id": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_twelve_factor_config", "label": "12-factor config", "file_type": "document", "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config is injected by the environment, parsed once at boot, and refused loudly when required values are missing."}, {"id": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_validation_at_boot", "label": "Env validation at boot", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "required() throws on missing DATABASE_URL. A throw here is a failed deploy, not a half-up process accepting traffic."}, {"id": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_no_default_secrets", "label": "No default secrets", "file_type": "rationale", "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A default DATABASE_URL lets a misconfigured deploy silently talk to localhost or a shared dev DB."}, {"id": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_node_env_not_feature_flag", "label": "NODE_ENV is not a feature flag", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NODE_ENV=production changes dependency behaviour. Do not overload it for customer tier. Use explicit flags."}, {"id": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_file_local_only", "label": ".env local only", "file_type": "concept", "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node 24 --env-file is for local development. Never the only copy of prod secrets. Env values are strings \u2014 parse booleans explicitly."}], "edges": [{"source": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_no_default_secrets", "target": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_validation_at_boot", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_validation_at_boot", "target": "docs_nodejs_pages_phase_11_deployment_02_boot_sequence_boot_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_node_env_not_feature_flag", "target": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_twelve_factor_config", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "weight": 1.0}, {"source": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_env_file_local_only", "target": "docs_nodejs_pages_phase_11_deployment_01_twelve_factor_config_twelve_factor_config", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/nodejs/pages/phase-11-deployment/01-twelve-factor-config.md", "source_location": null, "weight": 1.0}], "hyperedges": []}