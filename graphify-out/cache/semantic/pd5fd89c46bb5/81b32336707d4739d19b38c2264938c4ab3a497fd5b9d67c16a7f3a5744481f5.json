{"nodes": [{"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_group_by", "label": "GROUP BY", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits rows into groups and emits one row per group. Every select-list column must be a grouping key or an aggregate. HashAggregate vs GroupAggregate can flip 59 ms to 118 ms."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_null_skip_rule", "label": "Aggregates skip NULL inputs", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sum/avg/min/max skip NULL rows while count(*) counts them. An all-NULL group returns NULL, not 0. 0 and NULL are deliberately different on cancelled vs unfinished orders."}, {"id": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_agg_fixture", "label": "agg_orders fixture", "file_type": "concept", "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six orders and five customers for topics 01\u201308; ex37 then adds a NULL-FK order and a no-country customer so later topics see 8 orders. Same growing-fixture pattern as phase 5."}], "edges": [{"source": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_group_by", "target": "build_css_p2_docs_postgresql_pages_phase_6_aggregation_group_by_null_skip_rule", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-css-p2/docs/postgresql/pages/phase-6-aggregation/group-by.html", "source_location": null, "weight": 1.0}, {"source"