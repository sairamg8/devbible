{"nodes": [{"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_grouping", "label": "GROUPING()", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 1 if that column was rolled up in this row, 0 if it is a real grouping value. Several columns yield a bit mask, MSB first. 42803 if the argument is not a grouping expression. The only reliable discriminator."}, {"id": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_subtotal_null", "label": "Subtotal NULL versus data NULL", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rolled-up column is NULL; so is a genuine missing value. Measured two country:null rows, n=1 is_subtotal=0 versus n=7 is_subtotal=1. Invisible until a NULL exists in the data \u2014 same latent shape as the NOT IN trap. Label with CASE WHEN GROUPING=1 THEN ALL ELSE coalesce(col,'(none)')."}], "edges": [{"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_grouping", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_subtotal_null", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_subtotal_null", "target": "docs_postgresql_pages_phase_6_aggregation_11_subqueries_readme_not_in_vs_not_exists", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_grouping", "target": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_01_sets_rollup_cube_rollup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_6_aggregation_16_grouping_sets_02_grouping_and_labels_grouping", "target": "docs_postgresql_pages_phase_7_pg_driver_05_errors_unique_violation_23505", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/postgresql/pages/phase-6-aggregation/16-grouping-sets/02-grouping-and-labels.md", "source_location": null, "weight": 1.0}], "hyperedges": []}