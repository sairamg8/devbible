{"nodes": [{"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterators_for_await_of", "label": "for await...of", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-iterators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loop for sequences that arrive over time. Awaits each value; strictly sequential, one item in memory."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterators_async_generator", "label": "async generator", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-iterators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "async function* can await and yield. Consumer pull pauses the producer \u2014 free pull-based backpressure."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterators_symbol_async_iterator", "label": "Symbol.asyncIterator", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-iterators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocol: a method returning { next() \u2192 Promise<{value, done}> }. Async generators produce it."}, {"id": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterators_pull_backpressure", "label": "Pull-based backpressure", "file_type": "concept", "source_file": "build-css-p2/docs/nodejs/pages/phase-2-async/async-iterators.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generator is suspended at yield until the consumer asks for the next value, so a slow consumer slows the producer."}], "edges": [{"source": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterators_async_generator", "target": "build_css_p2_docs_nodejs_pages_phase_2_async_async_iterato