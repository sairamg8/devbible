{"nodes": [{"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication", "label": "Logical replication", "file_type": "document", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_vs_physical", "label": "Logical vs physical replication", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Physical copies WAL bytes of the whole cluster, same major, read-only. Logical copies decoded row changes, per table, writable, cross-major."}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_publication_subscription", "label": "PUBLICATION and SUBSCRIPTION", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wal_level = logical requires a restart. Snapshot then stream in commit order. Schema must already exist on the subscriber."}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_not_replicated", "label": "What logical replication does not copy", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DDL/schema, sequence data, large objects; only tables. TRUNCATE is replicated but fails if FKs point outside the subscription."}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_replica_identity", "label": "Replica identity", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a PK or marked unique index, INSERTs replicate and the first UPDATE/DELETE fails. REPLICA IDENTITY FULL breaks for types like point/box."}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_slots", "label": "Abandoned replication slot fills publisher disk", "file_type": "concept", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slot whose subscriber is gone retains WAL forever. Alert on pg_replication_slots; set max_slot_wal_keep_size to sacrifice the subscriber."}, {"id": "docs_postgresql_pages_phase_13_ops_16_logical_replication_not_for_ha", "label": "Logical replication is not for HA", "file_type": "rationale", "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema, sequences and replica identity are all manual. Every one of those is a step that will not have been done at 4am failover."}], "edges": [{"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication", "target": "docs_postgresql_pages_phase_12_beyond_tables_18_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication", "target": "docs_postgresql_pages_phase_13_ops_17_major_upgrades", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_vs_physical", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication_publication_subscription", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_not_replicated", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication_publication_subscription", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_replica_identity", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication_publication_subscription", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_slots", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication_publication_subscription", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_not_for_ha", "target": "docs_postgresql_pages_phase_13_ops_16_logical_replication", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/postgresql/pages/phase-13-ops/16-logical-replication.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_13_ops_16_logical_replication_slots", "target": "docs_postgresql_pages_phase_12_beyond_tables_13_listen_notify