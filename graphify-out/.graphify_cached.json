{"nodes": [{"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_arrow_vs_double_arrow", "label": "jsonb -> vs ->>", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "-> returns jsonb and chains; ->> returns text and terminates. One character decides type."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_missing_key_vs_json_null", "label": "Missing key vs JSON null", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "->> returns SQL NULL for both a missing key and JSON null; use ? or jsonb_typeof to tell them apart."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_hash_path_operators", "label": "jsonb #> and #>> path operators", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path form takes text[]; prefer #>> when the path is fixed and deeper than two levels."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_02_containment_and_jsonpath_containment_operator", "label": "jsonb containment @>", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/02-containment-and-jsonpath.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks whether the document contains a fragment; GIN can serve it. ->> equality cannot."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_02_containment_and_jsonpath_jsonpath_predicates", "label": "jsonpath @? and @@", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/02-containment-and-jsonpath.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparisons and wildcards that @> cannot express; GIN can serve both opclasses."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_02_containment_and_jsonpath_shallow_merge", "label": "jsonb shallow merge ||", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/02-containment-and-jsonpath.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "|| replaces the whole top-level key; nested updates need jsonb_set. Every mutation rewrites the document."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_readme_two_operator_families", "label": "jsonb accessor vs predicate families", "file_type": "rationale", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/README.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessors dig a value out; predicates ask a question. The family you pick decides whether an index can help."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_hybrid_schema", "label": "Hybrid columns plus jsonb", "file_type": "rationale", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promote queried keys to columns; keep the varying remainder as jsonb. Generated STORED columns migrate without a write-path change."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_storage_multiplier", "label": "jsonb key-name storage cost", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same two facts: 22 MB as jsonb vs 1736 kB as columns (~13x) because key names repeat per row."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_02_column_vs_json_no_fk_into_jsonb", "label": "No foreign key into a jsonb key", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/02-column-vs-json.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CHECK on presence/range works; FOREIGN KEY from a jsonb key is 42601."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_03_index_jsonb_jsonb_ops", "label": "GIN jsonb_ops", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/03-index-jsonb.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default GIN: indexes keys and values separately. Serves @> and ?; 17 MB here; cannot serve ->>."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_03_index_jsonb_jsonb_path_ops", "label": "GIN jsonb_path_ops", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/03-index-jsonb.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One hash per path-plus-value. Smaller/faster for @> (1.1 ms, 13 MB) but cannot serve ?."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_03_index_jsonb_expression_index", "label": "jsonb expression index", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/03-index-jsonb.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index (doc->>'tag') for a hot key: 0.9 ms and 1352 kB. Expression must match the query exactly, including casts."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_04_build_json_sql_build_object_allowlist", "label": "jsonb_build_object allowlist", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/04-build-json-sql.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit keys so a new column does not leak into the client payload, unlike to_jsonb(row)."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_04_build_json_sql_empty_agg_trap", "label": "jsonb_agg empty-collection trap", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/04-build-json-sql.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Need FILTER to drop the LEFT JOIN null row and coalesce to [] — either half alone ships null."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_04_build_json_sql_shape_in_js", "label": "Shape JSON in JS not SQL", "file_type": "rationale", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/04-build-json-sql.md", "source_location": "L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jsonb_agg 284.8 ms vs flat join + JS 90.7 ms; json_agg 131.2 ms. Use SQL constructors when the shape is the point."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_01_tsvector_and_queries_tsvector", "label": "tsvector lexemes", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/01-tsvector-and-queries.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorted set of lexemes with positions. english stems and drops stop words; simple does neither."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_01_tsvector_and_queries_websearch_to_tsquery", "label": "websearch_to_tsquery", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/01-tsvector-and-queries.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search-engine syntax; never raises. to_tsquery parses tsquery language and raises 42601 on ordinary user text."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_01_tsvector_and_queries_prefix_star", "label": "tsquery prefix :*", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/01-tsvector-and-queries.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-text matches whole lexemes; rout returns 0 rows, rout:* returns 13336. Type-ahead appends :*."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_immutable_config", "label": "to_tsvector IMMUTABLE config", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-arg to_tsvector(body) is rejected in an index (42P17) because it reads a session GUC. Name the config."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_generated_tsv", "label": "Generated tsvector column", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same speed as an expression index (~17 ms). Chosen to merge columns, carry setweight, and keep queries as tsv @@ q."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_05_full_text_02_indexing_and_ranking_ts_headline", "label": "ts_headline after LIMIT", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/05-full-text/02-indexing-and-ranking.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-tokenises original text and cannot use the index. Apply after LIMIT so it runs for the page, not every match."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_06_pg_trgm_word_similarity", "label": "pg_trgm % vs <%", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/06-pg-trgm.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "% compares whole strings (0.273 on a long title). <% / word_similarity scores the best substring (1.000)."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_06_pg_trgm_gin_vs_gist", "label": "gin_trgm_ops vs gist_trgm_ops", "file_type": "concept", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/06-pg-trgm.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIN for ILIKE/%/<%; GiST required for ORDER BY <-> nearest neighbour. GIN 9 MB vs GiST 22 MB here."}, {"id": "docs_postgresql_pages_phase_12_beyond_tables_06_pg_trgm_fts_complement", "label": "FTS and trigram are complements", "file_type": "rationale", "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/06-pg-trgm.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FTS stems grammar but misses typos; trigram finds typos but cannot stem. Production: FTS first, trigram fallback."}], "edges": [{"source": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_missing_key_vs_json_null", "target": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_arrow_vs_double_arrow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/01-accessors-and-paths.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_01_accessors_and_paths_arrow_vs_double_arrow", "target": "docs_postgresql_pages_phase_12_beyond_tables_01_jsonb_operators_02_containment_and_jsonpath_containment_operator", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "/mnt/Storage/Backup/Knowledge/devbible/docs/postgresql/pages/phase-12-beyond-tables/01-jsonb-operators/02-containment-and-jsonpath.md", "source_location": null, "weight": 1.0}, {"source": "docs_postgresql_pages_ph