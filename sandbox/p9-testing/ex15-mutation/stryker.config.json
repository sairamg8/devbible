{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/*.test.mjs"
  },
  "mutate": [
    "src/*.mjs"
  ],
  "reporters": [
    "clear-text"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2
}